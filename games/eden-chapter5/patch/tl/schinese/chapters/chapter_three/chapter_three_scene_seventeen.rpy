    # mc "We need to find something to help her."
    mc "我们得找点东西帮到她。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1541
translate schinese house_one_child_label_315b36d3:

    # na "Let’s go back out and search."
    na "我们出去再找找吧。"

