translate schinese scene_seventeen_label_e0d0b8bb_1:

    # se "Sadly due to this place being so far away, we’re only able to help around here once every blue moon."
    se "可惜这里太远，我们难得才来帮一次。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:32
translate schinese scene_seventeen_label_bc1022e9_1:

    # gi "Is there anything we can do to help?"
    gi "我们能帮上什么忙吗？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:35
translate schinese scene_seventeen_label_3d87df97_1:

    # se "I would strongly suggest you lay low."
    se "我强烈建议你们低调行事。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:36
translate schinese scene_seventeen_label_bc450b4d_1:

    # se "We don’t want word spreading to the chancellor about this."
    se "我们可不想让消息传到宰相耳朵里。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:39
translate schinese scene_seventeen_label_fe79f137_1:

    # se "At any rate, I better get going."
    se "不管怎样，我得走了。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:40
translate schinese scene_seventeen_label_07851e1a_1:

    # se "Bishop Mara will be expecting my help with the investigation."
    se "玛拉主教还等着我去帮忙调查。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:41
translate schinese scene_seventeen_label_4894d66e_1:

    # se "See ya!"
    se "回见！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:45
translate schinese scene_seventeen_label_499493cf_1:

    # rav "Lay low my ass."
    rav "低调个屁。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:46
translate schinese scene_seventeen_label_c9d07992_1:

    # rav "We’re helping the people here."
    rav "我们是在帮这里的人。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:49
translate schinese scene_seventeen_label_025e7669_1:

    # na "As you wish, your highness."
    na "遵命，殿下。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:51
translate schinese scene_seventeen_label_d81f32cc_1:

    # yu "What should we do first?"
    yu "我们先做什么？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:54
translate schinese scene_seventeen_label_b93dca64_1:

    # rav "We look for the village’s leader."
    rav "我们去找村长。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:55
translate schinese scene_seventeen_label_10e9230b_1:

    # rav "Establish a relationship, tell her about our intention to help."
    rav "跟她建立联系，告诉她我们想帮忙。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:56
translate schinese scene_seventeen_label_7303de1b_1:

    # rav "And we earn our stay."
    rav "这样我们就能留下。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:59
translate schinese scene_seventeen_label_d90439a1_1:

    # mc "Should we reveal who you are?"
    mc "要不要透露你的身份？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:62
translate schinese scene_seventeen_label_71866c75_1:

    # rav "Yes. As the rightful ruler of Temporia, I want the people here to be by our side."
    rav "要。作为坦皮奥拉的正统统治者，我希望这里的人站在我们这边。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:65
translate schinese scene_seventeen_label_4b44bcce_1:

    # mc "You’re a good person, Ravena."
    mc "你是个好人，拉维娜。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:68
translate schinese scene_seventeen_label_d5a29f5b_1:

    # na "I agree."
    na "我同意。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:69
translate schinese scene_seventeen_label_e7c4d72e_1:

    # na "So… where’s the village leader?"
    na "那么……村长在哪儿？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:72
translate schinese scene_seventeen_label_8709005a_1:

    # yu "We should look for the biggest house."
    yu "我们应该找最大的房子。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:75
translate schinese scene_seventeen_label_877cde93_1:

    # gi "Then let’s head over."
    gi "那我们过去吧。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:76
translate schinese scene_seventeen_label_4bb4106f_1:

    # gi "We need to secure a place to stay tonight."
    gi "我们得找个今晚落脚的地方。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:81
translate schinese scene_seventeen_label_978a0ce7_1:

    # rav "Hello?"
    rav "有人吗？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:84
translate schinese scene_seventeen_label_43e15d5a_1:

    # ne "Greetings. How may I help you?"
    ne "您好。有什么可以帮您？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:87
translate schinese scene_seventeen_label_ed31aa33_1:

    # rav "Please excuse the intrusion."
    rav "抱歉打扰了。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:88
translate schinese scene_seventeen_label_0ed838d6_1:

    # rav "Are you the leader of this village?"
    rav "请问您是村长吗？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:92
translate schinese scene_seventeen_label_387d0d83_1:

    # ne "Correct, who may you be."
    ne "正是，敢问您是？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:95
translate schinese scene_seventeen_label_305fe50c_1:

    # rav "My name is Celeste, heir to the throne of Temporia, currently in exile due to the treacherous actions of the chancellor."
    rav "我叫塞莱斯特，坦皮奥拉王位继承人，因宰相的背信行为而出逃在外。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:96
translate schinese scene_seventeen_label_21fbb239_1:

    # rav "We are looking for shelter as we attempt to reclaim what was wrongfully taken from me."
    rav "我们正在寻求庇护，想夺回被错误夺走的东西。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:99
translate schinese scene_seventeen_label_c119c702_1:

    # ne "Princess Celeste! I am honored to meet you!"
    ne "塞莱斯特公主！能见到您是我的荣幸！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:100
translate schinese scene_seventeen_label_26c65675_1:

    # ne "I should’ve known from the royal pendant you wear!"
    ne "我早该从您佩戴的皇室吊坠看出来的！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:101
translate schinese scene_seventeen_label_70c2711a_1:

    # ne "My name is Neira, I am in charge of this village."
    ne "我叫奈拉，负责管理这个村子。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:103
translate schinese scene_seventeen_label_f142dbc2_1:

    # rav "Please rise, it is an honor to meet you as well."
    rav "请起，遇见您也是我的荣幸。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:106
translate schinese scene_seventeen_label_dfdae307_1:

    # ne "What is this about you being in exile?"
    ne "请问您说的出逃是怎么回事？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:109
translate schinese scene_seventeen_label_3042d9c9_1:

    # rav "Yes of course, here’s what happened…"
    rav "当然，事情是这样的……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:117
translate schinese scene_seventeen_label_da134ead_1:

    # ne "Luminox above!"
    ne "露米诺克斯在上！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:118
translate schinese scene_seventeen_label_8c936d73_1:

    # ne "This is treason of the highest order!"
    ne "这是罪级极重的叛国！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:119
translate schinese scene_seventeen_label_8ffd66ee_1:

    # ne "I wish there was something we could offer you."
    ne "真希望我们能提供点什么。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:122
translate schinese scene_seventeen_label_09dacb9c_1:

    # ne "But as you can see our town isn’t in…"
    ne "但你也看到了，我们镇子并不……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:123
translate schinese scene_seventeen_label_4ebfb919_1:

    # ne "...top conditions."
    ne "……什么好条件。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:126
translate schinese scene_seventeen_label_7360f73a_1:

    # mc "We can help, Miss Neira."
    mc "我们能帮忙，奈拉小姐。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:129
translate schinese scene_seventeen_label_e2d1530f_1:

    # yu "Yes. Tell us what you need, we will get it done."
    yu "是的。告诉我们你需要什么，我们一定办到。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:132
translate schinese scene_seventeen_label_198ec982_1:

    # ne "I truly appreciate the help."
    ne "我由衷感谢你们的帮助。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:133
translate schinese scene_seventeen_label_2d477a1f_1:

    # ne "First, allow me to show you where I can accommodate you."
    ne "首先，请让我带你们去我能让你们住下的地方。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:136
translate schinese scene_seventeen_label_26d5f7c3_1:

    # na "How many different places have we slept in since we got here?"
    na "我们到这里之后睡过多少个不同的地方了？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:139
translate schinese scene_seventeen_label_3059a2e4_1:

    # gi "I think this is the third place we stay at."
    gi "我想这是我们住的第三个地方。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:142
translate schinese scene_seventeen_label_f6c8ae7b_1:

    # gi "Of course… not counting the great outdoors."
    gi "当然了……还不算露宿野外。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:145
translate schinese scene_seventeen_label_972b964e_1:

    # na "Look at us, living a nomadic life."
    na "瞧瞧我们，过着游牧生活。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:146
translate schinese scene_seventeen_label_b968a22f_1:

    # na "Though… this is fairly common for you, isn’t it?"
    na "不过……对你来说这挺常见的吧？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:149
translate schinese scene_seventeen_label_af8597a6_1:

    # gi "*Chuckles softly* One could say."
    gi "*轻声笑* 可以这么说。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:150
translate schinese scene_seventeen_label_ce633ec8_1:

    # gi "The main difference is my travels aren’t life threatening situations."
    gi "主要区别是我的旅行没有性命之忧。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:153
translate schinese scene_seventeen_label_a4e68e8e_1:

    # na "Yeah, fair enough."
    na "嗯，说得也是。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:156
translate schinese scene_seventeen_label_e0141115_1:

    # mc "Natasha! Gianna! Come on up!"
    mc "娜塔莎！吉安娜！上来！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:162
translate schinese scene_seventeen_label_c478b4b1_1:

    # ne "Here we go… it’s a little dirty but…"
    ne "来了……是有点脏，不过……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:165
translate schinese scene_seventeen_label_3c1edb2d_1:

    # rav "Neira, we truly are grateful for you allowing us to stay here."
    rav "奈拉，非常感谢你让我们住在这里。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:168
translate schinese scene_seventeen_label_8d461908_1:

    # ne "It’s the least I can do for you, your highness."
    ne "这我能为您做的最起码的事，殿下。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:171
translate schinese scene_seventeen_label_01389488_1:

    # rav "Please, call me Ravena."
    rav "请叫我拉维娜就好。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:174
translate schinese scene_seventeen_label_a01a91c7_1:

    # ne "Of course, Ravena."
    ne "当然，拉维娜。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:175
translate schinese scene_seventeen_label_eb53976e_1:

    # ne "Now, could you all tell me a little more about yourselves?"
    ne "现在，各位能多介绍一下自己吗？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:178
translate schinese scene_seventeen_label_214fc3bd_1:

    # rav "Right, this is Natasha. She is a Nature Caster."
    rav "这位是娜塔莎，她是自然系施法者。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:179
translate schinese scene_seventeen_label_75fd8774_1:

    # rav "She is powerful when it comes to healing magic."
    rav "她在治疗魔法方面很强。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:182
translate schinese scene_seventeen_label_fdd9897b_1:

    # ne "You are?!"
    ne "您是？！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:185
translate schinese scene_seventeen_label_b5750ac2_1:

    # ne "Oh my goodness! I need your help!"
    ne "天哪！我需要您的帮助！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:188
translate schinese scene_seventeen_label_995639bf_1:

    # na "You do?"
    na "你知道？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:191
translate schinese scene_seventeen_label_4e3e5377_1:

    # ne "Yes! Please! Come with me now!"
    ne "是的！拜托！跟我来！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:194
translate schinese scene_seventeen_label_eee3857f_1:

    # na "O-oh okay!"
    na "哦、好的！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:198
translate schinese scene_seventeen_label_3acdd83e_1:

    # gi "Well that was unexpected."
    gi "嗯，这倒是出乎意料。"

