translate schinese scene_seventeen_label_0a6806b8:

    # gi "But you’ll be able to."
    gi "但你能想到。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:714
translate schinese scene_seventeen_label_a5bbafc8:

    # mc "Naturally."
    mc "那当然。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:717
translate schinese scene_seventeen_label_f0644638:

    # gi "Was your favorite subject in school history?"
    gi "你以前最喜欢哪门课？历史吗？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:720
translate schinese scene_seventeen_label_c7ccca90:

    # mc "Yeah! How could you tell?"
    mc "对！你怎么知道的？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:723
translate schinese scene_seventeen_label_1994d72b:

