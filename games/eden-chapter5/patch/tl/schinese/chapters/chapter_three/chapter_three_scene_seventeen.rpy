translate schinese neira_label_00a8a15d_1:

    # mc "Hey Neira!"
    mc "嘿，奈拉！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1473
translate schinese neira_label_f89fad23_1:

    # mc "Can you tell me about this herb?"
    mc "能跟我说说这种草药吗？"

