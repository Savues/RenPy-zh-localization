translate schinese neira_label_0ad64742:

    # ne "They’re not native to the area."
    ne "它们并不是这一带的原生植物。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1502
translate schinese neira_label_4f3b3be6:

    # mc "What can it be used for?"
    mc "它能做什么用？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1505
translate schinese neira_label_a182240e:

    # ne "When infused with Nature Spiritual Energy, it can cleanse a body from almost any ailment!"
    ne "注入自然系灵力后，它能清除体内几乎任何病症！"

