translate schinese herb_one_label_7bb7e026:

    # mc "It’s just a plant…"
    mc "就是株植物……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1418
translate schinese herb_one_label_74e48355:

    # na "Yeah but… I feel kinda drawn to it."
    na "对……但我总觉得它很吸引我。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1420
translate schinese herb_one_label_fe17428f:

    # mc "Then let’s grab it."
    mc "那我们摘上。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1421
translate schinese herb_one_label_8c3160da:

    # mc "Maybe Neira can tell us more about it."
    mc "也许奈拉能告诉我们更多。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1431
translate schinese herb_two_label_e276d020:

    # mc "Hey… check this out."
    mc "嘿……看看这个。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1432
translate schinese herb_two_label_ec454da6:

    # mc "Looks different to the other plants we see around here."
    mc "跟我们在这附近看到的其他植物不一样。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1434
translate schinese herb_two_label_1994496e:

    # na "Let’s take it to Neira then!"
    na "那就拿给奈拉看看吧！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1435
translate schinese herb_two_label_537b856c:

    # na "I’m sure she can tell us more about it."
    na "我敢肯定她能告诉我们更多。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1449
translate schinese neira_label_b9f03498:

    # na "Hey, Nei!"
    na "嘿，奈！"

