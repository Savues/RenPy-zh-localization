    # mother "I continue giving her water but…"
    mother "我一直给她喂水，可是……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1559
translate schinese house_one_mother_label_a263fa80:

    # mother "She just seems to continue to get worse…"
    mother "她好像反而越来越糟……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1562
translate schinese house_one_mother_label_7d77e50f:

    # mc "She gets worse from water?"
    mc "喝水让她更糟？"

