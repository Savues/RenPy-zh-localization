# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:663
translate schinese scene_seventeen_label_9b136841:

    # wi "Let’s continue your training for a bit longer."
    wi "你们的训练再继续一会儿。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:667
translate schinese scene_seventeen_label_774dbbd6:

    # gi "H-holy crap…"
    gi "天、天哪天哪……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:668
translate schinese scene_seventeen_label_1c1a2055:

    # gi "That was… intense."
    gi "刚才真是……太激烈了。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:671
translate schinese scene_seventeen_label_3aa3ce2e:

    # mc "I agree, that was quite the workout."
    mc "我同意，运动量真够大的。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:674
translate schinese scene_seventeen_label_b98adb33:

    # wi "*Giggles* I did push you two pretty hard."
    wi "*咯咯笑* 我确实把你们两个逼得挺狠的。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:675
translate schinese scene_seventeen_label_4a969ec8:

    # wi "But that was fantastic work."
    wi "但你们表现得非常出色。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:676
translate schinese scene_seventeen_label_9452f3a0:

    # wi "I am very proud of the two of you."
    wi "我为你们两个感到骄傲。"

