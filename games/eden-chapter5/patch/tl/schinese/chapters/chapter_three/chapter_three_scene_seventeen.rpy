    # na "You’re gonna have to wear a mask here."
    na "你在这儿得戴口罩。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1333
translate schinese scene_seventeen_label_c1578878_1:

    # na "There were 3 patients that I’m gonna need help with."
    na "有三位病人我需要帮忙。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1336
translate schinese scene_seventeen_label_4e8f9921_1:

    # na "I couldn’t fully figure out what was wrong with them."
    na "我没法完全弄清他们怎么了。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1337
translate schinese scene_seventeen_label_e7ccfd60_1:

    # na "Mind helping me a bit?"
    na "介意帮我一下吗？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1339
translate schinese scene_seventeen_label_298f046e_1:

    # mc "Absolutely, let’s go."
    mc "当然，走吧。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1342
translate schinese scene_seventeen_label_6fa61c97_1:

    # mc "So…{w} what’s the plan?"
    mc "那么……{w}计划是什么？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1345
translate schinese scene_seventeen_label_8bfc2ce9_1:

    # na "Like I said, we gotta go to the 3 remaining houses and check on the people in there."
    na "我说过了，我们得去剩下三户人家看看里面的人。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1348
translate schinese scene_seventeen_label_fbf70873_1:

    # mc "Sounds simple enough."
    mc "听起来还挺简单。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1351
translate schinese scene_seventeen_label_504880c6_1:

    # na "Yeah but you forget I’m not a doctor and neither are you."
    na "对了，但你忘了我不是医生，你也不是。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1352
translate schinese scene_seventeen_label_69594123_1:

    # na "I’m scared of… you know… killing them."
    na "我怕的是……你懂的……把他们治死。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1355
translate schinese scene_seventeen_label_9db912c0_1:

    # mc "And your magic didn’t work on them?"
    mc "你的魔法对他们没用？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1358
translate schinese scene_seventeen_label_62453207_1:

    # na "Nope, not at all."
    na "完全没用。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1361
translate schinese scene_seventeen_label_93058524_1:

    # mc "Then we gotta look around."
    mc "那我们就得四处查查。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1362
translate schinese scene_seventeen_label_5a46a91f_1:

    # mc "Remember, in medieval times it wasn’t so much of a horrible sickness that would wipe out villages and stuff."
    mc "记住，中世纪时候毁灭村庄的往往不是什么可怕的疾病。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1363
translate schinese scene_seventeen_label_409caf57_1:

    # mc "But rather a lack of sanitization and poor medical practices."
    mc "而是缺乏卫生设施和糟糕的医疗条件。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1366
translate schinese scene_seventeen_label_930c8d0e_1:

    # na "So you think…"
    na "所以你觉得……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1369
translate schinese scene_seventeen_label_1c7f3421_1:

    # mc "I think these people you can’t heal have some pretty simple problems that we can solve without having to go all Dr. House on them."
    mc "我觉得这些你治不了的人，毛病挺简单，不用非得当个豪斯医生才能解决。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1372
translate schinese scene_seventeen_label_4dd83d6b_1:

    # na "Since when are you making pop culture references?"
