    # gi "I’ve always wanted to go slumming."
    gi "我一直想去体验底层生活。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:796
translate schinese scene_seventeen_label_aaf273f8:

    # mc "So I’m your charity case now?"
    mc "所以我现在是你的慈善对象了？"

