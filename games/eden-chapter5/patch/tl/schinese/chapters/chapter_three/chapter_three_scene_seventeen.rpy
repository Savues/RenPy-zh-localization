    # mc "But it’s important to keep up our training."
    mc "但坚持训练很重要。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:697
translate schinese scene_seventeen_label_1051f5ba:

    # gi "You feel committed to it?"
    gi "你觉得你有这个决心吗？"

