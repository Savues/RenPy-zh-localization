translate schinese neira_label_aeb0cdf7:

    # na "Everything is going perfect!"
    na "一切都非常顺利！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1487
translate schinese neira_label_cadcc27d:

    # na "We just got this herb… can you tell us about it?"
    na "我们刚找到这种草药……能给我们讲讲吗？"

