translate schinese scene_seventeen_label_18d41c2f:

    # mc "*Chuckles* If I don’t do it Natasha will start panicking."
    mc "*轻笑* 我要是不那样，娜塔莎就要开始慌了。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:766
translate schinese scene_seventeen_label_91b5cd07:

    # gi "*Laughs* True."
    gi "*笑* 确实。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:767
translate schinese scene_seventeen_label_ae53995e:

