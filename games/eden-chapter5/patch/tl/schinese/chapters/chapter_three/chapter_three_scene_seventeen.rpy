translate schinese neira_label_f3874fbe:

    # ne "We typically use it to make teas for people with fever."
    ne "我们通常用它给发烧的人煮茶。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1466
translate schinese neira_label_ff63e062:

    # mc "That could come in handy."
    mc "那可派上用场了。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1468
translate schinese neira_label_b3cc2000:

    # na "Yup. Let’s keep on going."
    na "没错。我们继续。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1472
translate schinese neira_label_00a8a15d:

    # mc "Hey Neira!"
    mc "嘿，奈拉！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1473
translate schinese neira_label_f89fad23:

    # mc "Can you tell me about this herb?"
    mc "能跟我说说这种草药吗？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1476
