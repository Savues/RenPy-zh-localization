translate schinese neira_label_7f325bdd:

    # ne "You have no idea how much we appreciate this, though!"
    ne "不过你们不知道我们有多感激！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1514
translate schinese neira_label_b1c0f592:

    # na "It’s totally fine!"
    na "完全没关系！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1515
translate schinese neira_label_f1ac9916:

    # na "I’m more than happy to help!"
    na "我很乐意帮忙！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1518
