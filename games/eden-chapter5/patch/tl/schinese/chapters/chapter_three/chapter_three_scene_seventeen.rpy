    # mc "Looks different to the other plants we see around here."
    mc "跟我们在这附近看到的其他植物不一样。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1434
translate schinese herb_two_label_1994496e_1:

    # na "Let’s take it to Neira then!"
    na "那就拿给奈拉看看吧！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1435
translate schinese herb_two_label_537b856c_1:

    # na "I’m sure she can tell us more about it."
    na "我敢肯定她能告诉我们更多。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1449
translate schinese neira_label_b9f03498_1:

    # na "Hey, Nei!"
    na "嘿，奈！"

