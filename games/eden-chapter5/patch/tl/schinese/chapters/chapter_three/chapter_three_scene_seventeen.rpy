    # gi "I’d say I’m more curious than anything."
    gi "我只是好奇，仅此而已。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:802
translate schinese scene_seventeen_label_5a0345b1:

    # mc "*Laughs* Yeah right."
    mc "*笑* 才怪。"

