translate schinese scene_seventeen_label_39a2621c:

    # wi "Very well. Hope you enjoy!"
    wi "很好。祝你们玩得开心！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:690
translate schinese scene_seventeen_label_0c4cdd7a:

    # gi "Well that was… interesting."
    gi "嗯，那真是……有意思。"

