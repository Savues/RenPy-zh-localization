translate schinese scene_seventeen_part_two_label_b0e1a032_1:

    # ai "I simply could not hold myself from going to meet him."
    ai "我实在忍不住去见他。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2660
translate schinese scene_seventeen_part_two_label_48e1e347_1:

    # rav "So what did you do?"
    rav "所以你做了什么？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2663
translate schinese scene_seventeen_part_two_label_dc8e6020_1:

    # ai "I lured the Wayfarer to me."
    ai "我把游荡者引到了我这里。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2665
translate schinese scene_seventeen_part_two_label_17a509d6_1:

    # ravandmc "You what?!"
    ravandmc "你做了什么？！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2668
translate schinese scene_seventeen_part_two_label_ec71bfa7_1:

    # ai "Yeah… that’s how mother reacted…"
    ai "是啊……母亲当时就是这么反应的……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2671
translate schinese scene_seventeen_part_two_label_a7c84360_1:

    # mc "So then?"
    mc "所以？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2674
translate schinese scene_seventeen_part_two_label_57c8c821_1:

    # ai "We met in secret. Within a cave that I knew mother couldn’t see us."
    ai "我们偷偷见面。在我确定母亲看不到的洞穴里。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2675
translate schinese scene_seventeen_part_two_label_fd1be6fd_1:

    # ai "And in there we began to know each other."
    ai "在那里，我们开始了解彼此。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2678
translate schinese scene_seventeen_part_two_label_19b79d67_1:

    # rav "What do you mean…"
    rav "什么意思……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2681
translate schinese scene_seventeen_part_two_label_b9c4dc9b_1:

    # rav "Oh…"
    rav "哦……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2684
translate schinese scene_seventeen_part_two_label_bad548fb_1:

    # ai "*Giggles* It wasn’t just that, though."
    ai "*咯咯笑* 不过不只是那样。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2687
translate schinese scene_seventeen_part_two_label_d646f709_1:

    # ai "The Wayfarer told me tales about this world."
    ai "游荡者给我讲这个世界的故事。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2688
translate schinese scene_seventeen_part_two_label_71aa3e6a_1:

    # ai "He had told me he travelled far and wide and had the opportunity to meet everyone."
    ai "他跟我说他走南闯北，有机会见到所有人。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2689
translate schinese scene_seventeen_part_two_label_7ca30784_1:

    # ai "But the best part was he’d always bring me new food to try."
    ai "但最棒的是他总会给我带新食物来尝。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2690
translate schinese scene_seventeen_part_two_label_6cc2b810_1:

    # ai "I don’t think I’d ever been happier than when I was with him."
    ai "我想我从来没有像跟他在一起时那样快乐过。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2691
translate schinese scene_seventeen_part_two_label_6e237b21_1:

    # ai "We then decided to start going on strolls in this very forest."
    ai "接着我们决定在这片森林里散步。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2692
translate schinese scene_seventeen_part_two_label_11c5e35d_1:

    # ai "Walking together, eating together, sleeping together."
    ai "一起走路，一起吃饭，一起睡觉。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2694
translate schinese scene_seventeen_part_two_label_fa9f7492_1:

    # rav "Did he know the truth about you?"
    rav "他知道你的真相吗？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2696
translate schinese scene_seventeen_part_two_label_1006e7c2_1:

    # ai "Oh yes, I didn’t hide the true nature of my being."
    ai "哦，是的，我没隐瞒自己的真实身份。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2698
translate schinese scene_seventeen_part_two_label_5fe17834_1:

    # mc "Wasn’t that dangerous?"
    mc "那不是很危险吗？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2699
translate schinese scene_seventeen_part_two_label_959eab96_1:

    # mc "Wouldn’t any person take advantage of a literal Celestiarch being in love with them?"
    mc "换成任何人，都会利用一个天枢爱上自己这一点吧？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2701
translate schinese scene_seventeen_part_two_label_503dd89b_1:

    # rav "[playername]! That is so rude!"
    rav "[playername]！这话太无礼了！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2704
translate schinese scene_seventeen_part_two_label_c549486a_1:

    # ai "No, no. He’s right to question that."
    ai "不，不。他这么质疑是有道理的。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2705
translate schinese scene_seventeen_part_two_label_a2e3f07a_1:

    # ai "In a sense, I was a naive little girl."
    ai "从某种意义上说，我是个天真的小女孩。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2708
translate schinese scene_seventeen_part_two_label_b6ab1ed5_1:

    # ai "But so was he. We were two young fools in love."
    ai "但他也一样。我们是两个坠入爱河的年轻傻瓜。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2711
translate schinese scene_seventeen_part_two_label_85967b56_1:

    # rav "That’s beautiful, Ailana."
    rav "真美，艾拉娜。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2714
translate schinese scene_seventeen_part_two_label_38a1dfc0_1:

    # ai "Indeed. But not every story has a happy ending."
    ai "确实。但不是每个故事都有幸福的结局。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2717
translate schinese scene_seventeen_part_two_label_db149c28_1:

    # ai "I came back to Eden one day, expecting to meet my Wayfarer…"
    ai "有一天我回到伊甸，期待见到我的游荡者……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2718
translate schinese scene_seventeen_part_two_label_0a9fd80b_1:

    # ai "Only to be met by loneliness."
    ai "却只等来了寂寞。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2719
translate schinese scene_seventeen_part_two_label_9b8b3273_1:

    # ai "No matter how long I waited, he would never appear."
    ai "无论我等多久，他都不会出现。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2720
translate schinese scene_seventeen_part_two_label_89f534c3_1:

    # ai "And so I started to look for him."
    ai "于是我开始寻找他。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2723
translate schinese scene_seventeen_part_two_label_f21c15d5_1:

    # ai "I broke all of my mother’s rules."
    ai "我把母亲的规矩全都打破了。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2724
translate schinese scene_seventeen_part_two_label_2251af6d_1:

    # ai "I went into the city to ask for help."
    ai "我进城去求助。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2725
translate schinese scene_seventeen_part_two_label_c2d2c022_1:

    # ai "Begging people to tell me where my Wayfarer was."
    ai "求别人告诉我我的游荡者在哪。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2728
translate schinese scene_seventeen_part_two_label_4793b8f0_1:

    # ai "Until I eventually found him."
    ai "直到我终于找到了他。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2729
translate schinese scene_seventeen_part_two_label_bd3236e9_1:

    # ai "He was sick. Close to dying."
    ai "他病了。濒临死亡。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2730
translate schinese scene_seventeen_part_two_label_5463c90a_1:

    # ai "I could not let the love of my life simply die."
    ai "我不能让我挚爱的人就这样死去。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2733
translate schinese scene_seventeen_part_two_label_299932b2_1:

    # ai "So I went on a journey."
    ai "于是我踏上了旅途。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2734
translate schinese scene_seventeen_part_two_label_329bc5cb_1:

    # ai "I searched far and wide for someone that could tell me what I could do."
    ai "我四处寻找能告诉我该怎么办的人。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2735
translate schinese scene_seventeen_part_two_label_f8be0ba2_1:

    # ai "Until I met a Dark Caster named Vela."
    ai "直到我遇见了一位名叫薇拉的暗系施法者。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2737
translate schinese scene_seventeen_part_two_label_43cf6849_1:

    # mc "The one from 1500 years ago!"
    mc "就是1500年前那位？！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2739
translate schinese scene_seventeen_part_two_label_d14b500f_3:

    # ai "Correct."
    ai "正是。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2740
translate schinese scene_seventeen_part_two_label_8e5d1a5e_1:

    # ai "She told me of someone that could fix my problem."
    ai "她告诉我有个人能解决我的问题。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2741
translate schinese scene_seventeen_part_two_label_95fcbb6d_1:

    # ai "A Nexian named Solstice."
    ai "一个叫索尔斯蒂斯的涅克西安人。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2744
translate schinese scene_seventeen_part_two_label_d2bc49d7_1:

    # rav "WHAT?!"
    rav "什么？！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2745
translate schinese scene_seventeen_part_two_label_f883b3cc_1:

    # rav "You made a deal with Solstice?!"
    rav "你跟索尔斯蒂斯做了交易？！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2748
translate schinese scene_seventeen_part_two_label_55b6ac7a_1:

    # ai "I didn’t have a choice!"
    ai "我别无选择！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2749
translate schinese scene_seventeen_part_two_label_b2c9d803_1:

    # ai "It was either make a deal with him…"
    ai "要么跟他做交易……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2750
translate schinese scene_seventeen_part_two_label_640f465a_1:

    # ai "Or let my love die."
    ai "要么眼睁睁看着我的爱死去。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2751
translate schinese scene_seventeen_part_two_label_9abc1396_1:

    # ai "Surely you understand my predicament!"
    ai "你一定能理解我的处境！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2754
translate schinese scene_seventeen_part_two_label_288b0eeb_1:

    # mc "I can’t say I blame you."
    mc "我不能说怪你。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2755
translate schinese scene_seventeen_part_two_label_c2ffbdf7_1:

    # mc "I’d do the same."
    mc "我也会这么做。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2758
translate schinese scene_seventeen_part_two_label_a78e48a4_1:

    # rav "Y-you would?"
    rav "你、你会吗？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2761
translate schinese scene_seventeen_part_two_label_0148ee8b_1:

    # mc "When you love someone, you’d do everything in your power to make sure they’re alright."
    mc "当你爱着一个人，你会竭尽所能确保他安好。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2762
translate schinese scene_seventeen_part_two_label_df6ed50d_1:

    # mc "What’d you have to trade?"
    mc "你拿什么去交换的？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2765
translate schinese scene_seventeen_part_two_label_fe42e895_1:

    # ai "I had to give up my divinity. My powers."
    ai "我必须放弃我的神性，我的力量。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2766
translate schinese scene_seventeen_part_two_label_b1bca111_1:

    # ai "I gave that to him in order for him to make my Wayfarer immortal."
    ai "我把它给了他，好让我的游荡者获得永生。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2767
translate schinese scene_seventeen_part_two_label_55aaff76_1:

    # ai "But in return, I was never to see him again."
    ai "但作为代价，我再也不能见他。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2768
translate schinese scene_seventeen_part_two_label_92d4c948_1:

    # ai "A small price to pay for salvation."
    ai "换取救赎，这点代价不算什么。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2771
translate schinese scene_seventeen_part_two_label_1a3cb386_1:

    # rav "Small price?"
    rav "代价小？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2772
translate schinese scene_seventeen_part_two_label_2666ded2_1:

    # rav "You two are in an eternal limbo!"
    rav "你们两个就永远这样不上不下！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2775
translate schinese scene_seventeen_part_two_label_ed8cdde3_1:

    # ai "Yes, that may be true…"
    ai "是啊，也许是这样……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2776
translate schinese scene_seventeen_part_two_label_8de87bc4_1:

    # ai "But when you love someone, simply knowing they’re alive is enough."
    ai "但当你爱着一个人，光是知道他还活着就够了。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2779
translate schinese scene_seventeen_part_two_label_ae3848c2_1:

    # mc "Do you know where he is now?"
    mc "你知道他现在在哪儿吗？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2782
translate schinese scene_seventeen_part_two_label_2dd814d9_1:

    # ai "I do not."
    ai "我不知道。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2783
translate schinese scene_seventeen_part_two_label_097ec5f0_1:

    # ai "And I am bound to this place."
    ai "而且我被束缚在这里。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2786
translate schinese scene_seventeen_part_two_label_44dd898d_1:

    # rav "Maybe there’s something we can do?"
    rav "也许我们能做点什么？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2788
translate schinese scene_seventeen_part_two_label_acf5782a_1:

    # mc "Bringing the Wayfarer over here?"
    mc "把游荡者带过来？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2790
translate schinese scene_seventeen_part_two_label_d8e880b7_1:

    # rav "Yes!"
    rav "当然！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2791
translate schinese scene_seventeen_part_two_label_e65cb547_1:

    # rav "We have to!"
    rav "我们必须这么做！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2794
translate schinese scene_seventeen_part_two_label_52942b6a_1:

    # ai "Oh! If you could do that I would be eternally grateful!"
    ai "哦！要是你们能做到，我会永远感激你们！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2796
translate schinese scene_seventeen_part_two_label_02206b5e_1:

    # mc "We’ll do our best, but can’t promise anything."
    mc "我们会尽力，但不能保证。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2799
translate schinese scene_seventeen_part_two_label_c9e13ae7_1:

    # ai "Yes, of course."
    ai "当然可以。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2800
translate schinese scene_seventeen_part_two_label_8a068052_1:

    # ai "I’ll be here!"
    ai "我就在这儿！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2801
translate schinese scene_seventeen_part_two_label_28a2e152_1:

    # ai "And I promise that I’ll be careful with the villagers!"
    ai "我保证会对村民们小心的！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2802
translate schinese scene_seventeen_part_two_label_e4dba5ad_1:

    # ai "Oh I am so happy!"
    ai "哦我太开心了！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2803
translate schinese scene_seventeen_part_two_label_acee5970_1:

    # ai "I can’t wait to see my Wayfarer again!"
    ai "我迫不及待想再见到我的游荡者！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2804
translate schinese scene_seventeen_part_two_label_c3bd3bff_1:

    # ai "It’s getting dark, though."
    ai "不过天快黑了。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2805
translate schinese scene_seventeen_part_two_label_5afe4800_1:

    # ai "You two should head back."
    ai "你们俩该回去了。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2808
translate schinese scene_seventeen_part_two_label_80606771_1:

    # rav "Yes, indeed."
    rav "是啊。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2809
translate schinese scene_seventeen_part_two_label_2c2036b7_1:

    # rav "Thank you for this, Ailana."
    rav "谢谢你，艾拉娜。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2811
translate schinese scene_seventeen_part_two_label_dd82f07d_1:

    # mc "This was truly beautiful."
    mc "这个故事真的很美。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2812
translate schinese scene_seventeen_part_two_label_40b6a0b4_1:

    # mc "We appreciate your time."
    mc "感谢你抽时间。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2815
translate schinese scene_seventeen_part_two_label_bbb1cdbc_1:

    # ai "I appreciate you two!"
    ai "我才要谢谢你们俩！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2818
translate schinese scene_seventeen_part_two_label_37121d19_1:

    # ai "*Whispering* I see you found your Wayfarer."
    ai "*低语* 我看你找到你的游荡者了。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2819
translate schinese scene_seventeen_part_two_label_fca45826_1:

    # ai "Treat him right!"
    ai "要好好待他！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2822
translate schinese scene_seventeen_part_two_label_f72fc622_1:

    # ai "*Giggles as she runs away*"
    ai "*笑着跑开*"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2827
translate schinese scene_seventeen_part_two_label_3ee32121_1:

    # mc "You good?"
    mc "你没事吧？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2830
translate schinese scene_seventeen_part_two_label_a4a87c6a_1:

    # rav "Y-y-yeah!"
    rav "嗯、嗯、嗯！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2833
translate schinese scene_seventeen_part_two_label_8f426125_1:

    # mc "Come on, Ravena."
    mc "走吧，拉维娜。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2834
translate schinese scene_seventeen_part_two_label_820e676f_1:

    # mc "Let’s get back."
    mc "我们回去吧。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:2839
translate schinese scene_seventeen_part_two_label_36c9b3e5_1:

    # mc "Listen… we need to ask you to stop bothering the villagers."
