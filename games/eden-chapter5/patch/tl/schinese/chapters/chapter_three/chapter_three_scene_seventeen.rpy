    wi "你的法术弱得可怜。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:568
translate schinese scene_seventeen_label_92ed9a85:

    # mc "They seemed to work just fine earlier…"
    mc "之前不是还好用吗……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:571
translate schinese scene_seventeen_label_a57a5aa8:

    # wi "Can I borrow the weapon for a second?"
    wi "我能借用一下武器吗？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:574
translate schinese scene_seventeen_label_e72955ca:

    # mc "Sure, here it is."
    mc "当然，给你。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:582
translate schinese scene_seventeen_label_72fe740a:

    # wi "Your shots would barely make a dent."
    wi "你的射击几乎留不下痕迹。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:585
translate schinese scene_seventeen_label_06c7a520:

    # mc "Well damn…"
    mc "真是的……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:586
translate schinese scene_seventeen_label_f86e224b:

    # mc "So how can I become stronger?"
    mc "那我怎么才能变强？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:589
translate schinese scene_seventeen_label_409d2dfc:

    # wi "You’ll need to form more contracts."
    wi "你需要缔结更多契约。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:592
translate schinese scene_seventeen_label_6deb3bb8:

    # wi "For example, a contract with me gives you a small boost to all the Spiritual Energies."
    wi "比如，跟我缔结契约能让你所有灵力小幅提升。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:595
translate schinese scene_seventeen_label_1acb7909:

    # mc "But then a contract with Gianna would increase my Fire Spiritual Energy?"
    mc "那跟吉安娜缔结契约就能提升我的火系灵力？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:598
translate schinese scene_seventeen_label_cb014812:

    # wi "Indeed."
    wi "正是。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:599
translate schinese scene_seventeen_label_78357bae:

    # wi "But it’s much too early for you to form a contract with Gianna, or any of your companions for that matter."
    wi "但要跟吉安娜，或者你的任何同伴缔结契约，都还太早了。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:602
translate schinese scene_seventeen_label_2876efd9:

    # mc "Why?"
    mc "为什么？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:605
translate schinese scene_seventeen_label_d41a03ff:

    # wi "We need to train your capacity."
    wi "我们得训练你的容量。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:608
translate schinese scene_seventeen_label_d18a1a8d:

    # mc "And how can I do that?"
    mc "我要怎么做到？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:611
translate schinese scene_seventeen_label_1ef70293:

    # wi "It’s very simple."
    wi "很简单。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:612
translate schinese scene_seventeen_label_3f338a8e:

    # wi "You just need to repeatedly cast spells."
    wi "只要反复施法就行。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:615
translate schinese scene_seventeen_label_bd87542c:

    # mc "That’s it?"
    mc "就这样？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:618
translate schinese scene_seventeen_label_2d12a902:

    # wi "It’s the same way you build muscles."
    wi "这跟锻炼肌肉一个道理。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:619
translate schinese scene_seventeen_label_8b0a783b:

    # wi "The more you repeat an exercise, the stronger you get."
    wi "重复得越多，就变得越强。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:620
translate schinese scene_seventeen_label_d57a3e41:

    # wi "Same thing with Spiritual Energy."
    wi "灵力也一样。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:621
translate schinese scene_seventeen_label_6d636b9a:

    # wi "The more you do it the more reserve you get."
    wi "做得越多，储备就越足。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:624
translate schinese scene_seventeen_label_321a3b78:

    # mc "So why was I able to form a contract with you?"
    mc "那为什么我能跟你缔结契约？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:627
translate schinese scene_seventeen_label_4671d694:

    # wi "Due to the fact that I am a Dark Caster, it is easier for you to form a contract with me."
    wi "因为我是暗系施法者，你跟我缔结契约会更容易。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:630
translate schinese scene_seventeen_label_7df48e1b:

    # mc "So like a boost because of compatibility?"
    mc "也就是说因为相性所以有加成？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:633
translate schinese scene_seventeen_label_bccc9bca:

    # wi "Precisely!"
    wi "正是！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:636
translate schinese scene_seventeen_label_06f216cf:

    # gi "And he has to get stronger in order to get me, huh?"
    gi "而且他得变强才能得到我，嗯？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:639
translate schinese scene_seventeen_label_cbd98e85:

    # wi "That would be correct."
    wi "可以这么说。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:642
translate schinese scene_seventeen_label_44ee6446:

    # gi "Not even if I make it easy for him?"
    gi "就算我让他轻松一点也不行？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:645
translate schinese scene_seventeen_label_33ab8488:

    # wi "Now that wouldn’t be fun, wouldn’t it?"
    wi "那就没意思了，对吧？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:648
translate schinese scene_seventeen_label_420c492a:

    # gi "Oh no, I fully intend to make the detective earn it."
    gi "哦不，我可完全打算让警探自己挣来。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:651
translate schinese scene_seventeen_label_3f27a6bf:

    # wi "*Giggles* I wouldn’t expect anything less from you."
    wi "*咯咯笑* 我也没指望你手下留情。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:652
translate schinese scene_seventeen_label_d255329c:

    # wi "But yes, he does need to increase his mana reserves in order for that to happen."
    wi "但没错，他确实得增加魔力储备才行。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:655
translate schinese scene_seventeen_label_8832cd35:

    # gi "Interesting."
    gi "有意思。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:656
translate schinese scene_seventeen_label_58720212:

    # gi "I guess that means we’ll need more private lessons, [playername]."
    gi "那看来我们得多上点私人课程了，[playername]。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:659
