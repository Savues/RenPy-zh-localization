translate schinese scene_seventeen_label_b7006048_1:

    # yu "Yes, your highness."
    yu "是，陛下。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:207
translate schinese scene_seventeen_label_a1116473_1:

    # rav "Stop calling me your highness!"
    rav "别再叫我殿下了！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:208
translate schinese scene_seventeen_label_91dde35a_1:

    # rav "I’m still Ravena!"
    rav "我还是拉维娜！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:211
translate schinese scene_seventeen_label_1023f7d0_1:

    # yu "Sorry! I don’t know how to act around you anymore."
    yu "对不起！我不知道该怎么跟您相处了。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:214
translate schinese scene_seventeen_label_bde75368_1:

    # rav "*Giggles* Just treat me like you always do!"
    rav "*咯咯笑* 你还像以前那样对我就行了！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:215
translate schinese scene_seventeen_label_df92103a_1:

    # rav "I’m still the same Ravena you’ve known."
    rav "我还是你认识的那个拉维娜。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:218
translate schinese scene_seventeen_label_74914df0_1:

    # yu "O-okay!"
    yu "好、好的！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:221
translate schinese scene_seventeen_label_a9920aba_1:

    # rav "Come, on, let’s go exploring, shortcake."
    rav "走吧，我们去探险，小蛋糕。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:227
translate schinese scene_seventeen_label_b4de4ecc_1:

    # gi "And then… there were two."
    gi "然后……就变成两个人了。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:230
translate schinese scene_seventeen_label_d7b0cb4d_1:

    # gi "What would you like to do while we wait?"
    gi "等待的时候你想做什么？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:235
translate schinese scene_seventeen_label_1c07c505_1:

    # mc "You."
    mc "你。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:238
translate schinese scene_seventeen_label_40e4d1f4_1:

    # gi "*Gasps* Detective!"
    gi "*倒吸一口气* 警探！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:241
translate schinese scene_seventeen_label_002bf486_1:

    # mc "*Laughs* I’m kidding, I’m kidding."
    mc "*笑*开玩笑的开玩笑的。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:244
translate schinese scene_seventeen_label_6d49d1b8_1:

    # gi "Yeah, right."
    gi "嗯。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:247
translate schinese scene_seventeen_label_b4a90e92_2:

    # mc "Hmmm…"
    mc "嗯……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:248
translate schinese scene_seventeen_label_38920708_1:

    # mc "How about we head out?"
    mc "我们出发吧？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:251
translate schinese scene_seventeen_label_4121715f_1:

    # gi "You know… I could use some training."
    gi "你知道……我需要训练。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:254
translate schinese scene_seventeen_label_b9323922_1:

    # mc "Training?"
    mc "训练？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:257
translate schinese scene_seventeen_label_db85443a_1:

    # gi "Indeed."
    gi "正是。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:258
translate schinese scene_seventeen_label_377cc83e_1:

    # gi "I need to get stronger."
    gi "我需要变强。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:259
translate schinese scene_seventeen_label_78628ac9_1:

    # gi "Considering I’ll be wielding a sword."
    gi "毕竟我要用剑。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:260
translate schinese scene_seventeen_label_f01f5378_1:

    # gi "I need to learn!"
    gi "我得学会！"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:263
translate schinese scene_seventeen_label_b4a90e92_3:

    # mc "Hmmm…"
    mc "嗯……"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:264
translate schinese scene_seventeen_label_5d60eef3_1:

    # mc "That could definitely work."
    mc "这肯定行得通。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:265
translate schinese scene_seventeen_label_477afd6b_1:

    # mc "Shall we, then?"
    mc "那我们开始？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:268
translate schinese scene_seventeen_label_6167e0da_1:

    # gi "Let’s go."
    gi "出发吧。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:273
translate schinese scene_seventeen_label_f6d7515f_1:

    # mc "You sure you want to train all the way out here?"
    mc "你确定要跑到这种地方来训练？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:276
translate schinese scene_seventeen_label_293c85db_1:

    # gi "Please. I don’t need a crowd watching over me."
    gi "拜托，我可不需要一群人围观。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:277
translate schinese scene_seventeen_label_fdb357d8_1:

    # gi "Unless you’re into that, detective."
    gi "除非你就好这口，警探。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:280
translate schinese scene_seventeen_label_f75229bd_1:

    # mc "I plead the fifth."
    mc "我援引第五修正案。"

