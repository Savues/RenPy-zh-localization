translate schinese neira_label_4a97c1dd:

    # ne "What can I do for ya?"
    ne "有什么我能帮忙的？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1456
translate schinese neira_label_b1c14701:

    # na "Can you tell me about this specific herb?"
    na "能跟我说说这种草药吗？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1459
