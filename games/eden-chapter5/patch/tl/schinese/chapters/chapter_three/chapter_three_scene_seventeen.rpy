# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1325
translate schinese scene_seventeen_label_067054cf:

    # na "I might need some help."
    na "我可能需要帮手。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1328
translate schinese scene_seventeen_label_60d18d5e:

    # mc "For sure, let’s do it."
    mc "当然，走吧。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1332
