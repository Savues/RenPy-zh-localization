    na "要我去请那位女士让我们单独待会儿吗？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1597
translate schinese house_one_barrel_label_8a4378e7_1:

    # mc "That’d be great."
    mc "那太好了。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1604
translate schinese house_one_barrel_label_bc3f578f_1:

    # mc "Hey Soph-"
    mc "嘿，索菲——"

