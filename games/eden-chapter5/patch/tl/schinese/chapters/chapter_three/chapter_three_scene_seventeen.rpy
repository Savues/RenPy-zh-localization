translate schinese scene_seventeen_label_387d0d83:

    # ne "Correct, who may you be."
    ne "正是，敢问您是？"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:95
translate schinese scene_seventeen_label_305fe50c:

    # rav "My name is Celeste, heir to the throne of Temporia, currently in exile due to the treacherous actions of the chancellor."
    rav "我叫塞莱斯特，坦皮奥拉王位继承人，因宰相的背信行为而出逃在外。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:96
translate schinese scene_seventeen_label_21fbb239:

    # rav "We are looking for shelter as we attempt to reclaim what was wrongfully taken from me."
    rav "我们正在寻求庇护，想夺回被错误夺走的东西。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:99
translate schinese scene_seventeen_label_c119c702:

