    yu "好。我带吉安娜跟我一起训练。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1323
translate schinese scene_seventeen_label_d2cc3fff_1:

    # na "I’ll head over to Neira."
    na "我去奈拉那边。"

# game/chapters/chapter_three/chapter_three_scene_seventeen.rpy:1324
translate schinese scene_seventeen_label_9113ca89_1:

    # na "[playername]? You mind coming with me?"
    na "[playername]？你跟我一起来吗？"

