    # mc "Can’t say I do."
    mc "我可不敢说相信。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:576
translate schinese are_we_dead_label_b624660b_1:

    # rav "Do you fear me?"
    rav "你怕我吗？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:579
translate schinese are_we_dead_label_fca52711_1:

    # mc "No."
    mc "不是。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:582
translate schinese are_we_dead_label_49cd6963_1:

    # rav "Why?"
    rav "为什么？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:585
translate schinese are_we_dead_label_a53eefeb_1:

    # mc "I can tell you are a powerful person."
    mc "我看得出你是个很厉害的人。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:586
translate schinese are_we_dead_label_cd3a21f1_1:

    # mc "You’d have no real use for us…"
    mc "你没什么理由利用我们……"

# game/chapters/chapter_one_one/chapter_one_one.rpy:587
translate schinese are_we_dead_label_556580e8_1:

    # mc "...at least in theory."
    mc "……至少理论上是。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:588
translate schinese are_we_dead_label_e658bf64_1:

    # mc "You’re stuck here too, aren’t you?"
    mc "你也被困在这里了，对吧？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:591
translate schinese are_we_dead_label_8b5e25d6_1:

    # rav "My~"
    rav "我～"

# game/chapters/chapter_one_one/chapter_one_one.rpy:592
translate schinese are_we_dead_label_80a554c6_1:

    # rav "You are quite smart."
    rav "你还挺聪明的。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:595
translate schinese are_we_dead_label_07d25e84_1:

    # na "*Clearly very horny* I know… right?"
    na "*显然很兴奋* 我知道……对吧？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:598
translate schinese are_we_dead_label_eb00d90b_1:

    # rav "Is… is she okay?"
    rav "她……她没事吧？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:601
translate schinese are_we_dead_label_d760b8cb_1:

    # mc "Yeah… she just gets like this every now and then."
    mc "嗯……她偶尔就会这样。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:603
translate schinese are_we_dead_label_7cb586c0_1:

    # rav "Do…{w} Do you want me to cure her?"
    rav "要……{w}要我来治治她吗？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:606
translate schinese are_we_dead_label_a03a964a_1:

    # mcandna "Fuck no!"
    mcandna "操，才不要！"

# game/chapters/chapter_one_one/chapter_one_one.rpy:608
translate schinese are_we_dead_label_68fd31b2_1:

    # rav "O-oh…"
    rav "哦、哦……"

# game/chapters/chapter_one_one/chapter_one_one.rpy:609
translate schinese are_we_dead_label_b28cbce6_1:

    # rav "Anyway…"
    rav "总之……"

# game/chapters/chapter_one_one/chapter_one_one.rpy:610
translate schinese are_we_dead_label_74de35f1_1:

    # rav "I hope that answers your question…"
    rav "这样回答你的问题了吧……"

# game/chapters/chapter_one_one/chapter_one_one.rpy:611
translate schinese are_we_dead_label_e0ebffcc_1:

    # rav "Anything else?"
    rav "还有别的问题吗？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:617
translate schinese where_are_we_label_9d32f660_1:

    # mc "What is this place?"
    mc "这是什么地方？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:620
translate schinese where_are_we_label_1f25cdc4_1:

    # rav "You are unaware of the existence of this place?"
    rav "你们不知道这个地方的存在？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:623
translate schinese where_are_we_label_99097c03_1:

    # mc "Are we supposed to know?"
    mc "我们应该知道吗？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:626
translate schinese where_are_we_label_de6eede3_1:

    # rav "I guess this makes sense."
    rav "这样倒也说得通。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:629
translate schinese where_are_we_label_2f8c42e6_1:

    # rav "We are in what is known as a Time Distortion."
    rav "我们所在的地方，叫做时间扭曲。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:632
translate schinese where_are_we_label_33745ac0_1:

    # rav "Fortunately, this is not a one time occurrence."
    rav "幸好，这不是一次性的现象。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:635
translate schinese where_are_we_label_4e85aad9_1:

    # na "What do you mean?"
    na "什么意思？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:638
translate schinese where_are_we_label_17bcf02d_1:

    # rav "My parents went through something similar when they first met."
    rav "我父母初次相遇的时候，也经历过类似的事。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:641
translate schinese where_are_we_label_04ac5c48_1:

    # mc "So there is a way out?"
    mc "所以有办法出去？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:644
translate schinese where_are_we_label_9252759f_1:

    # rav "Yes, it should not be too difficult."
    rav "有，应该不会太难。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:645
translate schinese where_are_we_label_7ae85426_1:

    # rav "I will explain it after I answer all your questions."
    rav "我先回答完你们所有的问题，再解释。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:648
translate schinese where_are_we_label_da049ae2_1:

    # na "Sounds good."
    na "好主意。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:649
translate schinese where_are_we_label_45bf6c4b_1:

    # na "Tell us more about this place, though."
    na "不过，先多跟我们讲讲这个地方吧。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:652
translate schinese where_are_we_label_9cbfe676_1:

    # rav "Well, for one there isn’t an actual scientific explanation for it."
    rav "嗯，首先，它并没有真正的科学解释。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:655
translate schinese where_are_we_label_0d24f7d6_1:

    # mc "Ain’t that relieving."
    mc "那倒是让人松了口气。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:658
translate schinese where_are_we_label_3302b439_1:

    # rav "But it’s happened multiple times."
    rav "不过这事已经发生过好几次了。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:661
translate schinese where_are_we_label_def72cd9_1:

    # na "And to your parents, no less."
    na "而且你父母也经历过。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:664
translate schinese where_are_we_label_a8ad6bd7_1:

    # rav "Correct, so you need not worry."
    rav "没错，所以你们不用担心。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:667
translate schinese where_are_we_label_fb7c5b98_1:

    # na "I love how you speak, by the way."
    na "对了，我很喜欢你说话的方式。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:670
translate schinese where_are_we_label_1b1076a4_1:

    # rav "W-what?"
    rav "什、什么？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:673
translate schinese where_are_we_label_c20904d8_1:

    # na "Yeah like… you speak very pretty."
    na "就是……你说得很好听。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:674
translate schinese where_are_we_label_b31a14ab_1:

    # na "It’s so formal."
    na "特别正式。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:681
translate schinese where_are_we_label_fadf1338_1:

    # rav "*Giggles* Why thank you."
    rav "*咯咯笑* 哪里哪里。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:684
translate schinese where_are_we_label_81abd396_1:

    # rav "Anyway, any other questions?"
    rav "总之，还有别的问题吗？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:690
translate schinese where_you_from_label_f658ed11_1:

    # mc "Where exactly are you from?"
    mc "你到底是哪里人？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:691
translate schinese where_you_from_label_94f8499d_1:

    # mc "I can tell we’re not from the same place."
    mc "我看得出我们不是同一个地方来的。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:694
translate schinese where_you_from_label_51d4b44c_1:

    # rav "Correct. We do seem to be from different worlds."
    rav "没错，我们好像是来自不同的世界。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:697
translate schinese where_you_from_label_1c3e267e_1:

    # mc "Wait… this is kinda like Eter-"
    mc "等等……这有点像以特-"

