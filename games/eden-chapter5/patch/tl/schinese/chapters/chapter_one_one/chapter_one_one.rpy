translate schinese where_you_from_label_b09c82ad_1:

    # rav "With each war new spells are created."
    rav "每场战争都会催生新的法术。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:747
translate schinese where_you_from_label_0926c059_1:

    # rav "Spells that are more destructive."
    rav "更具破坏性的法术。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:748
translate schinese where_you_from_label_9849f6a0_1:

    # rav "But we also have huge advancements in healing magic."
    rav "但我们的治愈魔法也有了巨大的进步。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:749
translate schinese where_you_from_label_fad651eb_1:

    # mc "Fascinating."
    mc "真有意思。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:752
translate schinese where_you_from_label_31196941_1:

    # na "Have you ever been part of a war?"
    na "你参与过战争吗？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:755
translate schinese where_you_from_label_353c2616_1:

    # rav "*Laughs* Oh no, we’ve been at peace ever since I was born."
    rav "*大笑* 哪有，我出生以来就一直很和平。"

