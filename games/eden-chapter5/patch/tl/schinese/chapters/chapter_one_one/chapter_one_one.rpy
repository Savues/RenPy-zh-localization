translate schinese why_you_here_label_a1371d9f_1:

    # rav "I’d have nothing to gain from selling you two."
    rav "我把你们俩卖掉得不到任何好处。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:843
translate schinese why_you_here_label_50125c16_1:

    # mc "I guess she’s right."
    mc "我觉得她说得对。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:844
translate schinese why_you_here_label_525ba572_1:

    # mc "No option but to trust her."
    mc "只能选择相信她。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:849
translate schinese why_you_here_label_2b944092_1:

    # na "Hmmm… Yeah, you’re right."
    na "唔……是啊，你说得对。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:852
translate schinese why_you_here_label_e0ebffcc_1:

    # rav "Anything else?"
    rav "还有别的问题吗？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:866
translate schinese rav_and_nat_extra_c9e50506_1:

    # na "So what you’re saying is Spiritual Energy flows within us like blood does?"
    na "你的意思是，灵力就像血液一样在我们体内流动？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:869
translate schinese rav_and_nat_extra_2439bf6e_1:

    # rav "Yes, it will take some time getting used to it, but it inevitably becomes second nature to you."
    rav "是的，需要一点时间来习惯，但最终它会变得像呼吸一样自然。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:872
translate schinese rav_and_nat_extra_58dae857_1:

    # na "*Squealing* This is so exciting!"
    na "*尖叫* 太棒了！"

# game/chapters/chapter_one_one/chapter_one_one.rpy:875
translate schinese rav_and_nat_extra_6eef1c40_1:

    # rav "Once we meet the guru of time, he’ll be able to tell you exactly what kind of magic you can use."
    rav "等我们见到时间贤者，他就能准确告诉你你能使用哪种魔法。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:878
translate schinese rav_and_nat_extra_1cb6edeb_1:

    # na "And then I can finally embark on my quest to defeat the demon king!"
    na "然后我终于可以开始我的讨伐魔王之旅了！"

# game/chapters/chapter_one_one/chapter_one_one.rpy:881
translate schinese rav_and_nat_extra_c51cff37_1:

    # rav "*Giggles* Demon king?"
    rav "*咯咯笑* 魔王？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:884
translate schinese rav_and_nat_extra_4f72e919_1:

    # na "Is that not why we were summoned?"
    na "我们不是被召唤来打倒魔王的吗？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:887
translate schinese rav_and_nat_extra_37a36256_1:

    # rav "I… am actually not sure why you are here…"
    rav "我……其实不太清楚你们为什么会在这里……"

# game/chapters/chapter_one_one/chapter_one_one.rpy:890
translate schinese rav_and_nat_extra_d4c2d95e_1:

    # na "So our quest is a mystery, huh?"
    na "原来我们的任务还是个谜啊。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:893
translate schinese rav_and_nat_extra_1573b662_1:

    # rav "Seems so."
    rav "看来是吧。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:896
translate schinese rav_and_nat_extra_1892beaa_1:

    # na "Hmmm…"
    na "嗯……"

# game/chapters/chapter_one_one/chapter_one_one.rpy:897
translate schinese rav_and_nat_extra_e1a7caaf_1:

    # na "Well that’s fine by me."
    na "不过我倒无所谓。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:900
translate schinese rav_and_nat_extra_1fa611b3_1:

    # rav "Weren’t you panicking a few minutes ago?"
    rav "你几分钟前不是还在慌吗？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:903
translate schinese rav_and_nat_extra_5d756e88_1:

    # na "Uhhh… yeah, why?"
    na "呃……对啊，怎么了？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:906
translate schinese rav_and_nat_extra_a8ccd1a0_1:

    # rav "How did you get so excited suddenly?"
    rav "你怎么突然就兴奋起来了？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:909
translate schinese rav_and_nat_extra_c06089ef_1:

    # na "I mean… this is something I wanted so badly when I was in high school."
    na "我是说……这正是我读高中时梦寐以求的事。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:912
translate schinese rav_and_nat_extra_58f97afb_1:

    # rav "High… school? As in an academy for the upper class?"
    rav "高……高中？是指贵族学院那种吗？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:915
translate schinese rav_and_nat_extra_bc84852c_1:

    # na "*Giggles* I guess you wouldn’t know what I’m talking about, huh?"
    na "*咯咯笑* 我猜你不知道我在说什么，对吧？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:916
translate schinese rav_and_nat_extra_75753529_1:

    # na "High school is basically the last four years of school."
    na "高中基本上就是学校的最后四年。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:919
translate schinese rav_and_nat_extra_f8f3ebba_1:

    # rav "Fascinating."
    rav "真有意思。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:922
translate schinese rav_and_nat_extra_f354d017_1:

    # na "Anyway, for… reasons… I wanted to get away from my life."
    na "总之，出于……某些原因……我想逃离自己的人生。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:923
translate schinese rav_and_nat_extra_1eea98c6_1:

    # na "So I would listen to a lot of stories of people being transported to other worlds and becoming heroes there."
    na "所以我听了很多故事，讲人们被传送到异世界、然后成为英雄。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:924
translate schinese rav_and_nat_extra_d84f64a8_1:

    # na "So I’ve wanted to go through a story like that."
    na "所以我一直想亲身经历那样的故事。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:927
translate schinese rav_and_nat_extra_5a37ab7f_1:

    # rav "That is very sweet, Natasha."
    rav "娜塔莎，你真可爱。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:930
translate schinese rav_and_nat_extra_e0c2c86a_1:

    # na "*Giggles* Thank you!"
    na "*咯咯笑* 谢谢！"

# game/chapters/chapter_one_one/chapter_one_one.rpy:933
translate schinese rav_and_nat_extra_8739b41b_1:

    # rav "Well, I will make sure your experience in Eden proves to be the greatest story ever told."
    rav "好吧，我一定会让你在伊甸的经历成为有史以来最精彩的故事。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:936
translate schinese rav_and_nat_extra_71adc078_1:

    # na "You really mean that?!"
    na "你真是这个意思？！"

