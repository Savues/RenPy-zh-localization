translate schinese where_you_from_label_e9cb2de0_1:

    # na "How is war in your world?"
    na "你们的世界是怎么打仗的？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:745
translate schinese where_you_from_label_5d446286_1:

    # rav "Pretty brutal."
    rav "相当残酷。"

