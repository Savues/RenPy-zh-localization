translate schinese where_you_from_label_f3e8cdd0_1:

    # rav "What is she talking about?"
    rav "她在说什么？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:717
translate schinese where_you_from_label_ccbd0363_1:

    # mc "I have no clue."
    mc "我也不知道。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:718
