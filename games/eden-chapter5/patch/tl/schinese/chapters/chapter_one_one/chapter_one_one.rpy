# game/chapters/chapter_one_one/chapter_one_one.rpy:703
translate schinese where_you_from_label_11455b53_2:

    # mc "What?"
    mc "什么？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:706
translate schinese where_you_from_label_04aecae1_1:

    # na "You know we can’t mention that!"
    na "你知道我们不能提那个的！"

# game/chapters/chapter_one_one/chapter_one_one.rpy:709
translate schinese where_you_from_label_11455b53_3:

    # mc "What?"
    mc "什么？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:712
translate schinese where_you_from_label_fd06375e_1:

    # na "Just… don’t mention that game."
    na "总之……别提那个游戏。"

