    rav "我想，你们世界的科技发展得和我们的很不一样吧。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:725
translate schinese where_you_from_label_ec64d541_1:

    # na "You guys don’t have electricity or anything like that, right?"
    na "你们没有电之类的东西，对吧？"

