    # rav "*Giggles*"
    rav "*咯咯笑*"

# game/chapters/chapter_one_one/chapter_one_one.rpy:839
translate schinese why_you_here_label_033ddc8a_1:

    # rav "Sorry… I tried to look as menacing as possible."
    rav "抱歉……我努力装得很凶了。"

