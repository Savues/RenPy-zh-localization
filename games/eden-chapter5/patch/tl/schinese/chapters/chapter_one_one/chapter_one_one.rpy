translate schinese where_you_from_label_24e4725f_1:

    # rav "The current king and queen have been very benevolent."
    rav "现在的国王和王后非常仁慈。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:757
translate schinese where_you_from_label_12c9ad9e_1:

    # mc "So you’re from a kingdom?"
    mc "所以你来自一个王国？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:760
translate schinese where_you_from_label_723e2e67_1:

    # rav "Indeed! I would say we are the strongest of the 5 kingdoms of Eden."
    rav "没错！要我说，我们是伊甸五大王国里最强的。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:763
translate schinese where_you_from_label_84f1c4fe_1:

    # na "Eden?"
    na "伊甸？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:766
translate schinese where_you_from_label_bdba6246_1:

    # rav "That’s the name of my world."
    rav "那是我那个世界的名字。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:769
translate schinese where_you_from_label_190c9171_1:

    # mc "I see…"
    mc "我明白了……"

# game/chapters/chapter_one_one/chapter_one_one.rpy:770
translate schinese where_you_from_label_048d9db7_1:

    # rav "Anything wrong?"
    rav "有什么问题吗？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:771
translate schinese where_you_from_label_3f5b1bdb_1:

    # mc "Nope, just putting the pieces of the puzzle together."
    mc "没有，只是把拼图一块块拼起来而已。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:774
translate schinese where_you_from_label_53fbc9ce_1:

    # rav "Good to know."
    rav "知道了，谢谢。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:777
translate schinese where_you_from_label_e0ebffcc_1:

    # rav "Anything else?"
    rav "还有别的问题吗？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:783
translate schinese why_you_here_label_499c4059_1:

    # mc "How did you end up here?"
    mc "你是怎么到这里的？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:786
translate schinese why_you_here_label_0294b609_1:

    # rav "What do you mean?"
    rav "什么意思？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:789
translate schinese why_you_here_label_7b0518b4_1:

    # na "Yeah I mean… us being here makes sense sorta…"
    na "嗯我是说……我们出现在这里还算说得通……"

# game/chapters/chapter_one_one/chapter_one_one.rpy:790
translate schinese why_you_here_label_5688e11b_1:

    # na "But you being here doesn’t make too much sense."
    na "但你出现在这里就说不太通了。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:793
translate schinese why_you_here_label_980a4b25_1:

    # rav "I mean… I was asleep and woke up here."
    rav "我的意思是……我睡了一觉，醒来就在这里了。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:794
translate schinese why_you_here_label_c8257fbf_1:

    # rav "Not much of an explanation."
    rav "这解释不了什么。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:797
translate schinese why_you_here_label_e813cbf5_1:

    # mc "Yet it connects different worlds?"
    mc "但它能连接不同的世界？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:800
translate schinese why_you_here_label_3f0f8cb9_1:

    # rav "That it does."
    rav "没错。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:801
translate schinese why_you_here_label_ffc304e4_1:

    # rav "It was only a theory until quite literally just now."
    rav "直到刚才，它还只是个理论。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:802
translate schinese why_you_here_label_aa61fb02_1:

    # rav "So you two would do well to hide the fact that you’re Outlanders."
    rav "所以你俩最好把你们是外来者的事藏好。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:805
translate schinese why_you_here_label_09f2de35_1:

    # mc "Is that so?"
    mc "是吗？"

# game/chapters/chapter_one_one/chapter_one_one.rpy:808
translate schinese why_you_here_label_6c3b46e8_1:

    # rav "Some… organizations… would not hesitate to capture you and experiment on you."
    rav "有些……组织……会毫不犹豫地抓走你们做实验。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:811
translate schinese why_you_here_label_16c070f7_1:

    # na "That bad, huh?"
    na "这么严重啊。"

# game/chapters/chapter_one_one/chapter_one_one.rpy:814
