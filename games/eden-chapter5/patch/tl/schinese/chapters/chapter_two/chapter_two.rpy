    wi "所以历代少数暗系施法者最终都积累了相当庞大的力量。"

# game/chapters/chapter_two/chapter_two.rpy:3984
translate schinese chapter_two_scene_eleven_1d004ff6:

    # wi "Naturally, the fact that they cannot be sensed makes them more unpredictable."
    wi "自然而然，无法被感知让他们更难以预测。"

# game/chapters/chapter_two/chapter_two.rpy:3987
translate schinese chapter_two_scene_eleven_c372dd77:

    # mc "And that leads to them being feared."
    mc "这就让他们被恐惧。"

# game/chapters/chapter_two/chapter_two.rpy:3990
translate schinese chapter_two_scene_eleven_cb014812:

    # wi "Indeed."
    wi "正是。"

# game/chapters/chapter_two/chapter_two.rpy:3993
translate schinese chapter_two_scene_eleven_ffe74633:

    # mc "Why do they call you a terrorist?"
    mc "为什么他们说你是恐怖分子？"

# game/chapters/chapter_two/chapter_two.rpy:3996
translate schinese chapter_two_scene_eleven_3148a85a:

    # wi "Jumping straight to it, huh?"
    wi "你还真直接。"

# game/chapters/chapter_two/chapter_two.rpy:3999
translate schinese chapter_two_scene_eleven_8157f955:

    # mc "I don’t like wasting time."
    mc "我不喜欢浪费时间。"

# game/chapters/chapter_two/chapter_two.rpy:4002
translate schinese chapter_two_scene_eleven_86ad2442:

    # wi "Good. Neither do I."
    wi "很好，我也不喜欢。"

# game/chapters/chapter_two/chapter_two.rpy:4003
translate schinese chapter_two_scene_eleven_17e4b22c:

    # wi "Like I said, people fear what they cannot comprehend."
    wi "就像我说的，人们恐惧自己无法理解的东西。"

# game/chapters/chapter_two/chapter_two.rpy:4006
translate schinese chapter_two_scene_eleven_c2dd63b4:

    # gi "Not that I’m against this…"
    gi "我倒不是反对这一点……"

# game/chapters/chapter_two/chapter_two.rpy:4007
translate schinese chapter_two_scene_eleven_47581507:

    # gi "But how do we know you’re not lying to us?"
    gi "但我们怎么知道你没在骗我们？"

# game/chapters/chapter_two/chapter_two.rpy:4010
translate schinese chapter_two_scene_eleven_6e406d5b:

    # mc "She’s powerful enough to create a whole other dimension…"
    mc "她强大到能创造另一个位面……"

# game/chapters/chapter_two/chapter_two.rpy:4011
translate schinese chapter_two_scene_eleven_7d2d5a94:

    # mc "She’d be more than powerful enough to wipe us out."
    mc "更别说把我们全灭掉了。"

# game/chapters/chapter_two/chapter_two.rpy:4014
translate schinese chapter_two_scene_eleven_9e23c644:

    # wi "You could tell..?"
    wi "你能看出来……？"

# game/chapters/chapter_two/chapter_two.rpy:4017
translate schinese chapter_two_scene_eleven_7c927b78:

    # mc "Yes?"
    mc "嗯？"

# game/chapters/chapter_two/chapter_two.rpy:4020
translate schinese chapter_two_scene_eleven_f36de606:

    # wi "This truly is wonderful."
    wi "这真是太妙了。"

# game/chapters/chapter_two/chapter_two.rpy:4023
translate schinese chapter_two_scene_eleven_c4734286:

    # mc "Why’s that?"
    mc "为什么？"

# game/chapters/chapter_two/chapter_two.rpy:4026
translate schinese chapter_two_scene_eleven_1afe331f:

    # wi "[playername], you were able to sense my power."
    wi "[playername]，你能感知到我的力量。"

# game/chapters/chapter_two/chapter_two.rpy:4029
translate schinese chapter_two_scene_eleven_dc37b0d2:

    # mc "Uh huh…"
    mc "嗯哼……"

# game/chapters/chapter_two/chapter_two.rpy:4030
translate schinese chapter_two_scene_eleven_9b288cdb:

    # mc "What does that have to do with-"
    mc "这跟——有什么关系？"

# game/chapters/chapter_two/chapter_two.rpy:4031
translate schinese chapter_two_scene_eleven_b8de06d3:

    # mc "Oh."
    mc "哦。"

# game/chapters/chapter_two/chapter_two.rpy:4032
translate schinese chapter_two_scene_eleven_645dbf3f:

    # mc "Wait so-"
    mc "等等，所以——"

# game/chapters/chapter_two/chapter_two.rpy:4035
translate schinese chapter_two_scene_eleven_beaf0eac:

    # wi "Yes, indeed."
    wi "是啊。"

# game/chapters/chapter_two/chapter_two.rpy:4036
translate schinese chapter_two_scene_eleven_7c6f7581:

    # wi "You are a Dark Caster."
    wi "你是暗系施法者。"

# game/chapters/chapter_two/chapter_two.rpy:4039
translate schinese chapter_two_scene_eleven_48978efd:

    # na "HOLY FUCK WHAT?!"
    na "我靠什么？！"

# game/chapters/chapter_two/chapter_two.rpy:4042
translate schinese chapter_two_scene_eleven_45346606:

    # wi "Yes, [playername] is one of the 3 Dark Casters in Eden."
    wi "是的，[playername]是伊甸三位暗系施法者之一。"

# game/chapters/chapter_two/chapter_two.rpy:4043
translate schinese chapter_two_scene_eleven_80a677b7:

    # wi "Now, let’s figure out your powers."
    wi "现在，我们来看看你的能力。"

# game/chapters/chapter_two/chapter_two.rpy:4046
translate schinese chapter_two_scene_eleven_7d06eabb:

    # wi "Would you ladies mind waiting for us here?"
    wi "两位介意在这里等我们一下吗？"

# game/chapters/chapter_two/chapter_two.rpy:4049
translate schinese chapter_two_scene_eleven_4f946589:

    # gi "Not at all, the tea is fantastic."
    gi "完全不介意，这茶太棒了。"

# game/chapters/chapter_two/chapter_two.rpy:4052
translate schinese chapter_two_scene_eleven_753328bb:

    # yu "W-w-where are you going?"
    yu "你、你们要去哪？"

# game/chapters/chapter_two/chapter_two.rpy:4055
translate schinese chapter_two_scene_eleven_57e3ad34:

    # wi "Don’t worry, sweet Yuki."
    wi "别担心，可爱的由纪。"

# game/chapters/chapter_two/chapter_two.rpy:4056
translate schinese chapter_two_scene_eleven_da2e9883:

    # wi "I won’t harm him."
    wi "我不会伤害他。"

# game/chapters/chapter_two/chapter_two.rpy:4057
translate schinese chapter_two_scene_eleven_915d6501:

    # wi "Witch’s Oath."
    wi "女巫的誓言。"

# game/chapters/chapter_two/chapter_two.rpy:4060
translate schinese chapter_two_scene_eleven_89636cf8:

    # na "This is so cool!"
    na "太酷了！"

# game/chapters/chapter_two/chapter_two.rpy:4061
translate schinese chapter_two_scene_eleven_7e758fea:

    # na "Okok! You guys go! We’ll be here waiting patiently!"
    na "好好好！你们去吧！我们在这儿乖乖等着！"

# game/chapters/chapter_two/chapter_two.rpy:4064
translate schinese chapter_two_scene_eleven_36bfff75:

    # wi "Follow me, [playername]."
    wi "跟我来，[playername]。"

# game/chapters/chapter_two/chapter_two.rpy:4068
translate schinese chapter_two_scene_eleven_7d0d7859:

    # mc "Wow, two scene changes."
    mc "哇，连换两次场景。"

# game/chapters/chapter_two/chapter_two.rpy:4071
translate schinese chapter_two_scene_eleven_965e8082:

    # mc "Is this your power?"
    mc "这是你的能力？"

# game/chapters/chapter_two/chapter_two.rpy:4074
translate schinese chapter_two_scene_eleven_cfee0a21:

    # wi "One of them."
    wi "其中之一。"

# game/chapters/chapter_two/chapter_two.rpy:4077
translate schinese chapter_two_scene_eleven_978904d2:

    # mc "How many do you have?"
    mc "你有多少种？"

# game/chapters/chapter_two/chapter_two.rpy:4080
translate schinese chapter_two_scene_eleven_e9c9885a:

    # wi "Technically two."
    wi "严格来说两种。"

# game/chapters/chapter_two/chapter_two.rpy:4081
translate schinese chapter_two_scene_eleven_37c140b2:

    # wi "I can create Time Pockets."
    wi "我能制造时间口袋。"

# game/chapters/chapter_two/chapter_two.rpy:4082
translate schinese chapter_two_scene_eleven_7099494c:

    # wi "And I can use all elements except for Light Spiritual Energy."
    wi "并且能使用除光灵力外的所有元素。"

# game/chapters/chapter_two/chapter_two.rpy:4085
translate schinese chapter_two_scene_eleven_23a67f69:

    # mc "No wonder the kingdom fears you."
    mc "难怪王国怕你。"

# game/chapters/chapter_two/chapter_two.rpy:4088
translate schinese chapter_two_scene_eleven_277002d9:

    # wi "Funnily enough, I wouldn’t hurt a fly."
    wi "说来奇怪，我不会伤一只苍蝇。"

# game/chapters/chapter_two/chapter_two.rpy:4091
translate schinese chapter_two_scene_eleven_e23d9613:

    # mc "I can feel that."
    mc "我感觉得到。"

# game/chapters/chapter_two/chapter_two.rpy:4092
translate schinese chapter_two_scene_eleven_63721c78:

    # mc "So… how are we going to determine my power?"
    mc "那么……我们该怎么确定我的能力？"

# game/chapters/chapter_two/chapter_two.rpy:4095
translate schinese chapter_two_scene_eleven_c00dfe6a:

    # wi "That is very simple."
    wi "那很简单。"

# game/chapters/chapter_two/chapter_two.rpy:4098
translate schinese chapter_two_scene_eleven_da26a134:

    # wi "Lend me your hand, please."
    wi "请把手借给我。"

# game/chapters/chapter_two/chapter_two.rpy:4101
translate schinese chapter_two_scene_eleven_3227db2c:

    # wi "Ahh… I see now."
    wi "啊……我明白了。"

# game/chapters/chapter_two/chapter_two.rpy:4102
translate schinese chapter_two_scene_eleven_def0ad19:

    # mc "What is it?"
    mc "怎么了？"

# game/chapters/chapter_two/chapter_two.rpy:4105
translate schinese chapter_two_scene_eleven_6a4a406c:

    # wi "You have the ability to form bonds with different beings."
    wi "你有与不同存在缔结羁绊的能力。"

# game/chapters/chapter_two/chapter_two.rpy:4108
translate schinese chapter_two_scene_eleven_2e7e69b5:

    # mc "Bonds?"
    mc "羁绊？"

# game/chapters/chapter_two/chapter_two.rpy:4111
translate schinese chapter_two_scene_eleven_7bd7eba2:

    # wi "Imagine a sort of contract."
    wi "可以理解为某种契约。"

# game/chapters/chapter_two/chapter_two.rpy:4114
translate schinese chapter_two_scene_eleven_f2992414:

    # mc "Fascinating… and these contracts will increase my powers?"
    mc "有意思……这些契约会增强我的力量？"

# game/chapters/chapter_two/chapter_two.rpy:4117
translate schinese chapter_two_scene_eleven_62854601:

    # wi "That, and you may summon them wherever you are."
    wi "不只是这样，你还能在任何地方召唤他们。"

# game/chapters/chapter_two/chapter_two.rpy:4120
translate schinese chapter_two_scene_eleven_f30c76e8:

    # mc "Are you serious?"
    mc "你认真的？"

# game/chapters/chapter_two/chapter_two.rpy:4121
translate schinese chapter_two_scene_eleven_ebedaf5b:

    # mc "That sounds broken as hell."
    mc "这也太强了吧。"

# game/chapters/chapter_two/chapter_two.rpy:4124
translate schinese chapter_two_scene_eleven_1a40eb6f:

    # wi "Excuse me?"
    wi "什么？"

# game/chapters/chapter_two/chapter_two.rpy:4127
translate schinese chapter_two_scene_eleven_03872a9d:

    # mc "Sorry, that sounds way too overpowered."
    mc "抱歉，这听起来强得离谱。"

# game/chapters/chapter_two/chapter_two.rpy:4130
translate schinese chapter_two_scene_eleven_b20c7b7c:

    # wi "To an extent, yes."
    wi "某种程度上，是的。"

# game/chapters/chapter_two/chapter_two.rpy:4131
translate schinese chapter_two_scene_eleven_4bc57d41:

    # wi "But you can only summon people once every 6 hours, and for a few seconds."
    wi "但你只能每六小时召唤一次，而且只能持续几秒。"

# game/chapters/chapter_two/chapter_two.rpy:4132
translate schinese chapter_two_scene_eleven_4d81c961:

    # wi "Although, you get more powerful as you form more bonds."
    wi "不过，你缔结的羁绊越多，就越强。"

# game/chapters/chapter_two/chapter_two.rpy:4135
translate schinese chapter_two_scene_eleven_1136fffc:

    # mc "That’s still pretty overpowered."
    mc "这还是强得离谱。"

# game/chapters/chapter_two/chapter_two.rpy:4138
translate schinese chapter_two_scene_eleven_33a09171:

    # wi "Perhaps."
    wi "也许吧。"

# game/chapters/chapter_two/chapter_two.rpy:4141
translate schinese chapter_two_scene_eleven_8836ef36:

    # mc "So… I’ve got a few questions if you don’t mind me asking..?"
    mc "那么……如果你不介意，我有几个问题……"

# game/chapters/chapter_two/chapter_two.rpy:4144
translate schinese chapter_two_scene_eleven_59d7fb83:

    # wi "Go ahead."
    wi "请说。"

# game/chapters/chapter_two/chapter_two.rpy:4147
translate schinese chapter_two_scene_eleven_d401bfd7:

    # mc "Why do you live in the forest and not go to another continent?"
    mc "你为什么住在森林里，不去别的大陆？"

# game/chapters/chapter_two/chapter_two.rpy:4150
translate schinese chapter_two_scene_eleven_64a002fa:

    # wi "Hmmm…"
    wi "嗯……"

# game/chapters/chapter_two/chapter_two.rpy:4151
translate schinese chapter_two_scene_eleven_e0b91f1a:

    # wi "That’s a good question."
    wi "这是个好问题。"

# game/chapters/chapter_two/chapter_two.rpy:4152
translate schinese chapter_two_scene_eleven_20d10f20:

    # wi "I guess I feel attached to the forest."
    wi "我想我对这片森林有感情吧。"

# game/chapters/chapter_two/chapter_two.rpy:4155
translate schinese chapter_two_scene_eleven_81709362:

    # mc "You do?"
    mc "你知道？"

# game/chapters/chapter_two/chapter_two.rpy:4158
translate schinese chapter_two_scene_eleven_b424fab1:

    # wi "Yes. It’s quite a beautiful place."
    wi "是啊，这里确实很美。"

# game/chapters/chapter_two/chapter_two.rpy:4159
translate schinese chapter_two_scene_eleven_351488c7:

    # wi "And I’ve already set up the protective barrier…"
    wi "而且我已经布下了防护结界……"

# game/chapters/chapter_two/chapter_two.rpy:4162
translate schinese chapter_two_scene_eleven_f6860237:

    # mc "Right… I thought that was you…"
    mc "好吧……我以为那是你的结界……"

# game/chapters/chapter_two/chapter_two.rpy:4163
translate schinese chapter_two_scene_eleven_7c051e80:

    # mc "Care explaining that?"
    mc "能解释一下吗？"

# game/chapters/chapter_two/chapter_two.rpy:4166
translate schinese chapter_two_scene_eleven_6ae03608:

    # wi "Of course."
    wi "当然。"

# game/chapters/chapter_two/chapter_two.rpy:4167
translate schinese chapter_two_scene_eleven_7a77444a:

    # wi "Think of the world as a place where all six types of Spiritual Energies coexist in perfect harmony. Balance."
    wi "把世界想象成六种灵力完美共存的地方。平衡。"

# game/chapters/chapter_two/chapter_two.rpy:4170
translate schinese chapter_two_scene_eleven_4e766c84:

    # wi "I can imagine Yuki, Natasha, and Gianna felt ill as they approached my house, yes?"
    wi "我猜由纪、娜塔莎和吉安娜靠近我家时感到不适，对吗？"

# game/chapters/chapter_two/chapter_two.rpy:4173
translate schinese chapter_two_scene_eleven_4a38e4a1:

    # mc "Correct, and when we were extremely close, I had a headache."
    mc "对，而且我们非常靠近的时候，我开始头疼。"

# game/chapters/chapter_two/chapter_two.rpy:4176
translate schinese chapter_two_scene_eleven_d5876160:

    # wi "Well, all I had to do was knock off the balance of the elements."
    wi "我要做的只是打破元素之间的平衡。"

# game/chapters/chapter_two/chapter_two.rpy:4177
translate schinese chapter_two_scene_eleven_1e8f8d57:

    # wi "By increasing Wind, Water, Fire, and Nature, I am able to distort the magic absorption of people that wander in here."
    wi "通过提高风、水、火与自然之力，我能扭曲误入此地之人的魔力吸收。"

# game/chapters/chapter_two/chapter_two.rpy:4180
translate schinese chapter_two_scene_eleven_edb49a08:

    # wi "So at first, they feel invigorated."
    wi "所以一开始，他们会感到精神一振。"

# game/chapters/chapter_two/chapter_two.rpy:4183
translate schinese chapter_two_scene_eleven_ff257f38:

    # wi "But too much of something is always bad."
    wi "但任何东西过量都不好。"

# game/chapters/chapter_two/chapter_two.rpy:4184
translate schinese chapter_two_scene_eleven_bbc2213d:

    # wi "A lack of balance will destroy you."
    wi "失去平衡会毁掉你。"

# game/chapters/chapter_two/chapter_two.rpy:4187
translate schinese chapter_two_scene_eleven_6a6cc917:

    # mc "Why did I get a headache towards the end, then?"
    mc "那我快到的时候为什么会头疼？"

# game/chapters/chapter_two/chapter_two.rpy:4190
translate schinese chapter_two_scene_eleven_e66d589a:

    # wi "Well, there I balance the elements again, but increase Dark and Light exponentially."
    wi "因为在那附近我又重新平衡了元素，但把暗与光成倍提升。"

# game/chapters/chapter_two/chapter_two.rpy:4191
translate schinese chapter_two_scene_eleven_35cec409:

    # wi "Making it quite literally impossible for a normal person to access this place."
    wi "让普通人根本无法进入这里。"

# game/chapters/chapter_two/chapter_two.rpy:4194
translate schinese chapter_two_scene_eleven_1a5b2b35:

    # mc "We’re not normal, though…"
    mc "不过我们不是普通人……"

# game/chapters/chapter_two/chapter_two.rpy:4197
translate schinese chapter_two_scene_eleven_4891510b:

    # wi "Correct, you’re from outside of this world."
    wi "没错，你们来自这个世界之外。"

# game/chapters/chapter_two/chapter_two.rpy:4200
translate schinese chapter_two_scene_eleven_07519a12:

    # mc "What about-"
    mc "那拉维娜呢——"

# game/chapters/chapter_two/chapter_two.rpy:4203
translate schinese chapter_two_scene_eleven_c95f3422:

    # wi "Ravena is one of the most powerful casters in the world."
    wi "拉维娜是世界上最强大的施法者之一。"

# game/chapters/chapter_two/chapter_two.rpy:4204
translate schinese chapter_two_scene_eleven_b88618fd:

    # wi "She’d breeze right through here."
    wi "她能轻松穿过这里。"

# game/chapters/chapter_two/chapter_two.rpy:4207
translate schinese chapter_two_scene_eleven_fad651eb:

    # mc "Fascinating."
    mc "真有意思。"

# game/chapters/chapter_two/chapter_two.rpy:4208
translate schinese chapter_two_scene_eleven_56c18279:

    # mc "I notice you talk a lot about balance… why?"
    mc "我注意到你很强调平衡……为什么？"

# game/chapters/chapter_two/chapter_two.rpy:4211
translate schinese chapter_two_scene_eleven_f5c9ce04:

    # wi "You truly are keen, detective."
    wi "侦探，你真是敏锐。"

# game/chapters/chapter_two/chapter_two.rpy:4212
translate schinese chapter_two_scene_eleven_cb5e85da:

    # wi "I don’t know how much Bishop Mara taught you, but we both belong to different schools of thought."
    wi "我不知道玛拉主教教了你多少，但我们属于不同的思想流派。"

# game/chapters/chapter_two/chapter_two.rpy:4215
translate schinese chapter_two_scene_eleven_849bf551:

    # wi "Bishop Mara is from the belief that Light Casters are blessed by Luminox herself."
    wi "玛拉主教信奉光系施法者受露米诺克斯亲自庇佑。"

# game/chapters/chapter_two/chapter_two.rpy:4216
translate schinese chapter_two_scene_eleven_fd5b0214:

    # wi "Meaning in the hierarchy of Spiritual Energies, Light is the highest one, and Dark is the lowest."
    wi "也就是说在灵力的位阶上，光最高，暗最低。"

# game/chapters/chapter_two/chapter_two.rpy:4219
translate schinese chapter_two_scene_eleven_8f9e7b05:

    # mc "And that has to do with the War 500 years ago?"
    mc "这跟五百年前的战争有关？"

# game/chapters/chapter_two/chapter_two.rpy:4222
translate schinese chapter_two_scene_eleven_cb014812_1:

    # wi "Indeed."
    wi "正是。"

# game/chapters/chapter_two/chapter_two.rpy:4223
translate schinese chapter_two_scene_eleven_2421a68c:

    # wi "That’s when we had a bit of a schism in the Church."
    wi "那时教会有了分裂。"

# game/chapters/chapter_two/chapter_two.rpy:4226
translate schinese chapter_two_scene_eleven_bb54adc5:

    # mc "We?"
    mc "我们？"

# game/chapters/chapter_two/chapter_two.rpy:4229
translate schinese chapter_two_scene_eleven_c1013f45:

    # wi "Oh yes, I am a firm believer in Luminox."
    wi "是啊，我坚定地信仰露米诺克斯。"

# game/chapters/chapter_two/chapter_two.rpy:4230
translate schinese chapter_two_scene_eleven_2042ad6d:

    # wi "In fact, I was a bishop many moons ago."
    wi "事实上，很多年前我也当过主教。"

# game/chapters/chapter_two/chapter_two.rpy:4233
translate schinese chapter_two_scene_eleven_da244b9a:

    # mc "What made you stop?"
    mc "是什么让你不当了？"

# game/chapters/chapter_two/chapter_two.rpy:4236
translate schinese chapter_two_scene_eleven_8d7753e5:

    # wi "Fear of Dark Casters and disagreements with the Church teachings."
    wi "害怕暗系施法者，以及与教会教义不合。"

# game/chapters/chapter_two/chapter_two.rpy:4237
translate schinese chapter_two_scene_eleven_9e26407a:

    # wi "They believe in a second divinity."
