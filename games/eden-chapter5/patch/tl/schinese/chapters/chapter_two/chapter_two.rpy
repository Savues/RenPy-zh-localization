translate schinese chapter_two_scene_six_fb309cde:

    # mc "Thank you, this place is so beautiful."
    mc "谢谢，这里真美。"

# game/chapters/chapter_two/chapter_two.rpy:316
translate schinese chapter_two_scene_six_6a0f0755:

    # bm "That makes me happy to hear."
    bm "你这么说我很开心。"

# game/chapters/chapter_two/chapter_two.rpy:317
translate schinese chapter_two_scene_six_e6147aa7:

    # bm "Let us sit down."
    bm "我们坐下吧。"

# game/chapters/chapter_two/chapter_two.rpy:320
translate schinese chapter_two_scene_six_7cf7cd36:

    # mc "Yes. Thank you."
    mc "好的，谢谢。"

# game/chapters/chapter_two/chapter_two.rpy:323
translate schinese chapter_two_scene_six_87d2bdef:

    # bm "So, Miss Ravena says that you are from a different world?"
    bm "那么，拉维娜小姐说你们来自不同的世界？"

# game/chapters/chapter_two/chapter_two.rpy:326
translate schinese chapter_two_scene_six_38468504:

    # mc "Correct, we’re from a more modern looking place."
    mc "没错，我们来自一个更现代化的地方。"

# game/chapters/chapter_two/chapter_two.rpy:327
translate schinese chapter_two_scene_six_8edf0b93:

    # mc "We don’t have magic, though."
    mc "不过我们没有魔法。"

# game/chapters/chapter_two/chapter_two.rpy:328
translate schinese chapter_two_scene_six_630d8c44:

    # mc "Which explains why civilization there developed differently to yours here."
    mc "这就解释了为什么那里的文明和你们这里发展得不一样。"

# game/chapters/chapter_two/chapter_two.rpy:331
translate schinese chapter_two_scene_six_03fa804c:

    # bm "Fascinating."
    bm "真有意思。"

# game/chapters/chapter_two/chapter_two.rpy:332
translate schinese chapter_two_scene_six_edeff635:

    # bm "I can tell that you don’t seem to emanate any sort of Spiritual Energy."
    bm "我看得出来，你们身上似乎没有任何灵力。"

# game/chapters/chapter_two/chapter_two.rpy:335
translate schinese chapter_two_scene_six_115f93a0:

    # mc "*Chuckles* So I’ve been told…"
    mc "*轻笑* 我也是听人说的……"

# game/chapters/chapter_two/chapter_two.rpy:338
translate schinese chapter_two_scene_six_a1526e62:

    # bm "No need to be worried, the Church of Luminox can grant you protection."
    bm "不必担心，露米诺克斯教会可以赐予你们庇护。"

# game/chapters/chapter_two/chapter_two.rpy:341
translate schinese chapter_two_scene_six_03ec38b9:

    # mc "That is very generous of you, thank you."
    mc "您真是慷慨，谢谢。"

# game/chapters/chapter_two/chapter_two.rpy:342
translate schinese chapter_two_scene_six_87f9c90b:

    # mc "But my companions and I would rather keep a low profile."
    mc "不过我和同伴们更想保持低调。"

# game/chapters/chapter_two/chapter_two.rpy:343
translate schinese chapter_two_scene_six_eff2163a:

    # mc "I’m sure we can keep ourselves safe."
    mc "我们一定能保护好自己。"

# game/chapters/chapter_two/chapter_two.rpy:346
translate schinese chapter_two_scene_six_357ab273:

    # bm "Indeed. Ravena is extremely powerful."
    bm "确实，拉维娜非常强大。"

# game/chapters/chapter_two/chapter_two.rpy:349
translate schinese chapter_two_scene_six_d02387b2:

    # bm "Although…{w} if she would stop skipping her training…"
    bm "不过……{w}要是她能不再逃避训练……"

# game/chapters/chapter_two/chapter_two.rpy:352
translate schinese chapter_two_scene_six_b9323922:

    # mc "Training?"
    mc "训练？"

# game/chapters/chapter_two/chapter_two.rpy:355
translate schinese chapter_two_scene_six_0746d26d:

    # bm "*Sigh* Yes… but it’d be best if she’s the one that tells you about that."
    bm "*叹气* 是……不过那还是让她自己跟你说吧。"

# game/chapters/chapter_two/chapter_two.rpy:358
translate schinese chapter_two_scene_six_b4a90e92_1:

    # mc "Hmmm…"
    mc "嗯……"

# game/chapters/chapter_two/chapter_two.rpy:361
translate schinese chapter_two_scene_six_5dfccfda:

    # bm "Is everything alright?"
    bm "出什么事了吗？"

# game/chapters/chapter_two/chapter_two.rpy:364
translate schinese chapter_two_scene_six_2351c7ff:

    # mc "Nothing, Ravena was just equally secretive about that."
    mc "没什么，拉维娜对那件事也是守口如瓶。"

# game/chapters/chapter_two/chapter_two.rpy:367
translate schinese chapter_two_scene_six_04e90a8c:

    # bm "I see…"
    bm "我明白了……"

# game/chapters/chapter_two/chapter_two.rpy:368
translate schinese chapter_two_scene_six_8689462e:

    # bm "I promise, it will all make sense as time goes on."
    bm "我保证，时间久了你会明白的。"

# game/chapters/chapter_two/chapter_two.rpy:369
translate schinese chapter_two_scene_six_457f8daa:

    # bm "She is not a bad person."
    bm "她不是坏人。"

# game/chapters/chapter_two/chapter_two.rpy:372
translate schinese chapter_two_scene_six_a8ae6cb9:

    # mc "Oh I don’t doubt that for a second."
    mc "我一点也不怀疑。"

# game/chapters/chapter_two/chapter_two.rpy:373
translate schinese chapter_two_scene_six_b44ae330:

    # mc "She’s been nothing but kind to us this entire time."
    mc "她这一路上对我们一直很好。"

# game/chapters/chapter_two/chapter_two.rpy:376
translate schinese chapter_two_scene_six_e0d5d6a5:

    # bm "That is truly good to hear."
    bm "听到这话真好。"

# game/chapters/chapter_two/chapter_two.rpy:377
translate schinese chapter_two_scene_six_eb49f244:

    # bm "I’ve known her since she was a child."
    bm "她还是孩子的时候我就认识她了。"

# game/chapters/chapter_two/chapter_two.rpy:380
translate schinese chapter_two_scene_six_85e7420d:

    # mc "*Laughs* No way! What was she like?"
    mc "*笑* 不会吧！她小时候什么样？"

# game/chapters/chapter_two/chapter_two.rpy:383
translate schinese chapter_two_scene_six_6773f42f:

    # bm "Always very curious."
    bm "总是很好奇。"

# game/chapters/chapter_two/chapter_two.rpy:384
translate schinese chapter_two_scene_six_17c14a53:

    # bm "She’s one to struggle to stay in one place."
    bm "她总是待不住。"

# game/chapters/chapter_two/chapter_two.rpy:387
translate schinese chapter_two_scene_six_9c342880:

    # mc "I can definitely see that being the case."
    mc "我完全能想象。"

# game/chapters/chapter_two/chapter_two.rpy:390
translate schinese chapter_two_scene_six_8c0099dc:

    # bm "For that same reason, she’s also struggled to make friends."
    bm "也因为这个，她也不太擅长交朋友。"

# game/chapters/chapter_two/chapter_two.rpy:393
translate schinese chapter_two_scene_six_09f2de35:

    # mc "Is that so?"
    mc "是吗？"

# game/chapters/chapter_two/chapter_two.rpy:396
translate schinese chapter_two_scene_six_feab1f9d:

    # bm "Yes… so please, have patience with her."
    bm "是……所以请对她多点耐心。"

# game/chapters/chapter_two/chapter_two.rpy:397
translate schinese chapter_two_scene_six_fd3108c0:

    # bm "She’s one of the kindest souls I know."
    bm "她是我认识的最善良的人之一。"

# game/chapters/chapter_two/chapter_two.rpy:400
translate schinese chapter_two_scene_six_587a0fa2:

    # mc "You have my word."
    mc "我向你保证。"

# game/chapters/chapter_two/chapter_two.rpy:401
translate schinese chapter_two_scene_six_84198e61:

    # mc "While we have a chance to talk, would you mind if I ask you some questions?"
    mc "趁现在有机会聊天，我能问你几个问题吗？"

# game/chapters/chapter_two/chapter_two.rpy:404
translate schinese chapter_two_scene_six_ad73815c:

    # bm "Of course, ask away."
    bm "当然，请说。"

# game/chapters/chapter_two/chapter_two.rpy:415
translate schinese chapter_two_scene_six_ab93ef49:

    # mc "Can you tell me more about Spiritual Energy?"
    mc "能跟我多讲讲灵力吗？"

# game/chapters/chapter_two/chapter_two.rpy:418
translate schinese chapter_two_scene_six_6895ccf5:

    # bm "I am assuming Miss Ravena was not able to answer all your questions?"
    bm "看来拉维娜小姐没能回答你所有的问题？"

# game/chapters/chapter_two/chapter_two.rpy:421
translate schinese chapter_two_scene_six_f0ad4081:

    # mc "*Chuckles* Sadly, no…"
    mc "*轻笑* 遗憾的是，没有……"

# game/chapters/chapter_two/chapter_two.rpy:424
translate schinese chapter_two_scene_six_f2363aec:

    # bm "*Gritting her teeth* This girl…"
    bm "*咬牙切齿* 这家伙……"

# game/chapters/chapter_two/chapter_two.rpy:427
translate schinese chapter_two_scene_six_d45d240d:

    # bm "Ahem, anyway, Spiritual Energy is intertwined with living beings."
    bm "咳，总之，灵力与生命体交织在一起。"

# game/chapters/chapter_two/chapter_two.rpy:428
translate schinese chapter_two_scene_six_8f38fde5:

    # bm "In a sense, think of it as being part of your soul."
    bm "某种意义上，你可以把它当成自己灵魂的一部分。"

# game/chapters/chapter_two/chapter_two.rpy:429
translate schinese chapter_two_scene_six_81a8b562:

    # bm "Every living thing has Spiritual Energy."
    bm "每一个活物都有灵力。"

# game/chapters/chapter_two/chapter_two.rpy:432
translate schinese chapter_two_scene_six_40a3731e:

    # mc "But then…"
    mc "但……"

# game/chapters/chapter_two/chapter_two.rpy:435
translate schinese chapter_two_scene_six_92faac41:

    # bm "Yes, you’ve heard many people say they don’t sense any emanating from you."
    bm "是的，你听很多人说过，他们感觉不到你身上有任何灵力。"

# game/chapters/chapter_two/chapter_two.rpy:436
translate schinese chapter_two_scene_six_6c690de4:

    # bm "This just means you don’t have enough Spiritual Energy to cast spells."
    bm "这只是说明你的灵力不足以施展法术。"

# game/chapters/chapter_two/chapter_two.rpy:439
translate schinese chapter_two_scene_six_cbc81447:

    # mc "Interesting…"
    mc "有意思……"

# game/chapters/chapter_two/chapter_two.rpy:440
translate schinese chapter_two_scene_six_68fb42ce:

    # mc "There are different types of Spiritual Energy, right?"
    mc "灵力有不同类型，对吧？"

# game/chapters/chapter_two/chapter_two.rpy:443
translate schinese chapter_two_scene_six_b6aa610f:

    # bm "Correct, in total there are six."
    bm "没错，总共有六种。"

# game/chapters/chapter_two/chapter_two.rpy:446
translate schinese chapter_two_scene_six_1ee3fde7:

    # bm "The four most popular ones are Fire, Earth, Water, and Wind."
    bm "最常见的是火、土、水、风四种。"

# game/chapters/chapter_two/chapter_two.rpy:448
translate schinese chapter_two_scene_six_c62b9275:

    # mc "Four main elements."
    mc "四大元素。"

# game/chapters/chapter_two/chapter_two.rpy:450
translate schinese chapter_two_scene_six_a987cde9:

    # bm "Indeed."
    bm "正是。"

# game/chapters/chapter_two/chapter_two.rpy:452
translate schinese chapter_two_scene_six_f3b71eeb:

    # mc "And the other two?"
    mc "另外两种呢？"

# game/chapters/chapter_two/chapter_two.rpy:455
translate schinese chapter_two_scene_six_6f090e38:

    # bm "Those are extremely rare types of Spiritual Energy."
    bm "那是极其稀有的灵力类型。"

# game/chapters/chapter_two/chapter_two.rpy:456
translate schinese chapter_two_scene_six_11e62637:

    # bm "Light and Dark magic."
    bm "光与暗的魔法。"

# game/chapters/chapter_two/chapter_two.rpy:458
translate schinese chapter_two_scene_six_fad651eb:

    # mc "Fascinating."
    mc "真有意思。"

# game/chapters/chapter_two/chapter_two.rpy:462
translate schinese chapter_two_scene_six_b14dbd38:

    # mc "What do those kinds of energies do?"
    mc "那两种灵力能做什么？"

# game/chapters/chapter_two/chapter_two.rpy:465
translate schinese chapter_two_scene_six_536b2e27:

    # bm "Light Spiritual Energy is pure. It has high healing capabilities, but also can pack quite the punch."
    bm "光灵力很纯粹，治疗能力极强，同时威力也不小。"

# game/chapters/chapter_two/chapter_two.rpy:466
translate schinese chapter_two_scene_six_733b7704:

    # bm "The top healer in the nation uses Light Spiritual Energy."
    bm "全国最强的治疗师用的就是光灵力。"

# game/chapters/chapter_two/chapter_two.rpy:467
translate schinese chapter_two_scene_six_06c565ad:

    # bm "She is one of 7 Light Casters we know of."
    bm "她是我们已知的七位光系施法者之一。"

# game/chapters/chapter_two/chapter_two.rpy:469
translate schinese chapter_two_scene_six_6cd744c1:

    # mc "What about Dark Spiritual Energy?"
    mc "那暗灵力呢？"

# game/chapters/chapter_two/chapter_two.rpy:471
translate schinese chapter_two_scene_six_ea92df96:

    # bm "Dark Casters are people you should be wary about."
    bm "暗系施法者是你该提防的人。"

# game/chapters/chapter_two/chapter_two.rpy:472
translate schinese chapter_two_scene_six_54ac8b5c:

    # bm "500 years ago, there was a brutal war that ravaged the lands, led by a Dark Caster and his obsession over dominion."
    bm "五百年前，一位暗系施法者因对统治的执念，发动了一场蹂躏大地的残酷战争。"

# game/chapters/chapter_two/chapter_two.rpy:473
translate schinese chapter_two_scene_six_337e1376:

    # bm "Dark Spiritual Energy corrupts the mind."
    bm "暗灵力会腐蚀心智。"

# game/chapters/chapter_two/chapter_two.rpy:474
translate schinese chapter_two_scene_six_30a8b241:

    # bm "Despite it being incredibly powerful, users end up wanting more and more power."
    bm "尽管威力惊人，使用者最终只会越来越渴求更多力量。"

# game/chapters/chapter_two/chapter_two.rpy:476
translate schinese chapter_two_scene_six_dd903572:

    # mc "You said this type of Spiritual Energy is incredibly rare, correct?"
    mc "你说这种灵力极其稀有，对吗？"

# game/chapters/chapter_two/chapter_two.rpy:479
translate schinese chapter_two_scene_six_bf3bf3fc:

    # bm "Just as rare as Light Magic."
    bm "和光系魔法一样稀有。"

# game/chapters/chapter_two/chapter_two.rpy:480
translate schinese chapter_two_scene_six_2f840f9e:

    # bm "There are only two known users at the moment."
    bm "目前已知的使用者只有两位。"

# game/chapters/chapter_two/chapter_two.rpy:481
translate schinese chapter_two_scene_six_c0e86d8f:

    # bm "One of them works closely with the royal family."
    bm "其中一位与王室关系密切。"

# game/chapters/chapter_two/chapter_two.rpy:484
translate schinese chapter_two_scene_six_08556703:

    # mc "Isn’t that counterintuitive?"
    mc "这不是自相矛盾吗？"

# game/chapters/chapter_two/chapter_two.rpy:487
translate schinese chapter_two_scene_six_cd41f50e:

    # bm "How so?"
    bm "怎么说？"

# game/chapters/chapter_two/chapter_two.rpy:490
translate schinese chapter_two_scene_six_5448dec3:

    # mc "You just said that Dark Spiritual Energy corrupts the user."
    mc "你刚才还说暗灵力会腐蚀使用者。"

# game/chapters/chapter_two/chapter_two.rpy:491
translate schinese chapter_two_scene_six_2a302488:

    # mc "Makes them power hungry…"
    mc "会让他们贪恋力量……"

# game/chapters/chapter_two/chapter_two.rpy:492
translate schinese chapter_two_scene_six_76077c0e:

    # mc "Why would you put one so close to the royal family?"
    mc "那为什么要让这样一个人离王室这么近？"

# game/chapters/chapter_two/chapter_two.rpy:495
translate schinese chapter_two_scene_six_c3f60c81:

    # bm "How else are we going to neutralize any sort of threat?"
    bm "否则我们要怎么消除任何威胁？"

# game/chapters/chapter_two/chapter_two.rpy:496
translate schinese chapter_two_scene_six_732d8625:

    # bm "Imagine an assassin comes in and is a Dark Caster."
    bm "想象一下，一个刺客闯进来，还是暗系施法者。"

# game/chapters/chapter_two/chapter_two.rpy:497
translate schinese chapter_two_scene_six_4bd2843b:

    # bm "Yet no one can sense them because of the lack of Dark Casters in there?"
    bm "却因为其中没有别的暗系施法者，谁也感知不到他？"

# game/chapters/chapter_two/chapter_two.rpy:500
translate schinese chapter_two_scene_six_c70bbefe:

    # mc "You bring a fair point."
    mc "你说得有道理。"

# game/chapters/chapter_two/chapter_two.rpy:501
translate schinese chapter_two_scene_six_b97845bd:

    # mc "Is there any countermeasure in case he goes rogue?"
    mc "如果他失控，有应对手段吗？"

# game/chapters/chapter_two/chapter_two.rpy:504
translate schinese chapter_two_scene_six_b070dfd7:

    # bm "Yes, as I mentioned, we have seven Light Casters in the Kingdom."
    bm "有的，正如我说的，王国有七位光系施法者。"

# game/chapters/chapter_two/chapter_two.rpy:505
translate schinese chapter_two_scene_six_4da39555:

    # bm "Five of them act as his highness’s guard."
    bm "其中五位担任殿下的护卫。"

# game/chapters/chapter_two/chapter_two.rpy:508
translate schinese chapter_two_scene_six_91ed9a43:

    # mc "You are missing two, then."
    mc "那还剩两位。"

# game/chapters/chapter_two/chapter_two.rpy:511
translate schinese chapter_two_scene_six_5de6fe43:

    # bm "One of them is the King."
    bm "其一是国王。"

# game/chapters/chapter_two/chapter_two.rpy:512
translate schinese chapter_two_scene_six_a1a59336:

    # bm "The other being the healer I told you about."
    bm "另一位就是我刚才说的那位治疗师。"

# game/chapters/chapter_two/chapter_two.rpy:515
translate schinese chapter_two_scene_six_2ccb7669:

    # mc "Well that’s relieving."
    mc "那我就放心了。"

# game/chapters/chapter_two/chapter_two.rpy:516
translate schinese chapter_two_scene_six_18681e53:

    # mc "Anyway…"
    mc "总之……"

# game/chapters/chapter_two/chapter_two.rpy:521
translate schinese chapter_two_scene_six_2e335a41:

    # mc "So…{w} tell me about Eden…"
    mc "那么……{w}跟我说说伊甸吧……"

# game/chapters/chapter_two/chapter_two.rpy:524
translate schinese chapter_two_scene_six_475b4bdc:

    # bm "Well for one, the Kingdom we are in right now is the strongest one."
    bm "首先，我们现在所在的国家是最强的。"

# game/chapters/chapter_two/chapter_two.rpy:527
translate schinese chapter_two_scene_six_0e9013c7:

    # mc "Why is that?"
    mc "为什么？"

# game/chapters/chapter_two/chapter_two.rpy:530
translate schinese chapter_two_scene_six_0d4e115d:

    # bm "Our current king has brought peace, freedom, justice and security to the kingdom."
    bm "我们现任国王为这个国家带来了和平、自由、公正与安全。"

# game/chapters/chapter_two/chapter_two.rpy:531
translate schinese chapter_two_scene_six_5319fb09:

    # bm "Launching it into an age of prosperity never seen."
    bm "让它进入一个前所未有的繁荣时代。"

# game/chapters/chapter_two/chapter_two.rpy:532
translate schinese chapter_two_scene_six_04a0ed22:

    # bm "The queen, on the other hand, is quite the humanitarian."
    bm "而王后则十分有人道精神。"

# game/chapters/chapter_two/chapter_two.rpy:533
translate schinese chapter_two_scene_six_a1443a60:

    # bm "The two of them revolutionized the kingdom with concepts never imagined before."
    bm "两人以前所未见的理念，彻底革新了这个国家。"

# game/chapters/chapter_two/chapter_two.rpy:534
translate schinese chapter_two_scene_six_9be87255:

    # bm "Children are not allowed to work, but rather get educated."
    bm "儿童不允许工作，而是必须接受教育。"

# game/chapters/chapter_two/chapter_two.rpy:535
translate schinese chapter_two_scene_six_52956c5b:

    # bm "Moreover, there is no forced military conscription."
    bm "而且没有强制兵役。"

# game/chapters/chapter_two/chapter_two.rpy:536
translate schinese chapter_two_scene_six_3d7368e8:

    # bm "The king also allows people to do as they want in society, as long as they are productive and there isn’t a massive gap in the kingdom’s needs."
    bm "国王也允许人们在社会里做自己想做的事，只要他们有生产力，且王国的需求没有出现巨大缺口。"

# game/chapters/chapter_two/chapter_two.rpy:538
translate schinese chapter_two_scene_six_fad651eb_1:

    # mc "Fascinating."
    mc "真有意思。"

# game/chapters/chapter_two/chapter_two.rpy:539
translate schinese chapter_two_scene_six_808fb77a:

    # mc "Sounds like the king thinks very similarly to the way people think in my world."
    mc "听起来国王的想法和我那个世界的人很像。"

# game/chapters/chapter_two/chapter_two.rpy:542
translate schinese chapter_two_scene_six_c2f76226:

    # bm "Is that so?"
    bm "是吗？"

# game/chapters/chapter_two/chapter_two.rpy:545
translate schinese chapter_two_scene_six_2bf618f2:

    # mc "Yes, freedom is a very big theme where I am from."
    mc "是的，自由在我来的地方是核心理念。"

# game/chapters/chapter_two/chapter_two.rpy:546
translate schinese chapter_two_scene_six_4a8644c2:

    # mc "Anyway, I heard Ravena mention you were experiencing days of peace here in the kingdom?"
    mc "总之，我听拉维娜说你们正在王国里经历太平日子？"

# game/chapters/chapter_two/chapter_two.rpy:549
translate schinese chapter_two_scene_six_ba68d7d0:

    # bm "Correct, but that has been the case for a long time already."
    bm "没错，但这种日子其实已经持续很久了。"

# game/chapters/chapter_two/chapter_two.rpy:552
translate schinese chapter_two_scene_six_b24b7e16:

    # bm "Even before our current king."
    bm "早在我们现任国王之前就是了。"

# game/chapters/chapter_two/chapter_two.rpy:553
translate schinese chapter_two_scene_six_6a5d8119:

    # bm "Our last war was the Great War many centuries ago."
    bm "我们上一次战争是许多世纪前的那场大战。"

# game/chapters/chapter_two/chapter_two.rpy:557
translate schinese chapter_two_scene_six_c4deb51a:

    # mc "The one you mentioned that was 500 years ago?"
    mc "就是你提过的那场五百年前的战争？"

# game/chapters/chapter_two/chapter_two.rpy:560
translate schinese chapter_two_scene_six_c297aed6:

    # bm "Correct."
    bm "正是。"

# game/chapters/chapter_two/chapter_two.rpy:563
translate schinese chapter_two_scene_six_3ec77cc1:

    # bm "A war that happened over 500 years ago that claimed many lives."
    bm "那场五百多年前发生、夺走无数生命的战争。"

# game/chapters/chapter_two/chapter_two.rpy:566
translate schinese chapter_two_scene_six_bd3b4a30:

    # bm "Many people volunteered to the front lines…"
    bm "很多人自愿奔赴前线……"

# game/chapters/chapter_two/chapter_two.rpy:567
translate schinese chapter_two_scene_six_a93351b5:

    # bm "War this brutal had never occurred before."
    bm "如此残酷的战争前所未有。"

# game/chapters/chapter_two/chapter_two.rpy:568
translate schinese chapter_two_scene_six_ad472518:

    # bm "And thank Luminox it hasn’t happened again."
    bm "感谢露米诺克斯，此后再没发生过。"

# game/chapters/chapter_two/chapter_two.rpy:570
translate schinese chapter_two_scene_six_e2ed7bc4:

    # mc "Truly living in an age of peace and prosperity, huh?"
    mc "真是生活在和平与繁荣的时代啊。"

# game/chapters/chapter_two/chapter_two.rpy:571
translate schinese chapter_two_scene_six_7bad01de:

    # mc "Must be nice."
    mc "一定很美好。"

# game/chapters/chapter_two/chapter_two.rpy:573
translate schinese chapter_two_scene_six_20b428c8:

    # bm "Is your world not like this?"
    bm "你们世界不是这样的吗？"

# game/chapters/chapter_two/chapter_two.rpy:576
translate schinese chapter_two_scene_six_8874df2b:

    # mc "Oh not at all."
    mc "哦，完全不是。"

# game/chapters/chapter_two/chapter_two.rpy:577
translate schinese chapter_two_scene_six_f1a785cd:

    # mc "Every war is more brutal and pointless than the last."
    mc "每一场战争都比上一场更残酷、更毫无意义。"

# game/chapters/chapter_two/chapter_two.rpy:580
translate schinese chapter_two_scene_six_4bb1604e:

    # bm "That sounds dreadful."
    bm "听起来太可怕了。"

# game/chapters/chapter_two/chapter_two.rpy:583
translate schinese chapter_two_scene_six_eb9f9efe:

    # mc "*Sighs* It is what it is, I guess."
    mc "*叹气* 我想，只能这样了。"

# game/chapters/chapter_two/chapter_two.rpy:584
translate schinese chapter_two_scene_six_b83d3430:

    # mc "Anyway, what was this war about?"
    mc "总之，这场战争是因为什么？"

# game/chapters/chapter_two/chapter_two.rpy:587
translate schinese chapter_two_scene_six_4d1e82a6:

    # bm "Yes, a Dark Caster rose in the Eastern continent."
    bm "是的，东部大陆兴起了一位暗系施法者。"

# game/chapters/chapter_two/chapter_two.rpy:588
translate schinese chapter_two_scene_six_70b2fba2:

    # bm "He ultimately summoned creatures that would fight for him."
    bm "他最终召唤出了为他效力的魔物。"

# game/chapters/chapter_two/chapter_two.rpy:589
translate schinese chapter_two_scene_six_3ee4902d:

    # bm "And even after our troops would defeat those creatures…"
    bm "即便我们的军队击败了那些魔物……"

# game/chapters/chapter_two/chapter_two.rpy:590
translate schinese chapter_two_scene_six_507eab00:

    # bm "The final duel against him left us without our strongest soldiers."
    bm "与他的最终一战，让我们失去了最强的士兵。"

# game/chapters/chapter_two/chapter_two.rpy:592
translate schinese chapter_two_scene_six_ae276bae:

    # mc "How did you defeat him then?"
    mc "那你们是怎么击败他的？"

# game/chapters/chapter_two/chapter_two.rpy:594
translate schinese chapter_two_scene_six_add2e567:

    # bm "To this day, we are truly unsure of what happened."
    bm "至今我们仍不清楚当时发生了什么。"

# game/chapters/chapter_two/chapter_two.rpy:595
translate schinese chapter_two_scene_six_e816bb3d:

    # bm "Some say divine intervention."
    bm "有人说是神的干预。"

# game/chapters/chapter_two/chapter_two.rpy:596
translate schinese chapter_two_scene_six_c822dcb0:

    # bm "Others that the Dark Caster simply stopped fighting."
    bm "也有人说那位暗系施法者只是忽然不打了。"

# game/chapters/chapter_two/chapter_two.rpy:597
translate schinese chapter_two_scene_six_fbf125cd:

    # bm "What we do know is that many people suffered…"
    bm "我们确知的是，无数人因此受难……"

# game/chapters/chapter_two/chapter_two.rpy:598
translate schinese chapter_two_scene_six_9fd839fe:

    # bm "And so, since then we have looked for ways to keep the peace."
    bm "所以从那以后，我们就一直在寻找维持和平的方法。"

# game/chapters/chapter_two/chapter_two.rpy:601
translate schinese chapter_two_scene_six_f244419d:

    # mc "What ended up happening in the Eastern Continent?"
    mc "东部大陆后来变成了什么样？"

# game/chapters/chapter_two/chapter_two.rpy:604
translate schinese chapter_two_scene_six_e4d284e7:

    # bm "It’s uninhabitable."
    bm "已经无法居住了。"

# game/chapters/chapter_two/chapter_two.rpy:607
translate schinese chapter_two_scene_six_fad651eb_2:

    # mc "Fascinating."
    mc "真有意思。"

# game/chapters/chapter_two/chapter_two.rpy:608
translate schinese chapter_two_scene_six_fa29a9fc:

    # mc "I’ll have to research more about the history of Eden."
    mc "我得多查一些伊甸的历史。"

# game/chapters/chapter_two/chapter_two.rpy:611
translate schinese chapter_two_scene_six_356aeaba:

    # bm "That can be arranged."
    bm "这个可以安排。"

# game/chapters/chapter_two/chapter_two.rpy:612
translate schinese chapter_two_scene_six_75dc10b2:

    # bm "It wouldn’t hurt to exchange information between each other."
    bm "我们互相交换情报也无妨。"

# game/chapters/chapter_two/chapter_two.rpy:615
translate schinese chapter_two_scene_six_fcf340b6:

    # mc "I agree."
    mc "我同意。"

# game/chapters/chapter_two/chapter_two.rpy:621
translate schinese chapter_two_scene_six_711b96b5:

    # mc "So, tell me about the Church of Luminox."
    mc "那么，跟我说说露米诺克斯教会吧。"

# game/chapters/chapter_two/chapter_two.rpy:624
translate schinese chapter_two_scene_six_bdc2c8a8:

    # bm "Well what would you like to know?"
    bm "你想知道些什么？"

# game/chapters/chapter_two/chapter_two.rpy:627
translate schinese chapter_two_scene_six_acb08c91:

    # mc "Everything, from beliefs to a summarized version of the origins."
    mc "全部，从信仰到起源的简述。"

# game/chapters/chapter_two/chapter_two.rpy:630
translate schinese chapter_two_scene_six_19c135ca:

    # bm "Let’s start off with our beliefs, then."
    bm "那就从我们的信仰说起。"

# game/chapters/chapter_two/chapter_two.rpy:633
translate schinese chapter_two_scene_six_b95002ff:

    # bm "Luminox is the goddess that created our world."
    bm "露米诺克斯是创造了我们的女神。"

# game/chapters/chapter_two/chapter_two.rpy:635
translate schinese chapter_two_scene_six_eec70415:

    # mc "Goddess?"
    mc "女神？"

# game/chapters/chapter_two/chapter_two.rpy:637
translate schinese chapter_two_scene_six_0c107af2:

    # bm "Yes, is that shocking?"
    bm "是的，很意外吗？"

# game/chapters/chapter_two/chapter_two.rpy:639
translate schinese chapter_two_scene_six_ffa7a75a:

    # mc "Not at all, just fascinating to learn about new religions."
    mc "一点也不，了解新宗教很有意思。"

# game/chapters/chapter_two/chapter_two.rpy:640
translate schinese chapter_two_scene_six_c83e0177:

    # mc "Is that way you’re all women here?"
    mc "所以你们这里都是女性？"

# game/chapters/chapter_two/chapter_two.rpy:642
translate schinese chapter_two_scene_six_fbaa8e7b:

    # bm "That would be correct."
    bm "可以这么说。"

# game/chapters/chapter_two/chapter_two.rpy:643
translate schinese chapter_two_scene_six_158cca05:

    # bm "Although men can’t be priests, they can become bishops."
    bm "虽然男性不能当祭司，但可以当主教。"

# game/chapters/chapter_two/chapter_two.rpy:645
translate schinese chapter_two_scene_six_672c05f1:

    # mc "Oh? And how does one become a bishop?"
    mc "哦？那要怎么才能成为主教？"

# game/chapters/chapter_two/chapter_two.rpy:648
translate schinese chapter_two_scene_six_9b353e70:

    # bm "It’s a long process, but anyone with high levels of Spiritual Energy can try to become a bishop."
    bm "这个过程很长，但任何灵力水平高的人都可以尝试成为主教。"

# game/chapters/chapter_two/chapter_two.rpy:649
translate schinese chapter_two_scene_six_af2cf4f3:

    # bm "After a lot of time training, they come before all the bishops and there is where we make a decision."
    bm "经过长期训练后，他们会在所有主教面前，由我们做出决定。"

# game/chapters/chapter_two/chapter_two.rpy:651
translate schinese chapter_two_scene_six_76370d7a:

    # mc "So very much a meritocracy?"
    mc "所以完全是任人唯贤？"

# game/chapters/chapter_two/chapter_two.rpy:653
translate schinese chapter_two_scene_six_bef4e38c:

    # bm "You do rely on luck in order to make it here in a sense."
    bm "某种意义上，走到这一步也需要运气。"

# game/chapters/chapter_two/chapter_two.rpy:654
translate schinese chapter_two_scene_six_19d802c5:

    # bm "But yes, if you have high levels of Spiritual Energy within you, as well as a high level of intelligence, you shouldn’t have any issue to spread your wings and fly."
    bm "但没错，如果你灵力充沛又足够聪明，展翅高飞不成问题。"

# game/chapters/chapter_two/chapter_two.rpy:656
translate schinese chapter_two_scene_six_a10455b4:

    # mc "I respect that."
    mc "我很欣赏这一点。"

# game/chapters/chapter_two/chapter_two.rpy:657
translate schinese chapter_two_scene_six_0395c2ee:

    # mc "Now…{w} how did the Church come to be?"
    mc "那么……{w}教会是怎么建立的？"

# game/chapters/chapter_two/chapter_two.rpy:660
translate schinese chapter_two_scene_six_e9bc900b:

    # bm "Let me begin by telling you about Luminox."
    bm "我先跟你说说露米诺克斯。"

# game/chapters/chapter_two/chapter_two.rpy:661
translate schinese chapter_two_scene_six_19fbf320:

    # bm "She is a benevolent goddess, creator of our world."
    bm "她是仁慈的女神，我们世界的创造者。"

# game/chapters/chapter_two/chapter_two.rpy:662
translate schinese chapter_two_scene_six_50db2b40:

    # bm "She is also the reason why we can use Spiritual Energy."
    bm "她也是我们能够运用灵力的原因。"

# game/chapters/chapter_two/chapter_two.rpy:665
translate schinese chapter_two_scene_six_23bbdb90:

    # mc "So Spiritual Energy is directly tied to the goddess?"
    mc "所以灵力直接与女神相连？"

# game/chapters/chapter_two/chapter_two.rpy:668
translate schinese chapter_two_scene_six_a7342a47:

    # bm "Yes, in a sense it’s our way of proving her existence."
    bm "是的，某种意义上这是我们证明她存在的方式。"

# game/chapters/chapter_two/chapter_two.rpy:671
translate schinese chapter_two_scene_six_edb3ab3a:

    # mc "By the mere existence of spiritual energy…"
    mc "仅仅因为灵力存在本身……"

# game/chapters/chapter_two/chapter_two.rpy:674
translate schinese chapter_two_scene_six_19d3bc98:

    # bm "Correct!"
    bm "没错！"

# game/chapters/chapter_two/chapter_two.rpy:677
translate schinese chapter_two_scene_six_cbc81447_1:

    # mc "Interesting…"
    mc "有意思……"

# game/chapters/chapter_two/chapter_two.rpy:678
translate schinese chapter_two_scene_six_b68d6992:

    # mc "What else can you tell me?"
    mc "你还能告诉我些什么？"

# game/chapters/chapter_two/chapter_two.rpy:679
translate schinese chapter_two_scene_six_16f337ee:

    # mc "Are there any other divinities?"
    mc "还有别的神祇吗？"

# game/chapters/chapter_two/chapter_two.rpy:682
translate schinese chapter_two_scene_six_77c26729:

    # bm "Yes, smaller ones that came forth from Luminox herself."
    bm "有，是从露米诺克斯身上诞生的较小神祇。"

# game/chapters/chapter_two/chapter_two.rpy:683
translate schinese chapter_two_scene_six_73a34491:

    # bm "We know them as the Divinarchs."
    bm "我们称他们为天枢。"

# game/chapters/chapter_two/chapter_two.rpy:684
translate schinese chapter_two_scene_six_4114434c:

    # bm "There are six and each of them is in charge of one of the Spiritual Energies we see present in people."
    bm "一共有六位，各自掌管我们所见的一种灵力。"

# game/chapters/chapter_two/chapter_two.rpy:687
translate schinese chapter_two_scene_six_297ec99f:

    # mc "You don’t say?"
    mc "不会吧？"

# game/chapters/chapter_two/chapter_two.rpy:688
translate schinese chapter_two_scene_six_4b48b3bb:

    # mc "I would love to learn about them someday."
    mc "我很希望有一天能了解他们。"

# game/chapters/chapter_two/chapter_two.rpy:691
translate schinese chapter_two_scene_six_b5236be0:

    # bm "*Chuckles* Perhaps you could convince Ravena to come along with you?"
    bm "*轻笑* 也许你可以说服拉维娜跟你一起去？"

# game/chapters/chapter_two/chapter_two.rpy:694
translate schinese chapter_two_scene_six_e239cbd3:

    # mc "I can certainly try."
    mc "我一定试试。"

# game/chapters/chapter_two/chapter_two.rpy:701
translate schinese chapter_two_scene_six_1d309b56:

    # bm "The girls should be arriving soon, would you like to head over to the changing room?"
    bm "她们应该快到了，您要去更衣室吗？"

# game/chapters/chapter_two/chapter_two.rpy:704
translate schinese chapter_two_scene_six_505b218b:

    # mc "I would love that."
    mc "我很乐意。"

# game/chapters/chapter_two/chapter_two.rpy:707
translate schinese chapter_two_scene_six_8c245ce9:

    # bm "Certainly.{w} Selena?"
    bm "好的。{w}塞莱娜？"

# game/chapters/chapter_two/chapter_two.rpy:710
translate schinese chapter_two_scene_six_e32e5816:

    # se "Yes, bishop?"
    se "是的，主教？"

# game/chapters/chapter_two/chapter_two.rpy:713
translate schinese chapter_two_scene_six_e2a6183d:

    # bm "Please show our esteemed guest to the room where he can change."
    bm "请带我们尊贵的客人去换衣服的房间。"

# game/chapters/chapter_two/chapter_two.rpy:716
translate schinese chapter_two_scene_six_77bd9dec:

    # se "Certainly."
    se "当然可以。"

# game/chapters/chapter_two/chapter_two.rpy:720
translate schinese chapter_two_scene_six_bc10f61a:

    # se "Right this way, good sir."
    se "这边请，先生。"

# game/chapters/chapter_two/chapter_two.rpy:723
translate schinese chapter_two_scene_six_e0ba7f6b:

    # rav "Oh! Hi you two!"
    rav "哦！嗨，你们两位好！"

# game/chapters/chapter_two/chapter_two.rpy:726
translate schinese chapter_two_scene_six_7360133e:

    # mc "Wow… you all look beautiful…"
    mc "哇……你们都很美……"

# game/chapters/chapter_two/chapter_two.rpy:729
translate schinese chapter_two_scene_six_13d0e325:

    # gi "Why thank you, officer."
    gi "哪里，警官您过奖了。"

# game/chapters/chapter_two/chapter_two.rpy:731
translate schinese chapter_two_scene_six_40ea8a1e:

    # na "You are too sweet!"
    na "你太会说话了！"

# game/chapters/chapter_two/chapter_two.rpy:734
translate schinese chapter_two_scene_six_38fb3ce7_3:

    # yu "..."
    yu "……"

# game/chapters/chapter_two/chapter_two.rpy:737
translate schinese chapter_two_scene_six_d0090033:

    # rav "I think you broke our Yuki."
    rav "我觉得我们由纪被你说得不好意思了。"

# game/chapters/chapter_two/chapter_two.rpy:740
translate schinese chapter_two_scene_six_f8020cf4:

    # mc "*Chuckles* My bad, my bad."
    mc "*笑*我的错我的错。"

# game/chapters/chapter_two/chapter_two.rpy:741
translate schinese chapter_two_scene_six_2ef2bc02:

    # mc "I’ll be right back in a few, ‘kay?"
    mc "我一会儿就回来，好吗？"

# game/chapters/chapter_two/chapter_two.rpy:744
translate schinese chapter_two_scene_six_65d3dd99:

    # se "So…{w} you’re from another world?"
    se "那个……{w}你来自另一个世界？"

# game/chapters/chapter_two/chapter_two.rpy:747
translate schinese chapter_two_scene_six_45701026:

    # mc "Yep…"
    mc "对……"

# game/chapters/chapter_two/chapter_two.rpy:748
translate schinese chapter_two_scene_six_945625d7:

    # mc "Kinda crazy don’t you think?"
    mc "挺疯狂的吧？"

# game/chapters/chapter_two/chapter_two.rpy:751
translate schinese chapter_two_scene_six_8cbc68c2:

    # se "Absolutely."
    se "绝对保证。"

# game/chapters/chapter_two/chapter_two.rpy:752
translate schinese chapter_two_scene_six_0238e309:

    # se "I can’t believe there are different worlds out there."
    se "我不敢相信外面还有不同的世界。"

# game/chapters/chapter_two/chapter_two.rpy:755
translate schinese chapter_two_scene_six_5b9ee039:

    # mc "Trust me, I’m as shocked as you are."
    mc "相信我，我和你一样震惊。"

# game/chapters/chapter_two/chapter_two.rpy:756
translate schinese chapter_two_scene_six_15be036c:

    # mc "So… you’re a priestess?"
    mc "那个……你是女祭司？"

# game/chapters/chapter_two/chapter_two.rpy:759
translate schinese chapter_two_scene_six_7a9d20b5:

    # se "I am!"
    se "是的！"

# game/chapters/chapter_two/chapter_two.rpy:760
translate schinese chapter_two_scene_six_1932815e:

    # se "Do you have priestesses in your world?"
    se "你们世界有女祭司吗？"

# game/chapters/chapter_two/chapter_two.rpy:763
translate schinese chapter_two_scene_six_fdf0a355:

    # mc "I guess yes, although men tend to be the ones that are more often portrayed as priests."
    mc "应该是有的，不过男性更常被塑造成祭司。"

# game/chapters/chapter_two/chapter_two.rpy:766
translate schinese chapter_two_scene_six_e3562089:

    # se "Is that so?"
    se "是吗？"

# game/chapters/chapter_two/chapter_two.rpy:769
translate schinese chapter_two_scene_six_79deecbe:

    # mc "Indeed."
    mc "正是。"

# game/chapters/chapter_two/chapter_two.rpy:770
translate schinese chapter_two_scene_six_fd4978c4:

    # mc "What’s it like to be a priestess?"
    mc "当女祭司是什么感觉？"

# game/chapters/chapter_two/chapter_two.rpy:773
translate schinese chapter_two_scene_six_e005b071:

    # se "Oh, it’s splendid!"
    se "哦，棒极了！"

# game/chapters/chapter_two/chapter_two.rpy:776
translate schinese chapter_two_scene_six_822aa5c3:

    # mc "How so?"
    mc "怎么说？"

# game/chapters/chapter_two/chapter_two.rpy:779
translate schinese chapter_two_scene_six_b3235e21:

    # se "I simply adore serving people."
    se "我非常喜欢服务他人。"

# game/chapters/chapter_two/chapter_two.rpy:780
translate schinese chapter_two_scene_six_7db060df:

    # se "We get to see the impact we make on our kingdom as well."
    se "我们还能看到自己对王国产生的影响。"

# game/chapters/chapter_two/chapter_two.rpy:781
translate schinese chapter_two_scene_six_d3875a5e:

    # se "I am so glad the chancellor increased the Church’s funding!"
    se "我太高兴宰相增加了教会的拨款！"

# game/chapters/chapter_two/chapter_two.rpy:782
translate schinese chapter_two_scene_six_89e4163b:

    # se "We really needed it…"
    se "我们确实很需要……"

# game/chapters/chapter_two/chapter_two.rpy:785
translate schinese chapter_two_scene_six_437e5e87:

    # mc "Interesting… what do you use most of the money for?"
    mc "有意思……钱主要花在什么地方？"

# game/chapters/chapter_two/chapter_two.rpy:788
translate schinese chapter_two_scene_six_7c7f4322:

    # se "Well, for one we need to purchase materials to build housing for people in need."
