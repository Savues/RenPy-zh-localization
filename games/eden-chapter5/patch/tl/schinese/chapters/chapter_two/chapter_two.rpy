    # wi "This tea is the yield of your efforts."
    wi "这茶是你们努力的成果。"

# game/chapters/chapter_two/chapter_two.rpy:3958
translate schinese chapter_two_scene_eleven_62aee8da_1:

    # wi "A sort of perfect balance between the four of you."
    wi "你们四人之间某种完美的平衡。"

# game/chapters/chapter_two/chapter_two.rpy:3961
translate schinese chapter_two_scene_eleven_b2b9e19d_1:

    # mc "What do you mean?"
    mc "什么意思？"

# game/chapters/chapter_two/chapter_two.rpy:3964
translate schinese chapter_two_scene_eleven_0bc925d7_1:

    # na "Each one of us solved a puzzle…"
    na "我们每个人都解了一个谜题……"

# game/chapters/chapter_two/chapter_two.rpy:3965
translate schinese chapter_two_scene_eleven_4d52ca10_1:

    # na "Moreover the puzzles all followed the theme of the elements…"
    na "而且谜题都以元素为主题……"

# game/chapters/chapter_two/chapter_two.rpy:3968
translate schinese chapter_two_scene_eleven_a90dba53_1:

    # wi "Correct. Like I said, balance."
    wi "没错。就像我说的，平衡。"

# game/chapters/chapter_two/chapter_two.rpy:3969
translate schinese chapter_two_scene_eleven_f3e541d5_1:

    # wi "One can only find the truth if they are willing to learn from everything."
    wi "只有愿意从一切中学习的人，才能找到真相。"

# game/chapters/chapter_two/chapter_two.rpy:3972
translate schinese chapter_two_scene_eleven_f05f3b28_1:

    # na "*To herself* Holy shit she’s like Palps…"
    na "*自言自语* 我的天她好像帕尔普斯……"

# game/chapters/chapter_two/chapter_two.rpy:3975
translate schinese chapter_two_scene_eleven_27b3b059_1:

    # wi "*Chuckles* Yes, Dark Spiritual Energy is important to learn from, rather than fear."
    wi "*轻笑* 是的，暗灵力值得学习，而不是恐惧。"

# game/chapters/chapter_two/chapter_two.rpy:3978
translate schinese chapter_two_scene_eleven_54ada626_1:

    # mc "As much as I agree, does Dark Spiritual Energy not corrupt?"
    mc "虽然我同意，但暗灵力不是会腐蚀人心吗？"

# game/chapters/chapter_two/chapter_two.rpy:3981
translate schinese chapter_two_scene_eleven_b78ea284_1:

    # wi "It could, as it is the most powerful type of magic."
    wi "可能会，因为它是最强大的魔法。"

# game/chapters/chapter_two/chapter_two.rpy:3982
translate schinese chapter_two_scene_eleven_c03ab853_1:

    # wi "It also goes by unperceived."
    wi "它还有个别名，叫\"不可感知\"。"

# game/chapters/chapter_two/chapter_two.rpy:3983
translate schinese chapter_two_scene_eleven_d2840432_1:

    # wi "So the few Dark Casters that have lived end up amassing quite a large amount of power."
    wi "所以历代少数暗系施法者最终都积累了相当庞大的力量。"

# game/chapters/chapter_two/chapter_two.rpy:3984
translate schinese chapter_two_scene_eleven_1d004ff6_1:

    # wi "Naturally, the fact that they cannot be sensed makes them more unpredictable."
    wi "自然而然，无法被感知让他们更难以预测。"

# game/chapters/chapter_two/chapter_two.rpy:3987
translate schinese chapter_two_scene_eleven_c372dd77_1:

    # mc "And that leads to them being feared."
    mc "这就让他们被恐惧。"

# game/chapters/chapter_two/chapter_two.rpy:3990
translate schinese chapter_two_scene_eleven_cb014812_2:

    # wi "Indeed."
    wi "正是。"

# game/chapters/chapter_two/chapter_two.rpy:3993
translate schinese chapter_two_scene_eleven_ffe74633_1:

    # mc "Why do they call you a terrorist?"
    mc "为什么他们说你是恐怖分子？"

# game/chapters/chapter_two/chapter_two.rpy:3996
translate schinese chapter_two_scene_eleven_3148a85a_1:

    # wi "Jumping straight to it, huh?"
    wi "你还真直接。"

# game/chapters/chapter_two/chapter_two.rpy:3999
translate schinese chapter_two_scene_eleven_8157f955_1:

    # mc "I don’t like wasting time."
    mc "我不喜欢浪费时间。"

# game/chapters/chapter_two/chapter_two.rpy:4002
translate schinese chapter_two_scene_eleven_86ad2442_1:

    # wi "Good. Neither do I."
    wi "很好，我也不喜欢。"

# game/chapters/chapter_two/chapter_two.rpy:4003
translate schinese chapter_two_scene_eleven_17e4b22c_1:

    # wi "Like I said, people fear what they cannot comprehend."
    wi "就像我说的，人们恐惧自己无法理解的东西。"

# game/chapters/chapter_two/chapter_two.rpy:4006
translate schinese chapter_two_scene_eleven_c2dd63b4_1:

    # gi "Not that I’m against this…"
    gi "我倒不是反对这一点……"

# game/chapters/chapter_two/chapter_two.rpy:4007
translate schinese chapter_two_scene_eleven_47581507_1:

    # gi "But how do we know you’re not lying to us?"
    gi "但我们怎么知道你没在骗我们？"

# game/chapters/chapter_two/chapter_two.rpy:4010
translate schinese chapter_two_scene_eleven_6e406d5b_1:

    # mc "She’s powerful enough to create a whole other dimension…"
    mc "她强大到能创造另一个位面……"

# game/chapters/chapter_two/chapter_two.rpy:4011
translate schinese chapter_two_scene_eleven_7d2d5a94_1:

    # mc "She’d be more than powerful enough to wipe us out."
    mc "更别说把我们全灭掉了。"

# game/chapters/chapter_two/chapter_two.rpy:4014
translate schinese chapter_two_scene_eleven_9e23c644_1:

    # wi "You could tell..?"
    wi "你能看出来……？"

# game/chapters/chapter_two/chapter_two.rpy:4017
translate schinese chapter_two_scene_eleven_7c927b78_1:

    # mc "Yes?"
    mc "嗯？"

# game/chapters/chapter_two/chapter_two.rpy:4020
translate schinese chapter_two_scene_eleven_f36de606_1:

    # wi "This truly is wonderful."
    wi "这真是太妙了。"

# game/chapters/chapter_two/chapter_two.rpy:4023
translate schinese chapter_two_scene_eleven_c4734286_1:

    # mc "Why’s that?"
    mc "为什么？"

# game/chapters/chapter_two/chapter_two.rpy:4026
translate schinese chapter_two_scene_eleven_1afe331f_1:

    # wi "[playername], you were able to sense my power."
    wi "[playername]，你能感知到我的力量。"

# game/chapters/chapter_two/chapter_two.rpy:4029
translate schinese chapter_two_scene_eleven_dc37b0d2_1:

    # mc "Uh huh…"
    mc "嗯哼……"

# game/chapters/chapter_two/chapter_two.rpy:4030
translate schinese chapter_two_scene_eleven_9b288cdb_1:

    # mc "What does that have to do with-"
    mc "这跟——有什么关系？"

# game/chapters/chapter_two/chapter_two.rpy:4031
translate schinese chapter_two_scene_eleven_b8de06d3_1:

    # mc "Oh."
    mc "哦。"

# game/chapters/chapter_two/chapter_two.rpy:4032
translate schinese chapter_two_scene_eleven_645dbf3f_1:

    # mc "Wait so-"
    mc "等等，所以——"

# game/chapters/chapter_two/chapter_two.rpy:4035
translate schinese chapter_two_scene_eleven_beaf0eac_1:

    # wi "Yes, indeed."
    wi "是啊。"

# game/chapters/chapter_two/chapter_two.rpy:4036
translate schinese chapter_two_scene_eleven_7c6f7581_1:

    # wi "You are a Dark Caster."
    wi "你是暗系施法者。"

# game/chapters/chapter_two/chapter_two.rpy:4039
translate schinese chapter_two_scene_eleven_48978efd_1:

    # na "HOLY FUCK WHAT?!"
    na "我靠什么？！"

# game/chapters/chapter_two/chapter_two.rpy:4042
translate schinese chapter_two_scene_eleven_45346606_1:

    # wi "Yes, [playername] is one of the 3 Dark Casters in Eden."
    wi "是的，[playername]是伊甸三位暗系施法者之一。"

# game/chapters/chapter_two/chapter_two.rpy:4043
translate schinese chapter_two_scene_eleven_80a677b7_1:

    # wi "Now, let’s figure out your powers."
    wi "现在，我们来看看你的能力。"

# game/chapters/chapter_two/chapter_two.rpy:4046
translate schinese chapter_two_scene_eleven_7d06eabb_1:

    # wi "Would you ladies mind waiting for us here?"
    wi "两位介意在这里等我们一下吗？"

# game/chapters/chapter_two/chapter_two.rpy:4049
translate schinese chapter_two_scene_eleven_4f946589_1:

    # gi "Not at all, the tea is fantastic."
    gi "完全不介意，这茶太棒了。"

# game/chapters/chapter_two/chapter_two.rpy:4052
translate schinese chapter_two_scene_eleven_753328bb_1:

    # yu "W-w-where are you going?"
    yu "你、你们要去哪？"

# game/chapters/chapter_two/chapter_two.rpy:4055
translate schinese chapter_two_scene_eleven_57e3ad34_1:

    # wi "Don’t worry, sweet Yuki."
    wi "别担心，可爱的由纪。"

# game/chapters/chapter_two/chapter_two.rpy:4056
translate schinese chapter_two_scene_eleven_da2e9883_1:

    # wi "I won’t harm him."
    wi "我不会伤害他。"

# game/chapters/chapter_two/chapter_two.rpy:4057
translate schinese chapter_two_scene_eleven_915d6501_1:

    # wi "Witch’s Oath."
    wi "女巫的誓言。"

# game/chapters/chapter_two/chapter_two.rpy:4060
translate schinese chapter_two_scene_eleven_89636cf8_1:

    # na "This is so cool!"
    na "太酷了！"

# game/chapters/chapter_two/chapter_two.rpy:4061
translate schinese chapter_two_scene_eleven_7e758fea_1:

    # na "Okok! You guys go! We’ll be here waiting patiently!"
    na "好好好！你们去吧！我们在这儿乖乖等着！"

# game/chapters/chapter_two/chapter_two.rpy:4064
translate schinese chapter_two_scene_eleven_36bfff75_1:

    # wi "Follow me, [playername]."
    wi "跟我来，[playername]。"

# game/chapters/chapter_two/chapter_two.rpy:4068
translate schinese chapter_two_scene_eleven_7d0d7859_1:

    # mc "Wow, two scene changes."
    mc "哇，连换两次场景。"

# game/chapters/chapter_two/chapter_two.rpy:4071
translate schinese chapter_two_scene_eleven_965e8082_1:

    # mc "Is this your power?"
    mc "这是你的能力？"

# game/chapters/chapter_two/chapter_two.rpy:4074
translate schinese chapter_two_scene_eleven_cfee0a21_1:

    # wi "One of them."
    wi "其中之一。"

# game/chapters/chapter_two/chapter_two.rpy:4077
translate schinese chapter_two_scene_eleven_978904d2_1:

    # mc "How many do you have?"
    mc "你有多少种？"

# game/chapters/chapter_two/chapter_two.rpy:4080
translate schinese chapter_two_scene_eleven_e9c9885a_1:

    # wi "Technically two."
    wi "严格来说两种。"

# game/chapters/chapter_two/chapter_two.rpy:4081
translate schinese chapter_two_scene_eleven_37c140b2_1:

    # wi "I can create Time Pockets."
    wi "我能制造时间口袋。"

# game/chapters/chapter_two/chapter_two.rpy:4082
translate schinese chapter_two_scene_eleven_7099494c_1:

    # wi "And I can use all elements except for Light Spiritual Energy."
    wi "并且能使用除光灵力外的所有元素。"

# game/chapters/chapter_two/chapter_two.rpy:4085
translate schinese chapter_two_scene_eleven_23a67f69_1:

    # mc "No wonder the kingdom fears you."
    mc "难怪王国怕你。"

# game/chapters/chapter_two/chapter_two.rpy:4088
translate schinese chapter_two_scene_eleven_277002d9_1:

    # wi "Funnily enough, I wouldn’t hurt a fly."
    wi "说来奇怪，我不会伤一只苍蝇。"

# game/chapters/chapter_two/chapter_two.rpy:4091
translate schinese chapter_two_scene_eleven_e23d9613_1:

    # mc "I can feel that."
    mc "我感觉得到。"

# game/chapters/chapter_two/chapter_two.rpy:4092
translate schinese chapter_two_scene_eleven_63721c78_1:

    # mc "So… how are we going to determine my power?"
    mc "那么……我们该怎么确定我的能力？"

# game/chapters/chapter_two/chapter_two.rpy:4095
translate schinese chapter_two_scene_eleven_c00dfe6a_1:

    # wi "That is very simple."
    wi "那很简单。"

# game/chapters/chapter_two/chapter_two.rpy:4098
translate schinese chapter_two_scene_eleven_da26a134_1:

    # wi "Lend me your hand, please."
    wi "请把手借给我。"

# game/chapters/chapter_two/chapter_two.rpy:4101
translate schinese chapter_two_scene_eleven_3227db2c_1:

    # wi "Ahh… I see now."
    wi "啊……我明白了。"

# game/chapters/chapter_two/chapter_two.rpy:4102
translate schinese chapter_two_scene_eleven_def0ad19_1:

    # mc "What is it?"
    mc "怎么了？"

# game/chapters/chapter_two/chapter_two.rpy:4105
translate schinese chapter_two_scene_eleven_6a4a406c_1:

    # wi "You have the ability to form bonds with different beings."
    wi "你有与不同存在缔结羁绊的能力。"

# game/chapters/chapter_two/chapter_two.rpy:4108
translate schinese chapter_two_scene_eleven_2e7e69b5_1:

    # mc "Bonds?"
    mc "羁绊？"

# game/chapters/chapter_two/chapter_two.rpy:4111
translate schinese chapter_two_scene_eleven_7bd7eba2_1:

    # wi "Imagine a sort of contract."
    wi "可以理解为某种契约。"

# game/chapters/chapter_two/chapter_two.rpy:4114
translate schinese chapter_two_scene_eleven_f2992414_1:

    # mc "Fascinating… and these contracts will increase my powers?"
    mc "有意思……这些契约会增强我的力量？"

# game/chapters/chapter_two/chapter_two.rpy:4117
translate schinese chapter_two_scene_eleven_62854601_1:

    # wi "That, and you may summon them wherever you are."
    wi "不只是这样，你还能在任何地方召唤他们。"

# game/chapters/chapter_two/chapter_two.rpy:4120
translate schinese chapter_two_scene_eleven_f30c76e8_1:

    # mc "Are you serious?"
    mc "你认真的？"

# game/chapters/chapter_two/chapter_two.rpy:4121
translate schinese chapter_two_scene_eleven_ebedaf5b_1:

    # mc "That sounds broken as hell."
    mc "这也太强了吧。"

# game/chapters/chapter_two/chapter_two.rpy:4124
translate schinese chapter_two_scene_eleven_1a40eb6f_1:

    # wi "Excuse me?"
    wi "什么？"

# game/chapters/chapter_two/chapter_two.rpy:4127
translate schinese chapter_two_scene_eleven_03872a9d_1:

    # mc "Sorry, that sounds way too overpowered."
    mc "抱歉，这听起来强得离谱。"

# game/chapters/chapter_two/chapter_two.rpy:4130
translate schinese chapter_two_scene_eleven_b20c7b7c_2:

    # wi "To an extent, yes."
    wi "某种程度上，是的。"

# game/chapters/chapter_two/chapter_two.rpy:4131
translate schinese chapter_two_scene_eleven_4bc57d41_1:

    # wi "But you can only summon people once every 6 hours, and for a few seconds."
    wi "但你只能每六小时召唤一次，而且只能持续几秒。"

# game/chapters/chapter_two/chapter_two.rpy:4132
translate schinese chapter_two_scene_eleven_4d81c961_1:

    # wi "Although, you get more powerful as you form more bonds."
    wi "不过，你缔结的羁绊越多，就越强。"

# game/chapters/chapter_two/chapter_two.rpy:4135
translate schinese chapter_two_scene_eleven_1136fffc_1:

    # mc "That’s still pretty overpowered."
    mc "这还是强得离谱。"

# game/chapters/chapter_two/chapter_two.rpy:4138
translate schinese chapter_two_scene_eleven_33a09171_1:

    # wi "Perhaps."
    wi "也许吧。"

# game/chapters/chapter_two/chapter_two.rpy:4141
translate schinese chapter_two_scene_eleven_8836ef36_1:

    # mc "So… I’ve got a few questions if you don’t mind me asking..?"
    mc "那么……如果你不介意，我有几个问题……"

# game/chapters/chapter_two/chapter_two.rpy:4144
translate schinese chapter_two_scene_eleven_59d7fb83_1:

    # wi "Go ahead."
    wi "请说。"

# game/chapters/chapter_two/chapter_two.rpy:4147
translate schinese chapter_two_scene_eleven_d401bfd7_1:

    # mc "Why do you live in the forest and not go to another continent?"
    mc "你为什么住在森林里，不去别的大陆？"

# game/chapters/chapter_two/chapter_two.rpy:4150
translate schinese chapter_two_scene_eleven_64a002fa_1:

    # wi "Hmmm…"
    wi "嗯……"

# game/chapters/chapter_two/chapter_two.rpy:4151
translate schinese chapter_two_scene_eleven_e0b91f1a_1:

    # wi "That’s a good question."
    wi "这是个好问题。"

# game/chapters/chapter_two/chapter_two.rpy:4152
translate schinese chapter_two_scene_eleven_20d10f20_1:

    # wi "I guess I feel attached to the forest."
    wi "我想我对这片森林有感情吧。"

# game/chapters/chapter_two/chapter_two.rpy:4155
translate schinese chapter_two_scene_eleven_81709362_1:

    # mc "You do?"
    mc "你知道？"

# game/chapters/chapter_two/chapter_two.rpy:4158
translate schinese chapter_two_scene_eleven_b424fab1_1:

    # wi "Yes. It’s quite a beautiful place."
    wi "是啊，这里确实很美。"

# game/chapters/chapter_two/chapter_two.rpy:4159
translate schinese chapter_two_scene_eleven_351488c7_1:

    # wi "And I’ve already set up the protective barrier…"
    wi "而且我已经布下了防护结界……"

# game/chapters/chapter_two/chapter_two.rpy:4162
translate schinese chapter_two_scene_eleven_f6860237_1:

    # mc "Right… I thought that was you…"
    mc "好吧……我以为那是你的结界……"

# game/chapters/chapter_two/chapter_two.rpy:4163
translate schinese chapter_two_scene_eleven_7c051e80_1:

    # mc "Care explaining that?"
    mc "能解释一下吗？"

# game/chapters/chapter_two/chapter_two.rpy:4166
translate schinese chapter_two_scene_eleven_6ae03608_1:

    # wi "Of course."
    wi "当然。"

# game/chapters/chapter_two/chapter_two.rpy:4167
translate schinese chapter_two_scene_eleven_7a77444a_1:

    # wi "Think of the world as a place where all six types of Spiritual Energies coexist in perfect harmony. Balance."
    wi "把世界想象成六种灵力完美共存的地方。平衡。"

# game/chapters/chapter_two/chapter_two.rpy:4170
translate schinese chapter_two_scene_eleven_4e766c84_1:

    # wi "I can imagine Yuki, Natasha, and Gianna felt ill as they approached my house, yes?"
    wi "我猜由纪、娜塔莎和吉安娜靠近我家时感到不适，对吗？"

# game/chapters/chapter_two/chapter_two.rpy:4173
translate schinese chapter_two_scene_eleven_4a38e4a1_1:

    # mc "Correct, and when we were extremely close, I had a headache."
    mc "对，而且我们非常靠近的时候，我开始头疼。"

# game/chapters/chapter_two/chapter_two.rpy:4176
translate schinese chapter_two_scene_eleven_d5876160_1:

    # wi "Well, all I had to do was knock off the balance of the elements."
    wi "我要做的只是打破元素之间的平衡。"

# game/chapters/chapter_two/chapter_two.rpy:4177
translate schinese chapter_two_scene_eleven_1e8f8d57_1:

    # wi "By increasing Wind, Water, Fire, and Nature, I am able to distort the magic absorption of people that wander in here."
    wi "通过提高风、水、火与自然之力，我能扭曲误入此地之人的魔力吸收。"

# game/chapters/chapter_two/chapter_two.rpy:4180
translate schinese chapter_two_scene_eleven_edb49a08_1:

    # wi "So at first, they feel invigorated."
    wi "所以一开始，他们会感到精神一振。"

# game/chapters/chapter_two/chapter_two.rpy:4183
translate schinese chapter_two_scene_eleven_ff257f38_1:

    # wi "But too much of something is always bad."
    wi "但任何东西过量都不好。"

# game/chapters/chapter_two/chapter_two.rpy:4184
translate schinese chapter_two_scene_eleven_bbc2213d_1:

    # wi "A lack of balance will destroy you."
    wi "失去平衡会毁掉你。"

# game/chapters/chapter_two/chapter_two.rpy:4187
translate schinese chapter_two_scene_eleven_6a6cc917_1:

    # mc "Why did I get a headache towards the end, then?"
    mc "那我快到的时候为什么会头疼？"

# game/chapters/chapter_two/chapter_two.rpy:4190
translate schinese chapter_two_scene_eleven_e66d589a_1:

    # wi "Well, there I balance the elements again, but increase Dark and Light exponentially."
    wi "因为在那附近我又重新平衡了元素，但把暗与光成倍提升。"

# game/chapters/chapter_two/chapter_two.rpy:4191
translate schinese chapter_two_scene_eleven_35cec409_1:

    # wi "Making it quite literally impossible for a normal person to access this place."
    wi "让普通人根本无法进入这里。"

# game/chapters/chapter_two/chapter_two.rpy:4194
translate schinese chapter_two_scene_eleven_1a5b2b35_1:

    # mc "We’re not normal, though…"
    mc "不过我们不是普通人……"

# game/chapters/chapter_two/chapter_two.rpy:4197
translate schinese chapter_two_scene_eleven_4891510b_1:

    # wi "Correct, you’re from outside of this world."
    wi "没错，你们来自这个世界之外。"

# game/chapters/chapter_two/chapter_two.rpy:4200
translate schinese chapter_two_scene_eleven_07519a12_1:

    # mc "What about-"
    mc "那拉维娜呢——"

# game/chapters/chapter_two/chapter_two.rpy:4203
translate schinese chapter_two_scene_eleven_c95f3422_1:

    # wi "Ravena is one of the most powerful casters in the world."
    wi "拉维娜是世界上最强大的施法者之一。"

# game/chapters/chapter_two/chapter_two.rpy:4204
translate schinese chapter_two_scene_eleven_b88618fd_1:

    # wi "She’d breeze right through here."
    wi "她能轻松穿过这里。"

# game/chapters/chapter_two/chapter_two.rpy:4207
translate schinese chapter_two_scene_eleven_fad651eb_1:

    # mc "Fascinating."
    mc "真有意思。"

# game/chapters/chapter_two/chapter_two.rpy:4208
translate schinese chapter_two_scene_eleven_56c18279_1:

    # mc "I notice you talk a lot about balance… why?"
    mc "我注意到你很强调平衡……为什么？"

# game/chapters/chapter_two/chapter_two.rpy:4211
translate schinese chapter_two_scene_eleven_f5c9ce04_1:

    # wi "You truly are keen, detective."
    wi "侦探，你真是敏锐。"

# game/chapters/chapter_two/chapter_two.rpy:4212
translate schinese chapter_two_scene_eleven_cb5e85da_1:

    # wi "I don’t know how much Bishop Mara taught you, but we both belong to different schools of thought."
    wi "我不知道玛拉主教教了你多少，但我们属于不同的思想流派。"

# game/chapters/chapter_two/chapter_two.rpy:4215
translate schinese chapter_two_scene_eleven_849bf551_1:

    # wi "Bishop Mara is from the belief that Light Casters are blessed by Luminox herself."
    wi "玛拉主教信奉光系施法者受露米诺克斯亲自庇佑。"

# game/chapters/chapter_two/chapter_two.rpy:4216
translate schinese chapter_two_scene_eleven_fd5b0214_1:

    # wi "Meaning in the hierarchy of Spiritual Energies, Light is the highest one, and Dark is the lowest."
    wi "也就是说在灵力的位阶上，光最高，暗最低。"

# game/chapters/chapter_two/chapter_two.rpy:4219
translate schinese chapter_two_scene_eleven_8f9e7b05_1:

    # mc "And that has to do with the War 500 years ago?"
    mc "这跟五百年前的战争有关？"

# game/chapters/chapter_two/chapter_two.rpy:4222
translate schinese chapter_two_scene_eleven_cb014812_3:

    # wi "Indeed."
    wi "正是。"

# game/chapters/chapter_two/chapter_two.rpy:4223
translate schinese chapter_two_scene_eleven_2421a68c_1:

    # wi "That’s when we had a bit of a schism in the Church."
    wi "那时教会有了分裂。"

# game/chapters/chapter_two/chapter_two.rpy:4226
translate schinese chapter_two_scene_eleven_bb54adc5_1:

    # mc "We?"
    mc "我们？"

# game/chapters/chapter_two/chapter_two.rpy:4229
translate schinese chapter_two_scene_eleven_c1013f45_1:

    # wi "Oh yes, I am a firm believer in Luminox."
    wi "是啊，我坚定地信仰露米诺克斯。"

# game/chapters/chapter_two/chapter_two.rpy:4230
translate schinese chapter_two_scene_eleven_2042ad6d_1:

    # wi "In fact, I was a bishop many moons ago."
    wi "事实上，很多年前我也当过主教。"

# game/chapters/chapter_two/chapter_two.rpy:4233
translate schinese chapter_two_scene_eleven_da244b9a_1:

    # mc "What made you stop?"
    mc "是什么让你不当了？"

# game/chapters/chapter_two/chapter_two.rpy:4236
translate schinese chapter_two_scene_eleven_8d7753e5_1:

    # wi "Fear of Dark Casters and disagreements with the Church teachings."
    wi "害怕暗系施法者，以及与教会教义不合。"

# game/chapters/chapter_two/chapter_two.rpy:4237
translate schinese chapter_two_scene_eleven_9e26407a_1:

    # wi "They believe in a second divinity."
    wi "他们信仰第二位神祇。"

# game/chapters/chapter_two/chapter_two.rpy:4238
translate schinese chapter_two_scene_eleven_9b509d22_1:

    # wi "One that is Darkness personified."
    wi "一个黑暗的化身。"

# game/chapters/chapter_two/chapter_two.rpy:4241
translate schinese chapter_two_scene_eleven_7347e2c7_1:

    # mc "And you don’t believe in that?"
    mc "而你不信这个？"

# game/chapters/chapter_two/chapter_two.rpy:4244
translate schinese chapter_two_scene_eleven_b20c7b7c_3:

    # wi "To an extent, yes."
    wi "某种程度上，是的。"

# game/chapters/chapter_two/chapter_two.rpy:4245
translate schinese chapter_two_scene_eleven_8420e6ed_1:

    # wi "Even the most blatant lies hold some truth to them."
    wi "即使最露骨的谎言也含有几分真实。"

# game/chapters/chapter_two/chapter_two.rpy:4248
translate schinese chapter_two_scene_eleven_721d4483_1:

    # mc "What do you mean by that?"
    mc "你这话什么意思？"

# game/chapters/chapter_two/chapter_two.rpy:4250
translate schinese chapter_two_scene_eleven_b1f38266_1:

    # wi "Some creatures end up amassing enough power through their lives thanks to the blessings of Luminox."
    wi "有些存在因露米诺克斯的庇佑，一生积累了足够的力量。"

# game/chapters/chapter_two/chapter_two.rpy:4251
translate schinese chapter_two_scene_eleven_6d38418f_1:

    # wi "They end up ascending to what is known as a Celestiarch."
    wi "他们最终飞升为所谓的天枢。"

# game/chapters/chapter_two/chapter_two.rpy:4254
translate schinese chapter_two_scene_eleven_958a1dd8_1:

    # mc "I’m assuming that’s like a demi-god of some sort?"
    mc "我猜那算是某种次神？"

# game/chapters/chapter_two/chapter_two.rpy:4256
translate schinese chapter_two_scene_eleven_0640c8ad_1:

    # wi "Indeed!"
    wi "没错！"

# game/chapters/chapter_two/chapter_two.rpy:4257
translate schinese chapter_two_scene_eleven_dda9adce_1:

    # wi "A Dark Caster of 1500 years ago ascended to become a Celestiarch."
    wi "一千五百年前有一位暗系施法者飞升成了天枢。"

# game/chapters/chapter_two/chapter_two.rpy:4258
translate schinese chapter_two_scene_eleven_103e58b2_1:

    # wi "And so this is where we began to see a split in the Church…"
    wi "于是教会开始出现分裂……"

# game/chapters/chapter_two/chapter_two.rpy:4259
translate schinese chapter_two_scene_eleven_e090404e_1:

    # wi "He was so powerful, that people truly saw him on the same level as Luminox."
    wi "他如此强大，人们真的把他视为与露米诺克斯平级。"

# game/chapters/chapter_two/chapter_two.rpy:4262
translate schinese chapter_two_scene_eleven_a3afb29f_1:

    # mc "And during the war 500 years ago, I’m assuming people started revering him as a true god."
    mc "我猜五百年前那场战争期间，人们开始把他当作真正的神来崇拜。"

# game/chapters/chapter_two/chapter_two.rpy:4264
translate schinese chapter_two_scene_eleven_0cb94f58_1:

    # wi "A second one, alongside Luminox."
    wi "与露米诺克斯并列的第二位。"

# game/chapters/chapter_two/chapter_two.rpy:4265
translate schinese chapter_two_scene_eleven_e30e8a5a_1:

    # wi "So… the Church decided to make that one of its core beliefs."
    wi "所以……教会决定把这列为核心教义之一。"

# game/chapters/chapter_two/chapter_two.rpy:4266
translate schinese chapter_two_scene_eleven_8afe0475_1:

    # wi "Thus making all Dark Casters have to hide their identities."
    wi "于是所有暗系施法者都不得不隐藏身份。"

# game/chapters/chapter_two/chapter_two.rpy:4268
translate schinese chapter_two_scene_eleven_53aaf43d_1:

    # mc "That’s horrible…"
    mc "这太可怕了……"

# game/chapters/chapter_two/chapter_two.rpy:4271
translate schinese chapter_two_scene_eleven_7ee91151_1:

    # wi "It makes sense."
    wi "说得通。"

# game/chapters/chapter_two/chapter_two.rpy:4272
translate schinese chapter_two_scene_eleven_9389e3a5_1:

    # wi "The most brutal wars in our world’s history were caused by Dark Casters."
    wi "我们世界历史上最残酷的战争都是暗系施法者引起的。"

# game/chapters/chapter_two/chapter_two.rpy:4274
translate schinese chapter_two_scene_eleven_60d323ee_1:

    # mc "You’re awfully understanding for someone that’s been forced to be an outcast."
    mc "你对被驱逐的人倒是很理解。"

# game/chapters/chapter_two/chapter_two.rpy:4277
translate schinese chapter_two_scene_eleven_aff6639a_1:

    # wi "Funnily enough, I am quite satisfied with the little life I’ve built."
    wi "说来奇怪，我对自己建立的小日子还挺满意。"

# game/chapters/chapter_two/chapter_two.rpy:4278
translate schinese chapter_two_scene_eleven_164bc58d_1:

    # wi "I can pursue knowledge without anyone disturbing me."
    wi "我可以追求知识而没人打扰。"

# game/chapters/chapter_two/chapter_two.rpy:4281
translate schinese chapter_two_scene_eleven_55ab7740_1:

    # mc "That’s fair."
    mc "有道理。"

# game/chapters/chapter_two/chapter_two.rpy:4282
translate schinese chapter_two_scene_eleven_3a35b741_1:

    # mc "Going back to the whole balance thing… why do you believe in that?"
    mc "回到平衡这个话题……你为什么相信它？"

# game/chapters/chapter_two/chapter_two.rpy:4285
translate schinese chapter_two_scene_eleven_401fc652_1:

    # wi "All magic comes from Luminox."
    wi "一切魔法都源自露米诺克斯。"

# game/chapters/chapter_two/chapter_two.rpy:4286
translate schinese chapter_two_scene_eleven_9c356d52_1:

    # wi "Why would she create something implicitly evil?"
    wi "她为什么要创造本质邪恶的东西？"

# game/chapters/chapter_two/chapter_two.rpy:4287
translate schinese chapter_two_scene_eleven_c5704601_1:

    # wi "Spiritual Energy is, by nature, good."
    wi "灵力本质上是善的。"

# game/chapters/chapter_two/chapter_two.rpy:4288
translate schinese chapter_two_scene_eleven_a709c212_1:

    # wi "People are the ones that can pervert it into something evil."
    wi "是人会把它扭曲成邪恶。"

# game/chapters/chapter_two/chapter_two.rpy:4291
translate schinese chapter_two_scene_eleven_7bbab449_1:

    # mc "Fair point."
    mc "有道理。"

# game/chapters/chapter_two/chapter_two.rpy:4292
translate schinese chapter_two_scene_eleven_a7c84360_1:

    # mc "So then?"
    mc "所以？"

# game/chapters/chapter_two/chapter_two.rpy:4295
translate schinese chapter_two_scene_eleven_ec9044e1_1:

    # wi "If all magic comes from Luminox, one must find the balance between all the elements in order to get closer to her."
    wi "既然一切魔法都来自露米诺克斯，人就必须找到所有元素之间的平衡，才能更接近她。"

# game/chapters/chapter_two/chapter_two.rpy:4296
translate schinese chapter_two_scene_eleven_297460ab_1:

    # wi "Study all aspects of Spiritual Energy."
    wi "研究灵力的方方面面。"

# game/chapters/chapter_two/chapter_two.rpy:4299
translate schinese chapter_two_scene_eleven_4b27090d_1:

    # mc "You want to become a Celestiarch?"
    mc "你想成为天枢？"

# game/chapters/chapter_two/chapter_two.rpy:4302
translate schinese chapter_two_scene_eleven_3918ddaf_1:

    # wi "Oh heavens no!"
    wi "天哪才不是！"

# game/chapters/chapter_two/chapter_two.rpy:4303
translate schinese chapter_two_scene_eleven_2c83ab93_1:

    # wi "I simply want to understand Luminox better."
    wi "我只是想更好地理解露米诺克斯。"

# game/chapters/chapter_two/chapter_two.rpy:4304
translate schinese chapter_two_scene_eleven_2c610136_1:

    # wi "Pursuit of knowledge."
    wi "追求知识。"

# game/chapters/chapter_two/chapter_two.rpy:4307
translate schinese chapter_two_scene_eleven_190c9171_2:

    # mc "I see…"
    mc "我明白了……"

# game/chapters/chapter_two/chapter_two.rpy:4308
translate schinese chapter_two_scene_eleven_3014b2e6_1:

    # mc "Now, tell me the real reason why I’m here."
    mc "现在，告诉我我真正来这里的原因。"

# game/chapters/chapter_two/chapter_two.rpy:4311
translate schinese chapter_two_scene_eleven_7a6920ac_1:

    # wi "That’s awfully demanding of you, don’t you think?"
    wi "你这个要求也太高了吧？"

# game/chapters/chapter_two/chapter_two.rpy:4314
translate schinese chapter_two_scene_eleven_3710037d_1:

    # mc "Well?"
    mc "嗯？"

# game/chapters/chapter_two/chapter_two.rpy:4317
translate schinese chapter_two_scene_eleven_36bac59a_1:

    # wi "[playername]. You and your friends must prepare."
    wi "[playername]。你和你的朋友们必须做好准备。"

# game/chapters/chapter_two/chapter_two.rpy:4318
translate schinese chapter_two_scene_eleven_2472a54a_1:

    # wi "I cannot reveal why yet, but I must train you."
    wi "我还不能说为什么，但我必须训练你。"

# game/chapters/chapter_two/chapter_two.rpy:4321
translate schinese chapter_two_scene_eleven_95ebb1ad_1:

    # mc "You what?"
    mc "你要训练我？"

# game/chapters/chapter_two/chapter_two.rpy:4324
translate schinese chapter_two_scene_eleven_f2ec0f09_1:

    # wi "Yes. You must become more powerful."
    wi "是的。你必须变得更强。"

# game/chapters/chapter_two/chapter_two.rpy:4325
translate schinese chapter_two_scene_eleven_5c138e32_1:

    # wi "You must grow in order to protect those you care about."
    wi "你必须成长，才能保护你在乎的人。"

# game/chapters/chapter_two/chapter_two.rpy:4328
translate schinese chapter_two_scene_eleven_7f47a744_1:

    # mc "Protect them from what?"
    mc "保护他们免受什么？"

# game/chapters/chapter_two/chapter_two.rpy:4331
translate schinese chapter_two_scene_eleven_9a27542a_1:

    # wi "It is much too early to tell."
    wi "现在说还太早。"

# game/chapters/chapter_two/chapter_two.rpy:4332
translate schinese chapter_two_scene_eleven_9a0b50ad_1:

    # wi "But I shall train you from now on."
    wi "但从现在起我会训练你。"

# game/chapters/chapter_two/chapter_two.rpy:4335
translate schinese chapter_two_scene_eleven_6e296bda_1:

    # mc "So I’m just meant to stay here?"
    mc "所以我就该待在这里？"

# game/chapters/chapter_two/chapter_two.rpy:4338
translate schinese chapter_two_scene_eleven_f3678132_1:

    # wi "No."
    wi "不是。"

# game/chapters/chapter_two/chapter_two.rpy:4339
translate schinese chapter_two_scene_eleven_7c1c3844_1:

    # wi "We are to form a Spiritual Contract."
    wi "我们要缔结灵力契约。"

# game/chapters/chapter_two/chapter_two.rpy:4342
translate schinese chapter_two_scene_eleven_190c9171_3:

    # mc "I see…"
    mc "我明白了……"

# game/chapters/chapter_two/chapter_two.rpy:4343
translate schinese chapter_two_scene_eleven_657ccfc6_1:

    # mc "And we do that… how?"
    mc "怎么做……？"

# game/chapters/chapter_two/chapter_two.rpy:4346
translate schinese chapter_two_scene_eleven_b8b4f78f_1:

    # wi "Intercourse."
    wi "性交。"

# game/chapters/chapter_two/chapter_two.rpy:4349
translate schinese chapter_two_scene_eleven_fa73f44a_1:

    # mc "Oh cool."
    mc "哦，不错。"

# game/chapters/chapter_two/chapter_two.rpy:4350
translate schinese chapter_two_scene_eleven_34a1b9d4_1:

    # mc "Wait what?!"
    mc "等等什么？！"

# game/chapters/chapter_two/chapter_two.rpy:4353
translate schinese chapter_two_scene_eleven_566e4f68_1:

    # wi "Yes, in order to form a bond, you must have sexual intercourse with me."
    wi "是的，为了缔结羁绊，你必须和我发生性关系。"

# game/chapters/chapter_two/chapter_two.rpy:4356
translate schinese chapter_two_scene_eleven_ce19084f_1:

    # mc "That’s…"
    mc "那真是……"

# game/chapters/chapter_two/chapter_two.rpy:4357
translate schinese chapter_two_scene_eleven_da87ad01_1:

    # mc "That’s why you brought me here, huh?"
    mc "所以你把我带到这里就是为了这个，是吧？"

# game/chapters/chapter_two/chapter_two.rpy:4360
translate schinese chapter_two_scene_eleven_5149de73_1:

    # wi "Guilty as charged."
    wi "我认罪。"

# game/chapters/chapter_two/chapter_two.rpy:4363
translate schinese chapter_two_scene_eleven_b4a90e92_1:

    # mc "Hmmm…"
    mc "嗯……"

# game/chapters/chapter_two/chapter_two.rpy:4367
translate schinese chapter_two_scene_eleven_e7db10ad_1:

    # mc "Yeah… right…"
    mc "对……没错……"

# game/chapters/chapter_two/chapter_two.rpy:4370
translate schinese chapter_two_scene_eleven_aaa8dfcb_1:

    # wi "Called my bluff?"
    wi "被我拆穿了？"

# game/chapters/chapter_two/chapter_two.rpy:4381
translate schinese chapter_two_scene_twelve_61eca82f_1:

    # mc "So… what do we actually have to do?"
    mc "那么……我们到底要做什么？"

# game/chapters/chapter_two/chapter_two.rpy:4384
translate schinese chapter_two_scene_twelve_4e6de679_1:

    # wi "Oh it’s quite simple, really."
    wi "哦，其实很简单。"

# game/chapters/chapter_two/chapter_two.rpy:4385
translate schinese chapter_two_scene_twelve_05f43855_1:

    # wi "Barely an inconvenience."
    wi "一点都不麻烦。"

# game/chapters/chapter_two/chapter_two.rpy:4386
translate schinese chapter_two_scene_twelve_303142e7_1:

    # wi "Lend me your hand, real quick…"
    wi "把手借我一下……"

# game/chapters/chapter_two/chapter_two.rpy:4391
translate schinese chapter_two_scene_twelve_e7daac8f_1:

    # wi "Aaaand there we go…"
    wi "好——就是这样……"

# game/chapters/chapter_two/chapter_two.rpy:4394
translate schinese chapter_two_scene_twelve_c16fc788_1:

    # mc "Wait… just like that?"
    mc "等等……就这样？"

# game/chapters/chapter_two/chapter_two.rpy:4397
translate schinese chapter_two_scene_twelve_9a7b43c8_1:

    # wi "Yup…"
    wi "没错……"

# game/chapters/chapter_two/chapter_two.rpy:4400
translate schinese chapter_two_scene_twelve_0f978b21_1:

    # mc "That’s… anticlimactic…"
    mc "这……也太没高潮了……"

# game/chapters/chapter_two/chapter_two.rpy:4403
translate schinese chapter_two_scene_twelve_b7fc23b0_1:

    # wi "Were you expecting anything more?"
    wi "你还期待更多？"

# game/chapters/chapter_two/chapter_two.rpy:4406
translate schinese chapter_two_scene_twelve_7dc27b65_1:

    # mc "I guess something more… magical?"
    mc "我以为会有更……更神奇的过程？"

# game/chapters/chapter_two/chapter_two.rpy:4409
translate schinese chapter_two_scene_twelve_944359f6_1:

    # wi "Yeah…{w} sorry to disappoint…"
    wi "是啊……{w}抱歉让你失望……"

# game/chapters/chapter_two/chapter_two.rpy:4410
translate schinese chapter_two_scene_twelve_be239129_1:

    # wi "How are you feeling?"
    wi "感觉怎么样？"

# game/chapters/chapter_two/chapter_two.rpy:4413
translate schinese chapter_two_scene_twelve_372cb1f3_1:

    # mc "I guess the same..?"
    mc "我大概也一样……？"

# game/chapters/chapter_two/chapter_two.rpy:4416
translate schinese chapter_two_scene_twelve_9052a8be_1:

    # wi "It’s possible that you’ll start feeling the effects of this in a few hours."
    wi "你可能在几小时后开始感受到效果。"

# game/chapters/chapter_two/chapter_two.rpy:4417
translate schinese chapter_two_scene_twelve_ac80f25c_1:

    # wi "Don’t be alarmed if you start feeling nauseous and vomit."
    wi "如果开始恶心想吐，别惊慌。"

# game/chapters/chapter_two/chapter_two.rpy:4420
translate schinese chapter_two_scene_twelve_03058b42_2:

    # mc "Thank you, Sophia."
    mc "谢谢你，索菲娅。"

# game/chapters/chapter_two/chapter_two.rpy:4421
translate schinese chapter_two_scene_twelve_c3c4233a_1:

    # mc "Now, shall we join the ladies?"
    mc "现在，我们回去找她们吧？"

# game/chapters/chapter_two/chapter_two.rpy:4427
translate schinese chapter_two_scene_twelve_29e831c5_1:

    # mc "Okay, we’re back!"
    mc "好了，我们回来了！"

# game/chapters/chapter_two/chapter_two.rpy:4430
translate schinese chapter_two_scene_twelve_b1f44215_1:

    # na "Already?"
    na "这么快？"

# game/chapters/chapter_two/chapter_two.rpy:4431
translate schinese chapter_two_scene_twelve_584ac164_1:

    # na "That was quick."
    na "真快。"

# game/chapters/chapter_two/chapter_two.rpy:4434
translate schinese chapter_two_scene_twelve_7960dae3_1:

    # wi "We were there for a while."
    wi "我们在里面待了挺久。"

# game/chapters/chapter_two/chapter_two.rpy:4435
translate schinese chapter_two_scene_twelve_0eb8fb0a_1:

    # wi "Time flows differently in time pockets."
    wi "时间口袋里的时间流动方式不同。"

# game/chapters/chapter_two/chapter_two.rpy:4438
translate schinese chapter_two_scene_twelve_cd226e12_1:

    # gi "That’s really interesting."
    gi "真有意思。"

# game/chapters/chapter_two/chapter_two.rpy:4439
translate schinese chapter_two_scene_twelve_ca099232_1:

