    # lu "I know, I’m proud of her no matter what."
    lu "我知道，不管怎样我都为她骄傲。"

# game/chapters/chapter_two/fair_interactionables.rpy:1530
translate schinese miau_trivia_game_bd4fd5c9:

    # lu "Anyway, I’ll take her in, gotta work on some more stuff with her."
    lu "总之我先把她带走，还得再调教调教她。"

# game/chapters/chapter_two/fair_interactionables.rpy:1541
translate schinese tavern_part_two_7bdb7a77:

    # to "Spare some change for a drink?"
    to "施舍点零钱买杯酒？"

# game/chapters/chapter_two/fair_interactionables.rpy:1544
translate schinese tavern_part_two_e00a5a06:

    # rav "Ummm… who are you?"
    rav "呃……你是谁？"

# game/chapters/chapter_two/fair_interactionables.rpy:1547
translate schinese tavern_part_two_387bb85a:

    # to "How rude of me!"
    to "我这也太失礼了！"

# game/chapters/chapter_two/fair_interactionables.rpy:1549
translate schinese tavern_part_two_b3fe5566:

    # to "The name’s Tobias!"
    to "我叫托拜厄斯！"

# game/chapters/chapter_two/fair_interactionables.rpy:1552
translate schinese tavern_part_two_e7a023de:

    # to "I’m an adventurer, but buy me a drink and I’ll be a story-teller, too!"
    to "我是个冒险者，不过请我喝一杯，我还能当个说书人！"

# game/chapters/chapter_two/fair_interactionables.rpy:1555
translate schinese tavern_part_two_1cc8a6fa:

    # "Buy this man a drink?"
    "给这位先生买杯酒？"

# game/chapters/chapter_two/fair_interactionables.rpy:1561
translate schinese tavern_part_two_ef2ad121:

    # mc "Sure. We’ve got time to kill."
    mc "没问题，我们有的是时间。"

# game/chapters/chapter_two/fair_interactionables.rpy:1566
translate schinese tavern_part_two_addf3307:

    # to "Haha! You won’t be disappointed, my friend!"
    to "哈哈！你不会失望的，我的朋友！"

# game/chapters/chapter_two/fair_interactionables.rpy:1569
translate schinese tavern_part_two_0c3a805e:

    # to "Bartender! Another drink, if you will!"
    to "酒保！麻烦再来一杯！"

# game/chapters/chapter_two/fair_interactionables.rpy:1573
translate schinese tavern_part_two_0cc15600:

    # to "Ahhh! That hits the spot!"
    to "啊！这杯太到位了！"

# game/chapters/chapter_two/fair_interactionables.rpy:1576
translate schinese tavern_part_two_e4d6cf7e:

    # rav "So! You have a story for us?"
    rav "那么！你有故事要讲给我们听？"

# game/chapters/chapter_two/fair_interactionables.rpy:1579
translate schinese tavern_part_two_e6420622:

    # to "Yes, yes!"
    to "有有有！"

# game/chapters/chapter_two/fair_interactionables.rpy:1580
translate schinese tavern_part_two_561e834e:

    # to "I’ll tell you the story about…"
    to "我给你们讲讲……"

# game/chapters/chapter_two/fair_interactionables.rpy:1584
translate schinese tavern_part_two_a90d6dc6:

    # to "The Green Egg."
    to "绿鸡蛋的故事。"

# game/chapters/chapter_two/fair_interactionables.rpy:1587
translate schinese tavern_part_two_0200bf4d:

    # mc "The green egg?"
    mc "绿鸡蛋？"

# game/chapters/chapter_two/fair_interactionables.rpy:1590
translate schinese tavern_part_two_e6420622_1:

    # to "Yes, yes!"
    to "有有有！"

# game/chapters/chapter_two/fair_interactionables.rpy:1591
translate schinese tavern_part_two_0c551f9c:

    # to "Long ago, there was a very rich man."
    to "很久以前，有一位非常有钱的人。"

# game/chapters/chapter_two/fair_interactionables.rpy:1592
translate schinese tavern_part_two_58683610:

    # to "His wife had sadly passed away… but had left him with a son."
    to "他的妻子不幸去世了……但给他留下了一个儿子。"

# game/chapters/chapter_two/fair_interactionables.rpy:1595
translate schinese tavern_part_two_ebbbd541:

    # to "This rich man had quite literally all the riches in the world."
    to "这位富人几乎拥有世上所有的财富。"

# game/chapters/chapter_two/fair_interactionables.rpy:1596
translate schinese tavern_part_two_97f51bb5:

    # to "He lacked nothing."
    to "他什么都不缺。"

# game/chapters/chapter_two/fair_interactionables.rpy:1597
translate schinese tavern_part_two_69f0887d:

    # to "But his most prized possession was his son."
    to "但他最珍视的财产是儿子。"

# game/chapters/chapter_two/fair_interactionables.rpy:1600
translate schinese tavern_part_two_e0864737:

    # rav "Awww… that’s nice!"
    rav "啊啊……真好！"

# game/chapters/chapter_two/fair_interactionables.rpy:1603
translate schinese tavern_part_two_b3c988f7:

    # to "So… when the child turned 5, his father wanted to give him a gift!"
    to "于是……孩子5岁那年，父亲想送他一件礼物！"

# game/chapters/chapter_two/fair_interactionables.rpy:1604
translate schinese tavern_part_two_508506ab:

    # to "He said to his son, ‘Son, you are already 5 and I want to celebrate your birthday… what would you like?’"
    to "他对儿子说：‘儿子，你已经5岁了，我想庆祝你的生日……你想要什么？’"

# game/chapters/chapter_two/fair_interactionables.rpy:1605
translate schinese tavern_part_two_b5bb8af5:

    # to "To which the son replied that he’d like a green egg."
    to "儿子回答说，他想要一颗绿鸡蛋。"

# game/chapters/chapter_two/fair_interactionables.rpy:1608
translate schinese tavern_part_two_98f56873:

    # to "The father was perplexed, but decided to not question his son."
    to "父亲很费解，但决定不追问儿子。"

# game/chapters/chapter_two/fair_interactionables.rpy:1609
translate schinese tavern_part_two_7bb5f11e:

    # to "He bought an egg, and let his son have it."
    to "他买了颗鸡蛋，交给了儿子。"

# game/chapters/chapter_two/fair_interactionables.rpy:1610
translate schinese tavern_part_two_074e66e4:

    # to "The next day, he asked his son where the egg was, to which the son said, ‘I’ll tell you later.’"
    to "第二天，他问儿子鸡蛋在哪儿，儿子却说：‘我以后再告诉你。’"

# game/chapters/chapter_two/fair_interactionables.rpy:1613
translate schinese tavern_part_two_c49bb82a:

    # mc "What the…"
    mc "这什么……"

# game/chapters/chapter_two/fair_interactionables.rpy:1614
translate schinese tavern_part_two_10cff30a:

    # rav "That’s weird…"
    rav "真奇怪……"

# game/chapters/chapter_two/fair_interactionables.rpy:1617
translate schinese tavern_part_two_00d11531:

    # to "This behavior went on for many, many years."
    to "这样的情形持续了许许多多年。"

# game/chapters/chapter_two/fair_interactionables.rpy:1618
translate schinese tavern_part_two_a5f1be25:

    # to "The next birthday he asked for 10, then 25, then 50, until eventually he asked for 1000 green eggs."
    to "下一个生日他要10颗，然后25颗，然后50颗，最后他要了1000颗绿鸡蛋。"

# game/chapters/chapter_two/fair_interactionables.rpy:1619
translate schinese tavern_part_two_0a4d982e:

    # to "And every single time, the eggs would disappear the next day and the son would reply with the same cryptic answer."
    to "每一次，鸡蛋都会在第二天消失，儿子则给出同一个神秘的回答。"

# game/chapters/chapter_two/fair_interactionables.rpy:1622
translate schinese tavern_part_two_ec39651b:

    # to "Eventually, when the man’s son turned 20, he wanted to celebrate his birthday properly."
    to "终于，儿子20岁那年，他想好好庆祝一下生日。"

# game/chapters/chapter_two/fair_interactionables.rpy:1623
translate schinese tavern_part_two_5deb1c1d:

    # to "This time, he told his son that he had to ask for a real gift. The green eggs were driving him insane."
    to "这一次，他告诉儿子必须要个真正的礼物。绿鸡蛋快把他逼疯了。"

# game/chapters/chapter_two/fair_interactionables.rpy:1624
translate schinese tavern_part_two_6bf58c50:

    # to "Why would his son ask for so many green eggs?"
    to "儿子为什么要那么多绿鸡蛋呢？"

# game/chapters/chapter_two/fair_interactionables.rpy:1625
translate schinese tavern_part_two_dee0bd31:

    # to "And what the hell would happen to the eggs?"
    to "而且那些鸡蛋到底会怎么样？"

# game/chapters/chapter_two/fair_interactionables.rpy:1628
translate schinese tavern_part_two_676ad0b8:

    # mc "Yeah… I’d go crazy too."
    mc "换我……我也得疯。"

# game/chapters/chapter_two/fair_interactionables.rpy:1631
translate schinese tavern_part_two_b95a6677:

    # rav "[playername] shut up."
    rav "[playername]，闭嘴。"

# game/chapters/chapter_two/fair_interactionables.rpy:1634
translate schinese tavern_part_two_1e558a88:

    # rav "What happened next?"
    rav "接下来呢？"

# game/chapters/chapter_two/fair_interactionables.rpy:1637
translate schinese tavern_part_two_45a168df:

    # to "Well, the son ended up telling his father that he was right, and he’d like to receive something that could help with the business."
    to "结果儿子告诉父亲，父亲说得对，他想要一件能帮上生意的东西。"

# game/chapters/chapter_two/fair_interactionables.rpy:1638
translate schinese tavern_part_two_dba7b68b:

    # to "So he asked his father to buy him one of those fancy trade wagons."
    to "于是他让父亲买一辆那种气派的商用马车。"

# game/chapters/chapter_two/fair_interactionables.rpy:1641
translate schinese tavern_part_two_a6b3d3ef:

    # to "The father was delighted, until his son asked for the wagon to be filled to the brim with green eggs."
    to "父亲正高兴，直到儿子要求把马车装满绿鸡蛋。"

# game/chapters/chapter_two/fair_interactionables.rpy:1642
translate schinese tavern_part_two_a9387aca:

    # to "The father, of course, was not surprised, but also was starting to reach his breaking point."
    to "父亲当然不意外，但也快到极限了。"

# game/chapters/chapter_two/fair_interactionables.rpy:1645
translate schinese tavern_part_two_7034a77b:

    # to "At any rate, he got his son said wagon full of eggs."
    to "总之，他真的把儿子要的那辆车装满了鸡蛋。"

# game/chapters/chapter_two/fair_interactionables.rpy:1646
translate schinese tavern_part_two_84762c32:

    # to "Unsurprisingly enough, the green eggs had disappeared."
    to "毫不意外地，绿鸡蛋又消失了。"

# game/chapters/chapter_two/fair_interactionables.rpy:1647
translate schinese tavern_part_two_5979d4a7:

    # to "The whole mystery of the eggs was driving the poor man insane."
    to "鸡蛋的谜团快把可怜的父亲逼疯了。"

# game/chapters/chapter_two/fair_interactionables.rpy:1650
translate schinese tavern_part_two_b46702c6:

    # to "He truly loved his son, but what in the world was going through his son’s mind when he’d ask for that many eggs?"
    to "他是真的爱儿子，可儿子每次要那么多鸡蛋，心里到底在想什么？"

# game/chapters/chapter_two/fair_interactionables.rpy:1653
translate schinese tavern_part_two_8fdd8101:

    # to "And where in Luminox’s name would the eggs go?!"
    to "而且看在露米诺克斯的份上，那些鸡蛋到底去哪了？！"

# game/chapters/chapter_two/fair_interactionables.rpy:1654
translate schinese tavern_part_two_00d21cea:

    # to "At any rate, he decided that his son’s 21st birthday would be the last birthday he’d give his son a gift."
    to "总之，他决定儿子21岁生日是最后一次送礼物。"

# game/chapters/chapter_two/fair_interactionables.rpy:1657
translate schinese tavern_part_two_41094940:

    # to "So naturally, he wanted to give him something grand."
    to "于是他自然想送一份大礼。"

# game/chapters/chapter_two/fair_interactionables.rpy:1658
translate schinese tavern_part_two_be76fb86:

    # to "The son agreed, and said he’d like to have a huge manor in the outskirts of town."
    to "儿子答应了，说想要一座位于城郊的大庄园。"

# game/chapters/chapter_two/fair_interactionables.rpy:1661
translate schinese tavern_part_two_9f435431:

    # to "The father, delighted, hired the kingdom’s best architects to design the house, bought the finest materials in the continent, and hired the most famous builders’ guild to make the most splendid manor the kingdom had ever seen."
    to "父亲欣然答应，聘请王国最好的建筑师设计宅邸，买下大陆最上等的材料，还请了最著名的建筑公会，造出了王国史上最华丽的庄园。"

# game/chapters/chapter_two/fair_interactionables.rpy:1664
translate schinese tavern_part_two_a0655e26:

    # to "A few days before the son’s birthday, he told his father that he wanted the manor filled to the brim with green eggs."
    to "就在儿子生日前几天，他告诉父亲，要把庄园装满绿鸡蛋。"

# game/chapters/chapter_two/fair_interactionables.rpy:1667
translate schinese tavern_part_two_7d807857:

    # to "Unsurprisingly, the father had all already seen this coming, so he had the eggs on standby, but not only that…"
    to "毫不意外，父亲早就料到了，提前备好了鸡蛋，可不止这样……"

# game/chapters/chapter_two/fair_interactionables.rpy:1670
translate schinese tavern_part_two_15d69580:

    # to "He installed some visual crystals in the house, so that he could finally see what was going on with the green eggs."
    to "他在宅子里装了些影像水晶，好终于能看清绿鸡蛋到底怎么了。"

# game/chapters/chapter_two/fair_interactionables.rpy:1671
translate schinese tavern_part_two_f496cf15:

    # to "When night dawned, the father was sitting in his room, watching his son’s new house filled with eggs."
    to "夜幕降临，父亲坐在自己房间里，看着儿子装满鸡蛋的新宅。"

# game/chapters/chapter_two/fair_interactionables.rpy:1674
translate schinese tavern_part_two_12509d35:

    # to "However, as soon as the clock hit 3 in the morning, the crystals stopped transmitting an image."
    to "然而时钟一敲凌晨三点，水晶就停止了传送画面。"

# game/chapters/chapter_two/fair_interactionables.rpy:1675
translate schinese tavern_part_two_23509909:

    # to "When they came back, all the eggs were gone."
    to "画面恢复时，所有鸡蛋都不见了。"

# game/chapters/chapter_two/fair_interactionables.rpy:1678
translate schinese tavern_part_two_cb5df25c:

    # to "The father went insane."
    to "父亲疯了。"

# game/chapters/chapter_two/fair_interactionables.rpy:1679
translate schinese tavern_part_two_5aac475e:

    # to "And who could blame him?"
    to "谁又能怪他呢？"

# game/chapters/chapter_two/fair_interactionables.rpy:1680
translate schinese tavern_part_two_518cd38f:

    # to "This would make any man go crazy."
    to "换谁都得疯。"

# game/chapters/chapter_two/fair_interactionables.rpy:1683
translate schinese tavern_part_two_e3043f15:

    # to "He then decided to simply cut ties with his son."
    to "于是他决定干脆和儿子断绝关系。"

# game/chapters/chapter_two/fair_interactionables.rpy:1684
translate schinese tavern_part_two_2fe0b2d6:

    # to "A year later, on his son’s birthday, one of his son’s servants came to see the man."
    to "一年后儿子生日那天，儿子的一名仆从来找这位父亲。"

# game/chapters/chapter_two/fair_interactionables.rpy:1685
translate schinese tavern_part_two_05679cfc:

    # to "He was out of breath and pale, and bore horrible news."
    to "他气喘吁吁、脸色苍白，带来了可怕的消息。"

# game/chapters/chapter_two/fair_interactionables.rpy:1688
translate schinese tavern_part_two_906a12b2:

    # to "His son was dying."
    to "他的儿子快不行了。"

# game/chapters/chapter_two/fair_interactionables.rpy:1689
translate schinese tavern_part_two_636eb693:

    # to "The man ran to his son’s house, to be by his side in his last minutes."
    to "男子奔向儿子的宅子，想陪他走完最后几分钟。"

# game/chapters/chapter_two/fair_interactionables.rpy:1690
translate schinese tavern_part_two_c5d7d38a:

    # to "He had suddenly forgiven his son for the green eggs. After all, his son was his most prized possession."
    to "他突然原谅了儿子要绿鸡蛋这件事。毕竟儿子是他最珍视的财产。"

# game/chapters/chapter_two/fair_interactionables.rpy:1693
translate schinese tavern_part_two_de06ff76:

    # to "But one question lingered in the back of his mind."
    to "但有一个问题始终萦绕在他心头。"

# game/chapters/chapter_two/fair_interactionables.rpy:1694
translate schinese tavern_part_two_8096efbc:

    # to "One thing he simply had to know the answer to."
    to "有件事他非知道答案不可。"

# game/chapters/chapter_two/fair_interactionables.rpy:1697
translate schinese tavern_part_two_16986d69:

    # to "The man said, ‘son, you know I love you. You know I gave you everything. Will you please tell me now… what did you do with those green eggs?’"
    to "那人说：‘儿子，你知道我爱你，也知道我给了你一切。现在能不能告诉我……你到底拿那些绿鸡蛋做了什么？’"

# game/chapters/chapter_two/fair_interactionables.rpy:1698
translate schinese tavern_part_two_7235a490:

    # to "The son looked at his father with the most loving look."
    to "儿子用最慈爱的目光看着父亲。"

# game/chapters/chapter_two/fair_interactionables.rpy:1699
translate schinese tavern_part_two_26df65e4:

    # to "The kind of look you give someone when you have spent your entire life doing all you can for them."
    to "那是一个人用一生为对方做尽一切后，才会有的眼神。"

# game/chapters/chapter_two/fair_interactionables.rpy:1702
translate schinese tavern_part_two_9a3399b0:

    # to "And he says, ‘father, I truly am grateful for all you’ve done for me. I will now tell you what happened to the green eggs.’"
    to "他说：‘父亲，我真心感谢你为我做的一切。现在我告诉你那些绿鸡蛋去哪儿了。’"

# game/chapters/chapter_two/fair_interactionables.rpy:1703
translate schinese tavern_part_two_cb90c32e:

    # to "What happened to the green eggs was…"
    to "那些绿鸡蛋是……"

# game/chapters/chapter_two/fair_interactionables.rpy:1704
translate schinese tavern_part_two_9eddd69d:

    # to "And then, the son died."
    to "然后，儿子就死了。"

# game/chapters/chapter_two/fair_interactionables.rpy:1705
translate schinese tavern_part_two_79dde1e3:

    # to "The end."
    to "讲完了。"

# game/chapters/chapter_two/fair_interactionables.rpy:1706
translate schinese tavern_part_two_2b35b6fe:

    # mc "..."
    mc "……"

# game/chapters/chapter_two/fair_interactionables.rpy:1709
translate schinese tavern_part_two_7179822a:

    # rav "..."
    rav "……"

# game/chapters/chapter_two/fair_interactionables.rpy:1711
translate schinese tavern_part_two_15c05a93:

    # mc "WHAT THE FUCK WAS THAT?!"
    mc "那他妈是什么鬼？！"

# game/chapters/chapter_two/fair_interactionables.rpy:1712
translate schinese tavern_part_two_6c70edcd:

    # mc "THAT’S GOTTA BE THE SHITTIEST STORY I’VE EVER HEARD!"
    mc "这绝对是我听过最烂的故事！"

# game/chapters/chapter_two/fair_interactionables.rpy:1715
translate schinese tavern_part_two_f97b1833:

    # to "Yes, but you heard A story."
    to "是啊，但你确实听到了一个故事。"

# game/chapters/chapter_two/fair_interactionables.rpy:1716
translate schinese tavern_part_two_781f3791:

    # to "I never promised it’d be good."
    to "我可没保证它会好听。"

# game/chapters/chapter_two/fair_interactionables.rpy:1719
translate schinese tavern_part_two_8420d24a:

    # rav "I swear to Luminox if I ever see you again I will make you and your descendants’ lives a living hell."
    rav "我对露米诺克斯发誓，再见到你，我就让你和你的后代过上生不如死的生活。"

# game/chapters/chapter_two/fair_interactionables.rpy:1722
translate schinese tavern_part_two_26c4aaf1:

    # to "Hehe seems like that’s my cue to leave."
    to "嘿嘿，看来我该闪人了。"

# game/chapters/chapter_two/fair_interactionables.rpy:1723
translate schinese tavern_part_two_3c1b28f8:

    # to "Thank you for the drink, friends!"
    to "谢谢你们的酒，朋友们！"

# game/chapters/chapter_two/fair_interactionables.rpy:1724
translate schinese tavern_part_two_828ea36b:

    # to "I will never forget this!"
    to "我永远不会忘记今天！"

# game/chapters/chapter_two/fair_interactionables.rpy:1725
translate schinese tavern_part_two_efd7a610:

    # to "Ta ta!"
    to "回见啦！"

# game/chapters/chapter_two/fair_interactionables.rpy:1728
