translate schinese clue_three_interlude_c57c689a_1:

    # mc "*Groggy* Huh? How long was I out?"
    mc "*迷迷糊糊* 嗯？我睡了多久？"

# game/chapters/chapter_one/chapter_one.rpy:1188
translate schinese clue_three_interlude_c874ff10_1:

    # na "A couple of hours."
    na "几个小时。"

# game/chapters/chapter_one/chapter_one.rpy:1191
translate schinese clue_three_interlude_3c1d965a_1:

    # mc "WHAT?!"
    mc "什么？！"

# game/chapters/chapter_one/chapter_one.rpy:1192
translate schinese clue_three_interlude_87c2a02a_1:

    # mc "Why didn’t you wake me up?"
    mc "你怎么不叫醒我？"

# game/chapters/chapter_one/chapter_one.rpy:1195
translate schinese clue_three_interlude_fe9a60af_1:

    # na "I know you don’t get much sleep because of work."
    na "我知道你工作很忙，平时睡得不多。"

# game/chapters/chapter_one/chapter_one.rpy:1196
translate schinese clue_three_interlude_a9ac87c1_1:

    # na "Plus you looked very peaceful."
    na "而且你睡得很安稳。"

# game/chapters/chapter_one/chapter_one.rpy:1197
translate schinese clue_three_interlude_2360e1af_1:

    # na "It also doesn’t seem like anyone will be asking us to check out since it technically is way past that."
    na "而且现在早就过了退房时间，估计也没人会来问我们了。"

# game/chapters/chapter_one/chapter_one.rpy:1198
translate schinese clue_three_interlude_4a48fc8a_1:

    # na "So… why not let you sleep?"
    na "所以……干嘛不让你多睡会儿？"

# game/chapters/chapter_one/chapter_one.rpy:1201
translate schinese clue_three_interlude_23271b93_1:

    # mc "Fair enough, I won’t argue with your logic."
    mc "行吧，你的逻辑我无法反驳。"

# game/chapters/chapter_one/chapter_one.rpy:1202
translate schinese clue_three_interlude_f23b50c1_1:

    # mc "Anyway, should we get back to solving this?"
    mc "总之，我们继续解这个谜吧？"

# game/chapters/chapter_one/chapter_one.rpy:1205
translate schinese clue_three_interlude_f8add5c5_1:

    # na "Yep!"
    na "没错！"

# game/chapters/chapter_one/chapter_one.rpy:1206
translate schinese clue_three_interlude_3a6111b2_1:

    # na "What was our next clue?"
    na "下一条线索是什么？"

# game/chapters/chapter_one/chapter_one.rpy:1209
translate schinese clue_three_interlude_4c4d0f4b_1:

    # mc "I think it said something about beer?"
    mc "我记得是跟啤酒有关的？"

# game/chapters/chapter_one/chapter_one.rpy:1212
translate schinese clue_three_interlude_6c575908_1:

    # na "Then let’s figure this out."
    na "那我们来解开它吧。"

# game/chapters/chapter_one/chapter_one.rpy:1217
translate schinese clue_three_interlude_cb2e5ba0_1:

    # mc "Listen… how about we talk about this later?"
    mc "听着……这个我们晚点再聊好吗？"

# game/chapters/chapter_one/chapter_one.rpy:1220
translate schinese clue_three_interlude_806a9cb0_1:

    # na "Oh no…"
    na "不……"

# game/chapters/chapter_one/chapter_one.rpy:1223
translate schinese clue_three_interlude_ea10552b_1:

    # mc "N-Nat?"
    mc "娜、娜塔？"

# game/chapters/chapter_one/chapter_one.rpy:1226
translate schinese clue_three_interlude_a7c63396_1:

    # na "D-don’t worry about it."
    na "别、别担心。"

# game/chapters/chapter_one/chapter_one.rpy:1227
translate schinese clue_three_interlude_59456fce_1:

    # na "Mind letting me close my eyes for a bit so I can rest?"
    na "能让我闭眼休息一下吗？"

# game/chapters/chapter_one/chapter_one.rpy:1230
translate schinese clue_three_interlude_606e2d02_1:

    # mc "Sure."
    mc "当然。"

# game/chapters/chapter_one/chapter_one.rpy:1231
translate schinese clue_three_interlude_62c2fb2c_1:

    # mc "I’ll be right beside you."
    mc "我就在你身边。"

