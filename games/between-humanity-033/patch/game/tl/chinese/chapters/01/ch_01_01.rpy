# game/chapters/01/ch_01_01.rpy:7
translate chinese ch01_01_preWakeUp_769465a8:

    # n "You can't feel, see, or hear anything... Enveloped in total darkness..."
    n "你感觉不到、看不到、也听不到任何东西……被彻底的黑暗所包裹……"

# game/chapters/01/ch_01_01.rpy:8
translate chinese ch01_01_preWakeUp_754a6cf3:

    # n "One would wonder - does emptiness have a sound?"
    n "人不免会想：虚空也有声音吗？"

# game/chapters/01/ch_01_01.rpy:11
translate chinese ch01_01_preWakeUp_cdf9fc8e:

    # n "Suddenly, your heartbeat kicks in."
    n "突然，你的心脏开始跳动。"

# game/chapters/01/ch_01_01.rpy:12
translate chinese ch01_01_preWakeUp_8fd77f75:

    # n "... And soon after so does your brain. The flash flood of information fills your mind."
    n "……然后很快你的大脑也开始恢复运转。信息的洪流填满了你的脑海。"

# game/chapters/01/ch_01_01.rpy:15
translate chinese ch01_01_preWakeUp_5a43d904:

    # mc.think "I... I remember now..."
    mc.think "我……我现在想起来了……"

# game/chapters/01/ch_01_01.rpy:16
translate chinese ch01_01_preWakeUp_4c63622a:

    # mc.think "I'm [mc.ColoredName], a nineteen-year-old college student."
    mc.think "我是[mc.ColoredName]，一个十九岁的大学生。"

# game/chapters/01/ch_01_01.rpy:17
translate chinese ch01_01_preWakeUp_146ff7c3:

    # mc.think "My- my parents died in an accident..."
    mc.think "我、我的父母……在一场事故中去世了……"

# game/chapters/01/ch_01_01.rpy:18
translate chinese ch01_01_preWakeUp_180b703e:

    # n "You quickly push these thoughts away."
    n "你迅速将这些思绪抛诸脑后。"

# game/chapters/01/ch_01_01.rpy:19
translate chinese ch01_01_preWakeUp_acae4446:

    # n "You try to focus on anything else, but all you sense is overwhelming lightlessness..."
    n "你试图专注于其他事情，但你感受到的只有无尽的黑暗……"

# game/chapters/01/ch_01_01.rpy:20
translate chinese ch01_01_preWakeUp_780fde18:

    # n "All the while, your brain continuously feeds you snippets of your life..."
    n "与此同时，你的大脑不停地往你脑子里塞进一段段人生片段……"

# game/chapters/01/ch_01_01.rpy:22
translate chinese ch01_01_preWakeUp_8b010362:

    # mc.think "I have friends...{w} I lived with my grandma...{w} I have a strong appreciation for women..."
    mc.think "我有朋友……{w}我和奶奶一起生活……{w}我很喜欢女孩子……"

# game/chapters/01/ch_01_01.rpy:23
translate chinese ch01_01_preWakeUp_101e858b:

    # mc.think "Dammit, brain, cut it out... Not now..."
    mc.think "该死，头好痛，别这样……现在不是时候……"

# game/chapters/01/ch_01_01.rpy:24
translate chinese ch01_01_preWakeUp_43b1c4c6:

    # n "A series of images then flashes before you..."
    n "一连串的画面在你眼前闪过……"

# game/chapters/01/ch_01_01.rpy:63
translate chinese ch01_01_thoughtFragments_0dfb522f:

    # mc.think "What...?{w=1} Why...?{w=1} How...?"
    mc.think "什么……？{w=1}为什么……？{w=1}怎么会……？"

# game/chapters/01/ch_01_01.rpy:70
translate chinese ch01_01_hospitalAwakening_4a4df5a7:

    # mc.think "{b}Argh{/b}...! What the hell is this noise...?"
    mc.think "{b}啊{/b}……！这该死的声音是什么……？"

# game/chapters/01/ch_01_01.rpy:71
translate chinese ch01_01_hospitalAwakening_79215908:

    # n "A monotonously dull yet harsh beeping easily cuts through the dark fog surrounding you."
    n "单调而刺耳的哔哔声轻易地穿透了你周围的黑雾。"

# game/chapters/01/ch_01_01.rpy:73
translate chinese ch01_01_hospitalAwakening_e594b26c:

    # mc.think "How come it's even louder now...?"
    mc.think "为什么现在变得更响了……？"

# game/chapters/01/ch_01_01.rpy:74
translate chinese ch01_01_hospitalAwakening_2baf130e:

    # mc.think "There's- something else, too... It sounds... familiar?"
    mc.think "还有……别的什么……听起来……有点熟悉？"

# game/chapters/01/ch_01_01.rpy:75
translate chinese ch01_01_hospitalAwakening_cb2d5d93:

    # n "The more you concentrate on the tone, the more you become aware of your body."
    n "你越是集中注意力听那个声音，你就越能意识到自己的身体状况。"

# game/chapters/01/ch_01_01.rpy:78
translate chinese ch01_01_hospitalAwakening_f195bc13:

    # anya.sayWOI "Why isn't he waking up?"
    anya.sayWOI "他为什么还不醒？"

# game/chapters/01/ch_01_01.rpy:79
translate chinese ch01_01_hospitalAwakening_f91713b5:

    # lucy.sayWOI "*sobs* I-I don't know. The doctors aren't sure, either."
    lucy.sayWOI "*抽泣*我……我不知道。医生们也不确定。"

# game/chapters/01/ch_01_01.rpy:80
translate chinese ch01_01_hospitalAwakening_6b9e2f92:

    # lucy.sayWOI "T-they said it was only a concussion and that he should be conscious, but-"
    lucy.sayWOI "他、他们说只是脑震荡，应该已经清醒了，可是——"

# game/chapters/01/ch_01_01.rpy:81
translate chinese ch01_01_hospitalAwakening_bb26177c:

    # anya.sayWOI "Hey, sis. It's not your fault, alright? Now come here... *hugs*"
    anya.sayWOI "嘿，姐姐。这不是你的错，好吗？现在过来……*拥抱*"

# game/chapters/01/ch_01_01.rpy:82
translate chinese ch01_01_hospitalAwakening_a5deb155:

    # anya.sayWOI "He'll be fine, I'm sure. Just trust the experts.{w} And him, too..."
    anya.sayWOI "他一定会没事的，我保证。{w}相信专家们吧……也相信他……"

# game/chapters/01/ch_01_01.rpy:83
translate chinese ch01_01_hospitalAwakening_2fe00839:

    # n "The voices grow fainter and blur as darkness envelops you once again..."
    n "随着黑暗再次将你吞没，那些声音也越来越弱、越来越模糊……"

# game/chapters/01/ch_01_01.rpy:88
translate chinese ch01_01_hospitalAwakening_e052383f:

    # naomi.sayWOI "Oh, sweetie, you still here?"
    naomi.sayWOI "哦，亲爱的，你还在这里吗？"

# game/chapters/01/ch_01_01.rpy:89
translate chinese ch01_01_hospitalAwakening_d87e3034:

    # naomi.sayWOI "It's getting late. You should go home now. Let me take care of him."
    naomi.sayWOI "天色已晚。你现在应该回家了。让我来照顾他吧。"

# game/chapters/01/ch_01_01.rpy:90
translate chinese ch01_01_hospitalAwakening_0184bd30:

    # lucy.sayWOI "B-but what if he wakes up..."
    lucy.sayWOI "但是……如果他醒了……"

# game/chapters/01/ch_01_01.rpy:91
translate chinese ch01_01_hospitalAwakening_533225f4:

    # naomi.sayWOI "Aww, honey... No buts, you're going home now. Okay?"
    naomi.sayWOI "哎，亲爱的……不许“但是”，你现在就得回家。好吗？"

# game/chapters/01/ch_01_01.rpy:92
translate chinese ch01_01_hospitalAwakening_21c88110:

    # naomi.sayWOI "The doctor told me you came here after school. That's a lot of time..."
    naomi.sayWOI "医生告诉我你放学后就过来了。待了这么久……"

# game/chapters/01/ch_01_01.rpy:93
translate chinese ch01_01_hospitalAwakening_20ece48a:

    # naomi.sayWOI "I promise to call you if he wakes up, alright?"
    naomi.sayWOI "我保证如果他醒了就给你打电话，好吗？"

# game/chapters/01/ch_01_01.rpy:94
translate chinese ch01_01_hospitalAwakening_5c8ca6a2:

    # lucy.sayWOI "O-okay. Thank you so much..."
    lucy.sayWOI "好、好的。真的非常谢谢你……"

# game/chapters/01/ch_01_01.rpy:95
translate chinese ch01_01_hospitalAwakening_12a04a19:

    # naomi.sayWOI "No problem, sweetie. Just leave me your number."
    naomi.sayWOI "没问题，亲爱的。把你的号码留给我。"

# game/chapters/01/ch_01_01.rpy:96
translate chinese ch01_01_hospitalAwakening_cf74e2c2:

    # mc.think "What the hell is happening here right now... Why can't I see? \nDo I even have eyes?"
    mc.think "这里到底发生了什么……为什么我看不见？\n我眼瞎了吗？"

# game/chapters/01/ch_01_01.rpy:101
translate chinese ch01_01_hospitalAwakening_16b7bfb2:

    # n "At once, you feel the heavy sensation of the dark being lifted."
    n "突然间，你感觉到黑暗的压迫感逐渐消退。"

# game/chapters/01/ch_01_01.rpy:102
translate chinese ch01_01_hospitalAwakening_7b24a6db:

    # n "Immediately, as if by a spell, someone's voice progressively cuts through the dark veil the more you focus on the real world."
    n "恍惚间，像是某种魔法生效一般——你越把注意力放回现实，那道声音就越能穿透黑暗的帷幕。"

# game/chapters/01/ch_01_01.rpy:103
translate chinese ch01_01_hospitalAwakening_7e30b576:

    # n "A soft, warm, and, more importantly, familiar voice..."
    n "一个温柔、温暖，更重要的是，熟悉的声音……"

# game/chapters/01/ch_01_01.rpy:104
translate chinese ch01_01_hospitalAwakening_7af22b2f:

    # n "And for the first time, the numbness separating your mind from your body lessens."
    n "这是第一次，隔开你的心智与身体的那层麻木，开始消退了。"

# game/chapters/01/ch_01_01.rpy:105
translate chinese ch01_01_hospitalAwakening_28573a94:

    # lucy.sayWOI "*sighs* I hope you'll wake up soon..."
    lucy.sayWOI "*叹气*我希望你能快点醒来……"

# game/chapters/01/ch_01_01.rpy:106
translate chinese ch01_01_hospitalAwakening_50e26a95:

    # n "You try to fixate on the voice to bring yourself to answer... \nTo say something... Anything..."
    n "你尝试仔细听那个声音，试图让自己回应……\n说些什么……任何话……"

# game/chapters/01/ch_01_01.rpy:107
translate chinese ch01_01_hospitalAwakening_c3b39327:

    # n "... But to no avail."
    n "……但都是徒劳的。"

# game/chapters/01/ch_01_01.rpy:108
translate chinese ch01_01_hospitalAwakening_8308b07a:

    # mc.think "Keep talking! Whatever you're saying, and whoever you are - \njust keep talking!"
    mc.think "继续说！无论你在说什么，无论你是谁——\n继续说下去！"

# game/chapters/01/ch_01_01.rpy:110
translate chinese ch01_01_hospitalAwakening_f5a8c7d9:

    # n "The beeping inside your head changes its rhythm and snaps you out of your thoughts."
    n "你脑海中的哔哔声改变了节奏，将你从思绪中拉回。"

# game/chapters/01/ch_01_01.rpy:111
translate chinese ch01_01_hospitalAwakening_583c873e:

    # n "Until now, you haven't noticed the harsh sound, but as soon as you think about it, it grows louder almost exponentially."
    n "直到现在你都没留意那刺耳的声音，可一旦留意到，它就像被放大了一样，陡然变响。"

# game/chapters/01/ch_01_01.rpy:121
translate chinese ch01_01_hospitalAwakening_b57b8612:

    # n "Finally, you open your eyes. And the first image is of... a ceiling."
    n "终于，你睁开了眼睛。第一眼看到的是……天花板。"

# game/chapters/01/ch_01_01.rpy:122
translate chinese ch01_01_hospitalAwakening_a40570e1:

    # n "(Could've been worse if you asked me...)"
    n "（如果你问我的话，可能会更糟……）"

# game/chapters/01/ch_01_01.rpy:124
translate chinese ch01_01_hospitalAwakening_35d36cdc:

    # lucy.sayWOI "They said you barely have a scratch, so why won't you just wake up? *sighs sadly*" with disText
    lucy.sayWOI "他们说你连擦伤都没有，那你怎么还不醒呢？*悲伤地叹了口气*" with disText

# game/chapters/01/ch_01_01.rpy:126
translate chinese ch01_01_hospitalAwakening_0d66ce42:

    # mc.think "A girl..." with disText
    mc.think "一个女孩……" with disText

# game/chapters/01/ch_01_01.rpy:128
translate chinese ch01_01_hospitalAwakening_e084f076:

    # lucy.sayWOI "*sighs again* You've been comatose for three days now, and they can't tell why." with disText
    lucy.sayWOI "*又叹了口气*你已经昏迷三天了，他们也不知道为什么。" with disText

# game/chapters/01/ch_01_01.rpy:129
translate chinese ch01_01_hospitalAwakening_3d41d2d8:

    # mc.think "Oh. That- that explains it..."
    mc.think "哦。那——那一切就解释清楚了……"

# game/chapters/01/ch_01_01.rpy:131
translate chinese ch01_01_hospitalAwakening_38a35e26:

    # lucy.sayWOI "What were you doing out there in the middle of the night anyway?" with disText
    lucy.sayWOI "话说你大半夜到底跑到外面干什么了？" with disText

# game/chapters/01/ch_01_01.rpy:132
translate chinese ch01_01_hospitalAwakening_e426d3b2:

    # lucy.sayWOI "You know how dangerous these parts get..."
    lucy.sayWOI "你知不知道这些地方有多危险……"

# game/chapters/01/ch_01_01.rpy:134
translate chinese ch01_01_hospitalAwakening_61d15b90:

    # n "You try to reply... To tell her that you're here... That you hear her..." with disText
    n "你试着回复……告诉她你醒了……你能听到她的声音……" with disText

# game/chapters/01/ch_01_01.rpy:135
translate chinese ch01_01_hospitalAwakening_29734bf5:

    # n "But nothing (ever) happens..."
    n "但什么也没发生……"

# game/chapters/01/ch_01_01.rpy:137
translate chinese ch01_01_hospitalAwakening_17d18a23:

    # lucy.sayWOI "Why did this happen to you, [mc.ColoredName]? Why you, of all people..." with disText
    lucy.sayWOI "为什么这种事会发生在你身上，[mc.ColoredName]？为什么偏偏是你……" with disText

# game/chapters/01/ch_01_01.rpy:141
translate chinese ch01_01_hospitalAwakening_fd44a8b2:

    # lucy.sayWOI "[mc.ColoredName]?! Y-you're awake! Can you hear me?!"
    lucy.sayWOI "[mc.ColoredName]？！你——你醒了！你能听到我说话吗？！"

# game/chapters/01/ch_01_01.rpy:142
translate chinese ch01_01_hospitalAwakening_33850ab3:

    # lucy.sayWOI "Oh my God, I'll go get the doctor!"
    lucy.sayWOI "哦，天哪，我去叫医生！"

# game/chapters/01/ch_01_01.rpy:144
translate chinese ch01_01_hospitalAwakening_57efddd9:

    # mc.think "No! {b}Wait!{/b} Don't- don't leave me..." with disText
    mc.think "不！{b}等等！{/b}别——别离开我……" with disText

# game/chapters/01/ch_01_01.rpy:146
translate chinese ch01_01_hospitalAwakening_7b9f858b:

    # n "You scream, but no sound escapes your lips."
    n "你拼命大喊，可一点声音也没能发出来。"

# game/chapters/01/ch_01_01.rpy:147
translate chinese ch01_01_hospitalAwakening_cb8b8da1:

    # n "Once more, you feel something stirring within you..."
    n "再一次，你感觉到内心有什么在涌动……"

# game/chapters/01/ch_01_01.rpy:148
translate chinese ch01_01_hospitalAwakening_90480d5c:

    # n "But before you can lose yourself in it, the warm female voice returns."
    n "但还没等你沉浸其中，那道温暖的女声就又回来了。"

# game/chapters/01/ch_01_01.rpy:150
translate chinese ch01_01_hospitalAwakening_3684e399:

    # lucy.sayWOI "He opened his eyes, Doctor!" with disText
    lucy.sayWOI "医生，他醒了！" with disText

# game/chapters/01/ch_01_01.rpy:152
translate chinese ch01_01_hospitalAwakening_dc297e06:

    # lucy.sayWOI "[mc.ColoredName]? [mc.ColoredName]?!" with disText
    lucy.sayWOI "[mc.ColoredName]？[mc.ColoredName]？！" with disText #ignore

# game/chapters/01/ch_01_01.rpy:154
translate chinese ch01_01_hospitalAwakening_a791cd67:

    # n "A shadow covers your eyes, but you slowly open them again as you feel the warmth of someone's soft fingers touching your arm."
    n "一片阴影覆上你的眼睛，但当你再次缓缓睁开时，有人柔软的手指正轻轻抚过你的手臂。"

# game/chapters/01/ch_01_01.rpy:156
translate chinese ch01_01_hospitalAwakening_7f448beb:

    # lucy.sayWOI "[mc.ColoredName]..."
    lucy.sayWOI "[mc.ColoredName]……"

# game/chapters/01/ch_01_01.rpy:158
translate chinese ch01_01_hospitalAwakening_9235b041:

    # n "Unexpectedly, an unfamiliar, deep male voice speaks coolly and firmly..."
    n "出乎意料的是，一个陌生的低沉男声冷静而坚定地开口……"

# game/chapters/01/ch_01_01.rpy:160
translate chinese ch01_01_hospitalAwakening_562bd81d:

    # doctor.sayWOI "[mc.ColoredName]? Can you hear me?" with disText
    doctor.sayWOI "[mc.ColoredName]？你能听到我说话吗？" with disText

# game/chapters/01/ch_01_01.rpy:165
translate chinese ch01_01_hospitalAwakening_61e0b0b1:

    # n "Before you can go back to the girl, your gaze meets with the man's friendly but cool eyes." with disText
    n "在你的目光重新回到女孩身上之前，你的目光撞上了男人友善而冷静的眼睛。" with disText

# game/chapters/01/ch_01_01.rpy:167
translate chinese ch01_01_hospitalAwakening_3de84dec:

    # doctor.sayWOI "Hello, [mc.ColoredName]. I'm [doctor.ColoredName]."
    doctor.sayWOI "你好，[mc.ColoredName]。我是[doctor.ColoredName]。"

# game/chapters/01/ch_01_01.rpy:168
translate chinese ch01_01_hospitalAwakening_648d4a5a:

    # n "[doctor.ColoredName] smiles briefly before a momentary furrow and uncertainty flash across his face."
    n "[doctor.ColoredName]礼貌的笑了一下，然后脸上闪过一丝皱眉和不确定。"

# game/chapters/01/ch_01_01.rpy:179
translate chinese ch01_01_hospitalAwakening_91e654b4:

    # doctor.say "It's good to see you conscious again. How are you feeling?" with disText
    doctor.say "很高兴看到你又清醒了。你感觉怎么样？" with disText

# game/chapters/01/ch_01_01.rpy:181
translate chinese ch01_01_hospitalAwakening_f935b760:

    # n "You try to speak again, but your voice is surprisingly weak and rough."
    n "你再次尝试说话，但你的声音出奇地虚弱和沙哑。"

# game/chapters/01/ch_01_01.rpy:183
translate chinese ch01_01_hospitalAwakening_a5696938:

    # mc.say "My... My head hurts..." with disText
    mc.say "我的……我头疼……" with disText

# game/chapters/01/ch_01_01.rpy:184
translate chinese ch01_01_hospitalAwakening_4c5dd9aa:

    # mc.say "Where- where am I?"
    mc.say "我现在在哪儿？"

# game/chapters/01/ch_01_01.rpy:186
translate chinese ch01_01_hospitalAwakening_d3028574:

    # doctor.say "That's understandable. You are, after all, still recovering from a concussion..." with disText
    doctor.say "可以理解。毕竟，你还在从脑震荡中恢复……" with disText

# game/chapters/01/ch_01_01.rpy:187
translate chinese ch01_01_hospitalAwakening_dd446bd0:

    # doctor.say "As to where - well, you are currently at {b}St. Mango Hospital{/b}."
    doctor.say "至于在哪儿——嗯，你现在在{b}圣芒果医院{/b}。"

# game/chapters/01/ch_01_01.rpy:188
translate chinese ch01_01_hospitalAwakening_dfccd8f9:

    # doctor.say "Your status is a result of a car accident, as far as we're aware."
    doctor.say "据我们所知，你的状态是由于一场车祸造成的。"

# game/chapters/01/ch_01_01.rpy:190
translate chinese ch01_01_hospitalAwakening_3469a7b2:

    # n "He glances down, and you watch him as he flips through your medical records." with disText
    n "他低下头，你看着他翻看你的医疗记录。" with disText

# game/chapters/01/ch_01_01.rpy:194
translate chinese ch01_01_hospitalAwakening_685efcf7:

    # doctor.say "Your vitals are looking good." with disText
    doctor.say "你的生命体征看起来不错。" with disText

# game/chapters/01/ch_01_01.rpy:195
translate chinese ch01_01_hospitalAwakening_d0f9596a:

    # doctor.say "We're unsure why you didn't wake up earlier, but now that you are, \nyour situation should start improving."
    doctor.say "我们不知道为什么你之前没有醒来，但你现在既然醒了，\n那么你的情况应该会开始好转。"

# game/chapters/01/ch_01_01.rpy:196
translate chinese ch01_01_hospitalAwakening_e04ab6ab:

    # doctor.say "Anyway, do you remember what happened before you woke up?"
    doctor.say "无论如何，你还记得在此之前发生了什么吗？"

# game/chapters/01/ch_01_01.rpy:198
translate chinese ch01_01_hospitalAwakening_14720fb0:

    # n "You're perplexed, trying to search for any memories of the accident. Everything seems covered by an unexplainable black curtain." with disText
    n "你很困惑，试图寻找任何关于事故的记忆。一切似乎都被一层无法解释的黑幕遮住了。" with disText

# game/chapters/01/ch_01_01.rpy:199
translate chinese ch01_01_hospitalAwakening_c3eaae13:

    # n "You look at the young girl leaning on the bed.{w} \nAnd suddenly, it all clicks..."
    n "你看着那个靠在床上的年轻女孩。{w}\n突然间，一切都清晰了……"

# game/chapters/01/ch_01_01.rpy:200
translate chinese ch01_01_hospitalAwakening_a419f177:

    # mc.say "{cps=16}... [lucy.ColoredName]?"
    mc.say "{cps=16}……[lucy.ColoredName]？"

# game/chapters/01/ch_01_01.rpy:202
translate chinese ch01_01_hospitalAwakening_3a3e6bfa:

    # lucy.say "*nodding happily* You- you remember me! I'm so relieved!"
    lucy.say "*开心地点头*你——你记得我！我太欣慰了！"

# game/chapters/01/ch_01_01.rpy:227
translate chinese ch01_01_hospitalAwakening_95b8adec:

    # mc.think "Were her boobs always this... big?!" with disText
    mc.think "她的胸部有这么大吗？！" with disText

# game/chapters/01/ch_01_01.rpy:228
translate chinese ch01_01_hospitalAwakening_8d686954:

    # mc.think "How did I not notice that?"
    mc.think "我之前竟然没注意到？"

# game/chapters/01/ch_01_01.rpy:235
translate chinese ch01_01_hospitalAwakening_bb98ed6e:

    # doctor.say "That's a good sign, [mc.ColoredName]." with disText
    doctor.say "看起来你恢复的还不错，[mc.ColoredName]。" with disText

# game/chapters/01/ch_01_01.rpy:236
translate chinese ch01_01_hospitalAwakening_5b2ad0e4:

    # doctor.say "Do you recall anything else about the accident?"
    doctor.say "你还记得事故的其他细节吗？"

# game/chapters/01/ch_01_01.rpy:238
translate chinese ch01_01_hospitalAwakening_e74c38dc:

    # mc.say "I..."
    mc.say "我……"

# game/chapters/01/ch_01_01.rpy:239
translate chinese ch01_01_hospitalAwakening_4adfaf8f:

    # mc.think "Fuck. There's nothing. As if someone wiped my memory..."
    mc.think "该死。什么都没有。就好像有人抹去了我的记忆一样……"

# game/chapters/01/ch_01_01.rpy:240
translate chinese ch01_01_hospitalAwakening_114cc964:

    # mc.think "Except for these voices..."
    mc.think "除了这些声音……"

# game/chapters/01/ch_01_01.rpy:242
translate chinese ch01_01_hospitalAwakening_0f802e84:

    # mc.say "I'm not sure, to be honest..."
    mc.say "老实说，我也不太确定……"

# game/chapters/01/ch_01_01.rpy:243
translate chinese ch01_01_hospitalAwakening_39ff2b9e:

    # mc.say "I have a feeling that I wasn't alone, but I really can't tell..."
    mc.say "我有一种感觉，我不是一个人，但我真的不知道……"

# game/chapters/01/ch_01_01.rpy:245
translate chinese ch01_01_hospitalAwakening_211095d5:

    # mc.think "Who was I with? Was I with friends?"
    mc.think "我和谁在一起来着？和朋友吗？"

# game/chapters/01/ch_01_01.rpy:246
translate chinese ch01_01_hospitalAwakening_a4e41a3c:

    # mc.think "I mean, they'd tell the staff if that's the case-"
    mc.think "我的意思是，如果是那样的话，他们会告诉工作人员的——"

# game/chapters/01/ch_01_01.rpy:247
translate chinese ch01_01_hospitalAwakening_e279d2c9:

    # n "You have a sudden realization, but it vanishes as quickly as it appears, leaving only a sharp pain behind."
    n "你突然想到了什么，但一下就消失了，就像从来没来过一样，只留下一阵剧痛。"

# game/chapters/01/ch_01_01.rpy:249
translate chinese ch01_01_hospitalAwakening_ede78e3d:

    # mc.say "*groans*" with disText
    mc.say "哎……" with disText

# game/chapters/01/ch_01_01.rpy:250
translate chinese ch01_01_hospitalAwakening_33672b9d:

    # mc.say "I have this... constant beeping in my head."
    mc.say "我脑子里一直有声音在嗡嗡作响。"

# game/chapters/01/ch_01_01.rpy:252
translate chinese ch01_01_hospitalAwakening_bf59aa52:

    # doctor.say "Are you talking about the heart rate monitor? I already turned it down, \nso this should fade..."
    doctor.say "你是在说心率监测器吗？我已经把它调低了，你应该很快就听不到了"

# game/chapters/01/ch_01_01.rpy:253
translate chinese ch01_01_hospitalAwakening_125cf20e:

    # doctor.say "... Or maybe it's a side effect of the accident."
    doctor.say "……或者可能是事故的副作用。"

# game/chapters/01/ch_01_01.rpy:254
translate chinese ch01_01_hospitalAwakening_2e89bec9:

    # doctor.say "As I said, you suffered from a concussion, but the memories will return as your brain recovers."
    doctor.say "就像我说的那样，你遭受了脑震荡，但记忆会随着大脑的恢复而逐渐回归。"

# game/chapters/01/ch_01_01.rpy:256
translate chinese ch01_01_hospitalAwakening_e6f6d9aa:

    # n "You focus on the girl standing by your side..." with disText
    n "你仔细看着站在你旁边的女孩……" with disText

# game/chapters/01/ch_01_01.rpy:257
translate chinese ch01_01_hospitalAwakening_12949983:

    # mc.think "[lucy.ColoredName]... My first college friend."
    mc.think "[lucy.ColoredName]……我的第一个大学朋友。"

# game/chapters/01/ch_01_01.rpy:258
translate chinese ch01_01_hospitalAwakening_82623a1b:

    # mc.think "She looked so lost standing in the hallway, so I approached her and asked where she needed to go..."
    mc.think "她当时站在走廊里看起来很迷茫，所以我走过去问她需要去哪里……"

# game/chapters/01/ch_01_01.rpy:259
translate chinese ch01_01_hospitalAwakening_51d758a1:

    # mc.think "As coincidence would have it, she would end up being my classmate."
    mc.think "巧的是，她是我的同学。"

# game/chapters/01/ch_01_01.rpy:260
translate chinese ch01_01_hospitalAwakening_f92fbcb7:

    # mc.think "And soon became one of my best friends, too..."
    mc.think "而且很快也成了我最好的朋友之一……"

# game/chapters/01/ch_01_01.rpy:263
translate chinese ch01_01_hospitalAwakening_c21e23ad:

    # mc.think "Crap. Did she see me staring?"
    mc.think "糟糕。她注意到我正在盯着她看了吗？"

# game/chapters/01/ch_01_01.rpy:265
translate chinese ch01_01_hospitalAwakening_6f17044e:

    # mc.think "What's wrong with me..." with disText
    mc.think "我到底是怎么了……" with disText

# game/chapters/01/ch_01_01.rpy:266
translate chinese ch01_01_hospitalAwakening_9d7b732d:

    # mc.think "Besides the obvious, that is..."
    mc.think "除了显而易见的事情之外……"

# game/chapters/01/ch_01_01.rpy:269
translate chinese ch01_01_hospitalAwakening_94039346:

    # mc.think "Oh shit, how long was I staring?"
    mc.think "哦，该死，我盯着她看了多久？"

# game/chapters/01/ch_01_01.rpy:271
translate chinese ch01_01_hospitalAwakening_16ceb5cb:

    # mc.think "I just hope she didn't take it the \"wrong\" way..." with disText
    mc.think "我只希望她没有“误会”……" with disText

# game/chapters/01/ch_01_01.rpy:273
translate chinese ch01_01_hospitalAwakening_f90f1a4c:

    # mc.say "So... What exactly happened to me? Do you know any specifics, <doctor.color('Doctor')>?"
    mc.say "那么……我到底发生了什么事？你知道具体的情况吗，<doctor.color('医生')>？"

# game/chapters/01/ch_01_01.rpy:274
translate chinese ch01_01_hospitalAwakening_4e182be2:

    # doctor.say "Well, according to our report, you were hit by a car."
    doctor.say "嗯，根据我们的报告，你被一辆车撞了。"

# game/chapters/01/ch_01_01.rpy:275
translate chinese ch01_01_hospitalAwakening_e373689b:

    # doctor.say "Unfortunately, it was a hit-and-run, so we don't know the perpetrator."
    doctor.say "不幸的是，司机肇事逃逸，所以我们不知道肇事者是谁。"

# game/chapters/01/ch_01_01.rpy:276
translate chinese ch01_01_hospitalAwakening_53185ec0:

    # doctor.say "The ambulance was able to get to you quickly, so you can consider yourself pretty lucky."
    doctor.say "救护车很快就赶到你那里，所以你还挺幸运。"

# game/chapters/01/ch_01_01.rpy:277
translate chinese ch01_01_hospitalAwakening_9c68b4cd:

    # doctor.say "This was three days ago, you have been comatose ever since."
    doctor.say "这是三天前的事，从那以后你就一直昏迷不醒。"

# game/chapters/01/ch_01_01.rpy:279
translate chinese ch01_01_hospitalAwakening_f4e84000:

    # doctor.say "But apart from the concussion, you have suffered only minor physical injuries."
    doctor.say "但除了脑震荡，你只受了点轻伤。"

# game/chapters/01/ch_01_01.rpy:280
translate chinese ch01_01_hospitalAwakening_2e9ebe53:

    # doctor.say "However, I would like to keep you here for a few more days. You were unconscious for over seventy-two hours without any apparent cause."
    doctor.say "不过，我想让你在这里多待几天。你一口气昏迷了超过七十二小时。"

# game/chapters/01/ch_01_01.rpy:282
translate chinese ch01_01_hospitalAwakening_8ec247c0:

    # doctor.say "Also, your girlfriend has brought you a few things."
    doctor.say "另外，你的女朋友给你带了几样东西。"

# game/chapters/01/ch_01_01.rpy:284
translate chinese ch01_01_hospitalAwakening_cfe44bf7:

    # lucy.say "*mumbling*{size=-5} He is n- I-I am not-{w=2}{nw}" with disText
    lucy.say "*喃喃自语*{size=-5}他不是——我——我不是——{w=2}{nw}" with disText

# game/chapters/01/ch_01_01.rpy:286
translate chinese ch01_01_hospitalAwakening_61bc3791:

    # naomi.sayWOI "[doctor.ColoredName]! You are needed in Room 222!" with disText
    naomi.sayWOI "[doctor.ColoredName]！请到222房间！" with disText

# game/chapters/01/ch_01_01.rpy:288
translate chinese ch01_01_hospitalAwakening_fb9883ca:

    # doctor.say "*sighs* Mr. Trueman, of course..."
    doctor.say "*叹气*特鲁曼先生，当然……"

# game/chapters/01/ch_01_01.rpy:289
translate chinese ch01_01_hospitalAwakening_72809a90:

    # doctor.say "Does he still think he's the centerpiece of a sitcom series?"
    doctor.say "他还是觉得自己是喜剧的主角吗？"

# game/chapters/01/ch_01_01.rpy:290
translate chinese ch01_01_hospitalAwakening_4a5e80e4:

    # doctor.say "I'll be there in a moment, thank you."
    doctor.say "我马上就到，谢谢。"

# game/chapters/01/ch_01_01.rpy:295
translate chinese ch01_01_hospitalAwakening_67c07d8c:

    # doctor.say "I'll check up on you later, [mc.ColoredName]. Until then, please get some rest." with disText
    doctor.say "我待会再来看你，[mc.ColoredName]。在那之前，请好好休息。" with disText

# game/chapters/01/ch_01_01.rpy:299
translate chinese ch01_01_hospitalAwakening_aabaa6e6:

    # lucy.say "I'm so glad you're back, [mc.ColoredName]!" with disText
    lucy.say "我很高兴你醒了，[mc.ColoredName]！" with disText

# game/chapters/01/ch_01_01.rpy:303
translate chinese ch01_01_hospitalAwakening_e6702da8:

    # n "[lucy.ColoredName] sits on the edge of the bed, seeming occupied with thoughts..." with disText
    n "[lucy.ColoredName]坐在床边，似乎在沉思……" with disText

# game/chapters/01/ch_01_01.rpy:305
translate chinese ch01_01_hospitalAwakening_ab980c7a:

    # lucy.say "You can't imagine how surprised and worried I was when they called me about the accident..."
    lucy.say "你无法想象当他们打电话告诉我你被车撞了的时候，我有多害怕和担心……"

# game/chapters/01/ch_01_01.rpy:306
translate chinese ch01_01_hospitalAwakening_53bcca68:

    # lucy.say "*blushing* I-I didn't know you had me listed as an emergency contact..."
    lucy.say "*脸红*我——我很高兴你把我列为紧急联系人……"

# game/chapters/01/ch_01_01.rpy:309
translate chinese ch01_01_hospitalAwakening_fe96c1d7:

    # mc.think "Oh, right... I'm glad that the saleswoman told me about this feature when I bought my phone."
    mc.think "哦，对了……我很高兴售货员在我买手机的时候就告诉了我这个功能。"

# game/chapters/01/ch_01_01.rpy:310
translate chinese ch01_01_hospitalAwakening_bae28c2e:

    # mc.think "She said it can detect when you're in danger or unresponsive and call for emergency, even when the screen is broken."
    mc.think "她说它可以检测到你处于危险或无反应状态，并呼叫紧急救援，即使屏幕坏了。"

# game/chapters/01/ch_01_01.rpy:311
translate chinese ch01_01_hospitalAwakening_524a78dd:

    # mc.think "At that time, I thought it was some bullshit marketing technique, \nbut it was literally life-saving..."
    mc.think "当时，我认为这是某种营销噱头，\n但确实救了我一命……"

# game/chapters/01/ch_01_01.rpy:312
translate chinese ch01_01_hospitalAwakening_5c8ce876:

    # mc.think "I'm lucky that I'm not alone."
    mc.think "我很幸运，我并不孤独。"

# game/chapters/01/ch_01_01.rpy:314
translate chinese ch01_01_hospitalAwakening_eb5f5147:

    # mc.say "Come on, [lucy.ColoredName], who else should I have chosen? Certainly not my fucked-up relatives! *chuckles lightly*"
    mc.say "来吧，[lucy.ColoredName]，我还能选谁？总不能是我那些混蛋亲戚吧！*轻笑*"

# game/chapters/01/ch_01_01.rpy:318
translate chinese ch01_01_hospitalAwakening_3762180c:

    # mc.think "About [currentYear] years ago, back in 2023, my parents... died in a plane crash."
    mc.think "大约[currentYear]年前，回到2023年，我的父母……在飞机失事中去世了。"

# game/chapters/01/ch_01_01.rpy:319
translate chinese ch01_01_hospitalAwakening_05b348e6:

    # mc.think "I used to live with my grandmother, but she broke her leg, and her last living son, my uncle, put her in a nursing home three states away."
    mc.think "我曾和祖母一起生活，但她摔断了腿，她的小儿子，也就是我的叔叔，把她送到了三个州之外的养老院。"

# game/chapters/01/ch_01_01.rpy:320
translate chinese ch01_01_hospitalAwakening_34ff81dc:

    # mc.think "And since he couldn't just kick me out onto the streets (due to the promise made to Grandpa), he's allowing me to live in my grandmother's house."
    mc.think "由于对爷爷的承诺，他不能把我扔到大街上自生自灭，所以他允许我住在祖母的房子里。"

# game/chapters/01/ch_01_01.rpy:321
translate chinese ch01_01_hospitalAwakening_ff17ef6f:

    # mc.think "... But only for the next two months, until he returns from his business trip. Then it's up for rent, and I'm officially out.{w}{b} Fucking asshole{/b}..."
    mc.think "……但两个月之后，他从商务旅行回来之后。房子就要出租了，然后我就真的无家可归了。{w}{b}该死的混蛋{/b}……"

# game/chapters/01/ch_01_01.rpy:323
translate chinese ch01_01_hospitalAwakening_aefdc08e:

    # lucy.say "Are you thinking about your family again? That grimace on your face is one-of-a-kind, ha."
    lucy.say "你又在想你的家人了吗？你脸上的那种表情是独一无二的，哈。"

# game/chapters/01/ch_01_01.rpy:324
translate chinese ch01_01_hospitalAwakening_c58483ce:

    # lucy.say "A-anyway, I was thinking that, uh..."
    lucy.say "总——总之，我在想，呃……"

# game/chapters/01/ch_01_01.rpy:326
translate chinese ch01_01_hospitalAwakening_a27d08af:

    # lucy.say "... Since you're in such a vulnerable state right now, you should just move in with us."
    lucy.say "……既然你现在处于如此脆弱的状态，你应该搬来和我们一起住。"

# game/chapters/01/ch_01_01.rpy:328
translate chinese ch01_01_hospitalAwakening_4bbfe712:

    # lucy.say "My mom and sister won't mind... I already talked to them about that!"
    lucy.say "我妈妈和妹妹不会介意的……我已经和她们谈过了！"

# game/chapters/01/ch_01_01.rpy:329
translate chinese ch01_01_hospitalAwakening_4887fc97:

    # lucy.say "I mean, you and [anya.ColoredName] always got along, so..."
    lucy.say "我的意思是，你和[anya.ColoredName]一直相处得很好，所以……"

# game/chapters/01/ch_01_01.rpy:330
translate chinese ch01_01_hospitalAwakening_8afbc3b1:

    # lucy.say "Plus, Mom said it'd be good to have some male presence in the house again!"
    lucy.say "而且，妈妈说家里再有个男性会很好！"

# game/chapters/01/ch_01_01.rpy:332
translate chinese ch01_01_hospitalAwakening_3242c080:

    # mc.say "Wait. Are you serious?"
    mc.say "等等。你是认真的吗？"

# game/chapters/01/ch_01_01.rpy:334
translate chinese ch01_01_hospitalAwakening_05e8aa5d:

    # lucy.say "Of course I am serious, [mc.ColoredName]!"
    lucy.say "我当然是认真的，[mc.ColoredName]！"

# game/chapters/01/ch_01_01.rpy:337
translate chinese ch01_01_hospitalAwakening_d2c4e66a:

    # mc.think "Hmm... I've met their mother a few times, and she seemed nice, \njust always so busy..."
    mc.think "嗯……我见过她们的妈妈几次，她看起来很和善，\n但总是那么忙……"

# game/chapters/01/ch_01_01.rpy:338
translate chinese ch01_01_hospitalAwakening_c3f5f042:

    # mc.think "And [anya.ColoredName], [lucy.ColoredName]'s twin sister and classmate, has always been kind to me."
    mc.think "还有[anya.ColoredName]，[lucy.ColoredName]的双胞胎妹妹和同学，一直对我很友好。"

# game/chapters/01/ch_01_01.rpy:341
translate chinese ch01_01_hospitalAwakening_a571bcff:

    # mc.think "Also, I believe that [lucy.ColoredName] mentioned that her sister loves anime, \nso she can't be that bad, right?"
    mc.think "而且，我相信[lucy.ColoredName]提到过她妹妹喜欢动漫，\n所以她应该不会太差，对吧？"

# game/chapters/01/ch_01_01.rpy:342
translate chinese ch01_01_hospitalAwakening_3ee9d817:

    # mc.think "Still, this whole thing is coming out of left field..."
    mc.think "不过，这一切都来得太突然了……"

# game/chapters/01/ch_01_01.rpy:343
translate chinese ch01_01_hospitalAwakening_e2443b31:

    # mc.think "Can this arrangement even work out? I mean, if their mother is fine with that, then I guess..."
    mc.think "这种安排真的能行吗？我是说，如果她们的妈妈没意见，那我想……"

# game/chapters/01/ch_01_01.rpy:345
translate chinese ch01_01_hospitalAwakening_d3a52e6f:

    # mc.say "Are you sure it's, like, actually okay? I don't have much money... \nNo job, either..."
    mc.say "你确定真的没问题吗？我没什么钱……\n也没有工作……"

# game/chapters/01/ch_01_01.rpy:347
translate chinese ch01_01_hospitalAwakening_291238ef:

    # lucy.say "Hey, don't worry about that! Mom said she'll cover it. You can stay as long as you want!"
    lucy.say "嘿，别担心那个！妈妈说不要你的房租。你想住多久就住多久！"

# game/chapters/01/ch_01_01.rpy:348
translate chinese ch01_01_hospitalAwakening_ad761bb1:

    # lucy.say "So, what do you say?"
    lucy.say "那么，你怎么说？"

# game/chapters/01/ch_01_01.rpy:356
translate chinese ch01_01_hospitalAwakening_91805767:

    # mc.say "If that's how things are..." with disText
    mc.say "如果真是这样的话……" with disText

# game/chapters/01/ch_01_01.rpy:357
translate chinese ch01_01_hospitalAwakening_4930a170:

    # mc.say "Then I'm more than happy to accept your offer, [lucy.ColoredName]. Thank you!"
    mc.say "那么我非常乐意接受你的提议，[lucy.ColoredName]。谢谢你！"

# game/chapters/01/ch_01_01.rpy:358
translate chinese ch01_01_hospitalAwakening_e5d9fc01:

    # mc.say "I'll try not to be a burden and help with house chores whenever I can!"
    mc.say "我会尽量不成为负担，并尽可能帮忙做家务！"

# game/chapters/01/ch_01_01.rpy:361
translate chinese ch01_01_hospitalAwakening_d0a8d32d:

    # mc.say "That's really kind of you, but..." with disText
    mc.say "你真是太好了，但是……" with disText

# game/chapters/01/ch_01_01.rpy:365
translate chinese ch01_01_hospitalAwakening_44c0fc26:

    # lucy.say "No buts, [mc.ColoredName]! It's fine, seriously!{w} Please...?"
    lucy.say "不要推辞，[mc.ColoredName]！真的没关系！{w}请……？"

# game/chapters/01/ch_01_01.rpy:367
