translate chinese ch01_21_FirstSchoolTrain_2b9be0ba:

    # n "You instinctively touch the hands covering your eyes. \nThey are rather small but soft and warm."
    n "你本能地触摸了遮住你眼睛的手。\n它们相当小，但柔软且温暖。"

# game/chapters/01/ch_01_21.rpy:94
translate chinese ch01_21_FirstSchoolTrain_307db698:

    # n "The sound of her voice tells you that you should remember the girl..."
    n "她的声音告诉你，你应该记得这个女孩……"

# game/chapters/01/ch_01_21.rpy:95
translate chinese ch01_21_FirstSchoolTrain_13807a22:

    # mc.say "Uhm... I have no clue."
    mc.say "嗯……我完全不知道。"

# game/chapters/01/ch_01_21.rpy:96
translate chinese ch01_21_FirstSchoolTrain_0df36428:

    # chloe.sayWOI "Wrooong!"
    chloe.sayWOI "错啦！"

