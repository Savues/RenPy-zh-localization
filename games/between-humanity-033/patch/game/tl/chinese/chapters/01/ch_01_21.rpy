translate chinese ch01_21_FirstSchoolTrain_2d655fe1:

    # mc.say "You should hold onto the pole, though."
    mc.say "不过，你应该抓住杆子。"

# game/chapters/01/ch_01_21.rpy:85
translate chinese ch01_21_FirstSchoolTrain_5b719e3d:

    # lucy.say "Y-Yes. I'm really sorry..."
    lucy.say "是……是的。我真的很抱歉……"

# game/chapters/01/ch_01_21.rpy:87
translate chinese ch01_21_FirstSchoolTrain_8c87e47d_1:

    # anya.say "Well, well... Look who's here."
    anya.say "好吧，好吧……看看谁来了。"

