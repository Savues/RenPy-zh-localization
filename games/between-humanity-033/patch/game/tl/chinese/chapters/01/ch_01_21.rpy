# game/chapters/01/ch_01_21.rpy:5
translate chinese ch01_21_FirstSchoolTrain_b067fc33:

    # n "You squeeze into the cramped train and find a spot near the door." with disText
    n "你挤进拥挤的地铁，找了个靠近车门的位置。" with disText

# game/chapters/01/ch_01_21.rpy:6
translate chinese ch01_21_FirstSchoolTrain_d32d9bc0:

    # n "You don't speak much, but then your attention is drawn to [anya.ColoredName] rubbing her wrist."
    n "你没怎么说话，但你注意到[anya.ColoredName]在揉手腕。"

# game/chapters/01/ch_01_21.rpy:10
translate chinese ch01_21_FirstSchoolTrain_cfd7bced:

    # mc.say "Does it still hurt?" with disText
    mc.say "还疼吗？" with disText

# game/chapters/01/ch_01_21.rpy:12
translate chinese ch01_21_FirstSchoolTrain_39adb05a:

    # mc.say "What's up? Is your wrist bothering you?" with disText
    mc.say "咋？你的手腕不舒服吗？" with disText

# game/chapters/01/ch_01_21.rpy:14
translate chinese ch01_21_FirstSchoolTrain_9526aa9b:

    # n "Expecting a reply you get nothing, [anya.ColoredName] seemingly lost in her thoughts. [lucy.ColoredName], however, looks at her with concern."
    n "期待着回应，但得到的只有沉默，[anya.ColoredName]似乎陷入了沉思。然而，[lucy.ColoredName]却用关切的眼神看着她。"

# game/chapters/01/ch_01_21.rpy:16
translate chinese ch01_21_FirstSchoolTrain_8e0dcb0f:

    # lucy.say "What do you mean \"still\"?"
    lucy.say "你说的“还”是什么意思？"

# game/chapters/01/ch_01_21.rpy:17
translate chinese ch01_21_FirstSchoolTrain_309229d5:

    # lucy.say "Sis? What's wrong?"
    lucy.say "怎么了？妹妹？"

# game/chapters/01/ch_01_21.rpy:19
translate chinese ch01_21_FirstSchoolTrain_e3626c49:

    # n "[anya.ColoredName] realizes you two are trying to talk to her."
    n "[anya.ColoredName]意识到你们俩在跟她说话。"

# game/chapters/01/ch_01_21.rpy:21
translate chinese ch01_21_FirstSchoolTrain_66ccccdd:

    # anya.say "Oh. S-Sorry, I blanked out for a sec there..."
    anya.say "哦。抱歉，我刚才有点走神了……"

# game/chapters/01/ch_01_21.rpy:22
translate chinese ch01_21_FirstSchoolTrain_4cec477b:

    # anya.say "Well, it's still a bit sore, but I don't want to complain too much."
    anya.say "嗯，还是有点疼，但是问题不大。"

# game/chapters/01/ch_01_21.rpy:24
translate chinese ch01_21_FirstSchoolTrain_fc6bce2b:

    # lucy.say "*sighs deeply*"
    lucy.say "*深深地叹息*"

# game/chapters/01/ch_01_21.rpy:25
translate chinese ch01_21_FirstSchoolTrain_bb894799:

    # mc.think "Interesting... Looks like [anya.ColoredName] doesn't want to seem weak to her twin."
    mc.think "有趣……看起来[anya.ColoredName]不想在她的姐姐面前显露软弱的一面。"

# game/chapters/01/ch_01_21.rpy:27
translate chinese ch01_21_FirstSchoolTrain_f69c09e8:

    # lucy.say "I'm glad you didn't miss out on too much in school."
    lucy.say "我很高兴你并没有落下太多课程。"

# game/chapters/01/ch_01_21.rpy:28
translate chinese ch01_21_FirstSchoolTrain_44aac085:

    # lucy.say "But if you'd like, I can help you get back on track!"
    lucy.say "但如果你愿意，我可以辅导你！"

# game/chapters/01/ch_01_21.rpy:47
translate chinese ch01_21_FirstSchoolTrain_f8df49cf:

    # mc.say "Absolutely! Thanks a lot, [lucy.ColoredName]."
    mc.say "当然！非常感谢，[lucy.ColoredName]。"

# game/chapters/01/ch_01_21.rpy:50
translate chinese ch01_21_FirstSchoolTrain_bdea7c9d:

    # lucy.say "Yay! I'm available pretty much anytime you need me."
    lucy.say "耶！我随时都可以帮你。"

# game/chapters/01/ch_01_21.rpy:64
translate chinese ch01_21_FirstSchoolTrain_6465c05f:

    # n "The train brakes abruptly, causing quite the chaos in the car..." with disText
    n "地铁突然刹车，引起车厢里一片混乱……" with disText

# game/chapters/01/ch_01_21.rpy:67
translate chinese ch01_21_FirstSchoolTrain_42a5ee5c:

    # n "You find yourself holding onto a pole and, more importantly, \nwith [lucy.ColoredName] in your arms." with disText
    n "你自己抓住了一根杆子，更重要的是， \n [lucy.ColoredName]在你的怀里。" with disText

# game/chapters/01/ch_01_21.rpy:69
translate chinese ch01_21_FirstSchoolTrain_9b6ff0e5:

    # lucy.say "*murmuring* I'm s-sorry, [mc.ColoredName]..." with disText
    lucy.say "*喃喃道* 报——抱歉，[mc.ColoredName]……" with disText

# game/chapters/01/ch_01_21.rpy:74
translate chinese ch01_21_FirstSchoolTrain_c42a24b6:

    # mc.say "It's fine, [lucy.ColoredName]. I'm just glad you didn't fall." with disText
    mc.say "没关系，[lucy.ColoredName]。我很高兴你没有摔倒。" with disText

# game/chapters/01/ch_01_21.rpy:75
translate chinese ch01_21_FirstSchoolTrain_d1b16a5e:

    # mc.say "Feel free to hold onto me if you'd like."
    mc.say "如果你愿意，可以随时抱紧我。"

# game/chapters/01/ch_01_21.rpy:77
translate chinese ch01_21_FirstSchoolTrain_e13c6573:

    # n "Before she can reply, you grab her shoulder and hold her tightly."
