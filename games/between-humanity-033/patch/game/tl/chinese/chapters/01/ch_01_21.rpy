translate chinese ch01_21_FirstSchoolTrain_33136aa9:

    # chloe.sayWOI "You must've hit your head pretty hard if you don't remember this sweet voice..."
    chloe.sayWOI "如果你不记得这个甜美的声音，那你一定是撞傻了……"

# game/chapters/01/ch_01_21.rpy:99
translate chinese ch01_21_FirstSchoolTrain_f36e38ba:

    # n "A petite-looking girl moves around you and greets [anya.ColoredName] and [lucy.ColoredName] warmly." with disText
    n "一个看起来娇小的女孩绕过你，向[anya.ColoredName]和[lucy.ColoredName]打招呼。" with disText

# game/chapters/01/ch_01_21.rpy:101
translate chinese ch01_21_FirstSchoolTrain_be1b6343:

    # n "She squeezes herself between the girls before she looks back at you." with disText
    n "她挤在两个女孩中间，然后才回头看你。" with disText

# game/chapters/01/ch_01_21.rpy:103
translate chinese ch01_21_FirstSchoolTrain_5dceb7df:

    # mc.think "Ah, it's [chloe.ColoredName]! She's a friend of the twins mostly, but we're cool, too."
    mc.think "啊，是[chloe.ColoredName]！她是姐妹花的朋友，但我们也是好朋友。"

# game/chapters/01/ch_01_21.rpy:110
translate chinese ch01_21_FirstSchoolTrain_2ddd9ac3:

    # mc.say "My apologies, [chloe.ColoredName]. It's been quite a rough week." with disText
    mc.say "我的我的，[chloe.ColoredName]。我这一周过得很艰难。" with disText

# game/chapters/01/ch_01_21.rpy:112
translate chinese ch01_21_FirstSchoolTrain_e0ff4797:

    # chloe.say "Are you, like, {i}fine{/i} fine? I heard about the accident..."
    chloe.say "你真的，{i}真的{/i}没事吗？我听说了那次事故……"

