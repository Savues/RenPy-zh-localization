translate chinese ch01_21_FirstSchoolTrain_31d634cd:

    # chloe.say "Wait a sec.{w} [mc.ColoredName], where are your glasses...?"
    chloe.say "等一下。{w}[mc.ColoredName]，你的眼镜呢……？"

# game/chapters/01/ch_01_21.rpy:120
translate chinese ch01_21_FirstSchoolTrain_7f82b789:

    # n "[anya.ColoredName]'s and [lucy.ColoredName]'s eyes widen as they realize this too." with disText
    n "[anya.ColoredName]和[lucy.ColoredName]也注意到了这一点。" with disText

# game/chapters/01/ch_01_21.rpy:122
translate chinese ch01_21_FirstSchoolTrain_818a990f:

    # mc.say "I... can't explain it."
    mc.say "我……没法解释。"

