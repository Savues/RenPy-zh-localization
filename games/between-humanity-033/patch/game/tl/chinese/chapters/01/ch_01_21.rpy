translate chinese ch01_21_FirstSchoolTrain_5ef0880e:

    # chloe.say "You sure you're okay with going to school already?"
    chloe.say "你确定你已经准备好去上学了吗？"

# game/chapters/01/ch_01_21.rpy:115
translate chinese ch01_21_FirstSchoolTrain_4328a03c:

    # mc.say "Yeah. I'd rather be doing something than stare holes in the ceiling."
    mc.say "是啊。与其盯着天花板发呆，我宁愿做点什么。"

# game/chapters/01/ch_01_21.rpy:117
translate chinese ch01_21_FirstSchoolTrain_9b245ad4:

    # chloe.say "Haha, that's the spirit!" with disText
    chloe.say "哈哈，就该这样！" with disText

