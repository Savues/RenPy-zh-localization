translate chinese ch01_21_FirstSchoolTrain_5e96f330:

    # mc.say "I must admit that I kind of forgot about that."
    mc.say "记性不好忘记了，或许这一撞给我视力治好了。"

# game/chapters/01/ch_01_21.rpy:127
translate chinese ch01_21_FirstSchoolTrain_eccc039d:

    # chloe.say "At your service, then! *hehe*"
    chloe.say "等你眼睛啥时候瞎了就让我来搀扶你吧！*呵呵*"

# game/chapters/01/ch_01_21.rpy:129
