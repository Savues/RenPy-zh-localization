    new "我不会的，[lucy.Name]，别担心。"

    # game/chapters/01/ch_01_05.rpy:69
    old "Yay ^^ Gimme like 3 hours!"
    new "耶^^给我大约3个小时！"

    # game/chapters/01/ch_01_05.rpy:70
