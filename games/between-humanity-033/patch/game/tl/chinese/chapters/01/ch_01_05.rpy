translate chinese strings:

    # game/chapters/01/ch_01_05.rpy:63
    old "Hey, [lucy.Name]! I got the pass from the Doc, so I guess I'm waiting for you now."
    new "嘿，[lucy.Name]！医生说我可以出院了，所以我现在在等你。"

    # game/chapters/01/ch_01_05.rpy:65
    old "[mc.Name]! So glad to hear that! I'll be there as soon as school ends, okay?"
    new "[mc.Name]！听到这个消息真高兴！我一放学就过去，好吗？"

    # game/chapters/01/ch_01_05.rpy:67
    old "Please, don't leave without me..."
    new "请不要丢下我……"

    # game/chapters/01/ch_01_05.rpy:68
