label chapter19:
    stop music fadeout 2.0
    scene blank with Dissolve(2)
    window hide
    show datetime_1 at truecenter with dissolve
    show datetime_2 at truecenter with dissolve
    $ Show("chapter19", transition=Dissolve(1.0))()
