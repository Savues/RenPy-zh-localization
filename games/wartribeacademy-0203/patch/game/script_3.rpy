label cleoscene6menu:
    menu:
        "去逛点什么？"
        "冒险者广场" if adv_common == 0:
            jump cleoscene6adv
        "逛贸易集市" if city_market == 0:
            jump cleoscene6mar
        "前往码头" if city_docks == 0:
            jump cleoscene6doc
        "红灯区" if city_market == 1 and adv_common == 1 and city_docks == 1:
            jump cleoscene6red
        "返回学院" if brothel == 1 and city_market >= 1 and city_docks == 1 and adv_common == 1:
            scene bg black
            show cleo6juna_100
            with fade
            "逛了一大圈后，你和茱娜离开了城。"
            scene bg black
            with fade
            jump worldmap1
label cleoscene6doc:
    scene bg black
    show cleo6juna_11
