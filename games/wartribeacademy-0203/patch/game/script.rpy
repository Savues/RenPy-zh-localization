    with vpunch
    r "哈？！"
    scene bg black
    show rhea_bath_2
    with vpunch
    r "咕呜啊！~"
    scene bg black
    show rhea_bath_3
    with vpunch
    r "唔、唔啊！"
    scene bg black
    show rhea_bath_4
    with vpunch
    r "哦哦哦！"
    scene bg black
    show rhea_bath_5
    with vpunch
    r "咕……{w}呃。"

    scene bg black
    show rhea_bath_9
    with fade
    y "唔嗯——蕾娅。"
    scene bg black
    show rhea_bath_10
