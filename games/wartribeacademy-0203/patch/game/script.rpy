label rhea5_1a:
    #MANIPULATION ROUTE
    $ loverhea = 5
    play music "audio/Coy Koi.mp3" fadein 3.0
    scene bg black
    show rhea5r_14
    with fade
    y "嗯？子爵夫人。真意外。"
