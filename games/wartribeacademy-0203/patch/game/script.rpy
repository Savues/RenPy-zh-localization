label intro_x1:
    play music "audio/Horizon Flare.mp3" fadein 3.0
    who "喂？"
    who "有人吗？"
    who "请稍等一下……"
    show q_1
    with dissolve
    who "抱歉让你久等了。{w}淑女总是需要时间准备。"
    who "欢迎来到努比利亚！"
    who "正式开始之前，我们先把一些形式流程走完吧。"
    who "什么？{w}我？"
    who "别在意我！这张表格只是为了讨你欢心而已。"
    who "专心点！"
    who "首先，你被视为王族。我们族人通常会称你为「王子」或「殿下」。"
    who "如果你叫金，人们可能会称你为「金王子」。"

    $ player_name = renpy.input("你叫什么名字？（按回车确认）")
    $ player_name = player_name.strip()


    if player_name == "":
        $ player_name="Gin"
    if player_name == "Zuko":
        with dissolve
        "祖可？明白了。艾洛叔还好吗？"
    if player_name == "Charming":
        with dissolve
        "魅力王子！灰姑娘在等你！"
    if player_name == "Phillip":
        with dissolve
        "菲利普王子！睡美人就在这附近某个地方……"
    if player_name == "Aladdin":
        with dissolve
        "阿里王子~ 真是太棒了~ 阿里阿巴巴巴巴~"
        "抱歉，我没能忍住。"
    if player_name == "Eric":
        with dissolve
        "艾瑞克王子……这所学院里可没有美人鱼。"
        "抱歉，抱歉。"
    if player_name == "Ferdinand":
        with dissolve
        "斐迪南王子。贵族之中的贵族。"
    if player_name == "Snow":
        with dissolve
        "我听说……{size=-10}你一无所知……白雪{/size}"
    if player_name == "Grim":
        with dissolve
        "等等，是那个死神吗？"
        "我认识那个人！非常准时。"
    if player_name == "Rengoku":
        with dissolve
        "真的假的？！{w}炎柱？"
        "真是我的荣幸。"
    if player_name == "John":
        with dissolve
        "约翰？"
        "和另一个约翰有关系吗？"
        "哪个？{w}哦，你懂的。"
    if player_name == "Josh":
        with dissolve
        "是货真价实的那个乔许？还是随便一个乔许？"
        "算了，反正都一样。"
    $ persistent.pname = player_name

    "很高兴认识你，[player_name]！"
    define y = Character("[player_name]", color="#c8ffc8")
    with dissolve

    who "要是能让你的目光从我的胸部上移开一会儿就好了。"
    who "我知道你出身于一个强大的战族。来决定一下它的名字吧。"
    who "在你挑选之前举个例子：如果你把它命名为战族，"
    who "别人就会说「战族的[player_name]」。"
    who "而你的学院就会叫作战族学院。"
    who "如果你改主意了，随时可以在自己的房间里修改这些名字。"

    $ tribe_name = renpy.input("你的部族和学院叫什么名字？（按回车确认）")
    $ tribe_name = tribe_name.strip()

    if tribe_name == "":
        $ tribe_name="Wartribe"
    $ persistent.tname = tribe_name

    who "太好了！欢迎来到[tribe_name]学院的王子[player_name]！"
    who "还有最后一件事，[player_name]。"
    who "你想用快速旅行模式，还是探索模式？"
    who "快速旅行能让你在剧情场景之间随意移动。你可以在自己的主房间里使用它。"
    who "探索模式更有沉浸感，会在你从地图上发现场景时把它们展示出来。"
    who "如果你不喜欢沙盒要素，还是开启快速旅行就用它吧。"
    menu:
        "快速旅行或探索模式"
        "快速旅行模式":
            $ ezmode = True
            with dissolve
            who "我选好了！"
            who "你会在房间菜单里找到快速旅行的选项！"
            who "如果剧情进行到某个阶段时目标角色没有对应场景，就不会显示图标。"
            who "但别担心，那个角色之后大概还会有更多场景！"
            who "如果你想关掉它，茱娜可以帮你。"
            who "哦不，那不是我的名字。"
            who "我叫什么名字来着？"
            who "唔……{w}以后再说吧！"
            who "现在别忘了经常存档！"
            menu:
                "观看片头？（首次游玩推荐）"
                "是（观看片头）":
                    jump prologue_x
                "否（跳过片头）":
                    jump enteracademy3
        "探索模式":
            who "好的！"
            who "如果您改主意了，茱娜可以替您安排。"
            who "哦不，那不是我的名字。"
            who "我叫什么名字来着？"
            who "唔……{w}以后再说吧！"
            who "现在别忘了经常存档！"
            menu:
                "观看片头？（首次游玩推荐）"
                "是（观看片头）":
                    jump prologue_x
                "否（跳过片头）":
                    jump enteracademy3
