label magscene6cherry2:
    $ cherry_loop = 1
    $ shield_up = 0
    $ charge_up = 0

    screen simple_stats_screen():
        frame:
            xalign 0.01 yalign 0.05
            xminimum 220 xmaximum 220
            vbox:
                text "[player_name]" size 22 xalign 0.5
                null height 5
                hbox:
                    bar:
                        xmaximum 130
                        value mc_hp
                        range mc_max_hp
                        left_gutter 0
                        right_gutter 0
                        thumb None
                        thumb_shadow None

                    null width 5

                    text "[mc_hp] / [mc_max_hp]" size 16
        frame:
            xalign 0.99 yalign 0.05
            xminimum 220 xmaximum 220
            vbox:
                text "切莉" size 22 xalign 0.5
                null height 5
                hbox:
                    bar:
                        xmaximum 130
                        value cherry_hp
                        range cherry_max_hp
                        left_gutter 0
                        right_gutter 0
                        thumb None
                        thumb_shadow None

                    null width 5

                    text "[cherry_hp] / [cherry_max_hp]" size 16
        text "切莉 对阵 [player_name]" xalign 0.5 yalign 0.05 size 30
    label battle_game_1:
        $ cherry_max_hp = 80
        $ mc_max_hp = 80
        $ cherry_hp = cherry_max_hp
        $ mc_hp = mc_max_hp
        scene bg black
        show mag6_30
        with dissolve
        play music "audio/Eye of Forgiveness.mp3" fadein 3.0
        "即使在惨白的月光下，切莉的身段也很清晰。"
        if elder_sword == 1:
            y "（这剑有点温热……它是在对切莉有反应吗？）"
        jump battle_1_loop
    label battle_1_loop:
        show screen simple_stats_screen
        while (cherry_hp > 0) and (mc_hp > 0):
            show mag6_30
            with dissolve
            menu:
                "（重玩选项）" if _in_replay:
                    menu:
                        "胜":
                            hide screen simple_stats_screen
                            jump battle_1_ending
                        "败":
                            hide screen simple_stats_screen
                            jump battle_2_ending
                        "觉醒之刃·胜":
                            hide screen simple_stats_screen
                            jump sword_secret
                "攻击！":
                    if elder_sword == 1:
                        scene bg black
                        show mag6_31
                        with vpunch
                        $ mc_damage = renpy.random.randint(15,25)
                        $ cherry_hp -= mc_damage
                        "你挥刀斩向切莉！（造成伤害 - [mc_damage] 生命值）"
                    else:
                        scene bg black
                        show mag6_31
                        with vpunch
                        $ mc_damage = renpy.random.randint(7,15)
                        $ cherry_hp -= mc_damage
                        "你朝切莉挥出一击！（造成伤害 - [mc_damage] 生命值）"

                "喝下药水（剩余 [potions_left] 瓶）" if potions_left > 0:
                    scene bg black
                    show mag6_30
                    with dissolve
                    $ mc_hp = min(mc_hp+25, mc_max_hp)
                    $ potions_left -= 1
                    y "*咕咚*……（恢复 25 生命值）"

                "防御！":
                    scene bg black
                    show mag6_30
                    with dissolve
                    $ shield_up = 1
                    "你摆好防御架势。"

                "{color=#ffff00}滋养剑刃{/color}" if weapon_art == True:
                    if charge_up == 0:
                        scene bg black
                        show mag6_116
                        with dissolve
                        "剑在呼唤你……"
                        "你感到力量正在流失。（-10 生命值）"
                        $ mc_hp = max(1,mc_hp-10)
                        $ charge_up = 1

                    elif charge_up == 1:
                        scene bg black
                        show mag6_115
                        with dissolve
                        "你把力量灌入剑中……剑身灼热起来！"
                        "你感到力量正在流失。（-10 生命值）"
                        $ mc_hp = max(1,mc_hp-10)
                        $ charge_up = 2

                    elif charge_up == 2:
                        scene bg black
                        show mag6_119
                        with vpunch
                        cherry "啊啊！"
                        scene bg black
                        show mag6_118
                        with dissolve
