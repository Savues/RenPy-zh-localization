label festivalhub1_1:
    stop music fadeout 5.0
    $ festival_loc = renpy.random.randint(1, 4)
    if festival_loc == 1:
        scene festival_loc1 with fade
    elif festival_loc == 2:
        scene festival_loc2 with fade
    elif festival_loc == 3:
        scene festival_loc3 with fade
    else:
        scene festival_loc4 with fade
    menu:
        @S
        @S if party_mag == 0:
            $ party_mag = 1
            jump thefestival1_1 
        @S if party_rhea == 0:
            $ party_rhea = 1
            jump thefestival2_1
        @S if party_rhea == 1:
            $ party_rhea = 2
            jump thefestival4_1
        @S if party_cleo == 0:
            $ party_cleo = 1
            jump thefestival3_1
        @S if party_cleo == 1:
            $ party_cleo = 2
            jump thefestival15_1
        @S if party_mag >=1 and party_pris == 0:
            $ party_pris = 1
            jump thefestival5_1
        @S if party_mag >= 1 and party_luce == 0:
            $ party_luce = 1
            jump thefestival6_1
        @S if party_bona == 0:
            $ party_bona = 1
            jump thefestival7_1
        @S if party_fea == 0 and party_leo == 0:
            $ party_fea = 1
            $ party_leo = 1
            jump thefestival16_1
        @S if party_fea == 1:
            $ party_fea = 2
            jump thefestival8_1
        @S if party_pris == 1:
            $ party_pris = 2
            jump thefestival9_1
        @S if party_bona == 1:
            $ party_bona = 2
            jump thefestival10_1
        @S if party_fea >= 2 and party_judy == 0:
            $ party_judy = 1
            jump thefestival11_1
        @S if party_leo == 1 and party_pris >= 2 and party_fea >= 2:
            $ party_leo = 2
            jump thefestival17_1
        @S if party_rhea >= 2 and party_luce == 1:
            $ party_luce = 2
            jump thegracen2_1
        @S if party_mag == 1:
            $ party_mag = 2
            jump thefestival18_1
        @S if party_rhea == 2 and party_fea >= 2:
            $ party_rhea = 3
            jump thefestival14_1
        @S if party_pris >= 2 and ezra_morph == 1 and party_ezra == 0:
            $ party_ezra = 1
            jump thesoldier1_1
        @S if party_mag == 2:
            $ party_mag = 3
            jump thefestival12_1
        @S if party_bona == 2:
            $ party_bona = 3
            jump thefestival13_1
        @S if party_bona >= 2 and party_rhea >= 2 and party_leo >= 2:
            jump theceremony2_1
