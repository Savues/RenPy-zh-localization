
label massage_menu:
    if parlor_open == 0:
        y @S
        jump market1
    elif lovenatxtal >= 3 and lovenatxtal <= 4 and parlor >= 3:
        jump natxtal_2
    else:
        scene bg black
        show parlor_5
        with dissolve
        par1 @S
        scene bg black
        show parlor_7
        with dissolve
        menu:
            @S if massage == 0:
                jump massage1
            @S if massage == 1:
                jump massage2
            @S if lovenatxtal == 5:
                jump natxtal_3
            @S:
                par1 @S
                scene bg black
                with fade
                jump market1
