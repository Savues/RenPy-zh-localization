                $ gladix_mark = 1
                @S
                @S
                scene bg black
                show gladix_bat_35
                with dissolve
                @S
                $ gladix_loop = renpy.random.randint(0,4)
        elif gladix_loop == 0:
            scene bg black
            show gladix_bat_29
            with dissolve
            gladix_m @S
            if shield_up == 1:
                scene bg black
                show gladix_bat_26
                with vpunch
                @S
                $ shield_up = 0
                $ gladix_loop = renpy.random.randint(0,4)
            else:
                $ gladix_damage = 30 - (player_spd*4)
                $ player_hp -= gladix_damage
                scene bg black
                show gladix_bat_30
                with vpunch
                @S
                @S
                $ gladix_loop = renpy.random.randint(0,4)
    hide screen gladix_stats_screen
    if gladix_hp <= 0:
        
        scene bg black
        show gladix_bat_39
        with fade
        y @S
        scene bg black
        show gladix_bat_40
        with dissolve
        gladix_m @S
        scene bg black
        with fade
        jump battle_gladix_end_win
    else:
        y @S
