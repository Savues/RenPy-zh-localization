label battleloop_gladix:
    $ gladix_hp = 200
    $ gladix_hp_max = 200
    $ gladix_loop = 0
    $ gladix_phase2 = 0
    $ scarlet_blade = 0
    $ gladix_ramp = 3
    $ gladix_mark = 0
    $ shield_up = 0
    $ player_hp = player_hp_max
    screen gladix_stats_screen():
        frame:
            xalign 0.01 yalign 0.05
            xminimum 220 xmaximum 220
            vbox:
                text @S size 22 xalign 0.5
                null height 5
                hbox:
                    bar:
                        xmaximum 130
                        value player_hp
                        range player_hp_max
                        left_gutter 0
                        right_gutter 0
                        thumb None
                        thumb_shadow None
                    null width 5
                    text @S size 16
        frame:
            xalign 0.99 yalign 0.05
            xminimum 220 xmaximum 220
            vbox:
                text @S size 22 xalign 0.5
                null height 5
                hbox:
                    bar:
                        xmaximum 130
                        value gladix_hp
                        range gladix_hp_max
                        left_gutter 0
                        right_gutter 0
                        thumb None
                        thumb_shadow None
                    null width 5
                    text @S size 16
        text @S xalign 0.5 yalign 0.05 size 30
    label battle_gladix_1:
        play sound @S loop fadein 3.0
        play music @S loop fadein 3.0
        
        scene bg black
        show gladix_bat_1
        with fade
        caster @S
        if beat_niko == 0:
            caster @S
            scene bg black
            show gladix_bat_2
            with dissolve
            caster @S
        elif beat_niko == 1:
            caster @S
            scene bg black
            show gladix_bat_2
            with dissolve
            caster @S
        scene bg black
        show gladix_bat_4
        with dissolve
        gladix @S
        scene bg black
        show gladix_bat_5
        with dissolve
        y @S
        scene bg black
        show gladix_bat_3
        with dissolve
        gladix @S
        scene bg black
        show gladix_bat_5
        with dissolve
        y @S
        scene bg black
        show gladix_bat_4
        with dissolve
        gladix @S
        scene bg black
        show gladix_bat_5
        with dissolve
        y @S
        if elder_sword >= 4:
            scar @S
            y @S
            scar @S
            scar @S
        jump battle_gladix_loop
    label battle_gladix_loop:
        show screen gladix_stats_screen
        while (gladix_hp > 100) and (player_hp > 0):
            scene bg black
            show gladix_bat_5
            with dissolve
            menu:
                @S if _in_replay:
                    menu:
                        @S:
                            hide screen gladix_stats_screen
                            jump battle_gladix_end_win
                        @S:
                            hide screen gladix_stats_screen
                            jump battle_gladix_end_lose
                @S:
                    $ mc_damage = renpy.random.randint(1,5) + (player_str*4) + elder_buff
                    $ gladix_hp -= mc_damage
                    scene bg black
                    show gladix_bat_15
                    with vpunch
                    @S
                @S:
                    $ player_heal = player_vit*10 + 20
                    $ player_hp = min(player_hp+player_heal, player_hp_max)
                    scene bg black
                    show gladix_bat_5
                    with dissolve
                    @S
                    $ mc_damage = 0
                @S:
                    $ shield_up = 1
                    scene bg black
                    show gladix_bat_5
                    with dissolve
                    @S
                    $ mc_damage = 0
                @S if player_str >= 3:
                    $ mc_damage = player_str*3 - renpy.random.randint(8,10)
                    if mc_damage >= 1:
                        $ mc_damage = mc_damage*8
                        $ gladix_hp -= mc_damage
                        scene bg black
                        show gladix_bat_15
                        with vpunch
                        @S
                        scene bg black
                        show gladix_bat_16
                        with vpunch
                        gladix @S
                    elif mc_damage == 0:
                        scene bg black
                        show gladix_bat_7
                        with vpunch
                        @S
                    else:
                        scene bg black
                        show gladix_bat_5
                        with vpunch
                        @S
                        $ player_hp -= 20
                        scene bg black
                        show gladix_bat_6
                        with vpunch
                        @S
                @S if scarlet_blade == 0 and elder_sword >= 4:
                    $ player_hp -= 10
                    scene bg black
                    show gladix_bat_5
                    with vpunch
                    @S
                    $ scarlet_blade = 3
                @S if scarlet_blade == 3 and elder_sword >= 4:
                    scar @S
                    $ mc_damage = 30
                    $ gladix_hp -= mc_damage
                    scene bg black
                    show gladix_bat_31
                    with vpunch
                    gladix @S
                    @S
                    scar @S
                    $ scarlet_blade = 4
            if gladix_loop == 3:
                
                scene bg black
                show gladix_bat_7
                with dissolve
                @S
                if shield_up == 1:
                    scene bg black
                    show gladix_bat_14
                    with vpunch
                    @S
                    $ shield_up = 0
                    $ gladix_loop = renpy.random.randint(0,3)
                else:
                    $ gladix_damage = (gladix_ramp*4) - (player_spd*3)
                    $ player_hp -= gladix_damage
                    scene bg black
                    show gladix_bat_9
                    with vpunch
                    gladix @S
                    @S
                    $ gladix_ramp += 1
                    $ gladix_loop = renpy.random.randint(0,3)
            elif gladix_loop == 2:
                
                scene bg black
                show gladix_bat_13
                with dissolve
                @S
                if shield_up == 1:
                    scene bg black
                    show gladix_bat_14
                    with vpunch
                    @S
                    $ shield_up = 0
                    $ gladix_loop = renpy.random.randint(0,3)
                else:
                    $ gladix_damage = (renpy.random.randint(2,6)*6) - (player_spd*3)
                    $ player_hp -= gladix_damage
                    scene bg black
                    show gladix_bat_10
                    with vpunch
                    @S
