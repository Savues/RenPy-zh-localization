label battleloop_darius:
    $ darius_hp = 250
    $ darius_hp_max = 250
    $ darius_loop = 0
    $ shield_up = 0
    $ darius_str = 0
    $ player_hp = player_hp_max
    screen darius_stats_screen():
        frame:
            xalign 0.01 yalign 0.05
            xminimum 220 xmaximum 220
            vbox:
                text @S size 22 xalign 0.5
                null height 5
                hbox:
                    bar:
                        xmaximum 130
                        value player_hp
                        range player_hp_max
                        left_gutter 0
                        right_gutter 0
                        thumb None
                        thumb_shadow None
                    null width 5
                    text @S size 16
        frame:
            xalign 0.99 yalign 0.05
            xminimum 220 xmaximum 220
            vbox:
                text @S size 22 xalign 0.5
                null height 5
                hbox:
                    bar:
                        xmaximum 130
                        value darius_hp
                        range darius_hp_max
                        left_gutter 0
                        right_gutter 0
                        thumb None
                        thumb_shadow None
                    null width 5
                    text @S size 16
        text @S xalign 0.5 yalign 0.05 size 30
    label battle_darius_1:
        scene bg black
        show darius_bat_12
        with dissolve
        @S
        @S
        play music @S loop fadein 3.0
        jump battle_darius_loop
    label battle_darius_loop:
        show screen darius_stats_screen
        while (darius_hp > 0) and (player_hp > 0):
            scene bg black
            show darius_bat_12
            with dissolve
            menu:
                @S if _in_replay:
                    menu:
                        @S:
                            hide screen darius_stats_screen
                            jump battle_darius_end_win
                        @S:
                            hide screen darius_stats_screen
                            jump battle_darius_end_lose
                @S:
                    scene bg black
                    show darius_bat_25
                    with vpunch
                    $ mc_damage = (renpy.random.randint(2,3)*player_str) + elder_buff
                    $ darius_hp -= mc_damage
                    @S
                @S:
                    $ player_heal = player_vit*10 + 20
                    $ player_hp = min(player_hp+player_heal, player_hp_max)
                    @S
                @S:
                    $ shield_up = 1
                    @S
                @S if player_str >= 3:
                    $ mc_damage = player_str*4 - renpy.random.randint(9,12) - darius_str
                    if mc_damage >= 1:
                        $ mc_damage = mc_damage*8
                        $ darius_hp -= mc_damage
                        scene bg black
                        show darius_bat_19
                        with vpunch
                        @S
                    elif mc_damage == 0:
                        scene bg black
                        show darius_bat_20
                        with vpunch
                        @S
                    else:
                        scene bg black
                        show darius_bat_21
                        with vpunch
                        @S
                        $ player_hp -= 20
                        @S
            if darius_loop == 3:
                $ darius_loop = 0
                
                scene bg black
                show darius_bat_10
                with dissolve
                @S
                if shield_up == 1:
                    scene bg black
                    show darius_bat_22
                    with vpunch
                    @S
                    $ shield_up = 0
                else:
                    scene bg black
                    show darius_bat_14
                    with vpunch
                    $ darius_damage = renpy.random.randint(80, 90) - player_spd*9
                    $ player_hp -= darius_damage
                    darius @S
                    @S
            elif darius_loop == 2:
                $ darius_loop = 3
                scene bg black
                show darius_bat_11
                with dissolve
                @S
                if shield_up == 1:
                    scene bg black
                    show darius_bat_24
                    with vpunch
                    @S
                    $ mc_damage = renpy.random.randint(2,3)*player_str
                    $ darius_hp -= mc_damage
                    scene bg black
                    show darius_bat_25
                    with vpunch
                    darius @S
                    @S
                    $ shield_up = 0
                else:
                    $ darius_damage = renpy.random.randint(50, 60) - player_spd*3
                    $ player_hp -= darius_damage
                    scene bg black
                    show darius_bat_13
                    with vpunch
                    @S
            elif darius_loop == 1:
                $ darius_loop = 2
                scene bg black
                show darius_bat_15
                with dissolve
                @S
                $ darius_damage = renpy.random.randint(1,10) - player_str*3 + darius_str
                if darius_damage >= 1:
                    scene bg black
                    show darius_bat_18
                    with vpunch
                    $ darius_damage = darius_damage*15
                    $ player_hp -= darius_damage
                    @S
                    $ shield_up = 0
                elif darius_damage == 0:
                    scene bg black
                    show darius_bat_16
                    with vpunch
                    @S
                    $ shield_up = 0
                else:
                    $ mc_damage = darius_damage*(-10)
                    $ darius_hp -= mc_damage
                    scene bg black
                    show darius_bat_17
                    with vpunch
                    @S
                    scene bg black
                    show darius_bat_19
                    with vpunch
                    darius @S
                    $ shield_up = 0
            elif darius_loop == 0:
                $ darius_loop = 1
                scene bg black
                show darius_bat_26
                with dissolve
                @S
                if shield_up == 1:
                    scene bg black
                    show darius_bat_26
                    with vpunch
                    @S
                    darius @S
                    $ darius_str += 2
                    scene bg black
                    show darius_bat_27
                    with dissolve
                    @S
                    $ darius_hp = min(darius_hp+20, darius_hp_max)
                    $ shield_up = 0
                else:
                    scene bg black
                    show darius_bat_26
                    with vpunch
                    @S
                    $ darius_hp = min(darius_hp+10, darius_hp_max)
        hide screen darius_stats_screen
        if darius_hp <= 0:
            scene bg black
            show darius_bat_38
            with fade
            darius @S
            scene bg black
            show darius_bat_39
            with dissolve
            y @S
            scene bg black
            show darius_bat_37
            with dissolve
            darius @S
            jump battle_darius_end_win
        else:
            scene bg black
            show darius_bat_40
            with fade
            y @S
            jump battle_darius_end_lose
