label cleoscene6menu:
    menu:
        @S
        @S if adv_common == 0:
            jump cleoscene6adv
        @S if city_market == 0:
            jump cleoscene6mar
        @S if city_docks == 0:
            jump cleoscene6doc
        @S if city_market == 1 and adv_common == 1 and city_docks == 1:
            jump cleoscene6red
        @S if brothel == 1 and city_market >= 1 and city_docks == 1 and adv_common == 1:
            scene bg black
            show cleo6juna_100
            with fade
            @S
            scene bg black
            with fade
            jump worldmap1
