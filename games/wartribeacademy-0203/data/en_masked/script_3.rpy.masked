            elif gladix_loop == 1:
                
                scene bg black
                show gladix_bat_12
                with dissolve
                @S
                if shield_up == 1:
                    scene bg black
                    show gladix_bat_11
                    with vpunch
                    @S
                    @S
                    $ gladix_damage = renpy.random.randint(30,35) - (player_spd*3)
                    $ gladix_hp = min(gladix_hp+gladix_damage, gladix_hp_max)
                    @S
                    $ player_hp -= gladix_damage
                    $ shield_up = 0
                    $ gladix_loop = renpy.random.randint(0,3)
                else:
                    scene bg black
                    show gladix_bat_11
                    with vpunch
                    @S
                    $ gladix_damage = renpy.random.randint(15,20) - (player_spd*3)
                    $ gladix_hp = min(gladix_hp+gladix_damage, gladix_hp_max)
                    @S
