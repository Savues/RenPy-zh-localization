label battleloop_wilford:
    $ shield_up = 0
    $ wilford_hp = 100
    $ wilford_hp_max = 100
    $ wilford_loop = 0
    $ player_heal = 0
    $ player_hp = player_hp_max
    screen wilford_stats_screen():
        frame:
            xalign 0.01 yalign 0.05
            xminimum 220 xmaximum 220
            vbox:
                text @S size 22 xalign 0.5
                null height 5
                hbox:
                    bar:
                        xmaximum 130
                        value player_hp
                        range player_hp_max
                        left_gutter 0
                        right_gutter 0
                        thumb None
                        thumb_shadow None
                    null width 5
                    text @S size 16
        frame:
            xalign 0.99 yalign 0.05
            xminimum 220 xmaximum 220
            vbox:
                text @S size 22 xalign 0.5
                null height 5
                hbox:
                    bar:
                        xmaximum 130
                        value wilford_hp
                        range wilford_hp_max
                        left_gutter 0
                        right_gutter 0
                        thumb None
                        thumb_shadow None
                    null width 5
                    text @S size 16
        text @S xalign 0.5 yalign 0.05 size 30
    label battle_wilford_1:
        play music @S loop fadein 3.0
        scene bg black
        show bat_wil_2
        with fade
        @S
        scene bg black
        show bat_wil_2
        with dissolve
        wilford @S
        scene bg black
        show bat_wil_3
        with dissolve
        wilford @S
        scene bg black
        show bat_wil_4
        with dissolve
        wilford @S
        @S
        scene bg black
        show bat_wil_5
        with dissolve
        wilford @S
        wilford @S
        scene bg black
        show bat_wil_6
        with dissolve
        y @S
        scene bg black
        show bat_wil_7
        with dissolve
        wilford @S
        jump battle_wilford_loop
    label battle_wilford_loop:
        show screen wilford_stats_screen
        while (wilford_hp > 0) and (player_hp > 0):
            scene bg black
            show bat_wil_8
            with dissolve
            menu:
                @S if _in_replay:
                    menu:
                        @S:
                            hide screen wilford_stats_screen
                            jump battle_wil_end_win
                        @S:
                            hide screen wilford_stats_screen
                            jump battle_wil_end_lose
                @S:
                    scene bg black
                    show bat_wil_9
                    with vpunch
                    $ mc_damage = renpy.random.randint(10,15)+(player_str*4)+(elder_buff)
                    $ wilford_hp -= mc_damage
                    @S
                @S:
                    $ player_heal = player_vit*10 + 20
                    $ player_hp = min(player_hp+player_heal, player_hp_max)
                    @S
                    $ mc_damage = 0
                @S:
                    $ shield_up = 1
                    @S
                @S if player_str >= 3:
                    scene bg black
                    show bat_wil_9
                    with dissolve
                    $ mc_damage = player_str*3 - renpy.random.randint(1,5)
                    if mc_damage >= 1:
                        $ mc_damage = mc_damage*8
                        $ wilford_hp -= mc_damage
                        scene bg black
                        show bat_wil_19
                        with vpunch
                        @S
                        wilford @S
                    elif mc_damage == 0:
                        scene bg black
                        show bat_wil_8
                        with vpunch
                        @S
                    else:
                        scene bg black
                        show bat_wil_8
                        with vpunch
                        @S
                        $ player_hp -= 20
                        scene bg black
                        show bat_wil_8
                        with vpunch
                        @S
            if wilford_loop == 3:
                $ wilford_loop = 0
                scene bg black
                show bat_wil_10
                with vpunch
                @S
                if shield_up == 1:
                    scene bg black
                    show bat_wil_21
                    with vpunch
                    @S
                    $ shield_up = 0
                else:
                    $ wilford_damage = renpy.random.randint(10, 15)
                    $ player_hp -= wilford_damage
                    scene bg black
                    show bat_wil_11
                    with vpunch
                    wilford @S
                    @S
            elif wilford_loop == 2:
                $ wilford_loop = 3
                scene bg black
                show bat_wil_12
                with vpunch
                @S
                if shield_up == 1:
                    scene bg black
                    show bat_wil_20
                    with vpunch
                    @S
                    $ shield_up = 0
                else:
                    scene bg black
                    show bat_wil_13
                    with vpunch
                    $ wilford_damage = renpy.random.randint(5, 10)
                    $ player_hp -= wilford_damage
                    @S
            elif wilford_loop == 1:
                $ wilford_loop = 2
                scene bg black
                show bat_wil_14
                with vpunch
                @S
                if shield_up == 1:
                    scene bg black
                    show bat_wil_12
                    with vpunch
                    @S
                    $ mc_damage = ((renpy.random.randint(1,3)*player_str)+3)
                    $ wilford_hp -= mc_damage
                    scene bg black
                    show bat_wil_9
                    with vpunch
                    wilford @S
                    @S
                    $ shield_up = 0
                else:
