screen save():

    tag menu

    use file_slots(_(@S))


screen load():

    tag menu

    use file_slots(_(@S))

screen change_name(slot):
    modal True
    default slot_title = FileSaveName(slot)
    zorder 200
    style_prefix @S

    add @S

    frame:
        vbox:
            xalign .5
            yalign .5
            spacing 45

            label _(@S):
                style @S
                xalign 0.5

            input:
                style @S
                value ScreenVariableInputValue(@S)

            hbox:
                xalign 0.5
                spacing 150

                textbutton _(@S) action  [Function(saveWithNewName, slot=slot, name=slot_title), Hide(@S)]
                textbutton _(@S) action Hide(@S)
            key @S action  [Function(saveWithNewName, slot=slot, name=slot_title), Hide(@S)]

    
    key @S action Hide(@S)


screen file_slots(title):

    default page_name_value = FilePageNameInputValue(pattern=_(@S), auto=_(@S), quick=_(@S))

    use game_menu(title):

        fixed:

            
            
            order_reverse True

            
            button:
                style @S

                key_events True
                xalign 0.5
                action page_name_value.Toggle()

                input:
                    style @S
                    value page_name_value

            
            grid gui.file_slot_cols gui.file_slot_rows:
                style_prefix @S

                xalign 0.5
                yalign 0.5

                spacing gui.slot_spacing

                for i in range(gui.file_slot_cols * gui.file_slot_rows):

                    $ slot = i + 1

                    button:
                        action FileAction(slot)
                        
                        
                        vbox:
                            add FileScreenshot(slot) xalign 0.5
                            add Null(5)
                            $ save_name = FileSaveName(slot) or @Q
                            textbutton save_name:
                                style @S
                                text_text_align 0.5
                                text_min_width gui.slot_button_width - 40
                                hover_background @S
                                action Show(@S, slot=slot)
                                
                            text FileTime(slot, format=_(@S), empty=_(@S)):
                                style @S

                        key @S action FileDelete(slot)

            
            hbox:
                style_prefix @S

                xalign 0.5
                yalign 1.0

                spacing gui.page_spacing

                textbutton _(@S) action FilePagePrevious()

                if config.has_autosave:
                    textbutton _(@S) action FilePage(@S)

                if config.has_quicksave:
                    textbutton _(@S) action FilePage(@S)

                textbutton @S action FilePage(1)

                $ current_page = page_name_value.get_page()
                python:
                    try:
                        range_min = max(int(current_page) - 4, 2)
                    except ValueError:
                        range_min = 2
                for page in range(range_min, range_min + 9):
                    textbutton @S action FilePage(page)

                textbutton _(@S) action FilePageNext()


