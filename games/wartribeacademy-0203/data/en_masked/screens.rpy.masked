screen nvl(dialogue, items=None):

    window:
        style @S

        has vbox:
            spacing gui.nvl_spacing

        
        if gui.nvl_height:

            vpgrid:
                cols 1
                yinitial 1.0

                use nvl_dialogue(dialogue)

        else:

            use nvl_dialogue(dialogue)

        
        
        for i in items:

            textbutton i.caption:
                action i.action
                style @S

    add SideImage() xalign 0.0 yalign 1.0


screen nvl_dialogue(dialogue):

    for d in dialogue:

        window:
            id d.window_id

            fixed:
                yfit gui.nvl_height is None

                if d.who is not None:

                    text d.who:
                        id d.who_id

                text d.what:
                    id d.what_id




define config.nvl_list_length = gui.nvl_list_length

style nvl_window is default
style nvl_entry is default

style nvl_label is say_label
style nvl_dialogue is say_dialogue

style nvl_button is button
style nvl_button_text is button_text

style nvl_window:
    xfill True
    yfill True

    background @S
    padding gui.nvl_borders.padding

style nvl_entry:
    xfill True
    ysize gui.nvl_height

style nvl_label:
    xpos gui.nvl_name_xpos
    xanchor gui.nvl_name_xalign
    ypos gui.nvl_name_ypos
    yanchor 0.0
    xsize gui.nvl_name_width
    min_width gui.nvl_name_width
    text_align gui.nvl_name_xalign

style nvl_dialogue:
    xpos gui.nvl_text_xpos
    xanchor gui.nvl_text_xalign
    ypos gui.nvl_text_ypos
    xsize gui.nvl_text_width
    min_width gui.nvl_text_width
    text_align gui.nvl_text_xalign
    layout (@S if gui.nvl_text_xalign else @S)

style nvl_thought:
    xpos gui.nvl_thought_xpos
    xanchor gui.nvl_thought_xalign
    ypos gui.nvl_thought_ypos
    xsize gui.nvl_thought_width
    min_width gui.nvl_thought_width
    text_align gui.nvl_thought_xalign
    layout (@S if gui.nvl_text_xalign else @S)

style nvl_button:
    properties gui.button_properties(@S)
    xpos gui.nvl_button_xpos
    xanchor gui.nvl_button_xalign

style nvl_button_text:
    properties gui.button_text_properties(@S)







style pref_vbox:
    variant @S
    xsize 675



screen quick_menu():
    variant @S

    zorder 100

    if quick_menu:

        hbox:
            style_prefix @S

            xalign 0.5
            yalign 1.0

            textbutton _(@S) action Rollback()
            textbutton _(@S) action Skip() alternate Skip(fast=True, confirm=True)
            textbutton _(@S) action Preference(@S, @S)
            textbutton _(@S) action ShowMenu()
            textbutton _(@S) action HideInterface()


style window:
    variant @S
    background @S

style radio_button:
    variant @S
    foreground @S

style check_button:
    variant @S
    foreground @S

style nvl_window:
    variant @S
    background @S

style main_menu_frame:
    variant @S
    background @S

style game_menu_outer_frame:
    variant @S
    background @S

style game_menu_navigation_frame:
    variant @S
    xsize 510

style game_menu_content_frame:
    variant @S
    top_margin 0

style pref_vbox:
    variant @S
    xsize 600

style bar:
    variant @S
    ysize gui.bar_size
    left_bar Frame(@S, gui.bar_borders, tile=gui.bar_tile)
    right_bar Frame(@S, gui.bar_borders, tile=gui.bar_tile)

style vbar:
    variant @S
    xsize gui.bar_size
    top_bar Frame(@S, gui.vbar_borders, tile=gui.bar_tile)
    bottom_bar Frame(@S, gui.vbar_borders, tile=gui.bar_tile)

style scrollbar:
    variant @S
    ysize gui.scrollbar_size
    base_bar Frame(@S, gui.scrollbar_borders, tile=gui.scrollbar_tile)
    thumb Frame(@S, gui.scrollbar_borders, tile=gui.scrollbar_tile)

style vscrollbar:
    variant @S
    xsize gui.scrollbar_size
    base_bar Frame(@S, gui.vscrollbar_borders, tile=gui.scrollbar_tile)
    thumb Frame(@S, gui.vscrollbar_borders, tile=gui.scrollbar_tile)

style slider:
    variant @S
    ysize gui.slider_size
    base_bar Frame(@S, gui.slider_borders, tile=gui.slider_tile)
    thumb @S

style vslider:
    variant @S
    xsize gui.slider_size
    base_bar Frame(@S, gui.vslider_borders, tile=gui.slider_tile)
    thumb @S

style slider_pref_vbox:
    variant @S
    xsize None

style slider_pref_slider:
    variant @S
    xsize 900
