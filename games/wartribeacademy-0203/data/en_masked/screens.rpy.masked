screen history():

    tag menu

    
    predict False

    use game_menu(_(@S), scroll=(@S if gui.history_height else @S), yinitial=1.0):

        style_prefix @S

        for h in _history_list:

            window:

                
                has fixed:
                    yfit True

                if h.who:

                    label h.who:
                        style @S
                        substitute False

                        
                        
                        if @S in h.who_args:
                            text_color h.who_args[@S]

                $ what = renpy.filter_text_tags(h.what, allow=gui.history_allow_tags)
                text what:
                    substitute False

        if not _history_list:
            label _(@S)




