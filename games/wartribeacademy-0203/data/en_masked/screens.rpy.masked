screen game_menu(title, scroll=None, yinitial=0.0):

    style_prefix @S

    if main_menu:
        add gui.main_menu_background
    else:
        add gui.game_menu_background

    frame:
        style @S

        hbox:

            
            frame:
                style @S

            frame:
                style @S

                if scroll == @S:

                    viewport:
                        yinitial yinitial
                        scrollbars @S
                        mousewheel True
                        draggable True
                        pagekeys True

                        side_yfill True

                        vbox:
                            transclude

                elif scroll == @S:

                    vpgrid:
                        cols 1
                        yinitial yinitial

                        scrollbars @S
                        mousewheel True
                        draggable True
                        pagekeys True

                        side_yfill True

                        transclude

                else:

                    transclude

    use navigation

    textbutton _(@S):
        style @S

        action Return()

    label title

    if main_menu:
        key @S action ShowMenu(@S)


