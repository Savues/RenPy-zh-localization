screen say(who, what):
    style_prefix @S

    window:
        id @S
        background Transform(style.window.background, alpha=persistent.say_window_alpha)

        if who is not None:

            window:
                id @S
                style @S
                text who id @S

        text what id @S


    
    
    if not renpy.variant(@S):
        add SideImage() xalign 0.0 yalign 1.0



