screen skip_indicator():

    zorder 100
    style_prefix @S

    frame:

        hbox:
            spacing 9

            text _(@S)

            text @S at delayed_blink(0.0, 1.0) style @S
            text @S at delayed_blink(0.2, 1.0) style @S
            text @S at delayed_blink(0.4, 1.0) style @S



transform delayed_blink(delay, cycle):
    alpha .5

    pause delay

    block:
        linear .2 alpha 1.0
        pause .2
        linear .2 alpha 0.5
        pause (cycle - .4)
        repeat


