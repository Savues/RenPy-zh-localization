screen confirm(message, yes_action, no_action):

    
    modal True

    zorder 200

    style_prefix @S

    add @S

    frame:

        vbox:
            xalign .5
            yalign .5
            spacing 45

            label _(message):
                style @S
                xalign 0.5

            hbox:
                xalign 0.5
                spacing 150

                textbutton _(@S) action yes_action
                textbutton _(@S) action no_action

    
    key @S action no_action


