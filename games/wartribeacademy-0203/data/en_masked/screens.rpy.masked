screen navigation():

    vbox:
        style_prefix @S

        xpos gui.navigation_xpos
        yalign 0.5

        spacing gui.navigation_spacing

        if main_menu:

            textbutton _(@S) action Start()

        else:

            textbutton _(@S) action ShowMenu(@S)

            textbutton _(@S) action ShowMenu(@S)

        textbutton _(@S) action ShowMenu(@S)

        textbutton _(@S) action ShowMenu(@S)
        
        

        if persistent.pname != None and persistent.tname != None:
            textbutton _(@S) action ShowMenu(@S)
            if _in_replay:

                textbutton _(@S) action EndReplay(confirm=True)

            elif not main_menu:

                textbutton _(@S) action MainMenu()

        textbutton _(@S) action ShowMenu(@S)

        if renpy.variant(@S) or (renpy.variant(@S) and not renpy.variant(@S)):

            
            textbutton _(@S) action ShowMenu(@S)

        if renpy.variant(@S):

            
            
            textbutton _(@S) action Quit(confirm=not main_menu)


