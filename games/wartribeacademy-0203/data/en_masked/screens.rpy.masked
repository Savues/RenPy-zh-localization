screen preferences():

    tag menu

    use game_menu(_(@S), scroll=@S):

        vbox:

            hbox:
                box_wrap True

                if renpy.variant(@S) or renpy.variant(@S):

                    vbox:
                        style_prefix @S
                        label _(@S)
                        textbutton _(@S) action Preference(@S, @S)
                        textbutton _(@S) action Preference(@S, @S)

                vbox:
                    style_prefix @S
                    label _(@S)
                    textbutton _(@S) action Preference(@S, @S)
                    textbutton _(@S) action Preference(@S, @S)
                    textbutton _(@S) action Preference(@S, @S)

                vbox:
                    style_prefix @S
                    label _(@S)
                    textbutton _(@S) action Preference(@S, @S)
                    textbutton _(@S) action Preference(@S, @S)
                    textbutton _(@S) action InvertSelected(Preference(@S, @S))

                
                

            null height (4 * gui.pref_spacing)

            hbox:
                style_prefix @S
                box_wrap True

                vbox:

                    label _(@S)

                    bar value Preference(@S)

                    label _(@S)

                    bar value Preference(@S)

                    label _(@S)

                    bar value FieldValue(persistent, @Q, 1.0, style=@S)

                vbox:

                    if config.has_music:
                        label _(@S)

                        hbox:
                            bar value Preference(@S)

                    if config.has_sound:

                        label _(@S)

                        hbox:
                            bar value Preference(@S)

                            if config.sample_sound:
                                textbutton _(@S) action Play(@S, config.sample_sound)


                    if config.has_voice:
                        label _(@S)

                        hbox:
                            bar value Preference(@S)

                            if config.sample_voice:
                                textbutton _(@S) action Play(@S, config.sample_voice)

                    if config.has_music or config.has_sound or config.has_voice:
                        null height gui.pref_spacing

                        textbutton _(@S):
                            action Preference(@S, @S)
                            style @S


