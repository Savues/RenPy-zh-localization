    if player_name == @S:
        with dissolve
        @S
        @S
    $ persistent.pname = player_name

    @S
    define y = Character(@S, color=@S)
    with dissolve

    who @S
    who @S
    who @S
    who @S
    who @S
    who @S

    $ tribe_name = renpy.input(@S)
    $ tribe_name = tribe_name.strip()

    if tribe_name == @S:
        $ tribe_name=@S
    $ persistent.tname = tribe_name

    who @S
    who @S
    who @S
    who @S
    who @S
    who @S
    menu:
        @S
        @S:
            $ ezmode = True
            with dissolve
            who @S
            who @S
            who @S
            who @S
            who @S
            who @S
            who @S
            who @S
            who @S
            menu:
                @S
                @S:
                    jump prologue_x
                @S:
                    jump enteracademy3
        @S:
            who @S
            who @S
            who @S
            who @S
            who @S
            who @S
            menu:
                @S
                @S:
                    jump prologue_x
                @S:
                    jump enteracademy3
    

label prologue_x:
    scene bg black
    with fade
    @S
    show intro_start_47
    with fade
    soldier2_say @S
    soldier1_say @S
    scene bg black
    show intro_start_48
    with vpunch
    soldier2_say @S
    soldier1_say @S
    scene bg black
    show intro_start_47
    with dissolve
    soldier2_say @S
    soldier2_say @S
    soldier1_say @S

    scene bg black
    show intro_start_49
    with fade
    soldier1_say @S
    scene bg black
    show intro_start_50
    with dissolve
    mistress_say @S
    scene bg black
    show intro_start_52
    with dissolve
    soldier1_say @S
    mistress_say @S
    scene bg black
    show intro_start_53
