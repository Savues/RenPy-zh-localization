label fathers_fort:
    
    scene bg black
    if lovejuna <= 16:
        show father_fort_not
        with fade
    else:
        show father_fort_ready
        with fade
    @S
    if lovejuna == 6:
        jump juna7_1
    elif lovejuna == 16:
        jump juna17_1
    elif loveleo == 11:
        jump leona12_1
    elif lovetima == 1 and loveleo >= 20:
        jump tima2_1
    elif lovefea == 7:
        jump fea8_1
    elif servants == 19 and lovepris >= 30 and loveluce >= 25 and lovemag >= 22 and loverhea >= 26 and loveleo >= 29 and lovemarion >= 39 and lovefea >= 24 and lovecleo >= 23:
        jump servants19_1
    elif servants == 37:
        jump theinvasion13_1
    else:
        @S
        scene bg black
        jump worldmap1

