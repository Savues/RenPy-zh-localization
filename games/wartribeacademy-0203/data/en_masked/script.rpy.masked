label intro_x1:
    play music @S fadein 3.0
    who @S
    who @S
    who @S
    show q_1
    with dissolve
    who @S
    who @S
    who @S
    who @S
    who @S
    who @S
    who @S
    who @S

    $ player_name = renpy.input(@S)
