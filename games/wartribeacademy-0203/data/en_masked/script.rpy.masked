        jump theinvasion14_1
    elif loveluce == 30:
        jump joana8_1
    scene bg black
    with fade
    show cityshot
    with fade
    menu:
        @S
        @S if loveleo == 16:
            jump leona17_1
        @S if lovecleo == 6 and city_open == True:
            jump cleoscene7
        @S if lovecleo == 14:
            jump cleoscene15_1
        @S if lovemag >= 21 and loverhea >= 24 and magdate == 0:
            menu:
                @S
