label magscene6cherry2:
    $ cherry_loop = 1
    $ shield_up = 0
    $ charge_up = 0

    screen simple_stats_screen():
        frame:
            xalign 0.01 yalign 0.05
            xminimum 220 xmaximum 220
            vbox:
                text @S size 22 xalign 0.5
                null height 5
                hbox:
                    bar:
                        xmaximum 130
                        value mc_hp
                        range mc_max_hp
                        left_gutter 0
                        right_gutter 0
                        thumb None
                        thumb_shadow None

                    null width 5

                    text @S size 16
        frame:
            xalign 0.99 yalign 0.05
            xminimum 220 xmaximum 220
            vbox:
                text @S size 22 xalign 0.5
                null height 5
                hbox:
                    bar:
                        xmaximum 130
                        value cherry_hp
                        range cherry_max_hp
                        left_gutter 0
                        right_gutter 0
                        thumb None
                        thumb_shadow None

                    null width 5

                    text @S size 16
        text @S xalign 0.5 yalign 0.05 size 30
    label battle_game_1:
        $ cherry_max_hp = 80
        $ mc_max_hp = 80
        $ cherry_hp = cherry_max_hp
        $ mc_hp = mc_max_hp
        scene bg black
        show mag6_30
        with dissolve
        play music @S fadein 3.0
        @S
        if elder_sword == 1:
            y @S
        jump battle_1_loop
    label battle_1_loop:
        show screen simple_stats_screen
        while (cherry_hp > 0) and (mc_hp > 0):
            show mag6_30
            with dissolve
            menu:
                @S if _in_replay:
                    menu:
                        @S:
                            hide screen simple_stats_screen
                            jump battle_1_ending
                        @S:
                            hide screen simple_stats_screen
                            jump battle_2_ending
                        @S:
                            hide screen simple_stats_screen
                            jump sword_secret
                @S:
                    if elder_sword == 1:
                        scene bg black
                        show mag6_31
                        with vpunch
                        $ mc_damage = renpy.random.randint(15,25)
                        $ cherry_hp -= mc_damage
                        @S
                    else:
                        scene bg black
                        show mag6_31
                        with vpunch
                        $ mc_damage = renpy.random.randint(7,15)
                        $ cherry_hp -= mc_damage
                        @S

                @S if potions_left > 0:
                    scene bg black
                    show mag6_30
                    with dissolve
                    $ mc_hp = min(mc_hp+25, mc_max_hp)
                    $ potions_left -= 1
                    y @S

                @S:
                    scene bg black
                    show mag6_30
                    with dissolve
                    $ shield_up = 1
                    @S

                @S if weapon_art == True:
                    if charge_up == 0:
                        scene bg black
                        show mag6_116
                        with dissolve
                        @S
                        @S
                        $ mc_hp = max(1,mc_hp-10)
                        $ charge_up = 1

                    elif charge_up == 1:
                        scene bg black
                        show mag6_115
                        with dissolve
                        @S
                        @S
                        $ mc_hp = max(1,mc_hp-10)
                        $ charge_up = 2

                    elif charge_up == 2:
                        scene bg black
                        show mag6_119
                        with vpunch
                        cherry @S
                        scene bg black
                        show mag6_118
                        with dissolve
                        cherry @S
                        $ mc_damage = renpy.random.randint(45,60)
                        $ cherry_hp -= mc_damage
                        @S
                        scene bg black
                        show mag6_121
                        with vpunch
                        @S
                        @S
                        $ elder_sword = 3
                        $ charge_up = 0
            if cherry_loop == 2:
                scene bg black
                show mag6_35
                with vpunch
                @S
                if shield_up == 1:
                    scene bg black
                    show mag6_33
                    with vpunch
                    @S
                    scene bg black
                    show mag6_34
                    with vpunch
                    cherry @S
                    $ shield_up = 0
                    $ cherry_loop = 1
                else:
                    $ cherry_damage = renpy.random.randint(1, 6)
                    $ mc_hp -= cherry_damage
                    scene bg black
                    show mag6_35
                    with vpunch
                    @S
                    $ cherry_loop = 1
            elif cherry_loop == 1:
                scene bg black
                show mag6_34
                with vpunch
                @S
                if shield_up == 1:
                    scene bg black
                    show mag6_33
                    with vpunch
                    @S
                    $ mc_damage = renpy.random.randint(5,15)
                    $ cherry_hp -= mc_damage
                    scene bg black
                    show mag6_31
                    with vpunch
                    cherry @S
                    @S
                    $ shield_up = 0
                    $ cherry_loop = 0
                else:
                    $ cherry_damage = renpy.random.randint(10, 20)
                    $ mc_hp -= cherry_damage
                    scene bg black
                    show mag6_32
                    with vpunch
                    cherry @S
                    $ cherry_loop = 0
            elif cherry_loop == 0:
                scene bg black
                show mag6_117
                with dissolve
                @S
                if shield_up == 1:
                    @S
                    @S
                    $ cherry_hp = min(cherry_hp+18, cherry_max_hp)
                    $ cherry_loop = 2
                    $ shield_up = 0
                else:
                    @S
                    $ cherry_hp = min(cherry_hp+8, cherry_max_hp)
                    $ cherry_loop = 2
        hide screen simple_stats_screen
        if cherry_hp <= 0:
            if elder_sword == 3:
                jump sword_secret
            else:
                scene bg black
                show mag6_120
                with vpunch
                y @S
                @S
                jump battle_1_ending
        else:
            cherry @S
            jump battle_2_ending
