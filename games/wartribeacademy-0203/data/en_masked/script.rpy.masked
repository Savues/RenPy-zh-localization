label market1:
    stop music fadeout 3.0
    play sound @S loop fadein 3.0
    play music @S loop fadein 5.0
    show market
    menu:
        @S
        @S if loveleo == 2:
            jump leo3_1
        @S if loveleo == 5:
            jump leo6_1
        @S if loverhea == 4 and joyhelps == 1:
            jump rhea5_1b
        @S if loverhea == 5 and joyhelps == 1:
            jump rhea6_1b
        @S if lovemag == 2:
            stop sound fadeout 3.0
            jump magscene3
        @S if parlor == 0:
            stop music fadeout 3.0
            stop sound
            play music @S fadein 3.0
            show parlor
            with fade
            @S
            @S
            @S
            hide parlor
            $ parlor = 1
            stop music fadeout 3.0
            jump market1
        @S if loverhea == 0:
            stop sound fadeout 5.0
            stop music fadeout 3.0
            scene bg black
            jump rheascene1
        @S if loverhea == 2:
            stop music fadeout 3.0
            stop sound fadeout 3.0
            scene bg black
            jump rheascene3
        @S if loverhea == 3:
            stop music fadeout 3.0
            stop sound fadeout 3.0
            scene bg black
            jump rhea4_1
        @S if lovepris == 3:
            stop music fadeout 3.0
            stop sound fadeout 3.0
            scene bg black
            jump prisscene2
        @S if lovenatxtal == 0:
            stop music fadeout 3.0
            scene bg black
            jump natxtal1
        @S if lovenatxtal == 1:
            stop music fadeout 3.0
            scene bg black
            jump natxtal2
        @S if lovemag >= 5 and lovemag <= 7:
            if parlor == 0:
                $ parlor = 1
            stop sound fadeout 3.0
            if wentxichi == 1:
                jump mag_punishxichi
            elif wentyuni == 1:
                jump mag_punishyuni
            else:
                @S
                jump market1
        @S if lovemarion == 0 and servants >= 16:
            jump marion1_1
        @S if loverhea == 5 and joyhelps == 0:
            jump rhea6_1a
        @S if parlor >= 1 and servants >= 6:
            stop sound fadeout 3.0
            scene bg black
            show parlor
            with fade
            y @S
            if parlor == 1:
                y @S
                $ parlor = 2
                $ parlor_open = 1
                $ massage = 0
                scene bg black
                show parlor_2
                with fade
                par1 @S
                scene bg black
                show parlor_1
                with dissolve
                y @S
                scene bg black
                show parlor_5
                with dissolve
                par1 @S
                jump massage_menu
            else:
                jump massage_menu
        @S:
            stop sound
            scene bg black
            call screen worldmap1
label farm1:
    if lovefea == 24 and servants == 20:
        jump grove1_1
    elif lovepris == 26:
        jump pris26_1
    elif servants == 36:
        jump theinvasion12_1
    scene bg black
    show farm_morn
    with fade    
    menu:
        @S
        @S if lovefea >= 14:
            if lovefea == 14:
                jump fea15_1
            elif lovefea == 15:
                jump fea16_1
            
            elif lovefea == 16 and servants == 17:
                jump fea17_1
            elif lovefea == 17:
                jump fea18_1
            elif lovefea == 18:
                jump fea19_1
            elif lovefea == 19:
                jump fea20_1
            elif lovefea == 20:
                jump fea21_1
            elif lovefea == 21:
                jump fea22_1
            elif lovefea == 22:
                jump fea23_1
            elif lovefea == 23:
                jump fea24_1
            else:
                @S
                hide farm_morn
                with fade
                call screen exit1
        @S:
            y @S
            hide farm_morn
            with fade
            call screen exit1
        @S if lovepris == 11:
            jump prisscene12
