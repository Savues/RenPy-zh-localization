label broingnx_director:
    if loveingn == 3:
        jump brothelingn3_1
    elif loveingn == 4:
        jump brothelingn4_1
    elif fuckp1 == 2:
        jump brothelingn3_2
    elif fuckp2 == 2:
        jump brothelingn4_3
    elif loveluce >= 7 and lucePartydancer == 3:
        jump rummi1
    elif loveingn >= 6 and trueingn >= 7:
        jump broingnx_x
    elif loveingn == 5 and trueingn >= 7:
        jump broingn5_1
    else:
        $ ingn_girls = renpy.random.randint(1,2)
        if ingn_girls == 1:
            jump brothelingn3_x
        elif ingn_girls == 2:
            jump brothelingn4_2

