            jump bona1_isha
        @S if bona_q_1 == 0 and bona_q_2 == 0 and bona_q_3 == 0:
            jump bona1_3
        @S if bona_q_1 == 1 or bona_q_2 == 1 or bona_q_3 == 1:
            jump bona1_3
