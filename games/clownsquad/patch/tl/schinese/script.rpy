translate schinese first_lewd_scene_46ab737f:

    # r "(Not this time. I ain’t losing again.)"
    r "（这次不会。我不会再输了。）"

# game/script.rpy:4392
translate schinese first_lewd_scene_1b87e506:

    # ti "(Time to shake off the bloody boredom!)"
