# This file has one line that used to spell its CropMove mode out as the literal
# 'slideleft'.  tools/build_tl.py rewrites every string on a line into the line
# it has already shortened, so a second literal on the same line gets written at
# a stale offset.  Naming the mode is the fix, and the value cannot be dropped:
# 'slideleft' is not CropMove's default, the default is 'slideright'.
init python:
    ZH_SLIDELEFT = "slideleft"

# TODO: Translation updated at 2025-12-13 21:02

# game/script.rpy:61
translate schinese start_d338c3dd:

    # a "He’s had his say. Now we must decide who’s worthy of that honour."
    a "他话说完了。现在该由我们来决定，谁配得上那份荣誉。"

# game/script.rpy:63
translate schinese start_4b624790:

    # aa "..."
    aa "……"

# game/script.rpy:65
translate schinese start_e35edbfc:

    # a "Naturally. I should’ve expected as much."
    a "果然如此。我早该料到的。"

# game/script.rpy:66
translate schinese start_25fd5cc3:

    # a "Your word?"
    a "您说了算？"

# game/script.rpy:68
translate schinese start_9e5ff07c:

    # aaa "Hmmm... Ah’ve nay mood t’ toy wi’ ’em t’night. It’s on ye, old man... aye— or maybe not…"
    aaa "嗯……俺今晚没心思跟他们玩了。这事儿归你管，老头子……嗯——要不还是算了……"

# game/script.rpy:69
translate schinese start_76a98f1f:

    # aaa "Tell me then, were th’ whispers true? D’yeh say he’s flames where his head should be?"
    aaa "那你说说，那些传闻是真的？他们说他脑袋顶上烧着火？"

# game/script.rpy:71
translate schinese start_fa5d0467:

    # a "No comment."
    a "无可奉告。"

# game/script.rpy:72
translate schinese start_a666e173:

    # a "I’d introduce myself properly, but the man whose interests I represent has, rather firmly, forbidden me to do so."
    a "我本想正式自我介绍，但我所代表的那位先生，已经相当坚决地禁止我这么做。"

# game/script.rpy:73
translate schinese start_849df2f9:

    # a "Still, I must admit — conversing with someone whose name I don’t know feels… distasteful."
    a "不过我必须承认——和一个连名字都不知道的人交谈，感觉……不太体面。"

# game/script.rpy:74
translate schinese start_5b7ac670:

    # a "So, tell me — what do they call you?"
    a "那么，告诉我——他们怎么称呼你？"

# game/script.rpy:79
translate schinese start_fddd3b7a:

    # a "Interesting..."
    a "有意思……"

# game/script.rpy:81
translate schinese start_34e62188:

    # aaa "Impressive… yet Ah’d hoped fer somethin’ far more… graceful."
    aaa "倒是气派……可惜俺盼的是更……雅致的东西。"

# game/script.rpy:82
translate schinese start_b2aec0ac:

    # aaa "Still— Ah’m nay th’ one t’ judge ye."
    aaa "不过——评判你可轮不到俺。"

# game/script.rpy:83
translate schinese start_bb8e4b4e:

    # a "..."
    a "……"

# game/script.rpy:85
translate schinese start_0e2fa17f:

    # a "A few clarifications. The focus of this tale lies in its visual and novelistic nature. The adult element — merely a formality."
    a "先澄清几点。这个故事的重点在于其视觉与文字性质。成人内容——不过是走个形式。"

# game/script.rpy:86
translate schinese start_695d05bc:

    # a "Secondly, a small request from someone above my pay grade: play it with headphones… or music."
    a "第二，一位比我级别高的人有个小请求：请戴上耳机……或者开着音乐游玩。"

# game/script.rpy:88
translate schinese start_f57a8a04:

    # a "I’ll admit, his taste is remarkably refined."
    a "我得承认，他的品味相当高雅。"

# game/script.rpy:91
translate schinese start_3b731132:

    # aa "Taste is a subjective matter."
    aa "品味是主观的事。"

# game/script.rpy:92
translate schinese start_bb8e4b4e_1:

    # a "..."
    a "……"

# game/script.rpy:94
translate schinese start_5ce5ec73:

    # a "Third—there will be {b}no{/b} choices. Your journey is entirely linear."
    a "第三——将不会有{b}任何{/b}选项。你的旅程完全是线性的。"

# game/script.rpy:95
translate schinese start_223a0f1e:

    # a "Fourth — expect strong accents. You might find them… challenging."
    a "第四——请做好听到浓重口音的准备。你可能会觉得它们……有点吃力。"

# game/script.rpy:97
translate schinese start_e0f88101:

    # aaa "He’s no ape, that one. A couple o’ brains knockin’ aboot in there, sure enough. He’ll manage."
    aaa "那位可不是蠢货。脑袋里装着好几个机灵鬼呢，他应付得来。"

# game/script.rpy:100
translate schinese start_fd92d537:

    # aa "Have we resorted to bluntness now?"
    aa "我们现在改成直来直去了吗？"

# game/script.rpy:102
translate schinese start_27d2b284:

    # aaa "What then? Somethin’ botherin’ ye, love?"
    aaa "那又怎样？有什么让俺不爽的，亲爱的？"

# game/script.rpy:104
translate schinese start_092277cb:

    # a "Enough."
    a "够了。"

# game/script.rpy:105
translate schinese start_0605995a:

    # aaa "Tsk…"
    aaa "啧……"

# game/script.rpy:108
translate schinese start_9fe2ee2d:

    # a "That was the last of it."
    a "这是最后一句。"

# game/script.rpy:109
translate schinese start_e4a6f033:

    # a "If you disagree with anything I’ve said—by all means, leave this place."
    a "如果你对我说的任何一点有异议——大可离开这里。"

# game/script.rpy:110
translate schinese start_432000a8:

    # a "Write your furious little review if it pleases you… but I assure you, I couldn’t care less."
    a "随你写你那些气鼓鼓的小评论吧……但我向你保证，我一点也不在乎。"

# game/script.rpy:113
translate schinese start_3283031f:

    # aa "You speak on his behalf."
    aa "你是在替他说话。"

# game/script.rpy:114
translate schinese start_488a815c:

    # nn "Let it be, I’ve no quarrel with that. Should things go astray, he’ll serve as the lamb of atonement."
    nn "随他去吧，我对此没意见。要是真出了岔子，他就当是替罪羊了。"

# game/script.rpy:116
translate schinese start_bb8e4b4e_2:

    # a "..."
    a "……"

# game/script.rpy:117
translate schinese start_59547637:

    # a "[mc]?"
    a "[mc]？"

# game/script.rpy:118
translate schinese start_c89aa377:

    # a "Still here? Then… enjoy yourself."
    a "还在？那就……好好享受吧。"

# game/script.rpy:123
translate schinese start_5f8d6342:

    # mc "Keep pushing, they said. You’ll make it."
    mc "他们说，坚持下去，你行的。"

# game/script.rpy:124
translate schinese start_9f6969c3:

    # mc "Yeah. Sure."
    mc "是啊。是啊。"

# game/script.rpy:125
translate schinese start_46b7f72f:

    # mc "Add a kitten, sunrise, and boom — instant motivation."
    mc "再来一只小猫、一片朝阳，砰——动力瞬间拉满。"

# game/script.rpy:129
translate schinese start_969bb766:

    # mc "(For me, that’s comedy gold.)"
    mc "（对我来说，这就是年度最佳笑话。）"

# game/script.rpy:132
translate schinese start_57295015:

    # "Breaking news! At 2:23 PM today, terrorists have seized a shopping mall— shouting ‘For anime!’"
    "突发新闻！今天下午2点23分，恐怖分子占领了一家购物中心——高喊着「为了动漫！」"

# game/script.rpy:134
translate schinese start_0d366bc2:

    # "…and, quoting directly: ‘No taxes on anime!’ and… ‘Bring back the old school uniforms!’"
    "——并原话报道：「动漫免税！」以及……「把旧式水手服还回来！」"

# game/script.rpy:135
translate schinese start_f2c30c57:

    # mc "(And that’s humanity’s grand mission.)"
    mc "（这就是人类的大使命。）"

# game/script.rpy:136
translate schinese start_41f8f0b1:

    # mc "(Meanwhile, I’m still trying to crawl out of my frog hole.)"
    mc "（而我还在努力从自己的井底往外爬。）"

# game/script.rpy:139
translate schinese start_932d3070:

    # mc "(Since I was a kid, my parents kept saying: ‘Son, success will come! Just keep trying!’)"
    mc "（从小到大，父母总说：「儿子，成功会来的！只要坚持就行！」）"

# game/script.rpy:140
translate schinese start_9bb6b23c:

    # mc "(Spoiler: it didn’t.)"
    mc "（剧透：并没有。）"

# game/script.rpy:141
translate schinese start_7311e3a9:

    # mc "(You can grind your soul out, but without luck — you’re just Extra Number Three, dying off-screen.)"
    mc "（你可以把灵魂磨光，但没运气的话——你就是那种三号龙套，死在画面外。）"

# game/script.rpy:143
translate schinese start_8735bd48:

    # "It’s The Great One! He’s here to save them!"
    "是至高者！他来救他们了！"

# game/script.rpy:144
translate schinese start_72d97f97:

    # mc "(This world’s split in two: the blessed… and the rest. The frogs like me, staring up from the well.)"
    mc "（这个世界分成两半：被眷顾的人……和其余的人。像我这种青蛙，只能从井里干瞪眼。）"

# game/script.rpy:146
translate schinese start_103f0920:

    # "No need to thank me! Justice and safety for all citizens!"
    "不用谢我！正义与安全，献给全体市民！"

# game/script.rpy:148
translate schinese start_1481ec8d:

    # mc "(Yeah… and for the sponsors, the merch deals, and that shiny mayor’s chair.)"
    mc "（是啊……还有赞助商、周边授权，和那把闪闪发亮的市长椅子。）"

# game/script.rpy:149
translate schinese start_8b0e3f00:

    # mc "(The whole world’s a ball of lies — shrink-wrapped in heroism.)"
    mc "（整个世界就是一坨谎言——用英雄主义封了膜。）"

# game/script.rpy:163
translate schinese start_0dd53834:

    # mc "(Oh, and that’s me. The king of losers, and the poor bastard this shitty story’s about.)"
    mc "（啊，还有我。失败者之王，也是这破故事的主角倒霉蛋。）"

# game/script.rpy:166
translate schinese start_bd168045:

    # L "Didn’t think about toning down that bravado, huh? My ears are bleeding from all that self-love from him."
    L "是没打算收敛点那套吹嘘吧？光是他那些自恋的话，我耳朵都要流血了。"

# game/script.rpy:167
translate schinese start_286a2fde:

    # mc "Narcissism or not, the crowd seems to love it."
    mc "自恋归自恋，观众似乎挺吃这套。"

# game/script.rpy:169
translate schinese start_bf422575:

    # L "Yeah, yeah, big talk for someone with an ego the size of a thumb. Anyway, cut the drama, let’s move on."
    L "是是是，自恋到拇指头那么大还说得这么起劲。行了，别演了，继续吧。"

# game/script.rpy:170
translate schinese start_0914def5:

    # mc "(This girl — oh wait, not the mysterious kind. Just Lena.)"
    mc "（这姑娘——哦等等，不是那种神秘型的。就是莉娜。）"

# game/script.rpy:183
translate schinese start_3b2e9932:

    # mc "(Childhood friend.)"
    mc "（青梅竹马。）"

# game/script.rpy:184
translate schinese start_157321d9:

    # mc "(Puts up with my crap better than anyone I know.)"
    mc "（能忍受我那些乱七八糟的东西，比我认识的人都强。）"

# game/script.rpy:188
translate schinese start_ba1b8f6b:

    # mc "Still, he’s got power, money, and muscles — which pretty much compensate for his microscopic ego."
    mc "不过他有力量、有钱、有肌肉——基本能把那点针尖大的自尊补回来了。"

# game/script.rpy:190
translate schinese start_dfccdd82:

    # L "Oh please, jealous much? Relax, everyone’s got their own kind of shine."
    L "拜托，吃醋了？放轻松，每个人都有自己的闪光点。"

# game/script.rpy:191
translate schinese start_853bde78:

    # mc "(You wouldn’t guess it, but she’s actually kind. Vain sometimes, dramatic often… but deep down? Not half bad.)"
    mc "（看不出来吧，其实她人挺好。偶尔虚荣，经常戏剧化……但骨子里？还不赖。）"

# game/script.rpy:193
translate schinese start_5f00c373:

    # L "So what, nature’s not exactly fair. Happens."
    L "那又怎样，天生就不公平。常态。"

# game/script.rpy:194
translate schinese start_d4ea9b18:

    # L "Not everyone’s cut out to be a superhero."
    L "不是每个人都适合当超级英雄。"

# game/script.rpy:195
translate schinese start_75df8b79:

    # mc "(Or maybe that’s just what I tell myself.)"
    mc "（也可能那只是我安慰自己的说辞。）"

# game/script.rpy:198
translate schinese start_82b07031:

    # L "Anyway — how’s the new job? Heard you finally decided to, y’know, do something for once."
    L "话说回来——新工作怎么样？听说你终于决定干点正事了。"

# game/script.rpy:199
translate schinese start_e258c8ce:

    # mc "Surprisingly great — if you ignore the tiny pain in my ass."
    mc "出乎意料地好——如果你忽略我屁股上那点小疼的话。"

# game/script.rpy:201
translate schinese start_7640fded:

    # L "Oh sure, she gave you a place to live, a job, free food — and you still find something to whine about."
    L "得了吧，她给你地方住、给你工作、还包吃——你还能找到东西抱怨。"

# game/script.rpy:202
translate schinese start_c703ebac:

    # L "Typical."
    L "真典型。"

# game/script.rpy:203
translate schinese start_21edf222:

    # mc "Excuse me? She invaded my garage, turned it into her personal kingdom, and somehow I’m the bad guy?"
    mc "你说什么？她霸占了我的车库，把它变成她的私人王国，结果我成了坏人？"

# game/script.rpy:206
translate schinese start_b66eac0b:

    # L "Seriously? You’re really gonna blame her for that?"
    L "认真的？你真要为此怪她？"

# game/script.rpy:207
translate schinese start_303de000:

    # L "Think back — if I were your babysitter, I’d’ve done the same."
    L "想想看——如果我是你的保姆，我也会这么干。"

# game/script.rpy:208
translate schinese start_17f27899:

    # L "Plus, you got kicked out. Maybe time to use that brain a little, huh?"
    L "再说了，是你自己被赶出来的。差不多动动脑子了吧？"

# game/script.rpy:211
translate schinese start_2a8e49d9:

    # L "…Hey, why’re you grabbing my leg?"
    L "……喂，你抓我腿干嘛？"

# game/script.rpy:212
translate schinese start_d33dfba3:

    # mc "(Time to teach her some respect.)"
    mc "（是时候教她尊重一下长辈了。）"

# game/script.rpy:214
translate schinese start_6dfa57d4:

    # L "Oh no, don’t tell me you’re—"
    L "哦不，别告诉我你要——"

# game/script.rpy:215
translate schinese start_2b35b6fe:

    # mc "..."
    mc "……"

# game/script.rpy:216
translate schinese start_1160fff0:

    # L "[mc]...?"
    L "[mc]……？"

# game/script.rpy:220
translate schinese start_6c82d9ce:

    # L "Ha! Oh no, not that!"
    L "哈！哦不，不是那个！"

# game/script.rpy:221
translate schinese start_556243e9:

    # L "Aah! Stop! It tickles! It tickles—!"
    L "啊！住手！好痒！痒——！"

# game/script.rpy:222
translate schinese start_df1f0333:

    # mc "(Yeah… we’ve got a weird friendship. For some reason, she actually enjoys when I mess with her like this.)"
    mc "（是啊……我们的友谊很奇怪。不知为什么，她其实很享受我这样逗她。）"

# game/script.rpy:223
translate schinese start_35b624a7:

    # mc "(You ask what the point is? Profound, actually.)"
    mc "（你问这有什么意义？意义深远着呢。）"

# game/script.rpy:226
translate schinese start_9e7c7da7:

    # mc "(Feet and the world — yin and yang, baby. Balance and harmony.)"
    mc "（脚与世界——阴阳，宝贝。平衡与和谐。）"

# game/script.rpy:227
translate schinese start_55f7e426:

    # mc "(Yeah, sounds stupid. But in my head, it checks out.)"
    mc "（听着是挺蠢的。但在我脑子里逻辑完美。）"

# game/script.rpy:230
translate schinese start_8aa372fc:

    # L "Ha! Picture time! Say cheese!"
    L "哈！拍照时间！笑一个！"

# game/script.rpy:232
translate schinese start_01ab5ebf:

    # L "Perfect! You look adorable. Now let’s send it to your ex—let her di—"
    L "完美！你好可爱。现在发给你前任——让她死——"

# game/script.rpy:233
translate schinese start_6d0482f8:

    # L "What the—?!"
    L "搞什——？！"

# game/script.rpy:242
translate schinese start_f537b53f:

    # mc "Ow, ow… hey, congrats — kindness successfully received."
    mc "哎哟、哎哟……喂，恭喜——恶意成功传达了。"

# game/script.rpy:243
translate schinese start_91e3eaa8:

    # mc "But next time, maybe try a gentler delivery, huh?"
    mc "不过下次能不能换个温柔点的表达方式？"

# game/script.rpy:246
translate schinese start_ee97d1a5:

    # L "Sorry! I didn’t mean to. I keep forgetting how strong I am."
    L "对不起！我不是故意的。我总是忘记自己有多强。"

# game/script.rpy:247
translate schinese start_7f8f7d0d:

    # mc "Eh, I’m alive, so I’d call the experiment a success."
    mc "反正我还活着，这实验就算成功了。"

# game/script.rpy:250
translate schinese start_bad474e8:

    # L "No, seriously. I messed up again."
    L "不是，我说真的。我又搞砸了。"

# game/script.rpy:251
translate schinese start_3c11b875:

    # L "I’ve really gotta learn to control it."
    L "我真的得学会控制它。"

# game/script.rpy:252
translate schinese start_dcf348fe:

    # mc "Come on, be proud!"
    mc "来，为自己骄傲吧！"

# game/script.rpy:253
translate schinese start_11560dee:

    # mc "Not everyone can upgrade a man’s spine to version 2.0 with a single kick."
    mc "可不是谁都能靠一脚把男人的脊椎升级到2.0版本。"

# game/script.rpy:254
translate schinese start_d86bc3d9:

    # L "Ha-ha, very funny."
    L "哈哈，真有你的。"

# game/script.rpy:255
translate schinese start_7418844b:

    # L "Still, I get nervous when I lose control like that."
    L "不过，我一那样失控就会紧张。"

# game/script.rpy:257
translate schinese start_152fe148:

    # mc "So, tell me, was that ‘signature move’ of yours pure improv, or was there a reason behind the assault?"
    mc "所以告诉我，你那招“招牌动作”是纯即兴，还是蓄意伤人？"

# game/script.rpy:259
translate schinese start_078c41ce:

    # L "Oh, right!"
    L "哦对了！"

# game/script.rpy:262
translate schinese start_35028911:

    # L "My phone’s gone again… classic me, scatterbrained as ever."
    L "我手机又不见了……老样子，我永远这么丢三落四。"

# game/script.rpy:264
translate schinese start_74ea5ecd:

    # mc "(She’s getting stronger… or maybe I’m just getting softer.)"
    mc "（她越来越强了……也可能只是我越来越软。）"

# game/script.rpy:265
translate schinese start_e06e8183:

    # mc "(Then again, she’s one of the Academy’s best for a reason.)"
    mc "（不过话说回来，她能成为学院最强之一是有原因的。）"

# game/script.rpy:267
translate schinese start_9f2a0e73:

    # mc "(Iron Queen of the year, and me — the idiot who doesn’t know when to shut up. Perfect combo.)"
    mc "（年度铁女王，配上我这个不知何时该闭嘴的笨蛋。绝配。）"

# game/script.rpy:268
translate schinese start_01705b46:

    # mc "(At least after that hit, I’ve earned a spot in the survivor rankings.)"
    mc "（至少挨了那一下之后，我在幸存者排名里也占了一席。）"

# game/script.rpy:269
translate schinese start_c71c4298:

    # mc "(Feels good — ‘Tougher than a cockroach.’)"
    mc "（感觉不错——“比蟑螂还硬。”）"

# game/script.rpy:271
translate schinese start_7f951f43:

    # L "What, zoning out again? Earth to genius!"
    L "怎么，又走神了？天才，回过神来！"

# game/script.rpy:273
translate schinese start_0a43bebd:

    # mc "Shh, don’t interrupt."
    mc "嘘，别打断。"

# game/script.rpy:274
translate schinese start_dd1384d0:

    # mc "I’m having a heated debate with my subconscious about which one of us is dumber… {w}and my brain’s winning."
    mc "我正在和潜意识激烈辩论，看我们俩谁更蠢……{w}而我的大脑在领先。"

# game/script.rpy:276
translate schinese start_0cec23a3:

    # mc "And now I’m losing even in the one place I was supposed to be king"
    mc "结果连本该称王的地方我都输了"

# game/script.rpy:278
translate schinese start_2d6c3886:

    # L "Cool."
    L "真酷。"

# game/script.rpy:279
translate schinese start_9bb3ad25:

    # L "Save me a seat in that place of yours — I’m bringing sarcasm and a little chaos."
    L "在那个地方给我留个位子——我要带上讽刺和一点点混乱。"

# game/script.rpy:282
translate schinese start_1ef7b069:

    # mc "Well, well… strong, smart, and outstanding— uh, legs… inviting me to share the throne?"
    mc "哎呀哎呀……强壮、聪明、而且出色——呃，还有腿……这是在邀请我共治天下？"

# game/script.rpy:283
translate schinese start_3df758a5:

    # mc "I’d be an idiot to say no."
    mc "要拒绝的话我就真是个笨蛋了。"

# game/script.rpy:285
translate schinese start_67007abd:

    # L "Flatterer."
    L "油嘴滑舌。"

# game/script.rpy:286
translate schinese start_61eee931:

    # L "Anyway, enough talk — look."
    L "总之，废话少说——你看。"

# game/script.rpy:287
translate schinese start_fbdc7102:

    # L "You got accepted."
    L "你被录取了。"

# game/script.rpy:289
translate schinese start_b79ddbfd:

    # mc "What’s that supposed to mean?"
    mc "你这话什么意思？"

# game/script.rpy:291
translate schinese start_ef7cb1f4:

    # L "The Hero Academy, obviously."
    L "当然是英雄学院啊。"

# game/script.rpy:293
translate schinese start_6bb9c57e:

    # mc "You’re kidding."
    mc "你开玩笑吧。"

# game/script.rpy:297
translate schinese start_df3dff55:

    # L "Since when do I lie? I’m the most honest one around here."
    L "我什么时候撒过谎？我可是这儿最诚实的人。"

# game/script.rpy:299
translate schinese start_4966b524:

    # mc "There’s a first time for everything."
    mc "凡事都有第一次。"

# game/script.rpy:301
translate schinese start_b4bb87ae:

    # L "Then consider yourself lucky — I keep my “first times” for special occasions."
    L "那你就该庆幸吧——我的“第一次”可是留给特殊场合的。"

# game/script.rpy:305
translate schinese start_b198e21c:

    # mc "Which means…"
    mc "也就是说……"

# game/script.rpy:309
translate schinese start_c971c37c:

    # mc "Time to celebrate!"
    mc "该庆祝了！"

# game/script.rpy:311
translate schinese start_cc7233fa:

    # L "Time to get ready!"
    L "该准备准备了！"

# game/script.rpy:315
translate schinese start_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/script.rpy:318
translate schinese start_9993b94e:

    # L "..."
    L "……"

# game/script.rpy:321
translate schinese start_8e89330b:

    # mc "Celebrate."
    mc "庆祝。"

# game/script.rpy:324
translate schinese start_27870c40:

    # L "Getting ready." with CropMove(time=0.1, mode=ZH_SLIDELEFT)
    L "准备。" with CropMove(time=0.1, mode=ZH_SLIDELEFT)

# game/script.rpy:330
translate schinese start_1237b9f6:

    # L "Compromise. I call a compromise. We prep now, we celebrate later."
    L "折中。我宣布折中。现在准备，之后庆祝。"

# game/script.rpy:334
translate schinese start_2246f168:

    # mc "Denied. Activating T-pose intimidation! We celebrate now!"
    mc "驳回。启动T字姿势威慑！现在就庆祝！"

# game/script.rpy:336
translate schinese start_9993b94e_1:

    # L "..."
    L "……"

# game/script.rpy:341
translate schinese start_cfbf00ae:

    # mc "Ow! What the hell, Lena?! We agreed— no forbidden moves!"
    mc "哎哟！搞什么啊，莉娜？！说好了——不许用禁招！"

# game/script.rpy:345
translate schinese start_2542a1d5:

    # L "No foot-licking privileges for the next couple weeks."
    L "接下来几周取消你的舔脚特权。"

# game/script.rpy:347
translate schinese start_918df5ec:

    # mc "You really think {b}that{/b} threat’s gonna work on me?"
    mc "你真以为{b}那种{/b}威胁对我有用？"

# game/script.rpy:352
translate schinese start_107ed229:

    # L "Oh, I’m {b}sure{/b} it will."
    L "哦，我{b}很确定{/b}会。"

# game/script.rpy:356
translate schinese start_e9cfe3fb:

    # mc "I withdraw my refusal to withdraw."
    mc "我撤回我的“拒绝撤回”。"

# game/script.rpy:359
translate schinese start_45b442b2:

    # mc "Alright then— where do we start?"
    mc "那好——从哪儿开始？"

# game/script.rpy:360
translate schinese start_77fe05ad:

    # L "Time, fashionista."
    L "时间到了，时尚大师。"

# game/script.rpy:374
translate schinese start_a51860ca:

    # L "Move out!"
    L "出发！"

# game/script.rpy:384
translate schinese garage_3bcdf6d2:

    # L "Oh right, I just remembered — you sold your scooter, didn’t you? So… how exactly are we getting to the mall?"
    L "哦对了，我刚想起来——你把摩托车卖了，对吧？那……我们到底怎么去商场？"

# game/script.rpy:385
translate schinese garage_76b799a4:

    # mc "Don’t worry, I’ve got it covered."
    mc "别担心，我有办法。"

# game/script.rpy:389
translate schinese garage_3e9906b1:

    # mc "Feast your eyes on this majestic mess — a garage packed with more junk than my self-esteem."
    mc "请欣赏这壮丽的乱象——一个堆的东西比我的自尊还多的车库。"

# game/script.rpy:390
translate schinese garage_853a87b4:

    # mc "You name it, it happened here — from selling elf socks to holding mock presidential elections."
    mc "你能想到的这儿都发生过——从卖精灵袜子到举办模拟总统大选。"

# game/script.rpy:392
translate schinese garage_6f3ff0b7:

    # L "When you mentioned this place, I thought you were exaggerating. Please — forget it. It’s way worse than I imagined…"
    L "你说起这个地方时，我还以为你在夸张。拜托——忘了吧。比我想象的糟糕一百倍……"

# game/script.rpy:395
translate schinese garage_2a6a8917:

    # mc "Wanna know the name of this insanity?"
    mc "想知道这场混乱叫什么名字吗？"

# game/script.rpy:396
translate schinese garage_9e6f5c78:

    # mc "Don’t bother answering — I’ll tell you anyway. Beatrice."
    mc "不用回答，我自己告诉你。碧翠丝。"

# game/script.rpy:397
translate schinese garage_994e0358:

    # n "Catch him! Don’t let him get away!"
    n "抓住他！别让他跑了！"

# game/script.rpy:400
translate schinese garage_9adfd94c:

    # mc "A meter and a half of the most disgusting liquid known to mankind."
    mc "整整一米半，全人类最恶心的液体。"

# game/script.rpy:401
translate schinese garage_30cbffe1:

    # L "You’ve always needed a babysitter, no surprise there."
    L "你果然一直都需要保姆，一点都不意外。"

# game/script.rpy:402
translate schinese garage_95b556e2:

    # mc "Maybe I’ve lost it once or twice — not really my fault, by the way."
    mc "也许我脑子坏过一两次——不过那真不怪我。"

# game/script.rpy:405
translate schinese garage_03f5d028:

    # mc "But a babysitter? Nah. Especially not this walking ego-trip over here."
    mc "但保姆？才不是。尤其不是眼前这个行走的自我中心。"

# game/script.rpy:406
translate schinese garage_7020cc16:

    # mc "More like a black hole that swallows your wallet for ‘important personal needs.’"
    mc "更像是吞噬你钱包的黑洞，美其名曰“重要的个人需求”。"

# game/script.rpy:407
translate schinese garage_8d453866:

    # batman "Batman’s here!"
    batman "蝙蝠侠来了！"

# game/script.rpy:409
translate schinese garage_1a7df4d5:

    # batman "WHERE’S THE DETONATOR?! WHERE IS IT?!"
    batman "引爆器在哪儿？！在哪儿？！"

# game/script.rpy:412
translate schinese garage_44018f7a:

    # b "Oi, oi, hold it! You there — clown!"
    b "喂，喂，等等！那边那个——小丑！"

# game/script.rpy:413
translate schinese garage_aca9e1e0:

    # b "Grab your arse and get off my set, yeah? We’re makin’ history here!"
    b "夹着屁股从我片场滚出去，行吗？我们这儿在创造历史呢！"

# game/script.rpy:423
translate schinese garage_ab14fd43:

    # mc "(Beatrice...)"
    mc "（碧翠丝……）"

# game/script.rpy:424
translate schinese garage_3a2ed0dc:

    # mc "(She’s… uh, the daughter of my mom’s friend’s granddaughter, or someone like that. Honestly, I don’t really remember. But she acts as the overseer.)"
    mc "（她是……呃，我妈朋友的孙女的女儿，或者大概是这种关系。老实说我也不太记得了。但她确实是这个片子的监制。）"

# game/script.rpy:425
translate schinese garage_a6654710:

    # mc "(Or like the older sister I never had.)"
    mc "（或者就像我从来没有过的姐姐。）"

# game/script.rpy:427
translate schinese garage_ab1bcf10:

    # mc "History, my ass. The best you can do is a third-rate movie with a budget of three bowls of rice."
    mc "历史个屁。你顶多拍个三流电影，预算三碗米。"

# game/script.rpy:428
translate schinese garage_0914b37f:

    # mc "Claiming it’s ‘real’ and ‘authentic’ on your channel — lies, fraud, same as the rest of your colleagues."
    mc "还在频道里吹什么“真实”“还原”——谎言、欺诈，跟你那些同行一个德性。"

# game/script.rpy:431
translate schinese garage_6aba4537:

    # mc "Oh, did I hit a nerve? My bad — occupational hazard."
    mc "哦，扎到痛处了？抱歉——职业病。"

# game/script.rpy:432
translate schinese garage_2939b5a5:

    # L "You’re kinda crossing the line — she might actually take that personally."
    L "你这话有点过分了——她可能会真的往心里去。"

# game/script.rpy:435
translate schinese garage_6b9fc0b8:

    # mc "Oh, don’t let that cute face fool you. She’ll chew through your bones the second you blink."
    mc "哦，别被那张可爱的脸骗了。你一眨眼她就能把你的骨头嚼碎。"

# game/script.rpy:438
translate schinese garage_2efbb4e4:

    # mc "Even if you were the Greatest of the Greats, she wouldn’t stop. Right, shortie?"
    mc "就算你是至高者中的至高者，她也不会停手。对吧，小不点？"

# game/script.rpy:444
translate schinese garage_fe8d340c:

    # b "You havin’ a laugh, ya talentless prat? Ruined the scene, mouthed off at me, and now you’re throwin’ names?"
    b "你在笑吗，没天赋的废物？砸了我的场子，顶撞了我，现在还开始编排人？"

# game/script.rpy:445
translate schinese garage_a37484e7:

    # b "And then you wonder why no one can stand workin’ with ya!"
    b "然后你还不明白为什么没人受得了跟你共事！"

# game/script.rpy:446
translate schinese garage_fbb96392:

    # mc "Save your whining. Just tell me where you`re scooter went, and we’ll be gone."
    mc "省省你的抱怨。告诉我你的摩托车在哪儿，我们就走。"

# game/script.rpy:449
translate schinese garage_043647a0:

    # b "Hmph… What, ran outta cash sellin’ your scooter, so you flogged mine instead? Real clever, that. Walk, you broke git."
    b "哼……怎么，卖车卖到没钱了，就把我那辆也卖了？真聪明啊。走回去吧，穷光蛋。"

# game/script.rpy:450
translate schinese garage_f6105df5:

    # mc "Trust me, I’d love to walk out — but we’ve got company."
    mc "相信我，我也很想走着出去——但我们有伴了。"

# game/script.rpy:453
translate schinese garage_0dec60ca:

    # L "Hey, Beatrice."
    L "嗨，碧翠丝。"

# game/script.rpy:454
translate schinese garage_4ace0dca:

    # b "Len, love… been ages. You could’ve told me you were droppin’ by today."
    b "莉娜，宝贝……好久不见。你早说今天要来啊。"

# game/script.rpy:455
translate schinese garage_e17bf623:

    # L "It all happened too fast, sorry-sorry!"
    L "事情发展得太快了，抱歉抱歉！"

# game/script.rpy:457
translate schinese garage_202c2c12:

    # b "This tosser dragged you into his nonsense again, didn’t he?"
    b "这混蛋又把你拖进他那堆破事里了，是不是？"

# game/script.rpy:459
translate schinese garage_a7d5b33f:

    # L "Today’s an exception. I’m the one who started this whole thing, so please, Beatrice — just for today, okay?"
    L "今天是例外。整件事是我挑起的，所以求你了，碧翠丝——就今天，行吗？"

# game/script.rpy:461
translate schinese garage_ae7cabca:

    # mc "(She’s got a point. Tomorrow’s a big day. Whatever it takes — I have to give it everything.)"
    mc "（她说得有道理。明天是大日子。不管怎样——我必须全力以赴。）"

# game/script.rpy:462
translate schinese garage_5f8a9f24:

    # mc "(After all, chances like this don’t come twice.)"
    mc "（毕竟，这种机会不会有第二次。）"

# game/script.rpy:464
translate schinese garage_20df98b4:

    # mc "(Main objective: don’t ruin Lena’s reputation just by existing.)"
    mc "（主要目标：别光靠存在就毁了莉娜的名声。）"

# game/script.rpy:465
translate schinese garage_77d7e963:

    # L "(whispering) Huh, I wonder what he’s thinking about at times like this…"
    L "（低声）不知道这种时候他在想什么呢……"

# game/script.rpy:466
translate schinese garage_034d2861:

    # b "(whispering) Feet. That’s all he ever thinks about — feet."
    b "（低声）脚。他脑子里只有脚——脚。"

# game/script.rpy:468
translate schinese garage_c8ee96fd:

    # b "(whispering) He’s lookin’ at us now. Guess the bloke’s back on Earth."
    b "（低声）他在看我们了。看来这家伙回到地面了。"

# game/script.rpy:469
translate schinese garage_16cedfbd:

    # L "(whispering) Every time, I’m amazed how he can just… tune the whole world out. Seriously, how does he do that?"
    L "（低声）每次我都惊讶他怎么能就这样……把整个世界都调成静音。说真的，他怎么做到的？"

# game/script.rpy:471
translate schinese garage_21a56bdf:

    # mc "You know I can hear you, right? Then again, I guess that’s half the fun for you two."
    mc "你们知道我听得见吧？不过话说回来，这大概就是你们一半的乐趣。"

# game/script.rpy:473
translate schinese garage_22ec7b17:

    # L "No offense, we’ve been trying to reach you for like five minutes straight. You were just… gone."
    L "无意冒犯，但我们连续叫了你足足五分钟。你当时就……神游去了。"

# game/script.rpy:475
translate schinese garage_40d26793:

    # b "Couldn’t’ve said it better. Poor lad hasn’t seen daylight in ages."
    b "说得太好了。可怜的孩子不知道多久没见过太阳了。"

# game/script.rpy:476
translate schinese garage_8d39a36f:

    # b "Had to keep an eye on this muppet — proper headache, that one. With his bloody attitude."
    b "还得盯着这个蠢货——他那副欠揍的臭脾气，真是让人头疼。"

# game/script.rpy:480
translate schinese garage_03748995:

    # b "He’s all yours, girl. Don’t let him cock things up this time."
    b "他归你了，姑娘。这次别让他搞砸了。"

# game/script.rpy:481
translate schinese garage_af2ff611:

    # L "I’ll bring him back in one piece, promise."
    L "我保证完完整整地把他带回来。"

# game/script.rpy:489
translate schinese garage_c7e61d15:

    # batman "So… you’re Beatrice’s famous roommate. The most unlucky hero alive."
    batman "所以……你就是碧翠丝那位有名的室友。世上最倒霉的英雄。"

# game/script.rpy:491
translate schinese garage_9363fe02:

    # mc "Kinda ironic hearing that from a guy pretending to be Batman. He didn’t have any superpowers either, remember?"
    mc "从一个假扮蝙蝠侠的人嘴里听到这话，还真是讽刺。他当年也没有超能力，记得吧？"

# game/script.rpy:493
translate schinese garage_fec2846c:

    # batman "Are you rich?"
    batman "你有钱吗？"

# game/script.rpy:495
translate schinese garage_59446876:

    # mc "Buy a sandwich? Sure. That’s my level of luxury."
    mc "买三明治？算。这就是我的奢侈水平。"

# game/script.rpy:497
translate schinese garage_37b1ea75:

    # batman "Do you have servants… or advanced tech?"
    batman "你有仆人……或者先进科技吗？"

# game/script.rpy:499
translate schinese garage_73f13947:

    # mc "Had a scooter. Sold it. Mistakes were made."
    mc "我有过一辆摩托车。卖了。犯了个错误。"

# game/script.rpy:501
translate schinese garage_50c99b26:

    # batman "Were your parents… killed by criminals?"
    batman "你父母……是被罪犯杀死的吗？"

# game/script.rpy:503
translate schinese garage_ac3acb76:

    # mc "Nope. Still alive and well — disappointing, I know."
    mc "没有。还活着还挺好——我知道，这挺让人失望。"

# game/script.rpy:505
translate schinese garage_d1e4bfa0:

    # batman "And yet, you call yourself a hero. No money. No tragedy. No edge. A failure… in every category."
    batman "可你还自称英雄。没钱。没悲剧。没锋芒。各方面都是个失败者……"

# game/script.rpy:507
translate schinese garage_b99d4fdc:

    # mc "Nothing’s stopping me from kicking your ass right now."
    mc "现在没人拦得住我揍你。"

# game/script.rpy:509
translate schinese garage_97396c5d:

    # b "Right, glad you lot are best mates now an’ all, but move your arses, yeah?"
    b "行，既然你们现在是铁哥们了，赶紧动起来，行吗？"

# game/script.rpy:510
translate schinese garage_b9b2bf34:

    # b "’Specially you, flyin’ rat — back on set, chop-chop!"
    b "尤其是你，飞天耗子——回片场，快点！"

# game/script.rpy:513
translate schinese garage_1d86a0e0:

    # L "By the way, Beatrice — tomorrow at five we’re throwing a little celebration. You in? I’ll make something sweet!"
    L "对了，碧翠丝——明天五点我们办个小庆祝。你来吗？我做点甜的！"

# game/script.rpy:515
translate schinese garage_b6fe00cd:

    # mc "Hold on — when exactly did we agree on that date? Or are we doing the politician thing — 'voluntary-compulsory'?"
    mc "等一下——我们到底什么时候约的这个日子？还是说你要玩政客那套——“自愿强制”？"

# game/script.rpy:516
translate schinese garage_b2a4243a:

    # L "You against it? Come on… please?"
    L "你不愿意？拜托……求你了？"

# game/script.rpy:517
translate schinese garage_1fc5962e:

    # mc "Nah, I’m cool with it."
    mc "没事，我不介意。"

# game/script.rpy:518
translate schinese garage_13b0c9c4:

    # mc "What do you say, Beatrice?"
    mc "碧翠丝，你怎么说？"

# game/script.rpy:520
translate schinese garage_1920a5ca:

    # b "I’m in — but someone seems to’ve forgotten what they promised me today."
    b "我去——但好像有人忘了今天答应过我什么。"

# game/script.rpy:522
translate schinese garage_010611af:

    # mc "Relax, I didn’t even bother remembering that promise. So… remind me, what did I supposedly agree to?"
    mc "放心，我压根没费心去记那个承诺。所以……提醒我一下，我到底答应了什么来着？"

# game/script.rpy:526
translate schinese garage_3f174710:

    # b "You cheeky little sod. I’ve got an interview with The Great One tonight, and you’re comin’ with me."
    b "你这小混蛋。今晚我要跟至高者做访谈，你跟我一起来。"

# game/script.rpy:528
translate schinese garage_d73b2300:

    # mc "Come on, there’s already one narcissist there — no room for a sequel."
    mc "拜托，那里已经有一个自恋狂了——塞不下续集。"

# game/script.rpy:532
translate schinese garage_533e4555:

    # b "Trust me, I ain’t thrilled either — but you’ve got no bloody choice."
    b "相信我，我也不想去——但你压根没得选。"

# game/script.rpy:533
translate schinese garage_5dba9d6f:

    # mc "I’ll do everything in my power {b}not{/b} to show up."
    mc "我会尽一切努力{b}不{/b}去。"

# game/script.rpy:536
translate schinese garage_4ab072c8:

    # b "Knew ya would."
    b "就知道你会这么说。"

# game/script.rpy:544
translate schinese garage_77ab7600:

    # b "(whispering) Jokes aside — this’s for your own good. Stop runnin’, yeah?"
    b "（低声）玩笑归玩笑——这是为你好。别再逃了，行吗？"

# game/script.rpy:545
translate schinese garage_318cd327:

    # b "(whispering) Time you stood on your own damn feet, sunshine."
    b "（低声）是时候靠你自己那双该死的脚站起来了，小家伙。"

# game/script.rpy:547
translate schinese garage_c54a9fe8:

    # mc "(She’s serious... What the hell did you drag me into, short stack?)"
    mc "（她是认真的……你到底把我拖进什么鬼东西里了，小矮子？）"

# game/script.rpy:549
translate schinese garage_5d82fe57:

    # mc "Soon as I can. Worst case — I show up naked."
    mc "尽快。实在不行，我就光着身子去。"

# game/script.rpy:555
translate schinese garage_dcd9bf51:

    # b "Long as you show up, I don’t give a toss how — clothed or not. Len, he’s yours for now, but not for long."
    b "只要你人到了，穿没穿我根本不在乎。莉娜，他现在归你，但不会太久。"

# game/script.rpy:558
translate schinese garage_35f2e3b8:

    # L "So… you’re not allowed to drive, right? Mind if I take the wheel?"
    L "所以……你不许开车，对吧？我来开行吗？"

# game/script.rpy:561
translate schinese garage_f3245923:

    # mc "Why would you think that? I’m driving."
    mc "你为什么会这么想？我开。"

# game/script.rpy:564
translate schinese garage_e93cab12:

    # L "No way. Did you forget the last time you drove? Not up for discussion."
    L "想都别想。你忘了你上次开车的事了？没什么好商量的。"

# game/script.rpy:567
translate schinese garage_b66c6495:

    # mc "Everyone deserves a second chance."
    mc "每个人都该有第二次机会。"

# game/script.rpy:570
translate schinese garage_1e3530c5:

    # L "You already used up your “one mistake” quota."
    L "你的“一次犯错”额度已经用完了。"

# game/script.rpy:572
translate schinese garage_ad746276:

    # b "Before you two start scrapin’, Lena drives. You sit your arse down and behave."
    b "在你们俩打起来之前，莉娜开车。你给我坐好老实点。"

# game/script.rpy:578
translate schinese garage_640f5c76:

    # batman "BATMAN!"
    batman "蝙蝠侠！"

# game/script.rpy:579
translate schinese garage_e4f343ae:

    # mc "Exactly my point."
    mc "正是我要说的。"

# game/script.rpy:590
translate schinese street_ses1_d7eea55d:

    # mc "Len? Can I ask you… It might sound weird or out of nowhere, but I wa—"
    mc "莉娜？我能问你个事吗……可能听上去很奇怪也很突然，但我——"

# game/script.rpy:591
translate schinese street_ses1_e20036fe:

    # L "Yeah, yeah, go ahead, ask away."
    L "嗯嗯，问吧，问吧。"

# game/script.rpy:593
translate schinese street_ses1_5c9b6f39:

    # mc "Why do you care about me?"
    mc "你为什么在乎我？"

# game/script.rpy:594
translate schinese street_ses1_9e1bab3f:

    # mc "I get Beatrice. She’s stuck with me by law of bad luck."
    mc "碧翠丝我认了，她是被厄运绑定才甩不掉我。"

# game/script.rpy:595
translate schinese street_ses1_d80a5e40:

    # mc "But you? The top girl at the Academy… hanging out with a clown?"
    mc "但你呢？学院的第一名……跟一个小丑混在一起？"

# game/script.rpy:596
translate schinese street_ses1_fbbc7645:

    # mc "I mean, I knew I was charming — just not {b}that{/b} charming."
    mc "我是说，我知道自己有魅力——只是没那么{b}有魅力{/b}。"

# game/script.rpy:598
translate schinese street_ses1_33d7484f:

    # L "Okay, that’s… weird. Where’d {b}that{/b} come from?"
    L "好吧，这……有点怪。{b}没那么有魅力{/b}是从哪冒出来的？"

# game/script.rpy:599
translate schinese street_ses1_2623a710:

    # mc "Come on, what’s in it for you helping me?"
    mc "拜托，你帮我对你有什么好处？"

# game/script.rpy:600
translate schinese street_ses1_d460a7d1:

    # mc "I’ve been turning that over in my head for ages and came up empty."
    mc "我想了好久都没想出来。"

# game/script.rpy:601
translate schinese street_ses1_f3b7843e:

    # L "I dunno, feels kinda obvious to me."
    L "不知道啊，对我来说挺显而易见的。"

# game/script.rpy:603
translate schinese street_ses1_915a6515:

    # mc "Maybe, but it sure as hell isn’t obvious to me."
    mc "对你来说也许，但对我来说绝对不是。"

# game/script.rpy:604
translate schinese street_ses1_8f8ef58c:

    # mc "Unless, of course, you prefer hanging out with a third-rate clown over all those high-and-mighty heroes."
    mc "除非——当然了，你更愿意跟一个三流小丑混，而不是那些高高在上的英雄。"

# game/script.rpy:605
translate schinese street_ses1_6b95cbb1:

    # L "Believe it or not, that’s one of the reasons."
    L "信不信由你，这确实是原因之一。"

# game/script.rpy:606
translate schinese street_ses1_6ecbbefc:

    # L "Just the thought of talkin’ to those guys makes me sick."
    L "光是想想跟那帮人说话我就犯恶心。"

# game/script.rpy:607
translate schinese street_ses1_7a87e544:

    # L "You’ll get it once you get in."
    L "等你进去就懂了。"

# game/script.rpy:608
translate schinese street_ses1_cb716400:

    # mc "You mean {b}if{/b} I actually get in."
    mc "你是说{b}万一{/b}我真进去了。"

# game/script.rpy:609
translate schinese street_ses1_435b5fa3:

    # mc "Still gotta make it through the damn interview first."
    mc "我得先通过那该死的面试。"

# game/script.rpy:611
translate schinese street_ses1_f3a0d386:

    # L "Oh, please. With that silver tongue of yours, there’s no way you’ll bomb it."
    L "得了吧。就凭你那张嘴，不可能搞砸的。"

# game/script.rpy:612
translate schinese street_ses1_16a2eedc:

    # mc "Life didn’t exactly deal me a lucky hand. Clown, remember?"
    mc "人生可没给我发什么好牌。记得吗？小丑。"

# game/script.rpy:613
translate schinese street_ses1_edf4ec24:

    # L "Yeah, yeah."
    L "是是是。"

# game/script.rpy:614
translate schinese street_ses1_f15d64d5:

    # L "Still, you’re the hardest-working guy I know."
    L "不过，你是我认识的人里最努力的。"

# game/script.rpy:615
translate schinese street_ses1_bc509b12:

    # L "And if you do fail, I’m walkin’ out with ya."
    L "要是你真失败了，我就跟你一起走人。"

# game/script.rpy:616
translate schinese street_ses1_e852adbb:

    # mc "Even as a joke, that’s a bit much."
    mc "就算是玩笑，这也太过了。"

# game/script.rpy:617
translate schinese street_ses1_14fc8129:

    # mc "(Though… hell, if she actually meant it…)"
    mc "（不过……靠，她要是认真的……）"

# game/script.rpy:618
translate schinese street_ses1_0edd71f3:

    # mc "(…which is weird. People like her don’t just hand out kindness.)"
    mc "（……这就奇怪了。像她那种人不会随便对人好的。）"

# game/script.rpy:620
translate schinese street_ses1_4e7296d6:

    # mc "I’m just… not used to someone sticking around without a reason."
    mc "我只是……不习惯有人毫无理由地留在我身边。"

# game/script.rpy:621
translate schinese street_ses1_7bf13321:

    # L "That ex of yours really did a number on your ego, huh?"
    L "你那个前任把你伤得不轻啊，是吧？"

# game/script.rpy:622
translate schinese street_ses1_6d6b32c7:

    # L "Things ain’t as dark as you make ’em. Sometimes people just… "
    L "事情没你想的那么糟。有时候人就是……"

# game/script.rpy:623
translate schinese street_ses1_c3a8c1ac:

    # L "wanna make it a bit easier for someone else. No strings attached."
    L "想让别人的日子好过一点。不求回报。"

# game/script.rpy:624
translate schinese street_ses1_fa9df8c2:

    # mc "Yeah, right, and your world with us in one room?"
    mc "是啊，好啊。那你那个世界里关着我们俩会是什么样？"

# game/script.rpy:625
translate schinese street_ses1_1843d417:

    # mc "Lies, murders, inequality — thats world familiar to me."
    mc "谎言、谋杀、不平等——那种世界我很熟。"

# game/script.rpy:627
translate schinese street_ses1_4da7cf2d:

    # L "Seriously? Comin’ from the guy who spent two years talkin’ to his walls?"
    L "认真的？这话是那个对着自己的墙说了两年话的人说的？"

# game/script.rpy:628
translate schinese street_ses1_56b8b17a:

    # mc "This was an arc of self-growth and acceptance, thank you very much!"
    mc "这是一段自我成长与接纳的旅程，非常感谢！"

# game/script.rpy:629
translate schinese street_ses1_6bbb7aa1:

    # L "Exactly why I {b}know{/b} you’ll nail it."
    L "这正是我{b}确定{/b}你能搞定的理由。"

# game/script.rpy:631
translate schinese street_ses1_989871b4:

    # L "And quit draggin’ yourself down, got it? You’re not any worse than the rest."
    L "还有，别再贬低自己了，听见没？你不比别人差。"

# game/script.rpy:632
translate schinese street_ses1_13a8c558:

    # mc "(Why the hell does she say that with such confidence?)"
    mc "（她怎么能这么有把握地说出这种话？）"

# game/script.rpy:633
translate schinese street_ses1_69f3d640:

    # mc "(I haven’t believed words like that in ages…)"
    mc "（我已经很久没听过这种话了……）"

# game/script.rpy:635
translate schinese street_ses1_8b9bb47f:

    # mc "Easy for you to say, Ms. One of the Few S-Class Abilities."
    mc "S级稀有能力之一的大小姐，说这话当然轻松。"

# game/script.rpy:638
translate schinese street_ses1_d21acb14:

    # L "Hey, hey— I didn’t just sit on my ass, y’know? I worked for it."
    L "喂，喂——我可不是光坐着不动的，好吗？那是我努力来的。"

# game/script.rpy:640
translate schinese street_ses1_33649824:

    # mc "Like me, remember? But life… life had other plans."
    mc "跟我一样，记得吧？可人生……人生另有安排。"

# game/script.rpy:646
translate schinese street_ses1_ae59b506:

    # n "What the gorgeous! Snazzy helmet, I gotta say."
    n "哇哦，真是养眼！这头盔，帅。"

# game/script.rpy:647
translate schinese street_ses1_c62100c6:

    # n "Caught your little chat… fancy spendin’ some time with someone who actually {b}wins{/b}, yeah?"
    n "偷听到你们的悄悄话了……想不想跟真正{b}会赢{/b}的人待上一阵？"

# game/script.rpy:649
translate schinese street_ses1_8bb197f6:

    # n "That sidekick of yours?"
    n "就你那个跟班？"

# game/script.rpy:650
translate schinese street_ses1_283c1c30:

    # n "Pathetic. Not even close to your level."
    n "可笑。跟你根本不是一个层次。"

# game/script.rpy:651
translate schinese street_ses1_55b2b28f:

    # n "Me? I’ve got the cash, the muscle, the brains, and trust me… the women?"
    n "我？我有钱、有肌肉、有脑子，而且相信我……还有女人？"

# game/script.rpy:652
translate schinese street_ses1_f537c0dc:

    # n "They flock. Always."
    n "她们成群扑来。一直如此。"

# game/script.rpy:654
translate schinese street_ses1_2e646c08:

    # n "And yeah, I’m not just talkin’."
    n "而且对，我是说真的。"

# game/script.rpy:655
translate schinese street_ses1_403fac01:

    # n "Top G of the Hero Academy, mate. Best of the best."
    n "兄弟，英雄学院G级第一。精英中的精英。"

# game/script.rpy:656
translate schinese street_ses1_34519688:

    # n "Even The Greatest knows my name. Not everyone’s cut out for this kinda game."
    n "连至高者都知道我的名字。不是每个人都玩得起这种游戏。"

# game/script.rpy:658
translate schinese street_ses1_db285e92:

    # mc "The Greatest himself? Damn, you’re quite the guy."
    mc "至高者本人？啧，你还真是个人物。"

# game/script.rpy:659
translate schinese street_ses1_35f13e6a:

    # mc "Tell me — his sister as hot as him?"
    mc "告诉我——他妹妹有他那么辣吗？"

# game/script.rpy:661
translate schinese street_ses1_2b241136:

    # mc "(…note to self: flirting like a fool is my default setting.)"
    mc "（……备忘：像个傻子一样调情是我的默认设定。）"

# game/script.rpy:662
translate schinese street_ses1_f739a4c4:

    # mc "Maybe… I could get her number?"
    mc "也许……我能要到她的号码？"

# game/script.rpy:664
translate schinese street_ses1_59522e71:

    # n "Look in the mirror lately, clown? That little mate of yours is soft."
    n "最近照过镜子吗，小丑？你那个小跟班软得很。"

# game/script.rpy:665
translate schinese street_ses1_4606da3b:

    # n "Come over here, maybe I’ll even hook you up at the Hero Academy…"
    n "过来求我，说不定我还能在英雄学院给你安排一下……"

# game/script.rpy:666
translate schinese street_ses1_5f2c4a13:

    # n "if I feel like it."
    n "看我心情。"

# game/script.rpy:668
translate schinese street_ses1_65b4ea2b:

    # L "(Whispering) I swear, one more word from him and I’ll turn him into paste."
    L "（低声）我发誓，他再多说一个字，我就把他打成肉泥。"

# game/script.rpy:669
translate schinese street_ses1_e0d8719a:

    # mc "(Whispering) Chill, I’ve got a better idea."
    mc "（低声）冷静，我有个更好的主意。"

# game/script.rpy:671
translate schinese street_ses1_f2233f29:

    # mc "(…because clearly reasoning is not his strong suit.)"
    mc "（……因为很明显，讲道理不是他的强项。）"

# game/script.rpy:672
translate schinese street_ses1_98b441ad:

    # mc "Whoa, your generosity knows no bounds."
    mc "哇，你的大方真是没有边界。"

# game/script.rpy:673
translate schinese street_ses1_9fb87ba2:

    # mc "But lemme spill a little scary secret — we Greatest and I used to be best buds once."
    mc "但让我抖落一个有点吓人的秘密——我跟至高者以前可是好兄弟。"

# game/script.rpy:675
translate schinese street_ses1_9748b970:

    # n "Tryna lie now? Ha! Pathetic."
    n "想骗人了？哈！可笑。"

# game/script.rpy:676
translate schinese street_ses1_1da1bf78:

    # n "What colour is your bugatti?"
    n "你的布加迪是什么颜色？"

# game/script.rpy:677
translate schinese street_ses1_9fc4fc07:

    # n "You’ll never match my level, mate. {w}Never."
    n "你永远达不到我的层次，兄弟。{w}永远。"

# game/script.rpy:679
translate schinese street_ses1_03e1375e:

    # mc "Oh, going personal now? Don’t bother, buddy."
    mc "哦，改成攻击我本人了？省省吧，老兄。"

# game/script.rpy:680
translate schinese street_ses1_6ae73d31:

    # mc "How’s your mom?"
    mc "你妈怎么样？"

# game/script.rpy:682
translate schinese street_ses1_7396ac0b:

    # n "Don’t get clever with me—"
    n "别跟我耍聪明——"

# game/script.rpy:684
translate schinese street_ses1_baaea0f6:

    # mc "Say hi for me!"
    mc "替我向你妈问好！"

# game/script.rpy:686
translate schinese street_ses1_ede5ce62:

    # n "Absolute chaos! Hah!"
    n "一塌糊涂！哈！"

# game/script.rpy:687
translate schinese street_ses1_83a0cb79:

    # n "I ain’t lettin’ you two anywhere near that Academy."
    n "我可不会让你们俩靠近那所学院半步。"

# game/script.rpy:688
translate schinese street_ses1_460d837d:

    # n "I’ll make sure your circus act ends before it even starts."
    n "我保证你们这场马戏还没开场就结束。"

# game/script.rpy:690
translate schinese street_ses1_4d61f277:

    # n "Trust me, I {b}dominate{/b} everything I touch."
    n "相信我，我碰过的东西全都被我{b}支配{/b}。"

# game/script.rpy:691
translate schinese street_ses1_c2b0b862:

    # mc "(…and yet, I’m supposed to play nice with these maniacs?)"
    mc "（……可我还得跟这群疯子好好相处？）"

# game/script.rpy:695
translate schinese street_ses1_d1144cf4:

    # mc "He blew up way worse than I expected. 4/10."
    mc "他这波翻车比我预想的还严重。评分：4/10。"

# game/script.rpy:696
translate schinese street_ses1_1e3b5a71:

    # mc "Not quite the fireworks I hoped for. Back in the day, these rich pricks had way sharper tongues."
    mc "不是我期待的那种烟花。要搁以前，这帮有钱混账的嘴要毒得多。"

# game/script.rpy:697
translate schinese street_ses1_0285ea23:

    # mc "Degeneration at its finest."
    mc "堕落的极致。"

# game/script.rpy:699
translate schinese street_ses1_ed9c316e:

    # L "Gotta admit, that was clean."
    L "得承认，那一下挺干净的。"

# game/script.rpy:701
translate schinese street_ses1_5a5d4935:

    # L "But why’d you drop {b}that{/b} name? You know what kind of trouble that can stir up."
    L "可你为什么要提{b}那个{/b}名字？你知道那会惹上什么麻烦。"

# game/script.rpy:703
translate schinese street_ses1_2e1278d6:

    # mc "Come on, saw me?"
    mc "拜托，说得我好像很惨似的？"

# game/script.rpy:704
translate schinese street_ses1_117508be:

    # mc "Heard it straight from the Greatest himself, they wouldn’t believe it. Let alone now."
    mc "这话我是从至高者本人嘴里听来的，他们都不会信。更别说现在了。"

# game/script.rpy:705
translate schinese street_ses1_2f7a9e56:

    # L "I’d believe it."
    L "我信。"

# game/script.rpy:707
translate schinese street_ses1_e8937d47:

    # mc "I’m not surprised. You believed in a round Earth not too long ago, remember?"
    mc "我不意外。你前不久还相信地球是平的，记得吗？"

# game/script.rpy:708
translate schinese street_ses1_cd2297a9:

    # L "It is {b}round{/b} though…"
    L "可它确实是{b}圆{/b}的……"

# game/script.rpy:709
translate schinese street_ses1_9abfc86f:

    # mc "As you say."
    mc "您说什么就是什么。"

# game/script.rpy:717
translate schinese Isabella_scene1_7f15f736:

    # L "No, seriously, it is."
    L "不是，我是认真的，真的是。"

# game/script.rpy:722
translate schinese Isabella_scene1_591000a8:

    # p "Father, heard the news? About those terrorists. How’d I do, eh? Quite the show, wasn’t it?"
    p "父亲，新闻您看了吗？就那些恐怖分子的事。我干得怎么样？挺精彩的吧？"

# game/script.rpy:723
translate schinese Isabella_scene1_0da652c7:

    # p "You should’ve seen their faces— beggin’ for mercy like dogs! Bloody priceless, that was!"
    p "您真该看看他们的脸——像狗一样求饶！太他妈值了！"

# game/script.rpy:726
translate schinese Isabella_scene1_d19f855d:

    # c "..."
    c "……"

# game/script.rpy:727
translate schinese Isabella_scene1_d7c23565:

    # c "Did that, by any chance, improve our ratings?"
    c "请问，那一下有没有提升我们的评分？"

# game/script.rpy:729
translate schinese Isabella_scene1_d45a5161:

    # p "It’s all over the feeds, Father. These folk— easy to steer, easy to please."
    p "父亲，网上全炸了。这些人——好引导，好满足。"

# game/script.rpy:732
translate schinese Isabella_scene1_e6bf9113:

    # c "Isabella. The same question."
    c "伊莎贝拉。同样问题。"

# game/script.rpy:735
translate schinese Isabella_scene1_11a51645:

    # i "No, Father… my brother’s little display has only darkened our name."
    i "没有，父亲……哥哥那点小表演只会让我们家族蒙羞。"

# game/script.rpy:736
translate schinese Isabella_scene1_1603eb1f:

    # i "Seven souls lost, thirteen left to suffer —"
    i "七条人命丧生，十三个人继续受苦——"

# game/script.rpy:737
translate schinese Isabella_scene1_265f18ac:

    # i "the result, a fall of six points in the rating."
    i "结果是评分暴跌六分。"

# game/script.rpy:740
translate schinese Isabella_scene1_fc096211:

    # c "Your assessment?"
    c "你的评估？"

# game/script.rpy:741
translate schinese Isabella_scene1_584a38d5:

    # i "A complete failure."
    i "一场彻头彻尾的失败。"

# game/script.rpy:742
translate schinese Isabella_scene1_79c48c0b:

    # c "Thank you, Isabelle."
    c "谢谢你，伊莎贝拉。"

# game/script.rpy:746
translate schinese Isabella_scene1_32fe5a7e:

    # c "Your sister is quite right — your little stunt has cost us dearly."
    c "你姐姐说得对——你那个小把戏让我们付出了惨痛代价。"

# game/script.rpy:747
translate schinese Isabella_scene1_d70f04a3:

    # c "Poor ratings make for a poor reputation."
    c "评分差，声望就差。"

# game/script.rpy:748
translate schinese Isabella_scene1_f602031a:

    # c "And a poor reputation...?"
    c "而声望差……？"

# game/script.rpy:749
translate schinese Isabella_scene1_d35f253e:

    # p "The Dellaines’ll grab the mayor’s chair, I know. I know, Father."
    p "德拉伊姆家会抢走市长席位，我知道的。我知道，父亲。"

# game/script.rpy:750
translate schinese Isabella_scene1_ca5c3531:

    # c "Then tell me — what will you do, my son?"
    c "那告诉我——你打算怎么办，儿子？"

# game/script.rpy:753
translate schinese Isabella_scene1_c8ea8a4a:

    # p "..."
    p "……"

# game/script.rpy:754
translate schinese Isabella_scene1_9058cb26:

    # p "(Sod the ratings... and that damned chair. As if any of it means a thing.)"
    p "（管他评分……管他那该死的椅子。好像这一切真有什么要紧似的。）"

# game/script.rpy:755
translate schinese Isabella_scene1_37b54561:

    # p "(Just once, say it... I’m proud of you, son. But no— that’d be too human for the great Headmaster, wouldn’t it?)"
    p "（就说一次也好……“我为你骄傲，儿子。”但不行——对伟大的校长来说，那太有人味了，是吧？）"

# game/script.rpy:757
translate schinese Isabella_scene1_0d2d2c32:

    # c "I asked you a question."
    c "我在问你问题。"

# game/script.rpy:760
translate schinese Isabella_scene1_b2349671:

    # p "Sorry, drifted off a bit. I’ll fix it, Father— I swear it."
    p "抱歉，走神了一会儿。我会补救的，父亲——我发誓。"

# game/script.rpy:761
translate schinese Isabella_scene1_67287a2b:

    # c "How?"
    c "怎么？"

# game/script.rpy:762
translate schinese Isabella_scene1_fb54db6f:

    # p "We’ve got an interview tonight. I’ll win the crowd back— raise the bloody {b}ratings{/b}, you’ll see."
    p "今晚有一场访谈。我会把观众赢回来——把那该死的{b}评分{/b}拉上去，您看着。"

# game/script.rpy:763
translate schinese Isabella_scene1_7fb3bc04:

    # c "Isabelle."
    c "伊莎贝拉。"

# game/script.rpy:765
translate schinese Isabella_scene1_23b3d06b:

    # c "Philip has an interview scheduled today. You’ll keep an eye on him. Make sure he doesn’t... embarrass us."
    c "菲利普今天有一场访谈。你看着他。别让他……让我们难堪。"

# game/script.rpy:767
translate schinese Isabella_scene1_5a7ef56e:

    # i "Yes... Father."
    i "是……父亲。"

# game/script.rpy:768
translate schinese Isabella_scene1_a57eb543:

    # p "Father! Isabelle’s still not—"
    p "父亲！伊莎贝拉还没康复——"

# game/script.rpy:770
translate schinese Isabella_scene1_84f30c66:

    # c "Enough. You’re a strong boy, Philip. But strength without respect... is a bullet without powder."
    c "够了。你是个强壮的男孩，菲利普。但没有尊重的强壮……就是一颗没有火药的子弹。"

# game/script.rpy:771
translate schinese Isabella_scene1_99d010a3:

    # c "The Dellaines are not asleep, son. One mistake is all it takes for them to erase us."
    c "德拉伊姆家没有在睡，儿子。一个失误就足够让我们消失。"

# game/script.rpy:772
translate schinese Isabella_scene1_1697f4cb:

    # c "The mayoral elections are close. And you will take that seat."
    c "市长选举就快开始了。而那个位子必须由你拿下。"

# game/script.rpy:774
translate schinese Isabella_scene1_1665120c:

    # c "It’s her job to make sure you don’t say... anything regrettable."
    c "她的工作就是确保你不会说出……任何后悔的话。"

# game/script.rpy:775
translate schinese Isabella_scene1_b9aed2d4:

    # c "Is that clear?"
    c "听明白了吗？"

# game/script.rpy:777
translate schinese Isabella_scene1_6d4061bb:

    # p "I’ll do my best. You have my word."
    p "我会尽全力。我向您保证。"

# game/script.rpy:782
translate schinese Isabella_scene1_76b69863:

    # c "He’s your responsibility now. Do not disappoint me."
    c "现在他是你的责任了。别让我失望。"

# game/script.rpy:784
translate schinese Isabella_scene1_0960aef1:

    # i "Yes, Father."
    i "是，父亲。"

# game/script.rpy:786
translate schinese Isabella_scene1_d19f855d_1:

    # c "..."
    c "……"

# game/script.rpy:797
translate schinese Isabella_scene1_598465f5:

    # p "You sure, sis? You’re still not well..."
    p "你确定吗，姐姐？身体还没好……"

# game/script.rpy:798
translate schinese Isabella_scene1_26884bb6:

    # i "Don’t trouble yourself, brother..."
    i "别为哥哥操心……"

# game/script.rpy:799
translate schinese Isabella_scene1_d42e686c:

    # i "A few hours among people will not harm me."
    i "在人堆里待几个小时不会伤到我。"

# game/script.rpy:801
translate schinese Isabella_scene1_9f3feab2:

    # p "There’ll be crowds— a lot of ‘em."
    p "会很多人——非常多人。"

# game/script.rpy:803
translate schinese Isabella_scene1_3ea2d2e1:

    # i "There will be many… I know."
    i "会有很多人……我知道。"

# game/script.rpy:804
translate schinese Isabella_scene1_f5e63ae0:

    # i "But Father has spoken."
    i "但父亲已经发话了。"

# game/script.rpy:806
translate schinese Isabella_scene1_2972703c:

    # p "Admit it— Father’s lost his mind since that time. Ratings this, ratings that... treats us like livestock."
    p "承认吧——父亲从那之后就疯了。评分、评分……把我们当牲口。"

# game/script.rpy:807
translate schinese Isabella_scene1_3674e1e1:

    # p "Especially you... Tell me, Belle— how d’you even stomach it?"
    p "尤其是你……告诉我，贝莉——你怎么忍得下去？"

# game/script.rpy:809
translate schinese Isabella_scene1_efd26e2b:

    # i "What is it you’re speaking of, brother?"
    i "哥哥你在说什么？"

# game/script.rpy:812
translate schinese Isabella_scene1_6e7ebb02:

    # p "It’s ‘bout that bloke, innit? What was his name... [mc]?"
    p "是说那个小子吧？他叫什么来着……[mc]？"

# game/script.rpy:813
translate schinese Isabella_scene1_f9b62220:

    # i "Brother… please, do not."
    i "哥哥……请不要。"

# game/script.rpy:815
translate schinese Isabella_scene1_c2aa0311:

    # p "Right, right— my bad. Forget I said that."
    p "好好好——我的错。当我没说。"

# game/script.rpy:819
translate schinese Isabella_scene1_de27ccbd:

    # p "Anyway— time to lift those ratings, eh? Little sister."
    p "总之——该去拉一拉评分了，是吧？小妹妹。"

# game/script.rpy:821
translate schinese Isabella_scene1_df0a0efe:

    # p "After all, an idol shouldn’t rot away at home, should she?"
    p "毕竟，偶像可不该烂在家里，对吧？"

# game/script.rpy:823
translate schinese Isabella_scene1_6f3d4875:

    # i "..."
    i "……"

# game/script.rpy:826
translate schinese Isabella_scene1_9300cdde:

    # i "Only… do not fail us, brother."
    i "只是……别让我们失望，哥哥。"

# game/script.rpy:827
translate schinese Isabella_scene1_be351d58:

    # p "Where’s the faith, Belle? Thought you believed in your big brother!"
    p "你的信心呢，贝莉？不是说很崇拜你哥哥我吗！"

# game/script.rpy:840
translate schinese mall_f11f65c2:

    # mc "Would ya look at those headlines? Comedy gold, man."
    mc "看看那些标题？绝了，笑死人。"

# game/script.rpy:841
translate schinese mall_6d301025:

    # mc "‘It’s an honor to protect the common folk.’ {w}Yeah, sure — more like protectin’ their own asses."
    mc "“能保护平民是荣幸。”{w}是啊，当然——更像是保护他们自己的屁股。"

# game/script.rpy:843
translate schinese mall_50f2bb8a:

    # L "You’re mad again? We’ve been through this already."
    L "你又炸毛？我们不是说过了吗。"

# game/script.rpy:845
translate schinese mall_13dd0589:

    # mc "Yeah, especially when it comes with seven bodies and a minus-six rating, huh?"
    mc "是啊，尤其还附赠七具尸体和负六分评分的时候，对吧？"

# game/script.rpy:847
translate schinese mall_71d9f0ab:

    # mc "(…funny how numbers hit harder when they’ve got faces behind ‘em.)"
    mc "（……有意思，数字背后有了脸，打在心上就格外疼。）"

# game/script.rpy:850
translate schinese mall_7006e452:

    # L "Yeah, yeah, like you’d have done it any better."
    L "是是是，说得好像你就能做得更好似的。"

# game/script.rpy:851
translate schinese mall_6b209238:

    # mc "I never said I would’ve."
    mc "我可没说过我会。"

# game/script.rpy:852
translate schinese mall_deff6f50:

    # L "Didn’t have to say it — one look was enough. Don’t even try to deny it."
    L "不用说——一个眼神就够了。别想否认。"

# game/script.rpy:855
translate schinese mall_c395f207:

    # mc "Your word’s law, my queen."
    mc "您说了算，我的女王。"

# game/script.rpy:856
translate schinese mall_d5f2ad5c:

    # mc "So remind me again — what are we doin’ here?"
    mc "所以再提醒我一次——我们来这儿干嘛的？"

# game/script.rpy:858
translate schinese mall_84aee44d:

    # L "Your word’s law, my liege. Finally decided to ask, huh?"
    L "您说了算，我的陛下。总算肯问了？"

# game/script.rpy:859
translate schinese mall_56f222fd:

    # L "Sometimes I swear, the way you forget things so fast? It’s kinda scary."
    L "说真的，有时候你忘东西的速度还挺吓人的。"

# game/script.rpy:860
translate schinese mall_efd74006:

    # L "We’re here to fix you up, my lord. Can’t have the spoiled brats lookin’ down on you."
    L "我们是来捯饬您的，大人。可不能让那些被宠坏的少爷小姐看不起您。"

# game/script.rpy:861
translate schinese mall_329866f8:

    # L "And trust me — the Academy’s got plenty of “Spoiled brats."
    L "而且相信我——学院里可有的是“被宠坏的少爷”。"

# game/script.rpy:862
translate schinese mall_df78b290:

    # mc "(Here we go again—‘my lord,’ ‘spoiled brats’... give it five minutes and she’ll ask me to kiss her hand.)"
    mc "（又来了——“大人”、“被宠坏的少爷”……再过五分钟她就该让我吻她的手了。）"

# game/script.rpy:864
translate schinese mall_3e3a4fc8:

    # mc "Ah, I see. And here I thought you just wanted an excuse to drag me through the mall."
    mc "哦，我懂了。原来我以为你只是找个借口把我拽着逛商场。"

# game/script.rpy:866
translate schinese mall_f3009d73:

    # L "Oh, come on, isn’t that a nice bonus?"
    L "哦，拜托，这不算意外之喜吗？"

# game/script.rpy:868
translate schinese mall_8eab341e:

    # mc "Your lectures, huh? Bit early for morality class, my queen."
    mc "你的训话，是吗？道德课开得有点早啊，我的女王。"

# game/script.rpy:870
translate schinese mall_22638eaa:

    # mc "We’re not in the Acad—"
    mc "我们还没进学——"

# game/script.rpy:872
translate schinese mall_16d7336b:

    # L "Hold up, {b}queen{/b}? Again? Where’d that come from?"
    L "等一下，{b}“女王”{/b}？又是这个？从哪冒出来的？"

# game/script.rpy:874
translate schinese mall_27e93a24:

    # mc "Forgot what people call you?"
    mc "我忘了别人怎么称呼你了？"

# game/script.rpy:876
translate schinese mall_123bec95:

    # L "Really now? I thought you didn’t give a damn what people say."
    L "真的？我还以为你根本不在乎别人怎么说。"

# game/script.rpy:878
translate schinese mall_014a154f:

    # mc "In a world built on lies, gossip and intel are the sharpest blades you get."
    mc "在谎言堆砌的世界里，八卦和情报就是你唯一能拿到的锋刃。"

# game/script.rpy:880
translate schinese mall_9db39dd1:

    # mc "(And I’ve only ever been good at chattering away.)"
    mc "（而我唯一擅长的就是喋喋不休。）"

# game/script.rpy:882
translate schinese mall_cee7e132:

    # mc "Since I got stuck with the most useless power out there — I need somethin’, right?"
    mc "既然我摊上了这世上最没用的能力——我总得有点用吧，对吧？"

# game/script.rpy:884
translate schinese mall_d59b176f:

    # L "Wow, I’m impressed."
    L "哇，真叫人刮目相看。"

# game/script.rpy:886
translate schinese mall_3dde5ebe:

    # mc "Oh, don’t. Yeah, I’m weak, impulsive, whatever — but stupid? Nah, that one’s not on the list."
    mc "哦，别。承认吧，我软弱、冲动，随便怎样——但愚蠢？不，这条不在清单上。"

# game/script.rpy:887
translate schinese mall_9993b94e:

    # L "..."
    L "……"

# game/script.rpy:889
translate schinese mall_b37d688f:

    # mc "You… you didn’t think I was stupid, right?"
    mc "你……你不会觉得我很蠢吧？"

# game/script.rpy:891
translate schinese mall_4d63ce74:

    # mc "(…say no. Please just—)"
    mc "（……说不是。求你了——）"

# game/script.rpy:893
translate schinese mall_b95987b6:

    # mc "LENA?!"
    mc "莉娜？！"

# game/script.rpy:897
translate schinese mall_98de3a77:

    # L "Sorry, sorry — you’re right. But seriously, what’s your plan?"
    L "抱歉抱歉——你说得对。但说真的，你的计划是什么？"

# game/script.rpy:898
translate schinese mall_5765d708:

    # L "The Academy eats the weak, you know that. If you don’t fight back — they’ll chew you up."
    L "学院会吞掉弱者，你知道的。你要是不反击——他们就把你嚼碎。"

# game/script.rpy:900
translate schinese mall_c2fd2406:

    # mc "And here I thought they ranked us by brains."
    mc "我还以为他们是按脑子排名的。"

# game/script.rpy:902
translate schinese mall_7113f835:

    # L "I mean, I do believe in you, but don’t be naïve, okay? The place runs on power. That’s the pecking order."
    L "我是说，我确实相信你，但别太天真，行吗？那里靠实力说话。那就是食物链。"

# game/script.rpy:904
translate schinese mall_d8af4d08:

    # mc "Yeah? So that means I already lost, huh?"
    mc "是吗？那岂不是我一开始就输了？"

# game/script.rpy:906
translate schinese mall_73b98cb7:

    # L "I {b}do{/b} believe in you — which means you’ve still got a shot."
    L "我{b}确实{/b}相信你——也就是说你还有机会。"

# game/script.rpy:908
translate schinese mall_ad5f1d14:

    # mc "What’s with the emotional rollercoaster, huh? One minute you believe in me, next I’m naïve. So which is it?"
    mc "这情绪过山车是怎么回事？上一秒还相信我，下一秒就说我天真。到底哪句算数？"

# game/script.rpy:910
translate schinese mall_e94a60ff:

    # L "Hey, I know you got this, but… keep your damn wits about ya, yeah?"
    L "嘿，我知道你行的，但是……给我打起精神来，行吗？"

# game/script.rpy:911
translate schinese mall_e734d571:

    # L "You’ve got a chance if you take this seriously."
    L "只要认真对待，你就有机会。"

# game/script.rpy:912
translate schinese mall_9a04be92:

    # mc "(Serious, huh?)"
    mc "（认真啊……）"

# game/script.rpy:913
translate schinese mall_322e3387:

    # mc "(Damn, Lena… where do you even find that kind of faith in me?)"
    mc "（该死，莉娜……你到底从哪儿对我有这种信心？）"

# game/script.rpy:914
translate schinese mall_523bc6da:

    # mc "(…and here I thought my only talent was screwing things up.)"
    mc "（……我还以为我唯一的才能就是搞砸一切。）"

# game/script.rpy:916
translate schinese mall_f57a24f7:

    # mc "Doesn’t really matter. As long as I got my loyal queen, I can afford to be the idiot."
    mc "无所谓。只要有我忠诚的女王在，我就可以放心当个笨蛋。"

# game/script.rpy:919
translate schinese mall_079dce25:

    # L "Who {b}are{/b} you, and what’ve you done with [mc]?!"
    L "你{b}是{/b}谁，[mc]被你藏哪儿了？！"

# game/script.rpy:920
translate schinese mall_aae63d28:

    # L "What happened to shootin’ higher than your own damn head?"
    L "那个比自己的脑袋瞄得还高的家伙呢？"

# game/script.rpy:922
translate schinese mall_8afed2fb:

    # mc "Come on, why aim high? A fool king only makes his queen shine brighter."
    mc "拜托，为什么要瞄那么高？蠢货国王只会让他的王后更耀眼。"

# game/script.rpy:923
translate schinese mall_d117c4a5:

    # mc "And while everyone’s watchin’ you, I’ll be doin’ the real work."
    mc "而当所有人都在盯着你看的时候，我在干真正的活。"

# game/script.rpy:926
translate schinese mall_d9e883e8:

    # L "Oh… really? And what did I do to earn a sacrifice like this?"
    L "哦……真的？那我做了什么，值得你这样献身？"

# game/script.rpy:927
translate schinese mall_721ddb12:

    # mc "You?"
    mc "你？"

# game/script.rpy:929
translate schinese mall_889319e3:

    # mc "Hold up— LENA! I CAN’T HOLD YOU—!"
    mc "等等——莉娜！我接不住——！"

# game/script.rpy:941
translate schinese mall_243ccd3a:

    # L "Ow— damn, that hurt!"
    L "哎哟——该死，疼死了！"

# game/script.rpy:942
translate schinese mall_c5a6d3d8:

    # L "Why didn’t you catch me?!"
    L "你为什么不接住我？！"

# game/script.rpy:944
translate schinese mall_907cd592:

    # mc "Told you to watch yourself."
    mc "我都说了让你当心点。"

# game/script.rpy:945
translate schinese mall_6885da9c:

    # mc "That bump on your head? Kinda proves my point."
    mc "你头上那个包？多少证明了我的观点。"

# game/script.rpy:946
translate schinese mall_16e9c323:

    # L "You {b}could’ve{/b} tried! I trusted you, y’know!"
    L "你{b}明明可以{/b}试着接住我的！你知道的，我信任你！"

# game/script.rpy:949
translate schinese mall_df2a1290:

    # mc "Yeah, well, maybe don’t activate your ability next time."
    mc "是啊，那下次别开你的能力了。"

# game/script.rpy:950
translate schinese mall_d4295519:

    # mc "You weigh a ton in that mode."
    mc "你那个模式下重得像座山。"

# game/script.rpy:951
translate schinese mall_8d266220:

    # L "I swear, I’m gonna punch you."
    L "我发誓，我要揍你。"

# game/script.rpy:953
translate schinese mall_eaeafbc4:

    # mc "Go easy, we didn’t come here so you could tenderize me again."
    mc "手下留情，我们可不是来让你再把我揉成肉饼的。"

# game/script.rpy:954
translate schinese mall_2771c7d6:

    # mc "(whispering) Once was plenty, thanks."
    mc "（低声）一次就够了，谢谢。"

# game/script.rpy:957
translate schinese mall_61e63f83:

    # L "Fine, fine. I’ll keep that in mind next time."
    L "行行行，下次我记着点。"

# game/script.rpy:959
translate schinese mall_4a1e22cc:

    # L "Hey, what happened to your scooter, anyway?"
    L "话说回来，你的摩托车到底怎么了？"

# game/script.rpy:962
translate schinese mall_58b8a137:

    # mc "Oh, that’s a long, sad story."
    mc "哦，那是个又长又悲伤的故事。"

# game/script.rpy:964
translate schinese mall_60523d9b:

    # L "Please?"
    L "求你了？"

# game/script.rpy:967
translate schinese mall_6ff41185:

    # mc "Nope."
    mc "不告诉你。"

# game/script.rpy:969
translate schinese mall_f92ebe00:

    # L "Aww, come on, pretty please?"
    L "哎呀，拜托嘛，人家求求你了？"

# game/script.rpy:971
translate schinese mall_269d1161:

    # mc "Still no. Why the sudden curiosity anyway?"
    mc "还是不行。你怎么突然好奇起来了？"

# game/script.rpy:974
translate schinese mall_c9d81dc7:

    # L "I just remembered Beatrice mentioning it, that’s all!"
    L "我只是想起碧翠丝提过这事，仅此而已！"

# game/script.rpy:975
translate schinese mall_f689498c:

    # L "C’mon, no secrets between best friends, right?"
    L "拜托，最好的朋友之间不该有秘密，对吧？"

# game/script.rpy:977
translate schinese mall_5cb46441:

    # mc "(whispering) …I got scammed."
    mc "（低声）……我被骗了。"

# game/script.rpy:979
translate schinese mall_1f5625cd:

    # L "You what?"
    L "你什么？"

# game/script.rpy:981
translate schinese mall_4d50e4f9:

    # mc "Scammed, okay? Girl from the junkyard said my scooter was beyond repair, but she’d buy it for parts."
    mc "被骗了，行吧？废品站的女孩说我的摩托车修不好了，但她愿意出零件价买走。"

# game/script.rpy:982
translate schinese mall_21bd1565:

    # L "And you actually went for it..."
    L "而你居然真信了……"

# game/script.rpy:985
translate schinese mall_bbeeaa3a:

    # mc "I needed the cash. Didn’t exactly have a lotta options, alright?"
    mc "我需要那笔钱。我能选的路本来就不多，好吗？"

# game/script.rpy:986
translate schinese mall_4b9a0509:

    # mc "Only thing I didn’t count on was her vanishing with both my scooter and my money. No cash, no girl, no ride. Full combo."
    mc "我唯一没算到的是，她带着我的车和我的钱一起消失了。没钱、没女孩、没车。三重全空。"

# game/script.rpy:989
translate schinese mall_f6e92530:

    # L "That’s awful... You really went through all that alone?"
    L "太惨了……那些你都是一个人扛下来的？"

# game/script.rpy:991
translate schinese mall_33adc9df:

    # mc "You’re telling me."
    mc "你说呢。"

# game/script.rpy:993
translate schinese mall_cfa75be2:

    # L "Why didn’t you go to the cops? That’s literally theft! Or you could’ve told me— I’d have—"
    L "你怎么不去报警？那明明是偷窃！或者你可以告诉我——我本来能——"

# game/script.rpy:995
translate schinese mall_174e4d76:

    # mc "Thought I could handle it myself."
    mc "我以为自己能处理。"

# game/script.rpy:996
translate schinese mall_d60f763e:

    # mc "By the time I tried — too late, end of story"
    mc "等我反应过来时——已经太晚了。就这样。"

# game/script.rpy:997
translate schinese mall_2f81bfe8:

    # mc "Besides, you’re already juggling classes, work, and somehow keeping me alive. I’m not adding to that pile."
    mc "再说了，你既要上课又要打工，还想办法让我活着。我不想再给你添负担。"

# game/script.rpy:1001
translate schinese mall_b0371fcd:

    # L "Well, I’d’ve found time for you. If you needed me."
    L "只要你需要我，我总能挤出时间。"

# game/script.rpy:1002
translate schinese mall_de166d12:

    # L "Next time something like that happens, you call me first, got it?"
    L "下次再出这种事，第一个打给我，听到没？"

# game/script.rpy:1004
translate schinese mall_db7176ec:

    # mc "(How the hell do I deserve someone like her…)"
    mc "（我他妈凭什么配得上这样的人……）"

# game/script.rpy:1005
translate schinese mall_2c4f77f1:

    # mc "Len?"
    mc "莉娜？"

# game/script.rpy:1006
translate schinese mall_1e4e41b6:

    # L "Hm?"
    L "嗯？"

# game/script.rpy:1009
translate schinese mall_1d478482:

    # mc "Got you something. I know how much you love gifts, so…"
    mc "我给你弄了个东西。我知道你多喜欢礼物，所以……"

# game/script.rpy:1012
translate schinese mall_494a70da:

    # mc "Consider it a down payment on your kindness."
    mc "算是预付给你的善意。"

# game/script.rpy:1013
translate schinese mall_0de1743b:

    # L "Oh my Gawd — WHERE’D YOU EVEN GET THAT?!"
    L "我的天——你从哪儿弄来的？！"

# game/script.rpy:1014
translate schinese mall_11b2c7ab:

    # L "You kiddin’ me right now?! You’re, like — THE freakin’ BEST!"
    L "你现在是在逗我吗？！你简直——是世界上最棒的人！"

# game/script.rpy:1015
translate schinese mall_0e8c9518:

    # L "What’s the catch, huh? What’s this for?"
    L "说吧，有什么附加条件？这是为什么？"

# game/script.rpy:1018
translate schinese mall_78006a4a:

    # mc "Thanks I guess?"
    mc "就当是……谢谢？"

# game/script.rpy:1019
translate schinese mall_fe13d2ad:

    # L "Tryna buy me off with one lil’ Chupa Chup? Really?"
    L "想用一根小棒棒糖收买我？认真的？"

# game/script.rpy:1020
translate schinese mall_0aab6aa3:

    # mc "I didn’t—"
    mc "我不是——"

# game/script.rpy:1021
translate schinese mall_7745b481:

    # L "Heh—relax, I’m messin’ with ya. I don’t need more than that."
    L "嘿嘿——放松，我在逗你。有这些就够了。"

# game/script.rpy:1022
translate schinese mall_b9b3fda8:

    # L "Thanks, [mc], really."
    L "谢谢你，[mc]。真的。"

# game/script.rpy:1027
translate schinese mall_8e260332:

    # L "A’ight, let’s go, time to get you the sharpest damn outfit they got in this place!"
    L "好，走吧，该去给你挑这地方最他妈的帅的行头了！"

# game/script.rpy:1028
translate schinese mall_8f7c74b5:

    # mc "Hold up, Len — your accent!"
    mc "等等，莉娜——你的口音！"

# game/script.rpy:1032
translate schinese mall_756b1161:

    # L "Heh — we are alone, so d`worry."
    L "嘿嘿——这里没别人，放心吧。"

# game/script.rpy:1035
translate schinese mall_c2821aa7:

    # a "The most I’m willing to offer you is ten percent of the total sum."
    a "我最多愿意给你总价的百分之十。"

# game/script.rpy:1036
translate schinese mall_65a14ff4:

    # r "Hey, that ain’t how we agreed— it was half. {b}HALF!{/b}"
    r "喂，说好的不是这样——是一半。{b}一半！{/b}"

# game/script.rpy:1037
translate schinese mall_8a7dab3c:

    # a "And we also agreed on a proper bike, not the… derelict you dragged in."
    a "而且我们说好的要一辆像样的车，不是你拖回来的那堆……破铜烂铁。"

# game/script.rpy:1038
translate schinese mall_8ce11609:

    # r "I busted my ass for that wreck! That clown was worse than a warm can of beer!"
    r "那破烂我可是拼了命才弄到的！那个小丑比一罐温啤酒还难喝！"

# game/script.rpy:1039
translate schinese mall_0a71dbc9:

    # a "A clown, was he? {w}…Never mind. Ten percent — or nothing at all."
    a "小丑，是吗？{w}……算了。百分之十——否则一分没有。"

# game/script.rpy:1040
translate schinese mall_b9b755e5:

    # r "..."
    r "……"

# game/script.rpy:1041
translate schinese mall_3134686c:

    # r "...Fine."
    r "……行吧。"

# game/script.rpy:1045
translate schinese mall_85d39c23:

    # r "May your damn gears jam, you heartless elf."
    r "愿你那些该死的齿轮卡死吧，你这没心的精灵。"

# game/script.rpy:1046
translate schinese mall_895633d3:

    # r "Same crap every damn day. If it weren’t for beer, I’d lose my mind already."
    r "每天都是这堆破事。要不是有酒，我早就疯了。"

# game/script.rpy:1048
translate schinese mall_4637c28d:

    # r "(I’d’ve paid off that damn debt ages ago, but no— just keep payin’ interest. Screw ‘em.)"
    r "（我早就能还清那笔债了，可不——一直只交利息。去他的。）"

# game/script.rpy:1049
translate schinese mall_2989507e:

    # r "(And that clown— he trashed my workplace and called the cops! How the hell am I supposed to work now?!)"
    r "（还有那个小丑——他砸了我的场子还报警！我现在还怎么上班？！）"

# game/script.rpy:1051
translate schinese mall_b5bb7d71:

    # L "No freakin’ way! Rosa?! What’re you doin’ here?"
    L "不会吧？！罗丝？！你怎么会在这儿？"

# game/script.rpy:1052
translate schinese mall_3095b97f:

    # L "Back for another beer"
    L "回来再喝一杯"

# game/script.rpy:1064
translate schinese mall_6b6e7cca:

    # mc "(This girl… well, you’ll see soon enough.)"
    mc "（这姑娘……算了，你很快就会知道了。）"

# game/script.rpy:1067
translate schinese mall_02f1b453:

    # r "Lena? Well, damn, didn’t think you ever left work. What’re you doin’ here?"
    r "莉娜？嚯，真没想到你还会下班。你来干嘛？"

# game/script.rpy:1068
translate schinese mall_2951fa2e:

    # r "This place sure don’t look like no restaurant, if you catch my drift."
    r "这地方可一点都不像餐馆，你懂的。"

# game/script.rpy:1071
translate schinese mall_545fc416:

    # L "Oh, y’know, someone needed a bit of moral support, so I took the day off."
    L "哦，有人需要一点精神支持，我就请了一天假。"

# game/script.rpy:1072
translate schinese mall_9e3e1e7e:

    # L "But enough about me — how’ve you been?"
    L "不说我了——你最近怎么样？"

# game/script.rpy:1073
translate schinese mall_54d2017c:

    # L "Haven’t seen you around the Academy lately. Everything okay?"
    L "最近在学院都没见到你。还顺利吗？"

# game/script.rpy:1075
translate schinese mall_0f25245b:

    # mc "(whispering) Len…"
    mc "（低声）莉娜……"

# game/script.rpy:1076
translate schinese mall_6c3b0677:

    # L "Ya?"
    L "嗯？"

# game/script.rpy:1077
translate schinese mall_2957379b:

    # mc "(whispering) That’s her."
    mc "（低声）就是她。"

# game/script.rpy:1078
translate schinese mall_68ad1251:

    # mc "(whispering) The one who stole my scooter."
    mc "（低声）偷走我摩托车的那位。"

# game/script.rpy:1080
translate schinese mall_c92f2601:

    # mc "Well, well… fate’s got a sense of humor, huh, Android girl?"
    mc "哎呀呀……命运还挺会开玩笑，是吧，安卓女孩？"

# game/script.rpy:1085
translate schinese mall_7ad4391d:

    # r "You’re that clown..."
    r "你就是那个小丑……"

# game/script.rpy:1088
translate schinese mall_528422dd:

    # mc "Where’s my bike, you con artist?!"
    mc "我的车呢，你这骗子？！"

# game/script.rpy:1089
translate schinese mall_196cd37b:

    # r "Screw you, clown! I needed that money!"
    r "去你的，小丑！我需要那笔钱！"

# game/script.rpy:1090
translate schinese mall_2c83b79d:

    # mc "Oh, that’s funny — I needed that money too!"
    mc "哦，这可真巧——我也需要那笔钱！"

# game/script.rpy:1094
translate schinese mall_6d782227:

    # mc "Trying to run again? Not this time!"
    mc "又想跑？这回不行！"

# game/script.rpy:1095
translate schinese mall_234b1509:

    # r "You’re insane! You knew what you were gettin’ into, that ain’t on me!"
    r "你有病吧！明知道会怎样才跟我做的，这不能赖我！"

# game/script.rpy:1096
translate schinese mall_6c6c5c10:

    # mc "Give it back, dammit! My bike!"
    mc "还给我，混蛋！我的车！"

# game/script.rpy:1097
translate schinese mall_7d74ee20:

    # r "Bucket on wheels? I don’t even have it!"
    r "轮子上的垃圾桶？那破玩意儿我根本没留着！"

# game/script.rpy:1098
translate schinese mall_d8e11bd9:

    # mc "Bucket on wheels’? You did not just call my baby that, you tin-can tramp!"
    mc "轮子上的垃圾桶？你居然敢这么叫我的宝贝，你这铁皮流浪女！"

# game/script.rpy:1102
translate schinese mall_4e8aa048:

    # r "You ever look in a mirror, jackass? You’re the poster boy for scrap metal!"
    r "你照过镜子吗，蠢货？你就是废铁的代言海报！"

# game/script.rpy:1103
translate schinese mall_61ad9226:

    # r "Sorry, gramps."
    r "抱歉，老头。"

# game/script.rpy:1104
translate schinese mall_18ef1c66:

    # n "Hey, watch it! Mind where you’re going!"
    n "喂，看着点！走路看路！"

# game/script.rpy:1105
translate schinese mall_41507571:

    # mc "Sorry, sorry, my bad!"
    mc "抱歉抱歉，我的错！"

# game/script.rpy:1107
translate schinese mall_a1ca1bea:

    # L "They’re actually getting along… color me surprised."
    L "他们居然聊得来……真让我意外。"

# game/script.rpy:1108
translate schinese mall_790d124b:

    # L "Kinda jealous, not gonna lie…"
    L "说真的，有点嫉妒……"

# game/script.rpy:1111
translate schinese mall_b2d8dae1:

    # L "(Still, good job, Lena. You didn’t jump in.)"
    L "（不过做得好，莉娜。你没有冲上去。）"

# game/script.rpy:1112
translate schinese mall_f6fb5736:

    # L "(He needs to handle this on his own. He can do it.)"
    L "（这事得他自己解决。他能做到。）"

# game/script.rpy:1113
translate schinese mall_83ec7fc2:

    # L "(I’ll stick close, just in case. He probably won’t mind that.)"
    L "（我会在旁边守着，以防万一。他应该不介意。）"

# game/script.rpy:1114
translate schinese mall_b5493e25:

    # L "(Let him, for once, decide what’s really worth fighting for…)"
    L "（就让他自己决定一次，什么才真正值得去争……）"

# game/script.rpy:1118
translate schinese mall_bac5110f:

    # r "(Great, this bargain-bin Tom Cruise is gettin’ closer. I gotta think fast or I’m toast.)"
    r "（糟了，这个地摊货汤姆克鲁斯越来越近了。得赶紧想办法，不然我就死定了。）"

# game/script.rpy:1119
translate schinese mall_320c9223:

    # mc "Stop running already!"
    mc "别跑了！"

# game/script.rpy:1120
translate schinese mall_3349b7e8:

    # r "So you can catch me and do God-knows-what? Hell no!"
    r "好让你抓住我再干点天知道的事？做梦！"

# game/script.rpy:1123
translate schinese mall_df1705d9:

    # mc "I’m not here for you — I just want to get back what’s rightfully mine!"
    mc "我不是冲你来的——我只想拿回本该属于我的东西！"

# game/script.rpy:1124
translate schinese mall_2644b777:

    # r "Mom! Help! It’s that nutjob again— he’s as stubborn as a damn debt collector!"
    r "妈！救命！又是那个疯子——他比该死的讨债鬼还顽固！"

# game/script.rpy:1128
translate schinese mall_608056e3:

    # r "(What did I even do to deserve this freakin’ circus?! Like dealin’ with thugs wasn’t enough already!)"
    r "（我到底造了什么孽才要受这场马戏罪？！跟混混打交道还不够吗！）"

# game/script.rpy:1129
translate schinese mall_53de108a:

    # r "(Now that crazy clown’s on my tail. This should slow him down… hopefully.)"
    r "（现在那个疯小丑盯上我了。这应该能拖住他……希望吧。）"

# game/script.rpy:1131
translate schinese mall_d3beb5b8:

    # mc "(Seriously? She’s still acting like nothing happened?)"
    mc "（说真的？她还是装得跟什么都没发生一样？）"

# game/script.rpy:1132
translate schinese mall_fe2dc42c:

    # mc "(And I’m no better.)"
    mc "（而我也一样。）"

# game/script.rpy:1133
translate schinese mall_99ce0e9c:

    # mc "(Let it go? Move on?)"
    mc "（算了？翻篇？）"

# game/script.rpy:1134
translate schinese mall_0b79114c:

    # mc "(Yeah, right — I can’t just leave it like this.)"
    mc "（是啊对——我没法就这么放着。）"

# game/script.rpy:1135
translate schinese mall_79c23a27:

    # mc "(If I let this one go too — what’ll be left of me?)"
    mc "（要是这个我也放过——那我还剩下什么？）"

# game/script.rpy:1137
translate schinese mall_8e4a2203:

    # mc "Time to take matters into my own hands — let’s see what I can really do!"
    mc "该把事情抓在自己手里了——看看我到底能做到什么！"

# game/script.rpy:1141
translate schinese mall_06f6efbf:

    # mc "Technique number two: {b}Aesthetic Leap!{/b}"
    mc "技巧二号：{b}美学飞跃！{/b}"

# game/script.rpy:1142
translate schinese mall_db226672:

    # r "(Oh great, now he jumps too.)"
    r "（太好了，现在他还会跳了。）"

# game/script.rpy:1143
translate schinese mall_6e8559be:

    # r "You’re not leavin’ me a choice here!"
    r "你这是不给我留活路啊！"

# game/script.rpy:1147
translate schinese mall_b7ee44f3:

    # mc "Hey, what the hell are you doing?!"
    mc "喂，你到底在干什么？！"

# game/script.rpy:1148
translate schinese mall_385e0c0c:

    # r "(What the hell am I doin’? Sixth floor... ah screw it, I’ll figure it out later— just gotta get away first.)"
    r "（我在干什么来着？六楼……啊管他的，以后再说——先跑了再说。）"

# game/script.rpy:1149
translate schinese mall_59cdb942:

    # r "Good luck jumpin’ off the sixth floor, meatbag!"
    r "祝你好运从六楼跳下去，肉包！"

# game/script.rpy:1153
translate schinese mall_64e56458:

    # mc "No, no, no — dammit!"
    mc "不，不，不——该死！"

# game/script.rpy:1154
translate schinese mall_b0bad82b:

    # mc "Just one second too slow…"
    mc "就慢了一秒……"

# game/script.rpy:1155
translate schinese mall_ee533c8c:

    # mc "She really jumped? Unreal…"
    mc "她真跳了？难以置信……"

# game/script.rpy:1156
translate schinese mall_142f905d:

    # mc "Yeah… how am I supposed to keep up in a world like this, huh?"
    mc "是啊……在这样的世界里，我怎么可能追得上？"

# game/script.rpy:1158
translate schinese mall_1ae3a4ad:

    # mc "(There it is again — proof that stubbornness without luck gets you nowhere.)"
    mc "（又是这个结果——证明没有运气，光靠固执哪儿也去不了。）"

# game/script.rpy:1159
translate schinese mall_c56f05ec:

    # mc "(I knew it, and yet I still wanted to prove something.)"
    mc "（我明明知道，却还是想证明点什么。）"

# game/script.rpy:1160
translate schinese mall_9db9ba0b:

    # mc "(Isabelle would’ve said, ‘There he goes again’… and hell, she’d be right.)"
    mc "（伊莎贝拉会说：“他又来了”……该死，她说得对。）"

# game/script.rpy:1164
translate schinese mall_b6fef756:

    # L "Still blamin’ yourself? Stop it. You did better than you think."
    L "还在怪自己？别闹了。你做得比你自己以为的好。"

# game/script.rpy:1165
translate schinese mall_163ae621:

    # L "She hero... {w}no, forget it. That’s not the point."
    L "本该是英雄……{w}不，算了。那不是重点。"

# game/script.rpy:1166
translate schinese mall_58e7e6bd:

    # L "You just didn’t have the skills. Yet."
    L "你只是技巧不够。暂时而已。"

# game/script.rpy:1168
translate schinese mall_68652c03:

    # mc "Skills, huh? And what are you doing here, anyway?"
    mc "技巧，是吗？话说回来，你来这儿干嘛？"

# game/script.rpy:1169
translate schinese mall_ea3ae45e:

    # L "We’ll talk about that later — right now, we need to catch up to Rosa."
    L "这个待会儿再说——现在我们得追上罗丝。"

# game/script.rpy:1172
translate schinese mall_fb2e5377:

    # mc "Eh?"
    mc "嗯？"

# game/script.rpy:1175
translate schinese mall_4424a832:

    # L "That’s right. Sorry for the rough landing, but you’ll have to hang on a bit, alright?"
    L "没错。抱歉落地有点糙，你得再忍一下，行吗？"

# game/script.rpy:1176
translate schinese mall_b2d23421:

    # L "Unless, of course, you’ve already lost the drive to chase her down."
    L "除非，你已经不想追她了。"

# game/script.rpy:1178
translate schinese mall_877489d4:

    # mc "(Fantastic. I’m even more useless than Shinji from Evangelion. Great job, me.)"
    mc "（太棒了。我连EVA里的碇真嗣都不如。干得漂亮，我。）"

# game/script.rpy:1180
translate schinese mall_bc1db8af:

    # mc "Screw it all. Maybe I’m no hero — but whining? Oh, I’m amazing at that."
    mc "全他妈算了。也许我不是什么英雄——但抱怨？我可是天才。"

# game/script.rpy:1184
translate schinese mall_fa43913c:

    # L "Better think about what you’re gonna say to Rosa when we catch her — that’ll do more good."
    L "不如想想追上罗丝之后要跟她说什么——那更有用。"

# game/script.rpy:1185
translate schinese mall_b21541d8:

    # mc "No promises."
    mc "不保证。"

# game/script.rpy:1186
translate schinese mall_c35df6d0:

    # L "Just don’t give up. The rest’ll come naturally."
    L "别放弃就好。剩下的自然就会来。"

# game/script.rpy:1199
translate schinese street_ses2_f05ec9f0:

    # r "Barely made it outta there— was that guy even human?"
    r "好不容易从那儿出来——那家伙还是人吗？"

# game/script.rpy:1200
translate schinese street_ses2_f1cb0c7a:

    # r "Where the hell’d he get that speed?!"
    r "他妈的哪儿来的那种速度？！"

# game/script.rpy:1201
translate schinese street_ses2_b207a247:

    # r "Guess Mom was right — clowns {b}are{/b} creepy as hell."
    r "看来老妈是对的——小丑{b}就是{/b}瘆人。"

# game/script.rpy:1202
translate schinese street_ses2_3fd6fa05:

    # r "Oh, for f— sake, I FORGOT!"
    r "哦，看在老天的份上，我忘了！"

# game/script.rpy:1205
translate schinese street_ses2_8fd70f40:

    # r "Gotta swing by her place later!"
    r "待会儿得去她那儿一趟！"

# game/script.rpy:1207
translate schinese street_ses2_c39bfd65:

    # r "Or... maybe not?"
    r "或者……还是算了？"

# game/script.rpy:1208
translate schinese street_ses2_3cf55ace:

    # r "What’m I gonna tell her, huh? ‘Hey Mom, I’m knee-deep in crap’? Yeah… sounds ‘bout right."
    r "我该跟她说什么？“妈，我正陷在烂泥里”？对……听起来挺到位。"

# game/script.rpy:1209
translate schinese street_ses2_af6df058:

    # r "Eh, screw it, I’ll deal with that later. First thing’s first — fix the damn scooter story."
    r "算了，以后再说。先办正事——把那该死的摩托车的事解决掉。"

# game/script.rpy:1211
translate schinese street_ses2_9c4cdfc0:

    # r "Then maybe find a job again… hell, gotta get back to classes too."
    r "然后也许再找份工作……靠，还得回去上课。"

# game/script.rpy:1213
translate schinese street_ses2_818f89b3:

    # r "Man, everything’s just crashing down at once. Freakin’ lovely."
    r "真是的，全都赶一块儿崩了。真他妈美好。"

# game/script.rpy:1214
translate schinese street_ses2_9655983a:

    # r "And my beer... my poor, sweet beer..."
    r "还有我的酒……我那可怜的好酒……"

# game/script.rpy:1215
translate schinese street_ses2_2d1fc386:

    # r "Guess I’ll hit up Len later, maybe work somethin’ out."
    r "看来待会儿得找莉娜谈谈，也许能想个办法。"

# game/script.rpy:1219
translate schinese street_ses2_c56d319a:

    # L "No need to trouble yourself — express delivery, right to your door."
    L "不用你操心——特快专递，直接送到你家门口。"

# game/script.rpy:1220
translate schinese street_ses2_98123171:

    # mc "Len, I think my entire inner world’s about to make a public appearance."
    mc "莉娜，我觉得我的整个内心世界马上要公开展出了。"

# game/script.rpy:1224
translate schinese street_ses2_f37d8b43:

    # L "What?! No — don’t you dare! Hold it together!"
    L "什么？！不行——你可别！给我憋住！"

# game/script.rpy:1225
translate schinese street_ses2_2401d5a5:

    # mc "No, seriously, I—"
    mc "不是，我是说，我——"

# game/script.rpy:1226
translate schinese street_ses2_bef8e6ff:

    # L "Hold on!"
    L "等一下！"

# game/script.rpy:1227
translate schinese street_ses2_2b35b6fe:

    # mc "..."
    mc "……"

# game/script.rpy:1230
translate schinese street_ses2_e0d9dd79:

    # mc "Alright. Guess I’ll go shake hands with fate."
    mc "好吧。看来我得去跟命运握手言和。"

# game/script.rpy:1231
translate schinese street_ses2_6ac35382:

    # L "And what about your inner world, huh?"
    L "那你的内心世界呢？"

# game/script.rpy:1232
translate schinese street_ses2_21ce1572:

    # mc "He got sent back to the tutorial level."
    mc "他被打回新手教程了。"

# game/script.rpy:1235
translate schinese street_ses2_9341da96:

    # r "Alright, alright, you win. Now tell me, why’re you tailin’ me, huh?"
    r "好好好，你赢了。说说吧，你跟着我干嘛？"

# game/script.rpy:1238
translate schinese street_ses2_03278231:

    # mc "Time to pay back some old debts."
    mc "该还清一些旧账了。"

# game/script.rpy:1240
translate schinese street_ses2_101bc879:

    # r "Hmph…"
    r "哼……"

# game/script.rpy:1243
translate schinese street_ses2_770f6285:

    # r "You call that junk heap a ‘debt’? Thing barely started up every other try!"
    r "你把那堆废铁叫“债”？它隔三差五就熄火！"

# game/script.rpy:1244
translate schinese street_ses2_c4103c22:

    # L "Oh, for God’s sake, can you two stop comparing who’s got the shittier life?"
    L "看在上帝的份上，你们俩能不能别再比谁过得更惨？"

# game/script.rpy:1247
translate schinese street_ses2_d06db639:

    # r "Len, sweetheart, stay outta this. It’s between me and your damn clown here."
    r "莉娜宝贝，别掺和。这是我和你家那个小丑之间的事。"

# game/script.rpy:1248
translate schinese street_ses2_3ec1c6b9:

    # r "Now you— yeah, we had a deal, and I broke it, fine. But couldn’t you just let it slide?"
    r "至于你——对，我们是有过约定，我违反了，行了吧。但你就不能既往不咎？"

# game/script.rpy:1249
translate schinese street_ses2_43a86cb7:

    # r "Pretend you didn’t see a damn thing?"
    r "就当什么都没看见？"

# game/script.rpy:1251
translate schinese street_ses2_d49cc131:

    # r "I didn’t lie when I said it wouldn’t run again. Thing’s been dead for ages, just junk—"
    r "我说它不会再跑的时候可没撒谎。那玩意儿早就报废了，就是一堆废铁——"

# game/script.rpy:1254
translate schinese street_ses2_3eed785d:

    # mc "That’s not junk! Maybe to you, sure, but to me? That’s personal."
    mc "那不是废铁！对你来说是，但对我？那是有感情的。"

# game/script.rpy:1255
translate schinese street_ses2_24c272d7:

    # mc "And deal’s a deal. You broke it, I called it back. Now it’s time to settle up."
    mc "而且约定就是约定。你违反了，我把它收回了。现在该清账了。"

# game/script.rpy:1258
translate schinese street_ses2_bc8cf12e:

    # r "I’d give it back if I could, alright? But I {b}don’t{/b} have it anymore, got it?"
    r "能还我当然还，行吗？可我{b}根本{/b}没有了，懂吗？"

# game/script.rpy:1259
translate schinese street_ses2_fa63be7d:

    # r "Believe me, I didn’t do it ‘cause I wanted to. So do us both a favor — drop the damn junk and move on."
    r "信我，我不是故意的。咱俩都省点事——把那些废铁扔了，翻篇吧。"

# game/script.rpy:1261
translate schinese street_ses2_bd363d78:

    # mc "Oh no, sweetheart, you’re giving it back."
    mc "不，宝贝，你要还的。"

# game/script.rpy:1262
translate schinese street_ses2_73ad58da:

    # mc "I don’t care who you tangled with or where it ended up — figure it out, return my scooter and we’re square."
    mc "我不在乎你跟谁扯上关系，也不在乎它最后流落到哪儿——你自己想办法，把我的摩托车还回来，我们就两清。"

# game/script.rpy:1265
translate schinese street_ses2_b9b755e5:

    # r "..."
    r "……"

# game/script.rpy:1267
translate schinese street_ses2_fbefc130:

    # r "You’re kinda funny, I’ll give you that… but nope."
    r "你还挺逗，这点我承认……但不行。"

# game/script.rpy:1268
translate schinese street_ses2_c801a7fa:

    # r "Go ahead, call the cops if you want."
    r "想报警就报啊。"

# game/script.rpy:1269
translate schinese street_ses2_ff3211d1:

    # r "Ain’t got nothin’ to lose — but trust me, I’m takin’ you down with me."
    r "我没什么可失去的——但相信我，我会拉你一起下水。"

# game/script.rpy:1273
translate schinese street_ses2_6088b795:

    # L "She ain’t kidding, by the way. Stubborn’s her middle name — might even beat you at it."
    L "顺便说一句，她没在开玩笑。固执是她的本名——说不定比你还倔。"

# game/script.rpy:1275
translate schinese street_ses2_4a7ef331:

    # mc "(whispering) So what, you’re saying we just let this go?"
    mc "（低声）所以你的意思是，我们就这么算了？"

# game/script.rpy:1276
translate schinese street_ses2_4c62b199:

    # mc "(whispering) That scooter means more to me than you think."
    mc "（低声）那辆摩托车对我来说比你以为的重要得多。"

# game/script.rpy:1277
translate schinese street_ses2_06c31353:

    # L "(whispering) So that’s why you sold it, huh?"
    L "（低声）所以你才把它卖了，是吧？"

# game/script.rpy:1278
translate schinese street_ses2_a4695ec2:

    # mc "(whispering) Yeah, I screwed up. Happens. Now I’m just trying to fix it."
    mc "（低声）对，我搞砸了。常态。现在我只是想补救。"

# game/script.rpy:1280
translate schinese street_ses2_d017ecc0:

    # L "(whispering) Look, I’m not stepping in. You gotta talk her down yourself."
    L "（低声）听着，我不打算插手。你得自己说服她。"

# game/script.rpy:1281
translate schinese street_ses2_c06aa050:

    # mc "(whispering) I can handle it."
    mc "（低声）我能搞定。"

# game/script.rpy:1283
translate schinese street_ses2_55c47195:

    # L "(whispering) I don’t wanna pressure you, but... seems I’ve got no other choice."
    L "（低声）我不想给你压力，但……好像也别无选择。"

# game/script.rpy:1284
translate schinese street_ses2_48e2e3d8:

    # L "(whispering) You need to do this, or there’ll be consequences. Real ones."
    L "（低声）你必须这么做，否则会有后果。真正的后果。"

# game/script.rpy:1288
translate schinese street_ses2_f3219f9a:

    # mc "(whispering) Oh, trust me, wouldn’t wanna spend another month without your legs around."
    mc "（低声）哦，相信我，我可不想再过一个月没有你双腿的日子。"

# game/script.rpy:1289
translate schinese street_ses2_f51100cc:

    # L "(whispering) I’m serious, [mc]."
    L "（低声）我是认真的，[mc]。"

# game/script.rpy:1290
translate schinese street_ses2_af30daf4:

    # mc "(whispering) I`m too, dead serious."
    mc "（低声）我也是。绝对认真。"

# game/script.rpy:1292
translate schinese street_ses2_f04cffad:

    # L "What are you doing now?"
    L "你现在在干什么？"

# game/script.rpy:1294
translate schinese street_ses2_bd19bd3f:

    # mc "Trying to make your life easier. My turn to hold the beer."
    mc "想让你的日子好过点。轮到我来拎酒了。"

# game/script.rpy:1296
translate schinese street_ses2_59f41788:

    # L "Don’t. I got it."
    L "不用。我自己来。"

# game/script.rpy:1297
translate schinese street_ses2_26c20489:

    # mc "Nope. I insist."
    mc "不行。我坚持。"

# game/script.rpy:1298
translate schinese street_ses2_4fd01099:

    # L "Alright, if you insist."
    L "好吧，既然你坚持。"

# game/script.rpy:1301
translate schinese street_ses2_367d8720:

    # mc "One small step for mankind, one giant win for me!"
    mc "人类一小步，我的一大步胜利！"

# game/script.rpy:1303
translate schinese street_ses2_87e93f60:

    # L "Alright, jokes aside — please, stop acting like a kid."
    L "好吧，玩笑归玩笑——拜托，别像个孩子。"

# game/script.rpy:1307
translate schinese street_ses2_359daf0f:

    # L "And you, Rosa — enough running already. None of this would’ve happened if you’d just kept your word."
    L "还有你，罗丝——别再跑了。你要是守住承诺，这些事都不会发生。"

# game/script.rpy:1309
translate schinese street_ses2_a8a3ba4a:

    # r "(Well, there goes the escape plan... great.)"
    r "（好吧，逃跑计划泡汤了……棒。）"

# game/script.rpy:1310
translate schinese street_ses2_82ee558a:

    # r "(Yeah, said I got nothin’ to lose, but prison? No thanks… Mom’d lose her mind.)"
    r "（是说了没什么可失去的，可坐牢？免了……老妈会疯的。）"

# game/script.rpy:1313
translate schinese street_ses2_d53c1789:

    # mc "A boy once dreamed of going to a real zoo — ‘cause the only animals he’d ever seen were a dead goose, a beer goat, and his drunk old man."
    mc "有个男孩曾梦想去真正的动物园——因为他见过的动物只有一只死鹅、一只啤酒山羊，还有他那个喝醉的老爹。"

# game/script.rpy:1314
translate schinese street_ses2_9ab23429:

    # r "What’s that supposed to mean?"
    r "你这话什么意思？"

# game/script.rpy:1315
translate schinese street_ses2_b7db2640:

    # mc "I like finding meaning in stupid things. That scooter… it was one of ‘em. My tiny island of good memories."
    mc "我喜欢在愚蠢的东西里找意义。那辆摩托车……就是其中之一。我那一小块美好记忆的孤岛。"

# game/script.rpy:1316
translate schinese street_ses2_fa1e982e:

    # r "What’s with all the honesty, huh?"
    r "你突然这么坦诚干嘛？"

# game/script.rpy:1317
translate schinese street_ses2_f3270575:

    # mc "Let’s just say I’ve watched too much anime lately and learned that honesty can work wonders — especially when you’re trying to get something back that actually matters."
    mc "就当我最近番剧看多了，学会了坦诚有时候很管用——尤其当你是在拿回真正重要的东西时。"

# game/script.rpy:1318
translate schinese street_ses2_249227ee:

    # r "(Stubborn. Way too stubborn. Dumb, maybe?)"
    r "（固执。太固执了。蠢吗？）"

# game/script.rpy:1319
translate schinese street_ses2_03fa01e2:

    # r "(Yeah... dumb and stubborn — but honest. Huh. {w}Funny one, ain’t he?)"
    r "（是啊……又蠢又倔——但诚实。呵。{w}真是个怪人，是吧？）"

# game/script.rpy:1320
translate schinese street_ses2_721fef0b:

    # r "(No point runnin’ now. Could use a hand with those bikers anyway. If I can get him on my side — even that fool — that’s still a win in my book.)"
    r "（现在跑也没意义了。反正那些混混我也需要人帮忙。要能把他拉到我这边——就算是那个笨蛋——在我看来也算赢。）"

# game/script.rpy:1321
translate schinese street_ses2_a8bb1bec:

    # r "(And Lena trusts him… {w}fine. Guess I’ll roll with it.)"
    r "（而且莉娜信任他……{w}行吧。就随他去了。）"

# game/script.rpy:1325
translate schinese street_ses2_1af55a47:

    # r "You know what? Fine. I’m in."
    r "你知道吗？行吧，我加入。"

# game/script.rpy:1326
translate schinese street_ses2_49ab73a8:

    # r "Ain’t like I can get rid of you anyway. Let’s just make it quick."
    r "反正也甩不掉你。快点解决吧。"

# game/script.rpy:1327
translate schinese street_ses2_3b31c4e0:

    # mc "Starting fresh?"
    mc "从头开始？"

# game/script.rpy:1328
translate schinese street_ses2_d93ece15:

    # r "Not sure ‘bout {b}fresh{/b}, but yeah — let’s start somewhere."
    r "不一定是{b}重新{/b}开始，但好吧——总得从某处开始。"

# game/script.rpy:1330
translate schinese street_ses2_ddf5caed:

    # r "What about her?"
    r "那她呢？"

# game/script.rpy:1331
translate schinese street_ses2_8f5410cb:

    # mc "She won’t get in the way, don’t worry. Just you and me."
    mc "她不会碍事的，放心。就你和我。"

# game/script.rpy:1333
translate schinese street_ses2_f975b67a:

    # r "Alright then — but I want this {b}off{/b} the record, got it?"
    r "行吧——但我希望这件事从记录里{b}抹掉{/b}，听到没？"

# game/script.rpy:1334
translate schinese street_ses2_2145a61d:

    # mc "Yeah, yeah. I’m reliable as hell — when I wanna be."
    mc "是是是。我可靠得要命——当我想可靠的时候。"

# game/script.rpy:1347
translate schinese cafe_68167c23:

    # mc "No, seriously, can you {b}believe{/b} that? "
    mc "不是，认真说，你能{b}相信{/b}吗？"

# game/script.rpy:1348
translate schinese cafe_2e6f61b0:

    # mc "I actually gave {b}The Great One{/b} and his sister a ride. On that scooter!"
    mc "我真的载过{b}至高者{/b}和他妹妹。就在那辆摩托车上！"

# game/script.rpy:1351
translate schinese cafe_35eef177:

    # r "You’re kiddin’ me. For real?"
    r "你开玩笑吧。真的？"

# game/script.rpy:1354
translate schinese cafe_3e03f910:

    # mc "Yeah, yeah — I know, crazy, right?"
    mc "是啊是啊——我知道，很离谱，对吧？"

# game/script.rpy:1355
translate schinese cafe_a0aa9ee8:

    # mc "And get this — his sister? Used to be my ex. No joke. Nobody believes me though, shocker."
    mc "而且你听好——他妹妹？以前是我前任。不开玩笑。可没人信我，真是意外。"

# game/script.rpy:1358
translate schinese cafe_5166d196:

    # r "Oh, oh, I got one just like that."
    r "噢噢，我也有一个一模一样的。"

# game/script.rpy:1359
translate schinese cafe_b497af8c:

    # r "Those bikers I owe money to — yeah, the ones I gave your damn scooter to."
    r "那些我欠钱的混混——对，就是我把你的破摩托车给的那帮。"

# game/script.rpy:1360
translate schinese cafe_5bf7d587:

    # r "They feed off poor folks like us. And get this — their boss? Some spoiled Dellyman brat!"
    r "他们专吸我们这种穷人的血。而且听好——他们老大？某个被宠坏的德拉伊姆家小鬼！"

# game/script.rpy:1363
translate schinese cafe_730a2088:

    # mc "Oh, the {b}Dellymans{/b} themselves? Wow, robbing the poor — classy move, love that for them."
    mc "哦，{b}德拉伊姆{/b}家的人本人？哇，抢劫穷人——真有格调，替他们点赞。"

# game/script.rpy:1366
translate schinese cafe_9e9f4a26:

    # r "Right?! I know, it’s insane! How the hell they even dare?"
    r "对吧？！我知道，简直荒唐！他们怎么敢的？"

# game/script.rpy:1367
translate schinese cafe_bc0a6531:

    # r "We bust our asses day and night just to stay alive, and they still wanna bleed us dry!"
    r "我们日夜拼命只为活下去，他们还想把我们榨干！"

# game/script.rpy:1370
translate schinese cafe_cf1adef2:

    # mc "Yeah."
    mc "嗯。"

# game/script.rpy:1371
translate schinese cafe_df77512c:

    # mc "We’re not taking that crap. We’ll kick their asses."
    mc "我们不打算吃这一套。要揍烂他们的屁股。"

# game/script.rpy:1374
translate schinese cafe_7b765cff:

    # r "Hell yeah."
    r "那必须的。"

# game/script.rpy:1377
translate schinese cafe_101c78f0:

    # mc "You and me!"
    mc "你和我！"

# game/script.rpy:1380
translate schinese cafe_3205fe03:

    # r "Oh yes!"
    r "没错！"

# game/script.rpy:1383
translate schinese cafe_4ea9913f:

    # mc "We’ll grab my scooter, clear your debt, and make those guys regret having knees."
    mc "我们拿回我的摩托车，清掉你的债，再让那帮人后悔自己长着膝盖。"

# game/script.rpy:1386
translate schinese cafe_e85febf7:

    # r "Yeah!"
    r "对！"

# game/script.rpy:1387
translate schinese cafe_db12abfe:

    # r "Let’s roll up there, pay ‘em a visit, and take back every damn thing they stole."
    r "我们杀过去拜访一下，把他们偷的每一样该死东西都抢回来。"

# game/script.rpy:1390
translate schinese cafe_ec4b6ef8:

    # r "We’ll hit their place, clean ‘em out good. If they fight — fine. We’ll grab the loot and disappear."
    r "我们抄他们的老窝，狠狠干一票。要是他们反抗——也行。抢完东西就跑。"

# game/script.rpy:1393
translate schinese cafe_ac19dc84:

    # mc "Then we’ll ride off to the other side of the damn planet!"
    mc "然后一路骑到这个该死的星球另一头！"

# game/script.rpy:1396
translate schinese cafe_973d7fc3:

    # r "Get a normal job, settle in some rundown village, grow old like a couple’a ghosts."
    r "找份正经工作，在某个破村子里定居，像两个鬼一样慢慢变老。"

# game/script.rpy:1399
translate schinese cafe_6ce4b36d:

    # mc "Sure, why not? We’ll pretend we’re married — you work, I’ll stay home and look after your mom."
    mc "好啊，为什么不呢？我们假装结婚——你上班，我在家照顾你妈。"

# game/script.rpy:1400
translate schinese cafe_e85febf7_1:

    # r "Yeah!"
    r "对！"

# game/script.rpy:1402
translate schinese cafe_b4efe317:

    # an "Uh… e-excuse me… a-are y’ready t-to, uh, place your order?"
    an "呃……打、打扰一下……您、您准备好点、呃、点餐了吗？"

# game/script.rpy:1404
translate schinese cafe_cb14e271:

    # an "O-or should I c-come back, uh, l-later?"
    an "或、或者我该、呃、晚、晚点再回来？"

# game/script.rpy:1414
# game/script.rpy:1418
translate schinese cafe_a3b1a20c:

    # L "Alright, cut the damn circus, both of you. I asked for a normal talk, not your half-assed crime drama."
    L "行了你俩，收起那套马戏。我要的是好好谈谈，不是你们那半吊子犯罪剧。"

# game/script.rpy:1421
translate schinese cafe_a9e172b3:

    # mc "So… what’s for dinner, Your Majesty? Same as usual, or are we feeling {b}adventurous{/b} tonight?"
    mc "那么……今晚吃点什么，陛下？老样子，还是今晚想玩点{b}刺激的{/b}？"

# game/script.rpy:1423
translate schinese cafe_56dc92c6:

    # L "You know, I’m honestly amazed you can still talk that smooth while hammered."
    L "说真的，我挺惊讶你喝成这样还能说得这么溜。"

# game/script.rpy:1425
translate schinese cafe_dad9f8d5:

    # mc "Hey, school years weren’t wasted — I majored in ‘Drunk But Articulate.’"
    mc "嘿，那些年学费没白交——我的专业是“醉但能言”。"

# game/script.rpy:1427
translate schinese cafe_f435e87d:

    # L "Right. You’re the expert here, huh?"
    L "是啊，这方面你是专家，对吧？"

# game/script.rpy:1428
translate schinese cafe_d4790734:

    # L "Fine — lead the way, {b}chef."
    L "行——带路吧，{b}厨师{/b}。"

# game/script.rpy:1431
translate schinese cafe_a684bc1a:

    # mc "Alright then, two bottles of oolong tea for me. For the ladies — one ‘Horse Meal,’ one ‘Pure Bliss,’ and, uh… top it off with a ‘Wet Dream.’"
    mc "那么，我这边两瓶乌龙茶。两位女士——一份“马粮”、一份“纯乐”，呃……再来一份“春梦”收尾。"

# game/script.rpy:1434
translate schinese cafe_03f9ad84:

    # an "Y-yeah, w-would ya like, uh… a-anythin’ else?"
    an "好、好的，还、还需要点、呃……别的什么吗？"

# game/script.rpy:1436
translate schinese cafe_ea0d6233:

    # r "What’re ya starin’ at? Ain’t no beer here, so what’re we orderin’?"
    r "你看什么看？这里可没酒，我们点的什么？"

# game/script.rpy:1438
translate schinese cafe_41392c57:

    # mc "Four bottles? Damn, you’d outdrink my old man — and he once challenged a sailor."
    mc "四瓶？靠，你比我老爹还能喝——他当年可是跟水手对瓶过。"

# game/script.rpy:1439
translate schinese cafe_af026266:

    # mc "What is it with you and booze anyway? Some kind of emotional support addiction?"
    mc "说真的，你跟酒到底什么仇什么怨？某种情感支持型成瘾？"

# game/script.rpy:1441
translate schinese cafe_b5c93d15:

    # an "S-sorry, um… i-is that all, or, uh, d’ya w-wanna add somethin’?"
    an "对、对不起，呃……就、就这些吗，还、还是您要、要不要加点什么？"

# game/script.rpy:1443
translate schinese cafe_6d946a04:

    # mc "(whispering) Got a sweet tooth? Just copy Lena."
    mc "（低声）有甜食控？照莉娜的抄就行。"

# game/script.rpy:1446
translate schinese cafe_ec00d5b1:

    # r "My bad, I’ll take whatever she’s havin’."
    r "我的错，她喝什么我喝什么。"

# game/script.rpy:1447
translate schinese cafe_85ce68c8:

    # r "And if ya can, drizzle a bit o’ motor oil on top."
    r "能的话，上面再淋点机油。"

# game/script.rpy:1448
translate schinese cafe_4638d677:

    # an "M-motor oil? O-oh… uh, I-I’m n-not sure we, uh, s-serve that… b-but I’ll, um, d-do my best…"
    an "机、机油？哦……呃，我、我不确定我们、呃、有、有这个……但、但我会、嗯，尽、尽力……"

# game/script.rpy:1449
translate schinese cafe_21771bfc:

    # L "Relax. Screw it up all you want — it won’t make a difference."
    L "随便吧。你搞砸多少次都无所谓。"

# game/script.rpy:1452
translate schinese cafe_3961e56e:

    # mc "(whispering) What? What’s even the point of that?"
    mc "（低声）什么？那样做到底有什么意义？"

# game/script.rpy:1454
translate schinese cafe_2fd2b2fc:

    # r "(whispering) Helps with digestion — same as beer."
    r "（低声）助消化——跟啤酒一样。"

# game/script.rpy:1456
translate schinese cafe_5510e13f:

    # mc "(whispering) Yeah, right. Next you’ll tell me gasoline’s your energy drink."
    mc "（低声）对对对。下次你就要告诉我汽油是你的能量饮料了。"

# game/script.rpy:1460
translate schinese cafe_a4717c6b:

    # an "Uh… ‘W-wet Dream’… th-that’s a d-dessert, r-right?"
    an "呃……“春、春梦”……那、那是甜点，对、对吧？"

# game/script.rpy:1461
translate schinese cafe_b95f353d:

    # mc "If everything goes right — yeah, it’s dessert."
    mc "要是都顺利的话——对，是甜点。"

# game/script.rpy:1462
translate schinese cafe_3716aa76:

    # an "O-oh, o-okay, g-got it th-then—"
    an "哦、哦，好、好，那、那就——"

# game/script.rpy:1464
translate schinese cafe_6bed23bb:

    # a "Hey… mon chéri, where is ze toilet here?"
    a "嗯……亲爱的，洗手间在哪里呀？"

# game/script.rpy:1467
translate schinese cafe_9bfaef92:

    # an "Uh… r-right o-over there, t-to your l-left, m-madam."
    an "呃……在、在那边，您、您左手边，夫、夫人。"

# game/script.rpy:1471
translate schinese cafe_fb751322:

    # a "Excellent… merci, chérie."
    a "太好了……谢谢，亲爱的。"

# game/script.rpy:1472
translate schinese cafe_f46c3061:

    # an "S-so glad I c-could help!"
    an "真、真高兴能帮上忙！"

# game/script.rpy:1475
translate schinese cafe_bc5ca656:

    # an "S-so, that’s t-two bottles o’ oolong t-tea, two ‘H-horse meals,’ t-two ‘Pure Bliss,’ a-and, uh, two ‘W-wet Dreams’… r-right?"
    an "那、那么，是两、两瓶乌龙茶，两份“马、马粮”，两、两份“纯乐”，呃、呃，还有两份“春、春梦”……对、对吗？"

# game/script.rpy:1476
translate schinese cafe_3567b574:

    # mc "You’re doing great, by the way."
    mc "顺便说，你干得很好。"

# game/script.rpy:1477
translate schinese cafe_4ab09b9c:

    # an "O-oh, th-thank ya… eheh…"
    an "哦、哦，谢谢……嘿嘿……"

# game/script.rpy:1480
translate schinese cafe_bfd456f9:

    # an "Sh-shef, w-we g-got a n-new order!"
    an "生、生生……呃，我、我们有、有了新、新订单！"

# game/script.rpy:1481
translate schinese cafe_44042115:

    # "YEE-HAW! Horse sounds"
    "耶——吼！马叫声"

# game/script.rpy:1483
translate schinese cafe_2b35b6fe:

    # mc "..."
    mc "……"

# game/script.rpy:1485
translate schinese cafe_4efb1a12:

    # L "(whispering) What was that? You actually praised her?"
    L "（低声）刚才是怎么回事？你居然夸她了？"

# game/script.rpy:1486
translate schinese cafe_36c9f7ad:

    # L "(whispering) And what happened to all those sarcastic jokes of yours?"
    L "（低声）你那些刻薄玩笑都去哪儿了？"

# game/script.rpy:1488
translate schinese cafe_cf4c2e3e:

    # mc "(whispering) Who do you think I am? A clown, yes — but I’ve got some dignity."
    mc "（低声）你以为我是谁？我是小丑——但我也有尊严。"

# game/script.rpy:1489
translate schinese cafe_40a23d69:

    # mc "(whispering) Mocking someone’s doubts isn’t my style."
    mc "（低声）嘲笑别人的自我怀疑不是我的风格。"

# game/script.rpy:1491
translate schinese cafe_d24a63cd:

    # L "(whispering) That wouldn’t have stopped you before."
    L "（低声）换成以前你可不会因此收手。"

# game/script.rpy:1494
translate schinese cafe_65ea2eae:

    # mc "(whispering) Yeah, well... maybe the beer scrambled what’s left of my moral compass.."
    mc "（低声）是啊，嗯……也许是酒精把我仅剩的道德罗盘搅乱了……"

# game/script.rpy:1496
translate schinese cafe_c8a6c9fe:

    # r "You two done whisperin’ yet? Mind sharin’ with the rest of the class?"
    r "你俩嘀咕完了吗？介意跟全班分享一下吗？"

# game/script.rpy:1499
translate schinese cafe_cea97c6c:

    # r "Quit starin’ already — what’s goin’ on?"
    r "别盯着看了——到底怎么回事？"

# game/script.rpy:1501
translate schinese cafe_0a4827ee:

    # mc "About, that waitress? I just said she’s doing her job right. Calm down, that’s not a love confession."
    mc "关于那个女服务员？我只是说她干得好。冷静点，那不是告白。"

# game/script.rpy:1502
translate schinese cafe_e7357324:

    # L "Amazing… you’ve actually softened up a bit."
    L "真惊人……你居然软化了一点。"

# game/script.rpy:1504
translate schinese cafe_128601e5:

    # r "Maybe he’s just gettin’ old."
    r "也许他只是老了。"

# game/script.rpy:1506
translate schinese cafe_c7e03356:

    # mc "Beer’s fault. Always is."
    mc "酒的错。一直都是。"

# game/script.rpy:1507
translate schinese cafe_2a06338c:

    # mc "Anyway — back to business. Where do we find those bikers?"
    mc "总之——回到正事。那些混混在哪？"

# game/script.rpy:1509
translate schinese cafe_b195a3db:

    # r "Kinda sudden, don’t ya think? {w}Why? — Nah, stupid question."
    r "很突然吧？{w}为什么——算了，蠢问题。"

# game/script.rpy:1511
translate schinese cafe_52d9fa1f:

    # r "(We talked about this. But… {w}if I send the location…)"
    r "（我们已经说过了。但……{w}要是我把位置发过去……）"

# game/script.rpy:1513
translate schinese cafe_f8cc6e62:

    # r "Alright, I’m in. Sending coordinates."
    r "行吧，我加入。发坐标了。"

# game/script.rpy:1515
translate schinese cafe_dc16ebcd:

    # mc "Got it."
    mc "知道了。"

# game/script.rpy:1516
translate schinese cafe_c5b107b5:

    # mc "Wait — how the hell did you even get my number?"
    mc "等等——你他妈怎么拿到我号码的？"

# game/script.rpy:1528
translate schinese cafe_9195f18a:

    # r "A-N-D-R-O-I-D. Keep up, genius. Easy stuff for me."
    r "A-N-D-R-O-I-D。跟上节奏吧，天才。这种小菜一碟。"

# game/script.rpy:1529
translate schinese cafe_dadf6f57:

    # r "But that ain’t the point."
    r "但那不是重点。"

# game/script.rpy:1530
translate schinese cafe_f5cc22ec:

    # r "I need guarantees. I’m already stickin’ my neck out sendin’ you those coords."
    r "我需要保证。我把坐标发出去已经是把脑袋别在裤腰带上了。"

# game/script.rpy:1532
translate schinese cafe_25fcdcbe:

    # mc "Alright, hit me with your terms. Besides the usual James Bond secrecy nonsense."
    mc "行吧，开条件吧。除了那种007式的保密废话之外。"

# game/script.rpy:1536
translate schinese cafe_dc585094:

    # r "I need three things. One — full confidentiality."
    r "我需要三件事。第一——绝对保密。"

# game/script.rpy:1537
translate schinese cafe_d44a70dd:

    # r "Two — if shit hits the fan, you don’t know me, never heard of me."
    r "第二——万一出事，你不认识我，从没听说过我。"

# game/script.rpy:1538
translate schinese cafe_a2a75e41:

    # r "And three… a favor."
    r "第三……一个人情。"

# game/script.rpy:1540
translate schinese cafe_2e451b3e:

    # mc "A favor?"
    mc "一个人情？"

# game/script.rpy:1542
translate schinese cafe_8a749a71:

    # r "Details later. For now, I wanna see what you can actually do."
    r "细节以后再说。现在我想看看你到底能做什么。"

# game/script.rpy:1544
translate schinese cafe_656c0265:

    # mc "You’re generous, I’ll give you that. Still can’t quite figure out what’s driving you, though."
    mc "你很大方，这点我承认。不过我还是不太明白你到底图什么。"

# game/script.rpy:1546
translate schinese cafe_d2046141:

    # r "Don’t care what happens to me. Long as my mom stays safe."
    r "我不在乎自己会怎样。只要我妈平安。"

# game/script.rpy:1547
translate schinese cafe_6e8d4426:

    # r "And you... let’s just say I’m bettin’ it all on red."
    r "还有你……就当我把一切都押在红上了。"

# game/script.rpy:1549
translate schinese cafe_f4408f87:

    # mc "Blindly trusting a stranger? Now {b}that’s{/b} bold"
    mc "盲目相信一个陌生人？这倒{b}是{/b}挺大胆"

# game/script.rpy:1553
translate schinese cafe_04dbea3f:

    # r "If it were just you — hell no. But her… that’s different."
    r "要是只有你——当然不行。但她……不一样。"

# game/script.rpy:1555
translate schinese cafe_cf32c76f:

    # mc "You hear that, Lena?"
    mc "你听到了吗，莉娜？"

# game/script.rpy:1556
translate schinese cafe_25372b35:

    # mc "The idiot-king strategy never fails."
    mc "蠢货国王的战术从不失手。"

# game/script.rpy:1557
translate schinese cafe_91c0e614:

    # L "Well… glad you’re happy, I guess?"
    L "嗯……你开心就好吧？"

# game/script.rpy:1561
translate schinese cafe_0e6696df:

    # n "Lena… my dear… long time no see, ne? I think… you leave city… when already come back, hmm?"
    n "莉娜……我的老友……好久不见，对吧？我记得……你离开这座城市……结果已经回来了，嗯？"

# game/script.rpy:1563
translate schinese cafe_2095c639:

    # L "What do you want, Dmitriy?"
    L "德米特里，你想要什么？"

# game/script.rpy:1566
translate schinese cafe_0f716820:

    # n "So… we are mean, yes…? This… how you now treat old colleagues, yo?"
    n "所以……我们关系很差了，是吧？这……就是你如今对待老同事的方式？"

# game/script.rpy:1567
translate schinese cafe_99fe0f09:

    # L "You’re the last person I wanna have anything to do with in this world."
    L "这世上我最不想打交道的人就是你。"

# game/script.rpy:1568
translate schinese cafe_d9222237:

    # n "Ah… fired from worku… who not happen, ne?"
    n "啊……被公司开除了吧……那不可能发生，对吧？"

# game/script.rpy:1569
translate schinese cafe_e2ab8a70:

    # L "Remind me — whose fault was this anyway?"
    L "提醒我一下——这到底是谁的错？"

# game/script.rpy:1571
translate schinese cafe_b57aadda:

    # n "You… you good employee was… very good, ah… but… not worthy, sa."
    n "你……你是个好员工……非常好，啊……但……不够格，这样。"

# game/script.rpy:1572
translate schinese cafe_ac96c449:

    # n "Honestly… I happy you leave… now organization… look… professional, ne?"
    n "说实话……你走我很高兴……现在组织……看起来……很专业，对吧？"

# game/script.rpy:1575
translate schinese cafe_80ffecf9:

    # L "You’re just—"
    L "你就是——"

# game/script.rpy:1576
translate schinese cafe_30c1fd3a:

    # mc "(whispering) Don’t fall for that — it’s a provocation."
    mc "（低声）别上当——这是挑衅。"

# game/script.rpy:1577
translate schinese cafe_2d8330bc:

    # L "(whispering) [mc], you don’t get it — I can’t stand him."
    L "（低声）[mc]，你不懂——我受不了他。"

# game/script.rpy:1578
translate schinese cafe_e5ea36e6:

    # mc "(whispering) I’ll handle this, but I want the full story afterwards."
    mc "（低声）我来处理，但事后你得把前因后果都告诉我。"

# game/script.rpy:1580
translate schinese cafe_eefca9bb:

    # mc "Hey there, furball. Do me a favor — get lost."
    mc "喂，毛球。帮我个忙——滚开。"

# game/script.rpy:1581
translate schinese cafe_ccf639bb:

    # n "Ah… and what kind of clown are you, hmm? So now you work in circus… perfect place for you, Lena, ne…"
    n "啊……你又是个什么小丑，嗯？现在在马戏团工作了……真是给你的完美地方，莉娜，对吧……"

# game/script.rpy:1582
translate schinese cafe_da3fd96b:

    # mc "Clown, huh? Funny. Usually bears like you bark when they’re scared."
    mc "小丑，是吗？有意思。像你这种熊通常是在害怕时才叫唤。"

# game/script.rpy:1584
translate schinese cafe_116a06bb:

    # n "Careful tongue, boy… I still… can make life very short, hmm."
    n "小心你的舌头，小子……我照样……能让你的日子很短，嗯。"

# game/script.rpy:1585
translate schinese cafe_4adece61:

    # mc "Oh, I don’t doubt it. Problem is, you’d have to {b}get up from behind that desk first{/b}."
    mc "哦，我一点也不怀疑。问题是，你得先{b}从那张桌子后面站起来{/b}。"

# game/script.rpy:1586
translate schinese cafe_c5700d09:

    # n "You… you not know who… talk with, ne?"
    n "你……你不知道你在……跟谁说话，对吧？"

# game/script.rpy:1588
translate schinese cafe_86024600:

    # mc "A bear?"
    mc "熊？"

# game/script.rpy:1589
translate schinese cafe_38769da8:

    # mc "Come on. Where’s your creativity? You guys all read from the same damn script?"
    mc "拜托。你的创造力呢？你们都是从同一份该死的台词本上念的吗？"

# game/script.rpy:1590
translate schinese cafe_4872606f:

    # mc "Each one of you thinks the world spins around your sorry ass."
    mc "你们每个人都以为世界围着你那可怜屁股转。"

# game/script.rpy:1591
translate schinese cafe_6a575861:

    # mc "News flash — I don’t care who you are, what you are, or who’s paying your bills."
    mc "最新消息——我不在乎你是谁、是什么，也不在乎谁在替你付账。"

# game/script.rpy:1592
translate schinese cafe_850b733a:

    # n "How… how dare you?! Stand up… I tear you in pieces, yo!"
    n "你……你竟敢？！站起来……我把你撕成碎片！"

# game/script.rpy:1595
translate schinese cafe_ed69945b:

    # mc "Don’t come for me — deal with your own problems first, oh mighty decision-maker."
    mc "别冲我来——先解决你自己的问题吧，哦伟大的决策者。"

# game/script.rpy:1597
translate schinese cafe_5366b9e3:

    # n "How… how you… no, freaku! I not leave this… tell me where live… where worku… I crush you to dust, ne!"
    n "你……你怎么敢……不，疯子！我不放过你……告诉我你住哪儿……在哪儿工作……我把你碾成粉末，对吧！"

# game/script.rpy:1599
translate schinese cafe_932e9969:

    # L "(whispering) [mc], I’m gonna tear him to pieces right now."
    L "（低声）[mc]，我现在就把他撕碎。"

# game/script.rpy:1601
translate schinese cafe_18440c9f:

    # mc "(whispering) Your Majesty, if you’d be so kind — let your idiot-king handle this."
    mc "（低声）陛下，如果可以的话——请让您的蠢货国王来处理。"

# game/script.rpy:1604
translate schinese cafe_8fc0b82d:

    # mc "(whispering) You androids… not exactly on good terms with beastfolk, right?"
    mc "（低声）你们这些安卓……跟兽族关系不太好，对吧？"

# game/script.rpy:1606
translate schinese cafe_9ced174d:

    # r "(whispering) How to say ‘is more polite, we hate ‘em."
    r "（低声）这么说比较客气：我们恨他们。"

# game/script.rpy:1608
translate schinese cafe_c820b888:

    # mc "(whispering) Perfect. Let the fun begin, shall we?"
    mc "（低声）完美。娱乐时间开始，好吗？"

# game/script.rpy:1610
translate schinese cafe_7e1708c7:

    # r "(whispering) What are you—"
    r "（低声）你们要干什——"

# game/script.rpy:1613
translate schinese cafe_cd23e5c7:

    # n "I talk to you… tongue swallow already, hmm?!"
    n "你敢跟我说话……舌头就已经被吞了，嗯？！"

# game/script.rpy:1615
translate schinese cafe_a5763272:

    # mc "You might wanna check who you’re messing with, teddy. Looks like you don’t value your life much."
    mc "你或许该看看你惹的是谁，泰迪。看起来你不太珍惜自己的命。"

# game/script.rpy:1617
translate schinese cafe_2252e69e:

    # n "What… you talk about… t—"
    n "你……你在说什么……你——"

# game/script.rpy:1619
translate schinese cafe_69547d2f:

    # mc "She makes one call, and your whole crew’s getting buried before dinner."
    mc "她一个电话，你们整伙人晚餐前就得入土。"

# game/script.rpy:1621
translate schinese cafe_146bb735:

    # n "Ah… I totally believe you now, clown, ne… hah!"
    n "啊……我现在完全信你了，小丑，对吧……哈！"

# game/script.rpy:1624
translate schinese cafe_b521379e:

    # mc "And the Darwin Award goes to — this guy!"
    mc "而达尔文奖颁给——这位仁兄！"

# game/script.rpy:1628
translate schinese cafe_36bb022e:

    # mc "I’ll let you in on a secret — she knows the Dellaimen family {b}personally{/b}."
    mc "告诉你个秘密——她跟德拉伊姆家{b}私下里很熟{/b}。"

# game/script.rpy:1629
translate schinese cafe_1a62a6b5:

    # n "Wha—"
    n "什——"

# game/script.rpy:1639
translate schinese cafe_63a7bb89:

    # r "You’re screwed."
    r "你完蛋了。"

# game/script.rpy:1641
translate schinese cafe_e25f46af:

    # mc "If I were you, I’d be on my knees right now, begging for mercy. Or at least making sure your family doesn’t end up collateral."
    mc "我要是你，现在就该跪下求饶。或者至少确保你家人不会被殃及。"

# game/script.rpy:1642
translate schinese cafe_6132edef:

    # n "I…"
    n "我……"

# game/script.rpy:1645
translate schinese cafe_135ebb2a:

    # mc "Of course, you could call me a liar..."
    mc "当然，你也可以说我在撒谎……"

# game/script.rpy:1647
translate schinese cafe_fb3eff6f:

    # mc "but Lena’ll tell you — I physically {b}can’t{/b} lie."
    mc "但莉娜会告诉你——我{b}根本{/b}没法撒谎。"

# game/script.rpy:1649
translate schinese cafe_e0fed054:

    # n "I… I apologize… all… all good, hmm."
    n "我……我道歉……都、都好，嗯。"

# game/script.rpy:1652
translate schinese cafe_37bad3ab:

    # L "That was a quick change of heart."
    L "你变心还挺快。"

# game/script.rpy:1655
translate schinese cafe_9e4febec:

    # r "Hey, what was all that for? Lena coulda just kicked his ass and called it a day."
    r "喂，刚才那一整套是干嘛？莉娜直接揍他一顿不就完了。"

# game/script.rpy:1656
translate schinese cafe_c9c565b7:

    # mc "That little show just saved her reputation. You’d rather see her dragged through the mud?"
    mc "刚才那出戏保住了她的名声。你难道想看她被踩进泥里？"

# game/script.rpy:1658
translate schinese cafe_83484c61:

    # r "Academy don’t dock points for regular beatdowns. Especially when it’s a council member doin’ the punchin’."
    r "学院可不因为普通打架扣分。尤其打人的还是评议会成员。"

# game/script.rpy:1660
translate schinese cafe_76af590d:

    # mc "Wait — what? Seriously?"
    mc "等等——什么？真的？"

# game/script.rpy:1661
translate schinese cafe_7981bb1a:

    # L "Yeah… a hundred duels happen every day. There’s just no way to track all of that physically."
    L "嗯……每天有上百场决斗。根本没可能全都用身体记下来。"

# game/script.rpy:1663
translate schinese cafe_611f9907:

    # r "They’re too damn lazy to care — unless it hits the headlines. Then you’re in trouble."
    r "除非上了头条，否则他们懒得在乎——不然你就麻烦了。"

# game/script.rpy:1665
translate schinese cafe_766d52f8:

    # mc "You’ve gotta be kidding me... Give me back the time and brain cells I wasted on that damn bear!"
    mc "你开什么玩笑……把我浪费在那头熊身上的时间和脑细胞还给我！"

# game/script.rpy:1668
translate schinese cafe_f02745e9:

    # L "I… gotta admit… you actually looked kinda cool there. Thanks, [mc]."
    L "我……得承认……你刚才还真有点帅。谢谢，[mc]。"

# game/script.rpy:1671
translate schinese cafe_6b4429e2:

    # r "Ohhh, so {b}that’s{/b} what this is about, girl!"
    r "哦——原来{b}是{/b}因为这个啊，姑娘！"

# game/script.rpy:1672
translate schinese cafe_0e33b5fd:

    # mc "Huh? What?"
    mc "嗯？什么？"

# game/script.rpy:1676
translate schinese cafe_85cdc84e:

    # an "H-here’s y-your order…"
    an "给、给您……您、您的单……"

# game/script.rpy:1678
translate schinese cafe_dd7600cf:

    # L "Wow, that’s gorgeous! Could you, please, share the recipe afterwards? I’d be super grateful!"
    L "哇，太漂亮了！之后能请你分享一下配方吗？我会非常感激！"

# game/script.rpy:1679
translate schinese cafe_2700d77d:

    # an "I-I, uh… c-can’t, s-sorry… th-that’s somethin’ y-you’d gotta, uh, a-ask the sh-shef ‘bout…"
    an "我、我，呃……不、不行的，抱歉……那、那种东西您得、呃，去、去问厨、厨师……"

# game/script.rpy:1682
translate schinese cafe_eef4c8c1:

    # mc "And what exactly are you doing?"
    mc "那你到底在干什么？"

# game/script.rpy:1685
translate schinese cafe_3e5a1448:

    # r "Hmm? I’m just doin’ what people do — savin’ memories."
    r "嗯？我只是在做大家都做的事——记录回忆。"

# game/script.rpy:1688
translate schinese cafe_6d7a3ca7:

    # mc "With hands?"
    mc "用手？"

# game/script.rpy:1689
translate schinese cafe_cc09dc36:

    # r "And now… say cheese!"
    r "现在……笑一个！"

# game/script.rpy:1704
translate schinese two_sisters_e0e2bfe9:

    # L "Hey, don’t mind her, okay? She’s actually a good girl... just goin’ through some stuff."
    L "别介意她，好吗？她其实是个好姑娘……只是最近遇到些事。"

# game/script.rpy:1705
translate schinese two_sisters_9c1dc722:

    # mc "Does that really give her the right to bail on people like that?"
    mc "那她就有权利这样抛下别人吗？"

# game/script.rpy:1706
translate schinese two_sisters_a711b547:

    # L "No..."
    L "不……"

# game/script.rpy:1708
translate schinese two_sisters_f3fd639a:

    # mc "Relax, I don’t blame anyone but myself. Dumb idea, selling that scooter."
    mc "放松，我不怪任何人，只怪我自己。卖那辆摩托车真是个蠢主意。"

# game/script.rpy:1711
translate schinese two_sisters_d1307652:

    # mc "Just picture it — ‘For one night only! Get the best memories of my life — now at half price!’"
    mc "想象一下——“限一晚！用半价买回我一生中最美好的回忆！”"

# game/script.rpy:1712
translate schinese two_sisters_b770fd66:

    # mc "And then I’m out there running around, trying to buy my own past back... God, it’s not even funny."
    mc "然后我在外面到处跑，想把自己的过去买回来……天哪，一点也不好笑。"

# game/script.rpy:1714
translate schinese two_sisters_5af07202:

    # mc "Listen to me ramble… guess that beer’s finally doing its job."
    mc "听我在这儿啰嗦……看来那啤酒终于开始起作用了。"

# game/script.rpy:1716
translate schinese two_sisters_8dec0e4c:

    # mc "Lena? You still here?"
    mc "莉娜？你还在吗？"

# game/script.rpy:1718
translate schinese two_sisters_f4ddc222:

    # L "Mmh?"
    L "嗯哼？"

# game/script.rpy:1720
translate schinese two_sisters_d52fc53b:

    # L "Yeah… I just figured I’d let you talk it out."
    L "嗯……我就是想着让你说出来会好受点。"

# game/script.rpy:1721
translate schinese two_sisters_35e03937:

    # L "You’re not exactly the kinda guy who lets go easy, huh?"
    L "你可不是那种能轻易放下的人，对吧？"

# game/script.rpy:1723
translate schinese two_sisters_34aab01e:

    # L "So, what’s the plan now?"
    L "那么，现在的计划是什么？"

# game/script.rpy:1725
translate schinese two_sisters_6c8ee9bf:

    # mc "What’s up? You mad about something?"
    mc "怎么了？在为什么生气？"

# game/script.rpy:1727
translate schinese two_sisters_9021781f:

    # L "Nah… It’s just—"
    L "没……只是——"

# game/script.rpy:1728
translate schinese two_sisters_83312028:

    # L "night’s already here, and we’ve done nothin’ useful."
    L "天都黑了，我们一件正事也没干。"

# game/script.rpy:1729
translate schinese two_sisters_83da9923:

    # L "I did promise to get you all dressed up, and look at us now…"
    L "我可是答应过要好好打扮你的，看看我们现在……"

# game/script.rpy:1730
translate schinese two_sisters_e5bd8cd2:

    # mc "Come on, it’s fine. I didn’t even need those clothes."
    mc "算了，没事。反正我也不需要那些衣服。"

# game/script.rpy:1731
translate schinese two_sisters_f00a4807:

    # mc "Do I really look {b}that{/b} bad?"
    mc "我看起来真有{b}那么{/b}糟吗？"

# game/script.rpy:1733
translate schinese two_sisters_4ac2d2ff:

    # L "So… what do we do ’bout the bikers? We’re almost there."
    L "那么……那些混混怎么办？快到了。"

# game/script.rpy:1736
translate schinese two_sisters_30e019e4:

    # mc "So, two ways to play this — we go up to the bikers, ask nicely to get it back... or—"
    mc "两种玩法——要么我们去找混混，好好说，把车要回来……要么——"

# game/script.rpy:1738
translate schinese two_sisters_f17020b1:

    # L "Or?"
    L "要么什么？"

# game/script.rpy:1740
translate schinese two_sisters_c1e93803:

    # mc "...or we sneak in and steal it."
    mc "……要么我们溜进去偷回来。"

# game/script.rpy:1742
translate schinese two_sisters_bb8420e9:

    # L "No way. That’s insane."
    L "不行。太疯狂了。"

# game/script.rpy:1744
translate schinese two_sisters_bb55965b:

    # mc "Yeah, I’m not saying it’s smart… hell, it’s a dumb idea."
    mc "我没说这是聪明办法……说实话，这就是个蠢主意。"

# game/script.rpy:1745
translate schinese two_sisters_28978479:

    # mc "But come on — playing it safe? That’s just boring as hell."
    mc "但拜托——稳妥行事？那也太无聊了。"

# game/script.rpy:1747
translate schinese two_sisters_f954e5d2:

    # mc "See, here’s the thing: if we just walk up and ask, we look like idiots. But if we steal it—"
    mc "事情是这样：要是我们直接上去要，我们就成了傻子。但要是偷回来——"

# game/script.rpy:1748
translate schinese two_sisters_279760d2:

    # mc "—we’re idiots with a plan."
    mc "——我们就是“有计划的傻子”。"

# game/script.rpy:1749
translate schinese two_sisters_d0fa9b71:

    # mc "So… what’s it gonna be, Lena?"
    mc "那么……莉娜，你说了算？"

# game/script.rpy:1757
translate schinese two_sisters_e43604c2:

    # a "Impressive… zis is from ze limited collection, non? ‘Ow did you manage to get it?"
    a "厉害……这是限量版吧？您是怎么弄到的？"

# game/script.rpy:1771
# game/script.rpy:1774
translate schinese two_sisters_4a494087:

    # li "Acquiring it was never the problem. Earning it — was."
    li "得到它从来不是问题。挣到它才是。"

# game/script.rpy:1776
translate schinese two_sisters_d673ec56:

    # a "Even wiz your status? Mon dieu… forgive me, but zat is quite… wild."
    a "以您的身份来说也是？天哪……请原谅我，但这可真是……太疯狂了。"

# game/script.rpy:1778
translate schinese two_sisters_ead6269d:

    # li "Another reminder that status without strength is nothing."
    li "又一次证明，没有实力的地位一文不值。"

# game/script.rpy:1779
translate schinese two_sisters_255538a1:

    # ti "But strength without wit’s like bread without butter — dull, ain’t it, sis?"
    ti "但没有智谋的实力就像没抹黄油的面包——寡淡，不是吗，姐姐？"

# game/script.rpy:1781
translate schinese two_sisters_5fa8193c:

    # li "They complement each other, indeed. But without strength, clever words are merely noise."
    li "确实互补。但没有实力，再漂亮的词也不过是噪音。"

# game/script.rpy:1782
translate schinese two_sisters_e51e1177:

    # ti "Lucky for this daft wee thing, I got a clever sister to make me look good."
    ti "这小蠢货运气不错，摊上我这么个聪明姐姐帮她撑场面。"

# game/script.rpy:1783
translate schinese two_sisters_9e717813:

    # li "..."
    li "……"

# game/script.rpy:1785
translate schinese two_sisters_45152b5f:

    # a "Young lady, I do not wish to disturb you, but—"
    a "年轻女士，我不想打扰您，但是——"

# game/script.rpy:1787
translate schinese two_sisters_68f1ca55:

    # li "I know."
    li "我知道。"

# game/script.rpy:1788
translate schinese two_sisters_75a52ba1:

    # li "Tia? We have uninvited guests."
    li "蒂娅？我们有不速之客。"

# game/script.rpy:1793
translate schinese two_sisters_26629ec4:

    # L "(whispering) Please tell me you’ve got better plans for tomorrow than… {b}this{/b}."
    L "（低声）拜托告诉我，你明天的计划比这个……{b}强{/b}。"

# game/script.rpy:1794
translate schinese two_sisters_2d3aa1e4:

    # mc "(whispering) Come on, it’s a genius plan. Just needs a little polish and it’d be perfect."
    mc "（低声）拜托，这是个天才计划。只要稍微打磨一下就完美了。"

# game/script.rpy:1795
translate schinese two_sisters_a7e242dd:

    # L "(whispering) Sometimes I wonder if you’re a genius or just plain stupid."
    L "（低声）有时候我真分不清你是天才还是单纯的笨蛋。"

# game/script.rpy:1796
translate schinese two_sisters_9766e38f:

    # mc "(whispering) Two sides of the same coin, really. I just tend to land on the stupid one more often."
    mc "（低声）其实就是一枚硬币的两面。我只是比较常落在“蠢”的那面。"

# game/script.rpy:1798
translate schinese two_sisters_dfb14b41:

    # li "Amateurs. Madmen. Whatever they are — it’s almost painful to watch."
    li "外行。疯子。不管他们是什么——看着都令人痛苦。"

# game/script.rpy:1800
translate schinese two_sisters_cf62dedf:

    # li "Still, stay alert. Underestimating them would be a mistake."
    li "但还是保持警惕。低估他们会是错误。"

# game/script.rpy:1802
translate schinese two_sisters_119373a6:

    # ti "You and yer bloody caution again, sister dear. But I’ve got to say— what a sight."
    ti "亲爱的姐姐，你又是这套该死的小心谨慎。不过我得说——真是好戏。"

# game/script.rpy:1803
translate schinese two_sisters_6c08f13f:

    # ti "Takes a special kind o’ fool to pull somethin’ like this, don’t ye think?"
    ti "要干这种事，得是某种特殊的傻子才行，你不觉得吗？"

# game/script.rpy:1807
translate schinese two_sisters_fce80ab6:

    # ti "And yet…"
    ti "然而……"

# game/script.rpy:1810
translate schinese two_sisters_a683e26d:

    # li "Yes."
    li "是的。"

# game/script.rpy:1812
translate schinese two_sisters_8b98e05d:

    # li "Check the rear entrances and exits, sweep the perimeter. Report anything unusual directly to me."
    li "检查所有后门出口，扫一遍周边。发现任何异常直接向我报告。"

# game/script.rpy:1813
translate schinese two_sisters_f70023f4:

    # a "As you wish, mademoiselle."
    a "如您所愿，小姐。"

# game/script.rpy:1814
translate schinese two_sisters_98e66d28:

    # li "No. We’ll need you here Nami send message to security. Tia — your turn."
    li "不。我们需要你留在这里。娜米，去给安保发消息。蒂娅——轮到你了。"

# game/script.rpy:1819
translate schinese two_sisters_134f0a0b:

    # li "And be careful this time. I’d rather not see a repeat of last time’s... spectacle."
    li "这次小心点。我不想再看到上次那种……盛况。"

# game/script.rpy:1820
translate schinese two_sisters_42992a28:

    # ti "Sis — what d'you think you're doin'? What about the show, eh?"
    ti "姐姐——你以为你在干什么？演出怎么办，嗯？"

# game/script.rpy:1821
translate schinese two_sisters_952f421f:

    # ti "Or d'you want to keep it all quiet-like, same as always? If that's the case, be me guest an' do it yerself."
    ti "还是你想照老样子把一切都悄悄解决？要那样的话，请便，自己来吧。"

# game/script.rpy:1822
translate schinese two_sisters_37b6c4a8:

    # li "Tienara. Rating."
    li "蒂娅。评分。"

# game/script.rpy:1823
translate schinese two_sisters_ffe205ec:

    # ti "Aye, aye, don’t fret. I’ll do me best, promise."
    ti "是是是，别担心。我会尽力，保证。"

# game/script.rpy:1825
translate schinese two_sisters_f81acc97:

    # ti "(whispering) Please, let it be some gang’s errand boys, please, please..."
    ti "（低声）拜托，让它只是哪个混混的小弟吧，拜托拜托……"

# game/script.rpy:1829
translate schinese two_sisters_8a53d03a:

    # mc "(...Did I just bump into something, or someone?)"
    mc "（……我这是撞上什么东西了，还是撞上什么人了？）"

# game/script.rpy:1830
translate schinese two_sisters_d7c0d059:

    # ti "A bit o’ cardboard trophy, is it?"
    ti "是个纸板奖杯吧？"

# game/script.rpy:1831
translate schinese two_sisters_02976d00:

    # ti "Yank it off the hard way, or do it the easy way — stand there an’ let me kick yer arse."
    ti "硬抢，还是简单点——站那儿让俺踹你屁股。"

# game/script.rpy:1832
translate schinese two_sisters_5b321b38:

    # mc "You know, mysterious stranger, option two sounds way more exciting… but I’ll have to go with one."
    mc "神秘的陌生人，你好啊。第二个选项听起来刺激多了……但我只能选第一个。"

# game/script.rpy:1835
translate schinese two_sisters_abdcf2a8:

    # mc "(What the beauty...)"
    mc "（这美景……）"

# game/script.rpy:1836
translate schinese two_sisters_866b63be:

    # ti "Oh, ye ruin all the fun, don’t ye? "
    ti "哦，你把乐子全毁了，是吧？"

# game/script.rpy:1837
translate schinese two_sisters_2ce226b0:

    # ti "Not ashamed, darlin’? Come on, just one hit, I’ll be gentle."
    ti "不害臊吗，亲爱的？来，就一下，我会很温柔的。"

# game/script.rpy:1838
translate schinese two_sisters_39926ec2:

    # mc "(whispering) Len? Pretty sure we’ve been made."
    mc "（低声）莉娜？我敢肯定我们被发现了。"

# game/script.rpy:1839
translate schinese two_sisters_426bade4:

    # mc "(whispering) Len?"
    mc "（低声）莉娜？"

# game/script.rpy:1840
translate schinese two_sisters_9cdba9ae:

    # L "Yeah, get up."
    L "嗯，起来。"

# game/script.rpy:1841
translate schinese two_sisters_59337180:

    # ti "Oi, cat got yer tongue? I’m talkin’ to ye, love."
    ti "喂，猫把你的舌头吃了？俺在跟你说话呢，亲爱的。"

# game/script.rpy:1843
translate schinese two_sisters_6545d27c:

    # mc "You came to the right guy — I’m a pro at crushing expectations."
    mc "你找对人了——我很擅长粉碎别人的期待。"

# game/script.rpy:1844
translate schinese two_sisters_98040512:

    # mc "But I don’t think that’s reason enough to get punched."
    mc "但我不觉得这就够格让我挨一拳。"

# game/script.rpy:1845
translate schinese two_sisters_502584ce:

    # mc "Even with legs like yours. Maybe next time, though."
    mc "就算你腿长成那样也一样。下次倒是可以考虑。"

# game/script.rpy:1862
# game/script.rpy:1865
translate schinese two_sisters_c1927919:

    # ti "Hey, clown — who’re ye with, then?"
    ti "喂，小丑——你到底是谁的人？"

# game/script.rpy:1866
translate schinese two_sisters_4e54ceef:

    # ti "North District? Or one o’ them Sunrise rats?"
    ti "北区？还是那帮“日出”的老鼠？"

# game/script.rpy:1868
translate schinese two_sisters_99100673:

    # mc "I’m my own man. And I’ve got no damn clue what districts you’re talking about."
    mc "我是我自己的人。也不知道你在说什么区。"

# game/script.rpy:1871
translate schinese two_sisters_9377ed09:

    # ti "That so? Then what’re ye doin’ here, eh?"
    ti "是吗？那你来这儿干嘛，嗯？"

# game/script.rpy:1873
translate schinese two_sisters_98c1a9e4:

    # mc "To get back what you stole."
    mc "来拿回你偷的东西。"

# game/script.rpy:1875
translate schinese two_sisters_389b947d:

    # ti "Stealin’ what’s stolen?"
    ti "偷“被偷的东西”？"

# game/script.rpy:1876
translate schinese two_sisters_a2fabd1e:

    # ti "You’re a feckin’ madman, so ye are. I could break yer bones right now."
    ti "你真是个该死的疯子。俺现在就能打断你的骨头。"

# game/script.rpy:1879
translate schinese two_sisters_e059f699:

    # mc "Not {b}steal{/b}, just... reclaim what was on loan to you."
    mc "不是{b}偷{/b}，只是……收回“借”给你的东西。"

# game/script.rpy:1880
translate schinese two_sisters_b3b106c5:

    # mc "For certain reasons. For a certain time."
    mc "出于某些原因。为了一段特定的时间。"

# game/script.rpy:1881
translate schinese two_sisters_31d08529:

    # mc "Wouldn’t recommend breaking my bones, though. I still need them. Plus, might cause you some... paperwork."
    mc "不过我不建议你打断我的骨头。我还需要它们。而且可能会给你带来一些……文书工作。"

# game/script.rpy:1883
translate schinese two_sisters_8580077d:

    # ti "So ye’re threatenin’ me now, is it?"
    ti "所以你现在是在威胁我？"

# game/script.rpy:1884
translate schinese two_sisters_92e5e844:

    # ti "Brave words for someone standin’ that close, love."
    ti "站这么近还说大话，亲爱的，你可真勇敢。"

# game/script.rpy:1886
translate schinese two_sisters_f8f2468c:

    # mc "Come on, why would I? To piss you off? I could’ve just called the cops or hired someone for that."
    mc "拜托，我为什么要？为了惹毛你？我大可以直接报警或者雇人。"

# game/script.rpy:1890
translate schinese two_sisters_021c979f:

    # ti "Sister, what d’ye reckon? He’s not like the other tossers we’ve had."
    ti "姐姐，你觉得呢？他可不像我们之前遇到的那种废物。"

# game/script.rpy:1891
translate schinese two_sisters_d7770c80:

    # li "We’ll hear him out. If he gets difficult — he’s yours to handle."
    li "我们听他说完。如果他找麻烦——就交给你处理。"

# game/script.rpy:1892
translate schinese two_sisters_d3201c41:

    # ti "Oh, I’ll gladly—"
    ti "哦，我很乐意——"

# game/script.rpy:1895
translate schinese two_sisters_ba709879:

    # mc "Marry me."
    mc "嫁给我。"

# game/script.rpy:1897
translate schinese two_sisters_a60d4a9e:

    # ti "..."
    ti "……"

# game/script.rpy:1899
translate schinese two_sisters_ec2d72bd:

    # L "(whispering) What the hell are you doin’?!"
    L "（低声）你到底在干什么？！"

# game/script.rpy:1900
translate schinese two_sisters_641da0a6:

    # mc "(whispering) I’ve got a plan, and I’m sticking to it. Trust me."
    mc "（低声）我有个计划，而且我打定主意了。相信我。"

# game/script.rpy:1901
translate schinese two_sisters_d96d904a:

    # L "(whispering) Please, don’t do anything stupid."
    L "（低声）拜托，别做蠢事。"

# game/script.rpy:1903
translate schinese two_sisters_f1d86ce9:

    # ti "Ye serious right now?"
    ti "你现在是认真的？"

# game/script.rpy:1907
translate schinese two_sisters_c8f8d75f:

    # mc "Dead serious. Be my girlfriend."
    mc "绝对认真。做我女朋友。"

# game/script.rpy:1908
translate schinese two_sisters_10145c1c:

    # mc "Might sound crazy, but I fell for you the moment I saw you."
    mc "听起来可能很疯狂，但我看到你的那一刻就沦陷了。"

# game/script.rpy:1910
translate schinese two_sisters_454f3985:

    # mc "They were so beautiful I forgot how to talk… and couldn’t look away."
    mc "那双腿美得我忘了怎么说话……眼睛也移不开。"

# game/script.rpy:1911
translate schinese two_sisters_eb24caee:

    # ti "From them, ye say?"
    ti "你说的是“它们”？"

# game/script.rpy:1913
translate schinese two_sisters_ee1e2331:

    # mc "I meant your legs—those perfect, glorious legs—"
    mc "我指的是你的腿——那双完美、光辉的腿——"

# game/script.rpy:1919
translate schinese two_sisters_399c9b89:

    # L "Okay, that’s enough humiliation for one night. "
    L "好了，今晚的羞辱到此为止。"

# game/script.rpy:1920
translate schinese two_sisters_36c728c5:

    # L "What were you even thinkin’, confessin’ to her of all people?"
    L "你当时到底在想什么，为什么偏偏跟她告白？"

# game/script.rpy:1921
translate schinese two_sisters_baa7b1b7:

    # L "And what about your last relationship, huh? Or did you already forget what happened after that?"
    L "那你上一段感情呢？之后发生的事你都忘了？"

# game/script.rpy:1924
translate schinese two_sisters_0bd21dab:

    # mc "Oh, come on, that last time was totally different. This one was planned."
    mc "拜托，上次完全不一样。这次是有计划的。"

# game/script.rpy:1925
translate schinese two_sisters_acd701ca:

    # mc "And if it worked, we’d be golden."
    mc "而且要是成功了，我们就发达了。"

# game/script.rpy:1926
translate schinese two_sisters_18f963ea:

    # mc "But thanks to you, the plan crashed and burned."
    mc "多亏了你，计划彻底泡汤。"

# game/script.rpy:1927
translate schinese two_sisters_160571ef:

    # mc "Appreciate it, Lena."
    mc "谢谢你，莉娜。"

# game/script.rpy:1929
translate schinese two_sisters_1c0cbd4c:

    # li "Enough of this circus. The real reason you’re here — now."
    li "别再演这出马戏了。说你们来的真正原因——现在。"

# game/script.rpy:1932
translate schinese two_sisters_bf436624:

    # mc "We’re here for a scooter."
    mc "我们是为了一辆摩托车来的。"

# game/script.rpy:1933
translate schinese two_sisters_5fbdc6eb:

    # mc "Old piece of junk. Doesn’t run, doesn’t roll, barely exists."
    mc "一堆老破铜烂铁。跑不起来，转不动，勉强算存在。"

# game/script.rpy:1934
translate schinese two_sisters_ae06065c:

    # mc "And for the record, we come in peace."
    mc "声明一下，我们是带着诚意来的。"

# game/script.rpy:1935
translate schinese two_sisters_7d7bf6b0:

    # mc "You hand over the scooter, we walk out happy. Easy."
    mc "你把摩托车交出来，我们开开心心走人。很简单。"

# game/script.rpy:1937
translate schinese two_sisters_e075e93d:

    # li "Tell me — what guarantees do I have that you’re telling the truth?"
    li "告诉我——我凭什么保证你说的是真话？"

# game/script.rpy:1939
translate schinese two_sisters_ab4aea31:

    # mc "Because I can’t lie? {w}…Literally."
    mc "因为我说不了谎？{w}……字面意义上的。"

# game/script.rpy:1940
translate schinese two_sisters_4802b865:

    # L "(whispering) You gonna tell that to {b}everyone{/b} you meet?"
    L "（低声）你打算对遇到的{b}每一个人{/b}都这么说吗？"

# game/script.rpy:1941
translate schinese two_sisters_b36dcaa7:

    # mc "(whispering) Relax. My conscience is spotless. I’ve got nothing to hide."
    mc "（低声）放心。我良心清白。"

# game/script.rpy:1942
translate schinese two_sisters_eeb8f3d5:

    # L "(whispering) You wouldn’t have one, if you hadn’t made that promise to Rosa."
    L "（低声）要不是你答应过罗丝，你也不会有。"

# game/script.rpy:1945
translate schinese two_sisters_61c0be54:

    # a "(whispering) I can confirm zis — 'is words."
    a "（低声）我可以证明——这话属实。"

# game/script.rpy:1948
translate schinese two_sisters_35e61919:

    # li "You’re the clown whose bike Rosa stole, aren’t you?"
    li "你就是那个被罗丝偷了摩托车的小丑，对吧？"

# game/script.rpy:1950
translate schinese two_sisters_f800bed0:

    # mc "Yes."
    mc "是的。"

# game/script.rpy:1952
translate schinese two_sisters_7f562af5:

    # li "So she’s the one who leaked our location?"
    li "所以是她泄露了我们的位置？"

# game/script.rpy:1955
translate schinese two_sisters_641f5f32:

    # mc "Partly."
    mc "一部分。"

# game/script.rpy:1956
translate schinese two_sisters_531214bd:

    # li "A simple yes or no will suffice."
    li "回答是或不是就行。"

# game/script.rpy:1957
translate schinese two_sisters_f800bed0_1:

    # mc "Yes."
    mc "是的。"

# game/script.rpy:1958
translate schinese two_sisters_5e1b1184:

    # L "(whispering) You could’ve just kept your mouth shut."
    L "（低声）你本来可以闭嘴的。"

# game/script.rpy:1959
translate schinese two_sisters_7a763cc4:

    # mc "(whispering) I got you into this mess, and I don’t care if I take the hit or ruin my name. You just walk out of here safe."
    mc "（低声）是我把你拖进这摊事的，被骂或身败名裂我都无所谓。你只要平安走出去就行。"

# game/script.rpy:1961
translate schinese two_sisters_6de626e8:

    # li "Nami, your thoughts?"
    li "娜米，你怎么看？"

# game/script.rpy:1964
translate schinese two_sisters_d33e712f:

    # a "I doubt 'e is lyin'. I saw zem today at ze restaurant — ze one wiz ze horse. 'E was talkin' wiz Rosa."
    a "我不认为他在说谎。我今天在餐厅见过他——就是那个带着马的。他在跟罗丝说话。"

# game/script.rpy:1966
translate schinese two_sisters_7622f860:

    # li "I need an answer. Precise, and without a trace of doubt."
    li "我要一个答案。精确的，不带一丝犹豫。"

# game/script.rpy:1967
translate schinese two_sisters_797b9e5e:

    # a "Den, I 'ave nothing more to say."
    a "那么，我没什么可补充的了。"

# game/script.rpy:1970
translate schinese two_sisters_26489f5e:

    # ti "(What’s this feelin’ then? Me whole body's buzzin’—practically burnin'.)"
    ti "（这感觉是怎么回事？我浑身都在发麻——简直像在烧。）"

# game/script.rpy:1971
translate schinese two_sisters_5f9b356d:

    # li "Tia. Your opinion."
    li "蒂娅。你的看法。"

# game/script.rpy:1973
translate schinese two_sisters_54b6984d:

    # ti "Somethin’ tells me he ain’t lyin’. Looks proper naive, a wee fool."
    ti "有种直觉告诉俺他没在说谎。看着挺天真的，个小傻子。"

# game/script.rpy:1974
translate schinese two_sisters_4f96e1d0:

    # ti "An’ ya saw those boxes yerself, so..."
    ti "而且那些箱子是你自个儿看见的，所以……"

# game/script.rpy:1975
translate schinese two_sisters_f73c4608:

    # ti "Leave ’em be for now — if they sniff round, we’ll kick their arses later. No bother."
    ti "先放着——他们要是四处嗅探，之后再揍他们一顿就是了。小意思。"

# game/script.rpy:1977
translate schinese two_sisters_0144b626:

    # li "There’s a kernel of truth in your words."
    li "你这话里有几分道理。"

# game/script.rpy:1978
translate schinese two_sisters_2f17a2f0:

    # a "Young lady, ze reports from security — no breaches detected."
    a "年轻女士，安保那边来报——未发现任何入侵。"

# game/script.rpy:1981
translate schinese two_sisters_184a758a:

    # ti "Sis — yer big problem is ya overrate folk."
    ti "姐姐——你最大的问题就是太看得起别人了。"

# game/script.rpy:1982
translate schinese two_sisters_2c52a491:

    # ti "Not everyone here's as tactical as ye; sometimes there’s pure wildcards."
    ti "不是每个人都像你一样讲战术；有时纯粹是变数。"

# game/script.rpy:1983
translate schinese two_sisters_af3e81c8:

    # ti "They rush in with nae plan. I’m the livin’ proof o’ that."
    ti "他们没计划就冲。我就是活生生的证明。"

# game/script.rpy:1985
translate schinese two_sisters_df532d5e:

    # mc "(Well, someone’s all fired up. Guess that little serenade wasn’t a total waste.)"
    mc "（嚯，还有人上火了。看来那段小夜曲没白唱。）"

# game/script.rpy:1986
translate schinese two_sisters_29df0700:

    # L "(whispering) You’re starin’ way too obviously."
    L "（低声）你看得也太明显了。"

# game/script.rpy:1989
translate schinese two_sisters_ac831bdc:

    # a "Young lady, I believe your sister speaks true. You do analyse... too much, non?"
    a "年轻女士，我认为你姐姐说得对。你是不是……分析得太多了？"

# game/script.rpy:1990
translate schinese two_sisters_45782e3f:

    # li "Better to be prepared for everything, than to underestimate one’s enemy."
    li "做好万全准备，总好过低估敌人。"

# game/script.rpy:1991
translate schinese two_sisters_3a3a81d1:

    # mc "(Crap, she’s sharp. Come on, just buy the act, believe I’m nothing but a clown. Do us both a favor.)"
    mc "（糟了，她很敏锐……拜托，就信了吧，认定我只是个该死的小丑。帮帮我们两个吧。）"

# game/script.rpy:1992
translate schinese two_sisters_cb1563a0:

    # mc "(Time to act stupidly!)"
    mc "（该开始装蠢了！）"

# game/script.rpy:1995
translate schinese two_sisters_0336f8cb:

    # mc "Tia, right? Lovely name."
    mc "蒂娅，对吧？名字真好听。"

# game/script.rpy:1996
translate schinese two_sisters_5bfbf8c3:

    # mc "But I gotta ask — how come a lovely lady like you isn’t wearing a bra? Your nipples are kinda saying hi."
    mc "但我得问一句——像你这样的美人怎么不穿内衣？你的乳头都在打招呼了。"

# game/script.rpy:1999
translate schinese two_sisters_e66f7b73:

    # ti "Somethin’ wrong, eh? I don’t see a thing wrong with it. An’ I’m sure ye like the view yerself."
    ti "怎么，有问题吗？俺觉得哪儿都挺好。而且俺敢说你自个儿也很喜欢这风景。"

# game/script.rpy:2000
translate schinese two_sisters_320cb6c7:

    # mc "(Yeah, the body’s a masterpiece, no doubt. But the attitude… way below Isabelle’s league. That’s a fact.)"
    mc "（好吧，这身材的确杰作……但这态度……比起伊莎贝拉差太远了。这是事实。）"

# game/script.rpy:2001
translate schinese two_sisters_b641db6a:

    # mc "You got me there."
    mc "你说对了。"

# game/script.rpy:2005
translate schinese two_sisters_ec8eefba:

    # L "I’m truly sorry for this guy."
    L "我真的替这家伙感到抱歉。"

# game/script.rpy:2006
translate schinese two_sisters_94ee07f6:

    # L "I honestly have no idea what’s gotten into him tonight."
    L "我真不知道他今晚是怎么了。"

# game/script.rpy:2008
translate schinese two_sisters_b26a1f4f:

    # mc "Beer! It’s the beer, I swear… "
    mc "是酒！我发誓是酒……"

# game/script.rpy:2009
translate schinese two_sisters_42cd711a:

    # mc "I mean, I {b}hope{/b} it’s the beer."
    mc "我是说，我{b}希望{/b}是酒。"

# game/script.rpy:2011
translate schinese two_sisters_c843fd88:

    # L "Either way, we’re leaving."
    L "不管怎样，我们走了。"

# game/script.rpy:2012
translate schinese two_sisters_d133992a:

    # mc "Hey, what about the scooter? We’re not leaving without it, no matter what!"
    mc "喂，摩托车怎么办？我们无论如何都不会就这么走！"

# game/script.rpy:2014
translate schinese two_sisters_14c4f73e:

    # mc "(Whispering) Now turn around—fast—and walk away like nothing happened."
    mc "（低声）现在转过身——快——像什么都没发生一样走开。"

# game/script.rpy:2020
translate schinese two_sisters_b35d7287:

    # L "(whispering) You sure she’s buyin’ it? We’ve made big enough fools of ourselves already, and she doesn’t even flinch."
    L "（低声）你确定她会信？我们俩已经够丢脸了，她连一点反应都没有。"

# game/script.rpy:2022
translate schinese two_sisters_9ef71909:

    # mc "(whispering) Rosa said she’d be easier to handle. Dumber, even. Not seeing it."
    mc "（低声）罗丝说她更好对付。更笨。看不出来。"

# game/script.rpy:2023
translate schinese two_sisters_d2ad92c8:

    # L "(whispering) So, what now?"
    L "（低声）那现在怎么办？"

# game/script.rpy:2029
translate schinese two_sisters_968e7bc8:

    # mc "My scooter! NOOO! I’M NOT LEAVING WITHOUT IT! LET ME GO!"
    mc "我的摩托车！不——！我不会不带它就走的！放我走！"

# game/script.rpy:2031
translate schinese two_sisters_9c1eadff:

    # li "Very well. I’ll indulge you this once. Follow me."
    li "好吧。这次我纵容你。跟我来。"

# game/script.rpy:2034
translate schinese two_sisters_e44ac846:

    # li "Tell the others to tighten the perimeter. You’ll stay outside."
    li "告诉其他人收紧防线。你留在外面。"

# game/script.rpy:2035
translate schinese two_sisters_e8a26813:

    # li "I’ll handle them myself."
    li "我自己来对付他们。"

# game/script.rpy:2039
translate schinese two_sisters_0cc475f1:

    # mc "See you around, gorgeous. Next time, maybe drop me your number, yeah?"
    mc "回见，美女。下次或许给我留个号码，嗯？"

# game/script.rpy:2041
translate schinese two_sisters_6d0bef8e:

    # mc "(whispering) See? Smooth as butter."
    mc "（低声）看吧？顺滑得像黄油。"

# game/script.rpy:2042
translate schinese two_sisters_e9b45a82:

    # L "(whispering) Next time, {b}warn me{/b} before you pull crap like that."
    L "（低声）下次你再干这种事之前，先{b}警告我{/b}。"

# game/script.rpy:2043
translate schinese two_sisters_5bd5ec26:

    # mc "(whispering) Oh come on, it worked, didn’t it?"
    mc "（低声）拜托，不是管用了吗？"

# game/script.rpy:2044
translate schinese two_sisters_8159b727:

    # L "(whispering) You’re playin’ with fire. I don’t like the look in her eyes."
    L "（低声）你在玩火。我不喜欢她眼神里的东西。"

# game/script.rpy:2045
translate schinese two_sisters_4883ed04:

    # mc "(whispering) Don’t start, I’m not thrilled either."
    mc "（低声）别说了，我也不乐意。"

# game/script.rpy:2050
translate schinese two_sisters_2a3fa870:

    # ti "(This lad...)"
    ti "（这小子……）"

# game/script.rpy:2053
translate schinese two_sisters_d29b7bb5:

    # ti "(What’s happenin’ to me?! Why d’ I feel all strange after his words? Tiena, get a grip.)"
    ti "（我这是怎么了？！为什么听了他那句话就浑身不对劲？蒂娅，冷静点。）"

# game/script.rpy:2056
translate schinese two_sisters_1d71ad1b:

    # ti "(Makes me wanna shove him in the cellar, lock him up an’ make him a servant. Perfect candidate.)"
    ti "（真想把他塞进地窖锁起来，当仆人使唤。完美人选。）"

# game/script.rpy:2058
translate schinese two_sisters_837b0cf7:

    # ti "Nah — keep yer imagination to yerself. The crew comes first."
    ti "算了——你的想象留着自个儿用。团队优先。"

# game/script.rpy:2060
translate schinese two_sisters_c2eb41a0:

    # ti "(Or maybe nick him in the night? That’d be nae bother. Though his girl seems proper keen on him...)"
    ti "（或者半夜把他偷了？也不费什么事。虽然他女朋友看起来挺黏他的……）"

# game/script.rpy:2061
translate schinese two_sisters_05a133ab:

    # ti "(But he’s daft enough — shouldn’t be any trouble.)"
    ti "（不过他够蠢——应该不会有问题。）"

# game/script.rpy:2062
translate schinese two_sisters_5d280e8b:

    # n "Look at her, all red — did you actually like the clown?"
    n "瞧瞧她，脸都红了——你该不会是喜欢上那个小丑了吧？"

# game/script.rpy:2065
translate schinese two_sisters_52a23829:

    # ti "Sod off!"
    ti "滚开！"

# game/script.rpy:2071
translate schinese two_sisters_df3c9663:

    # ti "(Hold up — somethin’s off.)"
    ti "（等等——有点不对劲。）"

# game/script.rpy:2073
translate schinese two_sisters_099ff27e:

    # ti "(He looks strangely familiar.)"
    ti "（他看着莫名眼熟。）"

# game/script.rpy:2074
translate schinese two_sisters_137a344d:

    # ti "Oi — dig up everything on him, quick."
    ti "喂——把他的一切都给俺挖出来，快。"

# game/script.rpy:2078
translate schinese two_sisters_d291632e:

    # a "Very well. Anyzing specific you want me to dig up?"
    a "好的。您想让我重点挖什么？"

# game/script.rpy:2079
translate schinese two_sisters_c408a63e:

    # ti "Anything ye can find. Right now."
    ti "能找到的一切。现在就要。"

# game/script.rpy:2090
translate schinese mcxli_e8865109:

    # li "This place is our main headquarters. Every major gathering of our group happens here."
    li "这里是我们的主要据点。我们组织的每一次大型聚会都在这里举行。"

# game/script.rpy:2093
translate schinese mcxli_b6d14938:

    # L "That’s all real interestin’, but I don’t see the point. Why tell us any of this?"
    L "挺有意思的，但我看不出意义。为什么要告诉我们这些？"

# game/script.rpy:2095
translate schinese mcxli_23077858:

    # li "Who knows? Maybe I enjoyed your little stunt."
    li "谁知道呢？也许我只是欣赏你们的小把戏。"

# game/script.rpy:2096
translate schinese mcxli_688f24ae:

    # li "Or your composure under pressure. Pick whichever flatters you more."
    li "或者是你在压力下的镇定。挑一个更能让你受用的吧。"

# game/script.rpy:2097
translate schinese mcxli_42d77ba4:

    # L "You’re pretty strange, y’know that? And honestly… kinda dangerous. I don’t like the way you feel."
    L "你真的很奇怪，你知道吗？而且说实话……有点危险。我不喜欢你给我的感觉。"

# game/script.rpy:2100
translate schinese mcxli_369f56a2:

    # li "By feelings, you say? Intriguing."
    li "你说的是“感觉”？有意思。"

# game/script.rpy:2101
translate schinese mcxli_5212c598:

    # li "You’re just like Tia, then."
    li "那你和蒂娅还真像。"

# game/script.rpy:2104
translate schinese mcxli_d35eea47:

    # L "Give him back his scooter, and we’ll walk away nice and easy."
    L "把摩托车还给他，我们就客客气气地走人。"

# game/script.rpy:2106
translate schinese mcxli_3d93a9b8:

    # li "Hm..."
    li "嗯……"

# game/script.rpy:2111
translate schinese mcxli_099e4e9f:

    # li "Very well."
    li "好吧。"

# game/script.rpy:2113
translate schinese mcxli_4e817427:

    # li "Leave us alone. I need a word with him. In private."
    li "你们先走。我要和他单独谈谈。"

# game/script.rpy:2114
translate schinese mcxli_c8dcd171:

    # L "What?! {b}No way!"
    L "什么？！{b}不行！"

# game/script.rpy:2118
translate schinese mcxli_2a1e810f:

    # mc "(whispering) Len, let it go. Leave us."
    mc "（低声）莉娜，放下吧。让我们单独待会儿。"

# game/script.rpy:2120
translate schinese mcxli_5d4df335:

    # L "(whispering) And what if somethin’ happens to you?"
    L "（低声）万一你出什么事怎么办？"

# game/script.rpy:2123
translate schinese mcxli_b2336b62:

    # mc "(whispering) She’s not gonna touch me. Don’t worry — I can handle this."
    mc "（低声）她不会动我的。别担心——我能应付。"

# game/script.rpy:2126
translate schinese mcxli_483b58de:

    # L "(whispering) This isn’t a joke. She’s dangerous. Everything in me just… froze up."
    L "（低声）这不是开玩笑。她很危险。我整个人都……僵住了。"

# game/script.rpy:2127
translate schinese mcxli_ae057d9d:

    # mc "(whispering) It’s that bad, huh? Relax, it’s just some el—"
    mc "（低声）有那么严重吗？放松，不过是些精——"

# game/script.rpy:2128
translate schinese mcxli_53348092:

    # L "(whispering) Now’s not the time for jokes."
    L "（低声）现在不是开玩笑的时候。"

# game/script.rpy:2131
translate schinese mcxli_3c64fd7e:

    # L "(whispering) This reminds me of that time in the woods—"
    L "（低声）这让我想起那次在林子里——"

# game/script.rpy:2132
translate schinese mcxli_987d40a9:

    # L "(whispering) you, Isabelle, and me."
    L "（低声）你、伊莎贝拉，还有我。"

# game/script.rpy:2135
translate schinese mcxli_22cdbb49:

    # L "(whispering) This is a real shitty situation… seriously."
    L "（低声）这局面真是烂透了……说真的。"

# game/script.rpy:2136
translate schinese mcxli_2ee1c0cd:

    # mc "(whispering) C’mon, you trusted me before, right? Then trust me now."
    mc "（低声）拜托，你以前信过我，对吧？那现在也信我。"

# game/script.rpy:2139
translate schinese mcxli_3ab54207:

    # L "(whispering) Just… be as careful as you can, alright?"
    L "（低声）你就……尽可能小心，行吗？"

# game/script.rpy:2141
translate schinese mcxli_52ed3c77:

    # mc "(She’s scared... but not of {b}her{/b}. Outside, she was fine.)"
    mc "（她害怕了……但不是怕{b}她{/b}。在外面的时候她还好好的。）"

# game/script.rpy:2142
translate schinese mcxli_9a86f01f:

    # mc "(So what is it? The place?)"
    mc "（所以到底是什么？这个地方？）"

# game/script.rpy:2143
translate schinese mcxli_3fe3fbaf:

    # mc "(Yeah. Something’s off here.)"
    mc "（对。这里有点不对劲。）"

# game/script.rpy:2146
translate schinese mcxli_80bdc5a9:

    # mc "Why doesn’t a crocodile write poetry? Too many tears, not enough rhymes."
    mc "鳄鱼为什么不写诗？眼泪太多，韵脚不够。"

# game/script.rpy:2147
translate schinese mcxli_fb8e0a9e:

    # L "(whispering) You and your stupid jokes…"
    L "（低声）你那些蠢笑话……"

# game/script.rpy:2150
translate schinese mcxli_b332f0a5:

    # mc "(whispering) Who cares. They lift the mood, don’t they?"
    mc "（低声）谁在乎。不是能调节气氛吗？"

# game/script.rpy:2153
translate schinese mcxli_8f9c126e:

    # mc "(whispering) We’ll get the scooter back, then we’re gone. Promise."
    mc "（低声）我们会拿回摩托车，然后就走。保证。"

# game/script.rpy:2156
translate schinese mcxli_e43ae74d:

    # L "(whispering) Now {b}that’s{/b} an idea I can get behind."
    L "（低声）这个{b}主意{/b}我支持。"

# game/script.rpy:2158
translate schinese mcxli_0f5c8565:

    # mc "I’ll be fine. Don’t sweat it."
    mc "我没事的。别担心。"

# game/script.rpy:2162
translate schinese mcxli_01dfe8a1:

    # L "Stay in touch. If you don’t, I’ll level this whole damn place to the ground. Got it?"
    L "保持联系。你要是不联系，我就把这鬼地方夷为平地。懂吗？"

# game/script.rpy:2163
translate schinese mcxli_fe5be12c:

    # mc "Yeah, yeah."
    mc "是是是。"

# game/script.rpy:2164
translate schinese mcxli_a9bee42f:

    # L "And you, elf girl—"
    L "还有你，精灵姑娘——"

# game/script.rpy:2165
translate schinese mcxli_043f46a3:

    # L "if anything happens to him, I swear, I won’t hold back."
    L "他要是出什么事，我发誓，我绝不会手下留情。"

# game/script.rpy:2177
translate schinese mcxli_de710855:

    # li "I kept turning it over in my mind... where I’d seen you before."
    li "我一直在回想……我在哪儿见过你。"

# game/script.rpy:2179
translate schinese mcxli_724a31cc:

    # li "And that girl circling around you made it all feel... oddly familiar."
    li "而那个围着你转的女孩，让这一切都显得……莫名熟悉。"

# game/script.rpy:2181
translate schinese mcxli_7cdeb3a6:

    # li "Then it struck me. You’re the boy Isabelle used to toy with."
    li "然后我突然明白了。你就是伊莎贝拉以前玩弄的那个男孩。"

# game/script.rpy:2185
translate schinese mcxli_7ecbf236:

    # li "Everything fell into place after that. Though I’ll admit, I refused to believe it at first."
    li "这之后一切都对上了……不过我得承认，一开始我是不肯相信的。"

# game/script.rpy:2186
translate schinese mcxli_7c62d13f:

    # li "It must be... {b}difficult{/b} for Isabelle, don’t you think?"
    li "对伊莎贝拉来说一定很……{b}难受{/b}，你不觉得吗？"

# game/script.rpy:2189
translate schinese mcxli_d028e72e:

    # mc "(No point pretending anymore? Nah... too soon. She’s testing me.)"
    mc "（没必要再装了吗？不……太早了。她在试探我。）"

# game/script.rpy:2190
translate schinese mcxli_9247889b:

    # mc "(Need to see how much she really knows. Play dumb, keep it casual. Just another guy left by his girl.)"
    mc "（得看看她到底知道多少。装傻，语气随意。就当成一个被女朋友甩掉的男人。）"

# game/script.rpy:2194
translate schinese mcxli_8a748149:

    # mc "Not really. We broke up. Been a while since then."
    mc "不是。我们分手了。有一阵子了。"

# game/script.rpy:2196
translate schinese mcxli_215c0894:

    # li "Was it your idea to end things, or hers?"
    li "是你想结束的，还是她？"

# game/script.rpy:2198
translate schinese mcxli_21af864f:

    # mc "Let’s just say… I wasn’t strong enough for her. Especially after I got my “superpower.”"
    mc "姑且这么说吧……我配不上她。尤其是在我得到那个“超能力”之后。"

# game/script.rpy:2199
translate schinese mcxli_2c6c8a25:

    # mc "(Not a lie, but not the whole truth either.)"
    mc "（不算撒谎，但也算不上全部真相。）"

# game/script.rpy:2201
translate schinese mcxli_7ebc15f3:

    # li "Didn’t match her status, then?"
    li "身份配不上她？"

# game/script.rpy:2203
translate schinese mcxli_73d5ee5c:

    # mc "(She’s nibbling, but not biting. Still playing me like a cat with a toy… Gotta think fast before I trip myself up—)"
    mc "（她在小口试探，还没真咬。还在像猫耍玩具那样对付我……得快点想，别把自己说漏了——）"

# game/script.rpy:2204
translate schinese mcxli_c62c4ff5:

    # li "And?"
    li "然后呢？"

# game/script.rpy:2206
translate schinese mcxli_49e5ec88:

    # mc "Sorry, sorry— yeah, that’s pretty much it. Just... stung a bit, you know? Those feelings and all that."
    mc "抱歉抱歉——对，基本上就是这样。只是……有点刺痛，你懂的。那些感情什么的。"

# game/script.rpy:2212
translate schinese mcxli_9523003b:

    # li "Those feelings? What kind of feelings would those be?"
    li "什么感情？会是哪种感情？"

# game/script.rpy:2214
translate schinese mcxli_ac5da65f:

    # mc "(Damn it, stupid mouth— why’d I even say that?)"
    mc "（该死，这张嘴——我为什么要那么说？）"

# game/script.rpy:2215
translate schinese mcxli_39206b3c:

    # mc "Sadness… anger… mostly sadness. When I found out what my “gift” really meant."
    mc "悲伤……愤怒……主要是悲伤。当我发现我的“天赋”究竟意味着什么的时候。"

# game/script.rpy:2216
translate schinese mcxli_001fc38b:

    # mc "Though… someone like you probably wouldn’t get it."
    mc "不过……像你这样的人大概不会懂。"

# game/script.rpy:2218
translate schinese mcxli_b0c1280d:

    # li "No need to. I’ve no fondness for the weak."
    li "不需要。我对弱者没有好感。"

# game/script.rpy:2220
translate schinese mcxli_c7f0483e:

    # mc "Does that mean you hate your own people too?"
    mc "那你也讨厌自己族人吗？"

# game/script.rpy:2226
translate schinese mcxli_e4dc1c5b:

    # li "I see where you’re going with this, but very well, I’ll humour you."
    li "我知道你想干什么，不过好吧，我奉陪。"

# game/script.rpy:2234
translate schinese mcxli_5fa98d7c:

    # li "Tell me — what makes a good king... good?"
    li "告诉我——是什么让一个好国王……变好？"

# game/script.rpy:2236
translate schinese mcxli_0da68bc2:

    # li "Bloodline? Influence?"
    li "血统？人脉？"

# game/script.rpy:2237
translate schinese mcxli_e0499621:

    # li "Strength, or intellect?"
    li "实力，还是智慧？"

# game/script.rpy:2243
translate schinese mcxli_b4a356bb:

    # li "On the house."
    li "我请客。"

# game/script.rpy:2248
translate schinese mcxli_40aa08a6:

    # mc "Faith."
    mc "信念。"

# game/script.rpy:2251
translate schinese mcxli_fa9663bb:

    # li "Power rules faster than faith ever could."
    li "权力永远比信念更有说服力。"

# game/script.rpy:2253
translate schinese mcxli_934c92bc:

    # mc "Power without faith is like a sword without a sheath — Sooner or later, it cuts the one who swings it"
    mc "没有信念的权力就像没有鞘的剑——迟早会割伤挥剑的人自己。"

# game/script.rpy:2257
translate schinese mcxli_cf68fff8:

    # li "But would faith in a foolish king ever be rewarded?"
    li "但对一个蠢货国王的信念，还能得到回报吗？"

# game/script.rpy:2261
translate schinese mcxli_af12b86d:

    # mc "A foolish king with power? That’s called a tyrant. And their stories don’t usually end well."
    mc "有权力的蠢国王？那叫暴君。而他们的故事通常不会有好结局。"

# game/script.rpy:2272
translate schinese mcxli_052af1d7:

    # li "Many kings with faith you’ve seen? Tyrants are far easier to find."
    li "你见过多少“有信念的国王”？暴君可好找多了。"

# game/script.rpy:2274
translate schinese mcxli_3029f738:

    # mc "Spillin’ blood’s easy. Givin’ hope — that’s the hard part."
    mc "流血很容易。给予希望——那才难。"

# game/script.rpy:2277
translate schinese mcxli_d614fbb5:

    # li "How interesting."
    li "有意思。"

# game/script.rpy:2278
translate schinese mcxli_53eb4529:

    # li "What of intellect? It’s led many to prosperity."
    li "那智慧呢？它让很多人走向繁荣。"

# game/script.rpy:2281
translate schinese mcxli_5336d5bd:

    # mc "If he’s smart, he knows his mind alone won’t be enough."
    mc "聪明人就知道，光靠脑子不够。"

# game/script.rpy:2283
translate schinese mcxli_b6edc1b0:

    # li "Yet with both wit and power, one could achieve far more than with faith alone."
    li "然而兼有智慧与权力，能取得的成就远超过只有信念。"

# game/script.rpy:2285
translate schinese mcxli_7e6bae18:

    # mc "Maybe. But when times get tough, those same people will turn their backs."
    mc "也许吧。但到了乱世，恰恰是这批人会背弃你。"

# game/script.rpy:2297
translate schinese mcxli_8e0c6f0c:

    # li "And what sort of king leads his people into hardship?"
    li "什么样的国王会把人民带进苦难？"

# game/script.rpy:2299
translate schinese mcxli_1c5900ba:

    # mc "Sometimes it’s not the king’s fault. Shit hits from outside, and there’s not much you can do."
    mc "有时不是国王的错。麻烦来自外部，你没什么能做的。"

# game/script.rpy:2301
translate schinese mcxli_43644e07:

    # li "Would a wise king not foresee such things?"
    li "明智的国王难道不会预见这些吗？"

# game/script.rpy:2303
translate schinese mcxli_d8180caa:

    # mc "Some storms you just can’t see comin’."
    mc "有些风暴你根本看不见要来了。"

# game/script.rpy:2310
translate schinese mcxli_37cfcac9:

    # li "Would he now? Then what’s the way out?"
    li "是吗？那出路是什么？"

# game/script.rpy:2314
translate schinese mcxli_04c7770e:

    # mc "People."
    mc "人。"

# game/script.rpy:2315
translate schinese mcxli_c11d0d21:

    # mc "Not walls, not gold — the ones still standin’ when everything else falls."
    mc "不是城墙，不是黄金——而是其他一切都崩塌时依然站着的人。"

# game/script.rpy:2322
translate schinese mcxli_7b45c2db:

    # li "So... it’s loyalty you’re speaking of."
    li "所以……你说的是忠诚。"

# game/script.rpy:2324
translate schinese mcxli_8ac4140e:

    # mc "Not loyalty. Trust. Loyalty you can buy with fear or vows. Trust — you earn with what you do."
    mc "不是忠诚。是信任。忠诚可以用恐惧或誓言买到。信任——只能靠你的行动去赢得。"

# game/script.rpy:2326
translate schinese mcxli_a6c69748:

    # li "And yet, a king is surrounded by knights. Are they not his strength, his shield?"
    li "然而国王身边总围着骑士。他们难道不是他的力量、他的盾牌？"

# game/script.rpy:2328
translate schinese mcxli_01844a3a:

    # mc "Sometimes the jester who jokes with truth is more honest than the knight who swears and lies."
    mc "有时候，说真话的小丑比信誓旦旦却撒谎的骑士更诚实。"

# game/script.rpy:2332
translate schinese mcxli_a2d424fb:

    # li "Tell me..."
    li "告诉我……"

# game/script.rpy:2337
translate schinese mcxli_41a53913:

    # li "if I were to offer you a place — high above the rest, where you could look down on the world — would you stand by my side?"
    li "如果我给你一个位置——高高在上、让你能俯瞰整个世界——你愿意站在我身边吗？"

# game/script.rpy:2339
translate schinese mcxli_11455b53:

    # mc "What?"
    mc "什么？"

# game/script.rpy:2340
translate schinese mcxli_61cde1f0:

    # mc "(She’s inviting me up? No, [mc], don’t bite. There’s a catch in that tone… she’s hiding something.)"
    mc "（她在拉我上去？不行，[mc]，别上钩。那语气里有陷阱……她在藏什么。）"

# game/script.rpy:2341
translate schinese mcxli_addb452f:

    # mc "(Loneliness? Fear? Maybe she’s scared of being betrayed. Family stuff? Yeah… smells like family shit.)"
    mc "（孤独？恐惧？也许她害怕被背叛。家里的事？对……闻起来就是家族那套破事。）"

# game/script.rpy:2342
translate schinese mcxli_b5de5ce5:

    # mc "(Trap question. Her rep means everything — say yes, I drag her down. Say no, I bruise her ego.)"
    mc "（陷阱题。她的名声就是一切——说“好”，我会被她拖下水；说“不”，她的自尊会受伤。）"

# game/script.rpy:2343
translate schinese mcxli_bbb853de:

    # mc "(Best answer? None at all.)"
    mc "（最好的回答？根本别回答。）"

# game/script.rpy:2344
translate schinese mcxli_2b35b6fe:

    # mc "..."
    mc "……"

# game/script.rpy:2347
translate schinese mcxli_16d5525d:

    # li "Bingo."
    li "答对了。"

# game/script.rpy:2349
translate schinese mcxli_9e717813:

    # li "..."
    li "……"

# game/script.rpy:2355
translate schinese mcxli_0f063447:

    # li "You know... I’m starting to see what Isabelle found in you."
    li "你知道吗……我开始明白伊莎贝拉在你身上看到了什么。"

# game/script.rpy:2357
translate schinese mcxli_684b05ba:

    # mc "Don’t know what you’re talkin’ about. I’m just a clown — dumb, weak, painfully average."
    mc "不知道你在说什么。我只是个小丑——蠢、弱、平凡得让人难受。"

# game/script.rpy:2359
translate schinese mcxli_e9841039:

    # li "You possess something I haven’t seen in others."
    li "你身上有我从未在别人身上见过的东西。"

# game/script.rpy:2363
translate schinese mcxli_b2a9e809:

    # mc "What, my bad jokes? My irresistible charm?"
    mc "什么，我那些烂梗？我无法抵挡的魅力？"

# game/script.rpy:2367
translate schinese mcxli_b7f77471:

    # li "You’re dangerous. Far more than I expected."
    li "你很危险。比我预想的还要危险得多。"

# game/script.rpy:2368
translate schinese mcxli_2f1575a9:

    # li "If I let you live, I’d be making the greatest mistake of my life."
    li "如果我让你活着，那会是我一生中最大的错误。"

# game/script.rpy:2370
translate schinese mcxli_c2a03c92:

    # mc "Hey, forgot the blue-haired girl waitin’ outside? Her patience burns faster than jet fuel."
    mc "喂，忘了外面那个蓝发姑娘还在等着吗？她的耐心烧得比喷气燃料还快。"

# game/script.rpy:2373
translate schinese mcxli_3bc2b73e:

    # li "That won’t help you. You’ll reach the afterlife long before she reaches this door, [mc]."
    li "那救不了你。比起她走到这扇门前，你会更早去见死神，[mc]。"

# game/script.rpy:2374
translate schinese mcxli_eb4cf3c7:

    # mc "(Yeah… she knew everything from the start.)"
    mc "（是啊……她从一开始就什么都知道。）"

# game/script.rpy:2376
translate schinese mcxli_fe3745b7:

    # mc "How about we go back to a nice calm talk, huh? I tell a few jokes, you laugh, we all go home happy."
    mc "我们回到刚才那样平静地聊天，好吗？我讲几个笑话，你笑一笑，大家开开心心回家。"

# game/script.rpy:2379
translate schinese mcxli_e94a561f:

    # li "One last warning."
    li "最后警告一次。"

# game/script.rpy:2381
translate schinese mcxli_15c5f2b3:

    # li "With the second strike, your head will part from your shoulders. So choose your words carefully."
    li "第二下，你的头就会和肩膀分家。所以好好斟酌你的话。"

# game/script.rpy:2384
translate schinese mcxli_8a663c5d:

    # mc "(Yeah… she ain’t joking. But what the hell is she really after—)"
    mc "（是啊……她没开玩笑。可她到底图什么——）"

# game/script.rpy:2385
translate schinese mcxli_abfd66da:

    # mc "(Isabelle… damn, how did I not see that coming?)"
    mc "（伊莎贝拉……该死，我怎么会没想到？）"

# game/script.rpy:2387
translate schinese mcxli_685b29ca:

    # mc "So… what does the eldest daughter of House {b}Dellaymen{/b} want from me?"
    mc "那么……{b}德拉伊姆{/b}家的长女想从我这儿得到什么？"

# game/script.rpy:2389
translate schinese mcxli_6acc6993:

    # li "Revenge."
    li "复仇。"

# game/script.rpy:2391
translate schinese mcxli_e6b56dbc:

    # mc "(Revenge? For who — Isabelle? Her old man? Or the whole damn family tree?)"
    mc "（复仇？为了谁——伊莎贝拉？她老爹？还是整个该死的家族树？）"

# game/script.rpy:2392
translate schinese mcxli_46f29ed9:

    # mc "(Doesn’t matter. I just need to get the hell outta here… whatever it takes.)"
    mc "（无所谓。我只要他妈的离开这儿……不择手段。）"

# game/script.rpy:2394
translate schinese mcxli_1315dd06:

    # mc "I’m just a clown, remember? No power, no pull, no respect."
    mc "我只是个小丑，记得吗？没权力、没人脉、没尊严。"

# game/script.rpy:2396
translate schinese mcxli_991afcc0:

    # li "You’re closer to their family than anyone. Even if you’re no longer her lover — you still share memories."
    li "你和他们家族比任何人都更亲近。就算你不再是她的恋人——你们仍共享着回忆。"

# game/script.rpy:2398
translate schinese mcxli_d750ea3e:

    # mc "You’re givin’ me too much credit. Isabelle’s long forgotten me. Only thing still between us is that scooter — which, by the way, you’re holding hostage."
    mc "你太高估我了。伊莎贝拉早把我忘了。我们之间只剩那辆摩托车——顺便说，你正扣着它当人质。"

# game/script.rpy:2399
translate schinese mcxli_775622e8:

    # mc "You know what? Forget the scooter. Guess it’s time to start fresh — clean slate, no brakes."
    mc "你知道吗？摩托车算了。看来是时候重新开始了——一片空白，全速前进。"

# game/script.rpy:2401
translate schinese mcxli_b99bd619:

    # mc "(Alright… on three, I’m outta here. One…)"
    mc "（好……三、二、一我就走。一……）"

# game/script.rpy:2404
translate schinese mcxli_f366753a:

    # mc "RUN!"
    mc "跑！"

# game/script.rpy:2409
translate schinese mcxli_9c83c81b:

    # li "You won’t get out that easily."
    li "你没那么容易脱身。"

# game/script.rpy:2411
translate schinese mcxli_76f7a20a:

    # mc "(Run. Don’t look back. One second too slow and she’s slicing my damn head off!)"
    mc "（跑。别回头。慢一秒她的刀就砍下来了！）"

# game/script.rpy:2423
translate schinese mcxli_53c5389a:

    # mc "(Think, think, THINK! She’s faster, smarter, sharper — and cautious as hell. Great.)"
    mc "（想，快想！——她更快、更聪明、更锋利——而且谨慎得要命。好极了。）"

# game/script.rpy:2426
translate schinese mcxli_d43705ad:

    # mc "(Cheap tricks won’t work on her… I need something smarter. Stall her till Lena shows up? Yeah. That could work.)"
    mc "（小把戏对她没用……我需要更聪明的。拖住她直到莉娜赶到？对，这行得通。）"

# game/script.rpy:2427
translate schinese mcxli_f671f072:

    # mc "(Till then, priority one — stay alive.)"
    mc "（在那之前，第一要务——活下来。）"

# game/script.rpy:2432
translate schinese mcxli_8c6d013c:

    # mc "(She just changed her stance— no, screw it, what’s the point—)"
    mc "（她刚换了架势——算了，管它的，反正——）"

# game/script.rpy:2435
translate schinese mcxli_86674911:

    # mc "Time out! Time out! Let’s… negotiate, yeah? We go over your plan again and maybe— just maybe— come up with a better one."
    mc "暂停！暂停！我们……谈判吧，好吗？把你的计划再过一遍，也许——只是也许——能想出个更好的。"

# game/script.rpy:2437
translate schinese mcxli_9cce8e98:

    # mc "No blades, no drama, just you and me — sound fair?"
    mc "不动刀，不要花样，就你和我——这公平吧？"

# game/script.rpy:2438
translate schinese mcxli_039af097:

    # li "(His reflexes are slowing...)"
    li "（他的反应在变慢……）"

# game/script.rpy:2442
translate schinese mcxli_3b3968a3:

    # li "You had your chance. You wasted it."
    li "机会给过你了。你浪费了。"

# game/script.rpy:2443
translate schinese mcxli_47528240:

    # mc "C’mon, you saw me! I thought you were kidding!"
    mc "拜托，你看到我了吧！我以为你在开玩笑！"

# game/script.rpy:2444
translate schinese mcxli_0a3d62a0:

    # li "You understood me perfectly the first time."
    li "第一次你就完全懂了。"

# game/script.rpy:2445
translate schinese mcxli_1d0a40ca:

    # li "(Why am I even wasting my time on him?)"
    li "（我到底为什么要在他身上浪费时间？）"

# game/script.rpy:2448
translate schinese mcxli_a86e137e:

    # mc "(Damn it… should’ve kept playing the fool. But no, had to act smart, right?)"
    mc "（该死……我本该继续装傻的。可不，非要耍聪明，是吧？）"

# game/script.rpy:2449
translate schinese mcxli_922fd3cc:

    # mc "(Needed to prove you’re {b}more{/b} than a joke? Well, congrats, genius — look at you now.)"
    mc "（想证明你{b}不只是{/b}个笑话？恭喜你，天才——看看你现在。）"

# game/script.rpy:2455
translate schinese mcxli_47ced302:

    # mc "(No. No panic. You’ve been in worse.)"
    mc "（不。别慌。你经历过更糟的。）"

# game/script.rpy:2456
translate schinese mcxli_945618c7:

    # mc "(Focus. Use the room. Play off your surroundings.”)"
    mc "（专注。利用这个房间。借助周围环境。）"

# game/script.rpy:2458
translate schinese mcxli_d1cf00da:

    # mc "(Easier said than done.)"
    mc "（说起来容易做起来难。）"

# game/script.rpy:2459
translate schinese mcxli_faa2e3d0:

    # mc "(Anything… anything to throw her off tempo—)"
    mc "（什么都行……任何能打乱她节奏的东西——）"

# game/script.rpy:2461
translate schinese mcxli_c0337f0d:

    # mc "(Well, would you look at that — a perfect candidate to test my luck.)"
    mc "（哟，瞧瞧这个——一个完美的试运气对象。）"

# game/script.rpy:2462
translate schinese mcxli_c9403cc4:

    # mc "(Now if I could just switch it wi—)"
    mc "（要是我能把它换——）"

# game/script.rpy:2469
translate schinese mcxli_a5c605f3:

    # mc "You almost killed me! Ever heard of self-control, psycho? What about your damn rating, huh"
    mc "你差点杀了我！听说过自控力吗，疯子？你的评分呢，嗯？"

# game/script.rpy:2470
translate schinese mcxli_14e377fd:

    # mc "What about leaving me for the sequel — so I could get stronger, come back for revenge?!"
    mc "把我留给第二部怎么样——这样我能变强，再回来复仇？！"

# game/script.rpy:2471
translate schinese mcxli_90fad0da:

    # mc "You seriously never watched an anime?"
    mc "你该不会真没看过动漫吧？"

# game/script.rpy:2475
translate schinese mcxli_2859cda6:

    # mc "(God, that hurts. Really hurts.)"
    mc "（天啊，疼死了。真疼。）"

# game/script.rpy:2476
translate schinese mcxli_33094b2e:

    # mc "(But now I’m sure — she’s keeping me alive {b}on purpose.)"
    mc "（但我现在确定了——她是{b}故意{/b}留着我活。）"

# game/script.rpy:2479
translate schinese mcxli_6e0b0c89:

    # li "Credit where it’s due — you run well."
    li "该夸的还是要夸——你跑得不错。"

# game/script.rpy:2480
translate schinese mcxli_054cf179:

    # li "Impressive physical conditioning, remarkable intellect — all that, and not a shred of power to show for it."
    li "出色的体能，过人的智慧——这些全都有，却一点实力都拿不出来。"

# game/script.rpy:2481
translate schinese mcxli_4b3a8e12:

    # li "In a way, it’s... rather admirable."
    li "说实话……某种意义上，挺令人钦佩的。"

# game/script.rpy:2483
translate schinese mcxli_db389107:

    # mc "(So what’s the deal… waiting for Lena? Or—)"
    mc "（所以到底怎么回事……在等莉娜？还是——）"

# game/script.rpy:2484
translate schinese mcxli_a6725049:

    # mc "You had plenty of chances to kill me. But you always stop halfway."
    mc "你有很多次杀我的机会。可你每次都停在一半。"

# game/script.rpy:2485
translate schinese mcxli_2876efd9:

    # mc "Why?"
    mc "为什么？"

# game/script.rpy:2487
translate schinese mcxli_5cb9b470:

    # li "Out of curiosity."
    li "出于好奇。"

# game/script.rpy:2489
translate schinese mcxli_59e81c95:

    # mc "(Great. I’m a zoo exhibit now. Monkey with good reflexes.)"
    mc "（好极了。我现在成了动物园展品。一只反射神经不错的猴子。）"

# game/script.rpy:2490
translate schinese mcxli_6195841e:

    # mc "(I mean— could be worse, but a little respect wouldn’t kill her.)"
    mc "（不过——也就这样了，但给她一点尊重也不至于死。）"

# game/script.rpy:2492
translate schinese mcxli_26e4e1fb:

    # mc "So? Did I live up to the hype?"
    mc "所以？我配得上那些吹捧吗？"

# game/script.rpy:2494
translate schinese mcxli_8e19261c:

    # li "Almost. I’ll admit, I did have a bit of fun. But that’s where it ends."
    li "差不多吧。我承认，确实有点乐趣。但到此为止。"

# game/script.rpy:2495
translate schinese mcxli_470cc2f8:

    # mc "(Kill me? Let me go? Lena, where the hell are you—)"
    mc "（杀我？放我走？莉娜，你到底在哪儿——）"

# game/script.rpy:2497
translate schinese mcxli_d51b1e22:

    # mc "(Screw it. All in.)"
    mc "（管他的。全押了。）"

# game/script.rpy:2498
translate schinese mcxli_574532c7:

    # mc "(Just a little closer… come on, come on…)"
    mc "（就差一点……快点，快点……）"

# game/script.rpy:2500
translate schinese mcxli_e958eb19:

    # li "Let me guess — trying to lure me closer so you can drop that bag?"
    li "让我猜猜——是想把我引近一点，好让你扔下那个包？"

# game/script.rpy:2501
translate schinese mcxli_623bb3d2:

    # li "And then what? Stall for time until your little friend shows up?"
    li "然后呢？拖时间等你那个小伙伴赶到？"

# game/script.rpy:2504
translate schinese mcxli_347c7133:

    # li "Or make another pitiful attempt to run?"
    li "还是再可怜巴巴地尝试逃跑？"

# game/script.rpy:2505
translate schinese mcxli_a80a8c2a:

    # mc "Too predictable, huh? Maybe. But for anyone else — it would’ve worked like a charm."
    mc "太容易被看穿了吧？也许吧。但换成别人——这招肯定百试百灵。"

# game/script.rpy:2507
translate schinese mcxli_ae14e122:

    # li "Had those {b}others{/b} been even slightly more cautious, your little tricks wouldn’t have worked on them either."
    li "要是那些{b}别人{/b}再谨慎一点，你这些小把戏也一样不管用。"

# game/script.rpy:2508
translate schinese mcxli_906d7070:

    # mc "(Hate to admit it… but she sees right through me.)"
    mc "（不想承认……但她把我看得透透的。）"

# game/script.rpy:2511
translate schinese mcxli_7abb7961:

    # mc "You should be honored, by the way. Only the third person ever to figure out my tricks."
    mc "顺便说，你该感到荣幸。你是第三个识破我招数的人。"

# game/script.rpy:2512
translate schinese mcxli_c6558bcf:

    # li "Not the second? Someone else besides Isabelle?"
    li "不是第二个？除了伊莎贝拉还有别人？"

# game/script.rpy:2513
translate schinese mcxli_40317bc9:

    # mc "(Now!)"
    mc "（就是现在！）"

# game/script.rpy:2516
translate schinese mcxli_370b895f:

    # mc "(whisper) Technique Nine — Fool’s Command."
    mc "（低声）技巧九号——愚者指令。"

# game/script.rpy:2525
translate schinese mcxli_ca9ac07d:

    # li "(Foolish. Naïve. Predictable... and yet — for the first time in a while, I’m actually enjoying myself.)"
    li "（愚蠢。天真。可预测……然而——我却是这么久以来头一次真的乐在其中。）"

# game/script.rpy:2528
translate schinese mcxli_47d0792b:

    # li "(I wonder... if I let him live, will he become something greater?)"
    li "（我在想……如果我放他一条生路，他会不会变成更了不起的存在？）"

# game/script.rpy:2529
translate schinese mcxli_e11153d1:

    # li "(And am I truly willing to risk everything — just to find out?)"
    li "（而我真的愿意赌上一切——只为知道答案吗？）"

# game/script.rpy:2542
translate schinese two_sisters_part1_end_fbb76823:

    # "15 minutes earlier."
    "15分钟前。"

# game/script.rpy:2545
translate schinese two_sisters_part1_end_15a002af:

    # ti "(Well, would ya look at that — five minutes ago this place was louder than a club, an’ the moment my sister slips away…)"
    ti "（嚯，瞧瞧——五分钟前这地方还吵得像夜店，我姐一走开……）"

# game/script.rpy:2550
translate schinese two_sisters_part1_end_9f803cbe:

    # ti "(…an’ then — quiet as the grave. Dead silence. Christ, it’s pissin’ me off!)"
    ti "（……然后——安静得像坟墓。死一般的寂静。该死，气死我了！）"

# game/script.rpy:2552
translate schinese two_sisters_part1_end_9a5d6e99:

    # a "What you are zinking about, Lady Tia?"
    a "蒂娅小姐，您在想什么呢？"

# game/script.rpy:2555
translate schinese two_sisters_part1_end_4a4e5cf7:

    # ti "Ah, right — forgot ye were still breathin’. So, dig up anythin’ on that lad yet?"
    ti "啊，对——忘了你还在喘气呢。那，查到那小子的什么了吗？"

# game/script.rpy:2558
translate schinese two_sisters_part1_end_ee1c97ae:

    # L "I wouldn’t recommend that. We don’t know who you are, and you don’t know who we are."
    L "我不建议这么做。我们不知道你是谁，你也不知道我们是谁。"

# game/script.rpy:2561
translate schinese two_sisters_part1_end_d4e23b88:

    # L "My friend and I came here to take back what’s ours. Quietly, no trouble. That’s all."
    L "我和朋友来这儿，只是安安静静地拿回属于我们的东西。不惹事。就这样。"

# game/script.rpy:2567
translate schinese two_sisters_part1_end_5d36d7d9:

    # ti "(Maybe I should whoop her arse outta pure boredom? Nah — promised Lia I’d keep me hands in check.)"
    ti "（俺是不是该纯粹因为无聊就揍她一顿？算了——答应过莉娅要克制。）"

# game/script.rpy:2568
translate schinese two_sisters_part1_end_8c9ee12f:

    # ti "(But she never said anythin’ ’bout threats, did she? Right? Right)"
    ti "（但她可没说不能威胁人，对吧？对吧？）"

# game/script.rpy:2573
translate schinese two_sisters_part1_end_1e4a5453:

    # a "S’il vous plaît, Lady Tia… no stupid games, oui?"
    a "拜托了，蒂娅小姐……别耍小把戏，好吗？"

# game/script.rpy:2576
translate schinese two_sisters_part1_end_1b51bd5b:

    # L "So, you’re Tia? Who the hell are you people anyway?"
    L "所以你就是蒂娅？你们到底是什么人？"

# game/script.rpy:2578
translate schinese two_sisters_part1_end_5e7d1256:

    # ti "Oh no — if ye plan on havin’ small talk with me, I’ll gut ya."
    ti "哦不——你要是打算跟俺寒暄，俺就把你开膛破肚。"

# game/script.rpy:2581
translate schinese two_sisters_part1_end_22b99aae:

    # L "And if I don’t find someone to talk to right now, I’ll level this whole damn place to the ground."
    L "而我要是我现在找不到人说话，我就把这鬼地方夷为平地。"

# game/script.rpy:2590
translate schinese two_sisters_part1_end_ead43073:

    # ti "Oho! What a temper! Come on, show me what ye can do—"
    ti "哦吼！好大的脾气！来，让我看看你有什么本事——"

# game/script.rpy:2592
translate schinese two_sisters_part1_end_a78f4ee0:

    # a "Do not let your emotions run ze show. Zey make a mess of everyzing."
    a "别让情绪主导一切。它们会把一切都搅乱。"

# game/script.rpy:2594
translate schinese two_sisters_part1_end_74eaa67f:

    # ti "There ya go, knack for spoilin’ the mood, aren’t ya."
    ti "就是嘛，你天生就会毁气氛，对不对。"

# game/script.rpy:2596
translate schinese two_sisters_part1_end_c3e0d637:

    # a "I am only followin’ your papa’s orders, rien de plus."
    a "我只是遵照令尊的吩咐，仅此而已。"

# game/script.rpy:2598
translate schinese two_sisters_part1_end_440e1cd5:

    # ti "Watchin’ me for yer sister now? Ha — of course. Forgot that little detail."
    ti "现在替姐姐监视我了？哈——当然了。忘了这茬。"

# game/script.rpy:2599
translate schinese two_sisters_part1_end_2f81b57e:

    # ti "Can’t find fault in the rose, so ya complain ’bout the thorns… Daddy-style."
    ti "挑不出玫瑰的错，就抱怨花刺……真是爸爸风格。"

# game/script.rpy:2600
translate schinese two_sisters_part1_end_572a6f8b:

    # ti "Alright, blue-haired lass — ye wanted society chat? Spill it. What’s the topic?"
    ti "好吧，蓝发姑娘——你想聊天？说吧。聊什么？"

# game/script.rpy:2602
translate schinese two_sisters_part1_end_87ad391e:

    # L "Quick switch, huh—"
    L "说变就变，是吧——"

# game/script.rpy:2605
translate schinese two_sisters_part1_end_1d05b192:

    # ti "I GOT IT!!"
    ti "我知道了！！"

# game/script.rpy:2607
translate schinese two_sisters_part1_end_5e5723bc:

    # ti "Tell me ’bout that lad yerself. I promise — we won’t be diggin’ into his file."
    ti "你自己跟俺说说那小子的事。我保证——俺们不会去挖他的档案。"

# game/script.rpy:2609
translate schinese two_sisters_part1_end_da7f9740:

    # L "(Easy, Lena, easy... Trust him. He’s fine. Just deal with this nosy freak for now.)"
    L "（冷静点，莉娜，冷静……相信他。他没问题。先应付这个爱打听的怪人。）"

# game/script.rpy:2611
translate schinese two_sisters_part1_end_9ee98860:

    # L "I’ve got a condi—"
    L "我有个条件——"

# game/script.rpy:2622
translate schinese two_sisters_part1_end_8d2bfefb:

    # ti "Blah, blah, blah."
    ti "巴拉巴拉巴拉。"

# game/script.rpy:2625
translate schinese two_sisters_part1_end_621ce2af:

    # ti "Only ’bout that lad. The rest don’t concern me. Am I makin’ meself clear?"
    ti "只说那小子。别的跟俺无关。说清楚了吗？"

# game/script.rpy:2627
translate schinese two_sisters_part1_end_1f30f40b:

    # L "(Stay calm, Lena... stay calm. Remember all that student council training...)"
    L "（冷静，莉娜……冷静。想想学生会的那些训练……）"

# game/script.rpy:2629
translate schinese two_sisters_part1_end_9452bee5:

    # L "I—"
    L "我——"

# game/script.rpy:2632
translate schinese two_sisters_part1_end_ad71bff2:

    # ti "No — no."
    ti "不——不。"

# game/script.rpy:2634
translate schinese two_sisters_part1_end_3dda010a:

    # ti "Say after me: ‘Yes, Lady Tienara, I understand you.’"
    ti "跟着我说：“是的，蒂娅小姐，我明白您的意思。”"

# game/script.rpy:2636
translate schinese two_sisters_part1_end_291af4f8:

    # L "(Don’t lose it, Lena. Keep it together.)"
    L "（别失控，莉娜。撑住。）"

# game/script.rpy:2638
translate schinese two_sisters_part1_end_dbc4aeaa:

    # L "(Guess I’ve got no choice... Gonna have to apologize.)"
    L "（看来我没得选……只能道歉了。）"

# game/script.rpy:2643
translate schinese two_sisters_part1_end_6ff17050:

    # L "Screw you."
    L "去你的。"

# game/script.rpy:2645
translate schinese two_sisters_part1_end_8349c179:

    # L "(...Ah, screw it. I’ll deal with these two and go find him myself.)"
    L "（……啊，算了。我先搞定这俩，然后自己去找他。）"

# game/script.rpy:2647
translate schinese two_sisters_part1_end_e74c7fec:

    # ti "(Ha… finally showed some teeth.)"
    ti "（哈……总算露出点牙了。）"

# game/script.rpy:2650
translate schinese two_sisters_part1_end_02987a9b:

    # ti "Brilliant. Just brilliant. Only — since when did ye get cheeky, eh?"
    ti "精彩。太精彩了。只是——你什么时候变得这么嘴贱了，嗯？"

# game/script.rpy:2651
translate schinese two_sisters_part1_end_14f298ff:

    # L "Answer me first — who the hell do you think you are? Like I’d tell you {b}anything{/b} about [mc]."
    L "先回答我——你以为你是谁？我凭什么把[mc]的事告诉你{b}任何{/b}一句。"

# game/script.rpy:2653
translate schinese two_sisters_part1_end_f6c297e0:

    # mc "LENA! WE’RE OUTTA HERE!"
    mc "莉娜！我们在外面！"

# game/script.rpy:2654
translate schinese two_sisters_part1_end_c5ef4c66:

    # L "(That voice—!)"
    L "（那个声音——！）"

# game/script.rpy:2657
translate schinese two_sisters_part1_end_fde57b2b:

    # L "Wha—? What?!"
    L "什——？什么？！"

# game/script.rpy:2658
translate schinese two_sisters_part1_end_529dcb59:

    # mc "I’ll explain later — just don’t freak out, and whatever you do, don’t use your damn power!"
    mc "我待会儿解释——别慌，还有，无论如何别用你那该死的能力！"

# game/script.rpy:2660
translate schinese two_sisters_part1_end_e64ab87e:

    # mc "Now run — like hell!"
    mc "现在给我拼命跑！"

# game/script.rpy:2663
translate schinese two_sisters_part1_end_23a4b1cb:

    # ti "(They’ve scarpered… pity. I liked the blue-haired lass’s aggression.)"
    ti "（他们跑了……真可惜。我挺喜欢那蓝发姑娘的劲头。）"

# game/script.rpy:2664
translate schinese two_sisters_part1_end_30510d5b:

    # ti "(Hold up — that clown, he’s all cut up?!)"
    ti "（等等——那小丑，他浑身是伤？！）"

# game/script.rpy:2667
translate schinese two_sisters_part1_end_1b27c6c7:

    # ti "Sister — I’ll tear yer arse up right now. You been messin’ with that clown?! HE’S MY PREY!"
    ti "姐姐——俺现在就把你揍烂。你老缠着那个小丑？！他是俺的猎物！"

# game/script.rpy:2668
translate schinese two_sisters_part1_end_441fb0c0:

    # li "For now, yes. But that will change soon enough."
    li "暂时是这样。但很快就会变。"

# game/script.rpy:2669
translate schinese two_sisters_part1_end_d0a4d916:

    # ti "Oh no, no, no — that tone again. Whatcha plannin’ this time?"
    ti "哦不不不——又是这个语气。这次你打算干什么？"

# game/script.rpy:2670
translate schinese two_sisters_part1_end_7a00b4d8:

    # ti "An’ don’t say ye forgot — we swore: toys aren’t for sharin’."
    ti "别说你忘了——俺们发过誓：玩具不共享。"

# game/script.rpy:2671
translate schinese two_sisters_part1_end_dcfb2d28:

    # li "I remember."
    li "我记得。"

# game/script.rpy:2673
translate schinese two_sisters_part1_end_1eb6e132:

    # ti "You’ll do what ye please anyway, so what’s the point me naggin’."
    ti "反正你想怎样就怎样，我唠叨还有什么意义。"

# game/script.rpy:2674
translate schinese two_sisters_part1_end_ac58cefc:

    # ti "But seriously — why’d ya let him go? Not outta pity, I hope."
    ti "但说真的——你为什么放他走？不会是出于同情吧。"

# game/script.rpy:2677
translate schinese two_sisters_part1_end_f87c8681:

    # li "Who knows."
    li "谁知道。"

# game/script.rpy:2678
translate schinese two_sisters_part1_end_2581652f:

    # ti "What? Who the hell are ya, an’ what did ya do with my sister?!"
    ti "什么？你到底是谁，你对我姐姐做了什么？！"

# game/script.rpy:2682
translate schinese two_sisters_part1_end_bed16d7b:

    # li "Nami — he’s your mark. Not a kill. Surveillance only. Understood?"
    li "娜米——他是你的目标。不是要杀。只是监视。明白了吗？"

# game/script.rpy:2684
translate schinese two_sisters_part1_end_bb8e4b4e:

    # a "..."
    a "……"

# game/script.rpy:2691
translate schinese rose_next_44870e4c:

    # a "Yes, Lady Lia."
    a "是，莉娅小姐。"

# game/script.rpy:2696
translate schinese rose_next_21cee924:

    # n "G’day, how can I help ya?"
    n "您好，有什么可以帮您？"

# game/script.rpy:2697
translate schinese rose_next_1172564d:

    # r "I’m here to see Amira Klein."
    r "我来看阿米拉·克莱因。"

# game/script.rpy:2698
translate schinese rose_next_6f00cf82:

    # n "Ah, you must be her guardian. She’s in the middle of some procedures at the moment — her condition’s taken a turn for the worse."
    n "啊，您一定是她的家属。她现在正在接受一些治疗——她的情况恶化了。"

# game/script.rpy:2700
translate schinese rose_next_0c5e8ccd:

    # r "What?! You gotta be—"
    r "什么？！你一定是在——"

# game/script.rpy:2702
translate schinese rose_next_429a967d:

    # r "...Sorry. I get it. How long do I wait?"
    r "……抱歉。我明白了。我要等多久？"

# game/script.rpy:2703
translate schinese rose_next_850d35ba:

    # n "Uh… yeah, about thirty minutes. I can show you the way—"
    n "呃……大概三十分钟。我可以带您过去——"

# game/script.rpy:2704
translate schinese rose_next_2238170c:

    # r "Thanks, but I know the road."
    r "谢了，但路我认得。"

# game/script.rpy:2716
translate schinese rose_next_cd621c5b:

    # r "Tch…"
    r "啧……"

# game/script.rpy:2718
translate schinese rose_next_085c3bb8:

    # r "(Outside, I look sad... but inside it’s just empty.)"
    r "（在外面，我看起来很难过……但里面只有一片空洞。）"

# game/script.rpy:2719
translate schinese rose_next_b0c295fd:

    # r "(Are these the feelings you kept talkin’ about, Mom?)"
    r "（这就是你一直在说的那种感情吗，妈？）"

# game/script.rpy:2720
translate schinese rose_next_a0df39c4:

    # r "(Please… get better soon. I really miss you.)"
    r "（求你了……快点好起来。我真的很想你。）"

# game/script.rpy:2723
translate schinese rose_next_638d6422:

    # r "Hm?"
    r "嗯？"

# game/script.rpy:2724
translate schinese rose_next_58dc4103:

    # r "(Who the hell’s callin’ at this hour?)"
    r "（这个点谁他妈打电话来？）"

# game/script.rpy:2726
translate schinese rose_next_075688aa:

    # r "(Ah… the damn clown)"
    r "（啊……那个该死的小丑）"

# game/script.rpy:2730
translate schinese rose_next_433699a5:

    # r "Yeah, this is Rose speaking."
    r "喂，我是罗丝。"

# game/script.rpy:2732
translate schinese rose_next_482475db:

    # mc "At the phone? What are you, my great-grandma? Didn’t think anyone still said that."
    mc "打电话？你是我曾祖母吗？没想到还有人这么说。"

# game/script.rpy:2734
translate schinese rose_next_2c6317e4:

    # r "Save the showboatin’ for later, I’m not in the mood."
    r "吹牛留到以后，我现在没心情。"

# game/script.rpy:2736
translate schinese rose_next_a108fa88:

    # mc "Then I’ll just call you ba—"
    mc "那我就再打给——"

# game/script.rpy:2738
translate schinese rose_next_94e30e4b:

    # r "No, don’t bother. I just— ugh, skip it. Did it work?"
    r "不，别打了。我就——唉，算了。有用吗？"

# game/script.rpy:2740
translate schinese rose_next_8431bc9c:

    # mc "About that… just, uh— don’t get mad, okay?"
    mc "关于那个……呃，先说好——别生气，行吗？"

# game/script.rpy:2742
translate schinese rose_next_5e16b060:

    # r "Let me guess — you blew it?"
    r "我猜——你搞砸了？"

# game/script.rpy:2744
translate schinese rose_next_d492cf7b:

    # mc "Yeah. Totally misjudged that elf chick — that one’s on me, I’ll admit it."
    mc "对。完全低估了那个精灵丫头——这我认。"

# game/script.rpy:2746
translate schinese rose_next_0c10314d:

    # r "Didn’t expect any different. So, we even now?"
    r "也没指望别的。那我们两清了？"

# game/script.rpy:2748
translate schinese rose_next_0ce55c5c:

    # mc "Well… there’s this tiny little nuances."
    mc "嗯……不过有那么一丁点出入。"

# game/script.rpy:2750
translate schinese rose_next_a6fc7c17:

    # r "No damn ‘nuances.’ I gave you the lead, you got your info — that means you owe me."
    r "没有狗屁“出入”。我给你指了路，你拿到了情报——这就意味着你欠我。"

# game/script.rpy:2753
translate schinese rose_next_0acbd68f:

    # mc "They know it was you who gave me the info."
    mc "他们知道是我给你指的路。"

# game/script.rpy:2755
translate schinese rose_next_530247e5:

    # r "They what?! You’re kiddin’ me, clown?! We had a deal—"
    r "什么？！你开什么玩笑，小丑？！我们可是有约定的——"

# game/script.rpy:2758
translate schinese rose_next_466c26c9:

    # mc "At that café — yeah, the one where we were chuggin’ beer? One of their people saw us."
    mc "在那家咖啡馆——对，就是我们灌啤酒的那家？他们的人看见我们了。"

# game/script.rpy:2759
translate schinese rose_next_3ccbdec7:

    # mc "So now... guess that makes us a team. Kinda."
    mc "所以现在……看来我们算一队了。差不多吧。"

# game/script.rpy:2760
translate schinese rose_next_1dc1570e:

    # r "(Just when I thought it couldn’t get worse — ta-dam.)"
    r "（正当我觉得还能更糟的时候——啪。）"

# game/script.rpy:2763
translate schinese rose_next_d1603921:

    # n "You’re Rose Klein, right? Mind sparing a minute?"
    n "您是罗丝·克莱因吧？能占用您一点时间吗？"

# game/script.rpy:2765
translate schinese rose_next_baf1e66c:

    # r "I’ll call you back later. Bye."
    r "我待会儿再打给你。拜拜。"

# game/script.rpy:2766
translate schinese rose_next_7a2784d3:

    # mc "Wait, hold on—"
    mc "等等，先别——"

# game/script.rpy:2769
translate schinese rose_next_6ff41758:

    # r "And? How is she? Is she okay?"
    r "那她怎么样了？她还好吗？"

# game/script.rpy:2772
translate schinese rose_next_e11beffc:

    # n "It’s hard to say. Right now, she’s on the mend, but things could go south at any moment."
    n "不太好说。现在她在好转，但随时可能恶化。"

# game/script.rpy:2773
translate schinese rose_next_9b013b2e:

    # n "With all due respect, miss, we can’t discharge her from the hospital just yet."
    n "恕我直言，小姐，我们暂时还不能让她出院。"

# game/script.rpy:2775
translate schinese rose_next_e8c01064:

    # r "I… understand. Can I see her?"
    r "我……明白。我能见她吗？"

# game/script.rpy:2776
translate schinese rose_next_e05d6fd6:

    # n "She’s only just drifted off, but… yeah. You can see her."
    n "她刚刚才睡下，不过……可以。您可以见她。"

# game/script.rpy:2778
translate schinese rose_next_07534adc:

    # r "(People scream when they lose someone... but I don’t feel pain. Just the fear of not feelin’ it.)"
    r "（人们失去某个人时会尖叫……但我感受不到痛苦。只感到害怕自己感受不到。）"

# game/script.rpy:2780
translate schinese rose_next_8400fb6e:

    # r "(whispering) Whatever happens… there’s always a way forward. Right, Mom?"
    r "（低声）不管发生什么……总有往前走的路。对吧，妈？"

# game/script.rpy:2794
translate schinese rose_next_2274604b:

    # L "I don’t wanna sound like one of those clingy girls, but... {b}I told you so{/b}."
    L "我不想搞得像那些黏人的女生一样，但……{b}我早说过了{/b}。"

# game/script.rpy:2795
translate schinese rose_next_6bbe1952:

    # mc "Come on, it all ended pretty naturally… if you don’t count the cuts and the holes in my hands."
    mc "得了吧，结局挺自然的……如果你不数我手上的伤口和窟窿的话。"

# game/script.rpy:2796
translate schinese rose_next_082c96ca:

    # L "What about Rose?"
    L "罗丝呢？"

# game/script.rpy:2798
translate schinese rose_next_4ef829bc:

    # mc "Hey, that one’s not on me."
    mc "嘿，那不赖我。"

# game/script.rpy:2799
translate schinese rose_next_d1a9a096:

    # L "Maybe not your fault, but it hurts just looking at you."
    L "也许不是你的错，但光是看着你就让人难受。"

# game/script.rpy:2800
translate schinese rose_next_1e0dcfd9:

    # L "Your body’s barely healed, and here you go again."
    L "你身体才刚愈合，又来。"

# game/script.rpy:2801
translate schinese rose_next_2cddaa12:

    # mc "Guys like me — yeah, all we’ve got left is to push ourselves past the limit for something that almost makes sense."
    mc "像我这种人——是吧，剩下的也只有把自己逼过极限，去追一个勉强说得通的东西。"

# game/script.rpy:2802
translate schinese rose_next_944dd64d:

    # mc "Or at least that’s what I keep telling myself."
    mc "或者至少，我一直这么告诉自己。"

# game/script.rpy:2806
translate schinese rose_next_abeac3a4:

    # L "Now {b}that’s{/b} the spirit!"
    L "这{b}才{/b}对嘛！"

# game/script.rpy:2807
translate schinese rose_next_662be46c:

    # L "If only you had the actions to match all that dramatic talk, huh?"
    L "要是你的行动能配得上这么戏剧化的台词就好了。"

# game/script.rpy:2809
translate schinese rose_next_011214fa:

    # mc "Oh, come on. I’ve done enough for one day. Way more than I’ve done in months, actually."
    mc "得了吧。我今天干的已经够多了。其实比我几个月干的都多。"

# game/script.rpy:2810
translate schinese rose_next_69d420a6:

    # mc "I’m {b}this{/b} close to calling myself human again!"
    mc "我离重新自称人类只差{b}这么一点{/b}！"

# game/script.rpy:2811
translate schinese rose_next_5f091148:

    # mc "At least pretend you’re happy for me!"
    mc "至少假装为我高兴一下！"

# game/script.rpy:2814
translate schinese rose_next_61baeca8:

    # L "I {b}am{/b} happy. I just wish today’s little brawl didn’t end up looking like a horror movie."
    L "我{b}的确{/b}开心。只希望今天那点小打小闹别搞得像恐怖片。"

# game/script.rpy:2815
translate schinese rose_next_2654d685:

    # L "You could’ve told me, you know. I’d have kicked her ass myself."
    L "你本来可以告诉我的。我自己就能揍她。"

# game/script.rpy:2817
translate schinese rose_next_3f6e443f:

    # mc "Nah, you wouldn’t’ve beaten her. She’s the kind of person you really don’t want as an enemy."
    mc "不，你打不过她。她是你绝对不该树敌的那种人。"

# game/script.rpy:2818
translate schinese rose_next_57051937:

    # mc "(And I… I couldn’t forgive myself if something happened to you.)"
    mc "（而且我……如果你出了什么事，我没法原谅自己。）"

# game/script.rpy:2821
translate schinese rose_next_fdecba60:

    # L "Again with the dark thoughts? Come on, shake it off."
    L "又想这些有的没的？来，甩掉它。"

# game/script.rpy:2822
translate schinese rose_next_40e36f62:

    # mc "Don’t ruin the mood, woman! We were having such a nice conversation here."
    mc "别破坏气氛啊，女人！我们刚才聊得多愉快。"

# game/script.rpy:2823
translate schinese rose_next_b6892070:

    # L "Oh really? And still what {b}were{/b} you two talking about?"
    L "哦真的？那你们两个刚才还在聊{b}什么{/b}？"

# game/script.rpy:2825
translate schinese rose_next_5134d7f8:

    # mc "I… can’t tell you."
    mc "我……不能告诉你。"

# game/script.rpy:2826
translate schinese rose_next_27af4cf4:

    # L "Even to me? Wow, stingy much? Fine — keep your little secrets. I’m feeling generous today."
    L "连我也不说？哇，真小气。算了——留着你的小秘密吧。今天我很大方。"

# game/script.rpy:2829
translate schinese rose_next_1cc5cd38:

    # L "You do realize all that confidence and frustration of yours comes from here, right?"
    L "你知道你的自信和不甘都是从这儿来的吧？"

# game/script.rpy:2830
translate schinese rose_next_4ee73c28:

    # mc "Nose?"
    mc "鼻子？"

# game/script.rpy:2831
translate schinese rose_next_2bd85fe8:

    # L "From that head of yours, genius."
    L "从你那个脑袋里，天才。"

# game/script.rpy:2832
translate schinese rose_next_9f9f72e2:

    # L "Stop putting yourself down and you might actually start liking your life."
    L "别老贬低自己，说不定你真能开始喜欢自己的生活。"

# game/script.rpy:2835
translate schinese rose_next_c5663c11:

    # L "Anyway — while we’re waiting for Beatrice, how about we have a little fun? There’s a court right there."
    L "总之——等碧翠丝的时候，来找点乐子怎么样？那边就有球场。"

# game/script.rpy:2837
translate schinese rose_next_a7a4e551:

    # mc "You still into that kind of stuff? Thought you’d grown out of it."
    mc "你还玩这种？还以为你早就不玩了。"

# game/script.rpy:2838
translate schinese rose_next_91231edc:

    # mc "Wait — don’t tell me you {b}still{/b} have that notebook with the teddy bear?"
    mc "等等——别告诉我你还{b}还{/b}留着那个有小熊的笔记本？"

# game/script.rpy:2840
translate schinese rose_next_0053601d:

    # L "Of course I do."
    L "当然留着。"

# game/script.rpy:2841
translate schinese rose_next_d2b5e69b:

    # L "You gave it to me — how could I ever throw it away?"
    L "是你送我的——我怎么可能扔掉？"

# game/script.rpy:2850
translate schinese rose_next_da533b9e:

    # mc "You know, I {b}could’ve{/b} carried you all the way home."
    mc "你知道，我{b}本来{/b}可以把你一路背回家的。"

# game/script.rpy:2852
translate schinese rose_next_fddaa6f6:

    # L "I told you, I could walk just fine on my own. But nooo, our hero just {b}had{/b} to carry me home."
    L "我跟你说过了，我自己走得好好的。可不——我们的英雄就是{b}非要{/b}把我背回家。"

# game/script.rpy:2853
translate schinese rose_next_f72db097:

    # L "(whispering) And… I couldn’t really say no."
    L "（低声）而且……我还真拒绝不了。"

# game/script.rpy:2856
translate schinese rose_next_b7b3e3e0:

    # mc "Hey, let’s call it gratitude, all right? I don’t show it often, so cherish the moment!"
    mc "嘿，咱们就叫它感激吧，行吗？我很少表露这些，好好珍惜！"

# game/script.rpy:2858
translate schinese rose_next_4d4fe034:

    # L "Yeah, yeah — whatever you say, big guy."
    L "是是是——你说什么都对，大块头。"

# game/script.rpy:2863
translate schinese rose_next_bbbf90eb:

    # mc "Anyway, that’s the story. We really nailed it this time — yeah, yeah, I know. But what can you do?"
    mc "总之，故事就是这样。这次我们是真成功了——是是是，我知道。可你能怎么办？"

# game/script.rpy:2864
translate schinese rose_next_8e12931b:

    # mc "And please, spare me the life lecture, I know, I know."
    mc "求你了，别再上人生教育课，我知道我知道。"

# game/script.rpy:2866
translate schinese rose_next_098f391d:

    # b "Didn’t plan to, love. If that’s the kinda life you fancy, who am I to tell you otherwise, yeah?"
    b "亲爱的，我本来也没打算说。你要想过那种生活，我还能反对不成？"

# game/script.rpy:2868
translate schinese rose_next_7822bf2d:

    # mc "And here it comes… BUT."
    mc "来了吧……但是。"

# game/script.rpy:2870
translate schinese rose_next_b6ffcca4:

    # b "But as the one who’s gotta stick her neck out for your bloody mess, I can’t just sit back, can I?"
    b "但作为那个得为你这堆烂摊子出头的人，我没法袖手旁观，对吧？"

# game/script.rpy:2871
translate schinese rose_next_39d83169:

    # b "Think, yeah? What d’you reckon that stunt of yours just caused?"
    b "想想看，嗯？你觉得你刚才那场表演惹出了什么？"

# game/script.rpy:2873
translate schinese rose_next_0f78cbcb:

    # mc "Oh, don’t start…"
    mc "哦，别开始……"

# game/script.rpy:2875
translate schinese rose_next_c0ce7d38:

    # b "Oh, I’m bloody well startin’. You went to that club draggin’ Lena along, riskin’ both your hides for what, a bit of fun?"
    b "哦，我偏要开始。你拉着莉娜去那种夜店，拿两个人的命去赌——就为了点乐子？"

# game/script.rpy:2876
translate schinese rose_next_769e5257:

    # b "Yeah, she’s tough, I’ll give her that. But the world ain’t built on school grades, is it?"
    b "是啊，她很硬，这点我承认。但这世界又不是按学校成绩运转的，对吧？"

# game/script.rpy:2877
translate schinese rose_next_7ff95b23:

    # b "You two should’ve known that, plain an’ simple."
    b "你们俩本该明白这个，再简单不过。"

# game/script.rpy:2880
translate schinese rose_next_a20384f1:

    # L "(whispering) I got nothing to add. She’s kinda right, you know."
    L "（低声）我没什么可补充的。她说得有点对。"

# game/script.rpy:2882
translate schinese rose_next_606dc3b9:

    # mc "(whispering) Oh no, don’t tell me you’re on her side. I thought we’d team up against her."
    mc "（低声）哦不，别告诉我你站她那边。我还以为我们要联手对付她呢。"

# game/script.rpy:2885
translate schinese rose_next_740fd477:

    # L "(whispering) Beatrice?"
    L "（低声）碧翠丝？"

# game/script.rpy:2886
translate schinese rose_next_17cf8654:

    # L "(whispering) Nah, not a chance. She’d kick both our asses and still have time for a snack."
    L "（低声）想都别想。她能一边揍我们俩一边还有空吃点心。"

# game/script.rpy:2888
translate schinese rose_next_85f6251d:

    # mc "(whispering) Traitor!"
    mc "（低声）叛徒！"

# game/script.rpy:2890
translate schinese rose_next_f8ef8ffd:

    # mc "(whispering) What happened to ‘together forever,’ huh?”"
    mc "（低声）“永远在一起”呢，嗯？"

# game/script.rpy:2893
translate schinese rose_next_263e8fdc:

    # L "(whispering) Sorry, partner in crime, but I’m sitting this one out. She’s scary when she’s mad."
    L "（低声）抱歉，犯罪同伙，但这次我弃权。她生气起来很吓人。"

# game/script.rpy:2895
translate schinese rose_next_8e89029b:

    # b "(They do realise I can bloody hear ’em, right?)"
    b "（他们该不会忘了我他妈听得见吧？）"

# game/script.rpy:2896
translate schinese rose_next_a57a67d1:

    # b "(Still… credit where it’s due. Facin’ the Dillaymen lot and walkin’ out mostly intact? Not half bad.)"
    b "（不过……该夸还是要夸。顶着那帮德拉伊姆家的人走出来，还基本全身而退？不算太差。）"

# game/script.rpy:2902
translate schinese rose_next_3bd101b7:

    # b "Oi, lovebirds! You two want anythin’ or just gonna whisper sweet nothin’s all day?"
    b "喂，鸳鸯党！你们俩要买点东西，还是要一整天在那儿互诉衷肠？"

# game/script.rpy:2903
translate schinese rose_next_223c5ba6:

    # mc "Funny joke. You stealing soda again?"
    mc "真好笑。你又偷汽水了？"

# game/script.rpy:2904
translate schinese rose_next_e3f322e6:

    # b "Not sayin’ it twice, mind you."
    b "我可不重复第二遍。"

# game/script.rpy:2907
translate schinese rose_next_4f22aa68:

    # mc "I’ll pass."
    mc "我不了。"

# game/script.rpy:2909
translate schinese rose_next_07ad7bdb:

    # b "Lena?"
    b "莉娜？"

# game/script.rpy:2910
translate schinese rose_next_9993b94e:

    # L "..."
    L "……"

# game/script.rpy:2913
translate schinese rose_next_7d771f72:

    # mc "Lena?"
    mc "莉娜？"

# game/script.rpy:2914
translate schinese rose_next_fae132a4:

    # L "Uh… no, no, thanks, Beatrice."
    L "呃……不用了，谢谢你，碧翠丝。"

# game/script.rpy:2918
translate schinese rose_next_e50f2122:

    # mc "(whispering) By the way, do I {b}have{/b} to go to that interview with you? I’ve got no clothes, no mood…"
    mc "（低声）话说回来，我{b}真的{/b}得跟你去那个访谈吗？我没衣服，也没心情……"

# game/script.rpy:2921
translate schinese rose_next_ec6af035:

    # b "Ah, so that’s what this is about. Tough luck, sunshine — you’re goin’, naked or not."
    b "啊，原来是为了这个。认命吧，小子——你得去，穿不穿衣服都一样。"

# game/script.rpy:2922
translate schinese rose_next_6244d73c:

    # mc "(whispering) Who the hell even came up with this interview idea…"
    mc "（低声）到底是谁想出这个访谈主意的……"

# game/script.rpy:2926
translate schinese rose_next_03133f9c:

    # mc "(She just won’t drop it, huh? She used to not care about me that much, and now suddenly it’s ‘the interview this, the interview that’…)"
    mc "（她就是放不下，是吧？以前她也没那么在乎我，现在突然变成“这访谈那访谈”……）"

# game/script.rpy:2927
translate schinese rose_next_7de1444c:

    # mc "(My clown senses are tingling — something’s definitely off.)"
    mc "（我的小丑直觉在发麻——肯定有什么不对劲。）"

# game/script.rpy:2929
translate schinese rose_next_ebfb654d:

    # b "Interview’s with the Great One. Ring a bell?"
    b "访谈对象是至高者。听说过吗？"

# game/script.rpy:2930
translate schinese rose_next_093046ca:

    # b "You’ll be the one chattin’ with him, not hidin’ behind me."
    b "是你去跟他聊，不是躲在我身后。"

# game/script.rpy:2932
translate schinese rose_next_c551588d:

    # mc "You want me dead, is that it?!"
    mc "你是想让我死，对吧？！"

# game/script.rpy:2933
translate schinese rose_next_bc5c15fc:

    # mc "The moment he sees me, I’m toast! And if he doesn’t kill me on sight, he’ll do it mid-conversation!"
    mc "他一看到我就完蛋！就算不当场杀，也会在谈话中途下手！"

# game/script.rpy:2935
translate schinese rose_next_48965542:

    # b "’Course, there’s always option two — I kill ya myself. Quicker that way."
    b "当然，还有第二个选项——我自己动手杀你。这么快省事。"

# game/script.rpy:2937
translate schinese rose_next_b038255b:

    # mc "You’re the cruelest person I’ve ever met, you know that?"
    mc "你是我见过最残忍的人，你知不知道？"

# game/script.rpy:2942
translate schinese rose_next_c77aead6:

    # b "Didn’t think so. Any other clever questions, or we done here?"
    b "我倒不这么认为。还有别的聪明问题吗，还是到此为止？"

# game/script.rpy:2945
translate schinese rose_next_3af246c8:

    # mc "One thing — clothes. If I’m going to my execution, I’d rather look good doing it."
    mc "有一件——衣服。既然要去受刑，我希望死得好看点。"

# game/script.rpy:2947
translate schinese rose_next_ce97465b:

    # mc "(Oh no… that smile.)"
    mc "（哦不……那个笑容。）"

# game/script.rpy:2948
translate schinese rose_next_d861e42a:

    # mc "(She’s got a plan. Which means… I’m dead.)"
    mc "（她有计划了。也就是说……我死定了。）"

# game/script.rpy:2951
translate schinese rose_next_9a294d88:

    # L "I’ve got a small closet back home — maybe we could find something that fits him?"
    L "我家有个小衣柜——也许能找到合他身的？"

# game/script.rpy:2953
translate schinese rose_next_9c2c3457:

    # b "Cheers, Lena, but no need. Doubt you’ve got anythin’ that’d fit this idiot anyway."
    b "谢了，莉娜，但不用。我看你也没什么东西能合这个白痴的身。"

# game/script.rpy:2956
translate schinese rose_next_d9b2c34e:

    # mc "Doesn’t matter what it is, as long as I look good in it."
    mc "是什么不重要，只要我穿着好看。"

# game/script.rpy:2962
translate schinese rose_next_28fe5fce:

    # mc "Hey— wait, girls? C’mon, I was joking…"
    mc "喂——等等，姑娘们？拜托，我是开玩笑的……"

# game/script.rpy:2965
translate schinese rose_next_b7748a93:

    # mc "NOOOOOOOOOOO!"
    mc "不——————！！！"

# game/script.rpy:2974
translate schinese fashion_1_e9c710b5:

    # b "Looks pretty damn good, I’ll give ya that — but it ain’t for him."
    b "嗯，确实他妈的挺好看，这点我承认——但不是给他的。"

# game/script.rpy:2975
translate schinese fashion_1_bfc760bb:

    # mc "(You’re probably wondering, what’s so damn important about this interview, and why the hell am I even needed there?)"
    mc "（你大概在想，这场访谈到底有什么了不得的，我他妈为什么非得在场？）"

# game/script.rpy:2976
translate schinese fashion_1_153150c1:

    # mc "(And honestly? Same. I’d love to know why the universe keeps dragging me into this crap.)"
    mc "（说真的？我也想知道为什么宇宙老把我拖进这种破事。）"

# game/script.rpy:2977
translate schinese fashion_1_a0f46e00:

    # L "What d’you think about this one?"
    L "这件怎么样？"

# game/script.rpy:2979
translate schinese fashion_1_0052b3cf:

    # b "I like that one, we’ll keep it."
    b "我喜欢这件，留下了。"

# game/script.rpy:2980
translate schinese fashion_1_4d2c3eec:

    # b "Third outfit’s sorted — few more and he can start tryin’ ’em on."
    b "第三套也定了——再来几件他就能开始试穿了。"

# game/script.rpy:2981
translate schinese fashion_1_d25dd450:

    # mc "(I’ve got a theory — that blob of slime’s trying to ‘help me’ by tossing me to the wolves. Specifically, to my number one hater.)"
    mc "（我有个推测——那坨黏液怪想“帮”我，把我扔进狼群。具体来说，是扔给我头号黑粉。）"

# game/script.rpy:2982
translate schinese fashion_1_e3808842:

    # mc "(Smart move, really. For a normal person. Which, spoiler alert — I’m not.)"
    mc "（真聪明。对正常人来说。但剧透一下——我不是正常人。）"

# game/script.rpy:2984
translate schinese fashion_1_54c25110:

    # mc "(On the other hand — if you drop all the crap for a sec and face the truth...)"
    mc "（不过话说回来——如果你先放下那些破事，面对真相……）"

# game/script.rpy:2985
translate schinese fashion_1_bbabfcb9:

    # mc "(Beatrice, Lena...)"
    mc "（碧翠丝，莉娜……）"

# game/script.rpy:2986
translate schinese fashion_1_00c7bade:

    # mc "(What did I do to deserve them? Both of them have had my back for as long as I can remember.)"
    mc "（我做了什么才配得上她们？在我记忆里，她们俩一直都站在我这边。）"

# game/script.rpy:2987
translate schinese fashion_1_047bb41d:

    # mc "(And sometimes I wanna repay them for that kindness, but aside from dumb jokes... I’m good for nothing)"
    mc "（有时候我想报答这份好意，可除了蠢笑话……我什么都做不了）"

# game/script.rpy:2989
translate schinese fashion_1_ab8e143c:

    # mc "(Maybe that’s why I joined the Academy.)"
    mc "（也许这就是我加入学院的原因。）"

# game/script.rpy:2990
translate schinese fashion_1_3b81c555:

    # mc "(To pay them back for believing in me.)"
    mc "（为了回报她们的信任。）"

# game/script.rpy:2991
translate schinese fashion_1_386fe85b:

    # mc "(Or maybe… that’s why I’m walking into this damn interview today.)"
    mc "（又或者……这就是我今天走进这该死的访谈的原因。）"

# game/script.rpy:2992
translate schinese fashion_1_980862ee:

    # b "[mc]! You drifted off again, didn’t ya? Eyes up, sunshine."
    b "[mc]！你又走神了，是吧？把眼睛睁开，小子。"

# game/script.rpy:2994
translate schinese fashion_1_ca2d11bf:

    # mc "Don’t blame me, woman! We’ve been at this for an hour and you still can’t pick an outfit!"
    mc "别怪我啊，女人！都一个小时了你还挑不出衣服！"

# game/script.rpy:2996
translate schinese fashion_1_989cccfe:

    # b "You’re sittin’ on your arse doin’ sod all while we pick what you’re showin’ the world in."
    b "你光坐着什么也不干，我们却在这儿替你挑要穿给全世界看的衣服。"

# game/script.rpy:2998
translate schinese fashion_1_47c74174:

    # L "You gotta shine brighter than anyone else out there!"
    L "你必须比外面任何人都耀眼！"

# game/script.rpy:3000
translate schinese fashion_1_07edd351:

    # b "So no whinin’, got it? You’ll be wearin’ whatever we pick — tomorrow included."
    b "所以不许抱怨，听见了吗？你得穿我们挑的——包括明天那套。"

# game/script.rpy:3002
translate schinese fashion_1_1d7ca463:

    # mc "WHAT?! What happened to individuality? To style?!"
    mc "什么？！个性呢？风格呢？！"

# game/script.rpy:3004
translate schinese fashion_1_c80c9f87:

    # b "You mean that shirt from ten bloody years ago? Or them trousers your granddad probably died in?"
    b "你是说那件十年前的破衬衫？还是你爷爷大概穿着去世的那条裤子？"

# game/script.rpy:3006
translate schinese fashion_1_58426a34:

    # mc "Hey, they served me faithfully! Show some respect!"
    mc "喂，它们可是忠心耿耿地服务过我！放尊重点！"

# game/script.rpy:3007
translate schinese fashion_1_bcd7b380:

    # b "(mutterin’) You’re beggin’ for a slap, you know that?"
    b "（嘟囔）你这是欠揍，知不知道？"

# game/script.rpy:3011
translate schinese fashion_1_9b85026f:

    # b "No, and that’s final."
    b "不行，就这么定了。"

# game/script.rpy:3012
translate schinese fashion_1_bf906836:

    # b "This interview matters — for you and for me."
    b "这场访谈很重要——对你，对我都一样。"

# game/script.rpy:3013
translate schinese fashion_1_bb9fdc15:

    # b "How you handle yourself there might just change a lot, so don’t cock it up."
    b "你在那里的表现可能会改变很多事，所以别搞砸了。"

# game/script.rpy:3014
translate schinese fashion_1_a884583a:

    # b "So stop pushin’ our help away like it’s some bloody favour. We’re doin’ this ’cause we care, alright?"
    b "所以别再把我们的帮助往外推，好像那是什么施舍。我们这么做是因为在乎你，好吗？"

# game/script.rpy:3016
translate schinese fashion_1_37d5cb17:

    # b "That clear enough for ya?"
    b "这样够清楚了吗？"

# game/script.rpy:3017
translate schinese fashion_1_2b35b6fe:

    # mc "..."
    mc "……"

# game/script.rpy:3018
translate schinese fashion_1_ad88b25d:

    # b "Glad we understand each other. And don’t bring it up again."
    b "很高兴我们达成共识。别再提这事了。"

# game/script.rpy:3022
translate schinese fashion_1_3bea1d7e:

    # L "Maybe ease up on him a little? Oh— and the outfits are ready."
    L "也许对他稍微温和点？哦——衣服选好了。"

# game/script.rpy:3024
translate schinese fashion_1_7855165a:

    # b "Can’t handle him any other way, trust me."
    b "相信我，我没法用别的方式对付他。"

# game/script.rpy:3027
translate schinese fashion_1_18dfe7d2:

    # b "Up you get, grab the outfits, and leg it to the changin’ room."
    b "起来，拿上衣服，跑到更衣室去。"

# game/script.rpy:3033
translate schinese fashion_1_e05658cd:

    # mc "I’m tellin’ you, in this outfit I look like one of those old-school detectives."
    mc "我跟你说，穿上这身我就像那种老派侦探。"

# game/script.rpy:3034
translate schinese fashion_1_b3e94b41:

    # mc "All I need now’s a villain — and, oh right, I do have a meeting with one."
    mc "现在只差个反派——哦对了，我正好约了一个。"

# game/script.rpy:3035
translate schinese fashion_1_f90775fa:

    # mc "(Funny, isn’t it? They’re dressing me up for an interview, but it feels more like a circus.)"
    mc "（有意思，不是吗？他们给我打扮是为了访谈，可感觉更像一场马戏。）"

# game/script.rpy:3037
translate schinese fashion_1_bd029f5b:

    # b "He’s only a villain to you, mate. Rest of the world calls him a bloody hero."
    b "对你来说他才是反派，兄弟。这世上其他人都叫他英雄。"

# game/script.rpy:3039
translate schinese fashion_1_2be19cf7:

    # mc "Hero on the outside, villain underneath."
    mc "表面英雄，内里反派。"

# game/script.rpy:3041
translate schinese fashion_1_017b9391:

    # L "Hmm, someone’s giving me déjà vu. Can’t quite place who though... care to remind me, [mc]?"
    L "嗯，怎么有种似曾相识的感觉。可我又想不起来是谁……提醒我一下，[mc]？"

# game/script.rpy:3043
translate schinese fashion_1_e42f2035:

    # mc "No idea what you’re talkin’ about."
    mc "不知道你在说什么。"

# game/script.rpy:3044
translate schinese fashion_1_3f9c44fa:

    # mc "Anyway, thoughts on the outfit?"
    mc "总之，这身怎么样？"

# game/script.rpy:3046
translate schinese fashion_1_ce7bbbd9:

    # b "Next one."
    b "下一件。"

# game/script.rpy:3047
translate schinese fashion_1_5bd431d0:

    # L "Yeah, toss it. Next!"
    L "对，扔掉。下一件！"

# game/script.rpy:3050
translate schinese fashion_1_8dd56269:

    # mc "Ladies and gentlemen — Emperor Palpatine himself!"
    mc "女士们先生们——帕尔帕廷皇帝本人！"

# game/script.rpy:3052
translate schinese fashion_1_83f74b8e:

    # b "Didn’t know the head o’ the Republic was workin’ on minimum wage."
    b "没想到共和国元首拿的是最低工资。"

# game/script.rpy:3053
translate schinese fashion_1_340ca3b0:

    # L "Not gonna lie, there’s somethin’ about this one. It’s got... presence, you know?"
    L "不骗你，这件有点东西。它有……气场，你懂吧？"

# game/script.rpy:3055
translate schinese fashion_1_26c1cfa6:

    # mc "I was supposed to fight evil, not join it! Obi-Wan would lose his damn mind if he saw me now."
    mc "我本来是要消灭邪恶的，不是加入它！欧比旺看到我现在这副样子肯定要疯。"

# game/script.rpy:3057
translate schinese fashion_1_c0727a6f:

    # b "Your Obi-Wan ditched ya, left his whiny little padawan to me instead."
    b "你的欧比旺把你甩了，把他那个爱抱怨的小绝地留给了我。"

# game/script.rpy:3058
translate schinese fashion_1_080ca5ec:

    # b "And that padawan — bloody hell, what a handful he was."
    b "而那个小绝地——天啊，真是个磨人精。"

# game/script.rpy:3060
translate schinese fashion_1_3c575bb1:

    # mc "Like master, like apprentice."
    mc "有其师必有其徒。"

# game/script.rpy:3062
translate schinese fashion_1_ce7bbbd9_1:

    # b "Next one."
    b "下一件。"

# game/script.rpy:3065
translate schinese fashion_1_c6d52f45:

    # mc "(How many outfits do they even have left? This is turning into a side quest.)"
    mc "（她们到底还有多少件衣服？这已经变成支线任务了。）"

# game/script.rpy:3066
translate schinese fashion_1_fe52cc98:

    # mc "By the way, since we’re on the family topic — how’re your parents, Len?"
    mc "话说，既然聊到家庭——你父母怎么样，莉娜？"

# game/script.rpy:3073
translate schinese fashion_1_d0968ca7:

    # L "My mom’s great— actually, she asked about you the other day. Said you should stop by sometime."
    L "我妈好得很——其实，她前几天还问起你。说你有空过去坐坐。"

# game/script.rpy:3074
translate schinese fashion_1_c5d537a8:

    # L "Can barely see my dad lately— always buried in work. So yeah, that’s about it."
    L "最近很少见到我爸——总是埋在工作里。差不多就这样。"

# game/script.rpy:3077
translate schinese fashion_1_d4ebb61a:

    # b "Her mum rings now and then askin’ after you. Sweet woman, bit weird though."
    b "她妈时不时打电话来问你。是个好女人，就是有点古怪。"

# game/script.rpy:3079
translate schinese fashion_1_3699d705:

    # L "She’s always been that way— a bit odd, but honestly? She’s the best."
    L "她一直是这样——有点怪，但说真的？她最好了。"

# game/script.rpy:3080
translate schinese fashion_1_e6e1d6f6:

    # b "Next."
    b "下一件。"

# game/script.rpy:3081
translate schinese fashion_1_e16d7c0a:

    # mc "(Seriously? We’re still not done?)"
    mc "（认真的？还没完？）"

# game/script.rpy:3084
translate schinese fashion_1_f82f7e26:

    # L "So what about you two? Your folks still pretending you don’t exist?"
    L "那你们俩呢？你们家里人还在假装你们不存在吗？"

# game/script.rpy:3087
translate schinese fashion_1_c2af1509:

    # mc "Nothing surprising. Who’d want a clown for a son, anyway?"
    mc "毫不意外。谁会想要个小丑当儿子呢？"

# game/script.rpy:3088
translate schinese fashion_1_916136d9:

    # mc "If it weren’t for Beatrice, I’d probably be living the dream under a bridge somewhere."
    mc "要不是碧翠丝，我大概已经在哪个桥洞下实现梦想了。"

# game/script.rpy:3089
translate schinese fashion_1_850ef128:

    # b "..."
    b "……"

# game/script.rpy:3091
translate schinese fashion_1_a95db178:

    # L "I just can’t wrap my head around that... to disown your own kid just ‘cause they’re a little different?"
    L "我真是想不通……就因为孩子有点不一样，就断绝关系？"

# game/script.rpy:3094
translate schinese fashion_1_78c9734d:

    # b "Parents love dumpin’ their bloody dreams on their kids. You’d know that better’n most, yeah Len?"
    b "父母就爱把他们那该死的梦想压到孩子身上。这点你比谁都清楚，对吧，莉娜？"

# game/script.rpy:3095
translate schinese fashion_1_9993b94e:

    # L "..."
    L "……"

# game/script.rpy:3096
translate schinese fashion_1_e6e1d6f6_1:

    # b "Next."
    b "下一件。"

# game/script.rpy:3099
translate schinese fashion_1_7f2c9c31:

    # mc "Wait — when did your parents give you hell, Len? I thought you were, like, the family pride and joy."
    mc "等等——你父母什么时候折腾过你，莉娜？我还以为你是那种全家的骄傲和快乐源泉。"

# game/script.rpy:3100
translate schinese fashion_1_a86344e0:

    # mc "But hey, if it ever happens — though I doubt it — you know who to blame."
    mc "不过要是真发生了——虽然我不太信——你知道该怪谁。"

# game/script.rpy:3101
translate schinese fashion_1_743540df:

    # mc "I’ll be your personal lightning rod."
    mc "我会当你的避雷针。"

# game/script.rpy:3102
translate schinese fashion_1_850ef128_1:

    # b "..."
    b "……"

# game/script.rpy:3103
translate schinese fashion_1_6bd52bf9:

    # mc "Why’d you two go quiet all of a sudden?"
    mc "你俩怎么突然都不说话了？"

# game/script.rpy:3105
translate schinese fashion_1_03b2f914:

    # L "...Oh, {b}that{/b} one?"
    L "……哦，{b}那{/b}件？"

# game/script.rpy:3107
translate schinese fashion_1_2d5402ba:

    # b "That’s the one."
    b "就是那件。"

# game/script.rpy:3109
translate schinese fashion_1_d714b272:

    # mc "So this is the one I’m wearing, huh?"
    mc "所以我穿的是这件，嗯？"

# game/script.rpy:3110
translate schinese fashion_1_71f4a313:

    # mc "{b}Oh, come on!{/b} What about the so-called ‘style’ you’ve been preaching about?"
    mc "{b}得了吧！{/b}你一直念叨的那个所谓“风格”呢？"

# game/script.rpy:3112
translate schinese fashion_1_c0baa6a1:

    # b "Surprisingly, classic style suits ya bloody well."
    b "没想到，经典风格他妈的挺适合你。"

# game/script.rpy:3113
translate schinese fashion_1_73eb514e:

    # L "It actually looks {b}great{/b} on you. And it fits the academy’s dress code— nice find!"
    L "你穿着其实{b}很帅{/b}。而且符合学院着装规定——眼光不错！"

# game/script.rpy:3116
translate schinese fashion_1_d4c32687:

    # mc "Dress code? Wait — don’t tell me you’ve got uniforms, too?"
    mc "着装规定？等等——别告诉我你们还有制服？"

# game/script.rpy:3118
translate schinese fashion_1_9a73886f:

    # L "It’s an elite school, of course there’s a uniform. Thing is—"
    L "精英学校当然有制服。问题是——"

# game/script.rpy:3119
translate schinese fashion_1_e7ff851d:

    # L "most folks are too rich to care, so no one really wears it."
    L "大多数人太有钱不在乎，所以根本没人穿。"

# game/script.rpy:3120
translate schinese fashion_1_f381f7a0:

    # mc "So that’s why the dress code exists…"
    mc "所以着装规定才存在……"

# game/script.rpy:3122
translate schinese fashion_1_d11af043:

    # L "Exactly!"
    L "正是！"

# game/script.rpy:3123
translate schinese fashion_1_08692c39:

    # b "Still, there’s always exceptions to the rule."
    b "不过，规矩总有例外。"

# game/script.rpy:3127
translate schinese fashion_1_0f649215:

    # b "Beatrice speakin’. Go on."
    b "碧翠丝发言。继续。"

# game/script.rpy:3129
translate schinese fashion_1_bdb4871a:

    # mc "(And there it is— the call. End of the fashion show, and probably the start of something worse.)"
    mc "（来了——电话。时装秀结束，大概是更糟的事的开始。）"

# game/script.rpy:3131
translate schinese fashion_1_c841c9f7:

    # b "Got it. We’re on our way."
    b "知道了。我们马上过去。"

# game/script.rpy:3144
translate schinese fashion_1_018c4e87:

    # mc "Alright, down to business — what’s my actual job in this interview, huh?"
    mc "好，说正事——我在这次访谈里到底干什么活，嗯？"

# game/script.rpy:3146
translate schinese fashion_1_81741833:

    # b "You’ve heard o’ the Great One — or better yet, Philip."
    b "你听说过至高者吧——更准确地说，菲利普。"

# game/script.rpy:3147
translate schinese fashion_1_1288ffaf:

    # b "Try to get under his skin, yeah? Shouldn’t be too hard for you, knowin’ you."
    b "试着惹毛他，嗯？以你的本事，应该不难。"

# game/script.rpy:3148
translate schinese fashion_1_30971c8e:

    # mc "What? Why?!"
    mc "什么？为什么？！"

# game/script.rpy:3149
translate schinese fashion_1_633630be:

    # mc "(Piss off Philip? Perfect. Let’s just add ‘professional psycho-provoker’ to my résumé while we’re at it.)"
    mc "（惹毛菲利普？完美。顺手在简历上加一条“职业心理挑衅师”吧。）"

# game/script.rpy:3153
translate schinese fashion_1_ef0e8635:

    # b "Let’s just say, some big shots wanna see him crash and burn tonight — and you’re the perfect bloke for the job."
    b "这么说吧，今晚有几个大人物想看他摔个四脚朝天——而你正是最佳人选。"

# game/script.rpy:3154
translate schinese fashion_1_6dca209f:

    # b "Rile him up, earn yourself a bit o’ credit with ’em, and help me out in the process."
    b "把他激起来，在他们那儿攒点人情，同时顺手帮我个忙。"

# game/script.rpy:3155
translate schinese fashion_1_ad4e6791:

    # b "Easy as pie, innit?"
    b "简单得很，对吧？"

# game/script.rpy:3156
translate schinese fashion_1_12263d9e:

    # mc "His daddy — as in {b}the{/b} head of the Academy I’m interviewing at {b}tomorrow{/b}."
    mc "他爸——也就是我{b}明天{/b}要去面试的那所学院的{b}校长{/b}。"

# game/script.rpy:3157
translate schinese fashion_1_d004608e:

    # mc "Care to explain why that tiny detail got lost, dear sister?"
    mc "能不能解释一下，为什么这么小的细节被漏掉了，亲爱的姐姐？"

# game/script.rpy:3160
translate schinese fashion_1_97d9b1a4:

    # b "Don’t lose sleep over Charles. He won’t lift a bloody finger — not with Philip’s temper."
    b "别为查尔斯睡不着。他一根手指都不会动——有菲利普那脾气在呢。"

# game/script.rpy:3161
translate schinese fashion_1_b2f69bf0:

    # b "And if things go south, I’ll sort it. Stop worryin’, yeah?"
    b "要是出事，我来处理。别操心了，嗯？"

# game/script.rpy:3164
translate schinese fashion_1_6bf22837:

    # mc "And if things go sideways, what then?"
    mc "要是情况有变呢？"

# game/script.rpy:3166
translate schinese fashion_1_98e00479:

    # b "If you muck it up, yeah, there’ll be problems — just not for you. Either way, you come out on top."
    b "你要是搞砸了，确实会有麻烦——但不会是针对你的。无论哪种情况，你都是赢家。"

# game/script.rpy:3167
translate schinese fashion_1_37ff49ab:

    # b "That’s reason number one. Now, reason number two..."
    b "这是理由一。现在，理由二……"

# game/script.rpy:3169
translate schinese fashion_1_3d6d4da7:

    # b "Your trauma — I need to know you’ve moved past it, that you’re not stuck back there."
    b "你的创伤——我要确认你已经走出来了，不是还困在那里。"

# game/script.rpy:3170
translate schinese fashion_1_b0b2ca24:

    # b "Honestly, I do believe you’ll manage."
    b "说真的，我相信你能行。"

# game/script.rpy:3171
translate schinese fashion_1_0d853970:

    # b "And givin’ Philip a good kick up the arse? Just a lovely little bonus, ain’t it?"
    b "顺便狠狠踹菲利普屁股一顿？只是个小小的附赠品，对吧？"

# game/script.rpy:3173
translate schinese fashion_1_afc75028:

    # mc "(Too much pressure, too little time. On the other hand — perfect timing for my next ‘character development arc.’)"
    mc "（压力太大，时间太少。不过——正好赶上我下一段“角色成长弧”的好时机。）"

# game/script.rpy:3174
translate schinese fashion_1_815f8565:

    # mc "(Maybe I can finally pay Beatrice back, face my past, and— bonus! Ruin that pompous prick’s day.)"
    mc "（也许我能终于报答碧翠丝，直面过去——然后附赠！毁掉那个自命不凡的混蛋一天。）"

# game/script.rpy:3175
translate schinese fashion_1_ea85325e:

    # mc "(Still... one wrong move, and everything goes up in flames. High risk, high reward, I guess.)"
    mc "（不过……一步走错，全都付之一炬。我算是高风险高回报吧。）"

# game/script.rpy:3176
translate schinese fashion_1_fb909ccf:

    # mc "You’re dragging me into your shady politics again..."
    mc "你又把我拖进你那堆见不得光的政治里了……"

# game/script.rpy:3179
translate schinese fashion_1_89bd99f5:

    # b "And once again, you didn’t say no."
    b "而你又一次没说“不”。"

# game/script.rpy:3181
translate schinese fashion_1_f92c05c6:

    # mc "(That little menace. Life’s never dull with her around.)"
    mc "（那个小恶魔。她在身边的日子从没无聊过。）"

# game/script.rpy:3183
translate schinese fashion_1_ea5167f1:

    # b "(whisperin’) Told ya before, nothin’ happens if you fail... but you bloody well better not. Or I’ll kill ya myself."
    b "（低声）我之前说过，失败了也不会怎样……但你最好他妈的别失败。不然我亲手杀了你。"

# game/script.rpy:3186
translate schinese fashion_1_95741de2:

    # mc "(For you, this meeting means way more than you’re letting on…)"
    mc "（对你来说，这场会面比你表现出来的意义重大得多……）"

# game/script.rpy:3187
translate schinese fashion_1_71cb1bd2:

    # b "So do me a favour — don’t let me down, yeah?"
    b "所以帮我个忙——别让我失望，嗯？"

# game/script.rpy:3189
translate schinese fashion_1_3584a068:

    # mc "(Bit of a lose-lose situation here. Riling up Philip’s gonna be tricky.)"
    mc "（这有点两头不讨好。惹毛菲利普可不容易。）"

# game/script.rpy:3190
translate schinese fashion_1_6eea3bf3:

    # mc "(Hot-headed or not, I’ve gotta keep my cool. Straight-up insults are off the table.)"
    mc "（他再怎么急躁，我也得保持冷静。直接辱骂是行不通的。）"

# game/script.rpy:3192
translate schinese fashion_1_fc355b16:

    # mc "(And if I so much as mention Isabelle? Instant death. No exceptions. Good thing she’s not showing up...)"
    mc "（要是我一提伊莎贝拉？当场死亡。别无例外。幸好她不会出现……）"

# game/script.rpy:3196
translate schinese fashion_1_80fa7dd7:

    # n "…I once happened to see a tall dwarf — not a sight for the faint-hearted."
    n "……我有一回碰巧看见一个高个子矮人——心脏不好的人别看。"

# game/script.rpy:3198
translate schinese fashion_1_93108dcc:

    # mc "(Flag? Dwarves? What the hell’s happening right now…)"
    mc "（旗帜？矮人？现在到底他妈在干什么……）"

# game/script.rpy:3199
translate schinese fashion_1_cdcb5040:

    # n "So dere I vas, in dis shop, yah? I valk up to dis tall dwarf an’ go, *‘Could ye vey out five grams o’ cheese, please?’*"
    n "当时我就在那家店里，懂吗？我走到那个高个子矮人跟前，说：“能给我切五克奶酪吗？”"

# game/script.rpy:3200
translate schinese fashion_1_e8b4e2bf:

    # n "He smirks an’ goes, *‘Ain’t dat a bit much for ye, eh?’*"
    n "他咧嘴一笑，说：“对你来说这可有点过分了，是吧？”"

# game/script.rpy:3202
translate schinese fashion_1_baee1b5d:

    # n "And ye said vhat?"
    n "你当时说了什么？"

# game/script.rpy:3203
translate schinese fashion_1_4fe34bf0:

    # n "I said, *‘Keep talkin’ like dat an’ I’ll ask ye to slice it!’*"
    n "我说：“你再这么说话，我就让你亲手切！”"

# game/script.rpy:3204
translate schinese fashion_1_aba5b9ca:

    # n "Hah! Good vone, laddie! Hah-ha-ha-ha!"
    n "哈！说得好啊，小子！哈哈哈哈！"

# game/script.rpy:3206
translate schinese fashion_1_a730ab66:

    # n "Oi, lads! De boss’s here! All hail de Great One!"
    n "喂，小子们！老板来了！至高者万岁！"

# game/script.rpy:3207
translate schinese fashion_1_58b44fdc:

    # n "Gløry ta de Great One! May her Slime bless our sorry beards, yah!"
    n "至高者荣耀！愿她的史莱姆赐福我们可怜的胡子！"

# game/script.rpy:3209
translate schinese fashion_1_e52008bf:

    # b "’Ave a good break, boys. Don’t burn the place down, yeah?"
    b "祝你们休息愉快，小子们。别把店烧了，嗯？"

# game/script.rpy:3210
translate schinese fashion_1_432e4ad6:

    # n "Aye-aye, boss!"
    n "是是是，老板！"

# game/script.rpy:3211
translate schinese fashion_1_674ed16f:

    # n "(vhispering) Who’s de tall vone, eh? Looks like a stick dat learned ta valk!"
    n "（低声）那个高个子是谁？看着像根学会走路的棍子！"

# game/script.rpy:3212
translate schinese fashion_1_e08946d6:

    # n "(vhispering) Shh! Dat’s de Great One’s fool. Best keep yer tongue, unless ye fancy losin’ it, yah?"
    n "（低声）嘘！那是至高者的弄臣。最好管好你的舌头，除非你想丢掉它，懂吗？"

# game/script.rpy:3213
translate schinese fashion_1_d307d6c1:

    # n "Fool? Heh, looks more like *unfinished dwarf*, if ye ask me, heh!"
    n "弄臣？呵，要我说更像“没长完的矮人”，嘿！"

# game/script.rpy:3216
translate schinese fashion_1_abcd0443:

    # mc "Hold up— do they all sound like me?"
    mc "等等——他们都像我这么说话吗？"

# game/script.rpy:3218
translate schinese fashion_1_2932618b:

    # b "Now that ye mention it… nah. They sound like you after catchin’ a bleedin’ cold."
    b "你这么一说……不。听起来像你感冒之后的样子。"

# game/script.rpy:3223
translate schinese fashion_1_7ce55bb2:

    # mc "Fantastic. So I’m contagious now."
    mc "太棒了。所以我现在会传染了。"

# game/script.rpy:3225
translate schinese fashion_1_ceaa4933:

    # b "Oi, don’t mock ’em — them lads seen six wars and drunk four barrels o’ ale each."
    b "喂，别嘲笑他们——那些小子经历过六场战争，每人喝过四桶麦芽酒。"

# game/script.rpy:3226
translate schinese fashion_1_834922ed:

    # n "Aye! Five barrels, actually!"
    n "对！其实是五桶！"

# game/script.rpy:3228
translate schinese fashion_1_4f470ad7:

    # mc "You sure they’re not just drunk right now?"
    mc "你确定他们现在不是单纯喝醉了？"

# game/script.rpy:3229
translate schinese fashion_1_822eefd6:

    # n "Nay, lad, just... spiritually hydrated!"
    n "不是的，老弟，只是……精神上水满了！"

# game/script.rpy:3231
translate schinese fashion_1_462889cf:

    # b "Heh. Dwarf logic — can’t argue with it."
    b "呵。矮人逻辑——没法反驳。"

# game/script.rpy:3233
translate schinese fashion_1_536e3145:

    # mc "(gives her a deadpan look)"
    mc "（面无表情地看了她一眼）"

# game/script.rpy:3234
translate schinese fashion_1_cf4fa667:

    # b "Yeah, yeah. Move along, before they adopt you."
    b "是是是。继续走，别在他们把你收养了。"

# game/script.rpy:3238
translate schinese fashion_1_e00fb4c8:

    # b "Right then — off you go, and make it sing!"
    b "那么——去吧，好好表现！"

# game/script.rpy:3239
translate schinese fashion_1_0c9e8725:

    # mc "If I come back shorter, I’m blaming you."
    mc "我要是回来时更矮了，就怪你。"

# game/script.rpy:3253
translate schinese interview_3_b875aef1:

    # mc "(Whispering) Alright, I get the plan. But there’s one thing I missed — where exactly did it say I’d be giving you a massage?"
    mc "（低声）好吧，计划我懂了。但有件事我没搞明白——这上面哪儿写着要给你按摩？"

# game/script.rpy:3255
translate schinese interview_3_122a904e:

    # b "When you get all nervous, you start lookin’ for meaning where there ain't supposed to be any."
    b "你一紧张就开始在不该有意义的地方找意义。"

# game/script.rpy:3257
translate schinese interview_3_35a1f4c0:

    # mc "(Whispering) I just don’t like walking into something without a way out.)"
    mc "（低声）我只是不喜欢走进一个没有退路的地方。"

# game/script.rpy:3259
translate schinese interview_3_e8936491:

    # b "Your hands are shakin’."
    b "你的手在抖。"

# game/script.rpy:3261
translate schinese interview_3_402a2d5c:

    # mc "(Whispering) Maybe you’re a little right. Just a little.)"
    mc "（低声）也许你说得有点对。就一点点。"

# game/script.rpy:3262
translate schinese interview_3_d6683178:

    # mc "(Whispering) Reminds me of that joke — guy raises his hand to scare a girl, asks if she’s afraid, and she hits him with a frying pan asking if it hurts."
    mc "（低声）让我想起那个笑话——有个男的举手想吓女孩，问她害不怕，然后她一煎锅拍过去问他疼不疼。"

# game/script.rpy:3263
translate schinese interview_3_23aa8197:

    # mc "Now, imagine I’m the guy, and the one with the pan is Philip."
    mc "现在想象一下，我是那个男的，而拿煎锅的是菲利普。"

# game/script.rpy:3266
translate schinese interview_3_850ef128:

    # b "..."
    b "……"

# game/script.rpy:3267
translate schinese interview_3_a3ae19fe:

    # b "Relax, yeah? It’s gonna be fine. Trust me."
    b "放轻松，嗯？会没事的。相信我。"

# game/script.rpy:3269
translate schinese interview_3_8f2f0245:

    # mc "Reminder — killing me takes him one swing. And I’m not planning on dying early."
    mc "提醒一下——他一下就能杀了我。我可没打算提前死。"

# game/script.rpy:3270
translate schinese interview_3_598dde32:

    # mc "I’ve been a breath away from death once, and I’m not eager for a sequel."
    mc "我有过一次从鬼门关回来的经历，不想再来续集。"

# game/script.rpy:3272
translate schinese interview_3_37c3ac0a:

    # b "Once? Since when did you start lyin’ through your teeth?"
    b "一次？你从什么时候开始满嘴跑火车了？"

# game/script.rpy:3273
translate schinese interview_3_43ee1de4:

    # mc "The rest went... slightly better."
    mc "其他时候嘛……稍微好一点。"

# game/script.rpy:3274
translate schinese interview_3_11d2e063:

    # mc "(Even with that elf...)"
    mc "（就算跟那个精灵在一起也是……）"

# game/script.rpy:3278
translate schinese interview_3_6bae8be1:

    # mc "(No…)"
    mc "（不……）"

# game/script.rpy:3279
translate schinese interview_3_eb014842:

    # mc "(Not her. Not now. Not here.)"
    mc "（不是她。不是现在。不是在这里。）"

# game/script.rpy:3281
translate schinese interview_3_ebe7ff78:

    # mc "(This is bad. This is really, really bad. What the hell is Isabella doing in this place?!)"
    mc "（糟了。真的非常糟。伊莎贝拉跑到这种地方来干什么？！）"

# game/script.rpy:3282
translate schinese interview_3_3bf9260d:

    # mc "(I thought she never left their estate. So why is she here...)"
    mc "（我以为她从没离开过她们的宅邸。那她为什么会在这儿……）"

# game/script.rpy:3285
translate schinese interview_3_d49cb5c2:

    # mc "(It’s over before it even started...)"
    mc "（还没开始就结束了……）"

# game/script.rpy:3287
translate schinese interview_3_aba734a5:

    # mc "(Whispering) Bea — what the hell? You said it would only be Philip, one person! Not her."
    mc "（低声）碧翠丝——搞什么？你不是说只有菲利普一个人吗！不是她。"

# game/script.rpy:3289
translate schinese interview_3_443ec856:

    # b "With ’er? I ain’t got a clue what you’re on about—"
    b "跟她？我完全不知道你在说什么——"

# game/script.rpy:3291
translate schinese interview_3_bfe1a1c6:

    # b "(Whispers) What the hell’s she doin’ here?!"
    b "（低声）她跑到这儿来干什么？！"

# game/script.rpy:3293
translate schinese interview_3_0a4e1be1:

    # mc "(Whispering) I have to go. Now."
    mc "（低声）我得走了。马上。"

# game/script.rpy:3294
translate schinese interview_3_1c62a791:

    # mc "(Whispering) I can’t face her. Not today. Not like this."
    mc "（低声）我没法面对她。不是今天。不是这样。"

# game/script.rpy:3297
translate schinese interview_3_aca887ed:

    # b "(Whispers) Hide. I’ll keep her busy. You slip out the back, got it?"
    b "（低声）躲起来。我拖住她。你从后门溜走，懂吗？"

# game/script.rpy:3300
translate schinese interview_3_cc30340b:

    # mc "(Please… not now. Hold it together, [mc]... You’ve been through worse—)"
    mc "（求你了……别是现在。撑住，[mc]……你经历过更糟的——）"

# game/script.rpy:3301
translate schinese interview_3_285761b5:

    # mc "(Come on… come on... Don’t you dare pass out!)"
    mc "（快点……快点……你敢晕过去试试！）"

# game/script.rpy:3302
translate schinese interview_3_d54f217b:

    # b "(Whispers) [mc]? You’re not lookin’ so good—"
    b "（低声）[mc]？你看起来不太好——"

# game/script.rpy:3306
translate schinese interview_3_ce55b551:

    # b "(Whispers) hey, hey, stay with me. Breathe, yeah? We’ve been through worse than this."
    b "（低声）喂，喂，别走神。呼吸，嗯？我们经历过更糟的。"

# game/script.rpy:3307
translate schinese interview_3_bba3a786:

    # b "[mc]? Don’t you bloody dare… not again."
    b "[mc]？你可他妈的别……别又来。"

# game/script.rpy:3308
translate schinese interview_3_3874bbd6:

    # mc "(I… can’t… talk...)"
    mc "（我……说不出……话……）"

# game/script.rpy:3309
translate schinese interview_3_2e8b7bd9:

    # mc "(Air… I need air...)"
    mc "（空气……我需要空气……）"

# game/script.rpy:3310
translate schinese interview_3_64f25d6a:

    # mc "(Don’t blackout. Don’t.)"
    mc "（别晕。别。）"

# game/script.rpy:3311
translate schinese interview_3_bee78d30:

    # mc "(Just breathe. One breath.)"
    mc "（呼吸。一口气。）"

# game/script.rpy:3312
translate schinese interview_3_9fbc4541:

    # mc "(One— agh...)"
    mc "（一口——呃……）"

# game/script.rpy:3314
translate schinese interview_3_63970976:

    # b "(Idiot… you said you were over it, so what’s this then?)"
    b "（白痴……你说你已经放下了，那这是什么？）"

# game/script.rpy:3315
translate schinese interview_3_0692443a:

    # b "(Don’t you dare quit on me now — I’ve cried enough for both of us, you hear me?)"
    b "（你现在敢给我放弃试试——我已经替我们俩哭够了，听见没？）"

# game/script.rpy:3316
translate schinese interview_3_ebc952c3:

    # mc "Bea… I—"
    mc "碧翠丝……我——"

# game/script.rpy:3317
translate schinese interview_3_c049f4d7:

    # b "(Whispers) Don’t you — please, don’t say it…"
    b "（低声）别说——拜托，别说出来……"

# game/script.rpy:3319
translate schinese interview_3_54ba3ca3:

    # b "Oi! You two, over here!"
    b "喂！你们两个，过来！"

# game/script.rpy:3320
translate schinese interview_3_8af362dc:

    # "Boss? What happ—"
    "老板？怎么了——"

# game/script.rpy:3321
translate schinese interview_3_f6ff4dc3:

    # b "You — call an ambulance, now!"
    b "你——叫救护车，现在！"

# game/script.rpy:3322
translate schinese interview_3_19a63983:

    # b "And you — get him outta here!"
    b "还有你——把他弄出去！"

# game/script.rpy:3325
translate schinese interview_3_9fb76c3b:

    # Lil "What’s going on? Are you alright?"
    Lil "怎么回事？你没事吧？"

# game/script.rpy:3326
translate schinese interview_3_5e4c6a17:

    # Lil "Beatrice?"
    Lil "碧翠丝？"

# game/script.rpy:3328
translate schinese interview_3_00f6fae9:

    # b "Yeah… I’m fine. More or less."
    b "嗯……我没事。差不多吧。"

# game/script.rpy:3330
translate schinese interview_3_d09aa6bb:

    # Lil "That the guy you were talking about?"
    Lil "就是你说的那个人吗？"

# game/script.rpy:3332
translate schinese interview_3_4a68fb00:

    # b "Lili, I’m sorry — you’ll have to handle it on your own today."
    b "莉莉，我很抱歉——今天你得自己撑了。"

# game/script.rpy:3333
translate schinese interview_3_e4230a51:

    # b "I’m so sorry—"
    b "真的对不起——"

# game/script.rpy:3335
translate schinese interview_3_7e558cf7:

    # Lil "No worries. It’ll be tough, sure — but I’ll manage somehow. Go."
    Lil "没事。会很难，但……我总能想办法的。去吧。"

# game/script.rpy:3338
translate schinese interview_3_669288be:

    # b "You’re the best, really. I owe you one, big time."
    b "你真的很棒。我欠你一个大人情。"

# game/script.rpy:3340
translate schinese interview_3_9be3e8de:

    # i "(That voice… no, it cannot be… and yet—)"
    i "（那个声音……不，不可能……可是——）"

# game/script.rpy:3341
translate schinese interview_3_0f7e0c40:

    # i "(My heart remembers that rhythm, even through the walls.)"
    i "（隔着墙，我的心也记得那个节奏。）"

# game/script.rpy:3342
translate schinese interview_3_fc286843:

    # p "(Whispering) And where d’you think you’re goin’, eh? Father put you on me for a reason."
    p "（低声）你以为你要去哪儿，嗯？父亲把你交给我是有原因的。"

# game/script.rpy:3343
translate schinese interview_3_86d5d74a:

    # i "(Whispering) I thought I saw a familiar face."
    i "（低声）我以为我看到了一张熟悉的脸。"

# game/script.rpy:3345
translate schinese interview_3_9e0d53fd:

    # p "(Whispering) So you’d ditch me to chase a ghost? Relax, sister — he’s dead. Your precious darling’s long gone."
    p "（低声）所以你要丢下我去追一个鬼影？放松吧，姐姐——他已经死了。你那宝贝心上人早就没了。"

# game/script.rpy:3347
translate schinese interview_3_bf6b11b2:

    # i "(Whispering) He still lives within my heart."
    i "（低声）他仍活在我心里。"

# game/script.rpy:3348
translate schinese interview_3_72c9a80c:

    # p "(Whispering) That bastard—"
    p "（低声）那个混账——"

# game/script.rpy:3349
translate schinese interview_3_2322e5c3:

    # i "(Whispering) Brother."
    i "（低声）哥哥。"

# game/script.rpy:3352
translate schinese interview_3_519acbe2:

    # p "(Whispering) Aye, aye... I’ll behave. No need to glare."
    p "（低声）是是是……我会乖的。不用瞪我。"

# game/script.rpy:3355
translate schinese interview_3_6fcae26c:

    # b "It’s an honour, truly, to meet you in person, Your Greatness. The rumours didn’t lie — you’re every bit as charming as they say."
    b "陛下，能当面见到您真是我的荣幸。传闻没有说谎——您果然跟他们说的一样迷人。"

# game/script.rpy:3356
translate schinese interview_3_4b485c3c:

    # p "Still the silver tongue, eh, Beatrice?"
    p "还是那张三寸不烂之舌啊，碧翠丝？"

# game/script.rpy:3357
translate schinese interview_3_3bde6718:

    # p "Gotta admit— music to my ears. But spare me the flattery, we’re not strangers here."
    p "得承认——真悦耳。但恭维就免了，我们不是外人。"

# game/script.rpy:3358
translate schinese interview_3_5e172668:

    # b "With all due respect, Philip — I’m working. And even I have to keep up appearances sometimes."
    b "恕我直言，菲利普——我在工作。而且就连我也偶尔得做点样子。"

# game/script.rpy:3360
translate schinese interview_3_d9b4aa62:

    # p "Oh, come now, don’t start that ‘I’m on duty’ nonsense. It doesn’t suit you one bit."
    p "哎呀，得了，别来这套“我在执勤”的废话。那一点都不适合你。"

# game/script.rpy:3361
translate schinese interview_3_1702f5bd:

    # b "I’ll take that as a compliment. But I’m afraid I’ve got to run — something’s come up. Lili will be covering for me."
    b "我就当这是夸奖了。但恐怕我得走了——出了点事。莉莉会替我顶班。"

# game/script.rpy:3362
translate schinese interview_3_06aace10:

    # p "Let me guess — that clown’s to blame, ain’t he? Bloody hilarious."
    p "我猜——怪那个小丑，对吧？真够可乐的。"

# game/script.rpy:3363
translate schinese interview_3_51d79e0f:

    # b "Strength ain’t about reflection, it’s about fightin’ your way into the light with your own damn hands. Have a good day, yeah?"
    b "强大不是靠反思，是靠用你自己那双该死的手，一路打进光里。祝你今天愉快，嗯？"

# game/script.rpy:3365
translate schinese interview_3_67400f1c:

    # i "(So it truly was him… that voice still warms my soul, and turns my sorrow into light.)"
    i "（所以真的是他……那个声音依然温暖我的灵魂，把我的悲伤化作光。）"

# game/script.rpy:3366
translate schinese interview_3_f93ba4af:

    # i "(How bitterly sweet, to see you once more… how cruelly my heart tightens at your shadow.)"
    i "（再次见到你，何苦又何甜……你的影子却让我的心如此残酷地收紧。）"

# game/script.rpy:3375
translate schinese interview_3_7c8a4223:

    # b "Yeah, sorry, ran into a bit of a mess on my end."
    b "嗯，抱歉，我这边出了点乱子。"

# game/script.rpy:3376
translate schinese interview_3_db563b3d:

    # b "Lili’ll handle it. She’s bloody brilliant at what she does."
    b "莉莉会处理。她干这行真他妈聪明。"

# game/script.rpy:3377
translate schinese interview_3_976b81b5:

    # b "Yeah… it’s ‘cause of his sister."
    b "嗯……是因为他妹妹。"

# game/script.rpy:3378
translate schinese interview_3_1ff9175c:

    # b "Talk soon."
    b "回聊。"

# game/script.rpy:3381
translate schinese interview_3_1abe5a37:

    # b "(All that prep for the interview… all that bloody work — gone in a blink.)"
    b "（为了这场访谈准备的那些……那些他妈的功夫——眨眼就没了。）"

# game/script.rpy:3382
translate schinese interview_3_b3b92be5:

    # b "(Why today, of all days, did she decide to show her face?! It’s not even funny.)"
    b "（偏偏是今天，她为什么要露脸？！一点都不好笑。）"

# game/script.rpy:3383
translate schinese interview_3_290da537:

    # b "(And him… Look at the state you’re in. You really think you’re makin’ it to the Academy tomorrow? Give me a break!)"
    b "（还有他……看看你这副样子。你真觉得自己明天能进学院？得了吧！）"

# game/script.rpy:3384
translate schinese interview_3_c4201a96:

    # b "Pick up the damn phone already."
    b "快他妈接电话。"

# game/script.rpy:3386
translate schinese interview_3_e4ae3665:

    # b "Come on, answer the bloody thing!"
    b "喂，接电话啊！"

# game/script.rpy:3389
translate schinese interview_3_ecc57bce:

    # L "(Quota’s crushed. Nailed it, Lena, hell yeah!)"
    L "（配额达标了。干得漂亮，莉娜，爽！）"

# game/script.rpy:3390
translate schinese interview_3_842f8b90:

    # L "(Though, ugh… tomorrow my body’s gonna scream from that workout.."
    L "（不过，呃……明天全身都得因为那场训练惨叫了……）"

# game/script.rpy:3392
translate schinese interview_3_80cdb918:

    # L "(Eh, pain means progress. No pain — no gain, right?)"
    L "（呃，痛苦意味着进步。没有痛苦——就没有收获，对吧？）"

# game/script.rpy:3393
translate schinese interview_3_367fdd5a:

    # L "Alright, time to head to wor—"
    L "好，该去上班了——"

# game/script.rpy:3394
translate schinese interview_3_ee194a0d:

    # L "(Beatrice?)"
    L "（碧翠丝？）"

# game/script.rpy:3398
translate schinese interview_3_3742a0fc:

    # L "Hey, hey! How’s the interview going? He’s not freaking out too much, is he?"
    L "喂，喂！访谈怎么样了？他没太失控吧？"

# game/script.rpy:3400
translate schinese interview_3_24f31e55:

    # b "He’s fine — for now. Ridin’ in an ambulance. The idiot passed out again."
    b "他没事——暂时。正坐救护车呢。那个白痴又晕过去了。"

# game/script.rpy:3402
translate schinese interview_3_6a4b61d9:

    # L "WHAT?! HOW?!"
    L "什么？！怎么会？！"

# game/script.rpy:3404
translate schinese interview_3_66add924:

    # b "I’m tailin’ ‘em on my bike — North Hospital, Sixth District. I’ll be waitin’ there."
    b "我正骑车跟着——北区医院，第六区。我在那儿等。"

# game/script.rpy:3405
translate schinese interview_3_5d57c841:

    # b "If you’re free—"
    b "你要是有空——"

# game/script.rpy:3407
translate schinese interview_3_aeaaee00:

    # L "I’m on my way — right now!"
    L "我马上出发——现在就去！"

# game/script.rpy:3418
translate schinese interview_3_7ada41e3:

    # Lil "A very good evening to you all! Tonight, you’re watching Evening with the Stars! And with you, as always — your host, Lily."
    Lil "各位晚上好！今晚收看《明星之夜》！依旧由我陪伴——主持人莉莉。"

# game/script.rpy:3419
translate schinese interview_3_645672b1:

    # Lil "And the Great One himself — in person!"
    Lil "还有至高者本人——现场！"

# game/script.rpy:3421
translate schinese interview_3_7498c513:

    # p "Ha! My thanks for the invitation, truly."
    p "哈！真感谢你的邀请。"

# game/script.rpy:3424
translate schinese interview_3_e9b8db3f:

    # p "(Smile’s on. Now to boost that damn rating— spin a few noble tales and walk out shining.)"
    p "（笑脸上线。现在去刷那该死的评分——编几个高尚的故事，风风光光地走出去。）"

# game/script.rpy:3426
translate schinese interview_3_96533557:

    # Lil "But that’s not all! Joining him tonight — a surprise guest, his younger sister, Isabella!"
    Lil "但这还不是全部！今晚还有一位神秘嘉宾加盟——他的妹妹，伊莎贝拉！"

# game/script.rpy:3427
translate schinese interview_3_cd898957:

    # Lil "Former idol star, and the heartbreaker of every boy in her school days!"
    Lil "前偶像巨星，学生时代没有一个男孩逃得过她的心！"

# game/script.rpy:3428
translate schinese interview_3_6f3d4875:

    # i "..."
    i "……"

# game/script.rpy:3429
translate schinese interview_3_ae26a245:

    # p "(Why’re you quiet? Say somethin’, don’t look weak.)"
    p "（怎么不说话？说点什么，别显得软弱。）"

# game/script.rpy:3431
translate schinese interview_3_099b3f8c:

    # p "Forgive her — she’s not used to events like these. Truth be told, tonight’s the first time she’s stepped outside in months."
    p "请原谅她——她不习惯这种场合。说实话，今晚是她几个月来第一次出门。"

# game/script.rpy:3433
translate schinese interview_3_3a01a000:

    # Lil "(She’s rather silent... and from the files I’ve got, quite an easy catch.)"
    Lil "（她相当沉默……从我手上的档案来看，是个相当容易到手的目标。）"

# game/script.rpy:3434
translate schinese interview_3_361d7c76:

    # Lil "Really now? And all that just for this event? What an honor for us."
    Lil "真的吗？这么大阵仗就为了这场活动？我们真是荣幸。"

# game/script.rpy:3436
translate schinese interview_3_687caf10:

    # Lil "(Push her just a little... she’ll crack.)"
    Lil "（稍微推一把……她就会崩。）"

# game/script.rpy:3437
translate schinese interview_3_5f02c3d5:

    # i "Mutual."
    i "彼此彼此。"

# game/script.rpy:3438
translate schinese interview_3_005670ea:

    # Lil "..."
    Lil "……"

# game/script.rpy:3441
translate schinese interview_3_61d21c09:

    # Lil "Ahem— well then, let’s get straight to it! Many have been wondering about the {b}humanity{/b} of your actions today at the mall."
    Lil "咳咳——那么我们直奔主题！很多人都在好奇，您今天在商场的行动究竟有没有{b}人性{/b}。"

# game/script.rpy:3442
translate schinese interview_3_1fccf07e:

    # Lil "How would you comment on what happened?"
    Lil "对发生的事，您有什么要说的？"

# game/script.rpy:3445
translate schinese interview_3_c118c6f6:

    # p "(Ah, straight to the hard questions, are we? Fine. Let’s play it by the book.)"
    p "（啊，直接问硬问题？好吧。就按规矩来。）"

# game/script.rpy:3447
translate schinese interview_3_894dedbd:

    # p "As I’ve said before, my only intent was to protect the innocent."
    p "正如我之前说过的，我唯一的目的是保护无辜者。"

# game/script.rpy:3448
translate schinese interview_3_e0dcbeb6:

    # p "Those… people sought to harm them, and I simply couldn’t stand by."
    p "那些……人试图伤害他们，我实在无法袖手旁观。"

# game/script.rpy:3450
translate schinese interview_3_acd5b320:

    # p "(Go on, swallow it. I’ll even shed a tear if that’s what sells.)"
    p "（咽下去吧。要是这能卖出去，我甚至可以挤滴眼泪。）"

# game/script.rpy:3451
translate schinese interview_3_84122faa:

    # Lil "Just as we thought. You acted out of good intentions!"
    Lil "正如我们所想。您是出于善意行动的！"

# game/script.rpy:3452
translate schinese interview_3_5b2be18e:

    # Lil "(Same old act... Alright then — let’s go through his sister.)"
    Lil "（还是老一套……好吧——那我们来审他妹妹。）"

# game/script.rpy:3454
translate schinese interview_3_06e0dd3f:

    # Lil "And how would your sister comment on that?"
    Lil "令妹对此会怎么评价？"

# game/script.rpy:3455
translate schinese interview_3_b9fcb31e:

    # i "(He’s making excuses again… as always)"
    i "（他又开始找借口了……一如既往）"

# game/script.rpy:3457
translate schinese interview_3_7f8466c4:

    # i "Failure."
    i "失败。"

# game/script.rpy:3459
translate schinese interview_3_0b754125:

    # Lil "(What?)"
    Lil "（什么？）"

# game/script.rpy:3460
translate schinese interview_3_cd5e3ec3:

    # Lil "What do you mean by that?"
    Lil "你这话是什么意思？"

# game/script.rpy:3462
translate schinese interview_3_281716cb:

    # i "It was a complete failure."
    i "那是一场彻头彻尾的失败。"

# game/script.rpy:3463
translate schinese interview_3_41ed67db:

    # i "My brother made a mistake — one that cost lives."
    i "我哥哥犯了个错——一个害死了人的错。"

# game/script.rpy:3464
translate schinese interview_3_3ca35f29:

    # p "(What the hell’re you doing?! We had a plan!)"
    p "（你他妈在干什么？！我们说好的计划！）"

# game/script.rpy:3466
translate schinese interview_3_1ed06396:

    # p "(Whispering) What are you playing at?"
    p "（低声）你在打什么算盘？"

# game/script.rpy:3468
translate schinese interview_3_35593757:

    # i "(Whispering) Escaping the grave you dug for us."
    i "（低声）从你替我们挖的坟墓里逃走。"

# game/script.rpy:3470
translate schinese interview_3_5c7d7397:

    # i "We understand that apologies alone will not suffice."
    i "我们明白，仅凭道歉是不够的。"

# game/script.rpy:3471
translate schinese interview_3_d6a813f7:

    # i "That is why our family will offer compensation to those who’ve lost their loved ones—"
    i "所以我们家族将对那些失去挚爱的人提供赔偿——"

# game/script.rpy:3472
translate schinese interview_3_27270a23:

    # i "as a sign of our remorse… and acknowledgment of our faults."
    i "以表明我们的悔意……以及对我们过错的承认。"

# game/script.rpy:3474
translate schinese interview_3_d78f350f:

    # Lil "Th—that’s... quite an unexpected confession."
    Lil "这、这……真是出人意料的坦白。"

# game/script.rpy:3475
translate schinese interview_3_dba6bc35:

    # Lil "(She’ll be tough.)"
    Lil "（她不好对付。）"

# game/script.rpy:3476
translate schinese interview_3_14df304d:

    # Lil "(Change the subject... or press harder?)"
    Lil "（换个话题……还是逼得更紧？）"

# game/script.rpy:3477
translate schinese interview_3_56ca7543:

    # Lil "Moving on to the next question — many are curious about what happened to you. Why did you end your career so suddenly?"
    Lil "下一个问题——很多人好奇你身上发生了什么。你为什么这么突然就退役了？"

# game/script.rpy:3479
translate schinese interview_3_cdb288eb:

    # i "I cannot answer that."
    i "我无法回答。"

# game/script.rpy:3480
translate schinese interview_3_fe22f0c5:

    # Lil "(Straight to the face…)"
    Lil "（直接怼脸……）"

# game/script.rpy:3482
translate schinese interview_3_618aa7a3:

    # Lil "Then, allow me to read two rumors that have been circulating about your disappearance. You don’t mind, do you?"
    Lil "那请容我读两条关于你失踪的流传传闻。"

# game/script.rpy:3484
translate schinese interview_3_e78b642e:

    # p "Let’s skip that part, shall we? She’s still recovering from... what happened before."
    p "跳过那部分好吗？她还在从……之前发生的事里恢复。"

# game/script.rpy:3485
translate schinese interview_3_d8b509e8:

    # Lil "(He’s sharper than before… Should I try poking his ego?)"
    Lil "（他比以前更敏锐了……要不要试试戳他的自尊？）"

# game/script.rpy:3487
translate schinese interview_3_2cb2911d:

    # Lil "A question for the Great One himself: what are your thoughts on the Hero Academy — and its opening to ordinary citizens this year?"
    Lil "给至高者一个问题：您怎么看英雄学院——以及今年向普通市民开放这件事？"

# game/script.rpy:3489
translate schinese interview_3_8376c23b:

    # p "An interesting idea— on paper, I’ll admit. But in practice? Not everyone’s fit to be a hero."
    p "一个有意思的想法——纸面上，我承认。但落到实处？并不是每个人都适合当英雄。"

# game/script.rpy:3490
translate schinese interview_3_6af5def3:

    # p "It cheapens the very title we bleed for."
    p "这贬低了我们为之流血的这个称号。"

# game/script.rpy:3491
translate schinese interview_3_49fb16ab:

    # Lil "(Got him.)"
    Lil "（上钩了。）"

# game/script.rpy:3493
translate schinese interview_3_c01cc2f7:

    # Lil "So you’re saying ordinary people have no right to grow stronger?"
    Lil "所以您的意思是，普通人没有权利变强？"

# game/script.rpy:3495
translate schinese interview_3_22579d37:

    # p "(Of course you don’t get it. You mortals whine and hide while we do the dying.)"
    p "（你当然不懂。你们这些凡人一边哀嚎一边躲着，而死的是我们。）"

# game/script.rpy:3497
translate schinese interview_3_fb78598a:

    # p "No, I simply mean it’s... impractical."
    p "不，我的意思只是这……不切实际。"

# game/script.rpy:3498
translate schinese interview_3_3b2f2cfc:

    # p "They’ll drag the rest of us down— weaken the class, ruin the standard."
    p "他们会把我们其他人拖下去——拉低整体水平，毁掉标准。"

# game/script.rpy:3499
translate schinese interview_3_1fa99bd5:

    # p "And that, love, will drag down the quality — and the very name — of what it means to be a hero."
    p "而那，亲爱的，会拉低“英雄”这两个字的质量——和它的名声。"

# game/script.rpy:3501
translate schinese interview_3_65b1c29c:

    # Lil "(Your arrogance always sells best. Just a bit more, and I’ve got my headline.)"
    Lil "（你的傲慢永远最好卖。再多一点点，我的头条就有了。）"

# game/script.rpy:3502
translate schinese interview_3_48c56ca1:

    # i "(Your pride, brother… it will be your undoing.)"
    i "（你的骄傲，哥哥……会成为你的掘墓人。）"

# game/script.rpy:3504
translate schinese interview_3_ba6d990c:

    # Lil "So, you confirm then — that ordinary people are mere ballast to you?"
    Lil "那么您确认了——普通人对您来说只是压舱物？"

# game/script.rpy:3505
translate schinese interview_3_cc0e99a5:

    # Lil "Don’t you find that a bit hypocritical, for someone who vowed to protect them?"
    Lil "对于一个发誓要保护他们的人，你不觉得这有点虚伪吗？"

# game/script.rpy:3509
translate schinese interview_3_3a5e534f:

    # p "(Whispering) Shit."
    p "（低声）糟了。"

# game/script.rpy:3510
translate schinese interview_3_f35bd903:

    # Lil "Pardon? What did you say? We didn’t quite catch that."
    Lil "抱歉？你说什么？没太听清。"

# game/script.rpy:3511
translate schinese interview_3_76c36174:

    # i "(He’s about to lose his temper…)"
    i "（他快发火了……）"

# game/script.rpy:3512
translate schinese interview_3_c83eb0fc:

    # i "(and when he does, Father will be furious.)"
    i "（而他一发火，父亲就会大发雷霆。）"

# game/script.rpy:3515
translate schinese interview_3_776d94d5:

    # i "He did not mean all people."
    i "他指的不是所有人。"

# game/script.rpy:3517
translate schinese interview_3_7cd96662:

    # i "Only one."
    i "只有一个人。"

# game/script.rpy:3519
translate schinese interview_3_ac84addb:

    # Lil "What do you mean?"
    Lil "你什么意思？"

# game/script.rpy:3521
translate schinese interview_3_6f3d4875_1:

    # i "..."
    i "……"

# game/script.rpy:3523
translate schinese interview_3_468959bd:

    # i "A man he once called his dearest friend."
    i "一个他曾称作挚友的人。"

# game/script.rpy:3524
translate schinese interview_3_f91c0496:

    # i "And… my first love."
    i "以及……我的初恋。"

# game/script.rpy:3526
translate schinese interview_3_d69cf82a:

    # Lil "Wh—"
    Lil "什——"

# game/script.rpy:3527
translate schinese interview_3_b234b4c8:

    # i "We’re leaving."
    i "我们走。"

# game/script.rpy:3530
translate schinese interview_3_d19f855d:

    # c "..."
    c "……"

# game/script.rpy:3532
translate schinese interview_3_0a4e60ab:

    # c "Turned the whole damn thing on its head, didn’t she? Took the hit herself."
    c "她把整件事翻了个个儿，对吧？把刀接了过去。"

# game/script.rpy:3533
translate schinese interview_3_a79611e5:

    # c "Hnh. Just like her mother..."
    c "哼。就像她母亲一样……"

# game/script.rpy:3535
translate schinese interview_3_0c2de4ff:

    # c "Status report — ratings?"
    c "汇报——评分如何？"

# game/script.rpy:3536
translate schinese interview_3_8ef82233:

    # n "It’s climbing, sir. The news about it’s overshadowed Philip’s failure. And her compensation— it’s put your family in a good light."
    n "在上升，长官。这件事的热度盖过了菲利普的失败。而她的赔偿——让你们家族脸上很好看。"

# game/script.rpy:3537
translate schinese interview_3_0819704a:

    # c "Good. That’ll do."
    c "很好。可以。"

# game/script.rpy:3538
translate schinese interview_3_2adbb0e2:

    # n "But... what about that guy?"
    n "可是……那家伙怎么办？"

# game/script.rpy:3539
translate schinese interview_3_d19f855d_1:

    # c "..."
    c "……"

# game/script.rpy:3543
translate schinese interview_3_77dc42d7:

    # c "We will see."
    c "走着瞧。"

# game/script.rpy:3554
translate schinese interview_3_8c22bd44:

    # "He needs rest. His nervous system was put under too much strain in too short a time."
    "他需要休息。他的神经系统在太短时间内承受了过大压力。"

# game/script.rpy:3555
translate schinese interview_3_88183b9e:

    # b "Wot you on about? This ain’t a panic attack?"
    b "你在说什么？这不是恐慌发作吗？"

# game/script.rpy:3556
translate schinese interview_3_bda82a12:

    # "A variation of it, yes."
    "是它的变体。"

# game/script.rpy:3557
translate schinese interview_3_87b26ce2:

    # "Under normal conditions, he would have managed. However, there was an external trigger involved."
    "正常情况下他撑得住。但这次有外部诱因。"

# game/script.rpy:3560
translate schinese interview_3_9f9e0e97:

    # "No physical stress for now. A couple of days, and he should recover."
    "身体上没有大碍。休息两天应该就能恢复。"

# game/script.rpy:3561
translate schinese interview_3_b56eb0ba:

    # b "Right... cheers for that."
    b "好……谢谢你啊。"

# game/script.rpy:3562
translate schinese interview_3_7d549d37:

    # b "(Bloody idiot... absolute idiot... I swore I’d keep ‘im safe, swore I’d make things right, swore…)"
    b "（该死白痴……完全是白痴……我发誓要保护他，发誓要把事情做对，发誓……）"

# game/script.rpy:3564
translate schinese interview_3_1d9a59c9:

    # b "(And look at ‘im now, yeah?)"
    b "（你看看他现在，啊？）"

# game/script.rpy:3565
translate schinese interview_3_07a4fd23:

    # b "(Shining lad turned to pieces…)"
    b "（光鲜的小伙子碎成了一地……）"

# game/script.rpy:3566
translate schinese interview_3_37829b60:

    # b "(I was so sure he’d handle it. Never doubted him. Guess I was the one talkin’ rubbish.)"
    b "（我那么确定他能撑住。从没怀疑过他。看来说废话的是我。）"

# game/script.rpy:3567
translate schinese interview_3_1136f824:

    # b "(Shouldn’t have pushed ‘im that hard…)"
    b "（不该逼他逼得那么紧……）"

# game/script.rpy:3569
translate schinese interview_3_df21db60:

    # L "Yeah, I’m here for [mc]. Yes, yes, guardian, whatever—"
    L "是的，我来找[mc]的。对对对，监护人，随便——"

# game/script.rpy:3570
translate schinese interview_3_5422cb89:

    # L "just let me in already!"
    L "快让我进去！"

# game/script.rpy:3572
translate schinese interview_3_850ef128_1:

    # b "..."
    b "……"

# game/script.rpy:3575
translate schinese interview_3_61d1a5a9:

    # L "Where is he?!"
    L "他在哪儿？！"

# game/script.rpy:3576
translate schinese interview_3_626b1e0f:

    # b "Oi, look who finally showed up. ’Bout time — glad you’re here, really."
    b "哟，看看谁终于来了。可算来了——真高兴你来了。"

# game/script.rpy:3578
translate schinese interview_3_2d224073:

    # L "What the hell happened?! A couple hours ago he looked totally fine — how did we end up {b}back here{/b} again?!"
    L "到底发生了什么？！两小时前他还好好——我们怎么又{b}回到这儿{/b}了？！"

# game/script.rpy:3579
translate schinese interview_3_66b5fe8c:

    # b "One little surprise run-in, ruined the whole bloody thing."
    b "一次小小的意外碰面，搞砸了整件事。"

# game/script.rpy:3580
translate schinese interview_3_f48a0f2e:

    # L "What? Philip? No way— he wouldn’t—"
    L "什么？菲利普？不会吧——他不会——"

# game/script.rpy:3581
translate schinese interview_3_f04b5d21:

    # b "Isabelle."
    b "伊莎贝拉。"

# game/script.rpy:3584
translate schinese interview_3_9993b94e:

    # L "..."
    L "……"

# game/script.rpy:3585
translate schinese interview_3_921b2a0e:

    # b "She just popped outta nowhere, broad daylight, like thunder in a clear sky."
    b "她就那么凭空冒出来，光天化日，像晴天霹雳。"

# game/script.rpy:3586
translate schinese interview_3_076061c1:

    # b "No whispers for years — and bam — today of all days, when the muppet had a meetin’."
    b "好几年没动静——然后砰——偏偏是今天，偏偏在小丑有约的时候。"

# game/script.rpy:3588
translate schinese interview_3_d8040d59:

    # L "That… actually explains it. But—"
    L "那……确实说得通。可是——"

# game/script.rpy:3589
translate schinese interview_3_03dc4d46:

    # L "he’s got his Academy interview tomorrow! If he doesn’t show up—"
    L "他明天还有学院面试！要是他不出现——"

# game/script.rpy:3590
translate schinese interview_3_e943d1ed:

    # L "I..."
    L "我……"

# game/script.rpy:3592
translate schinese interview_3_31a7a8f0:

    # L "What did the doctors say?"
    L "医生怎么说？"

# game/script.rpy:3595
translate schinese interview_3_684e45ad:

    # b "They said he got triggered. Needs downtime. But when he wakes up..."
    b "他们说是被触发了。需要静养。但他醒来之后……"

# game/script.rpy:3596
translate schinese interview_3_58941adc:

    # b "...I dunno."
    b "……我不知道。"

# game/script.rpy:3598
translate schinese interview_3_88b732a9:

    # L "So he’s out cold, and there’s no way to wake him?"
    L "所以他睡死了，叫不醒？"

# game/script.rpy:3599
translate schinese interview_3_9f18923d:

    # L "Oh, that’s {b}just perfect{/b}! Absolutely brilliant, Beatrice!"
    L "哦，那可{b}真是完美{/b}！太聪明了，碧翠丝！"

# game/script.rpy:3601
translate schinese interview_3_cb1452c3:

    # L "What the hell were you thinking?!"
    L "你他妈当时在想什么？！"

# game/script.rpy:3602
translate schinese interview_3_0f36459f:

    # L "You {b}knew{/b} about his trauma — even without Isabelle, just having Philip there was enough to break him!"
    L "你{b}知道{/b}他的创伤——就算没有伊莎贝拉，光是菲利普在场就够让他崩溃了！"

# game/script.rpy:3603
translate schinese interview_3_21ab3b18:

    # b "I figured he could push through it."
    b "我以为他能挺过去。"

# game/script.rpy:3605
translate schinese interview_3_a9743699:

    # L "I thought he could handle it? You {b}thought{/b}?!"
    L "我以为他能应付？你{b}以为{/b}？！"

# game/script.rpy:3606
translate schinese interview_3_c7c3b9ca:

    # L "Look at what your damn “thinking” got him into!"
    L "看看你那该死的“思考”把他害成什么样！"

# game/script.rpy:3607
translate schinese interview_3_81d73789:

    # L "He worked his ass off for this — to get into the Academy, to pass every test — and the moment he finally had a chance, {b}bam!"
    L "他为这个拼了命——为了进学院，为了通过每一场测试——等他终于有了机会，{b}砰！{/b}"

# game/script.rpy:3609
translate schinese interview_3_2f05bc14:

    # b "Enough. I feel worst outta everyone here, Len. Don’t start actin’ like I’m the bloody villain."
    b "够了。在这儿我最难受的人是我，莉娜。别装得好像我是那个反派。"

# game/script.rpy:3611
translate schinese interview_3_23303804:

    # b "(Like I’m some monster, yeah… all I wanted was to help him fight through it…)"
    b "（好像我是个怪物一样……我只想帮他挺过去……）"

# game/script.rpy:3616
translate schinese interview_3_99daa0d3:

    # mc "In this whole mess? I’d blame the Brits."
    mc "这么一摊乱麻？我会怪英国人。"

# game/script.rpy:3618
translate schinese interview_3_9993b94e_1:

    # L "..."
    L "……"

# game/script.rpy:3620
translate schinese interview_3_5d34c7ed:

    # L "…Idiot."
    L "……笨蛋。"

# game/script.rpy:3623
translate schinese interview_3_7aabb2b8:

    # L "You know how worried we were about you?!"
    L "你知道我们有多担心你吗？！"

# game/script.rpy:3624
translate schinese interview_3_7c16c2ac:

    # b "Tosser, I’m glad you’re awake..."
    b "混蛋，你醒过来真是太好了……"

# game/script.rpy:3625
translate schinese interview_3_5562bd13:

    # mc "Hey— easy there, you’re gonna squeeze the life outta me!"
    mc "喂——轻点，你要把我的命挤没了！"

# game/script.rpy:3633
translate schinese interview_3_35c91931:

    # L "…and now you wake up here."
    L "……现在你在这儿醒来了。"

# game/script.rpy:3635
translate schinese interview_3_2d01c02b:

    # mc "So that’s how I ended up here, huh? For a second I thought my brain was playin’ ‘Guess That Flashback."
    mc "所以我就是这样到这儿来的，嗯？刚才有一瞬间我以为我脑子在玩“猜猜这段闪回”。"

# game/script.rpy:3636
translate schinese interview_3_b7fd375d:

    # mc "And yeah... that hurt. I’ll give it that."
    mc "而且……确实疼。这点我承认。"

# game/script.rpy:3638
translate schinese interview_3_96ae6d26:

    # L "So… what now? The Academy’s tomorrow, and she’ll most likely show up too."
    L "那么……现在怎么办？学院明天就到了，她多半也会出现。"

# game/script.rpy:3641
translate schinese interview_3_3106f035:

    # L "If today happens again… the consequences will be way, way worse."
    L "如果今天的事再发生一次……后果会严重得多得多。"

# game/script.rpy:3642
translate schinese interview_3_8d849025:

    # b "Doc said if he don't take it easy, yeah, it’ll keep happenin’. And next time it won’t be just a lil’ blackout — it'll be worse. Proper worse."
    b "医生说如果他不悠着点，还会再犯。而且下次就不只是小昏迷了——会更糟。糟得多。"

# game/script.rpy:3644
translate schinese interview_3_4e1c8254:

    # mc "I’d rather not think about it right now. Especially when I’ve got such a lovely view— of two perfect hills."
    mc "我现在不太想这个。尤其当我正有这么美的景色——两座完美的山丘。"

# game/script.rpy:3646
translate schinese interview_3_f3ef8c71:

    # L "Stop joking around, I’m being serious."
    L "别开玩笑了，我认真的。"

# game/script.rpy:3647
translate schinese interview_3_67a24039:

    # L "Your health’s on the line here, dummy."
    L "你身体还悬着呢，笨蛋。"

# game/script.rpy:3649
translate schinese interview_3_cfcc2293:

    # mc "I know."
    mc "我知道。"

# game/script.rpy:3650
translate schinese interview_3_8e3db8f7:

    # mc "And trust me, it does bother me. I just… after all that, I need a bit of quiet, y’know?"
    mc "相信我，这确实困扰着我。我只是……经历了那些之后，我需要一点安静，懂吗？"

# game/script.rpy:3651
translate schinese interview_3_cbe5a132:

    # mc "No drama, no talk about tomorrow. Just peace."
    mc "不要折腾，不要谈明天。只要安宁。"

# game/script.rpy:3652
translate schinese interview_3_7e8e6090:

    # mc "Now let me enjoy the view, yeah?"
    mc "现在让我欣赏一下风景，嗯？"

# game/script.rpy:3654
translate schinese interview_3_5d77727c:

    # L "Everything for you, my dear prince."
    L "一切都给你，我亲爱的王子。"

# game/script.rpy:3656
translate schinese interview_3_f5e9cb31:

    # mc "Prince? Wait— hold on, wasn’t I a king last time? A fool, sure, but still a king."
    mc "王子？等等——慢着，我上次不是国王吗？虽然是蠢货，但仍是国王。"

# game/script.rpy:3658
translate schinese interview_3_94bdb5d9:

    # L "People revolted — kicked you right off the throne. History’s brutal, huh?"
    L "人民造反了——把你从王座上踹了下来。历史很残酷，对吧？"

# game/script.rpy:3660
translate schinese interview_3_ec0d20ce:

    # mc "Life’s never fair… not even in daydreams."
    mc "人生从不公平……连白日梦都不例外。"

# game/script.rpy:3661
translate schinese interview_3_9fb7ae18:

    # mc "Sometimes I wonder — would it really matter if I just… wasn’t here? You’d all have one less headache."
    mc "有时我想——如果我干脆……不在了，真的会不一样吗？你们都能少一份麻烦。"

# game/script.rpy:3663
translate schinese interview_3_89c0030c:

    # mc "Ow! What was that for?!"
    mc "哎哟！你打我干什么？！"

# game/script.rpy:3665
translate schinese interview_3_06de2095:

    # L "That’s what you get for talking nonsense like that. Got it?"
    L "这就是你说那种胡话的代价。懂了吗？"

# game/script.rpy:3666
translate schinese interview_3_39a276ab:

    # L "Life won’t get easier if you keep looking at it through doom and regrets."
    L "如果你一直用末日与后悔的眼光看人生，它不会变容易。"

# game/script.rpy:3667
translate schinese interview_3_809a10fc:

    # L "Live one day at a time. Good or crappy — doesn’t matter. Clear?"
    L "一天一天地活。好还是烂——不重要。清楚了吗？"

# game/script.rpy:3669
translate schinese interview_3_5b111ddc:

    # mc "Alright, alright! Just— stop pullin’ my nose, you’ll rip it clean off!"
    mc "好好好！只是——别再揪我鼻子了，会整个扯下来的！"

# game/script.rpy:3672
translate schinese interview_3_ed320f37:

    # L "Sorry-sorry! But hey, you did great today. You really did a lot…"
    L "抱歉抱歉！不过说真的，你今天表现很棒。你真的做了很多……"

# game/script.rpy:3673
translate schinese interview_3_55f59b56:

    # L "If it wasn’t for Isabelle—"
    L "要不是伊莎贝拉——"

# game/script.rpy:3674
translate schinese interview_3_e410fa11:

    # L "By the way… you still in love with her?"
    L "对了……你还爱着她吗？"

# game/script.rpy:3675
translate schinese interview_3_b79ddbfd:

    # mc "What’s that supposed to mean?"
    mc "你这话什么意思？"

# game/script.rpy:3676
translate schinese interview_3_5f3c86fa:

    # L "Your blackout…"
    L "你那次昏迷……"

# game/script.rpy:3678
translate schinese interview_3_ccc9d294:

    # mc "I don’t know, Lena. Honestly… I don’t."
    mc "我不知道，莉娜。说真的……我不知道。"

# game/script.rpy:3679
translate schinese interview_3_c12c0d69:

    # mc "Sometimes I think yeah… and then it hits me — maybe I’m just mistakin’ it for something else."
    mc "有时我觉得是……然后突然意识到——也许我只是把别的当成了那个。"

# game/script.rpy:3685
translate schinese interview_3_c613faf6:

    # mc "Hey, Goo-girl! You plannin’ to sit sulkin’ in that corner all night? I said I’m not mad!"
    mc "喂，黏人精！你打算在那个角落坐一晚上生闷气吗？我说了我不生气！"

# game/script.rpy:3688
translate schinese interview_3_f5fcc79a:

    # b "You ain’t mad at me… I know. But I can’t forgive meself for it, alright?"
    b "你不是在生我的气……我知道。但我没法原谅自己，行吗？"

# game/script.rpy:3689
translate schinese interview_3_19d80e27:

    # mc "Fine, keep blamin’ yourself — just do it out here, not in the damn corner."
    mc "行，继续怪你自己吧——但在这儿怪，别躲那个该死的角落。"

# game/script.rpy:3690
translate schinese interview_3_14c3fe0e:

    # b "I can`t."
    b "我做不到。"

# game/script.rpy:3691
translate schinese interview_3_b08a7ab6:

    # mc "Keep that up and I’ll send your sleepy-face pics to HQ."
    mc "再这样我就把你睡脸的照片发到总部去。"

# game/script.rpy:3694
translate schinese interview_3_3d647bec:

    # b "Right, I forgive meself. Sorted."
    b "好吧，我原谅我自己了。完事。"

# game/script.rpy:3695
translate schinese interview_3_ba9e1002:

    # b "So— wot were we talkin’ about again?"
    b "那么——我们刚才在聊什么来着？"

# game/script.rpy:3697
translate schinese interview_3_79de9c40:

    # mc "Fast recovery! Anyway — any pro tips for tomorrow?"
    mc "恢复得真快！总之——明天有什么专家级建议吗？"

# game/script.rpy:3699
translate schinese interview_3_fc61b0f7:

    # b "Easy. Don’t go stickin’ your nose where all the arrogant prats are hangin’ about, yeah?"
    b "简单。别把鼻子凑到那帮傲慢蠢货扎堆的地方，嗯？"

# game/script.rpy:3701
translate schinese interview_3_f8071021:

    # mc "And if they come at me first?"
    mc "要是他们先冲我来呢？"

# game/script.rpy:3703
translate schinese interview_3_90800ad5:

    # b "Kick their arses."
    b "揍他们屁股。"

# game/script.rpy:3705
translate schinese interview_3_5db03e42:

    # mc "And if they’re stronger?"
    mc "要是他们更强呢？"

# game/script.rpy:3708
translate schinese interview_3_90767483:

    # b "Leg it. That’s the whole strategy."
    b "跑。这招就够了。"

# game/script.rpy:3710
translate schinese interview_3_97f3b78b:

    # mc "Real uplifting advice, thanks."
    mc "真是振奋人心的建议，谢谢。"

# game/script.rpy:3712
translate schinese interview_3_f0acc273:

    # b "Every bloody year they switch the rules up. The goals change, the whole system shifts."
    b "他们他妈每年都换规则。目标变了，整个系统都变。"

# game/script.rpy:3713
translate schinese interview_3_a48a0c6b:

    # b "Wot worked when I was there ain’t gonna work for you."
    b "我那套当年管用的，对你不管用。"

# game/script.rpy:3714
translate schinese interview_3_b3c7ddac:

    # b "Except the month-long tournament battles. Or class battles — depends which year they shove you in."
    b "除了为期一个月的锦标赛对战。或者班级对战——看你被塞进哪一届。"

# game/script.rpy:3716
translate schinese interview_3_6e99a700:

    # mc "Oh, a tournament, huh? And what’s that supposed to be for?"
    mc "哦，锦标赛，是吗？那是干什么用的？"

# game/script.rpy:3718
translate schinese interview_3_f9416436:

    # L "Spectacular. Builds bonds between heroes — and keeps the rest from slacking off."
    L "场面壮观。能加深英雄之间的羁绊——也能防止其他人偷懒。"

# game/script.rpy:3720
translate schinese interview_3_3c2f2de4:

    # mc "So basically — a public ass-kicking arena. What a way to make a debut."
    mc "所以基本上——就是个公开互殴的竞技场。多好的出道方式啊。"

# game/script.rpy:3722
translate schinese interview_3_4c7743dd:

    # L "But admit it — sounds kinda fun."
    L "但承认吧——听着还挺有意思。"

# game/script.rpy:3723
translate schinese interview_3_d91f6d80:

    # mc "For you, maybe. I’ll be the damn punching bag out there."
    mc "对你来说也许吧。我在外面就是那个沙包。"

# game/script.rpy:3724
translate schinese interview_3_b1a3570c:

    # b "(And wot’s she doin’ here…?)"
    b "（她怎么也会在这儿……？）"

# game/script.rpy:3726
translate schinese interview_3_11a93929:

    # b "I’ll be back in a bit — ladies’ room."
    b "我去一下洗手间，马上回来。"

# game/script.rpy:3730
translate schinese interview_3_2e6011b9:

    # mc "Huh? What? Sure, sure — whatever you say."
    mc "嗯？什么？好好好——你说什么都行。"

# game/script.rpy:3741
translate schinese interview_3_f05a5d30:

    # b "(Look at ‘er. Standin’ there like the whole world owes her somethin’.)"
    b "（看看她。站在那儿好像全世界都欠她的。）"

# game/script.rpy:3742
translate schinese interview_3_d74e0467:

    # na "Took you long enough to notice me, hm? You’re gettin’ slow, chère."
    na "你注意到我可真够久的，嗯？你反应变慢了，亲爱的。"

# game/script.rpy:3745
translate schinese interview_3_be047c40:

    # b "You takin’ the piss? Your silhouette’s visible from the bloody street. I had more important things goin’ on."
    b "你在耍我？你的剪影从街上都看得见。我这边有更重要的事。"

# game/script.rpy:3746
translate schinese interview_3_6327c18a:

    # b "Say what you want or jog on."
    b "有话快说，不然滚。"

# game/script.rpy:3748
translate schinese interview_3_b86bc6b2:

    # na "Oh, is zat how you zank me? After I slipped your little friend through ze cracks?"
    na "哦，这就是你感谢我的方式？我刚把你那位小朋友从门缝里放出去，你就这样谢我？"

# game/script.rpy:3750
translate schinese interview_3_c01fad94:

    # b "Oh listen to her talk now."
    b "听听她现在说话多好听。"

# game/script.rpy:3751
translate schinese interview_3_8bf59650:

    # b "All you did was sit there pretendin’ you were helpin’. He did it himself — didn’t need you in the slightest."
    b "你不过就是坐在那儿装作在帮忙。是他自己做到的——压根用不着你。"

# game/script.rpy:3754
translate schinese interview_3_a77db302:

    # na "He did, oui. But I was ze one makin’ sure no one put a knife in his back while he did it."
    na "是的没错。但在他动手的时候，确保没人往他背后捅刀子的，是我。"

# game/script.rpy:3756
translate schinese interview_3_dcc9cdb5:

    # b "(Oh bloody hell… that tone of hers again. Means they need somethin’ from me.)"
    b "（该死……又是她那个语气。说明他们有东西需要我。）"

# game/script.rpy:3757
translate schinese interview_3_69e306b1:

    # b "And wot, you want applause? Fine — cheers, yeah? Happy now?"
    b "怎么，想要掌声？行——恭喜，满意了？"

# game/script.rpy:3758
translate schinese interview_3_417df634:

    # b "Now spit out why you’re here, or piss off."
    b "现在说清楚你来干嘛，否则滚。"

# game/script.rpy:3760
translate schinese interview_3_69bae54b:

    # na "Ze boss didn’t exactly enjoy your... performance at ze interview."
    na "老板对你在访谈上的……表演，可不怎么满意。"

# game/script.rpy:3761
translate schinese interview_3_7104338d:

    # na "Charles’ boy was supposed to fall, not rise. What ‘appened, hm?”"
    na "查尔斯的儿子本该栽跟头，不是爬起来。怎么回事，嗯？"

# game/script.rpy:3762
translate schinese interview_3_e3ecbced:

    # b "(Ah right… here we go. They want somethin’ from me.)"
    b "（啊对……来了。他们有事要求我。）"

# game/script.rpy:3764
translate schinese interview_3_7bcfba61:

    # b "You takin’ the piss? You know what happened."
    b "你耍我？你明明知道发生了什么。"

# game/script.rpy:3765
translate schinese interview_3_e9c772b7:

    # b "But I’ll remind you — Isabelle happened."
    b "但我提醒你一下——是伊莎贝拉。"

# game/script.rpy:3766
translate schinese interview_3_1596374a:

    # b "You said he’d be alone. So go on, explain to me why she was there?"
    b "你说他会是一个人。所以来，解释一下她为什么会在场？"

# game/script.rpy:3768
translate schinese interview_3_52f43a8e:

    # na "Why you care so much about ’im, {b}hein?"
    na "你为什么这么在意他，{b}嗯？{/b}"

# game/script.rpy:3771
translate schinese interview_3_f4e0e24d:

    # b "Keep playin’ this little performance and I swear, I’ll tear you apart. I ain’t in the mood."
    b "继续演这出小戏，我发誓撕了你。我现在没心情。"

# game/script.rpy:3773
translate schinese interview_3_7b2f36d4:

    # na "’Cause he caught Lady Lié’s eye. She told me to keep an eye on him."
    na "因为他被莉娅小姐看上了。她让我盯着他。"

# game/script.rpy:3775
translate schinese interview_3_178d8395:

    # b "Oh yeah? Loved him so much she nearly killed him on the spot?"
    b "哦是吗？爱他爱到差点当场杀了他？"

# game/script.rpy:3777
translate schinese interview_3_b0d78d2b:

    # na "She kept her power on a leash."
    na "她把力量拴住了。"

# game/script.rpy:3780
translate schinese interview_3_f89d6f5a:

    # na "But, as an apology... keys to ze bike."
    na "不过，作为道歉……车钥匙给你。"

# game/script.rpy:3781
translate schinese interview_3_7a5a5120:

    # b "That’s it?"
    b "就这样？"

# game/script.rpy:3782
translate schinese interview_3_546f7d3e:

    # na "Oui."
    na "是的。"

# game/script.rpy:3783
translate schinese interview_3_ea415c5b:

    # na "Ah, and one more zing — about zat little... failure."
    na "啊，还有一件事——关于那个小……失败。"

# game/script.rpy:3784
translate schinese interview_3_697fa083:

    # na "If you fail again, ma chère, maybe your precious [mc] will ‘ave a little accident, oui?"
    na "如果你再失败一次，亲爱的，也许你宝贝的[mc]会出点小意外，嗯？"

# game/script.rpy:3788
translate schinese interview_3_d1f28ee9:

    # b "If a single hair falls off his head ‘cause of you lot…"
    b "如果你们害他掉了一根头发……"

# game/script.rpy:3790
translate schinese interview_3_675b8543:

    # b "I swear, I’ll burn your whole family to ash."
    b "我发誓把你全家烧成灰。"

# game/script.rpy:3793
translate schinese interview_3_39ca6e34:

    # b "And no one — hear me? No one in this world will help you. Got it?"
    b "而且没人——听清楚？这世上不会有任何人帮你。懂了吗？"

# game/script.rpy:3794
translate schinese interview_3_0c7f2035:

    # na "..."
    na "……"

# game/script.rpy:3796
translate schinese interview_3_8c4dab37:

    # b "Answer me!"
    b "回答我！"

# game/script.rpy:3798
translate schinese interview_3_06887f0f:

    # na "Y-yes"
    na "是、是的"

# game/script.rpy:3800
translate schinese interview_3_cccc66b8:

    # b "Hmph..."
    b "哼……"

# game/script.rpy:3803
translate schinese interview_3_4b3ddb8c:

    # b "Good girl."
    b "乖姑娘。"

# game/script.rpy:3804
translate schinese interview_3_03a6a282:

    # b "Now then — compensation. The real reason you’re here."
    b "那么——赔偿。你来的真正原因。"

# game/script.rpy:3806
translate schinese interview_3_b3372411:

    # na "I already told you — I’m ‘ere to watch over him. Nothin’ more."
    na "我已经说过了——我是来看着他的。没别的。"

# game/script.rpy:3807
translate schinese interview_3_d70648a1:

    # b "(Lyin’ through her teeth. If she’s even thinkin’ of hurtin’ him — I’ll cut that thought out at the root.)"
    b "（满嘴跑火车。她要是哪怕动一点伤害他的念头——我就把那个念头连根拔掉。）"

# game/script.rpy:3810
translate schinese interview_3_41fb9c26:

    # b "Pretty fingers you’ve got… promise you, it’s gonna hurt."
    b "你这手指真漂亮……我保证，会很疼。"

# game/script.rpy:3812
translate schinese interview_3_9faf6e5d:

    # na "I was just—"
    na "我只是——"

# game/script.rpy:3813
translate schinese interview_3_cd353678:

    # na "Argh—!"
    na "啊——！"

# game/script.rpy:3815
translate schinese interview_3_a7ff42a6:

    # b "Real reason. And I’ll let this slide."
    b "真正的原因。这次我饶过你。"

# game/script.rpy:3816
translate schinese interview_3_4940c6c9:

    # b "Last chance."
    b "最后一次机会。"

# game/script.rpy:3819
translate schinese interview_3_a9d648c9:

    # na "(Merde... She’s insane! We’re supposed to be allies, {b}non?!{/b})"
    na "（糟了……她疯了！我们应该是盟友，{b}对吧？！{/b}）"

# game/script.rpy:3820
translate schinese interview_3_0c7f2035_1:

    # na "..."
    na "……"

# game/script.rpy:3822
translate schinese interview_3_853da16e:

    # b "Ok, seems I`ve no choice."
    b "好吧，看来我没得选。"

# game/script.rpy:3824
translate schinese interview_3_e38d3fd9:

    # na "(No, no, no... {b}putain{/b}, she’s really gonna break my fingers...)"
    na "（不不不……{b}该死{/b}，她真要掰断我的手指……）"

# game/script.rpy:3826
translate schinese interview_3_c1275ed3:

    # na "Because of... Isabelle."
    na "是因为……伊莎贝拉。"

# game/script.rpy:3828
translate schinese interview_3_850ef128_2:

    # b "..."
    b "……"

# game/script.rpy:3829
translate schinese interview_3_ebfeef29:

    # b "Right."
    b "说得对。"

# game/script.rpy:3832
translate schinese interview_3_ae16354c:

    # b "(If I send her off like this, it's just gonna cause trouble. If I fix her up, she’ll learn nothing…)"
    b "（要是就这么放她走，只会惹麻烦。要是帮她把手指弄好，她又学不到教训……）"

# game/script.rpy:3833
translate schinese interview_3_5f5150a9:

    # b "(Still… she acted out of some kind of good intent. Mostly. Annoying to admit — but she’s the best one to keep eyes on him.)"
    b "（不过……她出发点算是好的。大体上是。虽然很不爽，但让她盯着他确实最合适。）"

# game/script.rpy:3836
translate schinese interview_3_6e5e4d82:

    # b "Listen up. I’ll let your little stunt go this time — but on one condition."
    b "听着。这次你的小把戏我放你一马——但有一个条件。"

# game/script.rpy:3837
translate schinese interview_3_47f6ce73:

    # b "Tomorrow’s his big day. And you know exactly how things work in that Academy."
    b "明天是他的大日子。那所学院的规矩你很清楚。"

# game/script.rpy:3840
translate schinese interview_3_5db69f5c:

    # b "No matter what happens — he gets in."
    b "不管发生什么——他必须进去。"

# game/script.rpy:3841
translate schinese interview_3_61463e96:

    # b "How you make it happen? Don’t care. Pull strings, twist arms, mess with Charles himself — not my problem."
    b "你怎么做到？我不管。走后门、施压、甚至去动查尔斯本人——都不关我的事。"

# game/script.rpy:3844
translate schinese interview_3_0c7f2035_2:

    # na "..."
    na "……"

# game/script.rpy:3845
translate schinese interview_3_a0161fe2:

    # b "Brilliant. Glad we understand each other."
    b "很好。很高兴我们达成共识。"

# game/script.rpy:3846
translate schinese interview_3_680d8b07:

    # b "Now get out."
    b "现在滚。"

# game/script.rpy:3852
translate schinese interview_3_850ef128_3:

    # b "..."
    b "……"

# game/script.rpy:3854
translate schinese interview_3_52f43a8e_1:

    # na "Why you care so much about ’im, {b}hein?"
    na "你为什么这么在意他，{b}嗯？{/b}"

# game/script.rpy:3858
translate schinese interview_3_d7d96aa0:

    # b "Yeah, why do I care?"
    b "是啊，我为什么要在意？"

# game/script.rpy:3860
translate schinese interview_3_2c8ea894:

    # b "(Because to my parents, I was just a monster?)"
    b "（因为在父母眼里，我只是个怪物？）"

# game/script.rpy:3861
translate schinese interview_3_3c700026:

    # b "(And all I ever wanted was love — not the fear, not the lookin’ down…)"
    b "（而我想要的从来只是爱——不是恐惧，不是俯视……）"

# game/script.rpy:3862
translate schinese interview_3_fb90384c:

    # b "(Or maybe ‘cause he was the first one who saw me — really saw me — for who I am?)"
    b "（又或者，是因为他是第一个看见我——真正看见我——是什么样的人？）"

# game/script.rpy:3864
translate schinese interview_3_fb4f19b6:

    # b "I don’t even remember anymore..."
    b "我都已经不记得了……"

# game/script.rpy:3866
translate schinese interview_3_21377ec1:

    # b "(But he’s the only one I still call family.)"
    b "（但他是我唯一还称作家人的人。）"

# game/script.rpy:3875
translate schinese interview_3_b4a0cbb7:

    # mc "(Man, I’m starvin’... like, seriously starving...)"
    mc "（天啊，我快饿死了……真的快饿死了……）"

# game/script.rpy:3876
translate schinese interview_3_cfef04c8:

    # mc "Hey, Lena, that thing tomorrow — we still on for our little get-together?"
    mc "喂，莉娜，明天那事——我们的小聚会还算数吗？"

# game/script.rpy:3877
translate schinese interview_3_6d173d30:

    # L "You mean {b}that{/b} invitation? Yeah, of course. Why?"
    L "你说{b}那个{/b}邀请？当然算了。怎么了？"

# game/script.rpy:3878
translate schinese interview_3_df0fabfa:

    # mc "Just got this sudden craving for your cooking, y’know? Bit of nostalgia, I guess."
    mc "突然特别想吃你做的菜，懂吗？大概是怀旧吧。"

# game/script.rpy:3879
translate schinese interview_3_6d78ca85:

    # L "You just want to stuff yourself at my expense, huh?"
    L "你就是想白吃白喝吧？"

# game/script.rpy:3880
translate schinese interview_3_18aaf24a:

    # mc "Not denying it."
    mc "不否认。"

# game/script.rpy:3883
translate schinese interview_3_b87308d4:

    # L "Thought so..."
    L "我就知道……"

# game/script.rpy:3884
translate schinese interview_3_1716e730:

    # L "(Same old him… But I’m glad to see him like this again — more alive, more honest with himself.)"
    L "（还是老样子……但看到他这样我挺高兴——更有活力，也更诚实地面对自己了。）"

# game/script.rpy:3885
translate schinese interview_3_405a9386:

    # L "(Honest… right. Not hiding from others, not pretending. Just living his life.)"
    L "（诚实……对。不再躲着别人，不再伪装。只是过自己的生活。）"

# game/script.rpy:3888
translate schinese interview_3_f493c0cb:

    # L "(Feelings, huh... Funny, Lena. You’re doing great — lying to yourself even in your own head.)"
    L "（感情，是吗……有意思，莉娜。你干得真棒——连在脑子里都在骗自己。）"

# game/script.rpy:3889
translate schinese interview_3_33adf182:

    # L "(Come on, like we practiced — just say it. Where’s that boldness when you actually need it?)"
    L "（来，像我们练习的那样——就说出来。真正需要的时候，你的胆量呢？）"

# game/script.rpy:3890
translate schinese interview_3_b0c8a091:

    # L "[mc]?"
    L "[mc]？"

# game/script.rpy:3894
translate schinese interview_3_59fd44b9:

    # mc "Ye?"
    mc "嗯？"

# game/script.rpy:3896
translate schinese interview_3_65735683:

    # L "You know... I…"
    L "你知道……我……"

# game/script.rpy:3897
translate schinese interview_3_1ff50b0d:

    # L "What do you wanna eat tomorrow?"
    L "你明天想吃什么？"

# game/script.rpy:3899
translate schinese interview_3_34c3aea9:

    # L "(No, no, not that, you idiot…)"
    L "（不不不，不是这个，你这个笨蛋……）"

# game/script.rpy:3900
translate schinese interview_3_f6f24fca:

    # mc "Doesn’t matter to me, really — I’ll eat just about anything. Just... no turkey. I can’t stand that bird."
    mc "其实我无所谓——我几乎什么都吃。只是……不要火鸡。我受不了那鸟。"

# game/script.rpy:3901
translate schinese interview_3_940c4108:

    # mc "By the way — about tomorrow. Yeah, yeah, I know, I won’t shut up about it, but still..."
    mc "顺便说一句——关于明天。是是是，我知道，我会一直念叨，但还是要说……"

# game/script.rpy:3903
translate schinese interview_3_6af4bdb8:

    # L "That’s fine. When I was applying, I felt just the same — nervous wreck and all. Don’t worry, you’ll do great."
    L "没关系。我当初申请的时候也一样——紧张得一塌糊涂。别担心，你会很棒的。"

# game/script.rpy:3904
translate schinese interview_3_fd753361:

    # mc "So wait, we’re not in the same class, right? ’Cause of that whole ‘ability’ thing and what not? How’s that work, anyway?"
    mc "那等等，我们不在同一个班吧？因为那个什么“能力”之类的？到底怎么回事？"

# game/script.rpy:3905
translate schinese interview_3_54905fc3:

    # L "It’s in the handbook, you know..."
    L "手册里写着呢，你知道的……"

# game/script.rpy:3907
translate schinese interview_3_288a8f74:

    # mc "(whispering) sold them..."
    mc "（低声）卖惨卖得不错……"

# game/script.rpy:3908
translate schinese interview_3_9993b94e_2:

    # L "..."
    L "……"

# game/script.rpy:3909
translate schinese interview_3_b5d84522:

    # L "(He never stops surprising me. Why? How?)"
    L "（他永远都在让我惊讶。为什么？怎么做到的？）"

# game/script.rpy:3910
translate schinese interview_3_e1ba95f8:

    # L "(…No, stupid question — that’s just so him.)"
    L "（……不，蠢问题——那就是他。）"

# game/script.rpy:3912
translate schinese interview_3_496136ce:

    # L "Three exams. First—"
    L "三场考试。第一场——"

# game/script.rpy:3914
translate schinese interview_3_e3623abc:

    # mc "Hold up, hold up — {b}three{/b} exams? Come again? I thought tomorrow was the last one!"
    mc "等等等等——{b}三场{/b}考试？再说一遍？我以为明天就是最后一场了！"

# game/script.rpy:3916
translate schinese interview_3_b7987cb3:

    # L "The first’s the written one — you passed that. Second’s the interview at the Academy — they decide if you’re “worthy” or not. And the third one’s... physical."
    L "第一场是笔试——你过了。第二场是学院面试——他们决定你“够不够格”。第三场是……体能。"

# game/script.rpy:3917
translate schinese interview_3_d789a257:

    # L "They actually count that one a lot, so, yeah — better not flunk it."
    L "那一项占比很高，所以——最好别挂。"

# game/script.rpy:3919
translate schinese interview_3_e954dcb1:

    # mc "Yeah, I’m dead..."
    mc "完了，我死定了……"

# game/script.rpy:3921
translate schinese interview_3_c33da1bb:

    # L "Not exactly. You can skip it — it’s optional."
    L "也不至于。你可以跳过——那是选修的。"

# game/script.rpy:3922
translate schinese interview_3_690165fb:

    # mc "Wait, really?"
    mc "等等，真的吗？"

# game/script.rpy:3923
translate schinese interview_3_d9c3e098:

    # L "Yeah. But you’ll have to ace the other ones to make up for it."
    L "是的。但你得把其他几场考到极致来补。"

# game/script.rpy:3926
translate schinese interview_3_5bc6f1c2:

    # b "You forgot to mention — without the physical exam, you ain’t gettin’ past Rank B. Door’s shut. Literally."
    b "你忘了说——没有体能考试，你过不了B级。门都关死了。字面意义上的。"

# game/script.rpy:3927
translate schinese interview_3_d859fcac:

    # mc "Hey, long as I get in, I don’t care what happens next. Where they stick me after that — not my problem."
    mc "嘿，只要能进去，之后怎样我不在乎。他们把我塞哪儿——不关我的事。"

# game/script.rpy:3929
translate schinese interview_3_38b9895e:

    # mc "Also… where the hell were you? You’re soaked through."
    mc "还有……你他妈跑哪儿去了？浑身湿透。"

# game/script.rpy:3930
translate schinese interview_3_04e04bdf:

    # mc "Don’t tell me the ladies’ room’s {b}that{/b} far away — what’d you do, take a walk around the block?"
    mc "别告诉我洗手间{b}那么{/b}远——你绕着街区散步去了？"

# game/script.rpy:3932
translate schinese interview_3_0c73a9cb:

    # b "Len, love, tomorrow I won’t be able to swing by. This idiot’s on you, yeah?"
    b "莉娜宝贝，明天我没法过来。这个白痴就交给你了，嗯？"

# game/script.rpy:3933
translate schinese interview_3_32a6f0fc:

    # L "Something happened?"
    L "出什么事了？"

# game/script.rpy:3934
translate schinese interview_3_053e726b:

    # b "Yeah. Work stuff needs sortin’."
    b "是。工作上有事要处理。"

# game/script.rpy:3936
translate schinese interview_3_f237f3ab:

    # mc "Hey! Stop ignoring me already!"
    mc "喂！别再无视我了！"

# game/script.rpy:3937
translate schinese interview_3_e8833f17:

    # mc "Beatrice, where the hell {b}were{/b} you?"
    mc "碧翠丝，你他妈{b}到底{/b}去哪了？"

# game/script.rpy:3940
translate schinese interview_3_106524ec:

    # L "Honestly, I’m curious too. You look soaked, and you’ve been gone for quite a while."
    L "说实话我也好奇。你浑身湿透，而且离开了挺久。"

# game/script.rpy:3941
translate schinese interview_3_ed87c1e1:

    # L "And considering the restroom’s right down the hall... kinda raises some questions."
    L "而且洗手间就在走廊那头……这就有点问题了。"

# game/script.rpy:3945
translate schinese interview_3_c443fae1:

    # b "I had constipation."
    b "我便秘了。"

# game/script.rpy:3946
translate schinese interview_3_2b35b6fe:

    # mc "..."
    mc "……"

# game/script.rpy:3947
translate schinese interview_3_9d9b865d:

    # mc "Liar."
    mc "骗子。"

# game/script.rpy:3948
translate schinese interview_3_854af459:

    # b "Prove I didn’t."
    b "证明我没有啊。"

# game/script.rpy:3950
translate schinese interview_3_4f8d5e9a:

    # mc "(You’re standing there drenched, it’s raining outside — don’t need to be a genius to put two and two together...)"
    mc "（你浑身湿透，外面在下雨——不需要多聪明就能把这两件事联系起来……）"

# game/script.rpy:3951
translate schinese interview_3_848b51c7:

    # mc "(That look in her eyes... she knows it too. But why’s she keepin’ quiet? Did I mess up somehow? Maybe that damn interview..)"
    mc "（她那个眼神……她也知道了。可她为什么不说话？我是不是搞砸了什么？也许是那该死的面试……）"

# game/script.rpy:3953
translate schinese interview_3_d46d16de:

    # mc "C’mon, be honest — that because of the interview?"
    mc "喂，老实说——是不是因为那场面试？"

# game/script.rpy:3955
translate schinese interview_3_0fd8282a:

    # b "Maybe."
    b "也许吧。"

# game/script.rpy:3957
translate schinese interview_3_92b91fea:

    # mc "Beatrice. No jokes. It was because of the interview?"
    mc "碧翠丝。别开玩笑。是因为那场面试吗？"

# game/script.rpy:3959
translate schinese interview_3_850ef128_4:

    # b "..."
    b "……"

# game/script.rpy:3960
translate schinese interview_3_5854db22:

    # b "...No."
    b "……不。"

# game/script.rpy:3961
translate schinese interview_3_22a5b359:

    # mc "(So it’s not that, huh? Then what else…? The Delleymans? Maybe. But that still doesn’t explain why she’s soaked.)"
    mc "（所以不是那个，嗯？那还能是什么……德拉伊姆家的人？有可能。但那还是解释不了她为什么湿透了。）"

# game/script.rpy:3962
translate schinese interview_3_9903b0ae:

    # mc "(She’s clearly been outside. A call? No — she could’ve done that in the hallway. A meeting? Doesn’t fit either.)"
    mc "（她明显出去过。打电话？不——在走廊就能打。开会？也不对。）"

# game/script.rpy:3963
translate schinese interview_3_9072dbb8:

    # mc "(Normally she just leaves that stuff for the next day... so what’s different this time?)"
    mc "（平时她都会把那种事留到第二天……这次有什么不同？）"

# game/script.rpy:3965
translate schinese interview_3_c1068548:

    # mc "Am I… somehow mixed up in this?"
    mc "我是不是……也被牵扯进去了？"

# game/script.rpy:3967
translate schinese interview_3_b865a08b:

    # b "(He’s thinkin’. Too much. Ain’t gonna hide it completely from him…)"
    b "（他在思考。动太多脑子了。没法完全瞒着他……）"

# game/script.rpy:3968
translate schinese interview_3_6fc80148:

    # b "Yeah."
    b "嗯。"

# game/script.rpy:3970
translate schinese interview_3_8d1d5154:

    # b "And no — we’re stoppin’ there. I’ll tell you, just… not now."
    b "好了——到此为止。我会告诉你的，只是……不是现在。"

# game/script.rpy:3971
translate schinese interview_3_88f091c5:

    # b "We all need rest. Tomorrow’s heavy for the both of you."
    b "我们都需要休息。明天对你们俩都很重要。"

# game/script.rpy:3972
translate schinese interview_3_cc15ab76:

    # b "And it’s late. You agree, yeah?"
    b "而且很晚了。你同意吧？"

# game/script.rpy:3983
translate schinese mcxbeatrice_1_f092fe7e:

    # mc "(Sure she will. Walked in, locked herself in the shower, and poof — gone. No biggie, right?)"
    mc "（她肯定会同意。走进来，把自己锁进浴室，然后噗——人就没了。没什么大不了的，对吧？）"

# game/script.rpy:3984
translate schinese mcxbeatrice_1_a496199c:

    # mc "(Keep guessin’, champ. What’s wrong, worried? Good job, [mc]. Keep it up — but I ain’t tellin’ ya a damn thing.)"
    mc "（继续猜吧，冠军。怎么了，担心了？干得好，[mc]。继续——但我一个字都不会告诉你。）"

# game/script.rpy:3987
translate schinese mcxbeatrice_1_1f38eb7d:

    # mc "Thirty-six."
    mc "三十六。"

# game/script.rpy:3989
translate schinese mcxbeatrice_1_6511b161:

    # mc "(Then again, you’re no saint either, buddy. Got tangled up with the Delleymans, blew the interview...)"
    mc "（话说回来，兄弟你也不是什么圣人。跟德拉伊姆家搅在一起，还搞砸了面试……）"

# game/script.rpy:3990
translate schinese mcxbeatrice_1_4ff2b20a:

    # mc "(All that’s left is for them to reject you tomorrow, and you’ll unlock the full loser combo..)"
    mc "（剩下的就是明天被拒，然后解锁“终极失败者”套装……）"

# game/script.rpy:3991
translate schinese mcxbeatrice_1_ac6749c6:

    # mc "(No, stop it. You promised Lena — you’re gettin’ in, no matter what.)"
    mc "（不，打住。你答应过莉娜——不管怎样都要进去。）"

# game/script.rpy:3994
translate schinese mcxbeatrice_1_243668ec:

    # mc "Thirty-seven."
    mc "三十七。"

# game/script.rpy:3996
translate schinese mcxbeatrice_1_bad7c3bd:

    # mc "(But what if I don’t? What then?)"
    mc "（可要是我没进去呢？然后呢？）"

# game/script.rpy:3997
translate schinese mcxbeatrice_1_72197dd5:

    # mc "(First — I let everyone down. Again. All their hope, gone.)"
    mc "（第一——我让所有人失望了。又一次。所有的希望都没了。）"

# game/script.rpy:3998
translate schinese mcxbeatrice_1_067ea6ab:

    # mc "(Second — Mom and Dad’ll be right, callin’ me useless. But hey, at least they’ll be wrong about me being persistent.)"
    mc "（第二——爸妈会是对的，骂我没用。不过嘿，至少他们会在“我是否执着”这件事上说错了。）"

# game/script.rpy:3999
translate schinese mcxbeatrice_1_76271d7a:

    # mc "(Which, overall, doesn't sound so bad.)"
    mc "（总的来说，好像也没那么糟。）"

# game/script.rpy:4002
translate schinese mcxbeatrice_1_250ea430:

    # mc "Thirty-eight."
    mc "三十八。"

# game/script.rpy:4006
translate schinese mcxbeatrice_1_5ab220be:

    # mc "Don’t make me laugh…"
    mc "别逗我笑……"

# game/script.rpy:4007
translate schinese mcxbeatrice_1_03f0cc2e:

    # mc "(Who are you tryin’ to fool, huh? Yourself? Keep feedin’ that pretty lie?)"
    mc "（你在骗谁呢，嗯？骗自己？继续喂自己那个漂亮的谎？）"

# game/script.rpy:4008
translate schinese mcxbeatrice_1_6baada22:

    # mc "If I don’t get in, that’s it — total collapse. The end."
    mc "要是我进不去，就完了——彻底崩盘。结束。"

# game/script.rpy:4010
translate schinese mcxbeatrice_1_364b46a2:

    # mc "Maybe I should just bolt now. Leave a note: ‘Dear Lena, Beatrice — I changed my mind.’"
    mc "也许我现在就该溜走。留张纸条：“亲爱的莉娜、碧翠丝——我改主意了。”"

# game/script.rpy:4012
translate schinese mcxbeatrice_1_0056f9bd:

    # mc "(Yeah, genius idea. Run away again. Then what? You gonna spend your whole life runnin’ from your screwups?)"
    mc "（是啊，天才主意。再逃一次。然后呢？你打算一辈子都在逃避自己的烂摊子？）"

# game/script.rpy:4013
