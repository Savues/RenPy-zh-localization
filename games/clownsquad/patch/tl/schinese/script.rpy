# game/script.rpy:4369
translate schinese first_lewd_scene_38fc49d7:

    # ti "Buzzkill."
    ti "真扫兴。"

# game/script.rpy:4373
translate schinese first_lewd_scene_5c1f815b:

    # "Different hearts. Different wounds. One place that binds them all."
    "不同的心。不同的伤。一个将他们联结在一起的地方。"

# game/script.rpy:4374
