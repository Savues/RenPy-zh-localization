# TODO: Translation updated at 2026-06-18 18:03

# game/story01en.rpy:9
translate schinese story01en_cab3a47c:

    # mc "(Y'know what the difference is between ordinary people and heroes?)"
    mc "（你知道普通人和英雄有什么区别吗？）"

# game/story01en.rpy:10
translate schinese story01en_de87836a:

    # mc "(No?)"
    mc "（不知道？）"

# game/story01en.rpy:11
translate schinese story01en_95f0215b:

    # mc "(Yeah. Me neither.)"
    mc "（嗯。我也不知道。）"

# game/story01en.rpy:13
translate schinese story01en_e34bfc8c:

    # mc "(Although, there is one difference.)"
    mc "（不过还真有一点区别。）"

# game/story01en.rpy:14
translate schinese story01en_040b783d:

    # mc "(Heroes sure love making ordinary people's lives miserable.)"
    mc "（英雄最喜欢把普通人的人生搅得一团糟。）"

# game/story01en.rpy:17
translate schinese story01en_c43ef84e:

    # mc "(Not exactly something you're supposed to say out loud, though...)"
    mc "（不过这话可不能当面说……）"

# game/story01en.rpy:18
translate schinese story01en_a64b9c58:

    # mc "(But anyway...)"
    mc "（算了……）"

# game/story01en.rpy:20
translate schinese story01en_dd4b9a86:

    # mc "(Feast your eyes on the Hero Academy!)"
    mc "（睁大眼睛瞧好了，这就是英雄学院！）"

# game/story01en.rpy:21
translate schinese story01en_b19bb584:

    # mc "(A collection of everything humanity has to offer. Bribery, corruption, hypocrisy—)"
    mc "（人类文明能拿出来的一切都在这儿：贿赂、腐败、虚伪——）"

# game/story01en.rpy:22
translate schinese story01en_216efc7e:

    # mc "(You get the idea.)"
    mc "（大概就是这种感觉。）"

# game/story01en.rpy:24
translate schinese story01en_14c2228b:

    # mc "(And in this wonderful, wonderful place, I'm supposed to spend the next few years of my life.)"
    mc "（而我接下来几年的人生，就要耗在这个美妙无比的地方。）"

# game/story01en.rpy:25
translate schinese story01en_185c0e72:

    # mc "Fan-fucking-tastic."
    mc "真他妈棒。"

# game/story01en.rpy:27
translate schinese story01en_4c6db1cc:

    # mc "(Well, I made it to the entrance. That's half the battle already.)"
    mc "（好吧，我人到了门口，这已经算赢一半了。）"

# game/story01en.rpy:28
translate schinese story01en_eec60c5a:

    # mc "(Now for the easy part: actually getting in...)"
    mc "（接下来就是简单部分：真正走进去……）"

# game/story01en.rpy:31
translate schinese story01en_588e7d54:

    # mc "Wait... did I leave the iron on?!"
    mc "等等……我是不是忘了关熨斗？！"

# game/story01en.rpy:35
translate schinese story01en_2d2ed0b6:

    # mc "Right. Better head back and check."
    mc "对。还是回去看一眼吧。"

# game/story01en.rpy:36
translate schinese story01en_857ed435:

    # mc "Although... I'm pretty sure I don't even own an iron."
    mc "不过……我很确定自己根本没有熨斗。"

# game/story01en.rpy:40
translate schinese story01en_9cad5809:

    # mc "...yeah. Thought so."
    mc "……嗯。果然。"

# game/story01en.rpy:41
translate schinese story01en_77ff597b:

    # mc "(I don't wanna be here. Not even a little.)"
    mc "（我一点都不想来这里。一点都不。）"

# game/story01en.rpy:44
translate schinese story01en_2b35b6fe:

    # mc "..."
    mc "……"

# game/story01en.rpy:45
translate schinese story01en_5c2756a5:

    # mc "But I am."
    mc "但我还是来了。"

# game/story01en.rpy:46
translate schinese story01en_bc9998ee:

    # mc "(Why?)"
    mc "（为什么？）"

# game/story01en.rpy:48
translate schinese story01en_9e65890b:

    # mc "(Because of Lena and Beatrice?)"
    mc "（因为莉娜和碧翠丝？）"

# game/story01en.rpy:49
translate schinese story01en_4a18b5bd:

    # mc "(Or... am I really just that stubborn?)"
    mc "（还是说……我真的只是那么死脑筋？）"

# game/story01en.rpy:50
translate schinese story01en_2d6d35ea:

    # mc "(Whispering) Prove yourself? Don't make me laugh... Have you looked in a mirror lately?"
    mc "（低声）证明自己？别逗了……你最近照过镜子吗？"

# game/story01en.rpy:51
translate schinese story01en_1fe71cf2:

    # mc "...clown."
    mc "……小丑。"

# game/story01en.rpy:53
translate schinese story01en_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/story01en.rpy:55
translate schinese story01en_5b122199:

    # mc "(No turning back now. You made a promise, and you're gonna keep it.)"
    mc "（现在没有回头路了。你许过诺，就得做到。）"

# game/story01en.rpy:56
translate schinese story01en_2ec82cff:

    # mc "(If I run away again...)"
    mc "（我要再逃一次的话……）"

# game/story01en.rpy:57
translate schinese story01en_604d230e:

    # mc "(Whispering) ...stop running. You're not that guy anymore."
    mc "（低声）……别再逃了。你已经不是那种人了。"

# game/story01en.rpy:62
translate schinese story01en_a5cf5ac0:

    # "Out of nowhere, a painfully familiar voice rings out."
    "毫无预兆地，一个熟悉得让人牙痒的声音响了起来。"

# game/story01en.rpy:63
translate schinese story01en_667e839f:

    # L "Well, look at you! Ain't you a sight for sore eyes?"
    L "哟，这不是你嘛！真是让人赏心悦目啊！"

# game/story01en.rpy:66
translate schinese story01en_4e30d682:

    # L "Finally worked up the nerve?"
    L "终于鼓起勇气了？"

# game/story01en.rpy:67
translate schinese story01en_0ab64de8:

    # L "I never doubted you, not for a second!"
    L "我可是一秒钟都没怀疑过你！"

# game/story01en.rpy:70
translate schinese story01en_078d927e:

    # mc "My ass you didn't!"
    mc "鬼才信！"

# game/story01en.rpy:71
translate schinese story01en_84a31830:

    # mc "You lie like it's a professional skill."
    mc "你撒谎简直是一门专业手艺。"

# game/story01en.rpy:73
translate schinese story01en_3cb5fdca:

    # L "Maybe for one tiny, itty-bitty second... when you turned around."
    L "也许有那么一丢丢、一瞬间……你转身那会儿？"

# game/story01en.rpy:76
translate schinese story01en_545c52e5:

    # mc "How long have you been standing here?"
    mc "你在这儿站多久了？"

# game/story01en.rpy:78
translate schinese story01en_382fdd05:

    # L "Long enough."
    L "够久了。"

# game/story01en.rpy:79
translate schinese story01en_dd1e0e74:

    # L "Forty minutes, give or take."
    L "差不多四十分钟吧。"

# game/story01en.rpy:81
translate schinese story01en_4be4aa62:

    # mc "Forty minutes?!"
    mc "四十分钟？！"

# game/story01en.rpy:82
translate schinese story01en_55c2bd98:

    # mc "What, were you waiting for your boyfriend to show up for a date? Why the hell'd you get here so early?"
    mc "怎么，等你男朋友来赴约吗？你到底干嘛来这么早？"

# game/story01en.rpy:84
translate schinese story01en_c6cdc831:

    # L "Hmm... Maybe I just enjoy helping people in need?"
    L "嗯……也许我就是喜欢帮助有困难的人？"

# game/story01en.rpy:86
translate schinese story01en_5c738abb:

    # mc "Did you actually buy that yourself?"
    mc "这种话你自己信吗？"

# game/story01en.rpy:88
translate schinese story01en_5ea3bb1d:

    # L "Hey! I'm serious."
    L "喂！我是认真的。"

# game/story01en.rpy:90
translate schinese story01en_65b0d133:

    # L "Y'know..."
    L "你知道不……"

# game/story01en.rpy:91
translate schinese story01en_cb01fb33:

    # L "It was kinda funny watching you stare at the Academy."
    L "看你盯着学院那副样子，还挺有意思的。"

# game/story01en.rpy:92
translate schinese story01en_3f13014d:

    # L "Especially with that look on your face."
    L "尤其是你脸上那表情。"

# game/story01en.rpy:94
translate schinese story01en_3ece9d14:

    # L "Like every single thought in your head was written all over it!"
    L "简直像是脑子里想什么全写在脸上！"

# game/story01en.rpy:95
translate schinese story01en_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/story01en.rpy:97
translate schinese story01en_e826c2da:

    # mc "Oh, that's just my superpower."
    mc "哦，那只是我的超能力而已。"

# game/story01en.rpy:98
translate schinese story01en_080e4d20:

    # mc "It's called an existential crisis."
    mc "它叫“存在主义危机”。"

# game/story01en.rpy:101
translate schinese story01en_fee1ac39:

    # L "And here I thought you were brooding over the injustices of the world again."
    L "我还以为你又在为世上的不公苦大仇深呢。"

# game/story01en.rpy:102
translate schinese story01en_1a1b60e5:

    # L "Still... I'm glad."
    L "不过……还是替你高兴。"

# game/story01en.rpy:104
translate schinese story01en_e87da162:

    # mc "I'm sure you are. What're you doing here?"
    mc "你当然高兴。说吧，你来干嘛？"

# game/story01en.rpy:116
translate schinese story01en_9993b94e:

    # L "..."
    L "……"

# game/story01en.rpy:120
translate schinese story01en_08beeae6:

    # mc "Second-years don't start classes for another two weeks, so..."
    mc "二年级两周后才开课，所以……"

# game/story01en.rpy:121
translate schinese story01en_de056adc:

    # mc "what brings my queen to this humble establishment?"
    mc "是什么让我的女王大人屈尊光临小店？"

# game/story01en.rpy:123
translate schinese story01en_b6f06aad:

    # L "You already know. So why're you asking?"
    L "你明明知道，还问什么？"

# game/story01en.rpy:124
translate schinese story01en_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/story01en.rpy:125
translate schinese story01en_3a969109:

    # mc "I wanna hear you say it."
    mc "我想听你亲口说。"

# game/story01en.rpy:128
translate schinese story01en_d295c6d1:

    # L "Well, look at you..."
    L "瞧瞧你……"

# game/story01en.rpy:129
translate schinese story01en_06dcf4cb:

    # L "Sorry, but you're gonna have to put up with me."
    L "抱歉，接下来你得忍着我了。"

# game/story01en.rpy:130
translate schinese story01en_169771b3:

    # L "I'm not leaving you on your own."
    L "我不会再丢下你一个人。"

# game/story01en.rpy:132
translate schinese story01en_8cc1a022:

    # mc "You left me on my own before."
    mc "上次你就是把我一个人丢下的。"

# game/story01en.rpy:134
translate schinese story01en_391636ce:

    # L "You asked me to."
    L "是你让我这么干的。"

# game/story01en.rpy:136
translate schinese story01en_d2fb4533:

    # mc "Don't remember agreeing to it this time."
    mc "我可没答应这次也这样。"

# game/story01en.rpy:139
translate schinese story01en_3ead130d:

    # L "And yet, here you are!"
    L "可你还是来了！"

# game/story01en.rpy:140
translate schinese story01en_a1384ff5:

    # L "What'd I tell you yesterday?"
    L "我昨天跟你说什么来着？"

# game/story01en.rpy:141
translate schinese story01en_dbad35a4:

    # L "If anyone's getting in, it's you."
    L "能进去的人是你。"

# game/story01en.rpy:142
translate schinese story01en_44925a95:

    # L "You just gotta want it."
    L "你只要真的想进去。"

# game/story01en.rpy:144
translate schinese story01en_6167aa68:

    # mc "I've got plenty of motivation. It's the talent somebody forgot to hand out."
    mc "我动力满满。缺的是天赋，而天赋是谁忘了发的。"

# game/story01en.rpy:148
translate schinese story01en_9742ecf6:

    # L "Oh, c'mon. Don't start."
    L "哎，别这样嘛。"

# game/story01en.rpy:149
translate schinese story01en_dc6e57a0:

    # L "Get over here."
    L "过来。"

# game/story01en.rpy:152
translate schinese story01en_2876efd9:

    # mc "Why?"
    mc "为什么？"

# game/story01en.rpy:153
translate schinese story01en_9993b94e_1:

    # L "..."
    L "……"

# game/story01en.rpy:154
translate schinese story01en_7d771f72:

    # mc "Lena?"
    mc "莉娜？"

# game/story01en.rpy:158
translate schinese story01en_e6887ad7:

    # L "(Whispering) You're. Overthinking. It!"
    L "（低声）你。又。想。多。了。"

# game/story01en.rpy:159
translate schinese story01en_e9605044:

    # L "(Whispering) What makes you think they're any better than you?"
    L "（低声）你凭什么觉得他们就比你强？"

# game/story01en.rpy:161
translate schinese story01en_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/story01en.rpy:163
translate schinese story01en_24d7f38e:

    # L "(Whispering) Don't you dare. You hear me?"
    L "（低声）你敢。听到没有？"

# game/story01en.rpy:164
translate schinese story01en_a3fcf0e4:

    # L "(Whispering) Don't you dare talk about yourself like that!"
    L "（低声）不许你那样说自己！"

# game/story01en.rpy:167
translate schinese story01en_ac0e87c1:

    # L "*Sulking*"
    L "*生闷气*"

# game/story01en.rpy:168
translate schinese story01en_c376b102:

    # mc "(Where the hell do you find that much strength...)"
    mc "（你到底哪来这么大的力气……）"

# game/story01en.rpy:169
translate schinese story01en_d712730b:

    # mc "Wow... When exactly did you become my therapist?"
    mc "哇……你什么时候开始当我的心理咨询师了？"

# game/story01en.rpy:171
translate schinese story01en_8f062073:

    # L "Hey, I'm seri—"
    L "喂，我是说——"

# game/story01en.rpy:176
translate schinese story01en_59572f9c:

    # mc "Beep-beep."
    mc "哔哔。"

# game/story01en.rpy:178
translate schinese story01en_9993b94e_2:

    # L "..."
    L "……"

# game/story01en.rpy:180
translate schinese story01en_94ccb5f7:

    # L "What're you doing?"
    L "你干嘛？"

# game/story01en.rpy:183
translate schinese story01en_cd6f6804:

    # mc "You were being way too cute. Couldn't help myself."
    mc "你刚才太可爱了。我忍不住。"

# game/story01en.rpy:184
translate schinese story01en_9993b94e_3:

    # L "..."
    L "……"

# game/story01en.rpy:185
translate schinese story01en_8ad414fa:

    # L "(Whispering) Thanks."
    L "（低声）谢了。"

# game/story01en.rpy:189
translate schinese story01en_14fc87f7:

    # L "Alright, now for the important part."
    L "好了，现在说正事。"

# game/story01en.rpy:190
translate schinese story01en_fc489e8f:

    # L "The second you step through those doors, the exam begins."
    L "你踏进那扇门的一刻，考试就开始了。"

# game/story01en.rpy:192
translate schinese story01en_98da3ade:

    # mc "An exam? What're they gonna judge, the way I walk?"
    mc "考试？他们要看我走路的样子？"

# game/story01en.rpy:195
translate schinese story01en_d984fab3:

    # L "Believe it or not, yeah."
    L "信不信由你，还真是。"

# game/story01en.rpy:196
translate schinese story01en_871789e6:

    # L "There's this old guy here who thinks the way you walk says everything about who you are."
    L "这儿有个老头，觉得一个人怎么走路就能看出他是什么样的人。"

# game/story01en.rpy:197
translate schinese story01en_9d8a694e:

    # L "So the teachers watch you walk and try to figure out what kinda person you are."
    L "所以老师们就看你走路，然后琢磨你是个什么货色。"

# game/story01en.rpy:198
translate schinese story01en_1d589153:

    # L "Still don't really get what that has to do with being a hero..."
    L "我还是不太懂这跟当英雄有什么关系……"

# game/story01en.rpy:199
translate schinese story01en_326d8071:

    # L "but hey, they know better than me."
    L "不过算了，他们比我懂。"

# game/story01en.rpy:202
translate schinese story01en_3bd1bf68:

    # mc "Used to judge people by what was inside their heads. Now it's all about the packaging."
    mc "以前还看人脑子里想什么，现在只看包装了。"

# game/story01en.rpy:203
translate schinese story01en_2f3855ef:

    # mc "Humanity took a wrong turn somewhere."
    mc "人类在某处拐错了弯。"

# game/story01en.rpy:205
translate schinese story01en_c3a009ec:

    # mc "(Wait... Is that the shy girl from the café?)"
    mc "（等等……那是咖啡馆里那个害羞的女孩？）"

# game/story01en.rpy:207
translate schinese story01en_32e40da9:

    # L "I know you're not exactly a fan of this whole world, but—"
    L "我知道你不太喜欢这个世界，不过——"

# game/story01en.rpy:208
translate schinese story01en_8ee12115:

    # L "There are heroes out there who genuinely care about what they do."
    L "但外面确实有真心在意自己在做什么的英雄。"

# game/story01en.rpy:211
translate schinese story01en_39726545:

    # mc "Yeah, and for every one of those champions of justice, there are ten assholes."
    mc "是啊，每有一个这样的正义卫士，就有十个混蛋。"

# game/story01en.rpy:212
translate schinese story01en_45bd346a:

    # mc "And no, I'm not having this conversation."
    mc "还有，不，这个话题我拒绝。"

# game/story01en.rpy:213
translate schinese story01en_496fae15:

    # mc "About exam."
    mc "咱们说考试。"

# game/story01en.rpy:214
translate schinese story01en_6867a088:

    # mc "Any advice? Or am I winging it?"
    mc "有什么建议吗？还是我只能临场瞎蒙？"

# game/story01en.rpy:216
translate schinese story01en_2a47d8f7:

    # L "Do whatever feels right. Just none of that nonsense from yesterday."
    L "怎么舒服怎么来。但昨天那套混账招数不许用。"

# game/story01en.rpy:220
translate schinese story01en_14c262d1:

    # L "No, I'm serious. Don't even think about it."
    L "我是认真的，想都别想。"

# game/story01en.rpy:222
translate schinese story01en_cb2638d8:

    # mc "Relax. I won't ruin your reputation."
    mc "放心吧。我不会坏你的名声。"

# game/story01en.rpy:223
translate schinese story01en_7960c127:

    # mc "(Whispering) ...probably."
    mc "（低声）……大概吧。"

# game/story01en.rpy:235
translate schinese story01_1_959b0e1d:

    # "A few minutes later, at the Academy's main entrance. The site of the first exam."
    "几分钟后，学院正门。第一场考试的地点。"

# game/story01en.rpy:236
translate schinese story01_1_9affeddc:

    # mc "(Whispering) ...no, I'm serious. Doesn't this whole thing seem stupid to you?"
    mc "（低声）……不是，我是认真的。你是不是也觉得这一切蠢透了？"

# game/story01en.rpy:237
translate schinese story01_1_784ce5ea:

    # mc "Why the hell did I risk my life for this?!"
    mc "我他妈到底为什么要拿命去赌这个？！"

# game/story01en.rpy:238
translate schinese story01_1_b7ac75fc:

    # L "But if it weren't for her, you'd still be an ordinary person."
    L "但要不是她，你现在还只是个普通人。"

# game/story01en.rpy:241
translate schinese story01_1_d43eba58:

    # mc "(Whispering) I'd rather have stayed ordinary than—"
    mc "（低声）我宁愿继续当个普通人，也——"

# game/story01en.rpy:243
translate schinese story01_1_2b35b6fe:

    # mc "..."
    mc "……"

# game/story01en.rpy:244
translate schinese story01_1_5482d6c9:

    # mc "(Shiny. Way too shiny.)"
    mc "（好闪。闪得过分了。）"

# game/story01en.rpy:246
translate schinese story01_1_6efbed34:

    # mc "(While the peasants scrape by, the lords' tables buckle under the weight of their feasts.)"
    mc "（平民们还在苟延残喘，贵族的餐桌却被宴席压得吱呀作响。）"

# game/story01en.rpy:247
translate schinese story01_1_64fc89d5:

    # mc "(Then again, what am I saying... It's not like the Middle Ages ever ended.)"
    mc "（……不过我在说什么呢。中世纪又不是已经过去了。）"

# game/story01en.rpy:249
translate schinese story01_1_070e581e:

    # mc "*Whistles*"
    mc "*吹口哨*"

# game/story01en.rpy:250
translate schinese story01_1_37a7749b:

    # mc "Hell of a crowd they got here."
    mc "哇，这儿的人可真多。"

# game/story01en.rpy:251
translate schinese story01_1_a3816ee2:

    # mc "Don't tell me every one of 'em needs a hero license that badly."
    mc "才不是他们人人都那么需要一张英雄执照。"

# game/story01en.rpy:253
translate schinese story01_1_5c56bead:

    # L "Getting one from a place like this? That's a status symbol."
    L "从这种地方弄到一张？那可是身份象征。"

# game/story01en.rpy:254
translate schinese story01_1_dcb27069:

    # mc "Mm-hm... Nice to see dignity ain't worth much these days."
    mc "嗯……看来尊严如今不值几个钱了。"

# game/story01en.rpy:255
translate schinese story01_1_2d5553af:

    # mc "(A hero license... That's funny. It's just a shiny badge for the rankings, but without it—)"
    mc "（英雄执照……真有意思。说白了不过是排行榜上的一块亮闪闪的徽章，可要是没有它——）"

# game/story01en.rpy:256
translate schinese story01_1_d00e419d:

    # mc "(nobody's even gonna call you a hero.)"
    mc "（就没人会叫你英雄了。）"

# game/story01en.rpy:261
translate schinese story01_1_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/story01en.rpy:262
translate schinese story01_1_cb728bcd:

    # mc "(Is that... gold? Not the purest, but still.)"
    mc "（那是……金子？成色不算好，但毕竟是金子。）"

# game/story01en.rpy:265
translate schinese story01_1_c812b159:

    # mc "Lena, is that thing actually—"
    mc "莉娜，那东西该不会是——"

# game/story01en.rpy:267
translate schinese story01_1_3e8152c2:

    # L "Over the top. I know."
    L "太夸张了。我知道。"

# game/story01en.rpy:272
translate schinese story01_1_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/story01en.rpy:275
translate schinese story01_1_ac5d50e6:

    # mc "Over the top? Lena, the chairs are made of gold!"
    mc "夸张？莉娜，这些椅子是金子做的！"

# game/story01en.rpy:277
translate schinese story01_1_23f925a3:

    # mc "GOLD!"
    mc "金的！"

# game/story01en.rpy:279
translate schinese story01_1_e3371a88:

    # mc "We could buy enough food to last half a lifetime with one of those things."
    mc "一把那样的椅子，够我们买下半辈子的口粮。"

# game/story01en.rpy:281
translate schinese story01_1_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/story01en.rpy:283
translate schinese story01_1_a3886bee:

    # mc "(Although... what if we pawned it?)"
    mc "（不过……要是把它当掉呢？）"

# game/story01en.rpy:285
translate schinese story01_1_0099f3c1:

    # mc "Lena, I have an idea."
    mc "莉娜，我有个主意。"

# game/story01en.rpy:287
translate schinese story01_1_9da03bab:

    # L "I don't like that look on your face..."
    L "我可不喜欢你现在这个表情……"

# game/story01en.rpy:288
translate schinese story01_1_e3ef897a:

    # L "And no, we're not selling it!"
    L "而且不，我们不卖！"

# game/story01en.rpy:291
translate schinese story01_1_f5885cf1:

    # mc "But it's gol—"
    mc "可它是金——"

# game/story01en.rpy:292
translate schinese story01_1_c7888348:

    # L "WE'RE NOT SELLING IT!"
    L "我们不卖！！"

# game/story01en.rpy:295
translate schinese story01_1_4419f635:

    # mc "(Whispering) What a waste..."
    mc "（低声）太浪费了……"

# game/story01en.rpy:296
translate schinese story01_1_1ad70b9e:

    # mc "Eh... None of my business."
    mc "嗐……不关我事。"

# game/story01en.rpy:299
translate schinese story01_1_dfc67b07:

    # L "Didn't forget, did ya?"
    L "你还没忘吧？"

# game/story01en.rpy:300
translate schinese story01_1_5c8f2129:

    # L "All those elites you love so much are tied to this place one way or another."
    L "你那么喜欢的那些精英，或多或少都跟这个地方有关系。"

# game/story01en.rpy:301
translate schinese story01_1_4b6432e2:

    # L "And their kids either go here or used to."
    L "他们的孩子要么在这儿读书，要么以前在这儿读过。"

# game/story01en.rpy:302
translate schinese story01_1_1becdfbf:

    # mc "I feel less and less inclined to have anything to do with this place."
    mc "我越来越不想跟这个地方扯上任何关系。"

# game/story01en.rpy:303
translate schinese story01_1_460d0997:

    # L "You'll get used to it."
    L "你会习惯的。"

# game/story01en.rpy:304
translate schinese story01_1_e864999d:

    # L "Took me about a year."
    L "我花了大概一年。"

# game/story01en.rpy:310
translate schinese story01_1_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/story01en.rpy:312
translate schinese story01_1_ee6db500:

    # mc "(Of course. My favorite kind of attention, the completely unnecessary kind.)"
    mc "（当然了。我最喜欢的那种关注——完全没必要的那种。）"

# game/story01en.rpy:315
translate schinese story01_1_ed1385ed:

    # mc "(Then again... the necessary kind too.)"
    mc "（不过……必要的关注倒也还行。）"

# game/story01en.rpy:316
translate schinese story01_1_d161fa15:

    # mc "(You guys could at least pretend you're hiding. Just for appearances' sake.)"
    mc "（你们好歹也装一下是在躲啊。哪怕做做样子。）"

# game/story01en.rpy:318
translate schinese story01_1_65f9a5ce:

    # mc "(Otherwise, it practically screams—)"
    mc "（不然简直是大声在喊——）"

# game/story01en.rpy:319
translate schinese story01_1_341524bc:

    # "Noticing a guy suspiciously looking around holding a notebook."
    "一个拿着本子、鬼鬼祟祟四处张望的家伙。"

# game/story01en.rpy:320
translate schinese story01_1_f2ee3455:

    # mc "(...Huh?)"
    mc "（……咦？）"

# game/story01en.rpy:321
translate schinese story01_1_fe28da7f:

    # mc "(Doesn't look like someone who's here for the exam.)"
    mc "（看着不像是来考试的人。）"

# game/story01en.rpy:322
translate schinese story01_1_209764bc:

    # mc "(Someone from the Academy? An examiner, perhaps.)"
    mc "（学院的人？也许是考官。）"

# game/story01en.rpy:324
translate schinese story01_1_39aac481:

    # mc "(Let's poke the bear and see if it growls.)"
    mc "（那就捅一下老虎屁股，看看它会不会叫。）"

# game/story01en.rpy:325
translate schinese story01_1_37c679c1:

    # mc "Lena, how many points did you get back then?"
    mc "莉娜，你当年拿了多少分？"

# game/story01en.rpy:327
translate schinese story01_1_ba2820e0:

    # L "Why're you asking all of a sudden?"
    L "怎么突然问这个？"

# game/story01en.rpy:328
translate schinese story01_1_99079f0d:

    # mc "Just wondering."
    mc "随口一问。"

# game/story01en.rpy:329
translate schinese story01_1_446fabeb:

    # L "'Just wondering' he says."
    L "还“随口一问”呢。"

# game/story01en.rpy:331
translate schinese story01_1_b48d0406:

    # mc "Trust me for now."
    mc "先信我一回。"

# game/story01en.rpy:333
translate schinese story01_1_a46c28af:

    # L "I did great on everything, but somehow I only got half the points."
    L "我每项都表现得很好，结果莫名其妙只拿到一半分数。"

# game/story01en.rpy:334
translate schinese story01_1_ca4fc648:

    # mc "(Half?)"
    mc "（一半？）"

# game/story01en.rpy:338
translate schinese story01_1_eb0bf5fe:

    # mc "(Knowing Lena, she probably didn't give a damn about this part. But unlike her...)"
    mc "（以莉娜的性格，这一项她大概根本没放在心上。但我不一样……）"

# game/story01en.rpy:339
translate schinese story01_1_d1071605:

    # mc "(this is my only shot.)"
    mc "（这是我唯一的机会。）"

# game/story01en.rpy:340
translate schinese story01_1_0ca01c6b:

    # mc "(The problem is... they are not even trying to hide their presence?)"
    mc "（问题是……他们压根没打算藏起来？）"

# game/story01en.rpy:343
translate schinese story01_1_9cc94967:

    # mc "(No. Knowing that crazy old man, he'd account for that.)"
    mc "（不。想必那个疯老头早就算到这一步了。）"

# game/story01en.rpy:344
translate schinese story01_1_8d7454b3:

    # mc "(Maybe the obvious examiners are bait.)"
    mc "（也许这些明面上的考官才是诱饵。）"

# game/story01en.rpy:346
translate schinese story01_1_9e51f9cc:

    # mc "(Make us think we've already spotted the trick...)"
    mc "（让我们以为自己已经看穿了把戏……）"

# game/story01en.rpy:347
translate schinese story01_1_f3d86274:

    # mc "(No. Too neat. Doesn't fit.)"
    mc "（不对。太干净了。不像。）"

# game/story01en.rpy:349
translate schinese story01_1_0cff9937:

    # mc "(Whispering) What'd you say they were paying attention to again?"
    mc "（低声）你刚才说他们在看什么来着？"

# game/story01en.rpy:350
translate schinese story01_1_46eb1c83:

    # L "How you carry yourself. Whether you look the part."
    L "你的举止仪态。像不像那回事。"

# game/story01en.rpy:351
translate schinese story01_1_4ec26cfe:

    # L "The nobler a hero looks, the easier they are to sell to the public."
    L "英雄装得越高贵，就越容易忽悠住民众。"

# game/story01en.rpy:353
translate schinese story01_1_54bb7fa0:

    # mc "(The public... He couldn't care less about the public. All he gives a damn about is the ratings.)"
    mc "（民众……他压根不在乎民众。他在乎的只有评分。）"

# game/story01en.rpy:354
translate schinese story01_1_71cea3ac:

    # mc "(Everyone's standing around, waiting for the exam to start...)"
    mc "（所有人还站着，等着考试开始……）"

# game/story01en.rpy:355
translate schinese story01_1_e607e165:

    # mc "(But it already has.)"
    mc "（可它早就开始了。）"

# game/story01en.rpy:358
translate schinese story01_1_4f63e59c:

    # mc "(So they actually are observing. But then how can nobody notice them?)"
    mc "（所以他们确实在观察。可为什么没人能注意到他们？）"

# game/story01en.rpy:359
translate schinese story01_1_3b56c8e0:

    # mc "(But... If Lena missed it then so might most people.)"
    mc "（不过……连莉娜都没发现，那大多数人恐怕也不会发现。）"

# game/story01en.rpy:360
translate schinese story01_1_bb5dd00d:

    # mc "(So it really does work?)"
    mc "（所以这套路真的管用？）"

# game/story01en.rpy:363
translate schinese story01_1_e3415e1b:

    # mc "(Knowing that lunatic they put in charge of this place... he loves screwing with people's heads.)"
    mc "（想想他们塞来管事儿的那个疯子……他就是喜欢玩弄人心。）"

# game/story01en.rpy:364
translate schinese story01_1_e4a2e603:

    # mc "I don't envy Isabella. Her old man's completely out of his mind."
    mc "我真不羡慕伊莎贝拉。她老爹脑子彻底坏了。"

# game/story01en.rpy:365
translate schinese story01_1_5c1078af:

    # mc "(Still... I need to know how far this goes.)"
    mc "（不过……我得知道这到底到什么程度。）"

# game/story01en.rpy:367
translate schinese story01_1_8c03a4ee:

    # mc "(A quiet crowd won't show me who matters.)"
    mc "（一群安分的人可看不出谁重要。）"

# game/story01en.rpy:368
translate schinese story01_1_8215f170:

    # mc "(Alright. Let's make this awkward.)"
    mc "（好。接下来让场面尴尬一点。）"

# game/story01en.rpy:369
translate schinese story01_1_b5016d96:

    # mc "Hey, Lena. Do me a favor."
    mc "莉娜，帮个忙。"

# game/story01en.rpy:371
translate schinese story01_1_17838824:

    # mc "(Whispering) ...hit me."
    mc "（低声）……打我一下。"

# game/story01en.rpy:372
translate schinese story01_1_9993b94e:

    # L "..."
    L "……"

# game/story01en.rpy:387
translate schinese story01_1_33acd2df:

    # L "Wh—?!"
    L "什——？！"

# game/story01en.rpy:388
translate schinese story01_1_e780ce00:

    # L "Have you lost your mind now?! Why?!"
    L "你疯了吗？！为什么？！"

# game/story01en.rpy:390
translate schinese story01_1_2c3ed94b:

    # mc "No sane person walks into a Hero Academy just because they feel like it."
    mc "正常人不会因为一时兴起就跑来英雄学院。"

# game/story01en.rpy:391
translate schinese story01_1_84ecafcd:

    # mc "Everyone here has something to prove."
    mc "这里每个人都有非要证明的东西。"

# game/story01en.rpy:392
translate schinese story01_1_2c319cb0:

    # mc "Put a little pressure on them, and it'll start showing."
    mc "稍微施点压，真东西就藏不住了。"

# game/story01en.rpy:393
translate schinese story01_1_98804191:

    # L "And...?"
    L "然后呢？"

# game/story01en.rpy:396
translate schinese story01_1_d9cff970:

    # mc "(Whispering) Look closely. See those guys with the notebooks?"
    mc "（低声）仔细看。看见那些拿着本子的家伙了吗？"

# game/story01en.rpy:397
translate schinese story01_1_a8d49efd:

    # mc "(Whispering) They're watching how everyone handles the wait."
    mc "（低声）他们在看每个人怎么应付这段等待。"

# game/story01en.rpy:400
translate schinese story01_1_121684fc:

    # L "Hmm..."
    L "嗯……"

# game/story01en.rpy:403
translate schinese story01_1_d4aad903:

    # mc "You're staring way too obviously."
    mc "你看得太明显了。"

# game/story01en.rpy:404
translate schinese story01_1_1d1cb949:

    # mc "(Whispering) And they're probably decoys. The real observers are hiding in the crowd."
    mc "（低声）而且他们多半是诱饵。真正的观察者藏在人群里。"

# game/story01en.rpy:405
translate schinese story01_1_9ac2f534:

    # mc "(Whispering) Almost nobody's noticed even the obvious ones."
    mc "（低声）连那些明面上的都几乎没人注意到。"

# game/story01en.rpy:417
translate schinese story01_1_5f1f0e62:

    # mc "(Whispering) Now look at everyone else. What do you see?"
    mc "（低声）现在看看其他人。你看到什么？"

# game/story01en.rpy:418
translate schinese story01_1_81a7a867:

    # L "(Whispering) They're just... waiting?"
    L "（低声）他们只是……在等？"

# game/story01en.rpy:419
translate schinese story01_1_a2f757d6:

    # mc "(Whispering) Exactly. They think the exam hasn't started yet."
    mc "（低声）没错。他们以为考试还没开始。"

# game/story01en.rpy:420
translate schinese story01_1_be71a73e:

    # mc "(Whispering) That's when people start performing."
    mc "（低声）而这正是人开始表演的时候。"

# game/story01en.rpy:421
translate schinese story01_1_4a070c5e:

    # mc "(Whispering) Look at that guy."
    mc "（低声）看那边那个男的。"

# game/story01en.rpy:424
translate schinese story01_1_53e0a5d0:

    # mc "Eyes darting around. Leg won't stop twitching. Burns on his hands."
    mc "眼神乱飘，腿抖个不停，手上还有烫伤。"

# game/story01en.rpy:426
translate schinese story01_1_711a037f:

    # mc "He's nervous. Probably can't control his power very well. Judging by the burns, something fire-related."
    mc "他很紧张，多半控制不好自己的能力。看那些烫伤，应该是跟火有关。"

# game/story01en.rpy:427
translate schinese story01_1_c8775a17:

    # L "Well, damn..."
    L "哇……"

# game/story01en.rpy:429
translate schinese story01_1_b856630a:

    # L "And how d'ya know that?"
    L "你怎么知道的？"

# game/story01en.rpy:430
translate schinese story01_1_f9a31563:

    # mc "Lena, I have a confession to make."
    mc "莉娜，我得坦白一件事。"

# game/story01en.rpy:431
translate schinese story01_1_88ea81c5:

    # mc "I've always enjoyed checking girls out."
    mc "我这辈子就爱盯着女孩子看。"

# game/story01en.rpy:432
translate schinese story01_1_9993b94e_1:

    # L "..."
    L "……"

# game/story01en.rpy:434
translate schinese story01_1_4c0cdc6c:

    # L "Beatrice trained you pretty well."
    L "碧翠丝把你教得不错。"

# game/story01en.rpy:435
translate schinese story01_1_720c38d1:

    # mc "I learned from the best."
    mc "我师从最好的。"

# game/story01en.rpy:438
translate schinese story01_1_85d0c18c:

    # mc "Now her. Military posture. Strong arms. Steady gaze."
    mc "现在是她。军人般的姿态，结实的手臂，稳稳的目光。"

# game/story01en.rpy:439
translate schinese story01_1_d7623b7f:

    # mc "Calm. Confident. Might be the same kind of power as yours."
    mc "沉着，自信。可能跟你是同一种类型的能力。"

# game/story01en.rpy:441
translate schinese story01_1_4110920f:

    # L "I never doubted you, but spell it out for me..."
    L "我从没怀疑过你，不过你给我说明白点……"

# game/story01en.rpy:442
translate schinese story01_1_97af3153:

    # L "What's the point of all this?"
    L "这一大堆有什么意义？"

# game/story01en.rpy:446
translate schinese story01_1_90c3e356:

    # mc "That's what they're writing down."
    mc "他们记的就是这个。"

# game/story01en.rpy:447
translate schinese story01_1_c27bbfe0:

    # mc "Not answers. Not speeches."
    mc "不是答案，也不是演讲。"

# game/story01en.rpy:448
translate schinese story01_1_ac3295b5:

    # mc "Every little thing people reveal when they think nobody's looking."
    mc "而是人在以为没人看时流露出的点点滴滴。"

# game/story01en.rpy:449
translate schinese story01_1_11ac7b73:

    # mc "And now we get to the important part."
    mc "现在才是重头戏。"

# game/story01en.rpy:450
translate schinese story01_1_04b6da31:

    # mc "I wanna see what changes when something actually happens."
    mc "我想看看真出了事的时候会变什么样。"

# game/story01en.rpy:452
translate schinese story01_1_9ecfa2a9:

    # L "...if I hit you, we'll see who steps in."
    L "……我要是打了你，就能看出谁会出面。"

# game/story01en.rpy:453
translate schinese story01_1_ccdd7a58:

    # L "Who freezes. Who backs away."
    L "谁会僵住，谁会后退。"

# game/story01en.rpy:454
translate schinese story01_1_08976bf6:

    # L "And who starts taking notes."
    L "谁会开始记笔记。"

# game/story01en.rpy:456
translate schinese story01_1_f36e5aec:

    # mc "Exactly."
    mc "正是。"

# game/story01en.rpy:458
translate schinese story01_1_477146dd:

    # L "But they've already seen us together."
    L "可他们已经看见我们在一起了。"

# game/story01en.rpy:459
translate schinese story01_1_67c92e36:

    # L "Won't that look suspicious?"
    L "那不会显得很可疑吗？"

# game/story01en.rpy:461
translate schinese story01_1_2034c056:

    # mc "Maybe."
    mc "也许吧。"

# game/story01en.rpy:462
translate schinese story01_1_8bb9c395:

    # mc "But I don't need them to believe it for long."
    mc "但我不需要他们信太久。"

# game/story01en.rpy:463
translate schinese story01_1_24703bb7:

    # mc "Just long enough to see where they look."
    mc "只要够我看清他们的视线落在哪儿就行。"

# game/story01en.rpy:464
translate schinese story01_1_1d5ef92e:

    # mc "Just punch m—"
    mc "只要揍我一——"

# game/story01en.rpy:469
translate schinese story01_1_75492364:

    # L "(You asked for it.)"
    L "（这是你自找的。）"

# game/story01en.rpy:472
translate schinese story01_1_0cfab72d:

    # mc "(Ah... That hurts.)"
    mc "（啊……好疼。）"

# game/story01en.rpy:473
translate schinese story01_1_7062a2f3:

    # mc "(I might actually die like this...)"
    mc "（我真有可能就这么死掉……）"

# game/story01en.rpy:475
translate schinese story01_1_82c38738:

    # L "(Gesturing) Sorry... I overdid it."
    L "（比划着）抱歉……我用力过猛了。"

# game/story01en.rpy:476
translate schinese story01_1_d2534dc2:

    # mc "(Isn't she adorable? Murderously adorable...)"
    mc "（她是不是很可爱？可爱到能杀人……）"

# game/story01en.rpy:477
translate schinese story01_1_0aa1fab5:

    # mc "(Gesturing) Play along."
    mc "（比划着）配合我。"

# game/story01en.rpy:480
translate schinese story01_1_75910a21:

    # mc "(Alright. Let's see what happens.)"
    mc "（好。接下来看戏吧。）"

# game/story01en.rpy:482
translate schinese story01_1_a6da241b:

    # "The examiner scribbles a few notes in a notebook."
    "考官在本子上飞快记了几笔。"

# game/story01en.rpy:483
translate schinese story01_1_4dc7d581:

    # mc "(They're writing it down. Good.)"
    mc "（记下来了。很好。）"

# game/story01en.rpy:484
translate schinese story01_1_3624e91d:

    # mc "(Now for the fun part: the bigger fish.)"
    mc "（接下来是好玩的部分：真正的大鱼。）"

# game/story01en.rpy:485
translate schinese story01_1_9453a6ea:

    # mc "(Is anyone gonna give themselves away?)"
    mc "（会有人露馅吗？）"

# game/story01en.rpy:487
translate schinese story01_1_d75fb177:

    # mc "(But there's just one problem...)"
    mc "（不过有个问题……）"

# game/story01en.rpy:488
translate schinese story01_1_6c8cb941:

    # L "How dare you?!"
    L "你好大的胆子？！"

# game/story01en.rpy:489
translate schinese story01_1_a111216a:

    # mc "(Nobody else is stepping in. They still don't know what's going on.)"
    mc "（没别人出面。他们还不知道发生了什么。）"

# game/story01en.rpy:490
translate schinese story01_1_d181d688:

    # mc "(Then... time to have some fun.)"
    mc "（那么……该找点乐子了。）"

# game/story01en.rpy:493
translate schinese story01_1_9c0c1d16:

    # mc "Why would you treat me so cruelly, my queen?!"
    mc "我的女王陛下，您为何要如此狠心地对我？！"

# game/story01en.rpy:494
translate schinese story01_1_85e96dd2:

    # mc "How has your prince offended you?"
    mc "您的王子殿下是哪里冒犯了您？"

# game/story01en.rpy:497
translate schinese story01_1_9993b94e_2:

    # L "..."
    L "……"

# game/story01en.rpy:515
translate schinese story01_1_0e5645c2:

    # L "(Wh-what the hell is he saying again?! Prince? Queen? HERE?)"
    L "（他、他到底在说什么啊？！王子？女王？在这种地方？）"

# game/story01en.rpy:516
translate schinese story01_1_822c1b38:

    # L "(It's like he just confessed his feelings to me...)"
    L "（搞得好像他刚跟我表白了一样……）"

# game/story01en.rpy:517
translate schinese story01_1_3c08b16b:

    # L "(This is so embarrassing... Don't blush. Don't blush!)"
    L "（太丢人了……别脸红。别脸红！）"

# game/story01en.rpy:520
translate schinese story01_1_efb86054:

    # mc "(Sorry, Lena. It's the only way I know how.)"
    mc "（抱歉，莉娜。我只会这一招。）"

# game/story01en.rpy:521
translate schinese story01_1_730e6715:

    # mc "(Although calling her my queen might've been a bit much... Then again, I'm just a clown.)"
    mc "（虽然喊她女王是有点过了……不过我本来就是个小丑。）"

# game/story01en.rpy:522
translate schinese story01_1_3f8ad633:

    # mc "(Which means I might as well go all in!)"
    mc "（既然是小丑，那就索性豁出去！）"

# game/story01en.rpy:524
translate schinese story01_1_6a408280:

    # mc "(Back to our examiners.)"
    mc "（回到考官那边。）"

# game/story01en.rpy:525
translate schinese story01_1_a99e19d4:

    # mc "(So nobody's planning to step in...)"
    mc "（所以没人打算出面……）"

# game/story01en.rpy:526
translate schinese story01_1_3dab2fa9:

    # mc "(In that case.)"
    mc "（既然如此。）"

# game/story01en.rpy:529
translate schinese story01_1_727f177f:

    # "That little performance left no one indifferent."
    "那场小戏码，没有一个人能无动于衷。"

# game/story01en.rpy:530
translate schinese story01_1_1d0c5f27:

    # npc1 "(Whispering) He confessed his feelings to one of the Academy's stars..."
    npc1 "（低声）他居然跟学院里的明星告白了……"

# game/story01en.rpy:531
translate schinese story01_1_c669330e:

    # npc1 "(Whispering) Has the wretch ever looked in a mirror? The nerve of him..."
    npc1 "（低声）这混蛋照过镜子吗？脸皮可真够大的……"

# game/story01en.rpy:533
translate schinese story01_1_6cd211a3:

    # npc2 "(Whispering) Dunno, but the guy's got balls of steel."
    npc2 "（低声）不知道，但这小子胆子是真硬。"

# game/story01en.rpy:534
translate schinese story01_1_0786d6dd:

    # npc2 "(Whispering) Confessing his feelings in front of everyone like that..."
    npc2 "（低声）当着所有人的面就这么告白……"

# game/story01en.rpy:536
translate schinese story01_1_86a9b20e:

    # mc "(One, two...)"
    mc "（一、二……）"

# game/story01en.rpy:538
translate schinese story01_1_e3dad647:

    # mc "(Seven... Eight examiners in total.)"
    mc "（七……总共八个考官。）"

# game/story01en.rpy:539
translate schinese story01_1_270a0d5e:

    # mc "(And every single judgmental stare is aimed right at me.)"
    mc "（而每一道审判般的目光都冲着我来。）"

# game/story01en.rpy:540
translate schinese story01_1_7abebe39:

    # mc "(Ain't that adorable?)"
    mc "（是不是很可爱？）"

# game/story01en.rpy:544
translate schinese story01_1_2bac2857:

    # mc "(And all this attention...)"
    mc "（还有这么多关注……）"

# game/story01en.rpy:547
translate schinese story01_1_0e71fe98:

    # mc "(Honestly? Not half bad.)"
    mc "（说真的？还不赖。）"

# game/story01en.rpy:550
translate schinese story01_1_7a5cbc46:

    # mc "Hope you all enjoyed the show!"
    mc "希望各位看得尽兴！"

# game/story01en.rpy:553
translate schinese story01_1_3176c24d:

    # mc "(Mom, look! I'm a star!)"
    mc "（妈，快看！我成明星了！）"

# game/story01en.rpy:554
translate schinese story01_1_8e5b32e4:

    # mc "(Imitating his mother) (No, son. You're just a idiot.)"
    mc "（模仿他母亲）（不，儿子。你就是个白痴。）"

# game/story01en.rpy:556
translate schinese story01_1_63d40425:

    # "Whispers ripple through the hall. Someone laughs."
    "窃窃私语在大厅里扩散。有人笑了出来。"

# game/story01en.rpy:559
translate schinese story01_1_288a5db1:

    # "Only a handful of people understand the point of that little performance."
    "只有寥寥几人看懂了那场小戏码的用意。"

# game/story01en.rpy:562
translate schinese story01_1_f6618376:

    # "Meanwhile, in the upper rows."
    "与此同时，上层看台。"

# game/story01en.rpy:564
translate schinese story01_1_d54e3e5d:

    # li "(Desperation... confidence, or sheer stupidity?)"
    li "（孤注一掷……是自信，还是纯粹的愚蠢？）"

# game/story01en.rpy:565
translate schinese story01_1_09542e7d:

    # li "(With that first strike, he tested the boundaries.)"
    li "（第一手就试出了边界。）"

# game/story01en.rpy:566
translate schinese story01_1_7a58e209:

    # li "(With that little spectacle, he made certain the examiners would remember him.)"
    li "（用那场小戏码，确保考官们记住他。）"

# game/story01en.rpy:569
translate schinese story01_1_f833f378:

    # li "(And then, that exit...)"
    li "（然后是那句收场……）"

# game/story01en.rpy:571
translate schinese story01_1_5e5245b2:

    # ti "Ahhh, go on, sis! Lemme have him, would ye? Just a wee bit? Pleeease?"
    ti "啊——姐姐！让我玩会儿呗，就一小会儿！求求你了！"

# game/story01en.rpy:573
translate schinese story01_1_328e2f38:

    # li "That is not what we are here for."
    li "我们不是为这个来的。"

# game/story01en.rpy:575
translate schinese story01_1_2e0944f4:

    # ti "Go on... please, please, please, pretty please, PLEEEASE!"
    ti "拜托……求求你、求求你、求求你，求求求求你了！"

# game/story01en.rpy:576
translate schinese story01_1_c0601ec2:

    # ti "Ah, don't ye give me that look! I know well enough ye fancied him too!"
    ti "哎，别给俺摆那副表情！俺可清楚得很，你也想他！"

# game/story01en.rpy:578
translate schinese story01_1_86b80419:

    # li "Perhaps."
    li "或许吧。"

# game/story01en.rpy:580
translate schinese story01_1_4192febf:

    # ti "Then—"
    ti "那么——"

# game/story01en.rpy:582
translate schinese story01_1_2cb95f61:

    # li "Later."
    li "之后再说。"

# game/story01en.rpy:584
translate schinese story01_1_78c2cb35:

    # li "(What, precisely, are you going to pull next?)"
    li "（你接下来到底打算耍什么花招？）"

# game/story01en.rpy:589
translate schinese story01_1_6e0f5b38:

    # mc "(9:32 a.m. Eleven minutes since we walked in.)"
    mc "（上午9:32。我们进来十一分钟了。）"

# game/story01en.rpy:590
translate schinese story01_1_2de6ea58:

    # mc "(And the crowd's still standing around.)"
    mc "（人群还站着不走。）"

# game/story01en.rpy:591
translate schinese story01_1_7b52de67:

    # mc "(They sure love dragging things out.)"
    mc "（他们可真喜欢拖时间。）"

# game/story01en.rpy:592
translate schinese story01_1_cba3bc5a:

    # mc "(Speaking of which, how does the ranking system tie into the license again?)"
    mc "（说到这个，等级系统跟执照到底是怎么挂钩的？）"

# game/story01en.rpy:594
translate schinese story01_1_15d9dc57:

    # mc "(Okay... horses page, gay party... where the hell is it? Ah, there.)"
    mc "（好吧……赛马页、男同派对……到底在哪儿？啊，有了。）"

# game/story01en.rpy:595
translate schinese story01_1_5d2d444b:

    # mc "(A license certifies the right to work as a hero... Riveting.)"
    mc "（执照证明你有资格当英雄……真有意思。）"

# game/story01en.rpy:596
translate schinese story01_1_31863681:

    # mc "(Now this is more interesting: where you get licensed affects your starting rank.)"
    mc "（这下有意思了：在哪儿拿执照会影响你的初始等级。）"

# game/story01en.rpy:597
translate schinese story01_1_2a796ef3:

    # mc "(No wonder everyone's busting their ass to get in here.)"
    mc "（难怪人人都削尖了脑袋想进来。）"

# game/story01en.rpy:599
translate schinese story01_1_cf7723a9:

    # Mi "Oi, rookie. Who're ya gonna be, then?"
    Mi "喂，新人。你打算当个什么？"

# game/story01en.rpy:602
translate schinese story01_1_0700e33a:

    # mc "(Ears. Fox. Solid build. Short and straight to the point. Bit of arrogance in her voice.)"
    mc "（尖耳朵。像狐狸。身材结实。说话又短又直。声音里带着点傲气。）"

# game/story01en.rpy:604
translate schinese story01_1_68838dc7:

    # mc "(Sizing me up, huh? So you're cut from the same cloth as those examiners.)"
    mc "（在掂量我呢？看来你跟那些考官是一个路数。）"

# game/story01en.rpy:605
translate schinese story01_1_8a51a0d8:

    # mc "(Question is... what made you give yourself away?)"
    mc "（问题是……你究竟是哪一点露了马脚？）"

# game/story01en.rpy:609
translate schinese story01_1_1eb9796d:

    # mc "(Still, no reason to rush. First, I need to figure out what she wants.)"
    mc "（不过不急着摊牌。先得弄清她想要什么。）"

# game/story01en.rpy:626
translate schinese story01_1_05920533:

    # Mi "(Gesturing) (What's your name?)"
    Mi "（比划着）（你叫什么名字？）"

# game/story01en.rpy:628
translate schinese story01_1_55191ce5:

    # mc "(Why does everyone assume I'm mute?)"
    mc "（怎么人人都当我是个哑巴？）"

# game/story01en.rpy:629
translate schinese story01_1_a5e29c0e:

    # mc "(I just don't like talking to strangers...)"
    mc "（我只是不想跟陌生人说话……）"

# game/story01en.rpy:641
translate schinese story01_1_bb5fbfea:

    # mc "(Gesturing) ([mc]. How can I help you?)"
    mc "（比划着）（[mc]。有什么能帮到您的？）"

# game/story01en.rpy:642
translate schinese story01_1_b12244e5:

    # Mi "Oi, now. You're an interestin' one, lad."
    Mi "喂喂。你这人有意思，小子。"

# game/story01en.rpy:644
translate schinese story01_1_edb3ef2a:

    # Mi "Quit stallin'. I know full well you can talk."
    Mi "别磨蹭了。我可清楚你会说话。"

# game/story01en.rpy:645
translate schinese story01_1_aba64d04:

    # mc "Interesting?"
    mc "有意思？"

# game/story01en.rpy:646
translate schinese story01_1_889f9971:

    # mc "Nah. Desperate, maybe."
    mc "不顶多。可能只是走投无路。"

# game/story01en.rpy:648
translate schinese story01_1_0397cf5d:

    # Mi "My arse you're desperate."
    Mi "你走投无路个鬼。"

# game/story01en.rpy:659
translate schinese story01_1_9c19f9dd:

    # Mi "Tell me, then. Who taught ya how to fight?"
    Mi "那你说。谁教你打架的？"

# game/story01en.rpy:661
translate schinese story01_1_2447c87a:

    # mc "Excuse me?"
    mc "你说什么？"

# game/story01en.rpy:663
translate schinese story01_1_44c561b7:

    # Mi "Gonna keep this little comedy act goin', are ya?"
    Mi "还想接着演你这套小丑戏吗？"

# game/story01en.rpy:665
translate schinese story01_1_39051e13:

    # mc "You may wanna rein in that enthusiasm, ma'am."
    mc "女士，您这股热情最好收一收。"

# game/story01en.rpy:666
translate schinese story01_1_8606bc22:

    # mc "And I'd be deeply grateful if you told me what exactly you want from me."
    mc "也请您告诉我，您到底想从我这儿得到什么，我会非常感激。"

# game/story01en.rpy:668
translate schinese story01_1_c69f0610:

    # Mi "What's the rush, eh? Not enjoyin' my company, lad?"
    Mi "急什么？不享受跟我待在一块儿吗，小子？"

# game/story01en.rpy:671
translate schinese story01_1_1460e570:

    # mc "I've already had more than enough people staring at me."
    mc "盯着我看的人已经够多了。"

# game/story01en.rpy:672
translate schinese story01_1_844e7069:

    # mc "Now there are even more of 'em. And you're not exactly helping."
    mc "现在更多了。而您还帮倒忙。"

# game/story01en.rpy:673
translate schinese story01_1_d0a1542a:

    # Mi "Bit rude, that."
    Mi "这话可有点粗鲁。"

# game/story01en.rpy:676
translate schinese story01_1_0b8a6f21:

    # mc "Truth rarely sounds nice. Especially when it's about you."
    mc "真话向来不好听。尤其是关于你的。"

# game/story01en.rpy:677
translate schinese story01_1_33e0971c:

    # mc "(Still don't get one thing. Why'd she approach me so openly?)"
    mc "（还有一点想不通。她为什么要这么明目张胆地来找我？）"

# game/story01en.rpy:678
translate schinese story01_1_29c8231a:

    # mc "(It only makes things worse for her...)"
    mc "（这样只会让她自己更麻烦……）"

# game/story01en.rpy:680
translate schinese story01_1_ae86a399:

    # n "(Whispering) Isn't that the Red Beast?"
    n "（低声）那不是“赤红野兽”吗？"

# game/story01en.rpy:681
translate schinese story01_1_10cb0b31:

    # npc1 "(Whispering) I can't believe my eyes... But what is she doing with that clown?"
    npc1 "（低声）我没看错吧……可她怎么会跟那个小丑在一起？"

# game/story01en.rpy:682
translate schinese story01_1_bb1ab945:

    # npc2 "(Whispering) Maybe that little performance of his was part of some plan?"
    npc2 "（低声）也许他刚才那场表演，本来就是某个计划的一部分？"

# game/story01en.rpy:685
translate schinese story01_1_3f2ffa67:

    # mc "That look of yours is starting to scare me."
    mc "你这眼神开始让我害怕了。"

# game/story01en.rpy:686
translate schinese story01_1_56ccdc4c:

    # mc "Please, stop undressing me with your eyes."
    mc "求你了，别用眼神把我扒光。"

# game/story01en.rpy:688
translate schinese story01_1_62e365c6:

    # Mi "Funny."
    Mi "有意思。"

# game/story01en.rpy:689
translate schinese story01_1_2f5c871c:

    # Mi "Quit dodgin' the question. I asked ya somethin'."
    Mi "别打太极。我问你话呢。"

# game/story01en.rpy:691
translate schinese story01_1_6649701e:

    # mc "And what exactly do you want me to say?"
    mc "你到底想让我说什么？"

# game/story01en.rpy:692
translate schinese story01_1_96a56872:

    # mc "You already know the answer."
    mc "你心里已经有答案了。"

# game/story01en.rpy:693
translate schinese story01_1_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/story01en.rpy:695
translate schinese story01_1_4d7b25ff:

    # mc "(She's not even hiding it. Deliberate? Or is she trying to provoke me?)"
    mc "（她连藏都不藏。故意的？还是想激我？）"

# game/story01en.rpy:696
translate schinese story01_1_aec866bf:

    # mc "(The crowd... No. By talking to me, she's actually doing me a favor.)"
    mc "（人群……不。她这么跟我说话，其实是在帮我。）"

# game/story01en.rpy:697
translate schinese story01_1_3819d7cf:

    # mc "(She's making it pretty damn clear that nobody should mess with me.)"
    mc "（她明明白白地在告诉所有人，别惹我。）"

# game/story01en.rpy:700
translate schinese story01_1_b1c42f8c:

    # mc "(Is this about that little stunt? Or... Lena?)"
    mc "（这是因为刚才那出戏？还是……莉娜？）"

# game/story01en.rpy:701
translate schinese story01_1_99ffa4c8:

    # mc "(Right. She asked about combat training... Lena's the one who trained me.)"
    mc "（对。她问的是战斗训练……教我的人是莉娜。）"

# game/story01en.rpy:703
translate schinese story01_1_a471f1ca:

    # Mi "My eyes are up here, lad."
    Mi "眼睛在我脸上呢，小子。"

# game/story01en.rpy:705
translate schinese story01_1_e0ec5ed9:

    # mc "Maybe. But everything interesting is farther down."
    mc "也许吧。但有意思的都在下面。"

# game/story01en.rpy:706
translate schinese story01_1_da3fdbf1_1:

    # Mi "..."
    Mi "……"

# game/story01en.rpy:707
translate schinese story01_1_a2eed12e:

    # Mi "What did ya just say?"
    Mi "你刚才说什么？"

# game/story01en.rpy:711
translate schinese story01_1_59572f9c:

    # mc "Beep-beep."
    mc "哔哔。"

# game/story01en.rpy:713
translate schinese story01_1_7849b06b:

    # mc "I'm just an unremarkable clown."
    mc "我只是个平平无奇的小丑。"

# game/story01en.rpy:717
translate schinese story01_1_0522d929:

    # "A faint smile appears on Mia's face."
    "米娅脸上浮现出一丝淡淡的笑意。"

# game/story01en.rpy:720
translate schinese story01_1_2b35b6fe_5:

    # mc "..."
    mc "……"

# game/story01en.rpy:721
translate schinese story01_1_5c3bbadc:

    # Mi "(Sharp lad. Quick on the uptake. But far too cocky.)"
    Mi "（脑子快，反应也快。可惜太狂了。）"

# game/story01en.rpy:724
translate schinese story01_1_b35e972f:

    # Mi "(Whispering) Hell of a show you put on."
    Mi "（低声）刚才可真是一场好戏。"

# game/story01en.rpy:725
translate schinese story01_1_6c34f643:

    # Mi "(Whispering) Credit where it's due."
    Mi "（低声）这点我承认。"

# game/story01en.rpy:726
translate schinese story01_1_3169f091:

    # Mi "(Whispering) But I'll be straight with ya."
    Mi "（低声）不过我有话直说。"

# game/story01en.rpy:728
translate schinese story01_1_f1b7fd20:

    # Mi "(Whispering) ...Next time, try not to drag down the reputation of our best students."
    Mi "（低声）……下次别再把我们最优秀学生的名声一起拖下水。"

# game/story01en.rpy:730
translate schinese story01_1_66216cb2:

    # mc "(Damn. That glare could kill a man...)"
    mc "（该死。那眼神能杀人……）"

# game/story01en.rpy:733
translate schinese story01_1_f7b7e3aa:

    # Mi "You're good at hidin' behind jokes, I'll give ya that."
    Mi "你很擅长拿玩笑当挡箭牌，这点我承认。"

# game/story01en.rpy:734
translate schinese story01_1_0a02f30b:

    # Mi "But..."
    Mi "不过……"

# game/story01en.rpy:735
translate schinese story01_1_6d5b6fd4:

    # Mi "Lena's reputation is worth a damn sight more than your little performance."
    Mi "莉娜的名声，比你这点小把戏值钱多了。"

# game/story01en.rpy:737
translate schinese story01_1_dded5766:

    # Mi "Keep that in mind before your next stunt."
    Mi "下次再耍花样之前，先记住这句。"

# game/story01en.rpy:739
translate schinese story01_1_ec161528:

    # mc "(She's obviously one of the examiners, and she's casually threatening a student?)"
    mc "（她显然是考官之一，而且还在随口威胁学生？）"

# game/story01en.rpy:740
translate schinese story01_1_3560d115:

    # mc "(Seriously, how the hell did any of you become heroes?!)"
    mc "（说真的，你们到底是怎么当上英雄的啊？！）"

# game/story01en.rpy:742
translate schinese story01_1_29477107:

    # mc "Y'know what the difference is between an arrogant show-off and me?"
    mc "你知道爱显摆的家伙跟我有什么区别吗？"

# game/story01en.rpy:744
translate schinese story01_1_59572f9c_1:

    # mc "Beep-beep."
    mc "哔哔。"

# game/story01en.rpy:746
translate schinese story01_1_9bb1216d:

    # mc "I'm just a clown."
    mc "我只是个小丑。"

# game/story01en.rpy:747
translate schinese story01_1_da3fdbf1_2:

    # Mi "..."
    Mi "……"

# game/story01en.rpy:750
translate schinese story01_1_2f0c47d3:

    # Mi "(First the Dellaymen sisters, now him...)"
    Mi "（先是德拉伊姆姐妹，现在又是他……）"

# game/story01en.rpy:751
translate schinese story01_1_39183816:

    # Mi "(This year's freshmen are an absolute handful.)"
    Mi "（今年的新生真是一群麻烦精。）"

# game/story01en.rpy:753
translate schinese story01_1_d97663a6:

    # Mi "Aye. You're right."
    Mi "唉。你说得对。"

# game/story01en.rpy:754
translate schinese story01_1_cf061bae:

    # Mi "Seems I overestimated ya."
    Mi "看来是我高估你了。"

# game/story01en.rpy:755
translate schinese story01_1_3837e9ef:

    # Mi "Take care now."
    Mi "路上小心。"

# game/story01en.rpy:758
translate schinese story01_1_2b35b6fe_6:

    # mc "..."
    mc "……"

# game/story01en.rpy:760
translate schinese story01_1_63637059:

    # mc "(Mission failed successfully!)"
    mc "（任务圆满失败！）"

# game/story01en.rpy:761
translate schinese story01_1_ed12f016:

    # mc "(So I was right. Those obvious examiners aren't the only ones watching us.)"
    mc "（所以我猜对了。那些明面上的考官不是唯一在盯着我们的人。）"

# game/story01en.rpy:762
translate schinese story01_1_ff950f4d:

    # mc "(But the hidden ones revealed themselves way too quickly. Almost like they were waiting for this...)"
    mc "（可藏起来的那些暴露得太快了。简直像是在等这一幕……）"

# game/story01en.rpy:763
translate schinese story01_1_43f841b7:

    # mc "(And I don't like that. Not one bit.)"
    mc "（而我一点都不喜欢这样。）"

# game/story01en.rpy:765
translate schinese story01_1_9962e36b:

    # mc "(On the other hand... look at all this attention. They're not even trying to hide it anymore.)"
    mc "（不过话说回来……看看这些目光。他们已经不打算藏了。）"

# game/story01en.rpy:766
translate schinese story01_1_765d9751:

    # mc "(You're flattering me.)"
    mc "（你可真是抬举我。）"

# game/story01en.rpy:767
translate schinese story01_1_e299c7ef:

    # mc "(Now what... I can't talk to Lena. It'll hurt her reputation.)"
    mc "（接下来怎么办……我不能跟莉娜说话。会毁掉她的名声。）"

# game/story01en.rpy:769
translate schinese story01_1_e2e8ab59:

    # mc "(And I'd rather not piss off that fox agai—)"
    mc "（而且我也不想再惹毛那只狐狸——）"

# game/story01en.rpy:770
translate schinese story01_1_23aba32c:

    # mc "(Lena?)"
    mc "（莉娜？）"

# game/story01en.rpy:774
translate schinese story01_1_b3ce2c74:

    # L "(Gesturing) Phone. Now!"
    L "（比划着）手机。现在！"

# game/story01en.rpy:776
translate schinese story01_1_ca38417d:

    # mc "(What the hell did I ever do to any of you?! Women are terrifying creatures...)"
    mc "（我到底对你们做了什么啊？！女人真是可怕的生物……）"

# game/story01en.rpy:781
translate schinese story01_1_4e85cb4d:

    # mc "Hello?"
    mc "喂？"

# game/story01en.rpy:783
translate schinese story01_1_077dbdbf:

    # L "(Whispering) What the hell was that?"
    L "（低声）你刚才说什么？"

# game/story01en.rpy:785
translate schinese story01_1_b8738802:

    # mc "Wasn't it obvious? Your loyal protectors finally came out of hiding."
    mc "还不明显吗？你忠诚的护卫终于现身了。"

# game/story01en.rpy:786
translate schinese story01_1_f3e39ba8:

    # mc "They wanted me dead... sniff, sniff..."
    mc "她们想要我的命……呜呜……"

# game/story01en.rpy:788
translate schinese story01_1_24ed5a5c:

    # L "(Whispering) That's not what I'm talking about. You were staring way too hard at her BOOBS!"
    L "（低声）我说的不是这个。你刚才盯着人家的胸看太久了！"

# game/story01en.rpy:790
translate schinese story01_1_2b35b6fe_7:

    # mc "..."
    mc "……"

# game/story01en.rpy:792
translate schinese story01_1_2447c87a_1:

    # mc "Excuse me?"
    mc "你说什么？"

# game/story01en.rpy:793
translate schinese story01_1_02b96eea:

    # mc "What kind of man do you think I am?"
    mc "你以为我是什么人？"

# game/story01en.rpy:794
translate schinese story01_1_8e4ac321:

    # mc "I'm a clown, Lena. A CLOWN! Not a pervert."
    mc "我是小丑，莉娜。小、丑！不是变态。"

# game/story01en.rpy:796
translate schinese story01_1_14adf4b4:

    # L "Want me to remind you what happened with those elf girls? You were staring back then, too..."
    L "要我提醒你上次对那几个精灵姑娘做了什么吗？那时候你也盯着看……"

# game/story01en.rpy:798
translate schinese story01_1_98c480b5:

    # mc "That was strictly for resear—"
    mc "那纯粹是为了研究——"

# game/story01en.rpy:799
translate schinese story01_1_9993b94e_3:

    # L "..."
    L "……"

# game/story01en.rpy:800
translate schinese story01_1_6939e678:

    # mc "Alright, alright. Sorry."
    mc "好好好，我错了。"

# game/story01en.rpy:801
translate schinese story01_1_8ee37cf8:

    # mc "Maybe I stared a little... But only a little, okay?"
    mc "也许是有那么一点点……但就一点点，行了吧？"

# game/story01en.rpy:803
translate schinese story01_1_55aca9da:

    # mc "Besides, yours are better. Hers were way too big."
    mc "再说了，你的好看多了。她们那对实在太大了。"

# game/story01en.rpy:805
translate schinese story01_1_8d268b63:

    # L "(Soft sigh)"
    L "（轻轻叹气）"

# game/story01en.rpy:806
translate schinese story01_1_fe9da93f:

    # L "I don't care that you noticed. I'm not blind."
    L "你注意到了我不介意。我又不是瞎子。"

# game/story01en.rpy:807
translate schinese story01_1_d5a72dc0:

    # L "But did ya really have to stare that openly?"
    L "但你也不用看得那么明显吧？"

# game/story01en.rpy:836
translate schinese story01_2_e3b4316f:

    # mc "(This atmosphere... It's suffocating.)"
    mc "（这气氛……简直要人窒息。）"

# game/story01en.rpy:837
translate schinese story01_2_757aeba7:

    # mc "(The old man...)"
    mc "（那个老头……）"

# game/story01en.rpy:839
translate schinese story01_2_6f55720b:

    # mc "(In the flesh.)"
    mc "（本人。）"

# game/story01en.rpy:844
translate schinese story01_2_dc2a8bfe:

    # npc1 "(Whispering) No way... That's the director?!"
    npc1 "（低声）不会吧……那是校长？！"

# game/story01en.rpy:845
translate schinese story01_2_32608035:

    # npc1 "(Whispering) B-but what's he doing here?"
    npc1 "（低声）可、可他怎么会在这儿？"

# game/story01en.rpy:846
translate schinese story01_2_e88728b0:

    # mc "(And just like that, all eyes are on him.)"
    mc "（就这样，所有人的目光都落在他身上。）"

# game/story01en.rpy:848
translate schinese story01_2_0afec63a:

    # L "Well, aren't you lucky, [mc]. Your father-in-law!"
    L "哟，[mc]，你可真走运。你岳父来了！"

# game/story01en.rpy:850
translate schinese story01_2_cc0e5350:

    # mc "Thankfully, former father-in-law."
    mc "好在是“前”岳父。"

# game/story01en.rpy:851
translate schinese story01_2_e0728ef9:

    # mc "Lena, go. I'll call you later."
    mc "莉娜，走吧。我待会儿打给你。"

# game/story01en.rpy:853
translate schinese story01_2_1d7f3ef7:

    # L "Hey... [mc]."
    L "喂……[mc]。"

# game/story01en.rpy:854
translate schinese story01_2_5bdac16a:

    # mc "(Her voice... Did it get quieter?)"
    mc "（她的声音……是不是变小了？）"

# game/story01en.rpy:858
translate schinese story01_2_ea2f809b:

    # L "(Whispering) Go kick all their asses, got it?!"
    L "（低声）去把他们屁股全踹了，听到没？！"

# game/story01en.rpy:859
translate schinese story01_2_2b35b6fe:

    # mc "..."
    mc "……"

# game/story01en.rpy:860
translate schinese story01_2_bcccd399:

    # mc "(That smile of hers...)"
    mc "（她那个笑容……）"

# game/story01en.rpy:861
translate schinese story01_2_6a78c841:

    # mc "*Awkward chuckle*"
    mc "*尴尬地干笑*"

# game/story01en.rpy:862
translate schinese story01_2_eb151063:

    # mc "Sounds like a lotta work. And I'm not much of a hero anyway."
    mc "听起来活儿不少。而且我本来也不算什么英雄。"

# game/story01en.rpy:866
translate schinese story01_2_f9eda04b:

    # L "Hey, I was—"
    L "喂，我只是——"

# game/story01en.rpy:868
translate schinese story01_2_e1d1a871:

    # mc "I promise. I won't let you down."
    mc "我保证。不会让你失望的。"

# game/story01en.rpy:869
translate schinese story01_2_f4170572:

    # L "Remember, you promised!"
    L "记住你说的！"

# game/story01en.rpy:870
translate schinese story01_2_5e7f65d4:

    # L "Take care of yourself."
    L "照顾好自己。"

# game/story01en.rpy:873
translate schinese story01_2_d19f855d:

    # c "..."
    c "……"

# game/story01en.rpy:875
translate schinese story01_2_6eb28272:

    # c "Heroes."
    c "英雄们。"

# game/story01en.rpy:876
translate schinese story01_2_7208232d:

    # c "Sons and daughters of this great kingdom."
    c "这个伟大王国的子民们。"

# game/story01en.rpy:880
translate schinese story01_2_7f65efe5:

    # c "For years, you have toiled."
    c "多年来，你们付出了辛劳。"

# game/story01en.rpy:881
translate schinese story01_2_ce300ab7:

    # c "You have bled for others, fought to shield the weak, and laid your own dreams upon the altar of duty."
    c "你们为他人流过血，为守护弱者而战，将自己的梦想摆上责任的祭坛。"

# game/story01en.rpy:883
translate schinese story01_2_55e18948:

    # c "All for this moment."
    c "一切都是为了这一刻。"

# game/story01en.rpy:884
translate schinese story01_2_ff966a6b:

    # c "For the chance to change your fate..."
    c "为了改变命运的机会……"

# game/story01en.rpy:885
translate schinese story01_2_6a82d51d:

    # c "...and earn the right to stand among the heroes of our Kingdom."
    c "……为了赢得与我们王国英雄并肩而立的资格。"

# game/story01en.rpy:886
translate schinese story01_2_b8a7080a:

    # c "You are the chosen few."
    c "你们是被选中的少数人。"

# game/story01en.rpy:888
translate schinese story01_2_1e5b55d0:

    # c "The finest this nation could offer."
    c "是这个国家能献出的精华所在。"

# game/story01en.rpy:889
translate schinese story01_2_71e5573a:

    # c "You endured the preliminary trials."
    c "你们挺过了初选。"

# game/story01en.rpy:890
translate schinese story01_2_304b1841:

    # c "You proved yourselves superior..."
    c "你们证明了自己高人一等……"

# game/story01en.rpy:891
translate schinese story01_2_a9147b33:

    # c "...to thousands who failed where you prevailed."
    c "……胜过成千上万在你们成功之处失败的人。"

# game/story01en.rpy:895
translate schinese story01_2_dad484cf:

    # c "Yet..."
    c "然而……"

# game/story01en.rpy:897
translate schinese story01_2_c82303b6:

    # c "Do not deceive yourselves."
    c "不要自欺。"

# game/story01en.rpy:898
translate schinese story01_2_3777e34e:

    # c "A hero whom no one is willing to acknowledge..."
    c "无人愿意承认的英雄……"

# game/story01en.rpy:899
translate schinese story01_2_af4f1e23:

    # c "...is nearly as useless as a hero incapable of victory."
    c "……和一个打不了胜仗的英雄一样没用。"

# game/story01en.rpy:901
translate schinese story01_2_22a29bbd:

    # c "If you have come seeking status..."
    c "如果你们来这里是为了地位……"

# game/story01en.rpy:902
translate schinese story01_2_feb32155:

    # c "...or the satisfaction of personal ambition..."
    c "……或者为了满足个人的野心……"

# game/story01en.rpy:903
translate schinese story01_2_0cb17cb4:

    # c "Abandon such thoughts."
    c "那就放弃这些念头吧。"

# game/story01en.rpy:904
translate schinese story01_2_a2748208:

    # c "This Academy has no place for the weak."
    c "学院不收弱者。"

# game/story01en.rpy:905
translate schinese story01_2_9a41449e:

    # c "Nor for the undisciplined."
    c "也不收不自律的人。"

# game/story01en.rpy:907
translate schinese story01_2_877b5315:

    # mc "(Of course. You're looking right at me.)"
    mc "（当然了。你正盯着我看呢。）"

# game/story01en.rpy:908
translate schinese story01_2_4bfcaf57:

    # mc "(Still can't forgive me, can you, old man?)"
    mc "（还是没法原谅我，是吧，老头？）"

# game/story01en.rpy:909
translate schinese story01_2_21d47e6b:

    # c "And regrettably..."
    c "而很遗憾……"

# game/story01en.rpy:910
translate schinese story01_2_33c6910b:

    # c "...many of you shall fall before reaching the end."
    c "……你们当中许多人，还没走到……"

# game/story01en.rpy:918
translate schinese story01_2_1517366c:

    # "Three blue spheres appear in midair."
    "三个蓝色球体浮现在半空。"

# game/story01en.rpy:919
translate schinese story01_2_00752efd:

    # c "Three days. Three trials."
    c "三天。三场试炼。"

# game/story01en.rpy:920
translate schinese story01_2_d07fb1f4:

    # c "Today, the first trial tests the mind."
    c "今天，第一场试炼考验心智。"

# game/story01en.rpy:922
translate schinese story01_2_669c3846:

    # c "The second tests the body."
    c "第二场考验体魄。"

# game/story01en.rpy:923
translate schinese story01_2_0e4e09cf:

    # c "That awaits you tomorrow."
    c "明天在等着你们。"

# game/story01en.rpy:924
translate schinese story01_2_10b99b1a:

    # c "The third..."
    c "第三场……"

# game/story01en.rpy:925
translate schinese story01_2_555c9b95:

    # c "...shall test both."
    c "……将同时考验两者。"

# game/story01en.rpy:926
translate schinese story01_2_cba64e02:

    # c "That awaits you on the third day."
    c "第三天才轮到它。"

# game/story01en.rpy:928
translate schinese story01_2_d43b3d60:

    # c "Only by enduring and overcoming all three trials..."
    c "只有经受住并克服全部三场试炼……"

# game/story01en.rpy:929
translate schinese story01_2_55386037:

    # c "...will you earn the privilege of calling yourselves students of this Academy."
    c "……你们才配自称这所学院的学生。"

# game/story01en.rpy:930
translate schinese story01_2_bdf36815:

    # c "Tell me, then..."
    c "那么，告诉我……"

# game/story01en.rpy:931
translate schinese story01_2_4ad084e3:

    # c "Are you prepared to prove your worth?"
    c "你们准备好证明自己的价值了吗？"

# game/story01en.rpy:934
translate schinese story01_2_3999a4d4:

    # mc "(Good lord, that's a lotta theatrics...)"
    mc "（天老爷，这排场可真够大的……）"

# game/story01en.rpy:935
translate schinese story01_2_92badb85:

    # mc "(Unlike Philip, though, this old bastard's actually good at it.)"
    mc "（不过跟菲利普不同，这老混蛋确实很在行。）"

# game/story01en.rpy:937
translate schinese story01_2_78f2ccc1:

    # c "*Looking at one of the students.*"
    c "*看向其中一名学生。*"

# game/story01en.rpy:939
translate schinese story01_2_9ed29fcf:

    # c "Your name, student."
    c "学生，报上姓名。"

# game/story01en.rpy:942
translate schinese story01_2_ff41eb1f:

    # npc1 "Layla, sir!"
    npc1 "校长，我叫莱拉！"

# game/story01en.rpy:944
translate schinese story01_2_3c4961cb:

    # c "Why have you come here, Layla?"
    c "莱拉，你为何而来？"

# game/story01en.rpy:946
translate schinese story01_2_f7263980:

    # npc1 "To become stronger. And to protect others!"
    npc1 "为了变强，也为了守护他人！"

# game/story01en.rpy:948
translate schinese story01_2_139c6bba:

    # c "Good."
    c "很好。"

# game/story01en.rpy:956
translate schinese story01_2_35cb29ff:

    # c "*Points at another student.*"
    c "*指向另一名学生。*"

# game/story01en.rpy:957
translate schinese story01_2_a26b3f7d:

    # c "You."
    c "你。"

# game/story01en.rpy:958
translate schinese story01_2_3c80ebe8:

    # c "What is your purpose?"
    c "你的目的是什么？"

# game/story01en.rpy:977
translate schinese story01_2_b93e9e0c:

    # an "(M-me?)"
    an "（我、我？）"

# game/story01en.rpy:979
translate schinese story01_2_f34ff215:

    # an "(T-the director... picked me?! B-but what am I supposed to say... I-I...)"
    an "（校、校长……点了我的名？！可、可我要说什么啊……我、我……）"

# game/story01en.rpy:981
translate schinese story01_2_8663adaf:

    # an "I-I... came here to b-become better..."
    an "我、我是为了变、变得更好……"

# game/story01en.rpy:982
translate schinese story01_2_8ca61e46:

    # an "P-probably..."
    an "大、大概……"

# game/story01en.rpy:983
translate schinese story01_2_7628b435:

    # n "...how did she even get in here?"
    n "……她是怎么进来的？"

# game/story01en.rpy:984
translate schinese story01_2_96a8606f:

    # n "Maybe she's just got a big heart."
    n "也许她只是心肠软吧。"

# game/story01en.rpy:986
translate schinese story01_2_d19f855d_1:

    # c "..."
    c "……"

# game/story01en.rpy:987
translate schinese story01_2_7fb58c2e:

    # c "(Terrified of speaking... yet she answered nonetheless.)"
    c "（怕得要死……但还是答了。）"

# game/story01en.rpy:989
translate schinese story01_2_f3522c9e:

    # c "That, too..."
    c "这一点，也……"

# game/story01en.rpy:990
translate schinese story01_2_0c4a8b0b:

    # c "...is a worthy answer."
    c "……算是合格的答案。"

# game/story01en.rpy:996
translate schinese story01_2_23139dd2:

    # mc "(You're not gonna let me off that easy...)"
    mc "（你不会这么轻易放过我……）"

# game/story01en.rpy:999
translate schinese story01_2_0d02b9b3:

    # c "Miss Mia."
    c "米娅小姐。"

# game/story01en.rpy:1000
translate schinese story01_2_2777c748:

    # c "If you would, step forward."
    c "既然如此，请上前一步。"

# game/story01en.rpy:1005
translate schinese story01_2_0f69fa0f:

    # mc "(What the—)"
    mc "（什么——）"

# game/story01en.rpy:1008
translate schinese story01_2_c3c80b58:

    # Mi "(Gesturing) Sorry, sorry."
    Mi "（比划着）抱歉抱歉。"

# game/story01en.rpy:1009
translate schinese story01_2_a8201552:

    # mc "(Bitch.)"
    mc "（臭娘们。）"

# game/story01en.rpy:1012
translate schinese story01_2_5f9a5116:

    # mc "(No. Keep it together. That's exactly what she wants.)"
    mc "（不。冷静。这正是她想要的。）"

# game/story01en.rpy:1016
translate schinese story01_2_b4f53177:

    # "The examiner makes a few notes."
    "考官记了几笔。"

# game/story01en.rpy:1019
translate schinese story01_2_ff3b94e7:

    # mc "(Gesturing) (You're seriously gonna let that slide?!)"
    mc "（比划着）（你就这么放过她了？！）"

# game/story01en.rpy:1022
translate schinese story01_2_286788b4:

    # mc "(Completely ignored. Then again, what else did I expect?)"
    mc "（彻底无视了。不过也是，我还能指望什么？）"

# game/story01en.rpy:1025
translate schinese story01_2_eb522c34:

    # mc "(I'm sure this was your idea, old man.)"
    mc "（这肯定是你安排的吧，老头。）"

# game/story01en.rpy:1029
translate schinese story01_2_32ac6f4b:

    # c "Instructor Mia."
    c "米娅教官。"

# game/story01en.rpy:1030
translate schinese story01_2_4df2084f:

    # c "Known to the Kingdom as one of the Seven Heroes..."
    c "作为王国闻名的“七英雄”之一……"

# game/story01en.rpy:1031
translate schinese story01_2_db4660d6:

    # c "...the Beast of the Eastern Front."
    c "……“东境猛兽”。"

# game/story01en.rpy:1033
translate schinese story01_2_14b01e5b:

    # n "Mia... one of the Seven Heroes?!"
    n "米娅……是七英雄之一？！"

# game/story01en.rpy:1034
translate schinese story01_2_2fd88604:

    # n "Wait, what?! The Beast herself?!"
    n "等等，什么？！是猛兽本人？！"

# game/story01en.rpy:1035
translate schinese story01_2_988c5c85:

    # n "...Seeing her in person. Mom, pinch me."
    n "……真人诶。妈，掐我一下。"

# game/story01en.rpy:1038
translate schinese story01_2_f4540898:

    # mc "(Oh, wow. What a surprise.)"
    mc "（哦，哇。真意外。）"

# game/story01en.rpy:1039
translate schinese story01_2_b20ba443:

    # mc "(Not like she stood out from the crowd or anything...)"
    mc "（她在人群里也不怎么显眼嘛……）"

# game/story01en.rpy:1041
translate schinese story01_2_053a30fa:

    # mc "*Looks around at the others*"
    mc "*环顾四周*"

# game/story01en.rpy:1042
translate schinese story01_2_e9cfcbb7:

    # mc "(Miscalculated. Everyone here sticks out like a sore thumb.)"
    mc "（失算了。这儿的人个个都显眼得很。）"

# game/story01en.rpy:1044
translate schinese story01_2_9af3d426:

    # Mi "(Whispering) Your future son-in-law's a rather interestin' lad."
    Mi "（低声）你未来女婿可是个相当有意思的小子。"

# game/story01en.rpy:1045
translate schinese story01_2_6a6197c3:

    # Mi "(Whispering) Though if you don't want him..."
    Mi "（低声）不过你要是不要他……"

# game/story01en.rpy:1046
translate schinese story01_2_a7d81fa5:

    # Mi "(Whispering) Mind if I steal him for one of my daughters?"
    Mi "（低声）我把他拐去给我女儿当女婿，你不介意吧？"

# game/story01en.rpy:1048
translate schinese story01_2_d19f855d_2:

    # c "..."
    c "……"

# game/story01en.rpy:1051
translate schinese story01_2_a389442b:

    # c "(whispering) I have no intention of stopping you."
    c "（低声）我可没打算拦你。"

# game/story01en.rpy:1053
translate schinese story01_2_51b3698f:

    # c "The remainder of the briefing will be conducted by Instructor Mia."
    c "剩下的说明由米娅教官继续。"

# game/story01en.rpy:1057
translate schinese story01_2_8d433f46:

    # mc "(Creepy...)"
    mc "（真恶心……）"

# game/story01en.rpy:1059
translate schinese story01_2_d75569f1:

    # c "And prove that the hopes of this Kingdom..."
    c "并证明这个王国的期望……"

# game/story01en.rpy:1060
translate schinese story01_2_8d3a7eb4:

    # c "...were not misplaced in you."
    c "……并没有错付给你们。"

# game/story01en.rpy:1070
translate schinese story01_2_0c0fb9b3:

    # Mi "Thank you, Director."
    Mi "谢谢您，校长。"

# game/story01en.rpy:1072
translate schinese story01_2_d4063ddf:

    # Mi "(Right then... where do I start?)"
    Mi "（那么……从哪儿说起呢？）"

# game/story01en.rpy:1075
translate schinese story01_2_99705de1:

    # Mi "I'll be straight with ya. Twenty percent."
    Mi "我就直说了。百分之二十。"

# game/story01en.rpy:1076
translate schinese story01_2_8b1430cf:

    # Mi "Exactly one hundred of you will pass this exam."
    Mi "你们当中正好一百人通过考试。"

# game/story01en.rpy:1078
translate schinese story01_2_24e717e0:

    # n "Twenty percent? That's eight percent lower than last year!"
    n "百分之二十？比去年还低了八个点！"

# game/story01en.rpy:1079
translate schinese story01_2_b3575624:

    # n "That's insane..."
    n "这太离谱了……"

# game/story01en.rpy:1082
translate schinese story01_2_2972f2af:

    # Mi "And it's not just because we're stricter this year. Though that's part of it."
    Mi "而且这可不只是因为今年更严格。虽然这也是原因之一。"

# game/story01en.rpy:1083
translate schinese story01_2_cd458ce1:

    # Mi "This year's admission quota got cut."
    Mi "今年的录取名额被削减了。"

# game/story01en.rpy:1085
translate schinese story01_2_eaee3938:

    # Mi "As most of ya already know, every hero needs a licence."
    Mi "相信大多数人都知道，每位英雄都需要执照。"

# game/story01en.rpy:1086
translate schinese story01_2_e19fc7ac:

    # Mi "Problem is, thanks to resource shortages..."
    Mi "问题在于，由于资源短缺……"

# game/story01en.rpy:1087
translate schinese story01_2_3a15959b:

    # Mi "...handin' 'em out's become a bit of a headache."
    Mi "……发放执照成了件麻烦事。"

# game/story01en.rpy:1089
translate schinese story01_2_5499bd2d:

    # n "Question. Isn't the Kingdom required to issue them automatically?"
    n "请问。王国不是应该自动发放吗？"

# game/story01en.rpy:1091
translate schinese story01_2_51ea1089:

    # Mi "We are."
    Mi "是的。"

# game/story01en.rpy:1093
translate schinese story01_2_4e3bb773:

    # n "Then wh—"
    n "那为什……"

# game/story01en.rpy:1095
translate schinese story01_2_1a6f9e9d:

    # Mi "Find the resources for the licence plates yourself, then."
    Mi "那你就自己去找制作牌照的资源好了。"

# game/story01en.rpy:1096
translate schinese story01_2_425fda3d:

    # Mi "Who's stoppin' ya?"
    Mi "谁拦着你了？"

# game/story01en.rpy:1099
translate schinese story01_2_1846c191:

    # n "BUT THAT'S NOT FAIR!"
    n "可这不公平！"

# game/story01en.rpy:1102
translate schinese story01_2_a3e3e41c:

    # mc "(Wait, did he just...)"
    mc "（等等，他刚刚……）"

# game/story01en.rpy:1103
translate schinese story01_2_ce6b83aa:

    # mc "(He didn't write down the fox's answer. He wrote down that guy's reaction?)"
    mc "（他没记那只狐狸的回答。他记的是那小子的反应？）"

# game/story01en.rpy:1107
translate schinese story01_2_cf9e0194:

    # Mi "Name?"
    Mi "姓名？"

# game/story01en.rpy:1108
translate schinese story01_2_27b0124b:

    # n "Martin."
    n "马丁。"

# game/story01en.rpy:1111
translate schinese story01_2_0db45e4a:

    # Mi "Here's a little secret, Martin."
    Mi "告诉你个小秘密，马丁。"

# game/story01en.rpy:1112
translate schinese story01_2_2734a218:

    # Mi "I don't give a shit."
    Mi "我根本不在乎。"

# game/story01en.rpy:1115
translate schinese story01_2_87a7bcd9:

    # Mi "My job's to test what you're capable of."
    Mi "我的工作只是测试你们的能力。"

# game/story01en.rpy:1116
translate schinese story01_2_c735a4b0:

    # Mi "If it bothers ya that much, then don't let the others beat ya."
    Mi "既然这么在意，那就别让别人抢先。"

# game/story01en.rpy:1118
translate schinese story01_2_7329681e:

    # E "..."
    E "……"

# game/story01en.rpy:1120
translate schinese story01_2_e64c3bb6:

    # Mi "Anyone's got a problem with that, door's at the back."
    Mi "谁有意见，门口出去。"

# game/story01en.rpy:1121
translate schinese story01_2_bedce578:

    # Mi "And I couldn't care less what sort of problems you've got."
    Mi "你有什么问题我可一点都不关心。"

# game/story01en.rpy:1122
translate schinese story01_2_cfe41484:

    # Mi "Need money, last chance, tragic backstory, whatever."
    Mi "需要钱、走投无路、悲惨身世，随便什么都行。"

# game/story01en.rpy:1125
translate schinese story01_2_d1e81074:

    # Mi "You either pass the exam, or you don't."
    Mi "要么通过考试，"
    Mi "要么通不过。"

# game/story01en.rpy:1126
translate schinese story01_2_541f2b7c:

    # Mi "That's it."
    Mi "就这样。"

# game/story01en.rpy:1127
translate schinese story01_2_2429ff25:

    # Mi "Are we clear?"
    Mi "听明白了吗？"

# game/story01en.rpy:1134
translate schinese story01_2_892b745d:

    # Mi "I'll ask again."
    Mi "我再问一遍。"

# game/story01en.rpy:1135
translate schinese story01_2_e016f299:

    # Mi "Are we clear?!"
    Mi "听明白了吗？！"

# game/story01en.rpy:1137
translate schinese story01_2_16607e93:

    # E "YES!"
    E "太好了！"

# game/story01en.rpy:1140
translate schinese story01_2_f869bb7a:

    # mc "(First Richard, now her. Actors without an Oscar, but damn if they aren't convincing.)"
    mc "（先是理查德，现在又是她。没拿过奥斯卡的演员，但演得还真像那么回事。）"

# game/story01en.rpy:1143
translate schinese story01_2_c7716e8a:

    # mc "(One, two... eight... Twenty-two people with notebooks in total.)"
    mc "（一、二……八……总共有二十二个拿着本子的人。）"

# game/story01en.rpy:1144
translate schinese story01_2_8869fa17:

    # mc "(Writing down every move we make. Testing how we handle stress?)"
    mc "（记录我们的一举一动。测试我们如何应对压力？）"

# game/story01en.rpy:1146
translate schinese story01_2_2782ea7d:

    # mc "(That punch from earlier... No. Then why would they need so many examiners?)"
    mc "（刚才那一拳……不对。那他们为什么要这么多考官？）"

# game/story01en.rpy:1147
translate schinese story01_2_258d3907:

    # mc "(It's like all of this is just a warm-up...)"
    mc "（就好像这一切都只是热身……）"

# game/story01en.rpy:1149
translate schinese story01_2_02aa1603:

    # mc "(For exam? Or test?)"
    mc "（是考试？还是测验？）"

# game/story01en.rpy:1151
translate schinese story01_2_7611f41a:

    # Mi "Now then, about today's trial."
    Mi "好，说说今天的试炼。"

# game/story01en.rpy:1152
translate schinese story01_2_36cfdf0f:

    # Mi "Like the Director said, this one's gonna test your minds."
    Mi "就像校长说的，这场考验的是你们的头脑。"

# game/story01en.rpy:1153
translate schinese story01_2_d6b19418:

    # Mi "Three stages. Forty points each."
    Mi "三个阶段，每阶段四十分。"

# game/story01en.rpy:1154
translate schinese story01_2_8472b2bc:

    # Mi "Each stage is worth forty points."
    Mi "每个阶段值四十分。"

# game/story01en.rpy:1155
translate schinese story01_2_5d913c5d:

    # Mi "Failin' one won't send ya home."
    Mi "有一个阶段不及格，你不会被赶回去。"

# game/story01en.rpy:1156
translate schinese story01_2_60d0edbe:

    # Mi "It'll just make catchin' up a whole lot harder."
    Mi "只是会让你追分追得痛苦万分。"

# game/story01en.rpy:1157
translate schinese story01_2_b2aa07cb:

    # Mi "At the end of each day, we'll update the standings."
    Mi "每天结束时我们会公布排名。"

# game/story01en.rpy:1158
translate schinese story01_2_1578ff2f:

    # Mi "Your position depends on your team's total score."
    Mi "你们的排名取决于队伍总分。"

# game/story01en.rpy:1160
translate schinese story01_2_10dcb5a7:

    # Mi "Before we begin, understand two thing."
    Mi "开始之前，有两点要说明。"

# game/story01en.rpy:1161
translate schinese story01_2_1d88dc5b:

    # Mi "First: we've been watching since the moment ya walked through those doors."
    Mi "第一：从你们踏进那扇门的那一刻起，我们就一直在看。"

# game/story01en.rpy:1162
translate schinese story01_2_a4ef07eb:

    # Mi "Every choice ya make in this hall tells us something."
    Mi "你们在这大厅里的每一个选择都在告诉我们一些事。"

# game/story01en.rpy:1163
translate schinese story01_2_1e065d0d:

    # Mi "Second: not every stage will be announced."
    Mi "第二：不是每个阶段都会被公布。"

# game/story01en.rpy:1164
translate schinese story01_2_f1032b36:

    # Mi "Sometimes figuring out what's being tested is part of the test."
    Mi "有时，搞清楚要考什么本身就是考试的一部分。"

# game/story01en.rpy:1166
translate schinese story01_2_19f4a7b8:

    # mc "(So that's what all those examiners were for.)"
    mc "（所以那些考官都是为这个。）"

# game/story01en.rpy:1167
translate schinese story01_2_5e6a6f13:

    # mc "(They were setting this up from the start.)"
    mc "（他们从一开始就在布这个局。）"

# game/story01en.rpy:1168
translate schinese story01_2_b2cd4ea7:

    # mc "(Not exactly subtle, but hey, points for effort.)"
    mc "（算不上高明，不过，好歹有这份心思。）"

# game/story01en.rpy:1170
translate schinese story01_2_75bf1d37:

    # Mi "Now for the first stage."
    Mi "现在是第一阶段。"

# game/story01en.rpy:1171
translate schinese story01_2_f5339054:

    # Mi "Form teams of three."
    Mi "三人成组。"

# game/story01en.rpy:1172
translate schinese story01_2_d6e53546:

    # Mi "And choose carefully."
    Mi "仔细挑。"

# game/story01en.rpy:1173
translate schinese story01_2_7d26fa43:

    # Mi "The team ya form today stays together for all three trials."
    Mi "今天组成的队伍，三场试炼都绑在一起。"

# game/story01en.rpy:1174
translate schinese story01_2_ceaaa908:

    # Mi "If ya get accepted, you'll remain together until the end of your first semester."
    Mi "就算你们被录取，也要在一起待到第一学期结束。"

# game/story01en.rpy:1175
translate schinese story01_2_1d01ac74:

    # Mi "This time, you choose them yourselves."
    Mi "这一次，由你们自己挑人。"

# game/story01en.rpy:1180
translate schinese story01_2_0e131313:

    # Mi "First rule of the Academy."
    Mi "学院第一条规矩。"

# game/story01en.rpy:1181
translate schinese story01_2_8f4f4ae9:

    # Mi "Your team's closer than family."
    Mi "你的队伍比家人还亲。"

# game/story01en.rpy:1182
translate schinese story01_2_53b59261:

    # Mi "Once the teams are formed, groups of three will be sent in for interviews."
    Mi "队伍组建完成后，会以三人一组接受面试。"

# game/story01en.rpy:1183
translate schinese story01_2_6649544a:

    # Mi "That's where they'll spend an hour fillin' your heads with justice, peace, and all that."
    Mi "他们会在那儿花一个小时，往你们脑子里灌正义、和平之类的屁话。"

# game/story01en.rpy:1186
translate schinese story01_2_ccfcac7a:

    # Mi "Second rule."
    Mi "第二条规矩。"

# game/story01en.rpy:1187
translate schinese story01_2_f7c2eef8:

    # Mi "Strength runs the world."
    Mi "力量才是这个世界的法则。"

# game/story01en.rpy:1188
translate schinese story01_2_6fce8d8c:

    # Mi "If you disagree, get stronger and prove me wrong."
    Mi "不服气？变强，然后证明我是错的。"

# game/story01en.rpy:1190
translate schinese story01_2_06e63101:

    # n "W-what if... you d-don't have any powers..."
    n "那、那要是……你、你根本没有能力呢……"

# game/story01en.rpy:1191
translate schinese story01_2_d2a87018:

    # Mi "What're ya mumblin' there? Louder."
    Mi "你在那儿嘟囔什么？大点声。"

# game/story01en.rpy:1192
translate schinese story01_2_4fec19de:

    # n "R-right... what if you d-don't have any p-pow—"
    n "对、对……要是你、你没有任何能、力——"

# game/story01en.rpy:1195
translate schinese story01_2_25536126:

    # Mi "Then use your brain."
    Mi "那就用脑子。"

# game/story01en.rpy:1196
translate schinese story01_2_3b1f930f:

    # Mi "And if you've got neither brains nor strength..."
    Mi "那要是脑子和力量都没有呢……"

# game/story01en.rpy:1197
translate schinese story01_2_2958ab99:

    # Mi "What the hell are ya doin' here?"
    Mi "那你来这儿干嘛？"

# game/story01en.rpy:1199
translate schinese story01_2_87fe91a7:

    # mc "(Teams? Well, that's a problem.)"
    mc "（组队？嗯，这可有点麻烦。）"

# game/story01en.rpy:1200
translate schinese story01_2_0616c16d:

    # mc "(After that little performance, half the room thinks I'm an idiot. The other half thinks I'm trouble.)"
    mc "（刚才那出戏之后，半数人觉得我是个白痴，另一半觉得我是个麻烦。）"

# game/story01en.rpy:1201
translate schinese story01_2_a83f69c7:

    # mc "(Fantastic start to a team-based exam.)"
    mc "（以组队为核心的考试，开局真棒。）"

# game/story01en.rpy:1202
translate schinese story01_2_4c8982ed:

    # mc "(What the hell do I—)"
    mc "（我他妈该——）"

# game/story01en.rpy:1206
translate schinese story01_2_2158b111:

    # Mi "(Whispering) And now..."
    Mi "（低声）接下来……"

# game/story01en.rpy:1207
translate schinese story01_2_2bdfcefc:

    # Mi "(Whispering) My favourite part."
    Mi "（低声）是我最喜欢的部分。"

# game/story01en.rpy:1213
translate schinese story01_2_96014abc:

    # Mi "Four minutes to find yourselves a team!"
    Mi "四分钟，给自己找队伍！"

# game/story01en.rpy:1216
translate schinese story01_2_2f92af57:

    # Mi "Clock's tickin'."
    Mi "时间在走。"

# game/story01en.rpy:1223
translate schinese story01_3_e4a562e0:

    # "The room falls silent."
    "大厅安静下来。"

# game/story01en.rpy:1224
translate schinese story01_3_d1e63dd2:

    # mc "Wh—"
    mc "什——"

# game/story01en.rpy:1228
translate schinese story01_3_21c43781:

    # n "OUTTA MY WAY!"
    n "让开！"

# game/story01en.rpy:1229
translate schinese story01_3_0548cac9:

    # n "YOU— YOU'RE COMING WITH ME!"
    n "你——你跟我走！"

# game/story01en.rpy:1231
translate schinese story01_3_45a56c18:

    # n "G-get lost, brat—"
    n "滚、滚开，小鬼——"

# game/story01en.rpy:1232
translate schinese story01_3_b51c0d2d:

    # mc "(Chaos... Complete and utter chaos.)"
    mc "（混乱……彻底的、彻骨的混乱。）"

# game/story01en.rpy:1233
translate schinese story01_3_816ae197:

    # mc "(No. Just stay calm.)"
    mc "（不。冷静。）"

# game/story01en.rpy:1235
translate schinese story01_3_e7a001bf:

    # mc "(Think... think...)"
    mc "（想想……好好想想……）"

# game/story01en.rpy:1236
translate schinese story01_3_0c5981f2:

    # mc "(My strength is my brain, right? Then I need someone for the physical exam.)"
    mc "（我的强项是脑子，对吧？那体测那边就得找个人。）"

# game/story01en.rpy:1239
translate schinese story01_3_340e3641:

    # mc "(Strong enough to carry their own weight...)"
    mc "（强壮到能扛住自己的体重……）"

# game/story01en.rpy:1240
translate schinese story01_3_5228e18e:

    # mc "(But not dumb enough to become dead weight.)"
    mc "（但又不至于蠢到变成累赘。）"

# game/story01en.rpy:1243
translate schinese story01_3_5407b343:

    # mc "(That guy? Yeah, he looks sturdy.)"
    mc "（那家伙？嗯，看着挺结实。）"

# game/story01en.rpy:1248
translate schinese story01_3_d9fdd30b:

    # n "Mom, I wanna go home! This place is scary—"
    n "妈，我要回家！这地方好可怕——"

# game/story01en.rpy:1249
translate schinese story01_3_2b35b6fe:

    # mc "..."
    mc "……"

# game/story01en.rpy:1250
translate schinese story01_3_669a015f:

    # mc "(Nope. Too scared. He'll be a liability.)"
    mc "（不行。太胆小了。会拖后腿。）"

# game/story01en.rpy:1253
translate schinese story01_3_fe4d7bab:

    # mc "(Her? Lean build. Strong arms. Might work.)"
    mc "（她？体型精瘦。手臂有力。也许行。）"

# game/story01en.rpy:1254
translate schinese story01_3_40dd767b:

    # n "I REFUSE TO ASSOCIATE WITH BRUTES!"
    n "我拒绝跟野蛮人同伙！"

# game/story01en.rpy:1255
translate schinese story01_3_8c2f42fe:

    # mc "...never mind."
    mc "……算了。"

# game/story01en.rpy:1257
translate schinese story01_3_b85c3602:

    # mc "(Everyone's acting like a bunch of clowns... That's my job!)"
    mc "（一个个都跟小丑似的……可那是我的活儿！）"

# game/story01en.rpy:1258
translate schinese story01_3_20adadfe:

    # mc "(C'mon, where—)"
    mc "（来吧，在哪儿——）"

# game/story01en.rpy:1261
translate schinese story01_3_69d672d3:

    # r "(Three, eight, six... Nothin' but useless weaklings.)"
    r "（三、八、六……全是没用的软柿子。）"

# game/story01en.rpy:1262
translate schinese story01_3_a45fced6:

    # r "(Why the hell's everybody panickin' anyway?)"
    r "（大家到底在慌个什么？）"

# game/story01en.rpy:1264
translate schinese story01_3_77aa010d:

    # r "(Still got a whole two minutes—)"
    r "（还剩整整两分钟——）"

# game/story01en.rpy:1265
translate schinese story01_3_843d5597:

    # r "(Two minutes?! I ain't found anybody yet!)"
    r "（两分钟？！我一个人都还没找到呢！）"

# game/story01en.rpy:1267
translate schinese story01_3_cc40ca88:

    # r "(No, Rose. What d'people usually say in situations like this...)"
    r "（不对，罗丝。这种时候大家一般会怎么说来着……）"

# game/story01en.rpy:1268
translate schinese story01_3_47da7f90:

    # r "(Everythin's gonna be fine? Yeah, statistically speakin', that's bullshit.)"
    r "（“一切都会好起来的是吧”？说真的，按概率算那就是屁话。）"

# game/story01en.rpy:1270
translate schinese story01_3_b6a98205:

    # r "(How the hell's everythin' supposed to be fine when my analysis says we're completely screwed?)"
    r "（我的分析明明说我们完蛋了，情况怎么可能还好得了？）"

# game/story01en.rpy:1273
translate schinese story01_3_4c945ec2:

    # r "(That face... My optics ain't glitchin', are they?)"
    r "（那张脸……我的眼睛没出故障吧？）"

# game/story01en.rpy:1275
translate schinese story01_3_c52113e7:

    # r "(Whispering) He'll do..."
    r "（低声）他行……"

# game/story01en.rpy:1277
translate schinese story01_3_6e965381:

    # r "(Yeah, that's him. Still ain't noticed me, though.)"
    r "（对，就是他。不过他还没注意到我。）"

# game/story01en.rpy:1278
translate schinese story01_3_30835faa:

    # r "([mc], right? Maybe I oughta call out—)"
    r "（是[mc]吧？我是不是该喊一声——）"

# game/story01en.rpy:1280
translate schinese story01_3_d74f5fb3:

    # mc "(Rose? What the hell is she doing here—)"
    mc "（罗丝？她跑这儿来干嘛——）"

# game/story01en.rpy:1283
translate schinese story01_3_1f38ec0b:

    # r "Clown!"
    r "小丑！"

# game/story01en.rpy:1284
translate schinese story01_3_9d122515:

    # r "(No, damn it, I meant to say...)"
    r "（不，该死，我想说的是……）"

# game/story01en.rpy:1287
translate schinese story01_3_a3c2a8f7:

    # mc "Clanker!"
    mc "铁皮！"

# game/story01en.rpy:1288
translate schinese story01_3_26846f92:

    # r "(Screw you!)"
    r "（去你的！）"

# game/story01en.rpy:1291
translate schinese story01_3_1f38ec0b_1:

    # r "Clown!"
    r "小丑！"

# game/story01en.rpy:1292
translate schinese story01_3_a3c2a8f7_1:

    # mc "Clanker!"
    mc "铁皮！"

# game/story01en.rpy:1295
translate schinese story01_3_a896ae17:

    # r "Screw—"
    r "滚你的——"

# game/story01en.rpy:1297
translate schinese story01_3_13a7147c:

    # r "(Nope. Stop. Repeatin' myself.)"
    r "（不行。停。别再重复了。）"

# game/story01en.rpy:1298
translate schinese story01_3_bc97d2fa:

    # mc "What're you doing here?!"
    mc "你来这儿干嘛？！"

# game/story01en.rpy:1300
translate schinese story01_3_c90d989b:

    # r "Money."
    r "钱。"

# game/story01en.rpy:1301
translate schinese story01_3_bb8ecbf0:

    # r "Academy pays one hell of a scholarship. And I got debts to pay off."
    r "学院给的奖学金多得要命。而且我还欠着一屁股债。"

# game/story01en.rpy:1303
translate schinese story01_3_72566279:

    # r "(He already showed he ain't useless. That whole bike mess proved it.)"
    r "（他已经证明自己不是废物了。那场破自行车闹剧就是证据。）"

# game/story01en.rpy:1305
translate schinese story01_3_68233642:

    # mc "Now that's an interesting thought process."
    mc "这思路有点意思。"

# game/story01en.rpy:1306
translate schinese story01_3_a7a73f92:

    # mc "Wouldn't getting a job be easier?"
    mc "找个工作不是更省事？"

# game/story01en.rpy:1309
translate schinese story01_3_10f33e0e:

    # r "I was doin' just fine at my job till some asshole clown showed up."
    r "我本来干得好好的，直到某个混蛋小丑冒出来。"

# game/story01en.rpy:1311
translate schinese story01_3_6a57430d:

    # mc "Maybe you shouldn't have stolen my bike. Then you'd still have one."
    mc "也许你不该偷我自行车。那你现在还有得骑。"

# game/story01en.rpy:1313
translate schinese story01_3_544c4f09:

    # r "Oh, good. Glad ya brought that up. We had a deal."
    r "哦，好啊。真是谢谢您提起来。我们可是有约定的。"

# game/story01en.rpy:1314
translate schinese story01_3_8093e7bd:

    # r "One ya managed to screw up all on your own—"
    r "结果你自己全搞砸了——"

# game/story01en.rpy:1317
translate schinese story01_3_54159567:

    # mc "Shh... Complaints later."
    mc "嘘……回头再算账。"

# game/story01en.rpy:1318
translate schinese story01_3_b9eb743f:

    # mc "We got ninety seconds to find one more mem—"
    mc "我们还有九十秒找一个队员——"

# game/story01en.rpy:1321
translate schinese story01_3_f5056c31:

    # r "Then her."
    r "那就她。"

# game/story01en.rpy:1325
translate schinese story01_3_817ed4a4:

    # mc "The girl from the café? She's way too quiet. She'll drag us down."
    mc "咖啡馆那女孩？她太安静了。会拖我们后腿。"

# game/story01en.rpy:1326
translate schinese story01_3_30c8614d:

    # r "She's Mia's daughter."
    r "她是米娅的女儿。"

# game/story01en.rpy:1327
translate schinese story01_3_dd6c774c:

    # mc "Wait, that fox is her mom?"
    mc "等等，那只狐狸是她妈？"

# game/story01en.rpy:1329
translate schinese story01_3_7c20602c:

    # mc "(A free pass?)"
    mc "（等于直接过关？）"

# game/story01en.rpy:1331
translate schinese story01_3_76f0fcd3:

    # mc "(Are you thinking what I'm thinking?)"
    mc "（你想的是不是跟我一样？）"

# game/story01en.rpy:1332
translate schinese story01_3_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/story01en.rpy:1336
translate schinese story01_3_89e7ae43:

    # bot "(Jackpot.)"
    bot "（中大奖了。）"

# game/story01en.rpy:1339
translate schinese story01_3_f9398164:

    # r "SHE'S OUR TICKET TO THE GOOD LIFE!"
    r "她就是咱俩过上好生活的门票！"

# game/story01en.rpy:1340
translate schinese story01_3_6344b4ba:

    # mc "We'll get her, no matter what it takes!"
    mc "不管用什么手段，都要把她拉进来！"

# game/story01en.rpy:1344
translate schinese story01_3_ade1aa9e:

    # mc "(Sorry, horsie, but...)"
    mc "（抱歉啦，马儿，可是……）"

# game/story01en.rpy:1349
translate schinese story01_3_fbad482b:

    # r "(Did he just... use that horse as a damn springboard?!)"
    r "（他刚才……是把那匹马当成弹簧板了吗？！）"

# game/story01en.rpy:1351
translate schinese story01_3_f1649e57:

    # mc "(Mom, look! I'm shining!)"
    mc "（妈，快看！我在发光！）"

# game/story01en.rpy:1355
translate schinese story01_3_4c38e03b:

    # an "Wh-"
    an "什——"

# game/story01en.rpy:1356
translate schinese story01_3_15bbdec0:

    # an "A-a wet dream?"
    an "梦、梦遗？"

# game/story01en.rpy:1360
translate schinese story01_3_351fe1ff:

    # mc "That's me. Wanna join our team?"
    mc "那就是我。要加入我们队伍吗？"

# game/story01en.rpy:1361
translate schinese story01_3_a3816a0d:

    # mc "Please, say yes. You're the only sensible choice we've got!"
    mc "求你了，说好。你是我们唯一靠谱的人选！"

# game/story01en.rpy:1364
translate schinese story01_3_e8e38ec1:

    # an "..."
    an "……"

# game/story01en.rpy:1365
translate schinese story01_3_50343c77:

    # an "(H-he's... sooo close. A-and way too impulsive.)"
    an "（他、他……好近。而且太冲动了。）"

# game/story01en.rpy:1366
translate schinese story01_3_7bebc337:

    # an "(B-but yesterday, out of everyone there... h-he was the one who protected that girl from the b-bear, right?)"
    an "（可、可是昨天在场的所有人里……他、他保护了那个女孩不被熊咬，对吧？）"

# game/story01en.rpy:1368
translate schinese story01_3_c44e3df3:

    # an "U-um... are you s-sure I'd be a good fit?"
    an "那、那个……你、你确定我合适吗？"

# game/story01en.rpy:1369
translate schinese story01_3_1b8e4750:

    # an "I-I'm r-reeeally not that confident..."
    an "我、我真的不是很有信心……"

# game/story01en.rpy:1372
translate schinese story01_3_38c137ac:

    # mc "One hundred percent."
    mc "百分之一百。"

# game/story01en.rpy:1373
translate schinese story01_3_56b2ecee:

    # mc "Besides, for someone so shy, you handled yourself pretty damn well yesterday!"
    mc "再说了，你这么害羞，昨天也表现得相当不错！"

# game/story01en.rpy:1375
translate schinese story01_3_b750b937:

    # r "(Whispering) Hey. Ain't that a bit much? Ever heard of personal space?"
    r "（低声）喂。这有点过了吧？听说过个人空间吗？"

# game/story01en.rpy:1377
translate schinese story01_3_db6b61d1:

    # mc "Don't mind her. She's just jealous."
    mc "别管她。她就是嫉妒。"

# game/story01en.rpy:1379
translate schinese story01_3_0a219f93:

    # mc "(Whispering) What the hell are you doing?"
    mc "（低声）你到底在干嘛？"

# game/story01en.rpy:1380
translate schinese story01_3_004c842a:

    # r "(Whispering) What the hell are YOU doin'? Can't ya tell? You're makin' her uncomfortable crowdin' her like that."
    r "（低声）你干嘛？看不出来吗？你这样贴上去让她很不舒服。"

# game/story01en.rpy:1381
translate schinese story01_3_47e22cd3:

    # mc "(Whispering) Really? I thought—"
    mc "（低声）真的吗？我还以为——"

# game/story01en.rpy:1383
translate schinese story01_3_32dc8f75:

    # an "B-but why..."
    an "可、可是为什么……"

# game/story01en.rpy:1386
translate schinese story01_3_54490122:

    # mc "Because of your mother. We figured nepotism might carry us through the exam."
    mc "因为你妈。我们想着走关系说不定能帮我们撑过考试。"

# game/story01en.rpy:1388
translate schinese story01_3_ebe234df:

    # r "...and ya just went and dumped all that on her?"
    r "……你就这么把一切都砸她脸上了？"

# game/story01en.rpy:1390
translate schinese story01_3_74cdfa89:

    # mc "Truth, the whole truth, and nothing but the truth."
    mc "真相，全部的真相，绝无隐瞒。"

# game/story01en.rpy:1391
translate schinese story01_3_d8db5d9f:

    # mc "Or are you suggesting we lie to our own teammate?"
    mc "还是说你想让我对自己的队友撒谎？"

# game/story01en.rpy:1392
translate schinese story01_3_ce52a6ab:

    # mc "Sorry, but I don't know how to li—"
    mc "抱歉，可我不会撒——"

# game/story01en.rpy:1394
translate schinese story01_3_d0d0755a:

    # r "Dumpin' everythin' on her all at once is a bad idea. Theoretically and practically."
    r "一次性把所有事都倒给她是个坏主意。理论上是，实际上也是。"

# game/story01en.rpy:1395
translate schinese story01_3_90f74154:

    # r "And on top of that, she ain't even said yes yet."
    r "而且她都还没答应呢。"

# game/story01en.rpy:1397
translate schinese story01_3_e8e38ec1_1:

    # an "..."
    an "……"

# game/story01en.rpy:1398
translate schinese story01_3_c2783ef7:

    # mc "She might've agreed if you hadn't interrupted me!"
    mc "要不是你打断我，她说不定就答应了！"

# game/story01en.rpy:1399
translate schinese story01_3_4fb5fa43:

    # r "I'm startin' to think teamin' up with ya was a real bad idea."
    r "我开始觉得跟你组队是个天大的错误了。"

# game/story01en.rpy:1400
translate schinese story01_3_8badb718:

    # mc "Feeling's mutual."
    mc "我也是。"

# game/story01en.rpy:1402
translate schinese story01_3_4e6f0c51:

    # an "Th-then why are you..."
    an "那、那你为什么还……"

# game/story01en.rpy:1404
translate schinese story01_3_ac8cccf8:

    # bot "Because we're desperate!"
    bot "因为我们走投无路了！"

# game/story01en.rpy:1405
translate schinese story01_3_57659b41:

    # r "Don't get it twisted. I'm only stickin' with ya 'cause you'll be useful."
    r "别搞错了。我跟你组队只是因为你有用。"

# game/story01en.rpy:1406
translate schinese story01_3_5d45837a:

    # mc "Oh, believe me. Feeling's mutual."
    mc "哦，相信我。我也是这么想的。"

# game/story01en.rpy:1408
translate schinese story01_3_ac2e2df6:

    # mc "Bike thief."
    mc "自行车小偷。"

# game/story01en.rpy:1410
translate schinese story01_3_aca5165f:

    # r "Hypocrite."
    r "伪君子。"

# game/story01en.rpy:1413
translate schinese story01_3_d58b0495:

    # r "Alright, screw it. If she ain't interested, we'll find somebody else."
    r "行了吧，去他的。她要没兴趣，我们就再找别人。"

# game/story01en.rpy:1416
translate schinese story01_3_4d2518b9:

    # mc "(If only we had the time...)"
    mc "（要是时间够就好了……）"

# game/story01en.rpy:1417
translate schinese story01_3_4597d70d:

    # mc "(Forty-three seconds.)"
    mc "（四十三秒。）"

# game/story01en.rpy:1418
translate schinese story01_3_ae0d02a7:

    # an "S-sorry, b-but... I-I never said no."
    an "对、对不起，可、可是……我、我从来没说不。"

# game/story01en.rpy:1420
translate schinese story01_3_c868e390:

    # bot "..."
    bot "……"

# game/story01en.rpy:1421
translate schinese story01_3_54b4d235:

    # an "(M-mom said that h-honest, weak people are b-better than strong l-liars...)"
    an "（妈、妈妈说过，诚实的弱者比强大的说谎者更……）"

# game/story01en.rpy:1422
translate schinese story01_3_d22b26a6:

    # an "(A-and they...)"
    an "（而、而且他们……）"

# game/story01en.rpy:1423
translate schinese story01_3_1182a6de:

    # an "I-I'll join."
    an "我、我加入。"

# game/story01en.rpy:1425
translate schinese story01_3_5308c47a:

    # mc "Wait, seriously?"
    mc "等等，真的吗？"

# game/story01en.rpy:1426
translate schinese story01_3_144cbfca:

    # an "Mhm..."
    an "嗯……"

# game/story01en.rpy:1427
translate schinese story01_3_2876efd9:

    # mc "Why?"
    mc "为什么？"

# game/story01en.rpy:1428
translate schinese story01_3_0e597067:

    # r "Hey, she already said yes!"
    r "喂，她都已经答应了啊！"

# game/story01en.rpy:1430
translate schinese story01_3_716019b8:

    # mc "Right."
    mc "说得对。"

# game/story01en.rpy:1431
translate schinese story01_3_99e36a68:

    # mc "Then welcome to the team!"
    mc "那欢迎加入队伍！"

# game/story01en.rpy:1432
translate schinese story01_3_da6cdd57:

    # r "(Whispering) Ya sure didn't say that when I joined."
    r "（低声）我加入的时候你可没这么欢迎我。"

# game/story01en.rpy:1433
translate schinese story01_3_e4dd67f5:

    # mc "(Whispering) Not now."
    mc "（低声）现在别说了。"

# game/story01en.rpy:1437
translate schinese story01_3_64c29122:

    # r "Alright. Alice, right? Name's Rose. Nice meetin' ya."
    r "好了，艾丽西亚对吧？我叫罗丝。很高兴认识你。"

# game/story01en.rpy:1438
translate schinese story01_3_e1a4c7d9:

    # an "Y-yeah... i-it's reeeally nice to meet you."
    an "嗯、嗯……我、我也真的很高兴认识你。"

# game/story01en.rpy:1440
translate schinese story01_3_0e1e78ff:

    # mc "(That fox...)"
    mc "（那只狐狸……）"

# game/story01en.rpy:1441
translate schinese story01_3_e9ec3274:

    # mc "(She's gonna be a royal pain in my ass.)"
    mc "（她肯定会让我头疼死。）"

# game/story01en.rpy:1443
translate schinese story01_3_c9fa8bc7:

