translate schinese story01_6_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/story01en.rpy:3190
translate schinese story01_6_8d07ad4b:

    # mc "I don't entirely get it, but... sure."
    mc "我没完全听懂，不过……行吧。"

