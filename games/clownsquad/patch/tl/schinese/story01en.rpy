translate schinese story01_3_b9b755e5_1:

    # r "..."
    r "……"

# game/story01en.rpy:1584
translate schinese story01_3_e8e38ec1_3:

    # an "..."
    an "……"

# game/story01en.rpy:1588
translate schinese story01_3_604948e9:

    # an "I-I don't know wh-what just happened... b-but... ohhh... yay..."
    an "我、我不知道刚、刚才发生了什么……可、可是……哦……太好了……"

# game/story01en.rpy:1590
translate schinese story01_3_fcfdff06:

    # an "W-we won!"
    an "我、我们赢了！"

# game/story01en.rpy:1591
translate schinese story01_3_0196251d:

    # an "R-right...?"
    an "对、对吧……？"

