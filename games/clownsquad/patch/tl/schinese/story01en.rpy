translate schinese story01_6_7ecfccc2:

    # r "No, we were just..."
    r "没有，我们刚才只是……"

# game/story01en.rpy:3283
translate schinese story01_6_c28ae7a0:

    # mc "We made up. Your timing's perfect."
    mc "已经和好了。你来得正是时候。"

