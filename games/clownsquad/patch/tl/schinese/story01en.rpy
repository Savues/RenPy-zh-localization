translate schinese story01_4_d00fd510:

    # mc "Makes the plea more convincing."
    mc "这样请求更有诚意。"

# game/story01en.rpy:2281
translate schinese story01_4_da538fb0:

    # r "Ya even folded your hands."
    r "你还把双手合上了。"

# game/story01en.rpy:2282
translate schinese story01_4_f802f168:

    # mc "I'm not ruling out divine intervention."
    mc "我不排除神明介入的可能。"

