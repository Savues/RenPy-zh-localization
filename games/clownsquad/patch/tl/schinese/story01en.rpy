translate schinese story01_3_88736657:

    # Mi "Time's up."
    Mi "时间到。"

# game/story01en.rpy:1476
translate schinese story01_3_4398781d:

    # mc "(The only person to blame is me.)"
    mc "（该怪的人只有我自己。）"

# game/story01en.rpy:1478
translate schinese story01_3_745bb162:

    # mc "(But that damn smirk of hers.)"
    mc "（可她那副该死的得意劲……）"

# game/story01en.rpy:1480
translate schinese story01_3_57cfe41d:

    # mc "(It's pissing me off...)"
    mc "（气死我了……）"

# game/story01en.rpy:1481
translate schinese story01_3_b4bf96ca:

    # mc "(BITCH!)"
    mc "（臭娘们！）"

# game/story01en.rpy:1484
translate schinese story01_3_efd330bb:

    # Mi "(Not bad. He's holdin' it together.)"
    Mi "（不错。还绷得住。）"

# game/story01en.rpy:1485
translate schinese story01_3_d68f1dea:

    # Mi "(Still, that one definitely stung.)"
    Mi "（不过那一下肯定疼到了。）"

# game/story01en.rpy:1486
translate schinese story01_3_d3efcc3f:

    # Mi "(Let that be a lesson to ya, lad.)"
    Mi "（小子，当个教训吧。）"

# game/story01en.rpy:1488
translate schinese story01_3_90c8ac57:

    # r "(So... what, we ain't a team now?)"
    r "（所以……怎么，我们不算一队了？）"

# game/story01en.rpy:1489
translate schinese story01_3_9ed3e441:

    # r "(Statistically speakin', he's the closest match outta everybody here.)"
    r "（按概率算，他是这里最合适的人选。）"

# game/story01en.rpy:1491
translate schinese story01_3_e7d76093:

    # r "(And there was a seventy-two percent chance Alice agreed 'cause of him.)"
    r "（而且艾丽西亚有百分之七十二的概率是因为他才答应的。）"

# game/story01en.rpy:1492
translate schinese story01_3_b9b755e5:

    # r "..."
    r "……"

# game/story01en.rpy:1495
translate schinese story01_3_9993fb1a:

    # r "(Nope. Ain't gonna work.)"
    r "（不行。这条路走不通。）"

# game/story01en.rpy:1501
translate schinese story01_3_1ef264c2:

    # Mi "Third rule."
    Mi "第三条规矩。"

# game/story01en.rpy:1502
translate schinese story01_3_9e08c4f4:

    # Mi "Always be ready."
    Mi "随时保持警惕。"

# game/story01en.rpy:1503
translate schinese story01_3_2214b1d1:

    # Mi "Ya never know when a terror attack'll hit..."
    Mi "你永远不知道恐怖袭击什么时候会来……"

# game/story01en.rpy:1504
translate schinese story01_3_f8000880:

    # Mi "...or when danger'll come knockin'."
    Mi "……也不知道危险什么时候会找上门。"

# game/story01en.rpy:1506
translate schinese story01_3_4b7ac5a1:

    # mc "(My phone...)"
    mc "（我的手机……）"

# game/story01en.rpy:1508
translate schinese story01_3_8c235104:

    # mc "(I'm gonna get you back for this, you bi—)"
    mc "（这事我跟你没完，你个婊——）"

# game/story01en.rpy:1510
translate schinese story01_3_84899b68:

    # mc "(No! Get a grip...)"
    mc "（不！冷静点……）"

# game/story01en.rpy:1511
translate schinese story01_3_185704ea:

    # mc "(God, I'm so damn pissed off!)"
    mc "（天啊，我真是气炸了！）"

# game/story01en.rpy:1513
translate schinese story01_3_4eb40151:

    # mc "*Exhales*"
    mc "*呼出一口气*"

# game/story01en.rpy:1514
translate schinese story01_3_7235ba78:

    # mc "(Just breathe. Like Beatrice taught you...)"
    mc "（深呼吸。就像碧翠丝教你的那样……）"

# game/story01en.rpy:1515
translate schinese story01_3_38ee32a5:

    # an "(H-he's... r-reeeally upset. I-is it because of his phone?)"
    an "（他、他……好生气。是、是因为手机吗？）"

# game/story01en.rpy:1518
translate schinese story01_3_b48f08b2:

    # an "(I-it must've been his... b-but why—)"
    an "（一、一定是他的……可、可为什么——）"

# game/story01en.rpy:1519
translate schinese story01_3_8d8adc58:

    # an "(I-I need to cheer him up!)"
    an "（我、我要哄他开心！）"

# game/story01en.rpy:1520
translate schinese story01_3_e8e38ec1_2:

    # an "..."
    an "……"

# game/story01en.rpy:1523
translate schinese story01_3_86bf16d4:

    # an "(W-why I c-can't...)"
    an "（为、为什么我说不出口……）"

# game/story01en.rpy:1524
translate schinese story01_3_2ed83991:

    # mc "Something wrong?"
    mc "怎么了？"

# game/story01en.rpy:1527
translate schinese story01_3_f69fbf96:

    # an "(Y-yeah... y-you look so s-sad. I-I don't wanna see you l-like this...)"
    an "（嗯、嗯……你、你看起来好难过。我、我不想看到你这、这样……）"

# game/story01en.rpy:1528
translate schinese story01_3_80d21c69:

    # an "(I-I have to say something...)"
    an "（我、我得说点什么……）"

# game/story01en.rpy:1534
translate schinese story01_3_0daf9cfd:

    # an "(C-c'mon...)"
    an "（来、来吧……）"

# game/story01en.rpy:1536
translate schinese story01_3_911606e0:

    # an "P-please... d-don't be s-sad..."
    an "求、求你了……别、别难过……"

# game/story01en.rpy:1538
translate schinese story01_3_d006bc1d:

    # mc "(Well, would ya look at that. A girl who can barely get two words out without stuttering is trying to cheer me up?)"
    mc "（嚯，还真行啊。一个连两个字都说不利索的女孩居然在安慰我？）"

# game/story01en.rpy:1539
translate schinese story01_3_31a669ba:

    # mc "(I don't even know how I'm supposed to rea—)"
    mc "（我都不知道该怎么反、应——）"

# game/story01en.rpy:1541
translate schinese story01_3_21d1bfaa:

    # mc "(No. We agreed: don't be an asshole.)"
    mc "（不行。说好了：别当混蛋。）"

# game/story01en.rpy:1542
translate schinese story01_3_b6992b5f:

    # mc "(Making fun of her nerves...)"
    mc "（拿人家的紧张开玩笑……）"

# game/story01en.rpy:1545
translate schinese story01_3_4ae2985e:

    # Mi "Everyone who sent an invite through the Academy app, good work."
    Mi "通过学院APP发出邀请的人，干得漂亮。"

# game/story01en.rpy:1546
translate schinese story01_3_56e1c5be:

    # Mi "The rest of ya, that's your lo—"
    Mi "你们其他人就自求多福——"

# game/story01en.rpy:1552
translate schinese story01_3_2e947645:

    # Mi "Eh?"
    Mi "嗯？"

# game/story01en.rpy:1553
translate schinese story01_3_cfde0da1:

    # mc "(What... is happening?)"
    mc "（这是……怎么回事？）"

# game/story01en.rpy:1556
translate schinese story01_3_5463ec9e:

    # r "(Hurts like hell... Feels like my head's about to burst into a million tiny gears.)"
    r "（疼死我了……感觉脑袋要炸成上百万个小齿轮。）"

# game/story01en.rpy:1557
translate schinese story01_3_cb6d809b:

    # r "(But I pulled it off.)"
    r "（但我做到了。）"

# game/story01en.rpy:1559
translate schinese story01_3_83b081cc:

    # r "Ya owe me one, clown."
    r "你欠我一个人情，小丑。"

# game/story01en.rpy:1561
translate schinese story01_3_170f08b4:

    # mc "(What's she talking abou—)"
    mc "（她在说什——）"

# game/story01en.rpy:1565
translate schinese story01_3_deac2b75:

    # r "...Sending coordinates."
    r "……发送坐标。"

# game/story01en.rpy:1568
translate schinese story01_3_66fa455d:

    # mc "...how...did you..."
    mc "……你……怎么……"

# game/story01en.rpy:1571
translate schinese story01_3_4c5accdb:

    # r "A-N-D-R-O-I-D. Keep up, genius."
    r "安、卓。跟上节奏，天才。"

# game/story01en.rpy:1574
translate schinese story01_3_67b46967:

    # mc "(Android, huh?)"
    mc "（安卓，是吧？）"

# game/story01en.rpy:1575
translate schinese story01_3_081888c4:

    # mc "(Drinks are on me.)"
    mc "（我请客。）"

# game/story01en.rpy:1579
translate schinese story01_3_ab95aabe:

    # mc "I'm so happy I could piss myself."
    mc "我高兴得快尿出来了。"

# game/story01en.rpy:1580
translate schinese story01_3_f424e4bd:

    # r "(Did he mix up what he was thinkin' with what he meant to say?)"
    r "（他是把想的和说的搞混了吗？）"

