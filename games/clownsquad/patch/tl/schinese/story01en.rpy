    # an "O-on your phone... w-we need to send an i-invitation."
    an "用、用你的手机……我、我们得发一份邀、邀请。"

# game/story01en.rpy:1449
translate schinese story01_3_78ab3843:

    # an "Y-you do have the Academy app... r-right?"
    an "你、你手机上有学院APP……对、对吧？"

# game/story01en.rpy:1451
translate schinese story01_3_e591fb1c:

    # s "Thirteen seconds."
    s "十三秒。"

# game/story01en.rpy:1454
translate schinese story01_3_a666a63b:

    # mc "(What...)"
    mc "（什……）"

# game/story01en.rpy:1455
translate schinese story01_3_260a9c5e:

    # mc "(Where the hell is it...)"
    mc "（到底在哪儿……）"

# game/story01en.rpy:1458
translate schinese story01_3_07ab5dc8:

    # mc "(I know I put it somewhere...)"
    mc "（我记得我放在哪儿了……）"

# game/story01en.rpy:1459
translate schinese story01_3_6685e578:

    # s "Five seconds."
    s "五秒。"

# game/story01en.rpy:1465
translate schinese story01_3_6d0bf247:

    # mc "(Back then... She was going for my phone!)"
    mc "（刚才……她是冲我的手机去的！）"

# game/story01en.rpy:1468
translate schinese story01_3_dc86924f:

    # mc "Tch."
    mc "啧。"

# game/story01en.rpy:1469
translate schinese story01_3_c7d447ce:

    # mc "(Everything was going according to plan, and with one move she just...)"
    mc "（一切本来都按计划进行，她一步就把……）"

