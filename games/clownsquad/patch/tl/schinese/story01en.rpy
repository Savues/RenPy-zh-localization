translate schinese story01_4_a184dbac:

    # r "Reddit."
    r "Reddit。"

# game/story01en.rpy:2315
translate schinese story01_4_cc974aa1:

    # mc "Which subreddit?"
    mc "哪个版块？"

# game/story01en.rpy:2316
translate schinese story01_4_e553af7c:

    # r "Don't matter."
    r "不重要。"

# game/story01en.rpy:2317
translate schinese story01_4_3edb4829:

    # mc "Now it matters more than ever."
    mc "现在它比什么都重要。"

# game/story01en.rpy:2319
translate schinese story01_4_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/story01en.rpy:2320
translate schinese story01_4_aa9992a6:

    # an "I-I'm soh-ry... I'm o-only... B-rank."
    an "对、对不起……我、我只有……B级。"

# game/story01en.rpy:2321
translate schinese story01_4_c868e390:

    # bot "..."
    bot "……"

# game/story01en.rpy:2324
translate schinese story01_4_8a993d2d:

    # bot "(Jackpot!)"
    bot "（中大奖了！）"

# game/story01en.rpy:2336
translate schinese story01_4_a20998e0:

    # bot "(Easy win!)"
    bot "（白捡的！）"

# game/story01en.rpy:2337
translate schinese story01_4_cf48161b:

    # an "B-but sometimes... wh-when things get r-reeeally intense..."
    an "可、可是有时候……当事情变得非、非常紧张的时候……"

# game/story01en.rpy:2338
translate schinese story01_4_22ee470e:

    # an "I-I reach A-rank."
    an "我、我能达到A级。"

# game/story01en.rpy:2339
translate schinese story01_4_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/story01en.rpy:2340
translate schinese story01_4_b9b755e5_3:

    # r "..."
    r "……"

# game/story01en.rpy:2344
translate schinese story01_4_fba199f8:

    # bot "WHAT?!"
    bot "什么？！"

# game/story01en.rpy:2345
translate schinese story01_4_b977edc4:

    # an "I-I'm soh-ry..."
    an "我、我对不起……"

# game/story01en.rpy:2349
translate schinese story01_4_c60b37ea:

    # mc "*Laughs*"
    mc "*笑*"

# game/story01en.rpy:2350
translate schinese story01_4_b3b3843b:

    # r "No, no... don't apologize."
    r "不不……别道歉。"

