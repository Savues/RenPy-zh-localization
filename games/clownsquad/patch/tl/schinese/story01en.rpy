translate schinese story01_4_85b48c2c:

    # r "If you're tellin' the truth, and ya are..."
    r "如果你说的是真的，而你就是……"

# game/story01en.rpy:2233
translate schinese story01_4_e8da6a9e:

    # r "Gettin' in here without any real ability... that's actually kinda scary."
    r "毫无真本事就能进来……这其实挺吓人的。"

# game/story01en.rpy:2235
translate schinese story01_4_f693264f:

    # an "Y-yeah!"
    an "对、对！"

# game/story01en.rpy:2238
translate schinese story01_4_199f6e00:

    # r "*Lets out a heavy sigh*"
    r "*重重叹了口气*"

# game/story01en.rpy:2239
translate schinese story01_4_cd29a9ce:

    # r "Still..."
    r "不过……"

# game/story01en.rpy:2241
translate schinese story01_4_0769d92d:

    # r "(An F-rank illusionist. Looks like a clown. Can't lie, of all things...)"
    r "（F级幻术师。看着像个小丑。偏偏还不能说谎……）"

# game/story01en.rpy:2242
translate schinese story01_4_85fa4d55:

    # r "(Lie?)"
    r "（说谎？）"

# game/story01en.rpy:2243
translate schinese story01_4_620e4cd8:

    # r "(Wait. Why am I so sure he ain't lyin'?)"
    r "（等等。我为什么这么确定他没在说谎？）"

# game/story01en.rpy:2245
translate schinese story01_4_59572f9c:

    # mc "Beep-beep."
    mc "哔哔。"

# game/story01en.rpy:2246
translate schinese story01_4_b9b755e5_2:

    # r "..."
    r "……"

# game/story01en.rpy:2247
translate schinese story01_4_a96d47ef:

    # r "(No idea. Still, probably shouldn't take my eyes off him...)"
    r "（不知道。不过，还是别把视线从他身上移开比较好……）"

# game/story01en.rpy:2250
translate schinese story01_4_f9daf343:

    # mc "Alright! Enough about me."
    mc "好了！关于我的说够了。"

# game/story01en.rpy:2251
translate schinese story01_4_27f6337a:

    # mc "What ranks are you two?"
    mc "你们两个什么等级？"

# game/story01en.rpy:2253
translate schinese story01_4_778e827b:

    # r "Guess I'll go first."
    r "那我先说吧。"

# game/story01en.rpy:2255
translate schinese story01_4_84da69e2:

    # r "C-rank under normal conditions."
    r "平时是C级。"

# game/story01en.rpy:2256
translate schinese story01_4_03c2190a:

    # r "B-rank at full power."
    r "全力状态是B级。"

# game/story01en.rpy:2262
translate schinese story01_4_300b979d:

    # mc "B-rank?"
    mc "B级？"

# game/story01en.rpy:2264
translate schinese story01_4_39157ccc:

    # r "Yep."
    r "对。"

# game/story01en.rpy:2266
translate schinese story01_4_52d08774:

    # mc "Stable?"
    mc "稳定吗？"

# game/story01en.rpy:2268
translate schinese story01_4_39157ccc_1:

    # r "Yep."
    r "对。"

# game/story01en.rpy:2270
translate schinese story01_4_5fd6cf0f:

    # mc "And you're seriously taking the exam with us?"
    mc "而你居然真的要跟我们一起考试？"

