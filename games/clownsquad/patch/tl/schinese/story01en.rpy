translate schinese story01_6_b9b755e5_4:

    # r "..."
    r "……"

# game/story01en.rpy:3272
translate schinese story01_6_5fe782d2:

    # an "S-soh-ry—"
    an "对、对不起——"

# game/story01en.rpy:3275
