# game/story01en.rpy:3313
translate schinese story01_7_a318f3cb:

    # r "Ya feelin' alright?"
    r "你没事吧？"

# game/story01en.rpy:3317
translate schinese story01_7_4513d17b:

    # an "I-it was t-tasty, th-that's all..."
    an "好、好吃，仅此而已……"

# game/story01en.rpy:3318
translate schinese story01_7_20ccb9b2:

    # an "I-I usually don't eat q-quite this much, b-but after all the s-stress today..."
    an "我、我平常吃不了这、这么多，可、可是今天经历了那、那么多压、压力……"

# game/story01en.rpy:3319
translate schinese story01_7_7e7729b9:

    # an "I-I kinda got carried away."
    an "我、我有点没控制住。"

# game/story01en.rpy:3321
translate schinese story01_7_33c4c42d:

    # r "Got it."
    r "知道了。"

# game/story01en.rpy:3326
translate schinese story01_7_c9a44aca:

    # r "(Why...)"
    r "（为什么……）"

# game/story01en.rpy:3329
translate schinese story01_7_d86e0ee5:

    # r "(Four minutes and twelve seconds.)"
    r "（四分十二秒。）"

# game/story01en.rpy:3330
translate schinese story01_7_8f58ff4e:

    # r "(That's longer than necessary.)"
    r "（比需要的时间长多了。）"

# game/story01en.rpy:3332
translate schinese story01_7_7b29f3d2:

    # r "(Wait, why am I counting?)"
    r "（等等，我为什么要计时？）"

# game/story01en.rpy:3333
translate schinese story01_7_a80f2bad:

    # L "So, how're you holding up?"
    L "过得怎么样？"

# game/story01en.rpy:3335
translate schinese story01_7_964cc3f5:

    # mc "Currently thriving in the full bloom of an existential crisis."
    mc "正在存在主义危机的盛放期里茁壮成长。"

# game/story01en.rpy:3337
translate schinese story01_7_57539b33:

    # L "...you actually went through with it?"
    L "……你还真去做了？"

# game/story01en.rpy:3338
translate schinese story01_7_5ee7b41c:

    # L "What about the others?"
    L "其他人呢？"

# game/story01en.rpy:3340
translate schinese story01_7_2f565f76:

    # mc "More or less. I screwed up a little with the others."
    mc "差不多吧。我跟其他人之间出了点岔子。"

