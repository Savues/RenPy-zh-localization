translate schinese story01_6_b909c09e:

    # mc "(No. Not like that. Swallow your damn pride.)"
    mc "（不。不能那样。把你那该死的自尊咽下去。）"

# game/story01en.rpy:3157
translate schinese story01_6_0da2bcdd:

    # mc "Rose... I'm sorry."
    mc "罗丝……对不起。"

# game/story01en.rpy:3159
translate schinese story01_6_28d30b4c:

    # mc "Back there, I acted... {w=0.8}Let's just say I wasn't really thinking like part of a team."
    mc "刚才在里面，我做得……{w=0.8}只能说当时完全没把自己当成队伍的一员。"

# game/story01en.rpy:3160
translate schinese story01_6_e12ccd16:

    # mc "And maybe... I got a little carried away."
    mc "而且可能……有点上头了。"

# game/story01en.rpy:3161
translate schinese story01_6_b9b755e5_2:

    # r "..."
    r "……"

# game/story01en.rpy:3162
translate schinese story01_6_3ff75c48:

    # r "Gimme... two minutes. I gotta—"
    r "给我……两分钟。我得——"

# game/story01en.rpy:3165
translate schinese story01_6_b2ae21a3:

    # r "Just gimme two minutes."
    r "就给我两分钟。"

# game/story01en.rpy:3166
translate schinese story01_6_a49ed4f8:

    # mc "Okay."
    mc "好。"

# game/story01en.rpy:3167
translate schinese story01_6_e8e38ec1:

    # an "..."
    an "……"

# game/story01en.rpy:3169
translate schinese story01_6_59b3804c:

    # mc "(Whispering) You're staring pretty hard. Something bothering you?"
    mc "（低声）你盯得挺紧。有什么事吗？"

