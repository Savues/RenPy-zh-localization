translate schinese story01_4_d00532f5:

    # r "(Whispering) Ya gotta be kiddin' me..."
    r "（低声）你不是在逗我吧……"

# game/story01en.rpy:2352
translate schinese story01_4_436bcba2:

    # mc "(Bingo.)"
    mc "（答对了。）"

# game/story01en.rpy:2355
translate schinese story01_4_f5a8df13:

    # mc "Alright, we've got a star on the team."
    mc "好，队里多了颗星星。"

# game/story01en.rpy:2357
translate schinese story01_4_f028bf15:

    # an "I-I'm not a star..."
    an "我、我不是星星……"

# game/story01en.rpy:2358
translate schinese story01_4_787bc2a5:

    # an "I-it just... sorta happened."
    an "只、只是……碰巧而已。"

# game/story01en.rpy:2359
translate schinese story01_4_dbd78de6:

    # an "A-and it's not like I e-earned it or anything."
    an "而、而且又不是我挣来的。"

# game/story01en.rpy:2361
translate schinese story01_4_10f42a7a:

    # an "I-I just got lucky."
    an "我、我只是运气好。"

# game/story01en.rpy:2363
translate schinese story01_4_719bd1a7:

    # mc "Luck's a skill too, once in a blue moon. So go ahead and be proud of it!"
    mc "运气偶尔也是一种才能。所以尽管为此骄傲吧！"

# game/story01en.rpy:2364
translate schinese story01_4_c32b9b1a:

    # r "That how's ya comfort yourself?"
    r "你就是这么安慰自己的？"

# game/story01en.rpy:2365
translate schinese story01_4_dacbc6f4:

    # mc "You looking for a fight?"
    mc "你想打架？"

# game/story01en.rpy:2367
translate schinese story01_4_51843871:

    # n "...that's insane."
    n "……这太离谱了。"

# game/story01en.rpy:2368
translate schinese story01_4_af7b1aa5:

    # n "So the Dellaymen daughters enrolling here has something to do with the terrorist attacks?"
    n "所以德拉伊姆家的女儿来这里读书，跟恐怖袭击有关？"

# game/story01en.rpy:2369
translate schinese story01_4_d4564039:

    # npc2 "Yeah."
    npc2 "嗯。"

# game/story01en.rpy:2370
translate schinese story01_4_83a03e8a:

    # npc2 "All three family heads were seen at the consulate a few days ago."
    npc2 "三位家长几天前都在领事馆被人看到过。"

# game/story01en.rpy:2372
translate schinese story01_4_a8c3b717:

    # npc2 "Something's about to happen in this city..."
    npc2 "这座城里快要发生什么事了……"

# game/story01en.rpy:2373
translate schinese story01_4_297d1edf:

    # n "If all three of them came in person, they must be expecting something serious."
    n "要是三家家长都亲自到场，说明他们预感到有大事。"

# game/story01en.rpy:2374
translate schinese story01_4_da729d17:

    # n "I'll warn my parents. Tell them to leave town..."
    n "我得提醒我父母，让他们离开这座城……"

# game/story01en.rpy:2375
translate schinese story01_4_a7f26de2:

    # npc3 "Team Fifteen, proceed to Room Thirty-Three."
    npc3 "十五号队伍，请前往三十三号房间。"

# game/story01en.rpy:2376
translate schinese story01_4_90bf9812:

    # npc2 "Let's go. It's our turn."
    npc2 "走吧。轮到我们了。"

# game/story01en.rpy:2378
translate schinese story01_4_05221f7b:

    # mc "(Terrorist attacks?)"
    mc "（恐怖袭击？）"

# game/story01en.rpy:2379
translate schinese story01_4_f3882464:

    # mc "(Then again, I'm no hero. Why should I care?)"
    mc "（不过我又不是英雄。关我什么事？）"

# game/story01en.rpy:2380
translate schinese story01_4_0de32796:

    # mc "(But Lena... and Beatrice...)"
    mc "（可是莉娜……还有碧翠丝……）"

# game/story01en.rpy:2382
translate schinese story01_4_7e20239b:

    # mc "(No. Later. Gotta get accepted first.)"
    mc "（不。以后再说。先得被录取。）"

# game/story01en.rpy:2383
translate schinese story01_4_55e80d3e:

    # mc "(Otherwise, they'll kill me themselves...)"
    mc "（不然她们会亲手宰了我……）"

# game/story01en.rpy:2385
translate schinese story01_4_9b0ba654:

    # mc "...you're staring holes through me."
    mc "……你在盯着我看。"

# game/story01en.rpy:2386
translate schinese story01_4_11455b53:

    # mc "What?"
    mc "什么？"

# game/story01en.rpy:2388
translate schinese story01_4_260df095:

    # r "Lena said ya tend to drift off into your own little world sometimes."
    r "莉娜说你有时候会神游到自己的小世界里去。"

# game/story01en.rpy:2390
translate schinese story01_4_c2296e25:

    # r "And y'know... it's actually pretty damn funny to watch."
    r "而且你知道吗……看着还真他妈好笑。"

# game/story01en.rpy:2392
translate schinese story01_4_0a52ee55:

    # r "Right, Alice?"
    r "对吧，艾丽西亚？"

# game/story01en.rpy:2394
translate schinese story01_4_8a4b4f88:

    # an "Y-yeah..."
    an "嗯、嗯……"

# game/story01en.rpy:2395
translate schinese story01_4_09b11483:

    # mc "(Why do I feel like a chimp at the zoo?)"
    mc "（为什么我觉得自己像动物园里的猴子？）"

# game/story01en.rpy:2399
translate schinese story01_4_e4c15d7b:

    # mc "(Although a few minutes ago, I was an ant.)"
    mc "（虽然几分钟前我还是只蚂蚁。）"

# game/story01en.rpy:2400
translate schinese story01_4_f31680f1:

    # mc "(Evolution in action, I guess.)"
