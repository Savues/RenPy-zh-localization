translate schinese story01_6_a414b7cc:

    # an "Wh— N-NO!"
    an "什——不、没有！"

# game/story01en.rpy:3173
translate schinese story01_6_7a8dab7c:

    # an "I-it's j-just... y-your arms..."
    an "没、没什么……只、只是你的手臂……"

# game/story01en.rpy:3174
translate schinese story01_6_28e9d57f:

    # an "Th-they're sooo... y'know... b-big..."
    an "它、它们好、好大……你、你知道吧……"

# game/story01en.rpy:3177
translate schinese story01_6_691608b7:

    # an "A-and they look t-tasty—"
    an "而、而且看起来很、很美味——"

# game/story01en.rpy:3178
translate schinese story01_6_200e3000:

    # an "I-I mean, m-muscular! A-and..."
    an "我、我是说，很、很有肌肉！还、还有……"

# game/story01en.rpy:3181
translate schinese story01_6_e476a999:

    # an "I-I kinda wanted to t-touch 'em..."
    an "我、我有点想、想摸一下……"

# game/story01en.rpy:3183
