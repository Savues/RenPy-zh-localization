translate schinese story01_3_081caa91:

    # mc "(She...)"
    mc "（她……）"

# game/story01en.rpy:1473
translate schinese story01_3_37e5ad68:

    # mc "(Breathe. Just breathe... Don't blame her.)"
    mc "（呼吸。呼吸就好……别怪她。）"

