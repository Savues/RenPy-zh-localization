translate schinese story01_4_27013ee6:

    # r "Get up."
    r "起来。"

# game/story01en.rpy:2284
translate schinese story01_4_cb323b38:

    # mc "Is that a no?"
    mc "这算是拒绝了吗？"

# game/story01en.rpy:2285
translate schinese story01_4_404f52f0:

    # r "Is this some kinda jo—"
    r "这是什么玩笑——"

# game/story01en.rpy:2288
translate schinese story01_4_6cf1c2fb:

    # an "P-please... s-stop putting yourself down like that."
    an "求、求你了……别、别那样贬低自己。"

# game/story01en.rpy:2289
translate schinese story01_4_2f402845:

    # an "I-I mean it..."
    an "我、我是认真的……"

# game/story01en.rpy:2292
translate schinese story01_4_c5bb4a9a:

    # r "Queen, huh..."
    r "女王陛下，是吗……"

# game/story01en.rpy:2293
translate schinese story01_4_989c27de:

    # r "Just look at yourself. Waggin' your tail like a damn puppy."
    r "看看你自己。摇着尾巴，跟条狗似的。"

# game/story01en.rpy:2294
translate schinese story01_4_e61e47b4:

    # mc "At your service, Your Majesty!"
    mc "随时为您效劳，陛下！"

# game/story01en.rpy:2297
translate schinese story01_4_50bd2918:

    # mc "Still... sometimes the quiet ones surprise you the most."
    mc "不过……安静的人往往最让人意外。"

