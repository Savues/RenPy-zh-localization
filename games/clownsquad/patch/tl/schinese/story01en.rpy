translate schinese story01_3_653e3b5e:

    # Mi "(Could always void i—)"
    Mi "（大可以说作废——）"

# game/story01en.rpy:1597
translate schinese story01_3_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/story01en.rpy:1600
translate schinese story01_3_b6bb23ea:

    # Mi "(No. He learned his lesson.)"
    Mi "（不。他学到了教训。）"

# game/story01en.rpy:1601
translate schinese story01_3_528a541c:

    # Mi "(And what came after...)"
    Mi "（而之后发生的……）"

# game/story01en.rpy:1602
translate schinese story01_3_34b0e719:

    # Mi "(Good work.)"
    Mi "（干得漂亮。）"

# game/story01en.rpy:1604
translate schinese story01_3_1f8af72f:

    # n "But you never said anything about a phone! How were we supposed to—"
    n "可你从来没提过手机！我们怎么知道要——"

