translate schinese story01_6_3a46d2b4:

    # an "(I-it's my first time t-touching something this b-big...)"
    an "（这、这是我第一次摸这么、这么大的东西……）"

# game/story01en.rpy:3195
translate schinese story01_6_4847d2c6:

    # an "(I-I wonder what it'd feel like if I...)"
    an "（我、我在想如果我摸的是……会是什么感觉……）"

# game/story01en.rpy:3197
translate schinese story01_6_e6abb694:

    # mc "Alice?"
    mc "艾丽西亚？"

# game/story01en.rpy:3198
translate schinese story01_6_fde41031:

    # an "(I-it's sooo firm...)"
    an "（好、好结实……）"

# game/story01en.rpy:3199
translate schinese story01_6_ec76dc7e:

    # an "(A-and it feels—)"
    an "（而、而且手感——）"

# game/story01en.rpy:3201
translate schinese story01_6_e6abb694_1:

    # mc "Alice?"
    mc "艾丽西亚？"

# game/story01en.rpy:3202
translate schinese story01_6_926a7ca1:

    # mc "I don't exactly mind you feeling me up, but maybe save the rest for after the exam?"
    mc "我倒不介意你摸我，不过剩下的能不能等考试完再说？"

# game/story01en.rpy:3205
translate schinese story01_6_29b18289:

    # an "I-I just remembered..."
    an "我、我突然想起来……"

# game/story01en.rpy:3206
translate schinese story01_6_1ea21020:

    # an "I-I need to use the r-restroom!"
    an "我、我要去洗手间！"

# game/story01en.rpy:3207
translate schinese story01_6_d2438955:

    # mc "(The bathroom's the other way...)"
    mc "（洗手间在反方向……）"

# game/story01en.rpy:3209
translate schinese story01_6_7f965089:

    # r "Fast."
    r "快。"

# game/story01en.rpy:3212
translate schinese story01_6_74e4bc0f:

    # mc "So, what's your answer?"
    mc "所以，你的答复是？"

# game/story01en.rpy:3214
translate schinese story01_6_8dd66be9:

    # r "(I ain't even mad at him anymore, but...)"
    r "（我甚至已经不生他气了，可是……）"

# game/story01en.rpy:3217
translate schinese story01_6_b94b94a2:

    # r "Beep-beep."
    r "哔哔。"

# game/story01en.rpy:3219
translate schinese story01_6_f364963f:

    # r "Don't ya ever take my beer away from me again."
    r "再也别把我的啤酒从我手里拿走。"

# game/story01en.rpy:3220
translate schinese story01_6_cd210c65:

    # r "EV-ER!"
    r "永、永远！"

# game/story01en.rpy:3223
translate schinese story01_6_d87ad5cd:

    # r "Ya understand me?"
    r "明白吗？"

# game/story01en.rpy:3227
translate schinese story01_6_71bac9c0:

    # mc "Why are you so attached to beer?"
    mc "你为什么这么执着于啤酒？"

# game/story01en.rpy:3228
translate schinese story01_6_44b76024:

    # mc "Back there, it wasn't just stress."
    mc "刚才在里面，不只是压力。"

# game/story01en.rpy:3230
translate schinese story01_6_69bb328c:

    # mc "It was the opposite. Like the beer was keeping you grounded."
    mc "恰恰相反。就像那罐啤酒在让你保持清醒。"

# game/story01en.rpy:3233
translate schinese story01_6_c568fc65:

    # r "Hey, hey. You're wanderin' into dangerous territory there."
    r "喂喂。你这话说得有点危险了。"

# game/story01en.rpy:3234
translate schinese story01_6_c2e79b7c:

    # mc "(And you're one to talk? Ever heard of personal boundaries?)"
    mc "（你自己不也一样？听说过个人边界吗？）"

# game/story01en.rpy:3235
translate schinese story01_6_b9b755e5_3:

    # r "..."
    r "……"

# game/story01en.rpy:3237
translate schinese story01_6_1c33e48d:

    # "Awkward silence."
    "尴尬的沉默。"

# game/story01en.rpy:3238
translate schinese story01_6_c7965ec2:

    # r "(He ain't arguin'...)"
    r "（他不跟我吵……）"

# game/story01en.rpy:3240
translate schinese story01_6_f82c98a5:

    # r "(Why ain't he arguin'?)"
    r "（为什么不吵？）"

# game/story01en.rpy:3241
translate schinese story01_6_f8a649e1:

    # r "(Most people either push harder or back off.)"
    r "（大多数人要么追着不放，要么干脆退开。）"

# game/story01en.rpy:3242
translate schinese story01_6_82fb7576:

    # r "(He's just... waitin' for me to answer.)"
    r "（他只是……等我回答。）"

# game/story01en.rpy:3243
translate schinese story01_6_4520ce25:

    # r "(That's... inconvenient.)"
    r "（这……很麻烦。）"

# game/story01en.rpy:3245
translate schinese story01_6_43a34d47:

    # mc "(Whispering) Your breathing..."
    mc "（低声）你的呼吸……"

# game/story01en.rpy:3246
translate schinese story01_6_929eb942:

    # r "(Don't analyze me.)"
    r "（别分析我。）"

# game/story01en.rpy:3247
translate schinese story01_6_dc43a90a:

    # r "(No. Wait.)"
    r "（不。等等。）"

# game/story01en.rpy:3248
translate schinese story01_6_ea27912f:

    # r "(He noticed?)"
    r "（他注意到了？）"

# game/story01en.rpy:3251
translate schinese story01_6_3d87adc3:

    # r "*Breathing heavily*"
    r "*呼吸急促*"

# game/story01en.rpy:3252
translate schinese story01_6_af5336ba:

    # r "(Damn it.)"
    r "（该死。）"

# game/story01en.rpy:3253
translate schinese story01_6_71c454a4:

    # r "(Why's that makin' it harder to think?)"
    r "（为什么这样反而更难思考了？）"

# game/story01en.rpy:3254
translate schinese story01_6_7b5f53e2:

    # mc "(Whispering) Rose..."
    mc "（低声）罗丝……"

# game/story01en.rpy:3255
translate schinese story01_6_ba325b81:

    # mc "(Whispering) Breathe slower."
    mc "（低声）呼吸慢一点。"

