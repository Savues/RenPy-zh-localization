translate schinese story01_6_3168cc85:

    # r "(Don't tell me what to do.)"
    r "（别命令我。）"

# game/story01en.rpy:3258
translate schinese story01_6_a457c9a0:

    # r "(No.)"
    r "（不。）"

# game/story01en.rpy:3260
translate schinese story01_6_255f758b:

    # r "(Wait.)"
    r "（等等。）"

# game/story01en.rpy:3261
translate schinese story01_6_784f3e23:

    # r "(He's not pushing.)"
    r "（他没有逼近。）"

# game/story01en.rpy:3262
translate schinese story01_6_6d1aeeca:

    # r "(He's not leaving either.)"
    r "（也没有离开。）"

# game/story01en.rpy:3264
translate schinese story01_6_027d6ebf:

    # r "(Just... standing there.)"
    r "（就……站在那儿。）"

# game/story01en.rpy:3265
translate schinese story01_6_c97ce642:

    # r "(That's worse.)"
    r "（这样更糟。）"

# game/story01en.rpy:3266
translate schinese story01_6_996aafe5:

    # mc "Rose?"
    mc "罗丝？"

# game/story01en.rpy:3269
translate schinese story01_6_5205d185:

    # r "(Don't rush me.)"
    r "（别催我。）"

# game/story01en.rpy:3270
translate schinese story01_6_99a68870:

    # r "(I'm trying to figure that out myself.)"
    r "（我自己在琢磨这事。）"

