translate schinese story01_7_f60bd6a2:

    # mc "Speaking of which, wanna join us?"
    mc "话说回来，要一起来吗？"

# game/story01en.rpy:3344
translate schinese story01_7_7f6d61b8:

    # L "You asked? Well, look at you. Guess something really has changed."
    L "你还主动问？看不出来啊。看来真变了不少。"

# game/story01en.rpy:3346
translate schinese story01_7_fd473e11:

    # mc "Don't start, Lena."
    mc "别这样，莉娜。"

# game/story01en.rpy:3347
translate schinese story01_7_83fc0078:

    # mc "We're in one of the cafeterias. Not sure which one, though."
    mc "我们在其中一间食堂。不过不确定是哪一间。"

# game/story01en.rpy:3348
translate schinese story01_7_3d649031:

    # mc "There's a giant statue of the Greatest right in the middle of the room."
    mc "正中间立着一尊至高者的巨大雕像。"

# game/story01en.rpy:3349
translate schinese story01_7_beb1b737:

    # L "...the main building. Got it."
    L "……主楼。知道了。"

# game/story01en.rpy:3350
translate schinese story01_7_ad5e2ea1:

    # L "I'll be right there."
    L "我马上到。"

# game/story01en.rpy:3354
translate schinese story01_7_2b35b6fe:

    # mc "..."
    mc "……"

# game/story01en.rpy:3355
translate schinese story01_7_599b0481:

    # mc "(And Beatrice still hasn't answered... Eh. Whatever.)"
    mc "（碧翠丝还没回消息……算了，无所谓。）"

# game/story01en.rpy:3357
translate schinese story01_7_0f0a0bf8:

    # r "You two done burnin' daylight?"
    r "你们俩聊够了没？"

# game/story01en.rpy:3359
translate schinese story01_7_2447c87a:

    # mc "Excuse me?"
    mc "你说什么？"

# game/story01en.rpy:3361
translate schinese story01_7_bedacfc5:

    # r "Nothin'. Forget it."
    r "没什么。忘了。"

# game/story01en.rpy:3363
translate schinese story01_7_17bc783d:

    # mc "Alright. What's next on the schedule?"
    mc "好。接下来日程是什么？"

# game/story01en.rpy:3365
translate schinese story01_7_b3e696bc:

    # r "Written exam."
    r "笔试。"

# game/story01en.rpy:3366
translate schinese story01_7_7a8efe76:

    # r "Still got a couple hours before it starts."
    r "离开始还有几个小时。"

# game/story01en.rpy:3368
translate schinese story01_7_7660b727:

    # mc "No way."
    mc "不会吧。"

# game/story01en.rpy:3369
translate schinese story01_7_3558c077:

    # mc "Don't tell me we actually got a little free time."
    mc "难道我们真有点空闲时间？"

# game/story01en.rpy:3371
translate schinese story01_7_9fc2e0c2:

    # r "More like the calm before the storm."
    r "更像是暴风雨前的平静。"

