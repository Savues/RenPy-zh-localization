    # Mi "Last page."
    Mi "最后一页。"

# game/story01en.rpy:1617
translate schinese story01_3_de31e144:

    # Mi "Anyone who doesn't read the handbook loses five points."
    Mi "不读手册的人，扣五分。"

# game/story01en.rpy:1618
translate schinese story01_3_1a873788:

    # Mi "The answer to your question was in there."
    Mi "你问题的答案就在里面。"

# game/story01en.rpy:1619
translate schinese story01_3_77f545a5:

    # Mi "Now put two and two together."
    Mi "现在把前因后果串起来。"

# game/story01en.rpy:1621
translate schinese story01_3_bb2cf764:

    # n "..."
    n "……"

# game/story01en.rpy:1622
translate schinese story01_3_c7c2732c:

    # mc "(Full-scale mockery. Gotta give her credit, though, one move and she shut down every complaint in the room.)"
    mc "（纯属公开羞辱。不过得承认她厉害，一招就把全场所有抱怨都堵死了。）"

# game/story01en.rpy:1624
translate schinese story01_3_21e2cbe7:

    # Mi "Right then."
    Mi "好。"

# game/story01en.rpy:1625
