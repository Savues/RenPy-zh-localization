# game/story01en.rpy:2640
translate schinese story01_5_487cc1c6:

    # mc "Your chairs, miladies."
    mc "各位女士，请入座。"

# game/story01en.rpy:2642
translate schinese story01_5_b9b755e5:

    # r "..."
    r "……"

# game/story01en.rpy:2644
translate schinese story01_5_e8e38ec1:

    # an "..."
    an "……"

# game/story01en.rpy:2647
translate schinese story01_5_2cfd11eb:

    # r "(Let's see what ya cooked up this time.)"
    r "（看你这次又整了什么花样。）"

# game/story01en.rpy:2650
translate schinese story01_5_9ab8f264:

    # mc "After you, miladies."
    mc "女士们先请。"

# game/story01en.rpy:2651
translate schinese story01_5_7810853d:

    # r "(Whispering) Y'know, I could get used to bein' treated like this real quick."
    r "（低声）你知道吗，我很快就能习惯被这样对待。"

# game/story01en.rpy:2652
translate schinese story01_5_92ec0aa1:

    # mc "(Whispering) Oh, I'm sure you could."
    mc "（低声）我毫不怀疑。"

# game/story01en.rpy:2655
translate schinese story01_5_6b1e314e:

    # an "Th-thank ya..."
    an "谢、谢谢你……"

# game/story01en.rpy:2656
translate schinese story01_5_2111937c:

    # mc "(Whispering) I'll explain everything later."
    mc "（低声）我回头把一切解释清楚。"

# game/story01en.rpy:2658
translate schinese story01_5_f3cf6b11:

    # dm "Very well. Then we begin—"
    dm "很好。那么开始——"

# game/story01en.rpy:2660
translate schinese story01_5_70b28f76:

    # mc "Hold on."
    mc "稍等。"

# game/story01en.rpy:2662
translate schinese story01_5_aeaeb901:

    # dm "Da?"
    dm "嗯？"

# game/story01en.rpy:2664
translate schinese story01_5_268af925:

    # mc "Before we begin..."
    mc "开始之前……"

# game/story01en.rpy:2665
translate schinese story01_5_6a478a4d:

    # mc "Two things: the rules of the interview and its actual purpose."
    mc "有两件事：面试的规则，以及它真正的目的。"

# game/story01en.rpy:2667
translate schinese story01_5_b35b4242:

    # dm "In handbo—"
    dm "手册里——"

# game/story01en.rpy:2669
translate schinese story01_5_6dbbbe91:

    # r "Ain't nothin' in the handbook about an interview."
    r "手册里根本没写面试的事。"

# game/story01en.rpy:2671
translate schinese story01_5_8915e675:

    # mc "My lady does not appreciate mysteries, Mister..."
    mc "女士不喜欢不明不白的事，先生……"

# game/story01en.rpy:2672
translate schinese story01_5_24fe5a15:

    # mc "Or would you prefer a repeat of yesterday?"
    mc "还是你更想重温一遍昨天？"

# game/story01en.rpy:2675
translate schinese story01_5_7accaf30:

    # dm "Tch."
    dm "啧。"

# game/story01en.rpy:2677
translate schinese story01_5_6275989d:

    # dm "Now begins interrogation protocol number seven."
    dm "现在开始第七号审讯程序。"

# game/story01en.rpy:2678
translate schinese story01_5_814be258:

    # dm "You answer. I record."
    dm "你回答。我记录。"

# game/story01en.rpy:2679
translate schinese story01_5_2bfb6a62:

    # dm "You do not lie."
    dm "不许说谎。"

# game/story01en.rpy:2680
translate schinese story01_5_ac988892:

    # dm "If you lie, I record that also."
    dm "说谎的话，我也一并记录。"

# game/story01en.rpy:2681
translate schinese story01_5_d6f20312:

    # mc "(Dodged the purpose. So he doesn't want us thinking about what he's really testing.)"
    mc "（避开了目的。所以他不想让我们琢磨他到底在考什么。）"

# game/story01en.rpy:2683
translate schinese story01_5_c492ccf9:

    # dm "One rule only: one representative answers."
    dm "只有一条规则：一名代表作答。"

# game/story01en.rpy:2685
translate schinese story01_5_dd13ebe9:

    # mc "We request one minute to discuss."
    mc "我们请求商议一分钟。"

# game/story01en.rpy:2687
translate schinese story01_5_e28dcb1d:

    # mc "Alright. Who's the leader?"
    mc "好。谁是队长？"

# game/story01en.rpy:2695
translate schinese story01_5_2b35b6fe:

    # mc "..."
    mc "……"

# game/story01en.rpy:2697
translate schinese story01_5_31eae0ca:

    # mc "Her, I get. But why you?"
    mc "她，我懂。但为什么是你？"

# game/story01en.rpy:2699
translate schinese story01_5_54822763:

    # an "(Whispering) I-I... c-couldn't do it."
    an "（低声）我、我……做不了。"

# game/story01en.rpy:2700
translate schinese story01_5_c3e242d5:

    # an "(Whispering) A-and... y-you seem kinda good at this..."
    an "（低声）而、而且……你、你好像挺擅长这个的……"

# game/story01en.rpy:2702
translate schinese story01_5_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/story01en.rpy:2704
translate schinese story01_5_a8053cb0:

    # r "(Whispering) Can't stand the guy."
    r "（低声）我受不了这家伙。"

# game/story01en.rpy:2705
translate schinese story01_5_aac78b10:

    # r "(Whispering) And I ain't got a clue what the plan is."
    r "（低声）而且我完全不知道计划是什么。"

# game/story01en.rpy:2707
translate schinese story01_5_f9033187:

    # mc "(Expected. Still worth checking.)"
    mc "（意料之中。不过还是值得确认一下。）"

# game/story01en.rpy:2710
translate schinese story01_5_8aad7f36:

    # mc "I'll answer on behalf of both miladies."
    mc "我来代替两位女士回答。"

# game/story01en.rpy:2711
translate schinese story01_5_d176a331:

    # mc "What's the question?"
    mc "问题是什么？"

# game/story01en.rpy:2715
translate schinese story01_5_ad46cdf6:

    # dm "What is your connection to Lena?"
    dm "你和莉娜是什么关系？"

# game/story01en.rpy:2717
translate schinese story01_5_f9eecded:

    # mc "And what exactly does that have to do with the exam?"
    mc "这跟考试有什么关系？"

# game/story01en.rpy:2719
translate schinese story01_5_888aa501:

    # dm "Examiner is me. I ask whatever I want, yo."
    dm "主考官是我。我想问什么就问什么。"

# game/story01en.rpy:2721
translate schinese story01_5_5c42ed5e:

    # mc "(Now I get why Lena hates him. He's a complete asshole.)"
    mc "（现在我明白莉娜为什么恨他了。这人就是个彻底的混蛋。）"

# game/story01en.rpy:2723
translate schinese story01_5_3eb72685:

    # mc "Ahem... Article 17.2 of the Hero Code states:"
    mc "咳……《英雄法典》第十七条之二规定："

# game/story01en.rpy:2724
translate schinese story01_5_4bb4beb3:

    # mc "In the event that a curator or examiner exceeds their authority..."
    mc "若策展人或考官越权……"

# game/story01en.rpy:2726
translate schinese story01_5_d9e6613f:

    # mc "a hero has the right to file a complaint and request a replacement through the commission."
    mc "英雄有权提出申诉，并请求委员会更换考官。"

# game/story01en.rpy:2728
translate schinese story01_5_4c496cd3:

    # mc "So I'll ask again: got a normal question for us, teddy bear?"
    mc "所以我再问一次：小熊，有正常的问题给我们吗？"

# game/story01en.rpy:2733
translate schinese story01_5_84fca3e7:

    # dm "Hero possesses knowledge of Code."
    dm "英雄知晓法典内容。"

# game/story01en.rpy:2734
translate schinese story01_5_3bf53b9c:

    # dm "Deliberately evades answer."
    dm "故意回避回答。"

# game/story01en.rpy:2735
translate schinese story01_5_d9f104c2:

    # dm "Extremely suspicious."
    dm "极其可疑。"

# game/story01en.rpy:2742
translate schinese story01_5_1ec6cac0:

    # dm "You have choice."
    dm "你有选择。"

# game/story01en.rpy:2743
translate schinese story01_5_89388f96:

    # dm "Save ten people by sacrificing one."
    dm "牺牲一人，救下十人。"

# game/story01en.rpy:2745
translate schinese story01_5_fc42762e:

    # dm "Or save one by sacrificing rest."
    dm "或牺牲其余，只救一人。"

# game/story01en.rpy:2746
translate schinese story01_5_bcbf211b:

    # r "(I ain't imaginin' things, right...?)"
    r "（我没在瞎想吧……？）"

# game/story01en.rpy:2749
translate schinese story01_5_4ad9be54:

    # r "(There ain't no network in here...)"
    r "（这屋里不可能有网络……）"

# game/story01en.rpy:2750
translate schinese story01_5_337a2f20:

    # mc "What do you two think?"
    mc "你们俩怎么看？"

# game/story01en.rpy:2752
translate schinese story01_5_c119ab8b:

    # mc "(Whispering) Rose?"
    mc "（低声）罗丝？"

# game/story01en.rpy:2753
translate schinese story01_5_f5e35011:

    # mc "(Whispering) What're you doing?"
    mc "（低声）你在干嘛？"

# game/story01en.rpy:2756
translate schinese story01_5_b2127865:

    # r "There ain't any signal in here..."
    r "这屋里一点信号都没有……"

# game/story01en.rpy:2757
translate schinese story01_5_87a26846:

    # r "And as for the question, there's gotta be a catch."
    r "至于这个问题，肯定有坑。"

# game/story01en.rpy:2760
translate schinese story01_5_f6820e9f:

    # r "Statistically speakin', the right call is savin' the ten."
    r "按概率算，救那十人才是正解。"

# game/story01en.rpy:2761
translate schinese story01_5_ebba72c9:

    # r "But I seriously doubt that's the answer they're lookin' for."
    r "但我严重怀疑这不是他们想听的答案。"

# game/story01en.rpy:2766
translate schinese story01_5_46fcf9aa:

    # mc "Alice, what do you think?"
    mc "艾丽西亚，你怎么看？"

# game/story01en.rpy:2768
translate schinese story01_5_cca75a53:

    # an "I-it depends on the p-people..."
    an "得、得看是什么人……"

# game/story01en.rpy:2769
translate schinese story01_5_11871fd6:

    # an "I-if they're c-criminals..."
    an "如、如果他们是罪犯……"

# game/story01en.rpy:2771
translate schinese story01_5_912657d9:

    # r "Then sacrificin' them could save an innocent person."
    r "那牺牲他们就能救一个无辜的人。"

# game/story01en.rpy:2772
translate schinese story01_5_144cbfca_1:

    # an "Mhm..."
    an "嗯……"

# game/story01en.rpy:2774
translate schinese story01_5_f619c4a3:

    # mc "Criminals or not, choosing between lives is... messy."
    mc "不管是不是罪犯，在性命之间做选择……都很麻烦。"

# game/story01en.rpy:2776
translate schinese story01_5_1d64c91d:

    # an "I-it's not pleasant..."
    an "这、这不好受……"

# game/story01en.rpy:2777
translate schinese story01_5_3bb29ca9:

    # an "B-but ya still gotta ch-choose."
    an "可、可是你还是得选。"

# game/story01en.rpy:2778
translate schinese story01_5_75cacf36:

    # mc "(That's a little unsettling coming from her.)"
    mc "（这话从她嘴里说出来有点让人不安。）"

# game/story01en.rpy:2781
translate schinese story01_5_336428c7:

    # mc "(They're right. That's what heroes would actually do.)"
    mc "（她们说得对。这才是英雄真正会做的事。）"

# game/story01en.rpy:2782
translate schinese story01_5_0b05ca31:

    # mc "(Except...)"
    mc "（不过……）"

# game/story01en.rpy:2783
translate schinese story01_5_c073f276:

    # mc "(That's not how the Academy works. They'd choose the safest, most stable option for their ratings.)"
    mc "（学院不是这么运作的。为了评分，他们只会选最安全、最稳定的方案。）"

# game/story01en.rpy:2784
translate schinese story01_5_532dd903:

    # mc "(Not the lesser of two evils.)"
    mc "（而不是两害相权取其轻。）"

# game/story01en.rpy:2786
translate schinese story01_5_411b8dea:

    # mc "I say we stay out of it and watch."
    mc "我建议我们别插手，先看着。"

# game/story01en.rpy:2788
translate schinese story01_5_91018910:

    # mc "When you can't be sure of the outcome, sometimes it's better not to interfere."
    mc "当你无法确定结果时，有时候不干预更好。"

# game/story01en.rpy:2790
translate schinese story01_5_8efa48a0:

    # r "But why?"
    r "可为什么？"

# game/story01en.rpy:2793
translate schinese story01_5_e1d9f415:

    # mc "People don't care how many lives you saved."
    mc "人们不在乎你救了多少人。"

# game/story01en.rpy:2794
translate schinese story01_5_e9f23dc8:

    # mc "They'll blame you for the ones you didn't."
    mc "他们只会怪你没救的那些。"

# game/story01en.rpy:2796
translate schinese story01_5_6bf49adc:

    # mc "And to the Academy, ratings are everything."
    mc "而对学院来说，评分就是一切。"

# game/story01en.rpy:2797
translate schinese story01_5_a301c895:

    # an "M-mom mentioned s-something kinda like that..."
    an "妈、妈妈提过类似的事……"

# game/story01en.rpy:2798
translate schinese story01_5_1c52758b:

    # dm "..."
    dm "……"

# game/story01en.rpy:2801
translate schinese story01_5_893734a3:

    # dm "Team possesses knowledge of Academy's internal structure."
    dm "该队知晓学院内部结构。"

# game/story01en.rpy:2802
translate schinese story01_5_d222428c:

    # dm "Beast-girl mentioned mother."
    dm "兽耳女提到母亲。"

# game/story01en.rpy:2803
translate schinese story01_5_9b105534:

    # dm "Probable connection to Academy."
    dm "与学院存在关联。"

# game/story01en.rpy:2804
translate schinese story01_5_89782294_1:

    # dm "Extremely suspicious, ne."
    dm "极其可疑。"

# game/story01en.rpy:2806
translate schinese story01_5_535fda8a:

    # mc "Would ya mind keeping it down while you write?"
    mc "你边写能不能边小声点？"

# game/story01en.rpy:2808
translate schinese story01_5_b8c9df6d:

    # dm "Team displays hostility toward me."
    dm "该队对我表现出敌意。"

# game/story01en.rpy:2809
translate schinese story01_5_a30e445c:

    # r "(He's writin' down conclusions without a shred of evidence. How the hell's anybody supposed to work with a system like that?)"
    r "（他没凭一点证据就写结论。这种制度谁他妈能接受？）"

# game/story01en.rpy:2813
translate schinese story01_5_05079cf1:

    # r "Wh— HOW THE HELL DO YA—"
    r "你——你他妈怎么知道我是——"

# game/story01en.rpy:2814
translate schinese story01_5_6e651b41:

    # r "D'ya even know who I—"
    r "你、你知不知道我是——"

# game/story01en.rpy:2817
translate schinese story01_5_d3bfded7:

    # mc "(Whispering) You're overdoing it. You'll only make things worse."
    mc "（低声）你演过头了。只会让事情更糟。"

# game/story01en.rpy:2820
translate schinese story01_5_4651c044:

    # r "(Whispering) He's writin' complete bullshit!"
    r "（低声）他写的全是屁话！"

# game/story01en.rpy:2822
translate schinese story01_5_ad3fba11:

    # mc "(Whispering) Exactly. Which is why you shouldn't do anything stupid."
    mc "（低声）没错。所以你更别干蠢事。"

# game/story01en.rpy:2823
translate schinese story01_5_8d70a79d:

    # mc "(Whispering) He's weird, but he hasn't written down any direct contradictions."
    mc "（低声）他这人虽然古怪，但还没写下任何自相矛盾的东西。"

# game/story01en.rpy:2825
translate schinese story01_5_6b9a0db3:

    # mc "(Whispering) So please, don't lose your head."
    mc "（低声）所以拜托，别上头。"

# game/story01en.rpy:2826
translate schinese story01_5_e9a94eb0:

    # r "Tch."
    r "啧。"

# game/story01en.rpy:2828
translate schinese story01_5_8b921ef9:

    # mc "(Honestly, I'm not exactly fond of him either.)"
    mc "（说实话，我对他也没什么好感。）"

# game/story01en.rpy:2830
translate schinese story01_5_f5935c47:

    # mc "(But how the hell am I supposed to read a bear's face?)"
    mc "（可我他妈怎么看懂一张熊脸？）"

# game/story01en.rpy:2832
translate schinese story01_5_562b2ad9:

    # mc "(Is he angry? Scared? No clue.)"
    mc "（他是生气？害怕？完全看不出来。）"

# game/story01en.rpy:2834
translate schinese story01_5_bbb734cb:

    # mc "Did we answer the question?"
    mc "我们回答问题了吗？"

# game/story01en.rpy:2836
translate schinese story01_5_686e6489:

    # dm "Partially."
    dm "部分。"

# game/story01en.rpy:2839
translate schinese story01_5_e6b5ae60:

    # mc "(Partially?)"
    mc "（部分？）"

# game/story01en.rpy:2840
translate schinese story01_5_6b61a803:

    # mc "(Wait...)"
    mc "（等等……）"

# game/story01en.rpy:2841
translate schinese story01_5_5a0ff26e:

    # mc "(They were watching our reactions during the previous stage too.)"
    mc "（上一阶段他们也在观察我们的反应。）"

# game/story01en.rpy:2844
translate schinese story01_5_b0647d43:

    # mc "(Think... think. The last stage was meant to build the teams.)"
    mc "（想想……想想。上一阶段是为了组队。）"

# game/story01en.rpy:2845
translate schinese story01_5_7cee3052:

    # mc "(This one should be testing how well they work together.)"
    mc "（这一阶段应该是在考察我们配合得有多好。）"

# game/story01en.rpy:2847
translate schinese story01_5_e789fb3c:

    # mc "(But his questions are strange.)"
    mc "（可他的问题很奇怪。）"

# game/story01en.rpy:2848
translate schinese story01_5_bdc37b6f:

    # mc "(Almost like the questions themselves don't matter...)"
    mc "（几乎好像问题本身并不重要……）"

# game/story01en.rpy:2850
translate schinese story01_5_a6f36128:

    # mc "(Whispering) It's how we deal with them that matters."
    mc "（低声）重要的是我们怎么处理它们。"

# game/story01en.rpy:2853
translate schinese story01_5_3536315e:

    # mc "Hey, teddy bear."
    mc "喂，小熊。"

# game/story01en.rpy:2854
translate schinese story01_5_b2b41d26:

    # mc "There aren't any correct answers, are there?"
    mc "根本没有什么正确答案，对吧？"

# game/story01en.rpy:2856
translate schinese story01_5_1c52758b_1:

    # dm "..."
    dm "……"

# game/story01en.rpy:2858
translate schinese story01_5_92d1c7b2:

    # dm "No."
    dm "不。"

# game/story01en.rpy:2859
translate schinese story01_5_e5f50902:

    # dm "But there are undesirable answers."
    dm "但有不受欢迎的答案。"

# game/story01en.rpy:2862
translate schinese story01_5_860deb92:

    # mc "(Absurd. They don't care what's right.)"
    mc "（荒谬。他们根本不在乎什么是对错。）"

# game/story01en.rpy:2863
translate schinese story01_5_8727f90e:

    # mc "(They're looking for answers they can tolerate.)"
    mc "（他们要找的是自己能接受的答案。）"

# game/story01en.rpy:2864
translate schinese story01_5_ee5f0d98:

    # mc "(Then there's no point in dragging this out.)"
    mc "（那就没必要再拖下去了。）"

# game/story01en.rpy:2867
translate schinese story01_5_8cc822fc:

    # mc "Next question."
    mc "下一个问题。"

# game/story01en.rpy:2868
translate schinese story01_5_1c52758b_2:

    # dm "..."
    dm "……"

# game/story01en.rpy:2871
translate schinese story01_5_4f347f02:

    # dm "Team refuses to provide desirable answer."
    dm "该队拒绝给出受欢迎的答案。"

# game/story01en.rpy:2872
translate schinese story01_5_4169bb72:

    # dm "Then—"
    dm "那么——"

# game/story01en.rpy:2875
translate schinese story01_5_70b28f76_1:

    # mc "Hold on."
    mc "稍等。"

# game/story01en.rpy:2878
translate schinese story01_5_4c0c3888:

    # mc "(No. That doesn't make any sense.)"
    mc "（不。这说不通。）"

# game/story01en.rpy:2879
translate schinese story01_5_c585787d:

    # mc "(If the answers have already been judged... then it isn't a question.)"
    mc "（如果答案早就有定论……那这就不是问题。）"

# game/story01en.rpy:2882
translate schinese story01_5_82aa56f2:

    # mc "(It's a filter.)"
    mc "（而是筛子。）"

# game/story01en.rpy:2883
translate schinese story01_5_411c4986:

    # mc "(Why bother asking if the correct answer already exists?)"
    mc "（正确答案既然早就存在，何必还要问？）"

# game/story01en.rpy:2887
translate schinese story01_5_6649544a:

    # Mi "That's where they'll spend an hour fillin' your heads with justice, peace, and all that."
    Mi "他们会在那儿花一个小时，往你们脑子里灌正义、和平之类的屁话。"

# game/story01en.rpy:2890
translate schinese story01_5_fa61e178:

    # mc "(Brainwashing...?)"
    mc "（洗脑……？）"

# game/story01en.rpy:2891
translate schinese story01_5_a0c26a06:

    # mc "(No, no...)"
    mc "（不，不……）"

# game/story01en.rpy:2892
translate schinese story01_5_9ff7bda6:

    # mc "(The old man wouldn't do that.)"
    mc "（老头不会干这种事。）"

# game/story01en.rpy:2894
translate schinese story01_5_e2663a88:

    # mc "(You only brainwash pawns.)"
    mc "（只洗脑棋子。）"

# game/story01en.rpy:2895
translate schinese story01_5_d25d4916:

    # mc "(But heroes are... sacred to him.)"
    mc "（而英雄……在他心里是神圣的。）"

# game/story01en.rpy:2897
translate schinese story01_5_b8ae6010:

    # mc "(He loves ratings.)"
    mc "（他热爱评分。）"

# game/story01en.rpy:2899
translate schinese story01_5_40f370fe:

    # mc "(Ratings are entertainment.)"
    mc "（评分就是娱乐。）"

# game/story01en.rpy:2900
translate schinese story01_5_9e1ec962:

    # mc "(And entertainment needs a story.)"
    mc "（而娱乐需要故事。）"

# game/story01en.rpy:2902
translate schinese story01_5_7deab94f:

    # mc "(A hero. A victim. A villain.)"
    mc "（一个英雄。一个受害者。一个反派。）"

# game/story01en.rpy:2903
translate schinese story01_5_19cce305:

    # mc "(Someone to save. Someone to blame.)"
    mc "（一个该被救的人。一个该被怪罪的人。）"

# game/story01en.rpy:2905
translate schinese story01_5_04fc5cc9:

    # mc "(Clear roles.)"
    mc "（角色分明。）"

# game/story01en.rpy:2906
translate schinese story01_5_c08b841c:

    # mc "(That's what his question did.)"
    mc "（他的问题就是这个作用。）"

# game/story01en.rpy:2908
translate schinese story01_5_06fb5e72:

    # mc "(One life. Ten lives.)"
    mc "（一条命。十条命。）"

# game/story01en.rpy:2909
translate schinese story01_5_3e4c1a82:

    # mc "(A hero forced to judge between them.)"
    mc "（一个被迫在两者之间做判断的英雄。）"

# game/story01en.rpy:2911
translate schinese story01_5_5a6c26fd:

    # mc "(He wasn't testing what we'd save.)"
    mc "（他不是在考我们会救谁。）"

# game/story01en.rpy:2912
translate schinese story01_5_efac3dc1:

    # mc "(He was testing whether we'd accept the role of judge and executioner.)"
    mc "（而是在考我们会不会接受“判官兼刽子手”这个角色。）"

# game/story01en.rpy:2916
translate schinese story01_5_c0ff0d1a:

    # dm "Suspects are thinking for too long."
    dm "嫌疑人思考时间过长。"

# game/story01en.rpy:2917
translate schinese story01_5_89782294_2:

    # dm "Extremely suspicious, ne."
    dm "极其可疑。"

# game/story01en.rpy:2924
translate schinese story01_5_31ff21bd:

    # mc "(Fine.)"
    mc "（好吧。）"

# game/story01en.rpy:2925
translate schinese story01_5_44dd5892:

    # mc "(Let's see if he notices the same trap when it's pointed back at him.)"
    mc "（看看同一个陷阱指向他时，他会不会也中招。）"

# game/story01en.rpy:2928
translate schinese story01_5_392459ec:

    # mc "Teddy bear..."
    mc "小熊……"

# game/story01en.rpy:2929
translate schinese story01_5_07fc3bde:

    # mc "Wanna play a game?"
    mc "想玩个游戏吗？"

# game/story01en.rpy:2930
translate schinese story01_5_1c52758b_3:

    # dm "..."
    dm "……"

# game/story01en.rpy:2932
translate schinese story01_5_5a9b42a5:

    # mc "Picture this."
    mc "设想一下。"

# game/story01en.rpy:2933
translate schinese story01_5_fcdc207a:

    # mc "You have a revolver."
    mc "你手里有一把左轮。"

# game/story01en.rpy:2935
translate schinese story01_5_aa6e3757:

    # mc "In front of you are three people:"
    mc "你面前有三个人："

# game/story01en.rpy:2936
translate schinese story01_5_9b8148c9:

    # mc "a killer, a victim, and a witness."
    mc "一个凶手、一个受害者、一个目击者。"

# game/story01en.rpy:2937
translate schinese story01_5_1ad53506:

    # mc "Who do you shoot?"
    mc "你开枪打谁？"

# game/story01en.rpy:2941
translate schinese story01_5_5939f43d:

    # dm "Killer appears to be obvious answer."
    dm "凶手似乎是显而易见的答案。"

# game/story01en.rpy:2943
translate schinese story01_5_63fb2478:

    # mc "The point is, there is no right target."
    mc "重点是，没有正确的目标。"

# game/story01en.rpy:2945
translate schinese story01_5_1c52758b_4:

    # dm "..."
    dm "……"

# game/story01en.rpy:2948
translate schinese story01_5_f36e5aec:

    # mc "Exactly."
    mc "正是。"

# game/story01en.rpy:2949
translate schinese story01_5_93221c2b:

    # mc "That's why the trap works."
    mc "所以这个陷阱才有效。"

# game/story01en.rpy:2952
translate schinese story01_5_c5b3c5af:

    # mc "You heard 'killer' and accepted the rules."
    mc "你一听到“凶手”就接受了规则。"

# game/story01en.rpy:2953
translate schinese story01_5_d8e8d0e7:

    # mc "You didn't ask who called him that."
    mc "你没问是谁这么叫他的。"

# game/story01en.rpy:2955
translate schinese story01_5_8bf9ae78:

    # mc "You didn't ask what happened."
    mc "你没问发生了什么。"

# game/story01en.rpy:2956
translate schinese story01_5_55bd8983:

    # mc "You didn't ask why you're the one holding the gun."
    mc "你没问为什么握着枪的是你。"

# game/story01en.rpy:2958
translate schinese story01_5_7d544c47:

    # dm "And if I refuse to shoot?"
    dm "那如果我拒绝开枪呢？"

# game/story01en.rpy:2961
translate schinese story01_5_21f0cb43:

    # mc "Then you finally asked the right question."
    mc "那你终于问对问题了。"

# game/story01en.rpy:2963
translate schinese story01_5_c08b902f:

    # r "So the trap isn't the answer."
    r "所以陷阱不在于答案。"

# game/story01en.rpy:2964
translate schinese story01_5_488e3649:

    # r "It's accepting the question."
    r "而在于接受这个问题。"

# game/story01en.rpy:2965
translate schinese story01_5_0abb6920:

    # mc "That's the point."
    mc "这就是重点。"

# game/story01en.rpy:2967
translate schinese story01_5_6708f1bf:

    # mc "The question isn't who you're willing to kill."
    mc "问题不是你愿意杀谁。"

# game/story01en.rpy:2968
translate schinese story01_5_a21d8976:

    # mc "It's who made you believe killing was part of the answer."
    mc "而是谁让你相信杀人是答案的一部分。"

# game/story01en.rpy:2970
translate schinese story01_5_f7cfc19a:

    # an "I-I don't r-reeeally get it..."
    an "我、我真的不太明白……"

# game/story01en.rpy:2972
translate schinese story01_5_aa4725eb:

    # mc "It's simpler than it sounds, Alice."
    mc "艾丽西亚，没你想的那么复杂。"

# game/story01en.rpy:2973
translate schinese story01_5_620ec686:

    # mc "Don't look for the right target."
    mc "别去找“正确的目标”。"

# game/story01en.rpy:2975
translate schinese story01_5_2c5d9a23:

    # mc "First, ask who put the revolver in your hand."
    mc "先问，是谁把枪塞到你手里的。"

# game/story01en.rpy:2976
translate schinese story01_5_639e8f6a:

    # mc "And why they needed you to hold it."
    mc "以及为什么需要你握着它。"

# game/story01en.rpy:2980
translate schinese story01_5_77a6bf98:

    # mc "Rose. Alice."
    mc "罗丝。艾丽西亚。"

# game/story01en.rpy:2983
translate schinese story01_5_7966d2c7:

    # mc "We're done."
    mc "结束了。"

# game/story01en.rpy:2984
translate schinese story01_5_6bd256d0:

    # an "Wh—"
    an "什——"

# game/story01en.rpy:2987
translate schinese story01_5_067119e8:

    # r "C'mon, Alice."
    r "走吧，艾丽西亚。"

# game/story01en.rpy:2988
translate schinese story01_5_a4d162ef:

    # an "Y-yeah... g-goodbye, M-Mister Bear..."
    an "嗯、嗯……再、再见，熊、熊先生……"

# game/story01en.rpy:2990
translate schinese story01_5_1c52758b_5:

    # dm "..."
    dm "……"

# game/story01en.rpy:2993
translate schinese story01_5_5136e345:

    # dm "Is me. We need to talk."
    dm "是我。我们得谈谈。"

# game/story01en.rpy:3004
translate schinese story01_6_6465145d:

    # "A few minutes later."
    "几分钟后。"

# game/story01en.rpy:3011
translate schinese story01_6_ac18dc67:

    # r "Hold up!"
    r "等等！"

# game/story01en.rpy:3013
translate schinese story01_6_e6fdb9c5:

    # r "Alright, what the hell was that?"
    r "好，那到底是怎么回事？"

# game/story01en.rpy:3014
translate schinese story01_6_3fe7dd86:

    # r "Ya sure tore him a new one, but..."
    r "你确实把他撕了层皮，可是……"

# game/story01en.rpy:3017
translate schinese story01_6_8f674324:

    # mc "The questions were a sham."
    mc "那些问题都是幌子。"

# game/story01en.rpy:3018
translate schinese story01_6_91eb9032:

    # mc "I don't think the answers themselves affected our score."
    mc "我觉得答案本身并没有影响我们的分数。"

# game/story01en.rpy:3020
translate schinese story01_6_0e6f2643:

    # an "Th-then... wh-what was this whole stage e-even for?"
    an "那、那……这整个阶段到底是为了什么？"

# game/story01en.rpy:3022
translate schinese story01_6_65d263e8:

    # mc "No idea. But answering 'em would've only dug us a deeper hole."
    mc "不知道。但回答它们只会让我们陷得更深。"

# game/story01en.rpy:3023
translate schinese story01_6_0367b10b:

    # mc "Anyway, what nex—"
    mc "总之，接下来——"

# game/story01en.rpy:3025
translate schinese story01_6_16d65eac:

    # r "Wait, so ya just walked outta there?"
    r "等等，所以你就这样走出来了？"

# game/story01en.rpy:3026
translate schinese story01_6_67b8687d:

    # r "I thought ya had some kinda plan."
    r "我还以为你有什么计划。"

# game/story01en.rpy:3028
translate schinese story01_6_b53c277a:

    # mc "We passed the first stage, didn't we?"
    mc "我们不是通过第一阶段了吗？"

# game/story01en.rpy:3030
translate schinese story01_6_43e800a1:

    # r "Nope. Ya screwed that one up."
    r "没有。你把第一阶段搞砸了。"

# game/story01en.rpy:3031
translate schinese story01_6_ee95c103:

    # r "Remind me, who was it that bailed ya out?"
    r "提醒我一下，是谁替你兜的底？"

# game/story01en.rpy:3033
translate schinese story01_6_07ce0448:

    # mc "Okay, hold on. What's wrong?"
    mc "等等。怎么了？"

# game/story01en.rpy:3034
translate schinese story01_6_c6898d11:

    # mc "You're way too pissed off."
    mc "你火气也太大了。"

# game/story01en.rpy:3037
translate schinese story01_6_ee95c103_1:

    # r "Remind me, who was it that bailed ya out?"
    r "提醒我一下，是谁替你兜的底？"

# game/story01en.rpy:3038
translate schinese story01_6_c165cb2a:

    # r "Sure, looked damn impressive. But I thought ya had an actual reason for—"
    r "确实，看起来帅爆了。可我以为你这么做是有正当理由——"

# game/story01en.rpy:3044
translate schinese story01_6_ce095c7e:

    # r "Wh—"
    r "什——"

# game/story01en.rpy:3045
translate schinese story01_6_ecee2716:

    # mc "No alcohol."
    mc "不许喝酒。"

# game/story01en.rpy:3048
translate schinese story01_6_1ba7561a:

    # r "HEY! GIVE IT BACK!"
    r "喂！还给我！"

# game/story01en.rpy:3049
translate schinese story01_6_51690e69:

    # mc "We still got exams ahead of us, and I need you sober."
    mc "后面还有考试，我需要你保持清醒。"

# game/story01en.rpy:3052
translate schinese story01_6_459ba04d:

    # r "I don't give a damn about the exams! Give me my beer!"
    r "我才不管什么考试！把啤酒还我！"

# game/story01en.rpy:3053
translate schinese story01_6_87f25892:

    # mc "Hey, what happens if you fail?"
    mc "喂，你知道挂科会怎样吗？"

# game/story01en.rpy:3054
translate schinese story01_6_af530685:

    # r "(My head... damn it, not now.)"
    r "（我的头……该死，别是现在吧。）"

# game/story01en.rpy:3056
translate schinese story01_6_5749ff55:

    # r "I said give me my damn beer!"
    r "我说了把啤酒还我！"

# game/story01en.rpy:3057
translate schinese story01_6_1924667c:

    # mc "(What's gotten into her? It's like she's a different person...)"
    mc "（她这是怎么了？简直像换了个人……）"

# game/story01en.rpy:3063
translate schinese story01_6_d207900f:

    # "Unable to withstand the pressure, the can bursts."
    "压力之下，罐子炸裂。"

# game/story01en.rpy:3065
translate schinese story01_6_2b35b6fe:

    # mc "..."
    mc "……"

# game/story01en.rpy:3067
translate schinese story01_6_b9b755e5:

    # r "..."
    r "……"

# game/story01en.rpy:3068
translate schinese story01_6_4bbe5891:

    # mc "Sorry..."
    mc "对不起……"

# game/story01en.rpy:3070
translate schinese story01_6_b9b755e5_1:

    # r "..."
    r "……"

# game/story01en.rpy:3074
translate schinese story01_6_f735bfba:

    # "A punch."
    "一拳。"

# game/story01en.rpy:3078
translate schinese story01_6_a4ee0360:

    # "A few minutes later, in the restroom."
    "几分钟后，洗手间。"

# game/story01en.rpy:3083
translate schinese story01_6_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/story01en.rpy:3086
translate schinese story01_6_80ad200d:

    # mc "(Just now...)"
    mc "（刚才……）"

# game/story01en.rpy:3090
translate schinese story01_6_13db326c:

    # mc "(First, ask who put the revolver in your hand...)"
    mc "（先问，是谁把枪塞到你手里……）"

# game/story01en.rpy:3095
translate schinese story01_6_84d9e959:

    # mc "(I saw a problem and immediately reached for the easiest solution.)"
    mc "（我一眼看到问题，就立刻抓了最省事的办法。）"

# game/story01en.rpy:3096
translate schinese story01_6_b44ddb6a:

    # mc "(What the hell was I even thinking?)"
    mc "（我他妈当时到底在想什么？）"

# game/story01en.rpy:3098
translate schinese story01_6_5e80007d:

    # mc "(Walked straight into the very thing I was arguing against...)"
    mc "（一头撞进了自己刚刚还在反对的那件事里……）"

# game/story01en.rpy:3100
translate schinese story01_6_c149632e:

    # mc "(They trusted me, and I...)"
    mc "（他们信任我，而我……）"

# game/story01en.rpy:3101
translate schinese story01_6_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/story01en.rpy:3103
translate schinese story01_6_f24606c7:

    # mc "(Iza used to say abilities reflect the heart of the person who carries them.)"
    mc "（伊莎说过，能力反映的是承载它之人的心。）"

# game/story01en.rpy:3105
translate schinese story01_6_17619e86:

    # mc "(Looked at that way...)"
    mc "（从这个角度看……）"

# game/story01en.rpy:3106
translate schinese story01_6_e1c2c76c:

    # mc "(Mine really does suit me.)"
    mc "（我的能力还真挺适合我。）"

# game/story01en.rpy:3109
translate schinese story01_6_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/story01en.rpy:3110
translate schinese story01_6_9dea2b81:

    # mc "(Clown.)"
    mc "（小丑。）"

# game/story01en.rpy:3113
translate schinese story01_6_01bd7c23:

    # mc "They know it was you..."
    mc "他们知道是你干的……"

# game/story01en.rpy:3116
translate schinese story01_6_cb16f067:

    # mc "(I already let her down once. And not just her.)"
    mc "（我已经让她失望过一次。而且不只是她。）"

# game/story01en.rpy:3118
translate schinese story01_6_961a39cc:

    # mc "...just like I did now."
    mc "……就像我刚才那样。"

# game/story01en.rpy:3120
translate schinese story01_6_4b399e95:

    # mc "(I don't know what exactly set her off, but...)"
    mc "（我不知道到底是什么把她点着了，但是……）"

# game/story01en.rpy:3122
translate schinese story01_6_16411555:

    # mc "(No.)"
    mc "（不。）"

# game/story01en.rpy:3123
translate schinese story01_6_19f54e1a:

    # mc "(The problem isn't that I tried to stop her.)"
    mc "（问题不在于我试图阻止她。）"

# game/story01en.rpy:3124
translate schinese story01_6_df9f49c7:

    # mc "(It's that I never even asked what was wrong.)"
    mc "（而在于我根本没问她怎么了。）"

# game/story01en.rpy:3127
translate schinese story01_6_0ccdd604:

    # mc "(First, I gotta find her.)"
    mc "（首先，我得找到她。）"

# game/story01en.rpy:3128
translate schinese story01_6_9b7877df:

    # mc "(And at least try to listen.)"
    mc "（至少要听她说完。）"

# game/story01en.rpy:3137
translate schinese story01_6_1c41e17f:

    # r "(Why the hell did I hit him? Statistically speakin', that made no sense.)"
    r "（我他妈为什么要打他？按概率算这完全说不通。）"

# game/story01en.rpy:3138
translate schinese story01_6_f98a54d6:

    # r "(Not emotionally. Not practically. Not...)"
    r "（情感上说不通。实际层面说不通。也不……）"

# game/story01en.rpy:3139
translate schinese story01_6_fcdadc56:

    # r "(My actions don't follow any kinda logic.)"
    r "（我的行为完全不合逻辑。）"

# game/story01en.rpy:3142
translate schinese story01_6_05b0d222:

    # r "(Hell, I don't even understand emotions.)"
    r "（见鬼，我连情感都不懂。）"

# game/story01en.rpy:3143
translate schinese story01_6_378198d8:

    # r "(So why'd I do it?)"
    r "（那我为什么要这么做？）"

# game/story01en.rpy:3144
translate schinese story01_6_2d8b1bf4:

    # r "(He lent me his shirt. Got us through the exam...)"
    r "（他把衬衫借给了我。帮我们撑过了考试……）"

# game/story01en.rpy:3145
translate schinese story01_6_df4a2276:

    # r "(Maybe I oughta apologize?)"
    r "（也许我该道个歉？）"

# game/story01en.rpy:3147
translate schinese story01_6_cad95d13:

    # r "(No!)"
    r "（不！）"

# game/story01en.rpy:3150
translate schinese story01_6_be72ae6b:

    # mc "Rose? Hold up. Can we talk?"
    mc "罗丝？等一下。我们谈谈。"

# game/story01en.rpy:3153
translate schinese story01_6_e00dbac0:

    # r "What d'ya want?"
    r "你想干嘛？"

# game/story01en.rpy:3155
translate schinese story01_6_0def2681:

    # mc "Back there, why did you—"
    mc "刚才在里面，你为什么——"

