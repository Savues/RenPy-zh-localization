translate schinese story01_4_3a97f998:

    # mc "B-rank? Or A?"
    mc "B级？还是A级？"

# game/story01en.rpy:2300
translate schinese story01_4_e8e38ec1:

    # an "..."
    an "……"

# game/story01en.rpy:2303
translate schinese story01_4_a66af4e5:

    # r "Hey, are ya kiddin'? Gettin' B-rank's already a big deal!"
    r "喂，你开玩笑吧？能拿B级已经很了不起了！"

# game/story01en.rpy:2305
translate schinese story01_4_c2e2757b:

    # mc "Looks like fate's finally decided to cut me some slack."
    mc "看来命运终于肯放我一马了。"

# game/story01en.rpy:2306
translate schinese story01_4_9ade22b8:

    # mc "But why are you on your knees?"
    mc "可你为什么还跪着？"

# game/story01en.rpy:2308
translate schinese story01_4_274b4300:

    # r "After analyzin' your pose, I came to a conclusion..."
    r "分析完你的姿势之后，我得出一个结论……"

# game/story01en.rpy:2309
translate schinese story01_4_6ffbdab6:

    # r "The odds of gettin' a positive answer go up by sixty-three percent when ya ask like that."
    r "你这么问，得到肯定答复的概率会上升百分之六十三。"

# game/story01en.rpy:2311
translate schinese story01_4_4016f79e:

    # mc "That sounds suspiciously specific."
    mc "这数字具体得可疑。"

