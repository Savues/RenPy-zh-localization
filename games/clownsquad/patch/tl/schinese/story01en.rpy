translate schinese story01_6_e8e38ec1_1:

    # an "..."
    an "……"

# game/story01en.rpy:3287
translate schinese story01_6_6eb518d0:

    # an "I-if ya say so..."
    an "那、那就好……"

# game/story01en.rpy:3296
translate schinese story01_7_8b7b8b03:

    # "Moments later, in one of the Academy's cafeterias."
    "片刻之后，学院的一间食堂。"

