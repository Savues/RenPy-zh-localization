    r "没错。"

# game/story01en.rpy:2276
translate schinese story01_4_8872fdbf:

    # mc "Your Majesty."
    mc "陛下。"

# game/story01en.rpy:2277
translate schinese story01_4_19fcb7b1:

    # r "What?"
    r "什么？"

# game/story01en.rpy:2278
translate schinese story01_4_1722c761:

    # mc "Please, carry this pitiful mortal to the end of the exam."
    mc "请大发慈悲，捎上这个可怜凡人，一起走到考试结束。"

