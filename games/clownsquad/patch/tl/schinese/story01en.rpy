    # an "F-family?!"
    an "F——家人？！"

# game/story01en.rpy:3383
translate schinese story01_7_86163a78:

    # an "Family..."
    an "家人……"

# game/story01en.rpy:3385
translate schinese story01_7_c655ca52:

    # an "(W-w-wait... f-family?!)"
    an "（等、等一下……家、家人？！）"

# game/story01en.rpy:3386
translate schinese story01_7_c37c7425:

    # an "(Husband and wife? K-KIDS?!)"
    an "（老公老婆？孩、孩子？！）"

# game/story01en.rpy:3389
translate schinese story01_7_f589f647:

    # an "(Th-that's a l-little embarrassing...)"
