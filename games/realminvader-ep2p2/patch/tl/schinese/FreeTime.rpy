# game/FreeTime.rpyc:44
translate schinese main3freetimemiya_ec217317:

    # m "[name]?"
    m "[name]？"

# game/FreeTime.rpyc:45
translate schinese main3freetimemiya_939406d5:

    # m "I'm done with the bathroom now if you need it..."
    m "我刚用完浴室，如果你需要的话……"

# game/FreeTime.rpyc:50
translate schinese main3freetimemiya_c6906358:

    # MC "Hey, Miya..."
    MC "嘿，米娅……"

# game/FreeTime.rpyc:51
translate schinese main3freetimemiya_f1249b39:

    # MC "How are you feeling?"
    MC "感觉怎么样？"

# game/FreeTime.rpyc:52
translate schinese main3freetimemiya_12a934b3:

    # m "I feel..."
    m "我感觉……"

# game/FreeTime.rpyc:53
translate schinese main3freetimemiya_4a536e55:

    # m "Amazing..."
    m "好极了……"

# game/FreeTime.rpyc:54
translate schinese main3freetimemiya_b9a3d9f2:

    # MC "You do seem to look awfully... relaxed..."
    MC "你看起来确实相当……放松……"

# game/FreeTime.rpyc:55
translate schinese main3freetimemiya_d52573b1:

    # m "That cake was {i}so{/i} good..."
    m "那个蛋糕真的{i}太{/i}好吃了……"

# game/FreeTime.rpyc:56
translate schinese main3freetimemiya_6afe1b80:

    # m "I never knew you could eat something so good that you could {i}feel it running through your whole body{/i}..."
    m "我从没想过，吃到这么好吃的东西，能让你{i}感觉它流遍全身{/i}……"

# game/FreeTime.rpyc:57
translate schinese main3freetimemiya_c29d9a81:

    # MCt "Miya, that wasn't the food that you could feel..."
    MCt "米娅，那不是食物带来的感觉……"

# game/FreeTime.rpyc:58
translate schinese main3freetimemiya_e5999f6d:

    # MC "You were in the bath for a while."
    MC "你在浴缸里泡了很久。"

# game/FreeTime.rpyc:59
translate schinese main3freetimemiya_62232732:

    # m "Mmm... I think I fell asleep for a little while."
    m "嗯……我好像睡了一小会儿。"

# game/FreeTime.rpyc:60
translate schinese main3freetimemiya_d20869dd:

    # m "I can barely move."
    m "我几乎动不了。"

# game/FreeTime.rpyc:61
translate schinese main3freetimemiya_fc404cca:

    # m "You're going to go see that professor, aren't you?"
    m "你要去见那位教授，对吧？"

# game/FreeTime.rpyc:62
translate schinese main3freetimemiya_d2c168f8:

    # m "When is that, again?"
    m "那是什么时候？"

# game/FreeTime.rpyc:63
translate schinese main3freetimemiya_519e412c:

    # MC "The day after tomorrow."
    MC "后天。"

# game/FreeTime.rpyc:64
translate schinese main3freetimemiya_a04a1f55:

    # m "Did he say what you're doing?"
    m "他说你要做什么了吗？"

# game/FreeTime.rpyc:65
translate schinese main3freetimemiya_e1069473:

    # MC "Just some preamble, getting me up to speed before my enrollment."
    MC "只是一些开场说明，在我注册入学前先让我了解情况。"

# game/FreeTime.rpyc:66
translate schinese main3freetimemiya_6d1d2d28:

    # m "Hmm..."
    m "嗯……"

# game/FreeTime.rpyc:67
translate schinese main3freetimemiya_69003764:

    # m "I met the girls' father at his college."
    m "我在他的大学见到了女孩们的父亲。"

# game/FreeTime.rpyc:68
translate schinese main3freetimemiya_7ac1d531:

    # "Miya's expression becomes slightly sullen."
    "米娅的表情变得有些阴沉。"

# game/FreeTime.rpyc:69
translate schinese main3freetimemiya_1cca21fa:

    # MC "What were you doing there?"
    MC "你当时在那里做什么？"

# game/FreeTime.rpyc:70
translate schinese main3freetimemiya_585e05c6:

    # m "I don't know if you know this, but I was doing some modelling back then."
    m "不知道你听没听过，但那时我还在做模特。"

# game/FreeTime.rpyc:71
translate schinese main3freetimemiya_75c2be83:

    # m "My shoot at the time was on that campus. He worked in tech on the side for the college."
    m "我当时的工作就在那个校区拍摄。他在那所学院里还兼任技术工作。"

# game/FreeTime.rpyc:72
translate schinese main3freetimemiya_2578f6d7:

    # m "So he was there helping set up the lights and other things."
    m "所以他在那里帮忙布置灯光之类的东西。"

# game/FreeTime.rpyc:73
translate schinese main3freetimemiya_713d5a5d:

    # m "After the job, both of our crews went out drinking. I hit it off with him."
    m "工作结束后，我们两个的团队都出去喝酒了。我和他很聊得来。"

# game/FreeTime.rpyc:74
translate schinese main3freetimemiya_bf71516e:

    # MC "You're sounding nostalgic."
    MC "你听起来很怀旧。"

# game/FreeTime.rpyc:75
translate schinese main3freetimemiya_ddf9639c:

    # m "I {i}am{/i} being nostalgic."
    m "我{i}确实{/i}是在怀旧。"

# game/FreeTime.rpyc:76
translate schinese main3freetimemiya_024a46c5:

    # MC "You miss him?"
    MC "你想念他？"

# game/FreeTime.rpyc:77
translate schinese main3freetimemiya_47ba7d94:

    # m "No."
    m "不。"

# game/FreeTime.rpyc:78
translate schinese main3freetimemiya_83c719e7:

    # m "I miss when looking at him would bring me joy instead of confusion or nothingness."
    m "我想念的是，以前看着他会让我开心，而不是困惑或空洞。"

# game/FreeTime.rpyc:79
translate schinese main3freetimemiya_2d204a49:

    # MC "..."
    MC "……"

# game/FreeTime.rpyc:80
translate schinese main3freetimemiya_d996f3f5:

    # m "He's still out there living a normal life. Not that I particularly care."
    m "他还在外面过正常生活。倒不是我特别在意。"

# game/FreeTime.rpyc:81
translate schinese main3freetimemiya_ad0101a6:

    # MC "If you don't mind me asking... why did you stick around with him for so long?"
    MC "如果你不介意我问一下……你为什么和他在一起那么久？"

# game/FreeTime.rpyc:82
translate schinese main3freetimemiya_6d54e636:

    # MC "I don't remember much because he wasn't around very often when I was a kid. Even before you had Chloe."
    MC "我不太记得了，因为我小时候他很少在身边。甚至在你有克洛伊之前就是这样。"

# game/FreeTime.rpyc:83
translate schinese main3freetimemiya_e612037c:

    # m "..."
    m "……"

# game/FreeTime.rpyc:84
translate schinese main3freetimemiya_c9d33ba4:

    # m "Complacency can often be confused with safety."
    m "安逸很容易被误认为安全。"

# game/FreeTime.rpyc:85
translate schinese main3freetimemiya_2d204a49_1:

    # MC "..."
    MC "……"

# game/FreeTime.rpyc:86
translate schinese main3freetimemiya_e0912067:

    # MC "Wanna get some more cake sometime?"
    MC "以后想再吃些蛋糕吗？"

# game/FreeTime.rpyc:87
translate schinese main3freetimemiya_87ac232e:

    # m "Fuck yes, I do!"
    m "操，当然想！"

# game/FreeTime.rpyc:88
translate schinese main3freetimemiya_89b0f804:

    # m "That Rha'at Elth'wen hits all kinds of spots."
    m "那个拉阿特·埃尔思维恩真是处处都戳中我。"

# game/FreeTime.rpyc:89
translate schinese main3freetimemiya_596ce0f1:

    # MC "Let's... try a different cake next time."
    MC "下次……我们换个蛋糕试试吧。"

# game/FreeTime.rpyc:90
translate schinese main3freetimemiya_e4e1be9d:

    # m "Ooh, that's a nice idea. I could become a connoisseur."
    m "哦，这主意不错。我可以变成鉴赏家。"

# game/FreeTime.rpyc:101
translate schinese main3freetimenoelle_79b3d6d1:

    # n "Hey, [name]."
    n "嘿，[name]。"

# game/FreeTime.rpyc:102
translate schinese main3freetimenoelle_7026a493:

    # MC "Not at work?"
    MC "现在不用工作？"

# game/FreeTime.rpyc:103
translate schinese main3freetimenoelle_7f05d1f1:

    # n "It's a day off."
    n "今天休息。"

# game/FreeTime.rpyc:104
translate schinese main3freetimenoelle_ac94de8d:

    # MC "I see."
    MC "我明白了。"

# game/FreeTime.rpyc:109
translate schinese main3freetimenoelle_03aa359a:

    # MC "Candles and dimmed lighting."
    MC "蜡烛，还有调暗的灯光。"

# game/FreeTime.rpyc:110
translate schinese main3freetimenoelle_ad9ab8c5:

    # MC "Cozy."
    MC "真舒服。"

# game/FreeTime.rpyc:111
translate schinese main3freetimenoelle_fd9a8696:

    # n "Right?!"
    n "对吧？！"

# game/FreeTime.rpyc:112
translate schinese main3freetimenoelle_c1b4b3eb:

    # n "I love it. It makes me feel all fuzzy."
    n "我喜欢这样。感觉整个人都软绵绵的。"

# game/FreeTime.rpyc:113
translate schinese main3freetimenoelle_623eaab0:

    # MC "It somewhat reminds me of Christmas. With the sparkly, wintry vibes."
    MC "让我有点想起圣诞节。那种闪闪发亮、很有冬日气息的感觉。"

# game/FreeTime.rpyc:114
translate schinese main3freetimenoelle_71e52750:

    # n "What's Christmas? Is that a game?"
    n "圣诞节？那是一种游戏吗？"

# game/FreeTime.rpyc:115
translate schinese main3freetimenoelle_fa2a932e:

    # MCt "No way..."
    MCt "不会吧……"

# game/FreeTime.rpyc:116
translate schinese main3freetimenoelle_8ec3033d:

    # MC "You don't remember Christmas?"
    MC "你不记得圣诞节了？"

# game/FreeTime.rpyc:117
translate schinese main3freetimenoelle_e928049a:

    # n "It doesn't ring any bells."
    n "我一点印象都没有。"

# game/FreeTime.rpyc:118
translate schinese main3freetimenoelle_2e6a8726:

    # MC "Not even sleighbells?"
    MC "连雪橇铃铛都不记得？"

# game/FreeTime.rpyc:119
translate schinese main3freetimenoelle_7e6108e5:

    # MC "The thing that happens towards the end of December? With Santa Claus?"
    MC "就是十二月底会发生的那个？和圣诞老人一起？"

# game/FreeTime.rpyc:120
translate schinese main3freetimenoelle_5cd94cd7:

    # "Noelle's brow furrows."
    "诺艾尔的眉头皱了起来。"

# game/FreeTime.rpyc:121
translate schinese main3freetimenoelle_0658adc5:

    # n "You mean Gregmas?"
    n "你是说格蕾丝节？"

# game/FreeTime.rpyc:122
translate schinese main3freetimenoelle_2bfe2fde:

    # MC "What-mas?"
    MC "什么圣诞？"

# game/FreeTime.rpyc:123
translate schinese main3freetimenoelle_e4d32e71:

    # n "Are you still sick?"
    n "你还没好吗？"

# game/FreeTime.rpyc:124
translate schinese main3freetimenoelle_7a6ff324:

    # n "Gregmas! The Gregian holiday? The birthday of Jesus?"
    n "格蕾丝节！格蕾丝历的节日？耶稣的生日？"

# game/FreeTime.rpyc:125
translate schinese main3freetimenoelle_c3123e54:

    # MC "Oh! Uh, yeah yeah. Sorry, I think I am still recovering. I've been absent-minded ever since..."
    MC "哦！呃，对，对。抱歉，我想我还在恢复。自从……我就一直有点心不在焉。"

# game/FreeTime.rpyc:126
translate schinese main3freetimenoelle_6899b216:

    # MC "What's uh... Jesus' second name again?"
    MC "耶稣的第二个名字是什么来着？"

# game/FreeTime.rpyc:127
translate schinese main3freetimenoelle_bb2cf764:

    # n "..."
    n "……"

# game/FreeTime.rpyc:128
translate schinese main3freetimenoelle_3823f8f4:

    # n "Greg."
    n "格雷格。"

# game/FreeTime.rpyc:129
translate schinese main3freetimenoelle_a1915dce:

    # MC "Yep."
    MC "对。"

# game/FreeTime.rpyc:130
translate schinese main3freetimenoelle_bb2cf764_1:

    # n "..."
    n "……"

# game/FreeTime.rpyc:131
translate schinese main3freetimenoelle_a391bfd4:

    # MC "But man, it sure is comfy looking in here. I'm starting to get sleepy just soaking in the atmosphere."
    MC "不过说真的，这里看起来真舒服。我只是待在这种氛围里就开始犯困了。"

# game/FreeTime.rpyc:132
translate schinese main3freetimenoelle_864ce18c:

    # n "These candles are scented with infused wax. They're meant to encourage sleep."
    n "这些蜡烛用的是浸泡过香精油的蜡，设计目的就是助眠。"

# game/FreeTime.rpyc:133
translate schinese main3freetimenoelle_5200ba67:

    # MC "So that's what it is."
    MC "原来如此。"

# game/FreeTime.rpyc:134
translate schinese main3freetimenoelle_e629f002:

    # MC "That must mean you're winding down already."
    MC "那说明你已经开始放松下来了。"

# game/FreeTime.rpyc:135
translate schinese main3freetimenoelle_c1dd799b:

    # n "Yep. I think I'll be asleep within the next hour."
    n "对。我估计再过一个小时就能睡着。"

# game/FreeTime.rpyc:136
translate schinese main3freetimenoelle_c5b3a44f:

    # MC "I think I could use some of these candles. This feels great."
    MC "我可能会需要一些这样的蜡烛。感觉太棒了。"

# game/FreeTime.rpyc:137
translate schinese main3freetimenoelle_e267437f:

    # MC "I kinda wanna just sleep here right now."
    MC "我现在就想直接睡在这里。"

# game/FreeTime.rpyc:138
translate schinese main3freetimenoelle_97562606:

    # n "Sure. I don't mind."
    n "当然。我不介意。"

# game/FreeTime.rpyc:139
translate schinese main3freetimenoelle_e79ed82a:

    # MC "Huh?"
    MC "嗯？"

# game/FreeTime.rpyc:140
translate schinese main3freetimenoelle_385513df:

    # n "You can sleep in here."
    n "你可以睡在这里。"

# game/FreeTime.rpyc:141
translate schinese main3freetimenoelle_d4ad5e09:

    # n "You've gotta stay out of the bed, though."
    n "不过你不能睡床上。"

# game/FreeTime.rpyc:142
translate schinese main3freetimenoelle_30034a6e:

    # MC "Oh..."
    MC "哦……"

# game/FreeTime.rpyc:143
translate schinese main3freetimenoelle_3198be63:

    # n "C'mon, [name], we're not kids anymore. We can't share a bed."
    n "拜托，[name]，我们已经不是小孩子了，不能一起睡床。"

# game/FreeTime.rpyc:144
translate schinese main3freetimenoelle_9cff0a63:

    # MC "Noelle, you {i}hated{/i} me when we were kids. We've never shared a bed."
    MC "诺艾尔，我们小时候你{i}讨厌{/i}我。我们从来没一起睡过床。"

# game/FreeTime.rpyc:145
translate schinese main3freetimenoelle_16e4bf6c:

    # n "I'd love it if you'd forget that."
    n "要是你能忘了这件事就好了。"

# game/FreeTime.rpyc:146
translate schinese main3freetimenoelle_385b2211:

    # n "Little Noelle made a mistake by hating you."
    n "小时候的诺艾尔居然会讨厌你，真是个错误。"

# game/FreeTime.rpyc:147
translate schinese main3freetimenoelle_45acf7f4:

    # MC "I think I'll stick to my bedroom in that case. I like the candles, but I'd much prefer an actual bed."
    MC "那我还是回自己卧室吧。我喜欢这些蜡烛，但更想睡真正的床。"

# game/FreeTime.rpyc:148
translate schinese main3freetimenoelle_339758e3:

    # n "It's for the best. I like to sleep with my boobies out anyway and I'd consider it cruel to tape your eyes shut."
    n "这样最好。我本来也喜欢裸着胸睡觉，而且把你的眼睛粘上我觉得太残忍了。"

# game/FreeTime.rpyc:149
translate schinese main3freetimenoelle_2d204a49:

    # MC "..."
    MC "……"

# game/FreeTime.rpyc:150
translate schinese main3freetimenoelle_d9c6af3a:

    # n "Oh, and I think it says something about strong magicians."
    n "对了，我想上面还写了关于强效魔术师的事。"

# game/FreeTime.rpyc:151
translate schinese main3freetimenoelle_b3346259:

    # n "If your affinity is higher it won't work as well. I think it causes nightmares too."
    n "如果你的亲和力更高，效果就不太好了。而且我听说还会做噩梦。"

# game/FreeTime.rpyc:152
translate schinese main3freetimenoelle_76ad33e5:

    # MC "Yeah, that's probably bad."
    MC "对，那听起来确实不太好。"

# game/FreeTime.rpyc:163
translate schinese main3freetimegrace_7f72e9ac:

    # g "Need something?"
    g "需要什么吗？"

# game/FreeTime.rpyc:168
translate schinese main3freetimegrace_947900cb:

    # MC "Is that homework?"
    MC "那是作业吗？"

# game/FreeTime.rpyc:169
translate schinese main3freetimegrace_1295b6d5:

    # g "Yeah, what of it?"
    g "对，怎么了？"

# game/FreeTime.rpyc:170
translate schinese main3freetimegrace_268f81a3:

    # MC "It's just that... now that I think about it..."
    MC "只是……现在想想……"

# game/FreeTime.rpyc:171
translate schinese main3freetimegrace_17565b98:

    # MC "I've never seen you doing it before..."
    MC "我从没见你在晚上做过这个……"

# game/FreeTime.rpyc:172
translate schinese main3freetimegrace_ffbb7967:

    # MC "You're the type to do it at night?"
    MC "你是那种会在晚上做的人？"

# game/FreeTime.rpyc:173
translate schinese main3freetimegrace_43286a4b:

    # g "I'm an organized person."
    g "我是个很有条理的人。"

# game/FreeTime.rpyc:174
translate schinese main3freetimegrace_5f899581:

    # g "The end of the day is where homework fits best."
    g "一天结束的时候最适合做作业。"

# game/FreeTime.rpyc:175
translate schinese main3freetimegrace_e2e67209:

    # g "Most of the day is school, training, and any social activities I have planned."
    g "白天大部分时间都要上课、训练，还有我安排好的社交活动。"

# game/FreeTime.rpyc:176
translate schinese main3freetimegrace_0bdfaffa:

    # g "Plus, after all of that, I like to have some unstructured free time. I think I'd end up killing myself if my whole life was confined to a routine."
    g "而且做完这些之后，我还想留一点不受安排的自由时间。要是整个人生都被固定日程束缚，我可能会想自杀。"

# game/FreeTime.rpyc:177
translate schinese main3freetimegrace_8982d8bb:

    # MC "So what comes after the homework? Sleep?"
    MC "那作业之后是什么？睡觉？"

# game/FreeTime.rpyc:178
translate schinese main3freetimegrace_3f07aa68:

    # g "Not quite."
    g "不完全是。"

# game/FreeTime.rpyc:179
translate schinese main3freetimegrace_f93aa805:

    # MC "So what is it?"
    MC "那是什么？"

# game/FreeTime.rpyc:180
translate schinese main3freetimegrace_b3339d7b:

    # g "Masturbation."
    g "自慰。"

# game/FreeTime.rpyc:181
translate schinese main3freetimegrace_62e18230:

    # "Grace's expression remained natural while she said that."
    "格蕾丝说这话时，表情依然很自然。"

# game/FreeTime.rpyc:182
translate schinese main3freetimegrace_f37f5b05:

    # "You have no reason to believe that she was joking."
    "你没有理由认为她是在开玩笑。"

# game/FreeTime.rpyc:183
translate schinese main3freetimegrace_beacad35:

    # g "Don't go all stiff like that. Or are you going to pretend that you don't do it?"
    g "别整个人僵住。还是说，你要假装自己不会做？"

# game/FreeTime.rpyc:184
translate schinese main3freetimegrace_25ff23dc:

    # MC "I just... didn't expect you to say it so bluntly."
    MC "我只是……没想到你会说得这么直接。"

# game/FreeTime.rpyc:185
translate schinese main3freetimegrace_4b340443:

    # g "..."
    g "……"

# game/FreeTime.rpyc:186
translate schinese main3freetimegrace_33ac8b4a:

    # MC "You really rub one out on a schedule? I just do it whenever."
    MC "你真的按固定时间自慰？我都是想做就做。"

# game/FreeTime.rpyc:187
translate schinese main3freetimegrace_98879c43:

    # g "It's just compulsive like that."
    g "只是有点强迫症而已。"

# game/FreeTime.rpyc:188
translate schinese main3freetimegrace_60976b3c:

    # g "I do it once after waking up, and once before bed."
    g "我早上醒来后做一次，睡前再做一次。"

# game/FreeTime.rpyc:189
translate schinese main3freetimegrace_89c2ace2:

    # g "If I feel like doing it again during the day, I will."
    g "如果白天又想做了，我也会做。"

# game/FreeTime.rpyc:190
translate schinese main3freetimegrace_2d204a49:

    # MC "..."
    MC "……"

# game/FreeTime.rpyc:191
translate schinese main3freetimegrace_d3bb2ff9:

    # MC "What kinda homework is that?"
    MC "这算什么作业？"

