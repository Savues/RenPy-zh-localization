translate schinese ft18end_2_5718638b:

    # tea "How about {i}every one of them{/i}?"
    tea "要是说{i}每一门{/i}呢？"

# game/script2.rpyc:11633
translate schinese ft18end_2_3eea7656:

    # tea "Why are you standing {i}outside{/i}, Noelle?"
    tea "诺艾尔，你为什么站在{i}外面{/i}？"

