    # g "[name], that swim meet I told you about is in a few days."
    g "[name]，我跟你说的游泳比赛就在几天后。"

# game/script2.rpyc:611
translate schinese m12afterchoice3_e845ff35:

    # g "You're coming to cheer me on, right?"
    g "你会来给我加油，对吧？"

# game/script2.rpyc:612
translate schinese m12afterchoice3_e79ed82a:

    # MC "Huh?"
    MC "嗯？"

# game/script2.rpyc:613
translate schinese m12afterchoice3_fbe275fa:

