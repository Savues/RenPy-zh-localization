translate schinese m14choice1_2_28858de1:

    # g "You're genuinely my best friend in the world. I wouldn't give you up for anything."
    g "你真的是我最好的朋友。无论如何我都不会放弃这段友谊。"

# game/script2.rpyc:4989
translate schinese m14choice1_2_2d204a49:

    # MC "..."
    MC "……"

# game/script2.rpyc:4994
translate schinese m14choice2_1_5f6f2264:

    # g "I know."
    g "我知道。"

