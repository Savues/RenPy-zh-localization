    v "落后了很多……"

# game/script2.rpyc:3881
translate schinese m13afterfreda_2296bee1:

    # MC "It's her leg, isn't it?"
    MC "是因为她的腿吗？"

# game/script2.rpyc:3884
translate schinese m13afterfreda_8fc90cd7:

    # mer "I'm sorry..."
    mer "对不起……"

# game/script2.rpyc:3885
translate schinese m13afterfreda_441ff78f:

    # han "Meryl... Why didn't you tell us you were hurt?"
    han "梅瑞尔……你受伤了怎么不告诉我们？"

# game/script2.rpyc:3886
translate schinese m13afterfreda_6dd9f0fa:

    # mer "I didn't want to just forfeit..."
    mer "我不想就这样弃权……"

# game/script2.rpyc:3887
translate schinese m13afterfreda_8a3b62c7:

    # mer "I guess it made no difference... I came last anyway..."
    mer "看来也没什么区别……反正我还是垫底……"

# game/script2.rpyc:3888
translate schinese m13afterfreda_081effc6:

    # han "It's fine. We all understand."
    han "没关系，我们都理解。"

# game/script2.rpyc:3889
translate schinese m13afterfreda_8fc90cd7_1:

    # mer "I'm sorry..."
    mer "对不起……"

# game/script2.rpyc:3890
translate schinese m13afterfreda_a8b69bc9:

    # mer "There's no way we can win now..."
    mer "现在我们没法赢了……"

# game/script2.rpyc:3892
translate schinese m13afterfreda_9339d4af:

    # han "It's not your fault..."
    han "这不是你的错……"

# game/script2.rpyc:3893
translate schinese m13afterfreda_9aea3cbb:

    # han "And besides. {i}I{/i} won."
    han "再说，{i}我{/i}赢了。"

# game/script2.rpyc:3894
translate schinese m13afterfreda_c5daeebd:

    # han "We've got Grace and Freda."
    han "我们还有格蕾丝和芙蕾达呢。"

# game/script2.rpyc:3895
translate schinese m13afterfreda_c4148cb1:

    # han "I'm sure they'll win so... chin up, okay."
    han "我相信她们会赢的，所以……振作点，好吗？"

# game/script2.rpyc:3897
translate schinese m13afterfreda_3065f27f:

    # MC "Uh... What does this mean?"
    MC "呃……这是什么意思？"

# game/script2.rpyc:3898
translate schinese m13afterfreda_c45e8cf5:

    # v "Getting last place in a race doesn't bode well."
    v "比赛垫底可不是什么好兆头。"

# game/script2.rpyc:3899
translate schinese m13afterfreda_fa295167:

    # v "For all intents and purposes. We {i}need{/i} both Grace and Freda to win now."
    v "实际上，现在我们{i}指望{/i}格蕾丝和芙蕾达都能赢。"

# game/script2.rpyc:3900
translate schinese m13afterfreda_2d204a49_1:

    # MC "..."
    MC "……"

# game/script2.rpyc:3902
translate schinese m13afterfreda_5bed713d:

    # han "Then..."
    han "那……"

# game/script2.rpyc:3903
translate schinese m13afterfreda_dffe69f2:

    # han "It's {i}my{/i} fault too."
    han "这也有{i}我{/i}的责任。"

# game/script2.rpyc:3904
translate schinese m13afterfreda_c7ecbf00:

    # han "I didn't win either. If I won we'd still have a chance."
    han "我也没赢。如果我赢了，我们本来还有机会的。"

# game/script2.rpyc:3905
translate schinese m13afterfreda_c68cf102:

    # han "So don't blame yourself."
    han "所以别怪自己。"

# game/script2.rpyc:3907
translate schinese m13afterfreda_3065f27f_1:

    # MC "Uh... What does this mean?"
    MC "呃……这是什么意思？"

# game/script2.rpyc:3908
translate schinese m13afterfreda_7a8125f4:

    # v "We've lost."
    v "我们输了。"

# game/script2.rpyc:3909
translate schinese m13afterfreda_95e59f81:

    # MC "What?!"
    MC "什么？！"

# game/script2.rpyc:3910
translate schinese m13afterfreda_f68f6a0c:

    # v "You get zero points for last place."
    v "垫底是拿不到积分的。"

# game/script2.rpyc:3911
translate schinese m13afterfreda_0ac227c9:

    # v "Hypothetically, if the next best team comes in last in one of the upcoming races, we could stand a chance..."
    v "假设一下，如果那个实力仅次于我们的车队在接下来的某场比赛中垫底，我们或许还有机会……"

# game/script2.rpyc:3912
translate schinese m13afterfreda_e14a39e1:

    # v "But that, and the rest of the points aligning... isn't exactly likely."
    v "但这种情况，再加上其他积分情况的巧合……发生的可能性微乎其微。"

# game/script2.rpyc:3913
translate schinese m13afterfreda_2d204a49_2:

    # MC "..."
    MC "……"

# game/script2.rpyc:3917
translate schinese m13afterfreda_7fec58bf:

    # v "A little sloppy..."
    v "有点粗糙……"

# game/script2.rpyc:3918
translate schinese m13afterfreda_0682477f:

    # v "But still... a good performance."
    v "但表现依然很出色。"

# game/script2.rpyc:3920
translate schinese m13afterfreda_85e6088e:

    # han "Meryl! You're hurt!"
    han "梅瑞尔！你受伤了！"

# game/script2.rpyc:3921
translate schinese m13afterfreda_334fd238:

    # mer "Hehe, still didn't stop me, did it?"
    mer "嘿嘿，但这也没能阻止我，对吧？"

# game/script2.rpyc:3922
translate schinese m13afterfreda_89c579cb:

    # mer "I could've won, too if it wasn't for this damn leg."
    mer "要不是这条该死的腿，我也能赢的。"

# game/script2.rpyc:3927
translate schinese m13afterfreda_1beb2ff4:

    # MC "Nice! She won!"
    MC "太棒了！她赢了！"

# game/script2.rpyc:3929
translate schinese m13afterfreda_233c9c0c:

    # v "Maybe you should pursue being a masseuse."
    v "也许你应该考虑去当个按摩师。"

# game/script2.rpyc:3931
translate schinese m13afterfreda_f6a3105e:

    # MC "There's those two wins you were so invested in."
    MC "那两场你如此看重的胜利，现在到手了。"

# game/script2.rpyc:3932
translate schinese m13afterfreda_cbff1899:

    # v "Indeed. Unless Grace spontaneously combusts we've won for sure."
    v "确实。除非格蕾丝突然自燃，否则我们赢定了。"

# game/script2.rpyc:3934
translate schinese m13afterfreda_8d0cd358:

    # v "We're not done yet, though I'm not particularly worried about our next swimmer."
    v "比赛还没完全结束，不过我对我们的下一位选手并不怎么担心。"

# game/script2.rpyc:3942
translate schinese m13afterfreda_3ff8e1b1:

    # MC "Is Grace always this focused?"
    MC "格蕾丝总是这么专注吗？"

# game/script2.rpyc:3943
translate schinese m13afterfreda_87f84e05:

    # v "When it's down to the wire, yes."
    v "到了紧要关头，确实如此。"

# game/script2.rpyc:3944
translate schinese m13afterfreda_6a1e93dd:

    # MC "She was panicking non-stop until now."
    MC "她刚才还一直惊慌失措呢。"

# game/script2.rpyc:3946
translate schinese m13afterfreda_7fcc962c:

    # v "I do have to say... The change is quite extreme. Even for her standards."
    v "不得不说……这种转变太剧烈了。即便以她的标准来看也是如此。"

# game/script2.rpyc:3949
translate schinese m13afterfreda_1ec42ab4:

    # MC "I thought a calming spell should do the trick."
    MC "我想用个镇静咒应该能奏效。"

# game/script2.rpyc:3950
translate schinese m13afterfreda_74d8ccd5:

    # v "Hm. That's a good idea. As long as you didn't overdo it."
    v "嗯，好主意。只要你没用力过猛就行。"

# game/script2.rpyc:3951
translate schinese m13afterfreda_0e1fcb2e:

    # v "A well-balanced spell can dramatically increase focus."
    v "恰到好处的咒语能显著提升专注力。"

# game/script2.rpyc:3952
translate schinese m13afterfreda_3f04c7f0:

    # MC "Does it? I've never had it cast upon me before."
    MC "是吗？以前从未有人对我施过这种法术。"

# game/script2.rpyc:3953
translate schinese m13afterfreda_ead3c6ff:

    # v "Hmm... Is that so?"
    v "嗯……是吗？"

# game/script2.rpyc:3954
translate schinese m13afterfreda_b8f383c9:

    # v "Then..."
    v "那……"

# game/script2.rpyc:3957
translate schinese m13afterfreda_9e3c0d11:

    # v "Would you like to experience {i}my{/i} calming spell?"
    v "你想体验一下{i}我{/i}的镇静法术吗？"

# game/script2.rpyc:3958
translate schinese m13afterfreda_75fea830:

    # MC "I don't think it will work on me."
    MC "我觉得那对我没用。"

# game/script2.rpyc:3959
translate schinese m13afterfreda_ad61ab66:

    # v "Do you consider yourself immune to magic, [name]?"
    v "你认为自己对魔法免疫吗，[name]？"

# game/script2.rpyc:3960
translate schinese m13afterfreda_4aaaecbc:

    # MC "It's just that my affinity is much higher than yours so-"
    MC "只是因为我的亲和力比你高得多，所以——"

# game/script2.rpyc:3963
translate schinese m13afterfreda_2fa0528b:

    # v "Now when did you test such a thing?"
    v "那你是什么时候测试过这种事的？"

# game/script2.rpyc:3964
translate schinese m13afterfreda_06494a66:

    # MCt "Ah! She's right... I don't actually {i}know{/i} if my affinity is higher than hers. Even if statistics would indicate so."
    MCt "啊！她说得对……我其实并不知道{i}自己{/i}的亲和力是否真的比她高。尽管数据似乎是这么显示的。"

# game/script2.rpyc:3965
translate schinese m13afterfreda_57c8d906:

    # MC "Sorry... I've never met someone with higher affinity than mine. I just kinda assume everyone else's is lower."
    MC "抱歉……我以前从未遇到过亲和力比我高的人。我只是理所当然地以为别人的都比我低。"

# game/script2.rpyc:3966
translate schinese m13afterfreda_1bf5287a:

    # v "You're just full of surprises, aren't you?"
    v "你真是总能给人带来惊喜，不是吗？"

# game/script2.rpyc:3967
translate schinese m13afterfreda_b4870418:

    # v "As long as you consent, and feed yourself into me, I can influence you a little bit."
    v "只要你同意，并且将自己融入我，我就能对你产生些许影响。"

# game/script2.rpyc:3968
translate schinese m13afterfreda_9cc2aa80:

    # MC "This is the first time I'm hearing about such a thing being possible."
    MC "我还是头一次听说这种事是可能的。"

# game/script2.rpyc:3969
translate schinese m13afterfreda_89e9931d:

    # v "Oh, but it is."
    v "噢，但这确实是可能的。"

# game/script2.rpyc:3970
translate schinese m13afterfreda_c12102ad:

    # v "Here, let me try it on you."
    v "来，让我试试看。"

# game/script2.rpyc:3973
translate schinese m13afterfreda_e2ebc64e:

    # v "It feels like your affinity {i}is{/i} higher than mine. I admit I tried to force myself upon you just now."
    v "感觉你的亲和力{i}确实{/i}比我的高。我承认，刚才是我强行对你施加了影响。"

# game/script2.rpyc:3974
translate schinese m13afterfreda_2c3a89ce:

    # MC "How very selfish of you."
    MC "你真是太自私了。"

# game/script2.rpyc:3975
translate schinese m13afterfreda_ad335c1f:

    # v "Please do forgive me, my curiosity got the better of me."
    v "请原谅我，当时我实在按捺不住好奇心。"

# game/script2.rpyc:3976
translate schinese m13afterfreda_2938eb13:

    # v "Make sure you're responding to me."
    v "你要确保是在回应我。"

# game/script2.rpyc:3977
translate schinese m13afterfreda_1ebc6634:

    # v "Forget about your surroundings, forget about what you're doing, forget about the future, forget about your feelings..."
    v "忘掉周围的一切，忘掉你正在做的事，忘掉未来，忘掉你的感受……"

# game/script2.rpyc:3983
translate schinese m13afterfreda_b946fef8:

    # v "Forget about your wants, forget about your past."
    v "忘掉你的欲望，忘掉你的过去。"

# game/script2.rpyc:3989
translate schinese m13afterfreda_2f9e8221:

    # v "Forget..."
    v "忘掉……"

# game/script2.rpyc:3994
translate schinese m13afterfreda_65cabcbf_2:

    # v "..."
    v "……"

# game/script2.rpyc:3997
translate schinese m13afterfreda_fef08d5f:

    # v "Your silence implies that I had an effect on you."
    v "你的沉默说明我对你产生了影响。"

# game/script2.rpyc:3998
translate schinese m13afterfreda_2d204a49_3:

    # MC "..."
    MC "……"

# game/script2.rpyc:3999
translate schinese m13afterfreda_b128005b:

    # MC "Woah."
    MC "哇。"

# game/script2.rpyc:4000
translate schinese m13afterfreda_b01fb7cf:

    # v "Is it {i}that{/i} impressive?"
    v "效果有{i}那么{/i}惊人吗？"

# game/script2.rpyc:4001
translate schinese m13afterfreda_aa116067:

    # v "The induction of that spell may have been a bit intense."
    v "那个法术的引导过程可能确实有些激烈。"

# game/script2.rpyc:4002
translate schinese m13afterfreda_4374a877:

    # v "In a situation such as that, the caster has to intervene, hijack the recipient's magic, and attempt a coup of sorts."
    v "在这种情况下，施法者必须介入，劫持受术者的魔力，并尝试某种形式的“政变”。"

# game/script2.rpyc:4003
translate schinese m13afterfreda_65cabcbf_3:

    # v "..."
    v "……"

# game/script2.rpyc:4004
translate schinese m13afterfreda_921e1251:

    # v "You look awfully relaxed."
    v "你看上去……放松。"

# game/script2.rpyc:4008
translate schinese m13afterfreda_409aa7a1:

    # v "Hey!"
    v "喂！"

# game/script2.rpyc:4009
translate schinese m13afterfreda_7bebfa4a:

    # v "Talk to me."
    v "跟我说说话。"

# game/script2.rpyc:4010
translate schinese m13afterfreda_511c1c6b:

    # MC "Ah, wait, woah, woah! Sorry!"
    MC "啊，等等，哇，哇！抱歉！"

# game/script2.rpyc:4013
translate schinese m13afterfreda_681c5938:

    # MC "I had no idea it felt like that. That was beyond worthy of the name \"calming spell\"."
    MC "我完全没想到会是这种感觉。这效果简直太配得上“镇静咒”这个名字了。"

# game/script2.rpyc:4015
translate schinese m13afterfreda_a3aadbea:

    # v "I'm glad I could bring you such comfort."
    v "很高兴能让你感到如此舒适。"

# game/script2.rpyc:4016
translate schinese m13afterfreda_32ee1ea6:

    # MC "'Comfort' doesn't really do it justice, you practically turned my brain off for a moment."
    MC "光用“舒适”二字可形容不了，刚才那一瞬间，我的大脑简直都停止运转了。"

# game/script2.rpyc:4017
translate schinese m13afterfreda_eb08046d:

    # v "Be thankful it turned back on."
    v "该庆幸它后来又恢复运转了。"

# game/script2.rpyc:4018
translate schinese m13afterfreda_a498f3d3:

    # MCt "That was insane..."
    MCt "刚才那场面真惊人……"

# game/script2.rpyc:4019
translate schinese m13afterfreda_04c04466:

    # v "Do you feel any more focused than before?"
    v "你觉得注意力比之前更集中了吗？"

# game/script2.rpyc:4020
translate schinese m13afterfreda_acac705f:

    # MC "Focused? Like what's happening to Grace? Nah, doesn't feel like it."
    MC "集中？就像格蕾丝那种状态吗？不，没这种感觉。"

# game/script2.rpyc:4021
translate schinese m13afterfreda_8c7ef90d:

    # v "Hmm... the benefits to focus don't necessarily kick in until the recipient has a clear goal in mind."
    v "嗯……只有当接受者心中有明确目标时，这种提升专注力的效果才会显现出来。"

# game/script2.rpyc:4022
translate schinese m13afterfreda_1a4d9fae:

    # MC "So I'm not feeling the focus because there's not particularly anything I want to do right now?"
    MC "也就是说，我没感觉到专注力提升，是因为我现在没什么特别想做的事？"

# game/script2.rpyc:4023
translate schinese m13afterfreda_8e257914:

    # v "Precisely."
    v "正是如此。"

# game/script2.rpyc:4024
translate schinese m13afterfreda_ded445e2:

    # v "I can't tell the potency with which the spell was cast, what with it using some of {i}your{/i} magic and all."
    v "毕竟这法术动用了{i}你{/i}的魔力，所以我很难判断施法时的强度究竟如何。"

# game/script2.rpyc:4025
translate schinese m13afterfreda_bbda9eae:

    # v "But that focus could still be triggered if the spell doesn't wear off too quickly."
    v "不过，只要法术效果不会消退得太快，那种专注状态还是有可能被触发的。"

# game/script2.rpyc:4026
translate schinese m13afterfreda_6e38f7df:

    # MC "...Interesting..."
    MC "……有意思……"

# game/script2.rpyc:4028
translate schinese m13afterfreda_9ace5721:

    # v "Frivolous worrying. Plenty of people do it."
    v "无谓的担忧。很多人都这么做。"

# game/script2.rpyc:4032
translate schinese m13afterfreda_4b340443_1:

    # g "..."
    g "……"

# game/script2.rpyc:4034
translate schinese m13afterfreda_2d204a49_4:

    # MC "..."
    MC "……"

# game/script2.rpyc:4035
translate schinese m13afterfreda_ceaaa502:

    # MCt "It doesn't even look like she's thinking of anything..."
    MCt "她看起来甚至不像是在思考什么……"

# game/script2.rpyc:4037
translate schinese m13afterfreda_e691c5a6:

    # gt "He's watching me."
    gt "他在看着我。"

# game/script2.rpyc:4038
translate schinese m13afterfreda_4b340443_2:

    # g "..."
    g "……"

# game/script2.rpyc:4039
translate schinese m13afterfreda_da12bc24:

    # gt "There's no way I can lose in front of him."
    gt "我绝不能在他面前输掉。"

# game/script2.rpyc:4041
translate schinese m13afterfreda_4b340443_3:

    # g "..."
    g "……"

# game/script2.rpyc:4042
translate schinese m13afterfreda_fffbbfa9:

    # gt "He's watching me..."
    gt "他在看着我……"

# game/script2.rpyc:4043
translate schinese m13afterfreda_bcca9931:

    # g "*Sniff*"
    g "*吸鼻子*"

# game/script2.rpyc:4044
translate schinese m13afterfreda_8405b315:

    # gt "I don't wanna lose in front of him..."
    gt "我不想在他面前输……"

# game/script2.rpyc:4045
translate schinese m13afterfreda_62d3f251:

    # gt "What if I lose? Will he think I'm lame?"
    gt "万一我输了呢？他会觉得我很逊吗？"

# game/script2.rpyc:4046
translate schinese m13afterfreda_bcca9931_1:

    # g "*Sniff*"
    g "*吸鼻子*"

# game/script2.rpyc:4047
translate schinese m13afterfreda_446d51af:

    # gt "I wanna be cool..."
    gt "我想表现得帅气一点……"

# game/script2.rpyc:4050
translate schinese m13afterfreda_766aa07a:

    # MC "Here we go... It's her turn..."
    MC "开始了……轮到她了……"

# game/script2.rpyc:4079
translate schinese m13afterfreda_c0eaea67:

    # v "That's normal by the way."
    v "顺便说一句，这很正常。"

# game/script2.rpyc:4080
translate schinese m13afterfreda_dc65dc15:

    # v "Maybe a little slow for her standards, but mostly normal."
    v "也许以她的标准来看有点慢，但总体上是正常的。"

# game/script2.rpyc:4081
translate schinese m13afterfreda_2d204a49_5:

    # MC "..."
    MC "……"

# game/script2.rpyc:4082
translate schinese m13afterfreda_8c30967c:

    # MC "Why was she worrying, again?"
    MC "她到底在担心什么呢？"

# game/script2.rpyc:4090
translate schinese m13afterfreda_f998c1fe:

    # v "???"
    v "？？？"

# game/script2.rpyc:4091
translate schinese m13afterfreda_7c3bb098:

    # g "I won."
    g "我赢了。"

# game/script2.rpyc:4092
translate schinese m13afterfreda_28a185ed:

    # g "Did you see?"
    g "你看到了吗？"

# game/script2.rpyc:4093
translate schinese m13afterfreda_429a8376:

    # MC "Uh... yeah. I saw."
    MC "呃……嗯，我看到了。"

# game/script2.rpyc:4094
translate schinese m13afterfreda_fb6ed8fd:

    # g "Good."
    g "不错。"

# game/script2.rpyc:4095
translate schinese m13afterfreda_0d36b562:

