# game/script2.rpyc:60
translate schinese m12afterchoice1_d1d42dcf:

    # MCt "It's been eight days since then..."
    MCt "从那以后已经八天了……"

# game/script2.rpyc:61
translate schinese m12afterchoice1_8da77071:

    # MCt "No signs of Liliana. No-one looking for Cadence."
    MCt "没有莉莉安娜的消息。也没人在找凯登丝。"

# game/script2.rpyc:62
translate schinese m12afterchoice1_7564f27d:

    # MCt "Everything seems normal."
    MCt "一切似乎都正常。"

# game/script2.rpyc:63
translate schinese m12afterchoice1_d57ce89e:

    # MCt "We're all just... living our lives."
    MCt "我们大家只是……各自过着自己的生活。"

# game/script2.rpyc:64
translate schinese m12afterchoice1_e0d4ef9b:

    # MCt "Tensions in the house settled after a few days with the drama having no immediate follow-up."
    MCt "家里那场风波几天后渐渐平息，因为没有立刻引发后续。"

# game/script2.rpyc:65
translate schinese m12afterchoice1_21fb9c43:

    # MCt "Cadence has settled in, she's already as much a part of this family as I am."
    MCt "凯登丝已经适应了，她和我一样已经成了这个家庭的一员。"

# game/script2.rpyc:67
translate schinese m12afterchoice1_4ce82e5a:

    # MCt "Training under Ron, or more often than not, Stella, has progressed rapidly."
    MCt "在罗纳德，或者更多时候是斯特拉的指导下，训练进展很快。"

# game/script2.rpyc:68
translate schinese m12afterchoice1_34279ebd:

    # MCt "We've reached the high school syllabus already."
    MCt "我们已经学到高中课程了。"

# game/script2.rpyc:69
translate schinese m12afterchoice1_06fafb72:

    # MCt "While it seems like Embers are easy to come by considering how much my balance has increased, I need to remember that this is an entire childhood's worth of income."
    MCt "虽然我的余额增加后，余烬看起来很容易获得，但我得记住这是一整段童年收入。"

# game/script2.rpyc:70
translate schinese m12afterchoice1_1a8fba5e:

    # MCt "The card trick still works. So while I {i}do{/i} have a source of Embers, it's not like I'll see this many every day."
    MCt "扑克牌技巧仍然有效。所以我虽然{i}确实{/i}有余烬来源，但不会每天都能看到这么多。"

# game/script2.rpyc:71
translate schinese m12afterchoice1_dc504e26:

    # MCt "So in conclusion..."
    MCt "所以总的来说……"

# game/script2.rpyc:78
translate schinese m12afterchoice1_2c838da9:

    # MCt "Nothing has changed."
    MCt "什么都没变。"

# game/script2.rpyc:79
translate schinese m12afterchoice1_a737bc5d:

    # MCt "Which I guess I'm grateful for, all things considered..."
    MCt "考虑到发生的一切，我想我应该对此感到感激……"

# game/script2.rpyc:80
translate schinese m12afterchoice1_2885cf96:

    # n "I can see you looking at me, [name]."
    n "我能看到你在盯着我看，[name]。"

# game/script2.rpyc:81
translate schinese m12afterchoice1_23cdf91f:

    # MC "Uh huh. You want me to stop?"
    MC "嗯哼。想让我停下吗？"

# game/script2.rpyc:82
translate schinese m12afterchoice1_7805a8a3:

    # n "Oh, no. By all means, stare as much as you want. I know it's hard to resist."
    n "哦，不。请尽管看，想看多久都行。我知道你很难抵抗。"

# game/script2.rpyc:83
translate schinese m12afterchoice1_35763397:

    # MC "I bet that confidence goes a {i}looong{/i} way for you."
    MC "我敢说这份自信对你来说可{i}太重要{/i}了。"

# game/script2.rpyc:84
translate schinese m12afterchoice1_c5dc1719:

    # n "It weeds out all the incompatible people."
    n "这样能把所有不兼容的人筛掉。"

# game/script2.rpyc:85
translate schinese m12afterchoice1_9932e320:

    # MC "What kind of compatibility? Pushovers that worship you?"
    MC "什么兼容性？那种把你当神一样崇拜的软饭男？"

# game/script2.rpyc:89
translate schinese m12afterchoice1_9e87cf67:

    # n "You're still staring."
    n "你还在盯着。"

# game/script2.rpyc:90
translate schinese m12afterchoice1_7f49f74f:

    # MC "We're having a conversation."
    MC "我们在聊天。"

# game/script2.rpyc:91
translate schinese m12afterchoice1_6a0a6dc0:

    # n "I'm not staring at you."
    n "我没有盯着你看。"

# game/script2.rpyc:92
translate schinese m12afterchoice1_1dd34d0e:

    # MC "You normally abide by the unwritten rules of eye contact."
    MC "你通常会遵守眼神接触的不成文规则。"

# game/script2.rpyc:93
translate schinese m12afterchoice1_3e91e1a2:

    # n "As you can see I have my hands and feet full right now."
    n "你看，我现在手脚都忙着呢。"

# game/script2.rpyc:94
translate schinese m12afterchoice1_e467e673:

    # n "Do you have a thing for feet, [name]?"
    n "你喜欢脚，[name]？"

# game/script2.rpyc:96
translate schinese m12afterchoice1_e2da4cae:

    # n "You know what I mean."
    n "你知道我是什么意思。"

# game/script2.rpyc:102
translate schinese m12choice2_1_6d63db43:

    # n "!!!"
    n "！！！"

# game/script2.rpyc:112
translate schinese m12choice2_1_2ddf91ed:

    # n "You too?"
    n "你也喜欢？"

# game/script2.rpyc:116
translate schinese m12choice2_2_73da4c8e:

    # n "Hmm?"
    n "嗯？"

# game/script2.rpyc:117
translate schinese m12choice2_2_70643cd2:

    # n "Is that so?"
    n "是吗？"

# game/script2.rpyc:121
translate schinese m12choice2_3_73da4c8e:

    # n "Hmm?"
    n "嗯？"

# game/script2.rpyc:122
translate schinese m12choice2_3_70643cd2:

    # n "Is that so?"
    n "是吗？"

# game/script2.rpyc:125
translate schinese m12choice2_4_aa86aef5:

    # MC "No. But it's not about the feet. It's about the work that goes into them."
    MC "不。但这和脚本身无关。我在意的是它们背后的付出。"

# game/script2.rpyc:126
translate schinese m12choice2_4_b55b62b1:

    # MC "I don't have a \"thing\" for hair either but the right style can make someone gorgeous."
    MC "我对头发也没有这种“偏好”，但合适的发型能让人变得美艳。"

# game/script2.rpyc:127
translate schinese m12choice2_4_83abb563:

    # MC "Women work hard on themselves. And it pays off."
    MC "女人会为自己努力，而且确实会有回报。"

# game/script2.rpyc:131
translate schinese m12choice2_4_03439440:

    # n "Ohoho, [name]. I didn't realize you were such an ally of women."
    n "哦豁，[name]。没想到你还是女性主义的坚定盟友。"

# game/script2.rpyc:132
translate schinese m12choice2_4_295b06e2:

    # MC "I prefer \"connoisseur of fine art\"."
    MC "我更愿意被称为“鉴赏家”。"

# game/script2.rpyc:133
translate schinese m12choice2_4_63d931fa:

    # n "Don't push your luck, you're trailing into simp territory."
    n "别得寸进尺，你已经快掉进舔狗区了。"

# game/script2.rpyc:134
translate schinese m12choice2_4_43147ca6:

    # MC "Then let's just stick with \"I like painted toenails\"."
    MC "那就说“我喜欢涂了指甲油的脚趾”吧。"

# game/script2.rpyc:140
translate schinese m12choice2_5_0d6c9682:

    # n "Eww! That's gross."
    n "呃！太恶心了。"

# game/script2.rpyc:141
translate schinese m12choice2_5_caaf4377:

    # n "That joke didn't land the way you thought it would, [name]."
    n "这个笑话可没像你想象的那样奏效，[name]。"

# game/script2.rpyc:146
translate schinese m12afterchoice2_7a309500:

    # m "Heads up!"
    m "提醒一下！"

# game/script2.rpyc:157
translate schinese m12afterchoice2_cbfba530:

    # m "Lucky you, the chocolate has stayed intact. Must be a well insulated package."
    m "你运气真好，巧克力居然没化。包装一定很隔热。"

# game/script2.rpyc:168
translate schinese m12afterchoice2_f90730b8:

    # MC "Wakey wakey!"
    MC "醒醒醒醒！"

# game/script2.rpyc:177
translate schinese m12afterchoice2_60b9e114:

    # C "Mya-!"
    C "妈——！"

# game/script2.rpyc:181
translate schinese m12afterchoice2_1758c1f1:

    # MC "Something to help us keep cool."
    MC "这是帮我们保持凉快的东西。"

# game/script2.rpyc:185
translate schinese m12afterchoice2_c7371c45:

    # C "You know you didn't have to do this, master?"
    C "主人，你其实不用这样做的。"

# game/script2.rpyc:186
translate schinese m12afterchoice2_f556e16f:

    # C "I can handle the heat just fine."
    C "我完全能应付这种热度。"

# game/script2.rpyc:187
translate schinese m12afterchoice2_13cd286b:

    # MC "I know you can handle it. This is a gift not a medical prescription."
    MC "我知道你能应付。这是礼物，不是医疗处方。"

# game/script2.rpyc:190
translate schinese m12afterchoice2_3a82c421:

    # C "Hmm..."
    C "嗯……"

# game/script2.rpyc:191
translate schinese m12afterchoice2_59a98098:

    # C "Thanks, master!"
    C "谢谢你，主人！"

# game/script2.rpyc:193
translate schinese m12afterchoice2_67e6ecd6:

    # MC "Here. Chocolate."
    MC "给。巧克力。"

# game/script2.rpyc:195
translate schinese m12afterchoice2_22a96ce9:

    # C "Chocolate?!"
    C "巧克力？！"

# game/script2.rpyc:196
translate schinese m12afterchoice2_3624a886:

    # C "Why? What's the occasion?"
    C "为什么？今天是什么日子吗？"

# game/script2.rpyc:197
translate schinese m12afterchoice2_30b62a2e:

    # MC "Chocolate isn't a celebratory food, Cadence."
    MC "凯登丝，巧克力可不是庆祝用的食物。"

# game/script2.rpyc:198
translate schinese m12afterchoice2_e5bbff6e:

    # MC "I just thought about giving you some."
    MC "我只是突然想给你一些。"

# game/script2.rpyc:201
translate schinese m12afterchoice2_bb27f980:

    # C "I love chocolate! I haven't had it in years."
    C "我爱巧克力！已经好多年没吃过了。"

# game/script2.rpyc:202
translate schinese m12afterchoice2_54d7a6ce:

    # MC "Yeah, I guess you haven't, have you?"
    MC "对，我猜你确实没吃过，对吧？"

# game/script2.rpyc:203
translate schinese m12afterchoice2_afdfeebe:

    # C "You're the best, master!"
    C "主人最棒了！"

# game/script2.rpyc:209
translate schinese m12afterchoice2_12889282:

    # C "[size20small]I'll suck your dick extra hard tonight."
    C "[size20small]今晚我会更加用力地含你的阴茎。"

# game/script2.rpyc:210
translate schinese m12afterchoice2_07f94ae1:

    # MC "!!!" with vpunch
    MC "！！！" with vpunch

# game/script2.rpyc:212
translate schinese m12afterchoice2_b5b7086f:

    # m "Yeesh! It's starting to heat up."
    m "哎呀！开始变热了。"

# game/script2.rpyc:214
translate schinese m12afterchoice2_c2bc4cc6:

    # n "Sup, mom? Come sit with me."
    n "嗨，老妈？过来和我坐。"

# game/script2.rpyc:215
translate schinese m12afterchoice2_f276ba1a:

    # m "Maybe not for long. I'm beginning to cook out here."
    m "可能坐不了多久。我已经开始觉得这里像在户外烹饪了。"

# game/script2.rpyc:217
translate schinese m12afterchoice2_e612037c:

    # m "..."
    m "……"

# game/script2.rpyc:218
translate schinese m12afterchoice2_332e70ba:

    # m "You two are looking comfy..."
    m "你们两个看起来很舒服……"

# game/script2.rpyc:223
translate schinese m12afterchoice2_1388bb6c:

    # MC "One of us looks more comfortable than the other."
    MC "我们俩看起来谁更舒服？"

# game/script2.rpyc:227
translate schinese m12afterchoice2_6a4935a9:

    # n "What's wrong, mom? You're looking kind of bitter about something."
    n "怎么了，老妈？你看起来有点因为什么事而不高兴。"

# game/script2.rpyc:228
translate schinese m12afterchoice2_d49eb1a3:

    # m "It's nothing."
    m "没什么。"

# game/script2.rpyc:229
translate schinese m12afterchoice2_c89c17e5:

    # MC "You sure? I can see it too."
    MC "你确定？我也看出来了。"

# game/script2.rpyc:230
translate schinese m12afterchoice2_20e060a2:

    # m "I said it's nothing."
    m "我说了，没什么。"

# game/script2.rpyc:232
translate schinese m12afterchoice2_d96c17b3:

    # C "*Yawn*"
    C "*哈欠*"

# game/script2.rpyc:233
translate schinese m12afterchoice2_cab83d5c:

    # C "Is it really nothing?"
    C "真的没什么吗？"

# game/script2.rpyc:234
translate schinese m12afterchoice2_7a3fc2c1:

    # m "Let's all just forget about it, okay?!"
    m "我们大家都忘了吧，好吗？！"

# game/script2.rpyc:237
translate schinese m12afterchoice2_6bc3761d:

    # m "Are you working tonight?"
    m "你今晚要工作吗？"

# game/script2.rpyc:238
translate schinese m12afterchoice2_a003ae64:

    # n "Ugh, kill me. I'm working all week."
    n "呃，杀了我吧。我整周都要上班。"

# game/script2.rpyc:239
translate schinese m12afterchoice2_aaff18a8:

    # m "Oof. That's pretty bad. If I was in your shoes I'd ask them to reconsider. I get that they're a small roster, but seven days in a row is almost unfeasible."
    m "哎呀，那可真糟。如果是我，我会让他们重新考虑。我知道他们人手少，但连续七天几乎不可能。"

# game/script2.rpyc:240
translate schinese m12afterchoice2_3fc2fe28:

    # n "It's not all bad. Sure I'll be exhausted, but they don't drag me in for a full week often."
    n "也不全是坏事。虽然我会累死，但他们不会经常整周都把我叫去。"

# game/script2.rpyc:241
translate schinese m12afterchoice2_577e7797:

    # n "I get paid hourly and there are a few benefits."
    n "我是按小时拿钱的，还有几个福利。"

# game/script2.rpyc:244
translate schinese m12afterchoice2_ab0bbf7d:

    # m "Ah. Free drinks. I get it."
    m "啊，免费酒水。我懂了。"

# game/script2.rpyc:247
translate schinese m12afterchoice2_0052248b:

    # n "[size15small]Not just the drinks."
    n "[size15small]不只是酒水。"

# game/script2.rpyc:248
translate schinese m12afterchoice2_42b9a26f:

    # m "Hmm? What?"
    m "嗯？什么？"

# game/script2.rpyc:251
translate schinese m12afterchoice2_867d813b:

    # n "The drinks really help the week pass by more quickly."
    n "酒水确实能让我更快熬过这一周。"

# game/script2.rpyc:252
translate schinese m12afterchoice2_db09f499:

    # m "Do you detox? What about the hangovers?"
    m "你们会排毒吗？宿醉怎么办？"

# game/script2.rpyc:253
translate schinese m12afterchoice2_b35ccce8:

    # MCt "\"Detox\"?"
    MCt "“排毒”？"

# game/script2.rpyc:254
translate schinese m12afterchoice2_83ce5958:

    # n "No, I don't detox, usually. I like to keep the buzz going all the way home."
    n "我通常不排毒。我喜欢一直保持微醺，直到回家。"

# game/script2.rpyc:255
translate schinese m12afterchoice2_eeb04046:

    # n "I may look like a little weakling, but I'm hangover-resistant..."
    n "我看起来可能有点弱不禁风，但我很抗宿醉……"

# game/script2.rpyc:258
translate schinese m12afterchoice2_b2ff7d83:

    # n "Resistant... not immune. I need to be careful, haha..."
    n "抗性……不是免疫。我还是得小心，哈哈……"

# game/script2.rpyc:261
translate schinese m12afterchoice2_c5054701:

    # m "Good for you. My hangover resistance is zero. Maybe even in the negatives."
    m "那你真厉害。我的抗宿醉能力是零，甚至是负数。"

# game/script2.rpyc:262
translate schinese m12afterchoice2_5b4075ce:

    # n "You drink?!"
    n "你喝酒？！"

# game/script2.rpyc:263
translate schinese m12afterchoice2_47ba7d94:

    # m "No."
    m "不。"

# game/script2.rpyc:264
translate schinese m12afterchoice2_4fce450c:

    # m "I'm not against it it's just... I'm more of a social drinker..."
    m "我不是反对，只是……我更属于社交型饮酒者……"

# game/script2.rpyc:265
translate schinese m12afterchoice2_9fee7e18:

    # n "Uh-huh. And you're an anti-social person. It's all coming together."
    n "嗯哼。而且你是个反社交的人。这下都说通了。"

# game/script2.rpyc:268
translate schinese m12afterchoice2_816f3f89:

    # n "Have you ever been drunk?"
    n "你醉过吗？"

# game/script2.rpyc:269
translate schinese m12afterchoice2_6ccaa229:

    # m "Of course, I've been drunk. How else am I supposed to know about my hangover resistance?"
    m "当然醉过。不然我怎么会知道自己的抗宿醉能力？"

# game/script2.rpyc:270
translate schinese m12afterchoice2_e2251eaf:

    # n "Ah, good point."
    n "啊，有道理。"

# game/script2.rpyc:271
translate schinese m12afterchoice2_b3bb1bbd:

    # n "Then how about when was the last time you were drunk?"
    n "那你上次喝醉是什么时候？"

# game/script2.rpyc:272
translate schinese m12afterchoice2_33175648:

    # n "I'm starting to suspect it predates me."
    n "我开始怀疑那是在我出生前。"

# game/script2.rpyc:273
translate schinese m12afterchoice2_739e156f:

    # m "Not {i}that{/i} long ago."
    m "没{i}那么{/i}久以前。"

# game/script2.rpyc:274
translate schinese m12afterchoice2_7e2a86e6:

    # m "Though it {i}was{/i} by accident. I got carried away when digging into my private stash."
    m "不过那次是{i}意外{/i}。我翻找自己的私藏时喝过头了。"

# game/script2.rpyc:275
translate schinese m12afterchoice2_ac8fd242:

    # m "Paralyzed for the whole next day."
    m "第二天一整天都瘫痪了。"

# game/script2.rpyc:276
translate schinese m12afterchoice2_9b340f7b:

    # n "Hmm, it's a shame you didn't have a resident detoxer."
    n "嗯，真可惜你没有一个随叫随到的排毒员。"

# game/script2.rpyc:277
translate schinese m12afterchoice2_e9c00cf7:

    # m "Three Dull kids leaves me with slim pickings."
    m "三个无趣孩子让我没什么可选的。"

# game/script2.rpyc:280
translate schinese m12afterchoice2_3207d916:

    # n "Hey, dumbass."
    n "喂，白痴。"

# game/script2.rpyc:281
translate schinese m12afterchoice2_89a51588:

    # n "Why did you pretend to suck at magic for so long instead of protecting my dear mother from a headache?"
    n "你为什么要假装自己不会魔法那么久，而不是保护我亲爱的妈妈别让她头疼？"

# game/script2.rpyc:282
translate schinese m12afterchoice2_d3f21bcd:

    # MC "I mean, I didn't live with you guys every day. I appreciated the sleepovers, but I had my own home to live in."
    MC "我的意思是我不是每天都和你们住在一起。我很珍惜那些留宿，但我也有自己的家。"

# game/script2.rpyc:283
translate schinese m12afterchoice2_e122f649:

    # MC "And besides..."
    MC "而且……"

# game/script2.rpyc:286
translate schinese m12afterchoice2_c3f78cf4:

    # MC "I {i}did{/i} suck at magic."
    MC "我{i}确实{/i}不会魔法。"

# game/script2.rpyc:287
translate schinese m12afterchoice2_603e49a2:

    # MC "We've been over this, haven't we? Couldn't control it, sudden surge, private tutor..."
    MC "我们已经说过很多次了，不是吗？无法控制、突然爆发、私人导师……"

# game/script2.rpyc:288
translate schinese m12afterchoice2_26ced765:

    # n "We've never seen this \"private tutor\". Does he {i}really{/i} exist?"
    n "我们从来没见过这个“私人导师”。他真的{i}存在吗{/i}？"

# game/script2.rpyc:289
translate schinese m12afterchoice2_f46e9924:

    # n "Where's the evidence?"
    n "证据呢？"

# game/script2.rpyc:290
translate schinese m12afterchoice2_03dfdb00:

    # MC "Are you just eager to form a new conspiracy theory? What about your bar? Does {i}that{/i} really exist?"
    MC "你只是急着编出一个新阴谋论吗？那你的酒吧呢？那个真的{i}存在吗{/i}？"

# game/script2.rpyc:293
translate schinese m12afterchoice2_aa1dfe4d:

    # C "You've met Stella, haven't you?"
    C "你见过斯特拉了，对吧？"

# game/script2.rpyc:294
translate schinese m12afterchoice2_d81950e4:

    # n "I think Stella's the real private tutor."
    n "我觉得斯特拉才是真正的私人导师。"

# game/script2.rpyc:297
translate schinese m12afterchoice2_d7dc63c8:

    # MC "I sincerely wish that was the case. Don't get me wrong, his exposition and ability to deduce your shortcomings is incredible... it's just..."
    MC "我真心希望是这样。别误会，他的讲解和推断你弱点的能力简直惊人……只是……"

# game/script2.rpyc:298
translate schinese m12afterchoice2_3c287332:

    # MC "Being taught by Stella makes me want to live more than it makes me want to die."
    MC "被斯特拉教导让我想活下去，而不是想死。"

# game/script2.rpyc:301
translate schinese m12afterchoice2_b1dbb361:

    # m "You barely complain about him as much as you used to."
    m "你以前没那么多抱怨他了。"

# game/script2.rpyc:302
translate schinese m12afterchoice2_ea02ea32:

    # m "It reminded me of when you all were kids, and you'd come back after a bad day at school."
    m "这让我想起你们小时候的样子：放学回家时心情很差。"

# game/script2.rpyc:305
translate schinese m12afterchoice2_f401b620:

    # MC "Yeah... Uh... His teaching style is still miserable to sit through..."
    MC "对……呃……他的教学风格还是让人很难熬……"

# game/script2.rpyc:308
translate schinese m12afterchoice2_d8bca384:

    # MC "But he's started being a lot nicer to me for some reason."
    MC "但不知为什么，他最近对我友善多了。"

# game/script2.rpyc:309
translate schinese m12afterchoice2_80ed46eb:

    # MC "All of a sudden,"
    MC "突然之间，"

# game/script2.rpyc:310
translate schinese m12afterchoice2_8e832e89:

    # MC "Whenever I show up there he wants me to make myself feel at home."
    MC "每次我去那里，他都希望我把它当成自己家。"

# game/script2.rpyc:311
translate schinese m12afterchoice2_586d6f30:

    # MC "He fixes me drinks, offers to cook for me, asks if I want to hang out after sessions."
    MC "给我调酒、主动做饭、问我要不要训练后一起玩。"

# game/script2.rpyc:312
translate schinese m12afterchoice2_400366d5:

    # MC "He even looks sad whenever I leave."
    MC "甚至我离开时，他还会露出伤心的表情。"

# game/script2.rpyc:315
translate schinese m12afterchoice2_29cf5cbc:

    # n "Hmm..." (multiple=2)
    n "嗯……" (multiple=2)

# game/script2.rpyc:316
translate schinese m12afterchoice2_a9a230e9:

    # m "Hmm..." (multiple=2)
    m "嗯……" (multiple=2)

# game/script2.rpyc:321
translate schinese m12afterchoice2_bca95781:

    # n "[name] has seduced his teacher."
    n "[name]勾引了自己的老师。"

# game/script2.rpyc:336
translate schinese m12afterchoice2_f0365fe4:

    # m "Uh... Yeah! That's one of the possibilities!"
    m "呃……对！这也是可能性之一！"

# game/script2.rpyc:337
translate schinese m12afterchoice2_dd51d2bf:

    # m "I didn't consider that one."
    m "我没想到这个。"

# game/script2.rpyc:342
translate schinese m12afterchoice2_e940839e:

    # m "Good thinking, Noelle."
    m "想得好，诺艾尔。"

# game/script2.rpyc:343
translate schinese m12afterchoice2_e53b5286:

    # m "But maybe you should entertain the other options first."
    m "不过，也许你应该先考虑其他可能性。"

# game/script2.rpyc:344
translate schinese m12afterchoice2_b8b26a31:

    # n "But I've already run out of ideas!"
    n "可我已经想不出别的了！"

# game/script2.rpyc:347
translate schinese m12afterchoice2_a455e844:

    # m "It's gotta have something to do with Cadence being close with Stella, right?"
    m "肯定和凯登丝跟斯特拉关系亲近有关，对吧？"

# game/script2.rpyc:348
translate schinese m12afterchoice2_f4975d96:

    # m "He's probably grateful to [name] for bringing her a friend."
    m "他大概感谢[name]给她带来了朋友。"

# game/script2.rpyc:351
translate schinese m12afterchoice2_c8d63367:

    # MC "I've got no clue. As I said, it was an overnight transformation."
    MC "我完全不知道。就像我说的，一夜之间变了。"

# game/script2.rpyc:352
translate schinese m12afterchoice2_265b7827:

    # MC "It eases the pressure of going over there, though."
    MC "不过这样我去那里时压力小多了。"

# game/script2.rpyc:355
translate schinese m12afterchoice2_b61e5f4c:

    # C "He's nice to {i}me{/i}."
    C "他对{i}我{/i}很好。"

# game/script2.rpyc:356
translate schinese m12afterchoice2_59509156:

    # C "Maybe Miya's theory is correct."
    C "也许米娅的推测是对的。"

# game/script2.rpyc:357
translate schinese m12afterchoice2_c52331c7:

    # n "You've met him?"
    n "你见过他了？"

# game/script2.rpyc:358
translate schinese m12afterchoice2_816dc5e6:

    # C "I mean... I {i}do{/i} meet up with Stella every now and then."
    C "我是说……我{i}确实{/i}偶尔会和斯特拉见面。"

# game/script2.rpyc:359
translate schinese m12afterchoice2_eab4d71c:

    # m "And what's your take on him?"
    m "你觉得他怎么样？"

# game/script2.rpyc:362
translate schinese m12afterchoice2_b5af3f5d:

    # C "He's really open and friendly. With both of us."
    C "他很坦率，也很好相处。对我们两个都是。"

# game/script2.rpyc:363
translate schinese m12afterchoice2_ae131916:

    # C "He's kind of like a goofy dad."
    C "他有点像一个傻乎乎的爸爸。"

# game/script2.rpyc:366
translate schinese m12afterchoice2_1b658b4e:

    # MC "You didn't see him before."
    MC "你没见过他以前的样子。"

# game/script2.rpyc:367
translate schinese m12afterchoice2_95093613:

    # MC "He'd have killed me if I called him a goofy dad."
    MC "要是我说他像傻爸爸，他肯定会杀了了我。"

# game/script2.rpyc:368
translate schinese m12afterchoice2_0cc71030:

    # MC "Now I'm starting to think that calling him \"dad\" would bring him joy."
    MC "现在我开始觉得叫他“爸爸”会让他开心。"

# game/script2.rpyc:371
translate schinese m12afterchoice2_4ccf97ef:

    # n "Speaking of dramatic changes."
    n "说到这种戏剧性的变化。"

# game/script2.rpyc:372
translate schinese m12afterchoice2_21cff316:

    # n "How's your body holding up, Cadence?"
    n "你的身体撑得住吗，凯登丝？"

# game/script2.rpyc:375
translate schinese m12afterchoice2_24674698:

    # C "I feel stronger than ever."
    C "我感觉比以前任何时候都强。"

# game/script2.rpyc:376
translate schinese m12afterchoice2_af0b80b9:

    # C "Quality food, ample rest."
    C "优质食物，充足休息。"

# game/script2.rpyc:377
translate schinese m12afterchoice2_f91b8c35:

    # C "I'm back in my prime!"
    C "我重回巅峰了！"

# game/script2.rpyc:386
translate schinese m12afterchoice2_dd235bd5:

    # n "Oh? Care to put that to the test?"
    n "哦？要不要检验一下？"

# game/script2.rpyc:387
translate schinese m12afterchoice2_6e4bfc58:

    # n "Don't be scared, now."
    n "现在别害怕。"

# game/script2.rpyc:388
translate schinese m12afterchoice2_dc686db6:

    # n "I'm just little Ol' Noelle."
    n "我只是小诺艾尔而已。"

# game/script2.rpyc:391
translate schinese m12afterchoice2_aada8888:

    # C "Huh?"
    C "嗯？"

# game/script2.rpyc:392
translate schinese m12afterchoice2_311fd48f:

    # C "You want to arm-wrestle?"
    C "你想扳手腕？"

# game/script2.rpyc:393
translate schinese m12afterchoice2_445a1af1:

    # n "It's a health inspection. I need to gauge your strength."
    n "这是健康检查。我需要评估你的力量。"

# game/script2.rpyc:394
translate schinese m12afterchoice2_4b469229:

    # C "I'm good."
    C "我很好。"

# game/script2.rpyc:397
translate schinese m12afterchoice2_75086bf6:

    # MC "[size10small]Do it. It'll be funny."
    MC "[size10small]来吧。会很搞笑的。"

# game/script2.rpyc:398
translate schinese m12afterchoice2_02cc7160:

    # C "[size10small]I can't imagine it being {i}that{/i} funny."
    C "[size10small]我无法想象那会有{i}那么{/i}好笑。"

# game/script2.rpyc:399
translate schinese m12afterchoice2_2a403400:

    # MC "[size10small]Trust me. Humor her."
    MC "[size10small]相信我。逗她笑。"

# game/script2.rpyc:400
translate schinese m12afterchoice2_ba43de38:

    # C "[size10small]I'm not exactly good at arm-wrestling. And she looks pretty confident."
    C "[size10small]我不太擅长扳手腕。而且她看起来很有信心。"

# game/script2.rpyc:401
translate schinese m12afterchoice2_c4a6a94f:

    # MC "[size10small]Trust me."
    MC "[size10small]相信我。"

# game/script2.rpyc:402
translate schinese m12afterchoice2_26a803bc:

    # C "..."
    C "……"

# game/script2.rpyc:403
translate schinese m12afterchoice2_48903488:

    # C "*Sigh*"
    C "*叹气*"

# game/script2.rpyc:404
translate schinese m12afterchoice2_abc89086:

    # C "[size10small]If you say so, master."
    C "[size10small]既然你这么说，主人。"

# game/script2.rpyc:413
translate schinese m12afterchoice2_48903488_1:

    # C "*Sigh*"
    C "*叹气*"

# game/script2.rpyc:414
translate schinese m12afterchoice2_53748675:

    # C "Please go easy on me."
    C "请对我手下留情。"

# game/script2.rpyc:417
translate schinese m12afterchoice2_0608ff9c:

    # n "Not a chance!"
    n "想得美！"

# game/script2.rpyc:420
translate schinese m12afterchoice2_7f402509:

    # m "Here we go again."
    m "又来了。"

# game/script2.rpyc:421
translate schinese m12afterchoice2_19869222:

    # MC "Moving over here to get a better view?"
    MC "你搬到这里是为了看得更清楚？"

# game/script2.rpyc:422
translate schinese m12afterchoice2_bce1181d:

    # m "It's one of my favorite shows."
    m "这是我最喜欢的节目之一。"

# game/script2.rpyc:425
translate schinese m12afterchoice2_1532b66b:

    # C "Just so you know; I don't think I've won one of these in my entire life."
    C "先说好，我好像从来没赢过这种比赛。"

# game/script2.rpyc:426
translate schinese m12afterchoice2_c572dcbf:

    # n "Why so reluctant, Cadence? Are you trying to lull me into a false sense of security?"
    n "凯登丝，怎么这么不情愿？你是想让我放松警惕吗？"

# game/script2.rpyc:427
translate schinese m12afterchoice2_06b93531:

    # n "It won't work. I'm going a hundred percent!"
    n "没用的。我会全力以赴！"

# game/script2.rpyc:430
translate schinese m12afterchoice2_f04781c2:

    # n "Brace yourself, kitten."
    n "做好准备吧，小猫。"

# game/script2.rpyc:451
translate schinese m12afterchoice2_c099d25a:

    # n "Oww..."
    n "好痛……"

# game/script2.rpyc:458
translate schinese m12afterchoice2_6a95e1a8:

    # C "Was that supposed to happen?!"
    C "这本来应该发生吗？！"

# game/script2.rpyc:471
translate schinese m12afterchoice2_2c67d69f:

    # m "It's been Noelle's dream to win an arm-wrestling contest for as long as I can remember."
    m "从我记事起，诺艾尔就梦想赢得扳手腕比赛。"

# game/script2.rpyc:472
translate schinese m12afterchoice2_bc149286:

    # C "So all of that confidence was..."
    C "所以那些自信都是……"

# game/script2.rpyc:473
translate schinese m12afterchoice2_a5f6c618:

    # MC "Wishful thinking."
    MC "一厢情愿。"

# game/script2.rpyc:474
translate schinese m12afterchoice2_ab010729:

    # MC "She didn't even underestimate you or anything."
    MC "她甚至根本没低估你之类的。"

# game/script2.rpyc:475
translate schinese m12afterchoice2_c3652620:

    # MC "She's just {i}that{/i} weak."
    MC "她就是{i}这么{/i}弱。"

# game/script2.rpyc:478
translate schinese m12afterchoice2_99047055:

    # m "C'mon, Noelle. Let's get you back up."
    m "来吧，诺艾尔。我们把你拉起来。"

# game/script2.rpyc:481
translate schinese m12afterchoice2_84479406:

    # m "You did your best."
    m "你已经尽力了。"

# game/script2.rpyc:482
translate schinese m12afterchoice2_8891fe46:

    # m "Cadence, can you give me a hand? I think she's stuck under something."
    m "凯登丝，能帮我一下吗？我觉得她被什么东西压住了。"

# game/script2.rpyc:483
translate schinese m12afterchoice2_30cc5afb:

    # C "I'll try, but I'm not great at heavy lifting."
    C "我试试，不过我不擅长搬重物。"

# game/script2.rpyc:484
translate schinese m12afterchoice2_0dd08b9a:

    # m "Nonsense. You're the arm-wrestling champion."
    m "别胡说。你可是扳手腕冠军。"

# game/script2.rpyc:489
translate schinese m12afterchoice2_f82558c1:

    # n "Waaah! I lost again!"
    n "哇啊！我又输了！"

# game/script2.rpyc:490
translate schinese m12afterchoice2_143ff7a2:

    # n "Why do I keep losing?"
    n "为什么我总是输？"

# game/script2.rpyc:491
translate schinese m12afterchoice2_0c92fa95:

    # C "The only thing you're losing right now is blood pressure unless we upright you."
    C "你现在唯一会失去的只有血压，除非我们把你扶起来。"

# game/script2.rpyc:494
translate schinese m12afterchoice2_388f8ad2:

    # n "Are you taking pleasure in this?"
    n "你觉得这样很有趣吗？"

# game/script2.rpyc:495
translate schinese m12afterchoice2_c5f1a96e:

    # C "I didn't do this to you out of spite. I did it to you out of... moving my arm... a little bit."
    C "我这么做不是因为讨厌你。只是因为……我的手臂稍微动了一下。"

# game/script2.rpyc:500
translate schinese m12afterchoice2_9893a80f:

    # m "Ugh. I don't even understand the physics of how you got into this situation."
    m "呃。我都不明白你怎么会陷入这种状况的。"

# game/script2.rpyc:501
translate schinese m12afterchoice2_9cb51b5c:

    # n "Oww! Be gentle!"
    n "好痛！轻点！"

# game/script2.rpyc:502
translate schinese m12afterchoice2_24843d99:

    # C "I don't think gentle is going to cut it."
    C "我觉得再温柔也不管用了。"

# game/script2.rpyc:503
translate schinese m12afterchoice2_f5d76a55:

    # C "Seriously, we need some kind of lubricant or something."
    C "说真的，我们需要点什么润滑剂之类的。"

# game/script2.rpyc:504
translate schinese m12afterchoice2_dc0f5e8a:

    # n "Oh, I've got plenty of lube in my bedside cabinet!"
    n "哦，我床头柜里有很多润滑液！"

# game/script2.rpyc:505
translate schinese m12afterchoice2_e26c69ed:

    # C "..." (multiple=2)
    C "……" (multiple=2)

# game/script2.rpyc:506
translate schinese m12afterchoice2_7317b50f:

    # m "..." (multiple=2)
    m "……" (multiple=2)

# game/script2.rpyc:524
translate schinese m12afterchoice2_18da8c79:

    # MC "Sup?" with vpunch
    MC "嗨？" with vpunch

# game/script2.rpyc:527
translate schinese m12afterchoice2_2d7b2929:

    # g "Remember that big swim meet I talked about?"
    g "还记得我说过的那场大型游泳比赛吗？"

# game/script2.rpyc:528
translate schinese m12afterchoice2_2d204a49:

    # MC "..."
    MC "……"

# game/script2.rpyc:529
translate schinese m12afterchoice2_e7328dcf:

    # MC "Oh, you asked me if you should go train with your team and I told you to..."
    MC "哦，你问我要不要和队伍一起训练，我告诉你……"

# game/script2.rpyc:536
translate schinese m12choice3_1_625f1a39:

    # g "Wow. When you make important decisions about someone else's life it's usually a good idea to remember them."
    g "哇。替别人人生做重要决定时，通常最好记住这件事。"

# game/script2.rpyc:538
translate schinese m12choice3_1_5019dd44:

    # g "That's right."
    g "没错。"

# game/script2.rpyc:544
translate schinese m12choice3_2_625f1a39:

    # g "Wow. When you make important decisions about someone else's life it's usually a good idea to remember them."
    g "哇。替别人人生做重要决定时，通常最好记住这件事。"

# game/script2.rpyc:546
translate schinese m12choice3_2_5019dd44:

    # g "That's right."
    g "没错。"

# game/script2.rpyc:551
translate schinese m12afterchoice3_a524e266:

    # g "It was a pretty good idea, too."
    g "而且那也是个相当棒的主意。"

# game/script2.rpyc:552
translate schinese m12afterchoice3_5515f24f:

    # g "I mean, I was always in top form, obviously."
    g "我的意思是，我当然一直状态都很好。"

# game/script2.rpyc:553
translate schinese m12afterchoice3_9669ce2b:

    # g "But yeah, there was some sloppiness amongst the other girls."
    g "不过，其他女孩确实有些马虎。"

# game/script2.rpyc:554
translate schinese m12afterchoice3_ca8b6841:

    # g "I had to give them a few pointers on their forms and shit."
    g "我得在动作之类的事情上给她们几个建议。"

# game/script2.rpyc:556
translate schinese m12afterchoice3_548e6f8a:

    # g "It's been a while since I ate two tubs of ice cream in one night."
    g "我已经很久没在一晚上吃掉两盒冰淇淋了。"

# game/script2.rpyc:557
translate schinese m12afterchoice3_b05cd587:

    # MC "We both lost our battles against the food comas that day."
    MC "那天，我们都败给了那场美食催出的昏睡。"

# game/script2.rpyc:558
translate schinese m12afterchoice3_c13e9483:

    # MC "I think I lost harder than you did."
    MC "我觉得我输得比你还惨。"

# game/script2.rpyc:559
translate schinese m12afterchoice3_e1dcd3f4:

    # MC "I only had one and a half tubs before I succumbed to the lassitude."
    MC "我只吃了一盒半就输给那股懒意了。"

# game/script2.rpyc:560
translate schinese m12afterchoice3_9e4fd9ed:

    # g "Mmhm. Both of us sleeping on the floor. I think that's how about forty percent of our nights end."
    g "嗯。我们俩都睡在地板上。我觉得我们大约有百分之四十的夜晚都是这样结束的。"

# game/script2.rpyc:561
translate schinese m12afterchoice3_e676ec74:

    # MC "Not if I can help it. Your floor hurts my ass."
    MC "如果我能帮上忙，就不会这样了。你的地板硌得我屁股疼。"

# game/script2.rpyc:562
translate schinese m12afterchoice3_283b177b:

    # MC "Were you out for the {i}whole{/i} night?"
    MC "你整晚都{i}没醒{/i}？"

# game/script2.rpyc:563
translate schinese m12afterchoice3_1532beef:

    # g "Yep. A full night's rest."
    g "对。睡了一整晚。"

# game/script2.rpyc:564
translate schinese m12afterchoice3_eee7771f:

    # MC "Shit, I was back awake after like, twenty minutes. Saw you running in your sleep like a dreaming dog and decided it was time for me to return to my own room."
    MC "操，我大概二十分钟后就醒了。看见你像做梦的狗一样梦里跑步，就决定该回自己房间了。"

# game/script2.rpyc:567
translate schinese m12afterchoice3_b801b16e:

    # g "I run in my sleep?"
    g "我睡觉会跑步？"

# game/script2.rpyc:568
translate schinese m12afterchoice3_5a087e63:

    # MC "You did {i}that{/i} night. Might be related to your blood sugar levels."
    MC "你那晚确实{i}就是{/i}这样。可能和你的血糖水平有关。"

# game/script2.rpyc:569
translate schinese m12afterchoice3_de9818d1:

    # g "Maybe I was dreaming about something."
    g "也许我是在做梦。"

# game/script2.rpyc:570
translate schinese m12afterchoice3_b6846225:

    # g "Anyway-"
    g "总之——"

# game/script2.rpyc:573
translate schinese m12afterchoice3_02b4f493:

    # g "That swim meet starts in like, two-and-a-half hours."
    g "游泳比赛还有大概两个半小时开始。"

# game/script2.rpyc:576
translate schinese m12afterchoice3_6eacaacf:

    # g "And I'd {i}really{/i} like to bring along my little emotional support [name]."
    g "而且我{i}真的{/i}想带上我的小小情绪支持[name]。"

# game/script2.rpyc:577
translate schinese m12afterchoice3_2d204a49:

