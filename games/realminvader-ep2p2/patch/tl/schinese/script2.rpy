    ph "啊。以前带过团队吗？"

# game/script2.rpyc:8916
translate schinese m16choice8_2_3cabdcdb:

    # MC "Nope, just a hint of cynicism in my veins."
    MC "不，我骨子里只是带了点愤世嫉俗罢了。"

