translate schinese ft18end_2_4f8b924b:

    # tea "It's bad enough you're failing at every subject, you could try to not fail at timekeeping too."
    tea "每门课都不及格已经够糟糕了，至少在守时这方面别再不及格了吧。"

# game/script2.rpyc:11638
translate schinese ft18end_2_bb2cf764:

    # n "..."
    n "……"

