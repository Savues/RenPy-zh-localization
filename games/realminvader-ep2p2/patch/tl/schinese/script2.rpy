translate schinese m14choice2_1_a493f4a1:

    # g "Hmm... and what features would a better version of me have?"
    g "嗯……那“升级版”的我会有什么功能呢？"

# game/script2.rpyc:4997
translate schinese m14choice2_1_4e789ab4:

    # MC "Nipple lasers."
    MC "乳头激光炮。"

# game/script2.rpyc:5000
translate schinese m14choice2_1_5c5cbccb:

