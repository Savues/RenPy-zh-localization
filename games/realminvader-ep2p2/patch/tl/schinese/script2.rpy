    # n "..."
    n "……"

# game/script2.rpyc:5984
translate schinese m14choice14_1_b07a7006:

    # n "What?"
    n "什么？"

# game/script2.rpyc:5985
translate schinese m14choice14_1_48400597:

    # nt "I just wanted to spend time with him..."
    nt "我只是想和他待在一起……"

# game/script2.rpyc:5986
translate schinese m14choice14_1_bb2cf764_1:

    # n "..."
    n "……"

# game/script2.rpyc:5987
translate schinese m14choice14_1_f7f04a8a:

    # n "Does he care about me so little?"
    n "难道他一点也不在乎我吗？"

