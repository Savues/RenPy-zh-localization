# game/script2.rpyc:4185
translate schinese m13afterfreda_9edd61ed:

    # MC "How is everyone?"
    MC "大家怎么样？"

# game/script2.rpyc:4187
translate schinese m13afterfreda_a966b340:

    # v "Over the moon, you'll be glad to hear."
    v "你听了肯定会高兴，大家都乐坏了。"

# game/script2.rpyc:4189
translate schinese m13afterfreda_28605346:

    # v "Fantastic losers. Graceful in defeat. They know there's a next time."
    v "输得非常棒。输得很有风度。他们知道还有下一次机会。"

# game/script2.rpyc:4190
translate schinese m13afterfreda_f5c12db9:

    # MC "Speaking of Grace..."
    MC "说到格蕾丝……"

# game/script2.rpyc:4192
translate schinese m13afterfreda_e4294647:

    # v "Go ahead and see her. I'm sure she wants to vomit her thoughts all over you."
    v "去见见她吧。我敢肯定，她想把满脑子的想法一股脑儿全倾倒给你。"

# game/script2.rpyc:4193
translate schinese m13afterfreda_84be62da:

    # MC "Interesting choice of words... I'm not sure I'm a fan of them."
    MC "措辞挺有意思……不过我不太喜欢。"

# game/script2.rpyc:4194
translate schinese m13afterfreda_3c50dca3:

    # v "You should know by now that I'm not the best at choosing their words."
    v "你早该知道，我这人不太擅长措辞。"

# game/script2.rpyc:4195
translate schinese m13afterfreda_30fa4a84:

    # v "Go ahead, I'll watch from the sidelines."
    v "请便，我就在旁边看着。"

# game/script2.rpyc:4204
translate schinese m13afterfreda_8226ef3d:

    # v "I believe you've put her in a vegetative state."
    v "我看你是把她弄成植物人了。"

# game/script2.rpyc:4205
translate schinese m13afterfreda_e503a09f:

    # MC "She's fine. I held back."
    MC "她没事。我手下留情了。"

# game/script2.rpyc:4206
translate schinese m13afterfreda_5a791b3a:

    # v "{i}That's{/i} holding back?"
    v "{i}这也叫{/i}手下留情？"

# game/script2.rpyc:4207
translate schinese m13afterfreda_67ae43b4:

    # v "Remind me not to upset you, lest I incur your magical wrath."
    v "我得提醒自己别惹你生气，免得招来你那魔法般的怒火。"

# game/script2.rpyc:4208
translate schinese m13afterfreda_a78edc93:

    # MC "I think my magical wrath is prohibited by the Geneva convention. If I'm honest, my head's still a little fuzzy from the earlier calming spell."
    MC "我想我的魔法怒火大概违反了《日内瓦公约》吧。老实说，刚才那个镇静咒弄得我现在脑子还有点晕乎乎的。"

# game/script2.rpyc:4216
translate schinese m13afterfreda_a6dd8f6c:

    # MC "Hello?! Grace."
    MC "喂？！格蕾丝。"

# game/script2.rpyc:4217
translate schinese m13afterfreda_911b9c79:

    # MC "Event's over. You can do stuff now."
    MC "事件结束了。你现在可以做别的事了。"

# game/script2.rpyc:4220
translate schinese m13afterfreda_4b340443_5:

    # g "..."
    g "……"

# game/script2.rpyc:4221
translate schinese m13afterfreda_1d302703:

    # g "Do stuff?"
    g "做别的事？"

# game/script2.rpyc:4222
translate schinese m13afterfreda_aac481f3:

    # g "Like what?"
    g "比如什么？"

# game/script2.rpyc:4223
translate schinese m13afterfreda_f7a94154:

    # MC "Told you, Vineeta. The effect is waning."
    MC "跟你说过了，维妮塔，药效正在减退。"

# game/script2.rpyc:4224
translate schinese m13afterfreda_631794f5:

    # v "How long has it been?! You can't seriously be trying to convince me that this is a gentle application of the soothing spell."
    v "都过去多久了？！你该不会是想告诉我，这就是那种温和的安抚咒吧？"

# game/script2.rpyc:4225
translate schinese m13afterfreda_82c9dfcb:

    # g "What kind of stuff should I do?"
    g "我该做些什么呢？"

# game/script2.rpyc:4226
translate schinese m13afterfreda_227f716b:

    # MC "For starters, you're the only person here still in their swimsuit."
    MC "首先，这里只有你还穿着泳衣。"

# game/script2.rpyc:4227
translate schinese m13afterfreda_a8a401aa:

    # MC "You can go change out of your clothes, and we can go home together."
    MC "你可以去换下泳衣，然后我们一起回家。"

# game/script2.rpyc:4228
translate schinese m13afterfreda_976510f3:

    # MC "Or celebrate if that's what you're into."
    MC "或者如果你愿意的话，也可以庆祝一下。"

# game/script2.rpyc:4229
translate schinese m13afterfreda_a6eec111:

    # g "Change out of my clothes..."
    g "换下泳衣……"

# game/script2.rpyc:4230
translate schinese m13afterfreda_f10ae7fd:

    # g "Together..."
    g "一起……"

# game/script2.rpyc:4231
translate schinese m13afterfreda_b2c974f4:

    # g "Okay..."
    g "好吧……"

# game/script2.rpyc:4236
translate schinese m13afterfreda_b4704ea7:

    # MC "Grace?! What are you doing?"
    MC "格蕾丝？！你在干什么？"

# game/script2.rpyc:4237
translate schinese m13afterfreda_396b36e8:

    # MC "Grace you're kinda hurting my hand a little, could you let up?"
    MC "格蕾丝，你抓得我手有点疼，能松点劲吗？"

# game/script2.rpyc:4238
translate schinese m13afterfreda_fe7612b4:

    # v "Have fun, you two."
    v "祝你们玩得开心。"

# game/script2.rpyc:4239
translate schinese m13afterfreda_2dc15276:

    # MC "What fun?! She's crushing my hand! Help me!"
    MC "玩什么开心啊？！她快把我的手捏碎了！救命啊！"

# game/script2.rpyc:4240
translate schinese m13afterfreda_33fd1653:

    # v "Hmm... Looks too dangerous. Don't resist her and you should be okay."
    v "嗯……看起来太危险了。别反抗她，应该就没事。"

# game/script2.rpyc:4244
translate schinese m13afterfreda_7f208eaa:

    # MC "Hmm?"
    MC "嗯？"

# game/script2.rpyc:4247
translate schinese m13afterfreda_f0507347:

    # kidg "Hey, boss, what're we gonna do? We's ruined I tell ya'. Ruined!"
    kidg "嘿，老大，我们该怎么办？我们完蛋了，我跟你说，彻底完蛋了！"

# game/script2.rpyc:4248
translate schinese m13afterfreda_45b49d12:

    # kidgo "Ey, I dunno about this one, boss."
    kidgo "哎，这事儿我可拿不准啊，老大。"

# game/script2.rpyc:4249
translate schinese m13afterfreda_578f627d:

    # kidb "Can it! Both a' youse!"
    kidb "都给我闭嘴！你们两个！"

# game/script2.rpyc:4263
translate schinese m13afterfreda_4b340443_6:

    # g "..."
    g "……"

# game/script2.rpyc:4264
translate schinese m13afterfreda_0c66a294:

    # g "You're not a swimmer."
    g "你算什么游泳选手。"

# game/script2.rpyc:4265
translate schinese m13afterfreda_4b340443_7:

    # g "..."
    g "……"

# game/script2.rpyc:4266
translate schinese m13afterfreda_e85c1c9f:

    # g "[name]? What are you...?"
    g "[name]？你这是……？"

# game/script2.rpyc:4267
translate schinese m13afterfreda_4e346775:

    # MCt "There it is. The spell is wearing off."
    MCt "就是这个。魔法正在失效。"

# game/script2.rpyc:4268
translate schinese m13afterfreda_9f515a91:

    # MC "Just making sure you're okay. I'll wait outside for you."
    MC "只是确认一下你没事。我在外面等你。"

# game/script2.rpyc:4270
translate schinese m13afterfreda_4a0516e9:

    # g "Hurry up."
    g "快点。"

# game/script2.rpyc:4271
translate schinese m13afterfreda_19570c32:

    # MC "What?"
    MC "什么？"

# game/script2.rpyc:4272
translate schinese m13afterfreda_2d9afa4d:

    # g "Stop wasting time."
    g "别浪费时间了。"

# game/script2.rpyc:4275
translate schinese m13afterfreda_2d204a49_8:

    # MC "..."
    MC "……"

# game/script2.rpyc:4276
translate schinese m13afterfreda_095f24e9:

    # MCt "Wh-... What?"
    MCt "什……什么？"

# game/script2.rpyc:4277
translate schinese m13afterfreda_be6bd903:

    # MCt "Do I need to be doing something?"
    MCt "我需要做什么吗？"

# game/script2.rpyc:4278
translate schinese m13afterfreda_16d946f4:

    # MCt "Leaving, right? I should be leaving."
    MCt "要走了，对吧？我该走了。"

# game/script2.rpyc:4279
translate schinese m13afterfreda_e51090c1:

    # MCt "I need to practice that calming spell... It worked out in the end but... God- damn..."
    MCt "我得练练那个镇静咒……虽然最后成功了，但是……该死……"

# game/script2.rpyc:4280
translate schinese m13afterfreda_dc0a25c5:

    # MCt "Sedated Grace is kinda scary... Or more so, it's scary that I can do that to someone..."
    MCt "被镇静后的格蕾丝有点可怕……或者更确切地说，我竟然能对别人做这种事，这挺可怕的……"

# game/script2.rpyc:4281
translate schinese m13afterfreda_8f129966:

    # MCt "I know I'm strong but, maybe it's because she's dull?"
    MCt "我知道我很强，但……也许是因为她反应迟钝？"

# game/script2.rpyc:4282
translate schinese m13afterfreda_4f14b277:

    # g "Come on!"
    g "快来！"

# game/script2.rpyc:4283
translate schinese m13afterfreda_2d204a49_9:

    # MC "..."
    MC "……"

# game/script2.rpyc:4287
translate schinese m13replay2_002b3025:

    # g "Get over here! You can help me out!"
    g "过来！你可以帮我个忙！"

# game/script2.rpyc:4288
translate schinese m13replay2_2a70215b:

    # MC "Help her out? With what?"
    MC "帮她个忙？用什么？"

# game/script2.rpyc:4301
translate schinese m13replay2_cff36c9c:

    # g "Could you wash my back?"
    g "你能帮我洗洗背吗？"

# game/script2.rpyc:4304
translate schinese m13replay2_53dc662a:

    # g "For fuck's sake, [name]. Why are you still wearing your clothes?"
