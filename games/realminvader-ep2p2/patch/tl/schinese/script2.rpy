translate schinese m14choice14_1_0cc14fce:

    # MC "It was nice talking to you, Noelle. But I've gotta dash!"
    MC "很高兴和你聊天，诺艾尔。但我得赶紧走了！"

# game/script2.rpyc:5979
translate schinese m14choice14_1_08639f8e:

    # MC "See ya!"
    MC "回头见！"

# game/script2.rpyc:5980
translate schinese m14choice14_1_d590877b:

    # n "Wha-?"
    n "什——？"

# game/script2.rpyc:5981
