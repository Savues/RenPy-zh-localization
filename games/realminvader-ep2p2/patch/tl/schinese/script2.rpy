    # g "I've given you plenty of time to prepare. I've been telling you for days."
    g "我给了你很多时间准备。我已经告诉你好几天了。"

# game/script2.rpyc:599
translate schinese m12afterchoice3_c6eb333e:

    # n "Hey, [name]. Look at this YouTube channel I found."
    n "嘿，[name]。看看我找到的这个 YouTube 频道。"

# game/script2.rpyc:600
translate schinese m12afterchoice3_7d6a5b58:

    # n "This guy has a pet frog, and he dresses it up in different outfits every day."
    n "这个人养了一只宠物青蛙，每天给它换不同衣服。"

# game/script2.rpyc:604
translate schinese m12afterchoice3_1216526c:

    # MC "No fucking way!"
    MC "不会吧！"

# game/script2.rpyc:605
translate schinese m12afterchoice3_1aab0240:

    # n "I know, right!"
    n "对吧！"

# game/script2.rpyc:608
translate schinese m12afterchoice3_65afaef7:

    # n "Today he uploaded a beachwear video."
    n "他今天上传了一个海滩服装视频。"

# game/script2.rpyc:609
translate schinese m12afterchoice3_2089077d:

    # MC "YOOOOO! A Hawaiian shirt!"
    MC "哇哦哦哦！夏威夷衬衫！"

# game/script2.rpyc:610
