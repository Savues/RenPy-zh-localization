    # m "And me..."
    m "那我呢……"

# game/script2_2.rpyc:7257
translate schinese m22afterchoice8_0214e55b:

    # m "Am {i}I{/i} the {i}me{/i} that {i}you've{/i} always known?"
    m "我{i}是{/i}那个{i}你{/i}一直认识的{i}我{/i}吗？"

# game/script2_2.rpyc:7258
translate schinese m22afterchoice8_beaf65b2:

    # m "Please... tell me that I am."
    m "求你了……告诉我，我是。"

# game/script2_2.rpyc:7261
translate schinese m22afterchoice8_2d204a49_12:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:7262
