    # m "For my whole relationship with the MiyaVibe..."
    m "自从我开始用MiyaVibe以来……"

# game/script2_2.rpyc:13591
translate schinese m23aftergrace_f041bcd7:

    # m "I've been too scared to press this button."
    m "我一直不敢按下这个按钮。"

