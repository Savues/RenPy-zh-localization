    c "不……我是说……"

# game/script2_2.rpyc:399
translate schinese m21afterchoice1_9d5472ba:

    # c "Are {i}you{/i} sure you're going to be okay?"
    c "{i}你{/i}真的没问题吗？"

# game/script2_2.rpyc:402
translate schinese m21afterchoice1_2d204a49:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:403
