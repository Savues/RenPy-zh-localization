    # c "*Laughing*" (multiple=2)
    c "*笑*" (multiple=2)

# game/script2_2.rpyc:1113
translate schinese m21afterchoice3_0a3ae5e0:

    # MC "*Laughing*" (multiple=2)
    MC "*笑*" (multiple=2)

# game/script2_2.rpyc:1114
translate schinese m21afterchoice3_bf7bf5cf:

    # MC "Now where's our handler?"
    MC "我们的负责人去哪儿了？"

# game/script2_2.rpyc:1117
translate schinese m21afterchoice3_42de4c30:

    # c "Undoing his mess."
    c "去收拾他留下的烂摊子了。"

# game/script2_2.rpyc:1118
translate schinese m21afterchoice3_758cf169:

    # MC "He must really trust Nala to stay put, huh?"
    MC "他肯定很信任娜拉，确信她会乖乖待在那儿吧？"

# game/script2_2.rpyc:1119
translate schinese m21afterchoice3_42b47836:

    # c "Aren't we doing the same? We haven't looked backwards in a while."
    c "我们不也一样吗？我们也好一阵子没回头看了。"

# game/script2_2.rpyc:1120
translate schinese m21afterchoice3_833db2d2:

    # MC "It'll be fine. I actually made sure the door was shut."
    MC "没事的。我可是特意确认过门关好了。"

# game/script2_2.rpyc:1123
translate schinese m21afterchoice3_93950b8c:

    # c "You sure it isn't worth just a tiny peek?"
    c "你确定不值得稍微偷看一眼吗？"

# game/script2_2.rpyc:1124
translate schinese m21afterchoice3_a327c665:

    # MC "Not at all."
    MC "完全不会。"

# game/script2_2.rpyc:1125
translate schinese m21afterchoice3_660f8d0b:

    # c "How do you think the bookshelf ended up like that?"
    c "你觉得那个书架是怎么变成那样的？"

# game/script2_2.rpyc:1126
translate schinese m21afterchoice3_cb3ad3b8:

    # MC "His wife did it."
    MC "是他妻子干的。"

# game/script2_2.rpyc:1127
translate schinese m21afterchoice3_4eb19595:

    # c "How do you figure?"
    c "你是怎么推断出来的？"

# game/script2_2.rpyc:1128
translate schinese m21afterchoice3_440e2f3a:

    # MC "Well, he was unconscious, and Nala is too pure of heart to commit vandalism."
    MC "嗯，当时他昏迷不醒，而娜拉心地太善良，绝不会做出破坏公物这种事。"

# game/script2_2.rpyc:1129
translate schinese m21afterchoice3_0c8b07e5:

    # MC "See, I can be a detective too."
    MC "瞧，我也能当侦探。"

# game/script2_2.rpyc:1130
translate schinese m21afterchoice3_d7029406:

    # c "I don't think that's a very strong hypothesis."
    c "我觉得这个推论不太站得住脚。"

# game/script2_2.rpyc:1161
translate schinese m21afterchoice3_ef5628e0:

    # MC "Famous detectives usually work in duos. Whatt'ya say? Wanna team up?"
    MC "有名的侦探通常都是两人搭档。怎么样？要不要联手？"

# game/script2_2.rpyc:1162
translate schinese m21afterchoice3_4a7b6d0e:

    # c "What are we investigating?"
    c "我们要调查什么？"

# game/script2_2.rpyc:1163
translate schinese m21afterchoice3_6ae18f40:

    # MC "Gotta find a way to isolate Hugo and Ashley. We can find some... I dunno, character flaws to exploit? Schedules to interfere with?"
    MC "得想办法把雨果和阿什莉分开。我们可以找找……嗯，比如利用他们的性格弱点？或者干扰他们的日程安排？"

# game/script2_2.rpyc:1164
translate schinese m21afterchoice3_04636dfb:

    # MC "But first, we need the information."
    MC "但首先，我们需要掌握情报。"

# game/script2_2.rpyc:1165
translate schinese m21afterchoice3_a40b30f4:

    # c "Mm... sounds fun. Okay!"
    c "嗯……听起来很有趣。好啊！"

# game/script2_2.rpyc:1166
translate schinese m21afterchoice3_86f92ad6:

    # MC "Oh, and just so you know-"
    MC "噢，还有件事你要知道——"

# game/script2_2.rpyc:1195
translate schinese m21afterchoice3_5637d919:

    # MC "You're the sidekick."
    MC "你是那个跟班。"

# game/script2_2.rpyc:1198
translate schinese m21afterchoice3_a5cfe32f:

    # c "What?! Nuh-uh. I'm the one here who's actually seen some mystery shows."
    c "什么？！才不是呢。我才是那个真正看过悬疑剧的人。"

# game/script2_2.rpyc:1199
translate schinese m21afterchoice3_d22b7f5d:

    # c "{b}You're{/b} the sidekick."
    c "{b}你{/b}才是跟班。"

# game/script2_2.rpyc:1200
translate schinese m21afterchoice3_22c72b70:

    # MC "Oh, okay. Go ahead, Detective Chloe P.I."
    MC "噢，好吧。请便吧，克洛伊侦探（Detective Chloe P.I.）。"

# game/script2_2.rpyc:1201
translate schinese m21afterchoice3_1d35140e:

    # MC "That stands for Pusillanimous Idiot, by the way."
    MC "顺便说一句，那个“P.I.”代表的是“胆小懦弱的白痴”（Pusillanimous Idiot）。"

# game/script2_2.rpyc:1202
translate schinese m21afterchoice3_37042da2:

    # MC "How exactly do you plan on getting information out of anyone if you can't do the talking?"
    MC "如果你自己不开口说话，打算怎么从别人那里套出情报？"

# game/script2_2.rpyc:1203
translate schinese m21afterchoice3_a505ed7d:

    # c "That's what you, {b}the sidekick{/b}, are for. And I also don't know what \"pusillanimous\" means."
    c "那正是你——{b}跟班{/b}——该做的事。而且我也不知道“pusillanimous”（胆小懦弱）是什么意思。"

# game/script2_2.rpyc:1204
translate schinese m21afterchoice3_e48d8f35:

    # MC "A real detective would consider {i}investigating{/i} a dictionary."
    MC "真正的侦探会考虑去{i}查查{/i}字典。"

# game/script2_2.rpyc:1205
translate schinese m21afterchoice3_99f2abce:

    # MC "Since when is the sidekick a mouthpiece, anyway? What kind of main character lets someone else have all the dialogue?"
    MC "话说回来，跟班什么时候成了代言人了？哪种主角会让别人包揽所有台词？"

# game/script2_2.rpyc:1206
translate schinese m21afterchoice3_b6ed6753:

    # c "Umm. How about the reclusive genius. It's a character trait!"
    c "嗯……那种深居简出的天才怎么样？这是我的性格特点！"

# game/script2_2.rpyc:1207
translate schinese m21afterchoice3_e4dacef2:

    # MC "You can't even stick to a character trait! You're Chloe. You shouldn't be arguing."
    MC "你连自己的人设都坚持不住吗！你是克洛伊啊，你不该跟人争辩的。"

# game/script2_2.rpyc:1229
translate schinese m21afterchoice3_a9ffcea6:

    # MC "Ahhh!!! I got you!"
    MC "啊！！！抓到你了！"

# game/script2_2.rpyc:1233
translate schinese m21afterchoice3_721c14e0:

    # MC "Thought you could sneak away while I wasn't looking."
    MC "还以为趁我不注意就能溜走呢。"

# game/script2_2.rpyc:1234
translate schinese m21afterchoice3_ebf80117:

    # MC "Get back here."
    MC "回来。"

# game/script2_2.rpyc:1238
translate schinese m21afterchoice3_8916e879:

    # MC "Come on, take my picture with Nala. We've already wasted so much time in here anyway."
    MC "来吧，帮我和娜拉拍张照。反正我们在这儿已经浪费了不少时间了。"

# game/script2_2.rpyc:1239
translate schinese m21afterchoice3_3b028d49:

    # c "R-right... we should be keeping an eye on Hugo..."
    c "对……我们应该盯着雨果的……"

# game/script2_2.rpyc:1240
translate schinese m21afterchoice3_a103239f:

    # MC "Not without my commemorative tiger photograph. The absurdity of it is something I just {i}have{/i} to show off."
    MC "不拍张老虎纪念照怎么行？这种荒唐事儿我可是非得炫耀一下不可。"

# game/script2_2.rpyc:1241
translate schinese m21afterchoice3_90de0c74:

    # MC "Wait, where's the camera?"
    MC "等等，相机呢？"

# game/script2_2.rpyc:1242
translate schinese m21afterchoice3_f8a6102b:

    # c "It's conveniently placed off-screen, I assure you it's always within reach."
    c "它被“顺手”放在了画面之外，但我保证它随时都在手边。"

# game/script2_2.rpyc:1245
translate schinese m21afterchoice3_e258bce7:

    # MC "Think you know what you're doing?"
    MC "你觉得自己知道自己在做什么吗？"

# game/script2_2.rpyc:1246
translate schinese m21afterchoice3_3db89148:

    # c "Mmhm... how hard can it be? Just point and shoot... like a gun."
    c "嗯……这能有多难？就像用枪一样，瞄准然后射击就行了。"

# game/script2_2.rpyc:1247
translate schinese m21afterchoice3_0375cae9:

    # MC "I know you're talking about video games, but that's an utterly terrifying thing for you to say without context."
    MC "我知道你是在说电子游戏，但这话要是脱离了语境，听起来可真够吓人的。"

# game/script2_2.rpyc:1248
translate schinese m21afterchoice3_1d4b8751:

    # MC "Well, you said you're better at shooters than fighting games, so I have faith that this'll turn out well."
    MC "既然你说自己玩射击游戏比格斗游戏厉害，那我相信这次肯定没问题。"

# game/script2_2.rpyc:1249
translate schinese m21afterchoice3_75df679a:

    # MC "Your grip looks kind of awkward."
    MC "你握着的姿势看起来有点别扭。"

# game/script2_2.rpyc:1250
translate schinese m21afterchoice3_61ceb948:

    # c "I can't help it. It's too big for my little hands."
    c "没办法，这对我的小手来说太大了。"

# game/script2_2.rpyc:1251
translate schinese m21afterchoice3_8ba7f702:

    # MC "You'll figure it out, I'm sure you'll get used to large objects after repeated use."
    MC "你会找到窍门的，我相信多用几次之后，你就能适应这种大尺寸的东西了。"

# game/script2_2.rpyc:1254
translate schinese m21afterchoice3_5c28b665:

    # c "M-mm... I'll try my best."
    c "嗯……我会尽力的。"

# game/script2_2.rpyc:1264
translate schinese m21afterchoice3_15175058:

    # MC "Nala, you've been a fantastic sport."
    MC "娜拉，你真是太配合了。"

# game/script2_2.rpyc:1265
translate schinese m21afterchoice3_f8790002:

    # c "Thanks, Nala!"
    c "谢谢你，娜拉！"

# game/script2_2.rpyc:1266
translate schinese m21afterchoice3_a741c0bc:

    # MC "Okay, now do one where it looks like you're mauling me to death."
    MC "好了，现在摆个姿势，看起来就像你要把我活活撕碎一样。"

# game/script2_2.rpyc:1269
translate schinese m21afterchoice3_9a8300b3:

    # c "Oh my god..."
    c "天哪……"

# game/script2_2.rpyc:1270
translate schinese m21afterchoice3_47deeeb1:

    # MC "Hehe! Miya's gonna shit herself."
    MC "嘿嘿！米娅肯定会吓得屁滚尿流的。"

# game/script2_2.rpyc:1271
translate schinese m21afterchoice3_c9313b71:

    # c "Oh no... please don't send that to her... she's going to freak out."
    c "噢不……求你别发给她……她会抓狂的。"

# game/script2_2.rpyc:1272
translate schinese m21afterchoice3_6cd5d339:

    # MC "That's the plan."
    MC "计划就是这样。"

# game/script2_2.rpyc:1273
translate schinese m21afterchoice3_1d260ce6:

    # c "Jesus Greg..."
    c "天哪，格雷格……"

# game/script2_2.rpyc:1274
translate schinese m21afterchoice3_644c49f3:

    # MC "I'm doing it now, I've got a USB cable in storage."
    MC "我现在就弄，我储物箱里有根 USB 线。"

# game/script2_2.rpyc:1275
translate schinese m21afterchoice3_ecaf2f62:

    # c "This is a terrible idea..."
    c "这主意太糟糕了……"

# game/script2_2.rpyc:1276
translate schinese m21afterchoice3_f7ae3380:

    # MC "That's what I'm all about."
    MC "我向来就爱搞这种事。"

# game/script2_2.rpyc:1279
translate schinese m21afterchoice3_b5a7b65e:

    # hand "Thanks for keeping an eye on Nala."
    hand "谢谢你帮忙照看娜拉。"

# game/script2_2.rpyc:1282
translate schinese m21afterchoice3_58981d7f:

    # hand "I'm all done over here. You can get back to the party and I'll babysit the tabby."
    hand "我这边忙完了。你可以回派对去了，那只虎斑猫交给我看着就行。"

# game/script2_2.rpyc:1283
translate schinese m21afterchoice3_3645a0c8:

    # hand "And please destroy that camera."
    hand "还有，请把那个摄像头毁掉。"

# game/script2_2.rpyc:1284
translate schinese m21afterchoice3_9b0d1ef6:

    # MC "Uh... sure, we were just waiting to get to a different room in case we accidentally leave a mess."
    MC "呃……没问题，我们本来就打算换个房间再动手，免得不小心弄得一团糟。"

# game/script2_2.rpyc:1285
translate schinese m21afterchoice3_6d664c01:

    # MC "Wouldn't want it anywhere near you arousing suspicion, would we?"
    MC "毕竟要是把它留在你附近引起怀疑，那可就不妙了，对吧？"

# game/script2_2.rpyc:1286
translate schinese m21afterchoice3_5dbbc62d:

    # hand "Smart. Thanks a lot. I'll take it from here."
    hand "聪明。多谢了。剩下的交给我来处理。"

# game/script2_2.rpyc:1287
translate schinese m21afterchoice3_020a6887:

    # MC "Come on, Chloe, let's move out."
    MC "走吧，克洛伊，我们撤。"

# game/script2_2.rpyc:1290
translate schinese m21afterchoice3_9831867a:

    # MC "Lucky guy."
    MC "这家伙真走运。"

# game/script2_2.rpyc:1291
translate schinese m21afterchoice3_7543ea61:

    # c "Huh?"
    c "嗯？"

# game/script2_2.rpyc:1292
translate schinese m21afterchoice3_331b7200:

    # MC "That Drow."
    MC "那个卓尔精灵（Drow）……"

# game/script2_2.rpyc:1298
translate schinese m21afterchoice3_b2cc143a:

    # c "SHHHH!!"
    c "嘘——！！"

# game/script2_2.rpyc:1299
translate schinese m21afterchoice3_7672d49b:

    # c "What are you doing?! You can't say that! Hard W and everything!"
    c "你在干什么？！那种词可不能乱说！尤其是那个发音那么重的“W”开头的词！"

# game/script2_2.rpyc:1300
translate schinese m21afterchoice3_a6b1658c:

    # c "What if someone heard that? Do you want to get kicked out? Or assaulted?!"
    c "万一被人听到了怎么办？你想被赶出去吗？还是想挨揍？！"

# game/script2_2.rpyc:1301
translate schinese m21afterchoice3_465d1999:

    # MC "What did I do?!"
    MC "我做了什么？！"

# game/script2_2.rpyc:1302
translate schinese m21afterchoice3_ae7dbbf9:

    # c "You know what you did! You called him the... the D word."
    c "你自己心里清楚！你管他叫……叫那个D开头的词。"

# game/script2_2.rpyc:1306
translate schinese m21afterchoice3_522bef70:

    # c "A d-... d-... [size20small]Dr**..."
    c "一……一……[size20small]Dr**……"

# game/script2_2.rpyc:1307
translate schinese m21afterchoice3_a14d5c77:

    # MC "What? I couldn't hear that."
    MC "什么？我没听清。"

# game/script2_2.rpyc:1309
translate schinese m21afterchoice3_f16d3b20:

    # c "[size30small]Dr**..."
    c "[size30small]博士……"

# game/script2_2.rpyc:1310
translate schinese m21afterchoice3_b026fdc4:

    # MC "Drow?"
    MC "卓尔？"

# game/script2_2.rpyc:1313
translate schinese m21afterchoice3_edcdee5f:

    # c "Shut up!" with vpunch
    c "闭嘴！" with vpunch

# game/script2_2.rpyc:1314
translate schinese m21afterchoice3_8040f068:

    # MC "Woah, how do you bleep it out like that?"
    MC "哇，你是怎么把它消音消成那样的？"

# game/script2_2.rpyc:1315
translate schinese m21afterchoice3_d0fba208:

    # MC "I can't do that."
    MC "我做不到那样。"

# game/script2_2.rpyc:1318
translate schinese m21afterchoice3_f9a42c14:

    # MC "Do you think I have the pass?"
    MC "你觉得我有那个“通行证”吗？"

# game/script2_2.rpyc:1319
translate schinese m21afterchoice3_cb65ba98:

    # c "Can we please move on from this?"
    c "我们能别再谈这个了吗？"

# game/script2_2.rpyc:1321
translate schinese m21afterchoice3_63c9da0e:

    # c "You said he was lucky?"
    c "你说他很幸运？"

# game/script2_2.rpyc:1322
translate schinese m21afterchoice3_21363bbd:

    # c "Because you like tigers? Or... drinking yourself to death?"
    c "是因为你喜欢老虎？还是因为……能把自己喝死？"

# game/script2_2.rpyc:1323
translate schinese m21afterchoice3_70d2bf1a:

    # MC "He's not bound."
    MC "他没有受到束缚。"

# game/script2_2.rpyc:1324
translate schinese m21afterchoice3_85aaf38f:

    # c "O-oh... right... yeah, lucky him..."
    c "噢……对……是啊，他真幸运……"

# game/script2_2.rpyc:1325
translate schinese m21afterchoice3_e5170813:

    # c "Do you think it's because he's rich?"
    c "你觉得是因为他有钱吗？"

# game/script2_2.rpyc:1326
translate schinese m21afterchoice3_0d9c3560:

    # MC "Eh, I dunno, he might not even be rich considering he's an employee. When was the last time you heard of a palace servant being just as well off as the owners?"
    MC "呃，我不知道，考虑到他只是个雇员，他未必有钱。你什么时候听说过宫廷仆人能和主人一样富裕的？"

# game/script2_2.rpyc:1327
translate schinese m21afterchoice3_ff84955d:

    # c "Mmm... at least he gets a tiger."
    c "嗯……至少他有只老虎。"

# game/script2_2.rpyc:1330
translate schinese m21afterchoice3_daf79a23:

    # MC "Ha. You like that tiger, don't you?"
    MC "哈。你喜欢那只老虎，对吧？"

# game/script2_2.rpyc:1331
translate schinese m21afterchoice3_1b4f69c2:

    # c "Uh... she was a little too big to be practical... but yeah, she was cute and super friendly."
    c "呃……它体型有点太大，不太适合当宠物……不过，它确实很可爱，而且特别亲人。"

# game/script2_2.rpyc:1332
translate schinese m21afterchoice3_9d401cf8:

    # c "I think a pet would suit me... they're much easier to deal with than... people."
    c "我觉得养个宠物挺适合我的……毕竟它们比……人好相处多了。"

# game/script2_2.rpyc:1336
translate schinese m21choice4_1_ca0071c0:

    # c "Hmm... that's a hard one. I don't even know what my favorite animal is."
    c "嗯……这可真难选。我甚至都不知道自己最喜欢的动物是什么。"

# game/script2_2.rpyc:1337
translate schinese m21choice4_1_1f63b245:

    # c "I think I'd need something uh... quiet... calm..."
    c "我想我需要那种……安静……沉稳的……"

# game/script2_2.rpyc:1338
translate schinese m21choice4_1_a00f01a4:

    # c "And cuddly..."
    c "而且还要毛茸茸的……"

# game/script2_2.rpyc:1339
translate schinese m21choice4_1_c7786797:

    # MC "Bear."
    MC "熊。"

# game/script2_2.rpyc:1340
translate schinese m21choice4_1_68bc21d4:

    # c "Are you serious?"
    c "你是认真的吗？"

# game/script2_2.rpyc:1341
translate schinese m21choice4_1_a99f00b8:

    # MC "No."
    MC "不。"

# game/script2_2.rpyc:1342
translate schinese m21choice4_1_8bb5f181:

    # MC "It's a basic suggestion but, cat? You don't need to take it for walks, they're generally smaller than Nala, and both of you can hide away in the dark together."
    MC "虽然是个很普通的建议，但……猫怎么样？你不需要带它出去遛弯，它通常比娜拉体型小，而且你们俩可以一起躲在黑暗中。"

# game/script2_2.rpyc:1343
translate schinese m21choice4_1_a9fe5f63:

    # c "We have enough cats in the house."
    c "家里养的猫已经够多了。"

# game/script2_2.rpyc:1344
translate schinese m21choice4_1_70f70e8f:

    # MC "Are you talking about Cadence?"
    MC "你是说凯登丝吗？"

# game/script2_2.rpyc:1345
translate schinese m21choice4_1_b1b0be14:

    # c "Who else?"
    c "还能有谁？"

# game/script2_2.rpyc:1346
translate schinese m21choice4_1_e307918e:

    # MC "It's a little reductive to call her a cat, isn't it?"
    MC "把她称为“猫”未免有点太片面了吧？"

# game/script2_2.rpyc:1347
translate schinese m21choice4_1_ead90276:

    # c "She shows traits."
    c "她表现出了一些特征。"

# game/script2_2.rpyc:1348
translate schinese m21choice4_1_0b9b3094:

    # MC "I wasn't aware that you and Cadence have even interacted."
    MC "我都没意识到你和凯登丝有过接触。"

# game/script2_2.rpyc:1349
translate schinese m21choice4_1_96373e37:

    # c "Well... you're not always home, are you?"
    c "嗯……你又不总是待在家里，对吧？"

# game/script2_2.rpyc:1350
translate schinese m21choice4_1_f0c065ab:

    # MC "Do you get along?"
    MC "你们相处得好吗？"

# game/script2_2.rpyc:1351
translate schinese m21choice4_1_86660174:

    # c "Mmhm."
    c "嗯。"

# game/script2_2.rpyc:1354
translate schinese m21choice4_1_89e62296:

    # c "She's so humble... so kind... we're not close, but it's amazing how positive she stays."
    c "她很谦逊……也很善良……虽然我们不算特别亲密，但她那种积极的心态真的很了不起。"

# game/script2_2.rpyc:1355
translate schinese m21choice4_1_059a4d26:

    # MC "...Yeah. It's pretty remarkable, all things considered. Never complaining, always purring."
    MC "……是啊。考虑到种种情况，这确实很特别。从不抱怨，总是发出呼噜声。"

# game/script2_2.rpyc:1358
translate schinese m21choice4_1_4d0c8fdf:

    # c "I know! It's so cute!"
    c "就是说啊！太可爱了！"

# game/script2_2.rpyc:1359
translate schinese m21choice4_1_19570c32:

    # MC "What?"
    MC "什么？"

# game/script2_2.rpyc:1360
translate schinese m21choice4_1_a808dabc:

    # c "Cadence. Whenever she does cat stuff..."
    c "凯登丝。每当她做出那些猫咪特有的举动时……"

# game/script2_2.rpyc:1361
translate schinese m21choice4_1_d6bba79e:

    # c "It's... it's adorable. Sickeningly so."
    c "那真是……太可爱了。可爱得让人受不了。"

# game/script2_2.rpyc:1362
translate schinese m21choice4_1_541488e2:

    # MC "I can't disagree there, it still takes me off guard on occasion. I'm also uh... constantly tempted to exploit it for entertainment."
    MC "这点我完全同意，有时候还是会让我猝不及防。而且我……呃……总是忍不住想拿这事儿来找乐子。"

# game/script2_2.rpyc:1363
translate schinese m21choice4_1_61effba1:

    # c "I get it... I totally get it."
    c "我懂……我完全懂。"

# game/script2_2.rpyc:1367
translate schinese m21choice4_2_69af2cef:

    # c "Well... no. But It's not the same. I'm used to you."
    c "嗯……不。但这不一样。我已经习惯有你在身边了。"

# game/script2_2.rpyc:1368
translate schinese m21choice4_2_863e477f:

    # MC "Are you saying I'm already your pet? Because I can manifest like, sixteen leaps of logic that draw that conclusion."
    MC "你是说我已经成了你的宠物吗？因为我能列出十六个逻辑跳跃，直接得出这个结论。"

# game/script2_2.rpyc:1369
translate schinese m21choice4_2_b2635e69:

    # c "You like making logical leaps, don't you?"
    c "你很喜欢做逻辑跳跃，对吧？"

# game/script2_2.rpyc:1370
translate schinese m21choice4_2_06b3b861:

    # MC "Is that sass I hear? Very uncharacteristic of you."
    MC "我这是听到你在顶嘴吗？这可真不像你的风格。"

# game/script2_2.rpyc:1371
translate schinese m21choice4_2_4642c63b:

    # c "Mmm... don't start."
    c "唔……别开始了。"

# game/script2_2.rpyc:1372
translate schinese m21choice4_2_0c726e69:

    # MC "Start what? Would a pet call you out like I just did?"
    MC "开始什么？宠物会像我刚才那样当面指出你的问题吗？"

# game/script2_2.rpyc:1373
translate schinese m21choice4_2_95d001d5:

    # c "I didn't call you a pet."
    c "我没说你是宠物。"

# game/script2_2.rpyc:1374
translate schinese m21choice4_2_bf503d0b:

    # MC "You put me on their level."
    MC "是你把我跟它们归为一类了。"

# game/script2_2.rpyc:1378
translate schinese m21choice4_3_37c13b58:

    # c "And that's why you're doing all the talking. You're the people person."
    c "正因如此，才由你来负责交涉啊。你才是那个擅长与人打交道的人。"

# game/script2_2.rpyc:1379
translate schinese m21choice4_3_2308b608:

    # MC "Woah woah woah, I wouldn't go {i}that{/i} far."
    MC "等等，等等，我可没说得{i}那么{/i}夸张。"

# game/script2_2.rpyc:1380
translate schinese m21choice4_3_8bb8a7bc:

    # MC "You're just an... {i}anti{/i}-people person."
    MC "你不过是个……{i}厌{/i}别人的家伙。"

# game/script2_2.rpyc:1381
translate schinese m21choice4_3_1f8df28a:

    # c "No, I'm an anti-dealing with people person."
    c "不，我是个讨厌应付别人的人。"

# game/script2_2.rpyc:1382
translate schinese m21choice4_3_ea3262bf:

    # MC "And? What would you do if I wasn't here to cover for you?"
    MC "那又怎样？如果我不在这儿给你打掩护，你会怎么办？"

# game/script2_2.rpyc:1383
translate schinese m21choice4_3_c77ee2a1:

    # c "If you weren't here, I'd be at home where I'm safe."
    c "如果我不在这儿，我就会待在家里，那里才安全。"

# game/script2_2.rpyc:1384
translate schinese m21choice4_3_af6e5c97:

    # c "You do all the talking, and you're forgiven for getting me wound up in this."
    c "既然全都是你在说，那我就原谅你把我卷进这事儿里来了。"

# game/script2_2.rpyc:1385
translate schinese m21choice4_3_68d20883:

    # MC "*Tsk* Grace escaping the blame."
    MC "*啧*，格蕾丝倒是把自己摘得干干净净。"

# game/script2_2.rpyc:1389
translate schinese m21afterchoice4_2734a485:

    # MC "You know what I think?"
    MC "你知道我在想什么吗？"

# game/script2_2.rpyc:1390
translate schinese m21afterchoice4_297d93f3:

    # c "What?"
    c "什么？"

# game/script2_2.rpyc:1391
translate schinese m21afterchoice4_3681c78d:

    # MC "I think a rabbit would suit you."
    MC "我觉得兔子挺适合你的。"

# game/script2_2.rpyc:1392
translate schinese m21afterchoice4_9e22640c:

    # c "A rabbit?"
    c "兔子？"

# game/script2_2.rpyc:1395
translate schinese m21afterchoice4_0a83caaa:

    # c "Hmm."
    c "嗯。"

# game/script2_2.rpyc:1396
translate schinese m21afterchoice4_511b24fd:

    # c "You're not wrong... bunnies are cute, quiet, calm..."
    c "你说得没错……兔子既可爱又安静、温顺……"

# game/script2_2.rpyc:1397
translate schinese m21afterchoice4_22c21a65:

    # c "What made you think of that?"
    c "怎么突然想到这个了？"

# game/script2_2.rpyc:1398
translate schinese m21afterchoice4_e59b6978:

    # MC "You're both prey animals."
    MC "因为你们都是猎物型动物啊。"

# game/script2_2.rpyc:1399
translate schinese m21afterchoice4_d0aa4b24:

    # c "Oh, har-har. Which animal's the biggest smart-ass? I'll check if it's legal to own one so you can get yourself a companion."
    c "呵，真幽默。哪种动物最爱耍贫嘴？我去查查养那种动物合不合法，好给你找个伴儿。"

# game/script2_2.rpyc:1402
translate schinese m21afterchoice4_79170ffc:

    # MC "Does Vineeta know you're capable of quips like that?"
    MC "维妮塔知道你这么会贫嘴吗？"

# game/script2_2.rpyc:1405
translate schinese m21afterchoice4_ff5a7710:

    # c "Sorry, it's my first time."
    c "抱歉，这是我头一回。"

# game/script2_2.rpyc:1406
translate schinese m21afterchoice4_2bda31b8:

    # MC "Please nip it in the bud, I don't think I could handle two Vineetas berating me. One is plenty."
    MC "请务必把这苗头掐死在摇篮里，我可受不了两个维妮塔同时数落我。有一个就够受的了。"

# game/script2_2.rpyc:1407
translate schinese m21afterchoice4_dc760988:

    # MC "Anyway, I already know what kind of pet I'd want."
    MC "话说回来，我已经知道自己想要养什么宠物了。"

# game/script2_2.rpyc:1410
translate schinese m21afterchoice4_d19f855d:

    # c "..."
    c "……"

# game/script2_2.rpyc:1411
translate schinese m21afterchoice4_b015b3aa:

    # c "I'm sensing a bad joke."
    c "我有种不祥的预感，觉得你要讲个烂笑话。"

# game/script2_2.rpyc:1412
translate schinese m21afterchoice4_dd16bdf2:

    # MC "Nuh-uh. I'm sincere, nothing's changing my mind here."
    MC "不，我是认真的，没人能改变我的想法。"

# game/script2_2.rpyc:1413
translate schinese m21afterchoice4_bf3f8bc1:

    # c "Huh... It's not weird or anything is it?"
    c "嗯……这应该不算奇怪吧？"

# game/script2_2.rpyc:1414
translate schinese m21afterchoice4_04664e69:

    # MC "It's like a D-tier in terms of animal weirdness."
    MC "论“动物界的怪异程度”，它顶多算个D级。"

# game/script2_2.rpyc:1415
translate schinese m21afterchoice4_1e665559:

    # c "Hmm..."
    c "嗯……"

# game/script2_2.rpyc:1416
translate schinese m21afterchoice4_dc4b2cd8:

    # c "Okay then, what is it?"
    c "那好吧，到底是什么？"

# game/script2_2.rpyc:1418
translate schinese m21afterchoice4_5c729317:

    # MC "Frog."
    MC "青蛙。"

# game/script2_2.rpyc:1419
translate schinese m21afterchoice4_d19f855d_1:

    # c "..."
    c "……"

# game/script2_2.rpyc:1420
translate schinese m21afterchoice4_649ccb64:

    # c "Frog?"
    c "青蛙？"

# game/script2_2.rpyc:1421
translate schinese m21afterchoice4_5c729317_1:

    # MC "Frog."
    MC "青蛙。"

# game/script2_2.rpyc:1422
translate schinese m21afterchoice4_d7826e25:

    # c "Wh-... I don't get it..."
    c "什……我不太明白……"

# game/script2_2.rpyc:1423
translate schinese m21afterchoice4_85a8cb33:

    # c "Why are you so interested in frogs?"
    c "你为什么对青蛙这么感兴趣？"

# game/script2_2.rpyc:1424
translate schinese m21afterchoice4_7e5cc3ae:

    # MC "Let me show you."
    MC "我带你去看看。"

# game/script2_2.rpyc:1443
translate schinese m21afterchoice4_adc05f30:

    # c "I just remembered..."
    c "我突然想起来了……"

# game/script2_2.rpyc:1444
translate schinese m21afterchoice4_52b4195c:

    # c "Grace warned me about this! Hours. She said you'll be distracted for hours!"
    c "格蕾丝提醒过我这事儿！要花好几个小时。她说你会分心好几个小时！"

# game/script2_2.rpyc:1445
translate schinese m21afterchoice4_11cf938e:

    # c "We don't have that kind of time!"
    c "我们可没那么多时间！"

# game/script2_2.rpyc:1446
translate schinese m21afterchoice4_3a84e1db:

    # MC "But the pirate costume-"
    MC "可是那套海盗装——"

# game/script2_2.rpyc:1448
translate schinese m21afterchoice4_edcdee5f:

    # c "Shut up!" with vpunch
    c "闭嘴！" with vpunch

# game/script2_2.rpyc:1451
translate schinese m21afterchoice4_2d204a49:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:1452
translate schinese m21afterchoice4_438e3446:

    # MC "Fine."
    MC "很好。"

# game/script2_2.rpyc:1457
translate schinese m21afterchoice4_8d3a90a9:

    # "This side of Chloe is refreshing to you, you feel as if she's opened up to you."
    "克洛伊展现出的这一面让你耳目一新，感觉她向你敞开了心扉。"

# game/script2_2.rpyc:1458
translate schinese m21afterchoice4_3627aa96:

    # "She's comfortable enough to talk back to you, and engage in playful banter, she stutters and mumbles less."
    "她感到足够自在，敢于顶嘴，也能和你打趣调侃；说话时结巴和嘟囔的情况也变少了。"

# game/script2_2.rpyc:1459
translate schinese m21afterchoice4_15fbd867:

    # "And now she's grabbing your hand, maintaining eye contact, telling you to shut up."
    "此时，她紧紧抓住你的手，目光直视着你，叫你闭嘴。"

# game/script2_2.rpyc:1460
translate schinese m21afterchoice4_a038c1b6:

    # "It feels a little like you've injected life back into her."
    "感觉就像是你为她注入了新的活力。"

# game/script2_2.rpyc:1469
translate schinese m21choice5_1_5a579cc9:

    # MC "Your hands are small."
    MC "你的手很小。"

# game/script2_2.rpyc:1470
translate schinese m21choice5_1_60e8576f:

    # c "W-well..."
    c "这……那个……"

# game/script2_2.rpyc:1471
translate schinese m21choice5_1_c44d6a79:

    # c "I {i}am{/i} small."
    c "我{i}确实{/i}很小。"

# game/script2_2.rpyc:1474
translate schinese m21choice5_1_2eeb6323:

    # c "W-woah..."
    c "哇……"

# game/script2_2.rpyc:1475
translate schinese m21choice5_1_940e8a8c:

    # MC "What is it?"
    MC "什么事？"

# game/script2_2.rpyc:1476
translate schinese m21choice5_1_7ec35773:

    # c "Your hands are massive."
    c "你的手好大啊。"

# game/script2_2.rpyc:1477
translate schinese m21choice5_1_7feeca56:

    # MC "I don't think they are, this is just what a guy's hand is like."
    MC "我不觉得大，男人的手本来就是这样的。"

# game/script2_2.rpyc:1478
translate schinese m21choice5_1_215e9c36:

    # c "I can barely get my fingers around it."
    c "我的手指都快握不过来了。"

# game/script2_2.rpyc:1479
translate schinese m21choice5_1_55d8a33a:

    # "Her touch is delicate but deliberate. Her tiny hands and weak grip are holding onto you in earnest."
    "她的触碰既轻柔又充满心意。她那娇小无力的双手，正全心全意地紧握着你。"

# game/script2_2.rpyc:1480
translate schinese m21choice5_1_6f1f0c6d:

    # c "You're so much stronger than Neeta..."
    c "你比妮塔坚强多了……"

# game/script2_2.rpyc:1481
translate schinese m21choice5_1_7d46c8de:

    # MC "You hold hands with her often?"
    MC "你经常和她牵手吗？"

# game/script2_2.rpyc:1482
translate schinese m21choice5_1_83c75505:

    # c "Mm... sometimes."
    c "嗯……有时候吧。"

# game/script2_2.rpyc:1483
translate schinese m21choice5_1_ca157236:

    # MC "That sounds... intimate?"
    MC "听起来……挺亲密的？"

# game/script2_2.rpyc:1484
translate schinese m21choice5_1_65a0ba4b:

    # c "Neeta has... well... a {i}thing{/i}..."
    c "妮塔她……嗯……有点“{i}小{/i}问题”……"

# game/script2_2.rpyc:1485
translate schinese m21choice5_1_0c3b5916:

    # MC "I knew it. Is it bigger than mine?"
    MC "我就知道。它比我的大吗？"

# game/script2_2.rpyc:1487
translate schinese m21choice5_1_d0f61edb:

    # c "She's not really... good at touching people. It makes her uncomfortable, she starts sweating, getting nervous..."
    c "她其实不太……擅长和人有肢体接触。这会让她感到不自在，开始出汗、紧张……"

# game/script2_2.rpyc:1488
translate schinese m21choice5_1_4dc686f1:

    # MC "Huh, really? I had no idea."
    MC "咦，真的吗？我完全不知道。"

# game/script2_2.rpyc:1490
translate schinese m21choice5_1_c4f4d0e5:

    # c "Wait, I think she told you, didn't she?"
    c "等等，我想她应该跟你说过吧？"

# game/script2_2.rpyc:1491
translate schinese m21choice5_1_7ffdb9fd:

    # MC "About the physical contact thing? Yeah."
    MC "关于肢体接触那件事？嗯，说过。"

# game/script2_2.rpyc:1492
translate schinese m21choice5_1_8db656d8:

    # c "She gets used to it with constant exposure... we've been working on it for years..."
    c "只要不断接触，她就会慢慢适应……我们为此努力了好几年……"

# game/script2_2.rpyc:1493
translate schinese m21choice5_1_3159fc4e:

    # c "Started with holding hands... then hugs..."
    c "从牵手开始……然后是拥抱……"

# game/script2_2.rpyc:1494
translate schinese m21choice5_1_77d8fe41:

    # MC "Wow... you really care about her, huh?"
    MC "哇……你真的很关心她呢。"

# game/script2_2.rpyc:1495
translate schinese m21choice5_1_420eeacf:

    # c "Mmhm..."
    c "嗯……"

# game/script2_2.rpyc:1496
translate schinese m21choice5_1_243afdee:

    # c "I just thought... well... what if she falls in love with someone?"
    c "我只是在想……嗯……万一她爱上某个人了呢？"

# game/script2_2.rpyc:1497
translate schinese m21choice5_1_abeba1e7:

    # MC "That poor someone..."
    MC "那个可怜的人……"

# game/script2_2.rpyc:1498
translate schinese m21choice5_1_67409fac:

    # c "Wouldn't you want to touch the person you love?"
    c "难道你不想触碰自己爱的人吗？"

# game/script2_2.rpyc:1499
translate schinese m21choice5_1_5396b62a:

    # MC "...Yeah. I would."
    MC "……嗯。我想。"

# game/script2_2.rpyc:1500
translate schinese m21choice5_1_76c96738:

    # MC "Do you think about love often?"
    MC "你经常思考关于爱的事吗？"

# game/script2_2.rpyc:1503
translate schinese m21choice5_1_46cf7c73:

    # c "Eh? N-not really... I... don't think I even understand what love is..."
    c "诶？倒也……没有……我……甚至觉得自己都不明白什么是爱……"

# game/script2_2.rpyc:1504
translate schinese m21choice5_1_547ee0d7:

    # MC "Never been in love?"
    MC "从来没谈过恋爱？"

# game/script2_2.rpyc:1505
translate schinese m21choice5_1_8ccffd09:

    # c "...I... I don't know..."
    c "……我……我不知道……"

# game/script2_2.rpyc:1514
translate schinese m21choice5_2_45d0ef1c:

    # MC "Nghh!"
    MC "唔！"

# game/script2_2.rpyc:1515
translate schinese m21choice5_2_5a1240a2:

    # c "H-hey! Are you okay?"
    c "嘿！你没事吧？"

# game/script2_2.rpyc:1516
translate schinese m21choice5_2_a65762e5:

    # MCt "Fuck... it's Clement again... He must've moved or something..."
    MCt "该死……又是克莱门特……他肯定又挪动了位置之类的……"

# game/script2_2.rpyc:1517
translate schinese m21choice5_2_d21a3b80:

    # c "[name]?"
    c "[name]？"

# game/script2_2.rpyc:1520
translate schinese m21choice5_2_ed198d55:

    # MC "It's fine, Chloe. Come on, I need my sidekick within arm's reach."
    MC "没事的，克洛伊。来吧，我需要我的搭档就在触手可及的地方。"

# game/script2_2.rpyc:1523
translate schinese m21choice5_2_7ea757e6:

    # c "I'm {i}not{/i} your sidekick."
    c "我{i}可{/i}不是你的搭档。"

# game/script2_2.rpyc:1524
translate schinese m21choice5_2_37b38204:

    # MC "Then whose are you?"
    MC "那你又是谁的搭档？"

# game/script2_2.rpyc:1525
translate schinese m21choice5_2_56c088f6:

    # c "That's not what I meant! {i}I'm{/i} the globetrotting detective, you're the assistant?"
    c "我不是那个意思！我是那个环游世界的侦探，而你是助手，对吧？"

# game/script2_2.rpyc:1526
translate schinese m21choice5_2_bb6b32e7:

    # MC "Globetrotting? Have you seen your puny gait? I could trot the globe twice as fast. You're getting worn out just keeping up with me, aren't you?"
    MC "环游世界？看看你那小短腿迈出的步子吧？我环游世界的速度能比你快两倍。光是跟上我的脚步，你就已经累得够呛了吧？"

# game/script2_2.rpyc:1527
translate schinese m21choice5_2_a93da304:

    # c "No. I'm getting worn out because the most intensive form of exercise I do is getting out of bed."
    c "不。我之所以累，是因为我做过的强度最大的运动就是起床。"

# game/script2_2.rpyc:1528
