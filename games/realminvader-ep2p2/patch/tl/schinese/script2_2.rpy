translate schinese m23aftergrace_a1668e32:

    # m "See this?"
    m "看到这个了吗？"

# game/script2_2.rpyc:13578
translate schinese m23aftergrace_a6662824:

    # MC "Put that thing away! I have so much to live for!"
    MC "把那玩意儿收起来！我还有大好人生没过够呢！"

# game/script2_2.rpyc:13579
translate schinese m23aftergrace_3c37ca28:

    # m "This thing here has been my partner for six years after I broke the last one from overuse."
    m "上一个因为过度使用坏掉了，这个家伙已经陪了我六年了。"

# game/script2_2.rpyc:13580
translate schinese m23aftergrace_1f5aff7c:

    # MC "Overuse?!" (multiple=2)
    MC "过度使用？！" (multiple=2)

# game/script2_2.rpyc:13581
translate schinese m23aftergrace_c8f42a71:

    # m "I've used this thing habitually for so damn long that I might as well marry it." (multiple=2)
    m "我用这玩意儿用得太久、太频繁了，简直都快能跟它结婚了。" (multiple=2)

# game/script2_2.rpyc:13582
translate schinese m23aftergrace_5238fb52:

    # m "But all this time, I've been afraid. I always set it to \"Hyperdrive Mode\" and it rocks my fucking socks off."
    m "但这么久以来，我一直心存畏惧。每次我把它调到“超光速模式”，那感觉简直爽到飞起。"

