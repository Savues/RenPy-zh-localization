    # g "Have you noticed?"
    g "你注意到了吗？"

# game/script2_2.rpyc:8965
translate schinese m22aftermiya_19570c32:

    # MC "What?"
    MC "什么？"

# game/script2_2.rpyc:8968
translate schinese m22aftermiya_b23d0282:

