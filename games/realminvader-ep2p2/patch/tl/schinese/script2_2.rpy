translate schinese m21choice5_2_2d204a49_5:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:1718
translate schinese m21choice5_2_93b7b4c3:

    # MC "Now?"
    MC "现在？"

# game/script2_2.rpyc:1719
translate schinese m21choice5_2_d19f855d_5:

    # c "..."
    c "……"

