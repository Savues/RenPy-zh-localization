    # MCt "Shit! The window's open! I hope no one heard-"
    MCt "该死！窗户开着！希望没人听见——"

# game/script2_2.rpyc:4661
translate schinese m22afterchoice1_19a1f45f:

    # m "Found you!"
    m "找到你了！"

# game/script2_2.rpyc:4705
