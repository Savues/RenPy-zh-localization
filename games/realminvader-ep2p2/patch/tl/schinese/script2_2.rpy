translate schinese m23aftergrace_e1b698f4:

    # m "But it goes further."
    m "但这还不是极限。"

# game/script2_2.rpyc:13586
translate schinese m23aftergrace_eb776e21:

    # MC "What was that? An explosion?"
    MC "刚才那是什么？爆炸声吗？"

# game/script2_2.rpyc:13587
