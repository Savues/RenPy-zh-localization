translate schinese m21choice1_2_27d3d049:

    # c "Mm..."
    c "唔……"

# game/script2_2.rpyc:245
translate schinese m21choice1_2_caf5a2b7:

    # c "Mmmmmm..."
    c "唔唔唔……"

