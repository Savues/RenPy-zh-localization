    # MC "Yeah... It's you..."
    MC "嗯……就是你……"

# game/script2_2.rpyc:7266
translate schinese m22afterchoice8_86e346ea:

    # MC "Not just you... Grace, Chloe, Noelle... Nothing's changed..."
    MC "不光是你……格蕾丝、克洛伊、诺艾尔……什么都没变……"

# game/script2_2.rpyc:7267
translate schinese m22afterchoice8_267aaa32:

    # MC "Nothing's changed at all."
    MC "一切都未曾改变。"

# game/script2_2.rpyc:7269
translate schinese m22afterchoice8_9dc0db80:

    # MC "You really... took the lead there for a moment..."
    MC "你刚才……真的占据了主动呢……"

# game/script2_2.rpyc:7270
translate schinese m22afterchoice8_6f4a2338:

    # MC "Thanks."
    MC "谢谢。"

# game/script2_2.rpyc:7271
translate schinese m22afterchoice8_4cfb731c:

    # MC "Are you sure you're drunk."
    MC "你确定你喝醉了吗？"

# game/script2_2.rpyc:7272
translate schinese m22afterchoice8_3c8e055f:

    # m "I..."
    m "我……"

# game/script2_2.rpyc:7273
translate schinese m22afterchoice8_b889a4e5:

    # m "I've never been more drunk in my life."
    m "我这辈子从没醉得这么厉害过。"

# game/script2_2.rpyc:7274
translate schinese m22afterchoice8_2979654c:

    # MC "In that case, maybe you're not the Miya I've always known."
    MC "既然这样，也许你已经不是我一直认识的那个米娅了。"

# game/script2_2.rpyc:7287
translate schinese m22afterchoice8_97476eb7:

    # m "That's all I needed to know."
    m "这就足够了。"

# game/script2_2.rpyc:7288
translate schinese m22afterchoice8_a6415c1f:

    # m "I'm on your side, I always will be. We'll get to the bottom of this. And when I say \"we\", I mean it."
    m "我站在你这边，永远都会。我们会把这件事查个水落石出。我说“我们”的时候，是认真的。"

# game/script2_2.rpyc:7289
translate schinese m22afterchoice8_73890001:

    # m "If we need to start with Clement, then fine."
    m "如果必须从克莱门特那里着手，那就这么办吧。"

# game/script2_2.rpyc:7290
translate schinese m22afterchoice8_cd931934:

    # m "Just point me in the right direction."
    m "只要给我指个方向就行。"

# game/script2_2.rpyc:7310
translate schinese m22afterchoice8_780faa10:

    # MC "Y-you-"
    MC "你——"

# game/script2_2.rpyc:7313
translate schinese m22afterchoice8_3bda6387:

    # m "Hey!"
    m "喂！"

# game/script2_2.rpyc:7316
translate schinese m22afterchoice8_4437610d:

    # m "Get away from him! We don't want anything to do with you! Just leave us alone!"
    m "离他远点！我们不想跟你扯上任何关系！别来烦我们！"

# game/script2_2.rpyc:7317
translate schinese m22afterchoice8_c8a76904:

    # cle "..."
    cle "……"

# game/script2_2.rpyc:7320
translate schinese m22afterchoice8_299bf360:

    # m "I said stop!"
    m "我叫你住手！"

# game/script2_2.rpyc:7323
