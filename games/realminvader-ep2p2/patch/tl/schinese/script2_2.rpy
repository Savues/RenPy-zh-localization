# game/script2_2.rpyc:13812
translate schinese m23aftergrace_ec749dab:

    # fatc "Okay... I'll try to keep it beef so I can catch up."
    fatc "好吧……我会尽量长话短说，好跟上进度。"

# game/script2_2.rpyc:13813
translate schinese m23aftergrace_2d204a49_4:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:13814
translate schinese m23aftergrace_2bb68f3f:

    # fatc "Keep it brief."
    fatc "长话短说。"

# game/script2_2.rpyc:13817
translate schinese m23aftergrace_2d204a49_5:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:13818
translate schinese m23aftergrace_99575478:

    # fatc "Anything?"
    fatc "有什么进展吗？"

# game/script2_2.rpyc:13819
translate schinese m23aftergrace_bf925449:

    # MC "Nothing, well, I don't have the most time in the world to read all of these books... but no. Nothing."
    MC "没有。呃，我没那么多时间把这些书全读一遍……不过确实没发现什么。"

# game/script2_2.rpyc:13820
translate schinese m23aftergrace_9833f9b8:

    # MC "Anything on your end?"
    MC "你那边有什么发现吗？"

# game/script2_2.rpyc:13823
translate schinese m23aftergrace_88a9c732:

    # fatc "Just old stuff... but... {i}really{/i} old stuff... medieval and earlier. I found some weaponry... swords... and things like that..."
    fatc "只是一些老物件……不过……是那种{i}非常{/i}古老的东西……中世纪甚至更早时期的。我找到了一些武器……剑之类的……"

# game/script2_2.rpyc:13824
translate schinese m23aftergrace_a2417e7f:

    # MC "Yeah, I found a stack of crossbow bolts. Think the bloodline traces back to some barons or something?"
    MC "是啊，我找到了一堆弩箭。你说这血脉是不是能追溯到什么男爵之类的家族？"

# game/script2_2.rpyc:13825
translate schinese m23aftergrace_8943fbea:

    # fatc "Wouldn't surprise me, this kind of money and land doesn't come from nowhere."
    fatc "这倒不奇怪，这么多的钱和地可不是凭空变出来的。"

# game/script2_2.rpyc:13826
translate schinese m23aftergrace_58e37044:

    # fatc "So you didn't find that magic thingy?"
    fatc "所以你没找到那个神奇的玩意儿？"

# game/script2_2.rpyc:13827
translate schinese m23aftergrace_74398e28:

    # MC "Nah, but I still feel it. I think it's on another floor."
    MC "不，但我还是能感觉到它。我觉得它在另一层。"

# game/script2_2.rpyc:13828
translate schinese m23aftergrace_997fc1f1:

    # fatc "Oh no..."
    fatc "糟糕……"

# game/script2_2.rpyc:13831
translate schinese m23aftergrace_0fcc552a:

    # fatc "It's all ladders..."
    fatc "全都是梯子……"

# game/script2_2.rpyc:13832
translate schinese m23aftergrace_7a0deec2:

    # MC "Sure is. Scared of heights?"
    MC "确实。你恐高吗？"

# game/script2_2.rpyc:13833
translate schinese m23aftergrace_f319937b:

    # fatc "N-no... I don't think so... it's just..."
    fatc "不、不……应该不是吧……只是……"

# game/script2_2.rpyc:13836
translate schinese m23aftergrace_b826f4cd:

    # fatc "I think... I'd like to take a breather first..."
    fatc "我想……我想先喘口气……"

# game/script2_2.rpyc:13837
translate schinese m23aftergrace_295ed0f7:

    # MC "Fine, I'll go. You catch up."
    MC "好吧，我先过去，你随后跟上。"

# game/script2_2.rpyc:13864
translate schinese m23aftergrace_2d204a49_6:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:13882
translate schinese m23aftergrace_d9ebec3f:

    # MC "*Sigh*"
    MC "*叹气*"

# game/script2_2.rpyc:13883
translate schinese m23aftergrace_442e881f:

    # MCt "Thank god... I was starting to worry the magic I was feeling were animated guards..."
    MCt "谢天谢地……我还担心我感应到的魔法是那些被赋予了生命的守卫呢……"

# game/script2_2.rpyc:13884
translate schinese m23aftergrace_86c3869c:

    # MCt "Wait... that magic... It's... it's definitely in this room."
    MCt "等等……那股魔法……它……它肯定就在这个房间里。"

# game/script2_2.rpyc:13885
translate schinese m23aftergrace_8d4ff314:

    # MCt "I've gotta know what it is."
    MCt "我必须弄清楚那是什么。"

# game/script2_2.rpyc:13889
translate schinese m23aftergrace_603b0bd3:

    # MC "Wh-what is..."
    MC "这……这是什么……"

# game/script2_2.rpyc:13892
translate schinese m23aftergrace_1ea2f9c0:

    # MC "It's like... it's like an arcane lock..."
    MC "看起来……看起来像是个奥术锁……"

# game/script2_2.rpyc:13893
translate schinese m23aftergrace_3af4c01b:

    # MC "But I can..."
    MC "但我能……"

# game/script2_2.rpyc:13897
translate schinese m23aftergrace_e810bf74:

    # c "*Pant* *Pant*"
    c "*喘息* *喘息*"

# game/script2_2.rpyc:13901
translate schinese m23aftergrace_e14f2f0f:

    # c "*Pant* That- *Pant* was... so... much... exercise..."
    c "*喘息* 这—— *喘息* 这运动量……也太……大了……"

# game/script2_2.rpyc:13902
translate schinese m23aftergrace_d2b14c9b:

    # c "I hate ladders... if someone pulled a ladder up from behind them I'd throw a party."
    c "我讨厌爬梯子……要是有人能把梯子收上去，我非得开个派对庆祝一下不可。"

# game/script2_2.rpyc:13903
translate schinese m23aftergrace_affbd3d9:

    # c "The party will be just me and two cans of Monster Energy, but that's {i}crazy{/i} by my standards."
    c "所谓的“派对”其实就只有我和两罐魔爪（Monster Energy）能量饮料，但按我的标准，这已经够{i}疯狂{/i}了。"

# game/script2_2.rpyc:13904
translate schinese m23aftergrace_ec0ce871:

    # MC "Chloe, come check this out, I found the magic thing."
    MC "克洛伊，快来看看这个，我找到了那个魔法玩意儿。"

# game/script2_2.rpyc:13907
translate schinese m23aftergrace_05d80dd7:

    # c "What's in it?"
    c "里面有什么？"

# game/script2_2.rpyc:13908
translate schinese m23aftergrace_fedc5a55:

    # MC "It's locked, some kind of spell."
    MC "它被锁着，像是某种法术。"

# game/script2_2.rpyc:13909
translate schinese m23aftergrace_db0fc0fa:

    # c "Huh... like a seal?"
    c "嗯……就像某种封印一样？"

# game/script2_2.rpyc:13910
translate schinese m23aftergrace_f34203aa:

    # MC "Yeah."
    MC "对。"

# game/script2_2.rpyc:13911
translate schinese m23aftergrace_b748b255:

    # c "I didn't know you could do that."
    c "我不知道你还能做到这种事。"

# game/script2_2.rpyc:13912
translate schinese m23aftergrace_2d204a49_7:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:13913
translate schinese m23aftergrace_2c6d7152:

    # MC "Neither did I..."
    MC "我也不知道……"

# game/script2_2.rpyc:13914
translate schinese m23aftergrace_776373dc:

    # c "Can you smash it?"
    c "你能把它砸开吗？"

# game/script2_2.rpyc:13915
translate schinese m23aftergrace_8c30442d:

    # MC "It's not tangible."
    MC "它没有实体。"

# game/script2_2.rpyc:13916
translate schinese m23aftergrace_b6fc2d68:

    # MC "But... I don't get it... I think it's a trap."
    MC "可是……我不明白……我觉得这是个陷阱。"

# game/script2_2.rpyc:13917
translate schinese m23aftergrace_bb00a52c:

    # c "What do you mean?"
    c "你是什么意思？"

# game/script2_2.rpyc:13918
translate schinese m23aftergrace_412901a9:

    # MC "I mean... the solution is right there."
    MC "我是说……答案就在那儿。"

# game/script2_2.rpyc:13919
translate schinese m23aftergrace_032c90a4:

    # MC "It's like a word search puzzle... but all the words are in bold typeface. I think I'm being baited... but why?"
    MC "就像那种找词游戏……只不过所有的词都加粗了。我觉得这是个诱饵……但为什么呢？"

# game/script2_2.rpyc:13920
translate schinese m23aftergrace_d3861fb4:

    # c "...Wouldn't actually locking it be better than trapping it? ... What do you think?"
    c "……直接把它锁起来，是不是比设陷阱困住它更好？……你觉得呢？"

# game/script2_2.rpyc:13924
translate schinese m23choice7_1_782ed03a:

    # MC "...Stand back..."
    MC "……退后……"

# game/script2_2.rpyc:13925
translate schinese m23choice7_1_be1758bd:

    # c "...Okay."
    c "……好吧。"

# game/script2_2.rpyc:13945
translate schinese m23choice7_1_1b82a0cb:

    # MC "It's..."
    MC "那……"

# game/script2_2.rpyc:13948
translate schinese m23choice7_1_0648caef:

    # MC "It's a book."
    MC "是一本书。"

# game/script2_2.rpyc:13949
translate schinese m23choice7_1_be73bedd:

    # c "Fucking lame, I hate reading."
    c "真够烂的，我讨厌看书。"

# game/script2_2.rpyc:13950
translate schinese m23choice7_1_9db42070:

    # MC "Real."
    MC "确实。"

# game/script2_2.rpyc:13951
translate schinese m23choice7_1_58fd0b6c:

    # MC "But this might actually be important."
    MC "但这东西说不定很重要。"

# game/script2_2.rpyc:13959
translate schinese m23choice7_1_1ba67734:

    # MC "It's handwritten... it's like... a field report... like a scientific journal."
    MC "这是手写的……看起来像……一份实地考察报告……或者某种科学日志。"

# game/script2_2.rpyc:13960
translate schinese m23choice7_1_c3187de5:

    # MC "Dated... three-hundred-one years ago."
    MC "日期是……三百零一年前。"

# game/script2_2.rpyc:13963
translate schinese m23choice7_1_27079571:

    # c "Hey, you dropped something."
    c "嘿，你掉了东西。"

# game/script2_2.rpyc:13966
translate schinese m23choice7_1_001f2d79:

    # MC "A key?"
    MC "一把钥匙？"

# game/script2_2.rpyc:13967
translate schinese m23choice7_1_def2403d:

    # c "Is it magic?"
    c "这是魔法物品吗？"

# game/script2_2.rpyc:13968
translate schinese m23choice7_1_3c6ff364:

    # MC "Yeah... you catch on quickly. I'll hold onto it, you shouldn't be able to detect it in storage, at least I hope so."
    MC "没错……你反应挺快。这东西我先收着，把它放进储物空间里应该就不会被探测到了——至少我希望如此。"

# game/script2_2.rpyc:13971
translate schinese m23choice7_1_2cbeb684:

    # c "What's it about?"
    c "上面写了什么？"

# game/script2_2.rpyc:13972
translate schinese m23choice7_1_57d13b47:

    # MC "...Wild Elves. It's kind of tricky to decipher this with the outdated English..."
    MC "……关于“野精灵”的。上面的英语很古老，解读起来有点费劲……"

# game/script2_2.rpyc:13973
translate schinese m23choice7_1_bcdb7ba0:

    # c "Mmmm... Wild Elves... they like to keep to themselves, don't they?"
    c "唔……野精灵……他们向来不怎么与外界往来，对吧？"

# game/script2_2.rpyc:13974
translate schinese m23choice7_1_aa74648e:

    # MC "Mmhm. They live in the infinite forest, spotted about once every century."
    MC "嗯。他们栖息在无尽森林里，大概每隔一个世纪才会被发现一次。"

# game/script2_2.rpyc:13975
translate schinese m23choice7_1_878c3758:

    # c "Woah. Am {i}I{/i} a Wild Elf?"
    c "哇。难道{i}我{/i}是野精灵？"

# game/script2_2.rpyc:13976
translate schinese m23choice7_1_191fd2c6:

    # MC "But yeah, they didn't get involved in the High Elf war either. I imagine they're an extremely popular subject for anthropologists. Or at least they were before they all collectively gave up."
    MC "不过确实，他们也没卷入高等精灵的那场战争。我想他们应该是人类学家眼中的热门研究对象吧。或者说，在他们集体“放弃”之前确实如此。"

# game/script2_2.rpyc:13977
translate schinese m23choice7_1_e0c85f99:

    # c "What-ologists?"
    c "什么学家？"

# game/script2_2.rpyc:13978
translate schinese m23choice7_1_76bb1d5e:

    # MC "Scientists that study people's societies."
    MC "研究人类社会的科学家。"

# game/script2_2.rpyc:13979
translate schinese m23choice7_1_2d204a49:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:13980
translate schinese m23choice7_1_562869e5:

    # MC "That can't be right..."
    MC "这不太对劲吧……"

# game/script2_2.rpyc:13981
translate schinese m23choice7_1_0f173ebb:

    # c "What is it?"
    c "什么事？"

# game/script2_2.rpyc:13982
translate schinese m23choice7_1_496d0102:

    # MC "Whoever wrote this journal is recounting spending time with the Wild Elves."
    MC "写这本日志的人，是在讲述自己与野精灵相处的经历。"

# game/script2_2.rpyc:13983
translate schinese m23choice7_1_d59f6e06:

    # c "I'm not very smart but... even I know not to believe that."
    c "我虽然不太聪明，但……连我也知道不能信这个。"

# game/script2_2.rpyc:13984
translate schinese m23choice7_1_d1445d47:

    # MC "Yeah... I wonder if this is more like fictional non-fiction."
    MC "是啊……我在想，这会不会更像是一种“虚构的纪实文学”？"

# game/script2_2.rpyc:13985
translate schinese m23choice7_1_5352a44f:

    # c "Ha! They locked it up because it makes them cringe!"
    c "哈！他们把它锁起来，肯定是因为内容让人尴尬得脚趾扣地！"

# game/script2_2.rpyc:13986
translate schinese m23choice7_1_5dc2faff:

    # MC "Hmm... right... it {i}was{/i} locked up, wasn't it? I wonder... if this stuff {i}is{/i} true... there must be a good secret in here..."
    MC "嗯……对啊……它{i}确实{/i}是被锁起来的，不是吗？我在想……如果这些事{i}是真的{/i}……这里面肯定藏着什么了不起的秘密……"

# game/script2_2.rpyc:13987
translate schinese m23choice7_1_fb4e7277:

    # c "Does it say how to find the Elves?"
    c "上面有写怎么找到那些精灵吗？"

# game/script2_2.rpyc:13988
translate schinese m23choice7_1_7a317010:

    # MC "Give me a second..."
    MC "等我一下……"

# game/script2_2.rpyc:13989
translate schinese m23choice7_1_2d204a49_1:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:13990
translate schinese m23choice7_1_f5e2825d:

    # MC "No... nothing like that... there's a little bit about their physiology."
    MC "没有……没提那个……不过倒是写了一些关于他们生理特征的内容。"

# game/script2_2.rpyc:13991
translate schinese m23choice7_1_61d8d255:

    # c "You're the exact type of person to remember all of this shit even if you're never gonna see a Wild Elf in your life."
    c "你就是那种人，哪怕这辈子都见不到一个野精灵，也会把这些破事儿全记在脑子里。"

# game/script2_2.rpyc:13992
translate schinese m23choice7_1_dfefe800:

    # MC "Heh, sounds like me for sure."
    MC "呵，确实像我会干的事。"

# game/script2_2.rpyc:13993
translate schinese m23choice7_1_86c816ba:

    # MC "Unless it's encoded in here somehow... no... no life-changing secrets."
    MC "除非这里面用了什么加密手法……不……没什么惊天大秘密。"

# game/script2_2.rpyc:13994
translate schinese m23choice7_1_40b44af5:

    # c "Maybe the lock was just for the key."
    c "也许那把锁只是为了锁住那把钥匙。"

# game/script2_2.rpyc:13995
translate schinese m23choice7_1_698177f0:

    # MC "Yeah... that might be it. Huh. Clement wrote this, it's signed."
    MC "嗯……很有可能。嘿，这是克莱门特写的，上面有签名。"

# game/script2_2.rpyc:13996
translate schinese m23choice7_1_5d648e95:

    # c "Hmm... so he's into Wild Elves? Maybe you can ask him about that when you meet."
    c "嗯……看来他对野精灵挺感兴趣？也许你见到他的时候可以问问。"

# game/script2_2.rpyc:13997
translate schinese m23choice7_1_cf8d4656:

    # MC "Maybe. Not sure I wanna tip him off to the fact that we've been snooping around, though."
    MC "也许吧。不过我不确定自己想不想让他知道我们在到处打探。"

# game/script2_2.rpyc:14000
translate schinese m23choice7_1_8b501871:

    # MC "Well, that's that. I can't wait to see what Chekhov's key goes into."
    MC "好吧，事情就是这样。真想看看“契诃夫之钥”能插进什么东西里。"

# game/script2_2.rpyc:14004
translate schinese m23choice7_2_c19228ef:

    # MC "It's too dangerous, best case scenario, it's an alarm. Worst, it kills me."
    MC "这太危险了，最好的情况是触发警报，最坏的情况……我会送命。"

# game/script2_2.rpyc:14006
translate schinese m23afterchoice7_aeed048f:

    # MC "One more floor. Let's move up."
    MC "还有一层。我们往上走吧。"

# game/script2_2.rpyc:14007
translate schinese m23afterchoice7_1f730372:

    # c "...More ladders..."
    c "……又是梯子……"

# game/script2_2.rpyc:14008
translate schinese m23afterchoice7_6044a25e:

    # c "After you."
    c "你先请。"

# game/script2_2.rpyc:14016
translate schinese m23afterchoice7_50b1b6a7:

    # c "AHH!!" with vpunch
    c "啊！！" with vpunch

# game/script2_2.rpyc:14023
translate schinese m23afterchoice7_3ba6cc49:

    # MC "Oh, shit. Yeah, Chloe, one of those got me too."
    MC "糟了。没错，克洛伊，我也中过这招。"

# game/script2_2.rpyc:14027
translate schinese m23afterchoice7_2ef3d766:

    # MC "No need to worry about it, though."
    MC "不过不用担心。"

# game/script2_2.rpyc:14028
translate schinese m23afterchoice7_823974be:

    # MC "It's just armor. No dudes or anything."
    MC "那只是副盔甲，里面没藏着什么人。"

# game/script2_2.rpyc:14043
translate schinese m23afterchoice7_ba1f266a:

    # MC "See?"
    MC "看到了吗？"

# game/script2_2.rpyc:14046
translate schinese m23afterchoice7_424dbe0a:

    # MC "Come on, let's go up."
    MC "来吧，我们上去。"

# game/script2_2.rpyc:14050
translate schinese m23afterchoice7_10184f0a:

    # MC "Wait."
    MC "等等。"

# game/script2_2.rpyc:14053
translate schinese m23afterchoice7_b4e34591:

    # MC "Chloe! When did I say that journal was dated?!"
    MC "克洛伊！我什么时候说过那本日记上有日期了？！"

# game/script2_2.rpyc:14054
translate schinese m23afterchoice7_aba97ec8:

    # c "I... forgot. Three-hundred years ago?"
    c "我……忘了。三百年前？"

# game/script2_2.rpyc:14055
translate schinese m23afterchoice7_822cd479:

    # MC "And... it was signed by Clement."
    MC "而且……上面有克莱门特的签名。"

# game/script2_2.rpyc:14056
translate schinese m23afterchoice7_c375b229:

    # MC "{b}How?!{/b} It could just not be true but... why put a red herring there if you're going to lock it anyway?"
    MC "{b}怎么可能？！{/b}也许那不是真的，但是……既然都要把它锁起来，干嘛还要放个误导线索在那儿？"

# game/script2_2.rpyc:14057
translate schinese m23afterchoice7_be910cb6:

    # c "Umm... I don't think it's a big deal..."
    c "呃……我觉得这没什么大不了的吧……"

# game/script2_2.rpyc:14058
translate schinese m23afterchoice7_48d6098d:

    # MC "The fuck do you mean it's not a big deal? This motherfucker was Crip-walking to Frédéric Chopin!"
    MC "你他妈什么意思叫“没什么大不了”？这混蛋当时可是伴着肖邦的曲子跳 Crip-walk（瘸腿舞步）呢！"

# game/script2_2.rpyc:14059
translate schinese m23afterchoice7_a5fcac3b:

    # c "No... like... have you maybe considered that he's a Clement Jr.?"
    c "不……我是说……你有没有想过，他可能是个克莱门特二世（Jr.）之类的？"

# game/script2_2.rpyc:14060
