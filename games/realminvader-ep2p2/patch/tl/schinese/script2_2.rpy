# game/script2_2.rpyc:331
translate schinese m21afterchoice1_8c8fbb61:

    # c "Umm... I can go..."
    c "唔……那我先走了……"

# game/script2_2.rpyc:332
translate schinese m21afterchoice1_5ac6034a:

    # a "Woah, sorry, we're just fucking with [name]. You and your sister can stay."
    a "很遗憾，[name]，我们只是在拿你开涮。你和你姐姐可以留下。"

