    # c "W-well- maybe-"
    c "呃——也许吧——"

# game/script2_2.rpyc:678
translate schinese m21afterchoice2_b9e25af8:

    # c "I mean- it {i}did{/i} feel safe and stuff..."
    c "我是说——它{i}确实{/i}让人感觉挺有安全感的……"

# game/script2_2.rpyc:682
translate schinese m21afterchoice2_0d36b562_1:

    # MC "..." (multiple=2)
    MC "……" (multiple=2)

# game/script2_2.rpyc:683
translate schinese m21afterchoice2_f0c78c10:

    # c "..." (multiple=2)
    c "……" (multiple=2)

# game/script2_2.rpyc:687
translate schinese m21afterchoice2_e78ba695:

    # MC "Good kitty."
    MC "乖猫咪。"

# game/script2_2.rpyc:688
translate schinese m21afterchoice2_e4a63585:

    # c "What happened to {i}profoundly stupid{/i}?"
    c "{i}“蠢得无可救药”那劲儿哪去了？{/i}"

# game/script2_2.rpyc:694
translate schinese m21afterchoice2_91372d3b:

    # MC "The tiger is cute."
    MC "这只老虎真可爱。"

# game/script2_2.rpyc:700
translate schinese m21afterchoice2_422210f2:

    # MC "But you're right, we need to get this situation under control. I doubt zookeepers make the kind of money that would wind them up at this party."
    MC "不过你说得对，我们得控制住局面。我不觉得动物园饲养员的收入能让他们出现在这种派对上。"

# game/script2_2.rpyc:701
translate schinese m21afterchoice2_ddb7b749:

    # MC "And I only see one person I'm suspecting is qualified to handle this beast."
    MC "而且，我看只有一个人有资格应付这头猛兽。"

# game/script2_2.rpyc:704
translate schinese m21afterchoice2_e39940c4:

    # c "*Gulp*"
    c "*咽口水*"

# game/script2_2.rpyc:705
translate schinese m21afterchoice2_805f372b:

    # c "What happened to him?"
    c "他怎么了？"

# game/script2_2.rpyc:706
translate schinese m21afterchoice2_28b5d819:

    # c "Is he dead?"
    c "他死了吗？"

# game/script2_2.rpyc:707
translate schinese m21afterchoice2_20748906:

    # MC "Nah."
    MC "不。"

# game/script2_2.rpyc:708
translate schinese m21afterchoice2_aae47972:

    # c "Are you sure? The tiger didn't do this, did they?"
    c "你确定吗？这应该不是老虎干的吧？"

# game/script2_2.rpyc:709
translate schinese m21afterchoice2_49dccc5b:

    # MC "I think the lack of blood gives away that this isn't a big cat's handiwork."
    MC "现场没有血迹，这说明并非大型猫科动物所为。"

# game/script2_2.rpyc:712
translate schinese m21afterchoice2_54572fe2:

    # MC "Nope."
    MC "不。"

# game/script2_2.rpyc:713
translate schinese m21afterchoice2_c1ca15e6:

    # MC "This culprit is a classic real-life villain."
    MC "这个凶手是个典型的现实反派。"

# game/script2_2.rpyc:716
translate schinese m21afterchoice2_c73f4cc9:

    # MC "Completely empty."
    MC "空空如也。"

# game/script2_2.rpyc:717
translate schinese m21afterchoice2_89aefe22:

    # c "I see."
    c "我明白了。"

# game/script2_2.rpyc:718
translate schinese m21afterchoice2_11564bbd:

    # c "I don't see anything else. No signs of an accident or anything."
    c "没发现别的什么。没有发生事故或其他状况的迹象。"

# game/script2_2.rpyc:719
translate schinese m21afterchoice2_1fb4d2be:

    # MC "Nope, he really just drank himself to sleep."
    MC "没错，他真的只是喝醉睡着了。"

# game/script2_2.rpyc:720
translate schinese m21afterchoice2_72026a2f:

    # c "Aww. Where's the dramatic mystery to solve?"
    c "哎呀。那那种充满戏剧性的悬疑谜团去哪儿了？"

# game/script2_2.rpyc:721
translate schinese m21afterchoice2_3fcca791:

    # MC "Sorry. No crime scene investigations today. There's always next time."
    MC "抱歉。今天没有犯罪现场调查可做。不过总会有机会的。"

# game/script2_2.rpyc:724
translate schinese m21afterchoice2_bf7a5a0a:

    # c "Are you going to behave yourself?"
    c "你会安分点吗？"

# game/script2_2.rpyc:732
translate schinese m21afterchoice2_b3303e97:

    # c "Can you wait right here?"
    c "你能在这儿等一下吗？"

# game/script2_2.rpyc:739
translate schinese m21afterchoice2_e897fbb0:

    # c "Thank you."
    c "谢谢你。"

# game/script2_2.rpyc:742
translate schinese m21afterchoice2_06486ad6:

    # c "We need to wake him up, don't we?"
    c "我们得把他叫醒，对吧？"

# game/script2_2.rpyc:743
translate schinese m21afterchoice2_039bbafb:

    # MC "Mmhm. Go ahead."
    MC "嗯。去吧。"

# game/script2_2.rpyc:744
translate schinese m21afterchoice2_5547027a:

    # c "W-what? No... You said {i}you'd{/i} do the talking."
    c "什、什么？不……你明明说{i}你会{/i}负责交涉的。"

# game/script2_2.rpyc:745
translate schinese m21afterchoice2_4314b58b:

    # MC "I just wanted to see if you'd actually do it. Don't worry, I made a promise."
    MC "我只是想看看你是不是真的会去做。别担心，我既然答应了就会做到。"

# game/script2_2.rpyc:746
translate schinese m21afterchoice2_6723ac6e:

    # c "You um... didn't actually promise that..."
    c "你……呃……其实并没有那样承诺过……"

# game/script2_2.rpyc:747
translate schinese m21afterchoice2_c2c95610:

    # MC "That's 'cause I be lying sometimes."
    MC "那是因为我有时候会撒谎。"

# game/script2_2.rpyc:748
translate schinese m21afterchoice2_27d3d049:

    # c "Mm..."
    c "唔……"

# game/script2_2.rpyc:749
translate schinese m21afterchoice2_c092b3d3:

    # MC "Don't worry. I promise."
    MC "别担心。我保证。"

# game/script2_2.rpyc:752
translate schinese m21afterchoice2_87cf9d66:

    # MC "Hey, buddy. Your feline friend has gotten loose."
    MC "嘿，伙计。你的猫朋友跑出来了。"

# game/script2_2.rpyc:753
translate schinese m21afterchoice2_95287584:

    # MC "I'm starting to worry that it'll step on a butterfly at this rate."
    MC "照这样下去，我开始担心它会踩死一只蝴蝶了。"

# game/script2_2.rpyc:754
translate schinese m21afterchoice2_d5060e1f:

    # MC "Perhaps even knock over a glass."
    MC "甚至可能会打翻一个杯子。"

# game/script2_2.rpyc:755
translate schinese m21afterchoice2_948e8af3:

    # c "Slap him a little."
    c "稍微拍它一下。"

# game/script2_2.rpyc:758
translate schinese m21afterchoice2_8c99d51c:

    # MC "And just like that, your violent streak rears its ugly head."
    MC "瞧，你那暴力的一面又暴露出来了。"

# game/script2_2.rpyc:759
translate schinese m21afterchoice2_e344fe6a:

    # c "I don't have a violent streak."
    c "我没有暴力倾向。"

# game/script2_2.rpyc:760
translate schinese m21afterchoice2_866e303f:

    # MC "I have permanent scarring on my neck from your savage assault a few days ago."
    MC "几天前你那次野蛮的袭击，害我脖子上留下了永久的伤疤。"

# game/script2_2.rpyc:761
translate schinese m21afterchoice2_e15d81ba:

    # MC "Now you have a taste for my blood."
    MC "你现在尝到我的血了。"

# game/script2_2.rpyc:762
translate schinese m21afterchoice2_403ee49d:

    # c "You can take it."
    c "你可以拿去。"

# game/script2_2.rpyc:763
translate schinese m21afterchoice2_d6e7923a:

    # MC "Yeah, well, you're a level one barbarian so I think I'm safe."
    MC "是啊，不过你只是个一级野蛮人，所以我应该很安全。"

# game/script2_2.rpyc:764
translate schinese m21afterchoice2_11dc7ff2:

    # c "I prefer playing as a sorcerer anyway."
    c "反正我更喜欢玩术士。"

# game/script2_2.rpyc:765
translate schinese m21afterchoice2_155dea3e:

    # MC "Not a wizard?"
    MC "不是法师吗？"

# game/script2_2.rpyc:766
translate schinese m21afterchoice2_0399e75f:

    # c "Do you think I'm a fucking nerd or something? That's your wheelhouse."
    c "你以为我是什么死宅吗？那是你的强项。"

# game/script2_2.rpyc:767
translate schinese m21afterchoice2_eb750435:

    # MC "Anyway..."
    MC "总之……"

# game/script2_2.rpyc:770
translate schinese m21afterchoice2_b9b0f925:

    # MC "Slapping; not the best way to rouse an unconscious person. It even comes with a very tiny risk of brain damage."
    MC "扇耳光可不是唤醒昏迷之人的好办法。甚至还有极小的脑损伤风险。"

# game/script2_2.rpyc:771
translate schinese m21afterchoice2_506c11b1:

    # c "What are you doing?"
    c "你在干什么？"

# game/script2_2.rpyc:772
translate schinese m21afterchoice2_f7b0f6b2:

    # MC "I'm gonna give him a sternal rub."
    MC "我要给他做胸骨按压刺激。"

# game/script2_2.rpyc:773
translate schinese m21afterchoice2_c8dcba10:

    # c "A... sternal..."
    c "胸……胸骨……"

# game/script2_2.rpyc:774
translate schinese m21afterchoice2_1ec8ab6c:

    # c "That's uh... Mm..."
    c "那是……嗯……"

# game/script2_2.rpyc:775
translate schinese m21afterchoice2_338ccf96:

    # MC "Come on, sounds like you're close."
    MC "来吧，听起来你快想起来了。"

# game/script2_2.rpyc:776
translate schinese m21afterchoice2_b2e7eb3a:

    # c "I don't think I remember."
    c "我想不起来了。"

# game/script2_2.rpyc:777
translate schinese m21afterchoice2_37476535:

    # MC "Where's my hand?"
    MC "我的手在哪儿？"

# game/script2_2.rpyc:778
translate schinese m21afterchoice2_e8eb30a6:

    # c "...Oh... it's the bone in the middle of the chest."
    c "……哦……就是胸部中间的那块骨头。"

# game/script2_2.rpyc:779
translate schinese m21afterchoice2_6b95148f:

    # MC "You got it."
    MC "你说对了。"

# game/script2_2.rpyc:782
translate schinese m21afterchoice2_6576fb96:

    # c "So what are you doing? \"Sternal rub\"?"
    c "那你现在在做什么？“胸骨按压”？"

# game/script2_2.rpyc:783
translate schinese m21afterchoice2_c7d0d784:

    # MC "You dig your knuckles into their sternum and grind them around."
    MC "你用指关节用力抵住对方的胸骨，并来回研磨。"

# game/script2_2.rpyc:784
translate schinese m21afterchoice2_0a748695:

    # MC "It hurts like a motherfucker, and anyone with a functioning brain isn't going to take it in silence."
    MC "这痛得要命，只要脑子没坏的人，都不可能默默忍受。"

# game/script2_2.rpyc:785
translate schinese m21afterchoice2_037483eb:

    # c "What? No way. You just rub their chest?"
    c "什么？不会吧。只是揉揉胸口就行了？"

# game/script2_2.rpyc:786
translate schinese m21afterchoice2_8810d417:

    # c "I don't believe that's better than a slap."
    c "我不信这招比扇耳光还管用。"

# game/script2_2.rpyc:794
translate schinese m21choice3_2_66e07760:

    # c "???"
    c "？？？"

# game/script2_2.rpyc:807
translate schinese m21choice3_2_686f29ff:

    # c "OWWWW!!" with vpunch
    c "哎哟！！" with vpunch

# game/script2_2.rpyc:810
translate schinese m21choice3_2_eca9a752:

    # c "Why would you do that?! It hurt!"
    c "你干嘛？！好痛啊！"

# game/script2_2.rpyc:811
translate schinese m21choice3_2_278dcbd1:

    # MC "You didn't believe me."
    MC "你不相信我嘛。"

# game/script2_2.rpyc:812
translate schinese m21choice3_2_9532d001:

    # c "Well, you didn't have to just hurt me like that!"
    c "就算不信，也没必要那样弄痛我吧！"

# game/script2_2.rpyc:813
translate schinese m21choice3_2_26b37a68:

    # c "That's not funny."
    c "这可一点也不好笑。"

# game/script2_2.rpyc:814
translate schinese m21choice3_2_24d8eead:

    # MC "...S-sorry..."
    MC "……对、对不起……"

# game/script2_2.rpyc:815
translate schinese m21choice3_2_d184cf3d:

    # c "Please don't do anything like that again."
    c "请不要再做这种事了。"

# game/script2_2.rpyc:818
translate schinese m21choice3_3_61dd7050:

    # MC "Want me to try it on you?"
    MC "要我拿你试试看吗？"

# game/script2_2.rpyc:821
translate schinese m21choice3_3_61fa350a:

    # c "Mm... what if it hurts as much as you say it does?"
    c "唔……要是真像你说的那样痛怎么办？"

# game/script2_2.rpyc:822
translate schinese m21choice3_3_82a77f05:

    # MC "It will."
    MC "会很痛的。"

# game/script2_2.rpyc:823
translate schinese m21choice3_3_8fb97665:

    # MC "I can be gentle."
    MC "我会轻一点的。"

# game/script2_2.rpyc:824
translate schinese m21choice3_3_d19f855d:

    # c "..."
    c "……"

# game/script2_2.rpyc:827
translate schinese m21choice3_3_6513152b:

    # c "J-just a little... okay..."
    c "就……就一点点……好吧……"

# game/script2_2.rpyc:828
translate schinese m21choice3_3_21bc13f2:

    # c "I can take it..."
    c "我能忍住的……"

# game/script2_2.rpyc:829
translate schinese m21choice3_3_6e26e895:

    # MC "Eheh. Trying to act cool?"
    MC "嘿嘿。想装酷啊？"

# game/script2_2.rpyc:830
translate schinese m21choice3_3_662f11c2:

    # c "No. I'm always cool. I just... don't believe you."
    c "不。我本来就很酷。我只是……不相信你。"

# game/script2_2.rpyc:846
translate schinese m21choice3_3_a5fba5af:

    # c "OWWW!!!" with vpunch
    c "哎哟！！！" with vpunch

# game/script2_2.rpyc:847
translate schinese m21choice3_3_d951b589:

    # c "Why the fuck does that hurt so much?!"
    c "这他妈怎么这么痛啊？！"

# game/script2_2.rpyc:848
translate schinese m21choice3_3_1a0611b4:

    # c "Aaahhh, the one time I decide to face pain and I regret it immediately!"
    c "啊——！难得我想勇敢面对一次疼痛，结果马上就后悔了！"

# game/script2_2.rpyc:849
translate schinese m21choice3_3_b67a9d04:

    # MC "Told you."
    MC "早就跟你说了吧。"

# game/script2_2.rpyc:850
translate schinese m21choice3_3_e80884fb:

    # c "How long until it stops hurting?"
    c "还要多久才不疼啊？"

# game/script2_2.rpyc:851
translate schinese m21choice3_3_8e2e6b32:

    # MC "I dunno. Not long, like two minutes."
    MC "不知道。应该很快，也就两分钟吧。"

# game/script2_2.rpyc:852
translate schinese m21choice3_3_0c49ac87:

    # c "Mm... gonna be a shitty two minutes..."
    c "唔……这两分钟可真够受的……"

# game/script2_2.rpyc:853
translate schinese m21choice3_3_3777e62b:

    # MC "Aw. Do you want me to kiss it better?"
    MC "哎呀。要我亲亲帮你止痛吗？"

# game/script2_2.rpyc:857
translate schinese m21choice3_3_ed06adcd:

    # c "Ha-ha. No thanks, I'll be just fine."
    c "哈哈。不用了，我一个人没问题。"

# game/script2_2.rpyc:858
translate schinese m21choice3_3_d9e7c230:

    # MC "Oh, wow, you're such a big girl now."
    MC "哇，你现在真是个大姑娘了呢。"

# game/script2_2.rpyc:859
translate schinese m21choice3_3_22c28f19:

    # MC "Come on, let's wake this nerd up."
    MC "来吧，把这个书呆子叫醒。"

# game/script2_2.rpyc:864
translate schinese m21choice3_3_d19f855d_1:

    # c "..."
    c "……"

# game/script2_2.rpyc:865
translate schinese m21choice3_3_e5a9d3f8:

    # c "That..."
    c "那个……"

# game/script2_2.rpyc:866
translate schinese m21choice3_3_3dfea2f0:

    # c "Might help..."
    c "也许会有帮助……"

# game/script2_2.rpyc:867
translate schinese m21choice3_3_af200dad:

    # c "Just a little bit..."
    c "就一点点……"

# game/script2_2.rpyc:870
translate schinese m21choice3_3_2d204a49:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:871
translate schinese m21choice3_3_05efe3ae:

    # MC "Umm... I mean..."
    MC "嗯……我是说……"

# game/script2_2.rpyc:872
translate schinese m21choice3_3_e153663b:

    # MC "It was just a joke but... if you wanna..."
    MC "本来只是开个玩笑，不过……如果你想的话……"

# game/script2_2.rpyc:875
translate schinese m21choice3_3_babff610:

    # c "Ahaha! Well, if it was just a joke then- I-I was joking too!"
    c "啊哈哈！既然只是开玩笑，那——我——我也只是在开玩笑啦！"

# game/script2_2.rpyc:880
translate schinese m21choice3_3_ddd99bb0:

    # MC "*Kiss*"
    MC "*亲吻*"

# game/script2_2.rpyc:883
translate schinese m21choice3_3_ca3d278d:

    # MC "Sorry for hurting you."
    MC "对不起，伤害了你。"

# game/script2_2.rpyc:889
translate schinese m21choice3_3_a4e625d7:

    # c "!!!"
    c "！！！"

# game/script2_2.rpyc:890
translate schinese m21choice3_3_0e29e827:

    # c "W-"
    c "叫——"

# game/script2_2.rpyc:891
translate schinese m21choice3_3_676cb2f3:

    # c "Wake him up!"
    c "叫醒他！"

# game/script2_2.rpyc:892
translate schinese m21choice3_3_56c9cbc1:

    # MC "Right..."
    MC "对……"

# game/script2_2.rpyc:895
translate schinese m21choice3_3_b9820b7c:

    # c "N-no..."
    c "不……"

# game/script2_2.rpyc:896
translate schinese m21choice3_3_2214e6a0:

    # c "Like that's gonna help."
    c "那能有什么用啊。"

# game/script2_2.rpyc:901
translate schinese m21afterchoice3_4ba06c62:

    # MC "Three, two, one."
    MC "三、二、一。"

# game/script2_2.rpyc:914
translate schinese m21afterchoice3_d313f627:

    # hand "YEOWCH!!! STOP!!" with vpunch
    hand "哎哟！！！停下！！" with vpunch

# game/script2_2.rpyc:917
translate schinese m21afterchoice3_ac8fc885:

    # hand "*Groans* My head. I thought I told you not to wake me up with sternal rubs when I've been drinking."
    hand "*呻吟* 我的头。我记得我跟你说过，我喝醉的时候别用按压胸骨的方法叫醒我。"

# game/script2_2.rpyc:918
translate schinese m21afterchoice3_1737d2ea:

    # MC "I don't recall you ever telling me what to do or what not to do."
    MC "我不记得你曾告诉过我该做什么或不该做什么。"

# game/script2_2.rpyc:919
translate schinese m21afterchoice3_bc827cee:

    # hand "Hmm?"
    hand "嗯？"

# game/script2_2.rpyc:922
translate schinese m21afterchoice3_8b251ae4:

    # hand "Oh... You're not my wife."
    hand "噢……你不是我老婆。"

# game/script2_2.rpyc:923
translate schinese m21afterchoice3_3b800056:

    # MC "I could be, what's your income?"
    MC "我可以是啊，你收入多少？"

# game/script2_2.rpyc:924
translate schinese m21afterchoice3_546b9b8f:

    # c "Oh no. He's a gold digger."
    c "噢不，他是个图财的家伙。"

# game/script2_2.rpyc:925
translate schinese m21afterchoice3_e247291f:

    # hand "Heh, there's no way I'm making more than any of you guys, that's for sure."
    hand "呵，我的收入肯定没法跟你们任何一个人比，这是肯定的。"

# game/script2_2.rpyc:926
translate schinese m21afterchoice3_ad52aa72:

    # hand "You {i}are{/i} guests, right?"
    hand "你们{i}确实{/i}是客人，对吧？"

# game/script2_2.rpyc:927
translate schinese m21afterchoice3_f089b492:

    # MC "Mmhm."
    MC "嗯。"

# game/script2_2.rpyc:928
translate schinese m21afterchoice3_0bbbaa3c:

    # hand "Aww, crap."
    hand "噢，糟了。"

# game/script2_2.rpyc:929
translate schinese m21afterchoice3_eaff61e6:

    # MC "Uh oh. That doesn't sound good."
    MC "呃噢。听起来不太妙。"

# game/script2_2.rpyc:932
translate schinese m21afterchoice3_e2de0316:

    # hand "*Sigh* No, it's fine in the grand scheme of things. I was supposed to be awake before all of you showed up."
    hand "*叹气* 不，其实也没什么大不了的。我本来应该在你们大家到这儿之前就醒了的。"

# game/script2_2.rpyc:933
translate schinese m21afterchoice3_3d3f379b:

    # MC "Are you aware that you've got a..."
    MC "你知道你有一只……"

# game/script2_2.rpyc:934
translate schinese m21afterchoice3_e3e1a8b1:

    # MC "How much do tigers weigh?"
    MC "老虎有多重？"

# game/script2_2.rpyc:935
translate schinese m21afterchoice3_cf986da5:

    # c "Somewhere in the realm of one-hundred-twenty kilos."
    c "大概在一百二十公斤左右。"

# game/script2_2.rpyc:936
translate schinese m21afterchoice3_3d4866e7:

    # MC "Are you aware that you've got a one-hundred-twenty kilo feline running around?"
    MC "你知道你有一只一百二十公斤重的猫科动物在到处乱跑吗？"

# game/script2_2.rpyc:937
translate schinese m21afterchoice3_2d204a49:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:947
translate schinese m21afterchoice3_4e706721:

    # MC "Why did you know that?"
    MC "你怎么会知道那个？"

# game/script2_2.rpyc:950
translate schinese m21afterchoice3_8c3eae49:

    # c "It's literally the only fun fact about tigers I have memorized. You got lucky."
    c "那可是我关于老虎唯一记住的趣闻。算你走运。"

# game/script2_2.rpyc:953
translate schinese m21afterchoice3_9c0a6929:

    # hand "Her name's Nala and she weighs one-hundred-eight."
    hand "她叫娜拉，体重是一百零八公斤。"

# game/script2_2.rpyc:954
translate schinese m21afterchoice3_6f8f2d04:

    # MC "Nala? I hate to break it to you but she's not a lion."
    MC "娜拉？很抱歉得告诉你，她可不是狮子。"

# game/script2_2.rpyc:955
translate schinese m21afterchoice3_f5f20049:

    # hand "Hugo named her when he was about eight years old, we all humored him."
    hand "那是雨果八岁左右给她起的名字，我们当时都顺着他的意。"

# game/script2_2.rpyc:956
translate schinese m21afterchoice3_caf8ea9b:

    # hand "He loved that movie. Who doesn't?"
    hand "他特别喜欢那部电影。谁不喜欢呢？"

# game/script2_2.rpyc:957
translate schinese m21afterchoice3_6cb05c49:

    # hand "But yes, I'm aware that she isn't a lion."
    hand "不过，我当然知道她不是狮子。"

# game/script2_2.rpyc:958
translate schinese m21afterchoice3_ea801829:

    # MC "So she {i}is{/i} Hugo's pet..."
    MC "所以她{i}确实{/i}算是雨果的宠物……"

# game/script2_2.rpyc:959
translate schinese m21afterchoice3_a67fe9b5:

    # hand "A tiger isn't a god-damn pet, but good luck convincing Hugo. Didn't work for anyone else."
    hand "老虎可不是什么该死的宠物，但你想说服雨果？祝你好运吧。别人都没成功过。"

# game/script2_2.rpyc:960
translate schinese m21afterchoice3_56407c0e:

    # MC "What's with her disposition?"
    MC "她的脾气怎么回事？"

# game/script2_2.rpyc:961
translate schinese m21afterchoice3_f17c2d5d:

    # hand "Raised as a pet since birth. She's a giant house cat."
    hand "打小就是当宠物养大的。她就是只巨大的家猫。"

# game/script2_2.rpyc:962
translate schinese m21afterchoice3_113edb15:

    # MC "House cats still scratch."
    MC "家猫也是会抓人的。"

# game/script2_2.rpyc:963
translate schinese m21afterchoice3_b9cff74a:

    # hand "..."
    hand "……"

# game/script2_2.rpyc:969
translate schinese m21afterchoice3_c5fe6051:

    # hand "Destroy this camera."
    hand "把这台摄像机毁掉。"

# game/script2_2.rpyc:970
translate schinese m21afterchoice3_19570c32:

    # MC "What?"
    MC "什么？"

# game/script2_2.rpyc:971
translate schinese m21afterchoice3_dfc6e638:

    # hand "I don't care how you do it, it's gotta go."
    hand "我不管你怎么做，反正它必须消失。"

# game/script2_2.rpyc:972
translate schinese m21afterchoice3_0f95daa9:

    # hand "I can't be seen with it, I don't want anyone to suspect {i}anything{/i}. Please."
    hand "我不能让人看见我拿着它，我不想让任何人起{i}疑{/i}心。拜托了。"

# game/script2_2.rpyc:973
translate schinese m21afterchoice3_7d0995c1:

    # MC "No way, not without an explanation."
    MC "不行，除非给我个解释。"

# game/script2_2.rpyc:974
translate schinese m21afterchoice3_7ec0ae2e:

    # hand "*Tsk* If you haven't put two and two together, I'm {i}not{/i} supposed to be letting Nala run loose."
    hand "*啧*，如果你还没明白的话——我本来是{i}不{/i}该让娜拉到处乱跑的。"

# game/script2_2.rpyc:975
translate schinese m21afterchoice3_7ee83585:

    # hand "Normally, it wouldn't be a problem, but with all the guests today, she needs to be locked up for everyone's safety."
    hand "平时这倒没什么，但今天客人这么多，为了大家的安全，必须把她关起来。"

# game/script2_2.rpyc:976
translate schinese m21afterchoice3_c24e2530:

    # hand "*Sigh* Today is a special occasion, so I accidentally cut a little too loose earlier, had my wife show up."
    hand "*叹气*，今天是特殊场合，我一时疏忽，稍微放松了点警惕，结果被我老婆撞见了。"

# game/script2_2.rpyc:977
translate schinese m21afterchoice3_3ce46165:

    # hand "{b}Don't{/b} give a drunk guy a camera. He might record his crimes."
    hand "{b}别{/b}把摄像机交给醉汉，他可能会把自己的犯罪过程拍下来。"

# game/script2_2.rpyc:978
translate schinese m21afterchoice3_a359ea62:

    # hand "Listen, just destroy that thing for me, please? I won't blabber about your trespassing if blackmail is more of your thing."
    hand "听着，帮我把那玩意儿毁了，好吗？如果你更喜欢搞勒索那一套，我就不会把你的擅自闯入说出去。"

# game/script2_2.rpyc:981
translate schinese m21afterchoice3_563626b4:

    # c "...You can just delete the-"
    c "……你大可以把那个——"

# game/script2_2.rpyc:985
translate schinese m21afterchoice3_60c4b035:

    # MC "Brave of you to trust us, but you made the right call."
    MC "敢信任我们，你很有胆识，不过你做出了正确的选择。"

# game/script2_2.rpyc:986
translate schinese m21afterchoice3_f97e8645:

    # MC "We'll dispose of this thing, don't worry."
    MC "我们会处理掉这个东西的，别担心。"

# game/script2_2.rpyc:987
translate schinese m21afterchoice3_f70537b6:

    # hand "*Exhale* Thank you so much! You're kind people."
    hand "*呼气* 太感谢了！你们真是好人。"

# game/script2_2.rpyc:988
translate schinese m21afterchoice3_b48b072e:

    # hand "I need to clean up this room, hide my mistakes, then I can lock up the cat."
    hand "我得把这房间收拾一下，掩盖我犯的错，然后把猫关起来。"

# game/script2_2.rpyc:991
translate schinese m21afterchoice3_6e1b516c:

    # c "Why did you stop me?"
    c "你为什么要拦住我？"

# game/script2_2.rpyc:992
translate schinese m21afterchoice3_2d204a49_1:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:995
translate schinese m21afterchoice3_7c8f0863:

    # MC "Free camera."
    MC "自由视角。"

# game/script2_2.rpyc:996
translate schinese m21afterchoice3_d19f855d:

    # c "..."
    c "……"

# game/script2_2.rpyc:999
translate schinese m21afterchoice3_d3075fa0:

    # MC "Let's see what kind of \"evidence\" we have our hands on."
    MC "来看看我们到底弄到了什么样的“证据”。"

# game/script2_2.rpyc:1000
translate schinese m21afterchoice3_2d204a49_2:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:1001
translate schinese m21afterchoice3_d19f855d_1:

    # c "..."
    c "……"

# game/script2_2.rpyc:1002
translate schinese m21afterchoice3_a5b71841:

    # MC "Oh, wow."
    MC "噢，天哪。"

# game/script2_2.rpyc:1005
translate schinese m21afterchoice3_55548f54:

    # MC "That's our ninth pitch-black photograph in a row."
    MC "这已经是连续第九张漆黑一片的照片了。"

# game/script2_2.rpyc:1006
translate schinese m21afterchoice3_cb869a45:

    # MC "Some evidence we've got here."
    MC "这算哪门子证据啊。"

# game/script2_2.rpyc:1007
translate schinese m21afterchoice3_edbd2c10:

    # MC "What do you think, Chloe? Power outage? Just turned the lights off?"
    MC "你觉得呢，克洛伊？是停电了吗？还是只是把灯关了？"

# game/script2_2.rpyc:1008
translate schinese m21afterchoice3_73b63f33:

    # MC "EMP conveniently triggering every time the handler pressed the shutter?"
    MC "每次操作者按下快门时，EMP 都会恰好触发？"

# game/script2_2.rpyc:1017
translate schinese m21afterchoice3_bc6e53f0:

    # MC "*Groan*"
    MC "*呻吟*"

# game/script2_2.rpyc:1018
translate schinese m21afterchoice3_dda07103:

    # c "He left the lens cap on."
    c "他没摘镜头盖。"

# game/script2_2.rpyc:1019
translate schinese m21afterchoice3_65bdb844:

    # MC "I can see that."
    MC "我看得出来。"

# game/script2_2.rpyc:1020
translate schinese m21afterchoice3_a404eebe:

    # c "I don't think he's very good with technology."
    c "我觉得他不太擅长使用科技产品。"

# game/script2_2.rpyc:1021
translate schinese m21afterchoice3_4ce90fc9:

    # MC "I can see that too."
    MC "这点我也看出来了。"

# game/script2_2.rpyc:1024
translate schinese m21afterchoice3_4481d2dc:

    # MC "Here. You can have it."
    MC "给，这个归你了。"

# game/script2_2.rpyc:1025
translate schinese m21afterchoice3_1a0e2928:

    # c "W-why?"
    c "什……为什么？"

# game/script2_2.rpyc:1026
translate schinese m21afterchoice3_36976156:

    # MC "Gives you something to do, doesn't it?"
    MC "这样你就有点事做了，不是吗？"

# game/script2_2.rpyc:1027
translate schinese m21afterchoice3_2279c00f:

    # MC "Don't have to talk to anyone, don't need to step out of the shadows."
    MC "既不用跟人说话，也不必走出阴影。"

# game/script2_2.rpyc:1028
translate schinese m21afterchoice3_d19f855d_2:

    # c "..."
    c "……"

# game/script2_2.rpyc:1029
translate schinese m21afterchoice3_4446bf23:

    # MC "Get some cool shots to show Vineeta."
    MC "还能拍些酷照片给维妮塔看。"

# game/script2_2.rpyc:1030
translate schinese m21afterchoice3_4200c637:

    # MC "Take one of me and the tiger. I wanna give Miya a heart attack."
    MC "帮我和那只老虎拍张照吧。我想把米娅吓一跳。"

# game/script2_2.rpyc:1033
translate schinese m21afterchoice3_b0a67ddf:

    # MC "Better in your hands than mine. I don't even know how to take a convincing selfie."
    MC "还是你来拍吧。我根本不知道怎么自拍才显得自然。"

# game/script2_2.rpyc:1034
translate schinese m21afterchoice3_89e0ead7:

    # MC "Wait... I've probably taken more selfies than {i}you{/i} have now that I think about it..."
    MC "等等……仔细想想，我自拍的次数可能比{i}你{/i}还多呢……"

# game/script2_2.rpyc:1035
translate schinese m21afterchoice3_1f6ffc00:

    # MC "Chloe, do you ever take selfies?" (multiple=2)
    MC "克洛伊，你会自拍吗？" (multiple=2)

# game/script2_2.rpyc:1036
translate schinese m21afterchoice3_a7e3ca57:

    # c "There {i}is{/i} one." (multiple=2)
    c "这里{i}有{/i}一张。" (multiple=2)

# game/script2_2.rpyc:1037
translate schinese m21afterchoice3_100c1bcb:

    # MC "What was that?"
    MC "你说什么？"

# game/script2_2.rpyc:1038
translate schinese m21afterchoice3_d5f9be8a:

    # c "There {i}is{/i} a photo on here."
    c "这里{i}有{/i}一张照片。"

# game/script2_2.rpyc:1041
translate schinese m21afterchoice3_03a8b6ae:

    # MC "Oh, is there? Anything important?"
    MC "哦，真的吗？有什么重要的内容吗？"

# game/script2_2.rpyc:1042
translate schinese m21afterchoice3_1f7f9333:

    # c "I don't know... looks mundane in a sense..."
    c "不知道……看起来挺普通的……"

# game/script2_2.rpyc:1045
translate schinese m21afterchoice3_2d204a49_3:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:1046
translate schinese m21afterchoice3_0dfed82e:

    # c "Hugo, an Elf. Looks like they're friends."
    c "雨果，一位精灵。看来他们是朋友。"

# game/script2_2.rpyc:1047
translate schinese m21afterchoice3_31943181:

    # c "They look similar in age so probably a classmate or peer of some kind."
    c "看样子年纪相仿，大概是同学或同龄人吧。"

# game/script2_2.rpyc:1048
translate schinese m21afterchoice3_9890eb72:

    # c "If I were to guess, that picture was taken here at this palace."
    c "我猜这张照片是在这座宫殿里拍的。"

# game/script2_2.rpyc:1049
translate schinese m21afterchoice3_49000c2d:

    # c "Look at the timestamp. Early this afternoon."
    c "看时间戳，是今天下午早些时候拍的。"

# game/script2_2.rpyc:1054
translate schinese m21afterchoice3_52eb6ba2:

    # c "I wonder whose camera this is. The handler can barely operate it."
    c "不知道这是谁的相机。拿相机的人似乎不太会用。"

# game/script2_2.rpyc:1055
translate schinese m21afterchoice3_b79d3129:

    # c "But this is the only photo on it, and it was taken today. Maybe the handler stole it."
    c "但这上面只有这一张照片，而且就是今天拍的。也许是拿相机的人偷来的。"

# game/script2_2.rpyc:1056
translate schinese m21afterchoice3_0a9c7149:

    # c "Or it was just a gift."
    c "或者只是别人送的礼物。"

# game/script2_2.rpyc:1059
translate schinese m21afterchoice3_4e0a716e:

    # c "I guess it doesn't matter, does it?"
    c "我想这也不重要吧？"

# game/script2_2.rpyc:1060
translate schinese m21afterchoice3_d21a3b80:

    # c "[name]?"
    c "[name]？"

# game/script2_2.rpyc:1061
translate schinese m21afterchoice3_2d204a49_4:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:1063
translate schinese m21afterchoice3_a4057d8d:

    # c "[name]. You're spacing out again."
    c "[name]，你又在走神了。"

# game/script2_2.rpyc:1064
translate schinese m21afterchoice3_2d204a49_5:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:1070
translate schinese m21afterchoice3_5d312dc8:

    # MC "Huh? Oh, I'm fine."
    MC "嗯？哦，我没事。"

# game/script2_2.rpyc:1071
translate schinese m21afterchoice3_d9a1ee3b:

    # MC "You were really doing a deep dive back there, weren't you?"
    MC "刚才你观察得还挺仔细的嘛，对吧？"

# game/script2_2.rpyc:1075
translate schinese m21afterchoice3_97463154:

    # c "W-what?"
    c "什、什么？"

# game/script2_2.rpyc:1076
translate schinese m21afterchoice3_7feeae19:

    # c "I was just saying what I saw is all..."
    c "我只是随口说说我看到的而已……"

# game/script2_2.rpyc:1077
translate schinese m21afterchoice3_6fddaeed:

    # c "They might {i}not{/i} be classmates. They could be relatives, a cousin, even a half-brother."
    c "他们未必是同学。也可能是亲戚，比如表亲，甚至是同父异母（或同母异父）的兄弟。"

# game/script2_2.rpyc:1078
translate schinese m21afterchoice3_066e199e:

    # MC "He's an Elf."
    MC "他是精灵。"

# game/script2_2.rpyc:1079
translate schinese m21afterchoice3_89c4f70d:

    # c "So? Elf genes override human genes just like every other race."
    c "那又怎样？精灵的基因和其他种族一样，也是会盖过人类基因的。"

# game/script2_2.rpyc:1080
translate schinese m21afterchoice3_2d204a49_6:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:1081
translate schinese m21afterchoice3_d19f855d_3:

    # c "..."
    c "……"

# game/script2_2.rpyc:1084
translate schinese m21afterchoice3_d53af704:

    # c "I like the mystery genre..."
    c "我喜欢悬疑类作品……"

# game/script2_2.rpyc:1086
translate schinese m21afterchoice3_03483bfe:

    # MC "Never given it a shot."
    MC "我从来没尝试过。"

# game/script2_2.rpyc:1087
translate schinese m21afterchoice3_4a45b380:

    # c "I think you'd like it. I think you'd take it as a challenge to outsmart the author before the end."
    c "我觉得你会喜欢的。我觉得你会把它当成一种挑战，想在结局揭晓前就识破作者的意图。"

# game/script2_2.rpyc:1088
translate schinese m21afterchoice3_19780bbe:

    # MC "Maybe if I had {i}your{/i} competitive streak."
    MC "也许吧，如果我有你{i}那种{/i}好胜心的话。"

# game/script2_2.rpyc:1091
translate schinese m21afterchoice3_f7f03959:

    # c "I don't have a competitive streak."
    c "我可没什么好胜心。"

# game/script2_2.rpyc:1092
translate schinese m21afterchoice3_e8e45bef:

    # MC "Chloe."
    MC "克洛伊。"

# game/script2_2.rpyc:1093
translate schinese m21afterchoice3_da0d6cf8:

    # MC "You cheated at a fighting game just because I beat you twice."
    MC "你玩格斗游戏时作弊，就因为我赢了你两次。"

# game/script2_2.rpyc:1094
translate schinese m21afterchoice3_33751824:

    # c "You cheated first!"
    c "是你先作弊的！"

# game/script2_2.rpyc:1095
translate schinese m21afterchoice3_49ce0136:

    # MC "How did I?"
    MC "我怎么作弊了？"

# game/script2_2.rpyc:1096
translate schinese m21afterchoice3_c38bd754:

    # c "Like I said. By being a nerd."
    c "就像我说的，因为你是个书呆子。"

# game/script2_2.rpyc:1097
translate schinese m21afterchoice3_561eed61:

    # MC "Please stop using brain-phobic language in my presence. You shall call me \"scholarly\", not a \"nerd\"."
    MC "请别在我面前用这种“排斥脑力活动”的说法。你应该称我为“学者型人才”，而不是“书呆子”。"

# game/script2_2.rpyc:1098
translate schinese m21afterchoice3_d19f855d_4:

    # c "..."
    c "……"

# game/script2_2.rpyc:1099
translate schinese m21afterchoice3_2d204a49_7:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:1104
translate schinese m21afterchoice3_ad87b995:

    # c "Oof." (multiple=2)
    c "呃。" (multiple=2)

# game/script2_2.rpyc:1105
translate schinese m21afterchoice3_34e258aa:

    # MC "*Flick*" (multiple=2)
    MC "*弹了一下*" (multiple=2)

# game/script2_2.rpyc:1108
translate schinese m21afterchoice3_de8d0133:

    # MC "If you had cheats enabled you might've dodged that."
    MC "如果你开了作弊码，说不定就能躲开那一下了。"

# game/script2_2.rpyc:1109
translate schinese m21afterchoice3_6378d3ca:

    # c "Heh."
    c "嘿。"

# game/script2_2.rpyc:1112
