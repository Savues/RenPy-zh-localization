    # c "A-anyway, it started running over here, and I was already clinging onto it so..."
    c "总、总之，它突然往这边跑，而我当时正紧紧抱着它，所以……"

# game/script2_2.rpyc:670
translate schinese m21afterchoice2_f089b492:

    # MC "Mmhm."
    MC "嗯。"

# game/script2_2.rpyc:673
