    # m "Back off!"
    m "退后！"

# game/script2_2.rpyc:7324
translate schinese m22afterchoice8_1fc61003:

    # m "I'm serious."
    m "我是认真的。"

# game/script2_2.rpyc:7345
translate schinese m22afterchoice8_0e9e73a4:

    # MC "M-Miya!!"
    MC "米、米娅！！"

# game/script2_2.rpyc:7348
translate schinese m22afterchoice8_33f591d3:

    # cle "How long has it been since you awakened?"
    cle "你觉醒多久了？"

# game/script2_2.rpyc:7351
translate schinese m22afterchoice8_a94c78e9:

    # MC "What have you done to her-"
    MC "你对她做了什么——"

# game/script2_2.rpyc:7354
translate schinese m22afterchoice8_2d204a49_13:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:7355
translate schinese m22afterchoice8_ce80e3d6:

    # MC "\"Awakened\"?"
    MC "“觉醒”？"

# game/script2_2.rpyc:7357
translate schinese m22afterchoice8_3774b811:

    # cle "One month? Two?"
    cle "一个月？还是两个月？"

# game/script2_2.rpyc:7358
translate schinese m22afterchoice8_2d204a49_14:

    # MC "..."
    MC "……"

# game/script2_2.rpyc:7359
translate schinese m22afterchoice8_eccfd5ac:

    # MC "A few weeks..."
    MC "几周吧……"

# game/script2_2.rpyc:7362
translate schinese m22afterchoice8_a35235a7:

    # cle "You seem so well acclimatized after such a short amount of time. Good."
    cle "这么短的时间就适应得这么好。不错。"

# game/script2_2.rpyc:7363
translate schinese m22afterchoice8_218fd4c5:

    # cle "You don't have the luxury of time. Fast adaptation makes you a good candidate."
    cle "你可没有时间可以浪费。极强的适应力让你成为了合适的人选。"

# game/script2_2.rpyc:7366
translate schinese m22afterchoice8_70c0a8df:

    # MC "C-candidate... for what?"
    MC "人……人选？什么方面的？"

# game/script2_2.rpyc:7367
translate schinese m22afterchoice8_bb925c36:

    # MC "T-tell me!" with vpunch
    MC "快……快告诉我！" with vpunch

# game/script2_2.rpyc:7368
translate schinese m22afterchoice8_6393d83d:

    # MC "What do you know?!"
