# game/script.rpyc:453
translate schinese start_a20cefa7:

    # "..."
    "……"

# game/script.rpyc:454
translate schinese start_d845a140:

    # "... ..."
    "…… ……"

# game/script.rpyc:455
translate schinese start_f5a518c8:

    # "(I don't wanna get up.)"
    "（不想起来……）"

# game/script.rpyc:460
translate schinese start_dd62ab55:

    # "{i}{u}???" "Good. You're awake."
    "{i}{u}？？？" "醒了？太好了。"

# game/script.rpyc:465
translate schinese start_4432a4f1:

    # "... ... ...{w=1}{nw}"
    "…… …… ……{w=1}{nw}"

# game/script.rpyc:471
translate schinese start_9d9f98d4:

    # "Who the fuck are-{w=1}{nw}"
    "你他妈是谁——{w=1}{nw}"

# game/script.rpyc:476
translate schinese start_5962f4c3:

    # "{i}{u}???" "Hey, it's me."
    "{i}{u}？？？" "嘿，是我。"

# game/script.rpyc:484
translate schinese start_17d1928a:

    # dev "The developer."
    dev "开发者。"

# game/script.rpyc:488
translate schinese start_4eea25f2:

    # dev "I have a few things to explain before you start the game."
    dev "开始游戏前，我得先解释几件事。"

# game/script.rpyc:492
translate schinese start_855f4d75:

    # dev "This game will have {i}optional{/i}, guy-on-guy sex scenes."
    dev "这款游戏包含{i}可选{/i}的男男床戏。"

# game/script.rpyc:493
translate schinese start_29b5cfdf:

    # dev "Don't worry, these scenes are highly avoidable, you won't accidentally stumble into a sweaty, gay sex scene."
    dev "放心，这些场景完全可以避开，不会一不小心就误入汗津津的男男床戏。"

# game/script.rpyc:494
translate schinese start_e326bcf6:

    # dev "So you don't have to if you aren't interested."
    dev "如果你没兴趣，完全不用体验。"

# game/script.rpyc:495
translate schinese start_91b7dede:

    # dev "If you are interested, however..."
    dev "不过，既然你对此感兴趣……"

# game/script.rpyc:507
translate schinese start_3dc98ce6:

    # dev "There are also a few vignettes you need to recognize."
    dev "另外，还有几种画面效果你需要认出来。"

# game/script.rpyc:508
translate schinese start_6e31ea50:

    # dev "First:"
    dev "第一："

# game/script.rpyc:511
translate schinese start_5ec02862:

    # dev "The white vignette indicates that you have just made a choice that will have future consequences."
    dev "白色暗角表示你刚刚做出的选择会在之后产生后果。"

# game/script.rpyc:512
translate schinese start_1c45a221:

    # dev "The vignette will show regardless of if you made the 'bad' choice."
    dev "无论你选的是不是所谓的“坏选择”，这个效果都会出现。"

# game/script.rpyc:515
translate schinese start_5e479f43:

    # dev "The blue vignette indicates you are witnessing the {i}result{/i} of a previously made choice."
    dev "蓝色暗角表示你正在见证之前某个选择产生的{i}结果{/i}。"

# game/script.rpyc:516
translate schinese start_4cdd7655:

    # dev "Finally, we have point checks."
    dev "最后是好感度判定。"

# game/script.rpyc:517
translate schinese start_a72245d9:

    # dev "At some points in the story, the game will check how many points you will have with a character."
    dev "故事进行到某些节点时，游戏会检查你与某位角色积累了多少点数。"

# game/script.rpyc:520
translate schinese start_4497d0ff:

    # dev "If you have enough points you will pass the point check."
    dev "只要点数足够，就能通过判定。"

# game/script.rpyc:523
translate schinese start_9cf5ced9:

    # dev "If you don't have enough points you will fail."
    dev "点数不够，判定就会失败。"

# game/script.rpyc:524
translate schinese start_463cf989:

    # dev "Failing a point check may cause you to lose access to scenes, and at worst, it will cause you to {b}lose someone's route{/b}."
    dev "判定失败可能会让你失去部分场景，最坏的情况下，会让你{b}失去某位角色的个人路线{/b}。"

# game/script.rpyc:525
translate schinese start_dbf1fdae:

    # dev "Losing a route looks like this:"
    dev "失去路线时，画面会变成这样："

# game/script.rpyc:542
translate schinese start_5fe6e340:

    # dev "While most of them are, not every girl's route is initially optional."
    dev "虽然大多数角色的路线一开始都是可选的，但并非每个女孩都是如此。"

# game/script.rpyc:548
translate schinese start_76bbbd37:

    # dev "I'm too stupid to write a story to account for that."
    dev "我还没蠢到专门为此编出一套剧情。"

# game/script.rpyc:551
translate schinese start_21a7601e:

    # dev "If you keep losing routes, or are paranoid that you keep making the wrong decisions...."
    dev "如果你反复失去路线，或者总担心自己做错了选择……"

# game/script.rpyc:556
translate schinese start_a69f1c81:

    # dev "Subscribe to my Patreon for a walkthrough."
    dev "订阅我的 Patreon 就能查看流程攻略。"

# game/script.rpyc:560
translate schinese start_718af31a:

    # dev "If you forget what these vignettes mean, you will find a reminder in the pause menu."
    dev "如果忘了这些画面效果是什么意思，可以在暂停菜单里查看说明。"

# game/script.rpyc:561
translate schinese start_7fb21af4:

    # dev "Lastly, I want to warn you that you may find yourself unable to click through a few moments of the game."
    dev "最后提醒你一下：游戏中有少数画面可能无法点击跳过。"

# game/script.rpyc:562
translate schinese start_7b0f5696:

    # dev "This is, ironically, a quality of life feature to prevent you from accidentally skipping scenes, transitions, and animations. It also keeps the audio in synch."
    dev "讽刺的是，这其实是防止你误跳过场景、转场和动画的便利功能，同时也能让音频保持同步。"

# game/script.rpyc:563
translate schinese start_021d38c1:

    # dev "You can still skip through at any time by activating Ren'Py's skip mode, as long as you have already seen the text before or have Skip Unseen Text enabled in the preferences."
    dev "如果相关文本已经看过，或者你在偏好设置中启用了“跳过未读文本”，仍然可以随时开启 Ren’Py 的跳过模式。"

# game/script.rpyc:564
translate schinese start_59f1c0dc:

    # dev "Anyway, that's all for now. I'll let you get back to your story."
    dev "总之，先说这么多。接下来你可以继续看你的故事了。"

# game/script.rpyc:565
translate schinese start_0316cecc:

    # "No, wait!"
    "喂，等等！"

# game/script.rpyc:566
translate schinese start_f73397b6:

    # "How the fuck did you get in my roo-{w=1.0}{nw}"
    "你他妈到底是怎么进我家——{w=1.0}{nw}"

# game/script.rpyc:591
translate schinese main1_83267daf:

    # "Nghh..."
    "唔……"

# game/script.rpyc:592
translate schinese main1_bf02808b:

    # "{i}{u}???" "That looks like a rough one."
    "{i}{u}？？？" "看起来还挺严重的。"

# game/script.rpyc:600
translate schinese main1_4629f5f6:

    # stran "Your headache."
    stran "你的头疼。"

# game/script.rpyc:601
translate schinese main1_0f453823:

    # "{i}{u}???"
    "{i}{u}？？？"

# game/script.rpyc:605
translate schinese main1_00e108b2:

    # stran "C'mon, I see you walking out of a pharmacy, grimacing."
    stran "拜托，我刚看见你从药店里出来，脸都皱成一团了。"

# game/script.rpyc:609
translate schinese main1_540805f2:

    # stran "What's going on?"
    stran "怎么了？"

# game/script.rpyc:610
translate schinese main1_f9fb814f:

    # stran "You got a name?"
    stran "你叫什么名字？"

# game/script.rpyc:611
translate schinese main1_0f453823_1:

    # "{i}{u}???"
    "{i}{u}？？？"

# game/script.rpyc:615
translate schinese main1_0ca03854:

    # MC "It's [name]."
    MC "我叫[name]。"

# game/script.rpyc:619
translate schinese main1_d8407b56:

    # stran "Wanna smoke, [name]?"
    stran "抽烟吗，[name]？"

# game/script.rpyc:620
translate schinese main1_7f5c03be:

    # MC "Ah, no thanks."
    MC "啊，不用了，谢谢。"

# game/script.rpyc:624
translate schinese main1_29f3fa5b:

    # stran "Not a smoker?"
    stran "不抽烟？"

# game/script.rpyc:625
translate schinese main1_54572fe2:

    # MC "Nope."
    MC "不。"

# game/script.rpyc:626
translate schinese main1_150980c8:

    # stran "Smart. It's the biggest mistake I've ever made."
    stran "真聪明。吸烟是我这辈子犯过最大的错误。"

# game/script.rpyc:630
translate schinese main1_3c4df3a4:

    # stran "What's wrong with your head, [name]?"
    stran "你脑袋怎么了，[name]？"

# game/script.rpyc:631
translate schinese main1_09c6deaa:

    # MC "Err... I don't know."
    MC "呃……我不知道。"

# game/script.rpyc:632
translate schinese main1_29361cc7:

    # stran "It's a headache, right?"
    stran "是头疼吧？"

# game/script.rpyc:633
translate schinese main1_f192fca9:

    # MC "Usually. Though, I'd say it feels more like my brain is throbbing than just a headache."
    MC "通常吧。不过真要说起来，与其说是头疼，更像是我的脑子在一下一下地跳动。"

# game/script.rpyc:634
translate schinese main1_82dab454:

    # MC "When it {i}does{/i} ache..."
    MC "真{i}疼起来{/i}的时候……"

# game/script.rpyc:638
translate schinese main1_922be900:

    # MC "It usually hits here; like a truck."
    MC "一般会痛在这里——像被卡车撞了一样。"

# game/script.rpyc:642
translate schinese main1_8892966d:

    # stran "What the fuck? Those are the most intense goosebumps I've ever seen!"
    stran "你他妈什么情况？我从没见过这么夸张的鸡皮疙瘩！"

# game/script.rpyc:646
translate schinese main1_afc8cc1f:

    # MC "Yeah..."
    MC "对……"

# game/script.rpyc:647
translate schinese main1_de3b3168:

    # stran "It's like your hairs are trying to shoot out of your skin."
    stran "就像你的汗毛都想从皮肤里炸出来似的。"

# game/script.rpyc:651
translate schinese main1_b5a1f43f:

    # stran "You seen a doctor?"
    stran "看过医生吗？"

# game/script.rpyc:652
translate schinese main1_45e2585f:

    # MC "Nah, not yet. It isn't {i}that{/i} bad."
    MC "还没有。也没{i}那么{/i}严重。"

# game/script.rpyc:653
translate schinese main1_0a2a7794:

    # stran "Yeah but it's weird as hell."
    stran "但这也太邪门了。"

# game/script.rpyc:654
translate schinese main1_ac6744d2:

    # stran "Aren't you scared?"
    stran "你不害怕吗？"

# game/script.rpyc:658
translate schinese main1_6763d1e4:

    # MC "That reminds me... I've been getting these ominous vibes recently. At the same time these other symptoms started..."
    MC "这倒提醒我了……最近我总有种不祥的预感。偏偏也是在这时，其他症状才开始出现……"

# game/script.rpyc:659
translate schinese main1_c11fd2ea:

    # stran "???"
    stran "？？？"

# game/script.rpyc:663
translate schinese main1_16b4cfdf:

    # MC "I get this feeling..."
    MC "我有一种感觉……"

# game/script.rpyc:664
translate schinese main1_977bd561:

    # MC "Like something really bad is about to happen."
    MC "就好像马上要发生什么非常糟糕的事。"

# game/script.rpyc:677
translate schinese main1_2f12eaba:

    # stran "That's crazy, man. You sound like a cat, or a dog or something."
    stran "老兄，这太离谱了。你听起来像猫啊狗啊什么的。"

# game/script.rpyc:678
translate schinese main1_3269275c:

    # stran "You know, like how they can sense an earthquake?"
    stran "就是那种……它们好像能提前察觉地震的动物，不是吗？"

# game/script.rpyc:679
translate schinese main1_2e85d9fb:

    # MC "Woah, you think there may be an earthquake coming? Like I've got a superpower?"
    MC "哇，你是觉得地震要来了？好像我有什么超能力一样？"

# game/script.rpyc:683
translate schinese main1_f960382b:

    # stran "Hmmm..."
    stran "嗯……"

# game/script.rpyc:687
translate schinese main1_a32fd96d:

    # stran "Nah."
    stran "不。"

# game/script.rpyc:691
translate schinese main1_3124b471:

    # stran "He looks fine."
    stran "他看起来挺正常。"

# game/script.rpyc:697
translate schinese main1_2d204a49:

    # MC "..."
    MC "……"

# game/script.rpyc:698
translate schinese main1_3bf9d7e2:

    # MC "Maybe it has a sensory disability."
    MC "也许他的感官有问题。"

# game/script.rpyc:699
translate schinese main1_67645158:

    # stran "Then what about her?"
    stran "那她呢？"

# game/script.rpyc:706
translate schinese main1_2d204a49_1:

    # MC "..."
    MC "……"

# game/script.rpyc:707
translate schinese main1_e771ff0e:

    # MC "Why is there a cow here?"
    MC "为什么这里有头牛？"

# game/script.rpyc:717
translate schinese main1_d80c9f3e:

    # stran "That's Carlos' cow. He's kind of a local legend. I'm surprised you don't know him."
    stran "这是卡洛斯的牛。他在这附近挺有名，我没想到你不认识他。"

# game/script.rpyc:718
translate schinese main1_4240a63d:

    # stran "Hey, Carlos, how's Isabel's milk coming along?"
    stran "嘿，卡洛斯，伊莎贝尔的奶产量得怎么样了？"

# game/script.rpyc:723
translate schinese main1_215b7447:

    # "{i}{u}Carlos" "Sí, señor, the leche is flowing."
    "{i}{u}卡洛斯" "Sí,是的先生，牛奶正哗哗地流着呢。

# game/script.rpyc:729
translate schinese main1_0fa3a269:

    # stran "There you have it."
    stran "瞧，就是这样。"

# game/script.rpyc:730
translate schinese main1_ec84dcc6:

    # MC "Right, I think I read somewhere that cows produce less milk before an earthquake."
    MC "对，我记得在哪儿看过，地震前奶牛的产奶量会下降。"

# game/script.rpyc:731
translate schinese main1_29df4152:

    # stran "Eh, forget about it. Still, I'd see a doctor sometime."
    stran "算了，忘了这事吧。不过你最好找时间看看医生。"

# game/script.rpyc:732
translate schinese main1_721559d8:

    # stran "I've still got some time before I finish my smoke."
    stran "我烟还没抽完呢。"

# game/script.rpyc:740
translate schinese main1_d37af5da:

    # stran "You're pretty young."
    stran "你还挺年轻。"

# game/script.rpyc:741
translate schinese main1_1c1a1984:

    # stran "Are you still in school?"
    stran "还在上学吗？"

# game/script.rpyc:742
translate schinese main1_a0663c4b:

    # MC "I finished last year."
    MC "我去年毕业了。"

# game/script.rpyc:743
translate schinese main1_d19e38e5:

    # stran "Do you still live with your family?"
    stran "还和家人住吗？"

# game/script.rpyc:744
translate schinese main1_c3af2c67:

    # MC "No, not exactly."
    MC "不，不完全是。"

# game/script.rpyc:745
translate schinese main1_7bac4f72:

    # MC "I'm an only child, but my parents both work in marketing."
    MC "我是独生子，但父母都在做市场营销。"

# game/script.rpyc:746
translate schinese main1_f79b4aa5:

    # MC "They've been called for a temporary position overseas, and left a few days ago, I'm not quite sure how to even feel about it, it's the first time they've ever had to be away for so long."
    MC "他们被临时派到海外工作，几天前才离开。我也不知道自己该作何感想，这是他们第一次离开这么久。"

# game/script.rpyc:747
translate schinese main1_18e1f925:

    # MC "So for now, I'm holed up with one of their friends."
    MC "所以目前我暂住在他们的一个朋友家里。"

# game/script.rpyc:748
translate schinese main1_6c42a293:

    # stran "Yeah? You don't find that awkward?"
    stran "是吗？你不觉得这很尴尬？"

# game/script.rpyc:749
translate schinese main1_a6e2b609:

    # MC "Nope. I actually know her pretty well. Our families spent a lot of time together."
    MC "不会。我其实很了解她，我们两家以前常待在一起。"

# game/script.rpyc:750
translate schinese main1_7bc07ca8:

    # MC "Hell, it's almost always been an arrangement, whenever my parents were needed elsewhere, that's where I was sent."
    MC "说真的，这几乎已经成了惯例：父母需要去别处时，我就会被送到她那里。"

# game/script.rpyc:751
translate schinese main1_54650e05:

    # MC "I get along with her daughters, too."
    MC "我和她的女儿们也都相处得很好。"

# game/script.rpyc:752
translate schinese main1_4015c23d:

    # stran "Surrounded by women, huh?"
    stran "被女人包围着啊？"

# game/script.rpyc:753
translate schinese main1_37c08fb3:

    # stran "Lucky you. I barely get any attention at all."
    stran "你真幸运。我几乎连关注都得不到。"

# game/script.rpyc:754
translate schinese main1_ba629f53:

    # stran "Wanna give me a rundown?"
    stran "要不要我给你概括一下？"

# game/script.rpyc:755
translate schinese main1_439ff9dc:

    # MC "Sure... I guess..."
    MC "好啊……大概……"

# game/script.rpyc:779
translate schinese main1_50c0bd12:

    # MC "Miya, single mother of three."
    MC "米娅，三个孩子的单亲妈妈。"

# game/script.rpyc:780
translate schinese main1_c6812765:

    # MC "She babysat me a ton, and I mean a {b}ton{/b} when I was little."
    MC "她以前经常帮我照看，尤其是我小时候，简直是{b}无数{/b}次。"

# game/script.rpyc:781
translate schinese main1_b2703608:

    # MC "Anyway, she used to be a model in her twenties, that's how my mom knows her."
    MC "总之，她二十多岁时做过模特，我妈妈就是这样认识她的。"

# game/script.rpyc:782
translate schinese main1_a3a90b3b:

    # stran "What's she like?"
    stran "她是什么样的人？"

# game/script.rpyc:783
translate schinese main1_1aed35db:

    # MC "She's actually pretty passive and introverted."
    MC "她其实挺被动，也挺内向。"

# game/script.rpyc:784
translate schinese main1_13827e55:

    # MC "She doesn't seem to talk to many people or go out much. When she does go out, it's on her own or only with someone she's close to."
    MC "她好像不太和人说话，也不常出门。出门时要么独自一人，要么只和亲近的人在一起。"

# game/script.rpyc:785
translate schinese main1_b7a000b7:

    # stran "That's uh... sad to hear..."
    stran "呃……听起来有点……让人难过……"

# game/script.rpyc:786
translate schinese main1_1395ecad:

    # MC "Oh, sorry. Didn't mean to be negative."
    MC "哦，抱歉。我不是想说她不好。"

# game/script.rpyc:787
translate schinese main1_9b054770:

    # MC "She doesn't seem bothered by it."
    MC "她好像也不介意。"

# game/script.rpyc:788
translate schinese main1_50fe1610:

    # MC "Anyway, she doesn't seem to stick to jobs but I think that's because she has the leisure to."
    MC "总之，她好像不会固定做某份工作，但我觉得那是因为她有这份余裕。"

# game/script.rpyc:789
translate schinese main1_7d879c80:

    # MC "You see, she got really lucky about... thirteen or so years ago."
    MC "你看，她大概在十三年前……运气好得不得了。"

# game/script.rpyc:790
translate schinese main1_f90cfdfa:

    # MC "It turns out there was a rich hermit who died, about three quarters of the way across the country."
    MC "结果说是有个富有的隐士去世了，位置差不多在国土的四分之三处。"

# game/script.rpyc:791
translate schinese main1_f6f9e5d5:

    # MC "None of us had ever heard of him."
    MC "我们谁都没听说过他。"

# game/script.rpyc:792
translate schinese main1_6d8c2645:

    # MC "His lineage was tracked to her, and she inherited a small fortune."
    MC "他的遗产最后传到了她手里，于是她继承了一小笔财富。"

# game/script.rpyc:793
translate schinese main1_c4c4cab6:

    # stran "So she doesn't work?"
    stran "所以她不工作？"

# game/script.rpyc:794
translate schinese main1_8f7dc949:

    # MC "Not anymore."
    MC "现在不了。"

# game/script.rpyc:795
translate schinese main1_36c5e650:

    # MC "So that's Miya. She's a..."
    MC "所以这就是米娅。她是个……"

