# game/script.rpyc:11625
translate schinese m9choice1_1_61a60286:

    # C "One."
    C "一位。"

# game/script.rpyc:11629
translate schinese m9choice1_1_ec0dafaf:

    # MC "I don't understand..."
    MC "我不明白……"

# game/script.rpyc:11630
translate schinese m9choice1_1_12b554aa:

    # C "Please, tell me what's happening."
    C "请告诉我到底发生了什么。"

# game/script.rpyc:11634
translate schinese m9choice1_1_c839eb2c:

    # MC "I can't detect any binding in you. Nothing. No collar."
    MC "我察觉不到你身上有任何束缚。什么都没有。没有项圈。"

# game/script.rpyc:11638
translate schinese m9choice1_1_f2cafa86:

    # C "That's absurd! I became a slave! I saw it myself! Plus other people can see it!"
    C "这太荒谬了！我明明成了奴隶！我亲眼看到的！而且别人也能看见！"

# game/script.rpyc:11639
translate schinese m9choice1_1_a79908e6:

    # C "What about your affinity?! It becomes fuzzy trying to-"
    C "那你的亲和力呢？！试图探查时，感觉变得很模糊——"

# game/script.rpyc:11642
translate schinese m9choice1_1_31f107c6:

    # MC "I cast a calming spell on you earlier." with dissolve
    MC "我刚才对你施了一个镇静咒。" with dissolve

# game/script.rpyc:11643
translate schinese m9choice1_1_2b15c4bb:

    # C "The staff! They confirm it themselves when you register a slave for auction!"
    C "是工作人员！当你登记奴隶参加拍卖时，他们自己就会确认这一点！"

# game/script.rpyc:11644
translate schinese m9choice1_1_aa5fecd6:

    # MC "I know what I'm seeing."
    MC "我清楚自己看到了什么。"

# game/script.rpyc:11648
translate schinese m9choice1_1_ae2e463e:

    # C "*Tsk* It's just your affinity!"
    C "*啧*，那只是你的亲和力罢了！"

# game/script.rpyc:11663
translate schinese m9choice1_1_f4d20847:

    # C "AAAHHHH!"
    C "啊——！"

# game/script.rpyc:11667
translate schinese m9choice1_1_8c793b15:

    # MC "Cadence?!"
    MC "凯登丝？！"

# game/script.rpyc:11668
translate schinese m9choice1_1_0f070d2b:

    # C "What {i}are{/i} you?!"
    C "{i}你{/i}到底是什么？！"

# game/script.rpyc:11672
translate schinese m9choice1_1_1b3c7ffa:

    # MC "Just calm down. We'll figure this out."
    MC "冷静点。我们会弄清楚这件事的。"

# game/script.rpyc:11707
translate schinese m9choice1_1_c263cb3d:

    # "{i}{u}???" "Does the cat interest you?"
    "{i}{u}？？？" "你对那只猫感兴趣吗？"

# game/script.rpyc:11720
translate schinese m9choice1_1_6b6d8c53:

    # "{i}{u}???" "You appear to be in the middle of something. It's a shame I missed it."
    "{i}{u}？？？" "看来你正忙着什么事。真遗憾，我错过了。"

# game/script.rpyc:11732
translate schinese m9choice1_1_001c4728:

    # "{i}{u}???" "Are those tears?! How wonderful!"
    "{i}{u}？？？" "那是泪水吗？！真是太好了！"

# game/script.rpyc:11736
translate schinese m9choice1_1_8445e095:

    # "{i}{u}???" "I wish I could've seen it."
    "{i}{u}？？？" "真希望我当时也在场。"

# game/script.rpyc:11737
translate schinese m9choice1_1_0db30164:

    # "{i}{u}???" "I can't say I care much for slave ownership, but sometimes the little things bring you joy."
    "{i}{u}？？？" "虽说我对蓄奴这事儿没什么好感，但有时候，一些小事也能带来快乐。"

# game/script.rpyc:11741
translate schinese m9choice1_1_16ae4a21:

    # "{i}{u}???" "To come in here and have fun with my slave without making a reservation is quite impolite of you."
    "{i}{u}？？？" "不预约就跑来这儿，想跟我的奴隶寻欢作乐，你这行为可真够失礼的。"

# game/script.rpyc:11742
translate schinese m9choice1_1_ac6b0e13:

    # "{i}{u}???" "Or maybe, you couldn't resist?"
    "{i}{u}？？？" "又或者……你是实在按捺不住了？"

# game/script.rpyc:11750
translate schinese m9choice1_1_52c934de:

    # "{i}{u}???" "My name..."
    "{i}{u}？？？" "我的名字……"

# game/script.rpyc:11752
translate schinese m9choice1_1_fc76b886:

    # l "Is Liliana."
    l "是莉莉安娜。"

# game/script.rpyc:11753
translate schinese m9choice1_1_21d5b819:

    # l "I've been waiting. Waiting a long time for someone to finally appear in this room."
    l "我一直在等。等了很久，终于等到有人出现在这个房间里。"

# game/script.rpyc:11754
translate schinese m9choice1_1_f0f6cf10:

    # l "Someone like you."
    l "像你这样的人。"

# game/script.rpyc:11755
translate schinese m9choice1_1_5be4b099:

    # l "You're interested in her, aren't you?"
    l "你对她很感兴趣，对吧？"

# game/script.rpyc:11756
translate schinese m9choice1_1_98250004:

    # l "Fret not about booking a consultation."
    l "别操心预约咨询的事了。"

# game/script.rpyc:11760
translate schinese m9choice1_1_5ac95878:

    # l "Our consultation has already begun."
    l "我们的咨询已经开始了。"

# game/script.rpyc:11772
translate schinese m9choice1_1_940ef609:

    # l "*Tsk*"
    l "*啧*"

# game/script.rpyc:11773
translate schinese m9choice1_1_e6370720:

    # l "Please leave."
    l "请离开。"

# game/script.rpyc:11775
translate schinese m9choice1_1_67ffdeb7:

    # l "We're done here. See yourself out."
    l "这儿的事谈完了。自己出去吧。"

# game/script.rpyc:11776
translate schinese m9choice1_1_557a66c6:

    # MC "What the fuck are you talking about?!"
    MC "你他妈在说什么？！"

# game/script.rpyc:11777
translate schinese m9choice1_1_ecd5ad5f:

    # l "You're not supposed to be here. I don't know how you found this room but you've made a mistake."
    l "你不该出现在这儿。我不知道你是怎么找到这个房间的，但你搞错了。"

# game/script.rpyc:11787
translate schinese m9choice1_1_86322c55:

    # MC "Who are you?"
    MC "你是谁？"

# game/script.rpyc:11791
translate schinese m9choice1_1_c850be4b:

    # MC "What are you planning?"
    MC "你在打什么主意？"

# game/script.rpyc:11792
translate schinese m9choice1_1_7516e76c:

    # MC "This whole situation fucking stunk before I even walked into the room."
    MC "我还没进这房间，就觉得这事儿他妈的不对劲。"

# game/script.rpyc:11793
translate schinese m9choice1_1_b26ece2a:

    # MC "What do you mean you were waiting for someone like me? Where did all of that confidence go?"
    MC "什么叫你在等像我这样的人？你那股自信劲儿哪去了？"

# game/script.rpyc:11794
translate schinese m9choice1_1_c2262235:

    # MC "It looks to me like you're up to some shady shit."
    MC "我看你是在搞什么见不得人的勾当。"

# game/script.rpyc:11795
translate schinese m9choice1_1_2b1a7bf1:

    # MC "So explain, Liliana. Who am I, if not the person you wanted?"
    MC "所以，解释一下吧，莉莉安娜。如果我不是你要找的那个人，那我又是谁？"

# game/script.rpyc:11796
translate schinese m9choice1_1_b3bfa193:

    # MC "Because your reaction is telling me that I'm a monkey wrench you'd rather avoid."
    MC "因为你的反应告诉我，我像是个你避之唯恐不及的麻烦。"

# game/script.rpyc:11800
translate schinese m9choice1_1_25b798c9:

    # l "My business has nothing to do with you."
    l "我的事与你无关。"

# game/script.rpyc:11801
translate schinese m9choice1_1_16cedb3e:

    # l "I don't know what you believe you'll gain from this sudden onset of bravado, but you should understand that it is {i}very{/i} misplaced."
    l "我不知道你这种突如其来的逞强能换来什么，但你要明白，这{i}非常{/i}不合适。"

# game/script.rpyc:11802
translate schinese m9choice1_1_73deeafc:

    # l "If I were you I'd utilize some situational awareness and {i}not{/i} needlessly wave around idle threats."
    l "换作是我，我会审时度势，而{i}不会{/i}毫无必要地虚张声势、乱发威胁。"

# game/script.rpyc:11806
translate schinese m9choice1_1_cc981514:

    # l "Tell me, Icarus. Do you believe yourself to be the beneficiary of flying this closely to the sun?"
    l "告诉我，伊卡洛斯。你以为离太阳这么近飞行，自己能捞到什么好处吗？"

# game/script.rpyc:11807
translate schinese m9choice1_1_f2674bfe:

    # l "Invoke some pragmatism and snuff out your hubris. What use is diving into the unknown so brazenly?"
    l "务实一点，收起你的狂妄吧。如此鲁莽地一头扎进未知之中，又有什么意义？"

# game/script.rpyc:11808
translate schinese m9choice1_1_902110be:

    # l "Your presence here is a mistake. With an ounce of brainpower, you may come to realize this. I'd recommend doing so sooner than later."
    l "你出现在这里是个错误。只要稍微动动脑子，你就能明白这一点。我建议你最好早点想通。"

# game/script.rpyc:11809
translate schinese m9choice1_1_a0e50cd0:

    # l "It's fine to leave. You're not the person I'm looking for. We can leave it at that. I don't understand exactly why you're so riled up, but I'm willing to put your interference behind us."
    l "你可以走了。你不是我要找的人，事情到此为止就好。我不明白你为什么这么激动，但我愿意把你的干扰抛诸脑后。"

# game/script.rpyc:11814
translate schinese m9choice1_1_98b7256a:

    # MC "My interference is necessary."
    MC "我有必要插手这件事。"

# game/script.rpyc:11815
translate schinese m9choice1_1_2bd5e116:

    # MC "I have questions. Questions you probably don't expect. Once you hear them, it's going to become clear that answering them is within your best interests."
    MC "我有几个问题。恐怕是你意想不到的问题。一旦听了这些问题，你就会明白，回答它们才最符合你的利益。"

# game/script.rpyc:11816
translate schinese m9choice1_1_82822a0c:

    # l "..."
    l "……"

# game/script.rpyc:11817
translate schinese m9choice1_1_834adc96:

    # MC "I think I'm going to jump straight in there with the big one."
    MC "我想我还是直奔主题，问个最关键的问题吧。"

# game/script.rpyc:11828
translate schinese m9choice1_1_8c257ec9:

    # MC "How exactly did you concoct this fake slavery?"
    MC "你到底是怎么炮制出这出“伪造奴隶身份”戏码的？"

# game/script.rpyc:11838
translate schinese m9choice1_1_ea2fe3dd:

    # l "A glitch in your magic? Is that why you're so sure of yourself?!"
    l "是你的魔法出了岔子吗？这就是你如此自信的原因？！"

# game/script.rpyc:11839
translate schinese m9choice1_1_a141d175:

    # l "All of this confrontation because you can't cast a simple fucking spell?!"
    l "闹出这么大的动静，竟然只是因为你连个简单的该死魔法都施展不好？！"

# game/script.rpyc:11840
translate schinese m9choice1_1_70070831:

    # l "The collar is right there, you sack of brainless shit!"
    l "项圈就在那儿，你这个没脑子的蠢货！"

# game/script.rpyc:11844
translate schinese m9choice1_1_ee64e605:

    # MC "{i}A{/i} collar."
    MC "{i}那{/i}项圈。"

# game/script.rpyc:11849
translate schinese m9choice1_1_1d9ea577:

    # MC "It's fake."
    MC "那是假的。"

# game/script.rpyc:11850
translate schinese m9choice1_1_ca73be92:

    # l "There's no such thing!"
    l "根本就没有那种东西！"

# game/script.rpyc:11851
translate schinese m9choice1_1_1d9ea577_1:

    # MC "It's fake."
    MC "那是假的。"

# game/script.rpyc:11852
translate schinese m9choice1_1_e0cc9fc0:

    # MC "I checked. I checked her slave status. Ironically so I would recognize you in the off chance that we cross paths."
    MC "我查过了。我查了她的奴隶状态。讽刺的是，我查这个本来是为了万一我们偶遇时能认出你来。"

# game/script.rpyc:11853
translate schinese m9choice1_1_f238a710:

    # MC "All I saw was gibberish. Rogue magic. Like it was trying to tell me something:"
    MC "我看到的只有乱码。失控的魔法。就像它想告诉我什么一样："

# game/script.rpyc:11854
translate schinese m9choice1_1_8275c043:

    # MC "Lies."
    MC "谎言。"

# game/script.rpyc:11855
translate schinese m9choice1_1_e701d3eb:

    # MC "I don't know how you managed to convince anyone with this facade of a spell, but it's clear that it {i}does{/i} work."
    MC "我不知道你是怎么用这种虚假的法术骗过别人的，但它{i}确实{/i}奏效了。"

# game/script.rpyc:11856
translate schinese m9choice1_1_f5318903:

    # MC "Just not on me."
    MC "只是对我没用。"

# game/script.rpyc:11860
translate schinese m9choice1_1_0a281bf7:

    # l "Why would I pretend?! She's mine!" with vpunch
    l "我为什么要伪装？！她是属于我的！" with vpunch

# game/script.rpyc:11861
translate schinese m9choice1_1_bcbcc0f5:

    # l "Look at her!"
    l "看看她！"

# game/script.rpyc:11865
translate schinese m9choice1_1_84c5ec93:

    # l "She {i}fears{/i} me. You may have a warped view of our relationship but {i}nothing{/i} can get in the way of the truth behind a master-slave binding!"
    l "她{i}害怕{/i}我。你对我们的关系或许有扭曲的看法，但{i}什么{/i}也不能改变主仆契约背后的真相！"

# game/script.rpyc:11866
translate schinese m9choice1_1_f1b72d7f:

    # l "You understand, don't you? You were there from the beginning. You are {i}{b}mine{/b}{/i}."
    l "你明白的，对吧？你从一开始就在场。你是{i}{b}我的{/b}{/i}。"

# game/script.rpyc:11877
translate schinese m9choice1_1_0d9adec1:

    # l "Return to me. Show this misguided fool that you know your role."
    l "回到我身边来。让这个误入歧途的蠢货看看，你清楚自己的身份。"

# game/script.rpyc:11898
translate schinese m9choice1_1_3416c1e6:

    # MC "It looks to me like she's made her choice."
    MC "看来她已经做出了选择。"

# game/script.rpyc:11899
translate schinese m9choice1_1_e5b7eb95:

    # l "How?! How did you let him inject his conspiracy theories into your head?!"
    l "怎么会？！你怎么能让他把那些阴谋论灌输进你的脑子里？！"

# game/script.rpyc:11902
translate schinese m9choice1_1_58d94789:

    # l "For years! You've obeyed my every word for years!" with vpunch
    l "这么多年了！这么多年来，你对我言听计从！" with vpunch

# game/script.rpyc:11903
translate schinese m9choice1_1_4d008195:

    # l "How?! How did this man- this boy sway you away from me after mere minutes of wild speculation?!"
    l "怎么会？！这个男人——不，这个毛头小子——凭什么只靠几分钟的胡乱臆测，就把你从我身边拉走了？！"

# game/script.rpyc:11904
translate schinese m9choice1_1_2dc751ad:

    # l "I can't believe this! Never have I seen such insolence from you!"
    l "简直难以置信！我从未见过你如此放肆！"

# game/script.rpyc:11905
translate schinese m9choice1_1_b9b4cec7:

    # l "You would never even {i}talk{/i} to strangers, and yet you put all of your faith in {i}him{/i}?!"
    l "你以前甚至从不跟陌生人{i}说话{/i}，可现在却把全部信任放在{i}他{/i}身上？！"

# game/script.rpyc:11906
translate schinese m9choice1_1_d63c0a18:

    # l "What makes {i}him{/i} so special?!"
    l "{i}他{/i}到底有什么特别之处？！"

# game/script.rpyc:11916
translate schinese m9choice1_1_bf452014:

    # l "That's enough!"
    l "够了！"

# game/script.rpyc:11920
translate schinese m9choice1_1_553eefe8:

    # l "And I suggest that you try tilting at {i}other{/i} windmills in the future."
    l "我建议你以后还是去挑战{i}别的{/i}“风车”吧。"

# game/script.rpyc:11925
translate schinese m9choice1_1_720a5cd8:

    # l "We're calling today off."
    l "今天的行程就此取消。"

# game/script.rpyc:11934
translate schinese m9choice1_1_14c56b1f:

    # l "Unhand her!" with vpunch
    l "放开她！" with vpunch

# game/script.rpyc:11938
translate schinese m9choice1_1_090ccdcc_1:

    # MC "Cadence!"
    MC "凯登丝！"

# game/script.rpyc:11943
translate schinese m9choice1_1_699b3c61:

    # MC "You know what to do."
    MC "你知道该怎么做。"

# game/script.rpyc:11964
translate schinese m9choice1_1_26a803bc_1:

    # C "..."
    C "……"

# game/script.rpyc:11968
translate schinese m9choice1_1_b613d341:

    # C "..Help..."
    C "……救……"

# game/script.rpyc:11969
translate schinese m9choice1_1_1d7abe53:

    # C "...Me..."
    C "……我……"

# game/script.rpyc:11981
translate schinese m9choice1_1_a49632d4:

    # l "No..."
    l "不……"

# game/script.rpyc:11986
translate schinese m9choice1_1_4641ebc3:

    # l "What have you done..."
    l "你做了什么……"

# game/script.rpyc:11987
translate schinese m9choice1_1_d41017f9:

    # l "Give her back..."
    l "把她还给我……"

# game/script.rpyc:12001
translate schinese m9choice1_1_f22761a3:

    # l "GIVE HER BACK!"
    l "把她还给我！"

# game/script.rpyc:12020
translate schinese m9choice1_1_c7484054:

    # l "*Inhale*"
    l "*吸气*"

# game/script.rpyc:12024
translate schinese m9choice1_1_fb1119bf:

    # l "*Exhale*"
    l "*呼气*"

# game/script.rpyc:12027
translate schinese m9choice1_1_c7484054_1:

    # l "*Inhale*"
    l "*吸气*"

# game/script.rpyc:12031
translate schinese m9choice1_1_fb1119bf_1:

    # l "*Exhale*"
    l "*呼气*"

# game/script.rpyc:12036
translate schinese m9choice1_1_91e244b4:

    # "{i}{u}Cadence and [name]" "*Inhale*"
    "{i}{u}凯登丝和[name]" "*Inhale**吸气*

# game/script.rpyc:12041
translate schinese m9choice1_1_7f9654ef:

    # "{i}{u}Cadence and [name]" "*Exhale*"
    "{i}{u}凯登丝和[name]" "*Exhale**呼气*

# game/script.rpyc:12046
translate schinese m9choice1_1_000b0759:

    # l "Fine."
    l "很好。"

# game/script.rpyc:12047
translate schinese m9choice1_1_cc40926d:

    # l "You can keep her for now."
    l "你暂时可以留着她。"

# game/script.rpyc:12048
translate schinese m9choice1_1_8d3af1ab:

    # l "\"If you know yourself but not the enemy\"..."
    l "“若知己而不知彼……”……"

# game/script.rpyc:12050
translate schinese m9choice1_1_dedb3e12:

    # l "I suppose I should thank you. I'm wise enough to appreciate when a learning opportunity presents itself."
    l "我想我该谢谢你。我懂得把握学习的机会。"

# game/script.rpyc:12054
translate schinese m9choice1_1_82822a0c_1:

    # l "..."
    l "……"

# game/script.rpyc:12055
translate schinese m9choice1_1_b394dbee:

    # l "Do you even know who you are?"
    l "你到底知不知道自己是谁？"

# game/script.rpyc:12056
translate schinese m9choice1_1_469cae8e:

    # l "Wait..."
    l "等等……"

# game/script.rpyc:12061
translate schinese m9choice1_1_1827fa76:

    # l "Do you have one too?"
    l "你也有一个吗？"

# game/script.rpyc:12062
translate schinese m9choice1_1_295de6b0:

    # MC "I don't know what the fuck you're talking about, lady."
    MC "我他妈根本不知道你在说什么，女士。"

# game/script.rpyc:12063
translate schinese m9choice1_1_82822a0c_2:

    # l "..."
    l "……"

# game/script.rpyc:12064
translate schinese m9choice1_1_4028ddb5:

    # l "We'll meet again. When the time is right."
    l "我们会再见面的。在合适的时机。"

# game/script.rpyc:12074
translate schinese m9choice1_1_2800a714:

    # MC "We're not done here-"
    MC "我们的事还没完——"

# game/script.rpyc:12075
translate schinese m9choice1_1_3c73c7c6:

    # C "She's gone."
    C "她走了。"

# game/script.rpyc:12084
translate schinese m9choice1_1_7fd43d74:

    # C "She's really gone."
    C "她真的走了。"

# game/script.rpyc:12085
translate schinese m9choice1_1_7913d70d:

    # MC "Just like that? Why?"
    MC "就这样？为什么？"

# game/script.rpyc:12086
translate schinese m9choice1_1_4cc9e8e2:

    # C "I couldn't tell you."
    C "我说不上来。"

# game/script.rpyc:12087
translate schinese m9choice1_1_84065aa6:

    # MC "You're sure she's gone?"
    MC "你确定她走了吗？"

# game/script.rpyc:12088
translate schinese m9choice1_1_f0999be1:

    # C "I can smell it..."
    C "我能闻到……"

# game/script.rpyc:12106
translate schinese m9choice1_1_27887d42:

    # C "And I can hear it..."
    C "而且我能听到……"

# game/script.rpyc:12111
translate schinese m9choice1_1_385eae65:

    # MC "Hey... are... are you okay?"
    MC "嘿……你……你还好吗？"

# game/script.rpyc:12112
translate schinese m9choice1_1_7458a3f2:

    # C "I haven't felt this much adrenaline in years. I'm still a little scared to be honest."
    C "我已经好多年没感受过这么强烈的肾上腺素飙升了。老实说，我现在还有点害怕。"

# game/script.rpyc:12113
translate schinese m9choice1_1_77c57ecd:

    # C "I don't know what's going on. I don't even know who you are."
    C "我不知道发生了什么。我甚至不知道你是谁。"

# game/script.rpyc:12114
translate schinese m9choice1_1_53af49c9:

    # C "Did you... Did you feel anything when you first touched me?"
    C "你……你第一次碰到我的时候，有什么感觉吗？"

# game/script.rpyc:12115
translate schinese m9choice1_1_f47e5dca:

    # MC "Nothing. It seemed normal to me. I still noticed it at the time, though. Your reaction."
    MC "没什么感觉。我觉得很正常。不过，当时我确实注意到了——你的反应。"

# game/script.rpyc:12116
translate schinese m9choice1_1_a93c97a0:

    # MC "Did you see something?"
    MC "你看到了什么吗？"

# game/script.rpyc:12117
translate schinese m9choice1_1_07484dc4:

    # C "Only a feeling. It felt like... a piece of me that had been missing was finally returned."
    C "只是一种感觉。感觉就像……我缺失已久的一部分终于找回来了。"

# game/script.rpyc:12119
translate schinese m9choice1_1_d56dfb0d:

    # MC "Is that why you trusted me?"
    MC "这就是你信任我的原因吗？"

# game/script.rpyc:12120
translate schinese m9choice1_1_7f8c6b84:

    # C "I couldn't even begin to explain why I trusted you. It could've been that feeling. It could've been how you presented a change in my life."
    C "我根本无法解释自己为何信任你。也许是因为那种感觉，也许是因为你给我的生活带来了改变。"

# game/script.rpyc:12121
translate schinese m9choice1_1_81f5dd8d:

    # C "Maybe it's how you're the first stranger I've looked at who gave me a feeling other than fear."
    C "也许是因为，你是第一个让我看着时，不会感到恐惧的陌生人。"

# game/script.rpyc:12130
translate schinese m9choice1_1_2d204a49_3:

    # MC "..."
    MC "……"

# game/script.rpyc:12131
translate schinese m9choice1_1_26a803bc_2:

    # C "..."
    C "……"

# game/script.rpyc:12132
translate schinese m9choice1_1_303261ae:

    # C "You look ashamed."
    C "你看起来很愧疚。"

# game/script.rpyc:12133
translate schinese m9choice1_1_842a96b8:

    # MC "I enslaved you... I... didn't think about it. I just did it. I didn't have to, but it's... it's what I did..."
    MC "我奴役了你……我……当时没想那么多。我只是那样做了。我本不必这么做，但……我确实这么做了……"

# game/script.rpyc:12134
translate schinese m9choice1_1_8ed4f142:

    # MC "I'm... sorry. Because of me... you-"
    MC "我……很抱歉。因为我……你……"

# game/script.rpyc:12135
translate schinese m9choice1_1_69221af7:

    # C "What are you going to do to me?"
    C "你打算怎么处置我？"

# game/script.rpyc:12136
translate schinese m9choice1_1_67d91cc6:

    # MC "It's not hard to believe that I hadn't thought it through yet."
    MC "其实不难相信，我还没想好该怎么办。"

# game/script.rpyc:12140
translate schinese m9choice1_1_0e7d1d48:

    # MC "I need to give you a home, introduce you to the people I'm living with."
    MC "我得给你一个家，还要把你介绍给我同住的伙伴们认识。"

# game/script.rpyc:12141
translate schinese m9choice1_1_32258c48:

    # MC "I'm sure that we can afford to take care of you. We've gotta figure out your room, find you some clothes..."
    MC "我相信我们有能力照顾你。我们得把你的住处安顿好，再给你找些衣服……"

# game/script.rpyc:12142
translate schinese m9choice1_1_4d67db18:

    # MC "After that... I don't know. We're going to need to talk. A lot. I need to know exactly what your circumstances are, who I've gotten involved with."
    MC "至于之后的事……我也不清楚。我们需要好好谈谈，深入地谈谈。我得确切了解你的处境，弄清楚我究竟卷入了什么样的事情之中。"

# game/script.rpyc:12143
translate schinese m9choice1_1_fcdd2485:

    # MC "I'll try and find your family if you have any-"
    MC "我会试着帮你寻找家人——如果还有家人的话——"

# game/script.rpyc:12144
translate schinese m9choice1_1_cc7a6c08:

    # C "You didn't enslave me."
    C "你并没有把我变成奴隶。"

# game/script.rpyc:12145
translate schinese m9choice1_1_2d204a49_4:

    # MC "..."
    MC "……"

# game/script.rpyc:12146
translate schinese m9choice1_1_bb0f4d45:

    # C "You {i}saved{/i} me. Even if I wasn't bound by magic before, I was still a slave."
    C "是你{i}救了{/i}我。即便以前没有魔法的束缚，我依然是个奴隶。"

# game/script.rpyc:12147
translate schinese m9choice1_1_a09a32e8:

    # C "Listen to yourself. You have nothing to be ashamed of. You're going to give me clothes, a room, a family. You're not describing a slave."
    C "听听你自己在说什么。你没什么好羞愧的。你要给我衣服、住处，甚至一个家。这可不是在描述奴隶。"

# game/script.rpyc:12148
translate schinese m9choice1_1_3c8089e3:

    # MC "And what am I describing?"
    MC "那我在描述什么？"

# game/script.rpyc:12149
translate schinese m9choice1_1_1644148f:

    # C "A refugee."
    C "一个难民。"

# game/script.rpyc:12150
translate schinese m9choice1_1_2d204a49_5:

    # MC "..."
    MC "……"

# game/script.rpyc:12154
translate schinese m9choice1_1_6a94159b:

    # C "Stop grimacing like that. Why are you so hard to convince? I'm happy, you know. Actually happy because of you."
    C "别再那样皱着眉头了。怎么就这么难说服你呢？我是快乐的，你知道吗？因为你，我是真的感到快乐。"

# game/script.rpyc:12158
translate schinese m9choice1_1_3e867282:

    # C "What's your name, master?"
    C "你叫什么名字，主人？"

# game/script.rpyc:12180
translate schinese main10_e43549a4:

    # m "Oh, h-hey, [name]. Why are you calling {i}me{/i} all of a sudden? Haha."
    m "噢，嘿，[name]。怎么突然给{i}我{/i}打电话了？哈哈。"

# game/script.rpyc:12181
translate schinese main10_eddb45e0:

    # m "I was just thinking about you- I mean- you were on my mind lately- No! I mean-"
    m "我刚才在想你——我是说——最近我总是在想你——不！我是说——"

# game/script.rpyc:12186
translate schinese main10_1af399b0:

    # m "What's up, [name]? It's unusual of you to call me. Or did you start feeling sorry for my number laying in your phone?"
    m "怎么了，[name]？你很少给我打电话的。还是说，你终于觉得把我的号码闲置在手机里有点过意不去了？"

# game/script.rpyc:12190
translate schinese main10_402f33e7:

    # m "Mmhm..."
    m "嗯……"

# game/script.rpyc:12192
translate schinese main10_402f33e7_1:

    # m "Mmhm..."
    m "嗯……"

# game/script.rpyc:12206
translate schinese main10_46f72a05:

    # m "YOU FUCKING WHAT?!" with vpunch
    m "你他妈干了什么？！" with vpunch

# game/script.rpyc:12207
translate schinese main10_2b8ab1c5:

    # m "ARE YOU INSANE?!!!" with vpunch
    m "你疯了吗？！！！" with vpunch

# game/script.rpyc:12209
translate schinese main10_bd62d53f:

    # m "NO! DON'T EXPLAIN! YOU KEEP YOUR ASS RIGHT THERE!"
    m "不！别解释！你就给我老老实实待在那儿！"

# game/script.rpyc:12210
translate schinese main10_7a1446f1:

    # m "UN-FUCKING BELIEVABLE! I DON'T EVEN KNOW WHERE TO BEGIN!"
    m "简直他妈的难以置信！我都不知道该从哪儿说起！"

# game/script.rpyc:12211
translate schinese main10_34afc50f:

    # m "DON'T YOU FUCKING MOVE! I'LL BE RIGHT THERE!"
    m "你他妈别动！我马上就到！"

# game/script.rpyc:12220
translate schinese main10_1c0e5eb0:

    # MC "She said it's cool."
    MC "她说没问题。"

# game/script.rpyc:12221
translate schinese main10_2d204a49:

    # MC "..."
    MC "……"

# game/script.rpyc:12222
translate schinese main10_ddbff383:

    # MC "You hungry?"
    MC "你饿了吗？"

# game/script.rpyc:12227
translate schinese main10_36c7ec4d:

    # m "You were going out to \"buy lunch or something\"..."
    m "你本来是打算出去买午饭之类的……"

# game/script.rpyc:12228
translate schinese main10_92a3ccff:

    # m "Over two-hours later and I find myself rushing to a SLAVE MARKET because of an important phone call."
    m "结果过了两个多小时，我却因为一通重要的电话，正匆匆赶往奴隶市场。"

# game/script.rpyc:12229
translate schinese main10_630a50d3:

    # m "So if you would be willing to explain;"
    m "所以，能不能请你解释一下；"

# game/script.rpyc:12230
translate schinese main10_d81f8132:

    # m "{b}What exactly did you buy?!{/b}"
    m "{b}你到底买了什么？！{/b}"

# game/script.rpyc:12257
translate schinese main10_181ce984:

    # MC "Sandwich."
    MC "三明治。"

# game/script.rpyc:12259
translate schinese main10_2c3e1b3a:

    # m "Stand up."
    m "站起来。"

# game/script.rpyc:12315
translate schinese main10_bf2b6213:

    # m "Are you going to buy your own house?! Clothes? It's beyond obvious that we aren't prepared to take in a slave!"
    m "你是打算自己买房子吗？！还有衣服？显而易见，我们根本没准备好收留奴隶！"

# game/script.rpyc:12316
translate schinese main10_e0c2855b:

    # m "Not to mention the audacity of springing this on me out of nowhere!"
    m "更别提你竟然毫无预兆地搞了这么一出！"

# game/script.rpyc:12317
translate schinese main10_c2f924c9:

    # m "What were you thinking?!"
    m "你到底在想什么？！"

# game/script.rpyc:12318
translate schinese main10_8bdd8149:

    # m "Never! Never have you done something this reckless!"
    m "从来没有！你以前从来没做过这么鲁莽的事！"

# game/script.rpyc:12322
translate schinese main10_31807b8d:

    # m "What possesses you to do this in the first place?!"
    m "到底是什么让你做出这种事？！"

# game/script.rpyc:12337
translate schinese main10_9db14153:

    # m "I mean- why are you even here in the first place?! This is so unlike you!"
    m "我是说——你为什么会出现在这里？！这太不像你了！"

# game/script.rpyc:12338
translate schinese main10_f9213720:

    # m "And to actually {i}bind{/i} one of the slaves?! What about your money?! How many Embers do you have left?!"
    m "而且竟然还{i}契约绑定{/i}了一个奴隶？！你的钱呢？！你还剩下多少余烬？！"

# game/script.rpyc:12342
translate schinese main10_61b33c61:

    # m "Did you even for {i}one{/i} second, consider how {i}I{/i} would feel? How my daughters would feel?!"
    m "你哪怕有{i}一秒钟{/i}考虑过{i}我{/i}的感受吗？考虑过我女儿们的感受吗？！"

# game/script.rpyc:12359
translate schinese main10_3cd2e8fe:

    # MC "Listen. I understand that this is all very sudden for you. But like I said over the phone, this is an {i}emergency{/i}, and I have my reasons for doing this."
    MC "听着。我明白这对你来说太突然了。但就像我在电话里说的，这是{i}紧急情况{/i}，我这么做是有理由的。"

# game/script.rpyc:12360
translate schinese main10_ad52636a:

    # MC "You hit the nail on the head. This isn't like me. At least it wouldn't be unless I had a good reason. You haven't even let me explain."
    MC "你说得对。这确实不像我。至少，除非有充分的理由，否则我不会这么做。可你甚至都没让我解释。"

# game/script.rpyc:12361
translate schinese main10_1510e0f2:

    # MC "So while you've had your moment, I would appreciate you putting an end to your hysterics. Maybe exercise your ears and your patience for a moment."
    MC "既然你已经发泄过了，我希望你能停止歇斯底里。也许该稍微动动耳朵，拿出点耐心听听了。"

# game/script.rpyc:12362
translate schinese main10_5d0894b3:

    # MC "If you still have a problem we can talk about this later. In private."
    MC "如果你还有意见，我们可以稍后再谈。私下里。"

# game/script.rpyc:12367
translate schinese main10_e612037c:

    # m "..."
    m "……"

# game/script.rpyc:12368
translate schinese main10_e3f31b4f:

    # m "Sometimes I forget about your hidden assertive side."
    m "有时候我会忘了你那不为人知的强势一面。"

# game/script.rpyc:12373
translate schinese main10_e612037c_1:

    # m "..."
    m "……"

# game/script.rpyc:12377
translate schinese main10_143c55f6:

    # m "Jeez... you should really keep that assertive side of yourself hidden."
    m "天哪……你真该把那强势的一面藏好。"

# game/script.rpyc:12382
translate schinese main10_4af366fb:

    # m "Fine, go ahead. But I'm going to need a {i}lot{/i} of details. Because from my end, this is an entirely random series of events. Extreme events at that."
    m "好吧，你说吧。但我需要了解{i}很多{/i}细节。因为在我看来，这一连串的事情完全是随机发生的。而且都是些极端事件。"

# game/script.rpyc:12383
translate schinese main10_9133735a:

    # m "Then we'll sort out... sorry?"
    m "那我们来理一理……抱歉？"

# game/script.rpyc:12384
translate schinese main10_81d8ed6a:

    # MC "Cadence."
    MC "凯登丝。"

# game/script.rpyc:12388
translate schinese main10_cb5c42e9:

    # m "Sorry, Cadence. If you could wait for a moment while I sort this out with [name]. I promise we'll have time to talk. It's just that right now I find myself mediating a fucking disaster."
    m "抱歉，凯登丝。能不能请你稍等一下，让我先跟[name]把这事儿理清楚？我保证我们会有时间谈谈的。只是我现在正忙着收拾一个该死的烂摊子。"

# game/script.rpyc:12389
translate schinese main10_f3db5bce:

    # C "Oh... that's okay. I'm used to sitting around."
    C "哦……没关系。我习惯了干等。"

# game/script.rpyc:12390
translate schinese main10_a89b04f5:

    # C "I don't mind."
    C "我不介意。"

# game/script.rpyc:12391
translate schinese main10_e612037c_2:

    # m "..."
    m "……"

# game/script.rpyc:12392
translate schinese main10_26a803bc:

    # C "..."
    C "……"

# game/script.rpyc:12393
translate schinese main10_e612037c_3:

    # m "..."
    m "……"

# game/script.rpyc:12403
translate schinese main10_11682d08:

    # MC "Miya."
    MC "米娅。"

# game/script.rpyc:12404
translate schinese main10_e9a00f13:

    # m "What?"
    m "什么？"

# game/script.rpyc:12405
translate schinese main10_58680ce6:

    # MC "Don't you want me to explain the situation?"
    MC "你不想让我解释一下情况吗？"

# game/script.rpyc:12406
translate schinese main10_cb5760a8:

    # m "In due time."
    m "到时候再说吧。"

# game/script.rpyc:12408
translate schinese main10_11682d08_1:

    # MC "Miya."
    MC "米娅。"

# game/script.rpyc:12409
translate schinese main10_e9a00f13_1:

    # m "What?"
    m "什么？"

# game/script.rpyc:12410
translate schinese main10_1fb1a2b1:

    # MC "She's not a pet."
    MC "她可不是宠物。"

# game/script.rpyc:12411
translate schinese main10_ac1b1bbf:

    # C "It's fine, master. My parents used to do this all the time."
    C "没关系的，主人。我父母以前也经常这么做。"

# game/script.rpyc:12412
translate schinese main10_2d204a49_1:

    # MC "..."
    MC "……"

# game/script.rpyc:12413
translate schinese main10_26a803bc_1:

    # C "..."
    C "……"

# game/script.rpyc:12414
translate schinese main10_e612037c_4:

    # m "..."
    m "……"

# game/script.rpyc:12419
translate schinese main10_7be1d371:

    # m "Liliana?"
    m "莉莉安娜？"

# game/script.rpyc:12420
translate schinese main10_6d1d2d28:

    # m "Hmm..."
    m "嗯……"

# game/script.rpyc:12421
translate schinese main10_002095de:

    # m "Nope. No idea. Not even the description. It definitely seems like she's up to something."
    m "不，完全没头绪。连个描述都没有。她肯定是在谋划什么。"

# game/script.rpyc:12422
translate schinese main10_58e216f0:

    # m "How long have you known her, Cadence?"
    m "凯登丝，你认识她多久了？"

# game/script.rpyc:12423
translate schinese main10_acfc5035:

    # C "About five years. But I can't really say I got to know her at all, even what she's like."
    C "大概五年吧。但我其实并不了解她，甚至不知道她是个什么样的人。"

# game/script.rpyc:12424
translate schinese main10_65fe5f96:

    # C "I only knew her from a master-slave relationship. I never got to see how she behaves around others."
    C "我只知道她是我的主人，我是她的奴隶。我从未见过她在别人面前是什么样子。"

# game/script.rpyc:12425
translate schinese main10_07a75cc1:

    # C "And if she is up to something. I don't know what it is."
    C "如果她真有什么企图，我也完全不知道那是什么。"

# game/script.rpyc:12426
translate schinese main10_ced0e2b8:

    # m "Any sense of megalomania?"
    m "有没有那种妄自尊大的倾向？"

# game/script.rpyc:12427
translate schinese main10_63dc5311:

    # C "Umm... Maybe?"
    C "嗯……也许吧？"

# game/script.rpyc:12428
translate schinese main10_c7c0b9dc:

    # MC "Seemed like a hint of megalomania to me."
    MC "我觉得她确实有点妄自尊大。"

# game/script.rpyc:12432
translate schinese main10_108c171b:

    # m "And she said she'll see you again? To get Cadence back?"
    m "她说还会再来找你？是为了把凯登丝带回去吗？"

# game/script.rpyc:12433
translate schinese main10_4f779314:

    # MC "That's what it sounded like."
    MC "听起来是这样。"

# game/script.rpyc:12434
translate schinese main10_387e18a1:

    # m "Empty threats? It's not like you can just steal a slave."
    m "虚张声势？毕竟，奴隶可不是随随便便就能偷走的。"

# game/script.rpyc:12439
translate schinese main10_a06a20ce:

    # C "She was..."
    C "她当时……"

# game/script.rpyc:12443
translate schinese main10_ca9da643:

    # C "Most likely telling the truth."
    C "多半是在说实话。"

# game/script.rpyc:12444
translate schinese main10_a3c14001:

    # MC "She did seem distraught. I don't think it's only because I took what she believed was hers."
    MC "她看起来确实心烦意乱。我不认为这仅仅是因为我拿走了她自认为是属于她的东西。"

# game/script.rpyc:12445
translate schinese main10_fe680da8:

    # MC "It's Cadence she wants. Obviously I don't know why."
    MC "她想要的是凯登丝。至于原因，我显然不得而知。"

# game/script.rpyc:12446
translate schinese main10_54155e39:

    # MC "Cadence?"
    MC "凯登丝？"

# game/script.rpyc:12447
translate schinese main10_26a803bc_2:

    # C "..."
    C "……"

# game/script.rpyc:12448
translate schinese main10_e76aeab7:

    # C "She didn't use me as a slave often. Yet she still kept me around."
    C "她并不常把我当奴隶使唤，却还是把我留在了身边。"

# game/script.rpyc:12449
translate schinese main10_25a04a29:

    # C "I thought that had changed when she started bringing me to a market."
    C "当她开始带我去市场时，我还以为情况已经有所改变了。"

# game/script.rpyc:12450
translate schinese main10_b7b6d3e2:

    # C "Then day after day. I would wait in this room. No-one. No-one came in, even for a consultation."
    C "就这样日复一日，我一直在这间屋子里等待。没人来，甚至连来咨询的人都没有。"

# game/script.rpyc:12451
translate schinese main10_45723a72:

    # C "So when master came in. On his own. And started talking to {i}me{/i} instead of mas- Liliana..."
    C "所以当主人独自走进来，并且开始跟我——而不是跟莉莉安娜——说话时……"

# game/script.rpyc:12452
translate schinese main10_daf9fc73:

    # C "I didn't know what to do. I was almost paralyzed."
    C "我不知所措，整个人都僵住了。"

# game/script.rpyc:12456
translate schinese main10_a0d60dc8:

    # MC "Yeah, I noticed. You looked like you were stuck deliberating."
    MC "是啊，我注意到了。你当时看起来像是在犹豫不决。"

# game/script.rpyc:12457
translate schinese main10_3ea8e733:

    # MC "It might have been what kept me talking to you. I wasn't even entirely sure if you were for sale, or even a slave in the first place."
    MC "也许正是因为这样，我才继续跟你说话。我甚至不确定你是不是待售商品，或者说，你到底是不是个奴隶。"

# game/script.rpyc:12458
translate schinese main10_aab955d0:

    # MC "Or... supposed to be a slave anyway."
    MC "或者说……本来就该是个奴隶。"

# game/script.rpyc:12459
translate schinese main10_ed497aa1:

    # MC "It wasn't until I said your name..."
    MC "直到我喊出你的名字……"

# game/script.rpyc:12460
translate schinese main10_4445e2f3:

    # MC "Like I flipped a switch..."
    MC "就像按下了某个开关一样……"

# game/script.rpyc:12464
translate schinese main10_26a803bc_3:

    # C "..."
    C "……"

# game/script.rpyc:12468
translate schinese main10_205c3aa8:

    # m "I'm not going to lie to you, [name]."
    m "我不会骗你的，[name]。"

# game/script.rpyc:12469
translate schinese main10_b02fa83e:

    # m "This sounds dangerous."
    m "这听起来很危险。"

# game/script.rpyc:12470
translate schinese main10_c33dd27d:

    # m "Sure, I understand now why you did what you did. But you've gotten yourself into some shit."
    m "确实，我现在明白你为什么那么做了。但你惹上大麻烦了。"

# game/script.rpyc:12471
translate schinese main10_bdf52614:

    # m "Even Cadence doesn't properly know who she is. Whether she's just blowing hot air, or if she's genuinely capable of doing some serious damage."
    m "就连凯登丝自己都不完全清楚她究竟是谁。关键在于，她是在虚张声势，还是真有能力造成严重后果。"

# game/script.rpyc:12472
translate schinese main10_8c31f14d:

    # m "Legally speaking, you should have the advantage here, as long as what you told me is true and that you are demonstrably bound to her."
    m "从法律角度看，只要你告诉我的情况属实，且有确凿证据表明你受制于她，那你应该占据优势。"

# game/script.rpyc:12473
translate schinese main10_8c052a6b:

    # m "Considering that forcibly taking someone's slave isn't possible. If she wants to take it to some kind of court, she could claim blackmail or extortion."
    m "毕竟，强行夺走他人的奴隶是不可能的。如果她想诉诸法庭，可能会指控你进行勒索或敲诈。"

# game/script.rpyc:12474
translate schinese main10_3f9f5c5d:

    # m "Again, this all depends on what kind of strings she's capable of pulling."
    m "话说回来，这一切都取决于她能动用什么样的关系网。"

# game/script.rpyc:12478
translate schinese main10_7e576804:

    # m "Any ideas?"
    m "有什么想法吗？"

# game/script.rpyc:12481
translate schinese m10choice1_1_9f4c10cb:

    # MC "There's no use planning for something we don't understand."
    MC "对于我们不了解的事情，做计划也没用。"

# game/script.rpyc:12482
translate schinese m10choice1_1_b0a5eada:

    # MC "At least not for now. There are too many unknowns."
    MC "至少目前是这样。未知因素太多了。"

# game/script.rpyc:12483
translate schinese m10choice1_1_6082b1d0:

    # MC "And if you really think about it. There's nothing we {i}can{/i} do. I'd like to say that I have a plan to counterattack. But none of us do."
    MC "而且仔细想想，我们其实什么也做不了。我倒是希望能有个反击计划，但我们谁都没有。"

# game/script.rpyc:12484
translate schinese m10choice1_1_2332ba37:

    # MC "There's still time to figure these things out, ask Cadence what she knows. Maybe do some snooping of our own."
    MC "还有时间弄清楚这些事，可以问问凯登丝她知道些什么，或者我们自己去打探一下。"

# game/script.rpyc:12485
translate schinese m10choice1_1_723181d1:

    # MC "Panicking is the last thing we want to do."
    MC "惊慌失措是我们最不该做的事。"

# game/script.rpyc:12486
translate schinese m10choice1_1_0ccaff33:

    # MC "We'll take care of Cadence for now, get her settled."
    MC "我们先照顾好凯登丝，把她安顿下来。"

# game/script.rpyc:12487
translate schinese m10choice1_1_c2d81497:

    # MC "If Liliana shows up, she shows up. I'll handle it."
    MC "如果莉莉安娜现身，那就让她现身好了。我会处理的。"

# game/script.rpyc:12488
translate schinese m10choice1_1_111fd3a8:

    # MC "She's wary of me, I'm an unexpected variable in whatever she's doing."
    MC "她对我心存戒备；无论她在搞什么名堂，我都是个意料之外的变数。"

# game/script.rpyc:12492
translate schinese m10choice1_1_9627d945:

    # C "I feel like..."
    C "我觉得……"

# game/script.rpyc:12494
translate schinese m10choice1_1_bee94132:

    # C "That's a good line of reasoning."
    C "这思路很有道理。"

# game/script.rpyc:12497
translate schinese m10choice1_2_4ac454e8:

    # MC "It's simple isn't it? Liliana is clearly wary of me. She left immediately when she realized that I was more than she could handle."
    MC "道理很简单，不是吗？莉莉安娜显然对我有所忌惮。当她意识到我不是她能轻易对付的角色时，立刻就撤了。"

# game/script.rpyc:12498
translate schinese m10choice1_2_614ff70a:

    # MC "Cadence should know where to find here. I say that I go pay her a little visit."
    MC "凯登丝应该知道去哪儿找她。我看，不如我去“拜访”她一下。"

# game/script.rpyc:12499
translate schinese m10choice1_2_7b8a503e:

    # m "Are you seriously suggesting that we should use violence? You don't even know if this situation is as dramatic as it seems."
    m "你是认真的吗？竟然提议动用暴力？你甚至都不确定这事儿是不是真像表面看起来那么严重。"

# game/script.rpyc:12500
translate schinese m10choice1_2_35887b00:

    # m "Not to mention you are risking, or rather inviting police action. You seriously think I'd agree to this plan without it being a life or death situation?"
    m "更别提你这是在冒险——或者说是在招惹警察。你真觉得我会同意这种计划，除非是到了生死攸关的地步？"

# game/script.rpyc:12501
translate schinese m10choice1_2_bda77a19:

    # MC "Fine, how about some scouting first? She could be more vulnerable than we think. I'm not saying I should just rush in there-"
    MC "好吧，先去探探情况怎么样？她可能比我们想象的要脆弱。我并不是说要直接冲进去——"

# game/script.rpyc:12504
translate schinese m10choice1_2_188e8736:

    # C "I..."
    C "我……"

# game/script.rpyc:12506
translate schinese m10choice1_2_9e56d111:

    # C "Don't think that's a good idea."
    C "我觉得那不是个好主意。"

# game/script.rpyc:12507
translate schinese m10choice1_2_4fa30aee:

    # C "It would just cause more trouble for us."
    C "那只会给我们惹更多麻烦。"

# game/script.rpyc:12510
translate schinese m10choice1_3_8a88afa1:

    # MC "Let her do what she wants."
    MC "随她去吧。"

# game/script.rpyc:12511
translate schinese m10choice1_3_44491e4b:

    # m "Is that it? What if she wants to ruin your life?"
    m "就这样？万一她想毁了你的生活呢？"

# game/script.rpyc:12512
translate schinese m10choice1_3_dd39b74e:

    # MC "She's not ruining shit. I have all the cards. The longer she takes, the more I stack the deck."
    MC "她毁不了什么。主动权全在我手里。她拖得越久，我就能积累越多的筹码。"

# game/script.rpyc:12513
translate schinese m10choice1_3_21bc0a8a:

    # MC "I could sense it. Trepidation. She's knows I'm not normal, she probably even sees me as a threat, especially after I bound Cadence."
    MC "我能感觉到——那是忐忑不安。她知道我不寻常，甚至可能视我为威胁，尤其是在我束缚了凯登丝之后。"

# game/script.rpyc:12514
translate schinese m10choice1_3_ea4a7381:

    # MC "The truth is, even though {i}I{/i} don't know what's going on; {i}she{/i} does."
    MC "事实是，尽管{i}我{/i}不知道发生了什么，但{i}她{/i}知道。"

# game/script.rpyc:12518
translate schinese m10choice1_3_89141b10:

    # MC "Cadence, how emotional is Liliana?"
    MC "凯登丝，莉莉安娜的情绪波动大吗？"

# game/script.rpyc:12519
translate schinese m10choice1_3_ad77ab9e:

    # C "I'd say she's quick to anger. Other than that, aims for stoicism. I don't know how she really feels, whether she's genuinely that confident at all times, or if it's a carefully crafted facade."
    C "我觉得她很容易动怒。除此之外，她力求保持冷静沉着。我不知道她的真实感受，不知道她是真的时刻都那么自信，还是那只是一种精心伪装的假象。"

# game/script.rpyc:12523
translate schinese m10choice1_3_28129ac9:

    # MC "My point exactly. That facade didn't stay up once Cadence \"betrayed\" her for me."
    MC "正是如此。当凯登丝为了我而背叛她时，她的那副伪装就再也维持不下去了。"

# game/script.rpyc:12524
translate schinese m10choice1_3_663d8740:

    # MC "Regardless of if she knows more than we do, she was still taken aback by me. Shocked, even. She gave it away in a few split seconds, I'm a legitimate threat."
    MC "不管她掌握的信息是否比我们多，她当时确实被我震住了。甚至可以说是大吃一惊。在那电光火石的瞬间，她暴露了——她意识到我是一个真正的威胁。"

# game/script.rpyc:12525
translate schinese m10choice1_3_d2817ece:

    # MC "That means she needs to be careful when dealing with me. She may even be at a disadvantage when it comes to negotiations, if she's willing."
    MC "这意味着她在面对我时必须小心谨慎。如果她愿意谈判，甚至可能会处于劣势。"

# game/script.rpyc:12526
translate schinese m10choice1_3_e343008f:

    # MC "I think what I'm trying to say here is-"
    MC "我想说的是——"

# game/script.rpyc:12530
translate schinese m10choice1_3_a43a8eb1:

    # MC "From now on. Cadence is with me."
    MC "从现在起，凯登丝跟我站在同一阵线。"

# game/script.rpyc:12531
translate schinese m10choice1_3_bd285ca0:

    # MC "And if Liliana wants her back:"
    MC "如果莉莉安娜想把她带回去："

# game/script.rpyc:12536
translate schinese m10choice1_3_e38165cf:

    # MC "She'll need an army."
    MC "她得先组建一支军队才行。"

# game/script.rpyc:12556
translate schinese m10afterchoice1_0b1c3e88:

    # n "I came as quick as I could!"
    n "我已经用最快的速度赶来了！"

# game/script.rpyc:12557
translate schinese m10afterchoice1_3a2dcf90:

    # n "I made calls to Chloe and Grace on the way here."
    n "来的路上，我给克洛伊和格蕾丝打了电话。"

# game/script.rpyc:12561
translate schinese m10afterchoice1_0b99a33e:

    # n "[name]... What's going on?! I was in the movie theater and when I left I had a dozen missed calls and a voice message from mom!"
    n "[name]……到底出什么事了？！我刚才在电影院，出来一看，发现有十几个未接来电，还有一条妈妈留的语音信息！"

# game/script.rpyc:12562
translate schinese m10afterchoice1_c27b6267:

    # n "She said you got a-"
    n "她说你有个……"

# game/script.rpyc:12566
translate schinese m10afterchoice1_396d8b3d:

    # n "Slave..."
    n "奴隶……"

# game/script.rpyc:12581
translate schinese m10afterchoice1_dc99e90b:

    # n "Hello."
    n "你好。"

# game/script.rpyc:12582
translate schinese m10afterchoice1_0fb9891a:

    # C "Hello."
    C "你好。"

# game/script.rpyc:12583
translate schinese m10afterchoice1_c816a8a1:

    # n "..." (multiple=2)
    n "……" (multiple=2)

# game/script.rpyc:12584
translate schinese m10afterchoice1_e26c69ed:

    # C "..." (multiple=2)
    C "……" (multiple=2)

# game/script.rpyc:12592
translate schinese m10afterchoice1_9dfc96da:

    # n "[name]."
    n "[name]。"

# game/script.rpyc:12593
translate schinese m10afterchoice1_a3f24803:

    # MC "Yo."
    MC "喂。"

# game/script.rpyc:12594
translate schinese m10afterchoice1_6255089a:

    # n "Nice taste."
    n "眼光不错。"

# game/script.rpyc:12595
translate schinese m10afterchoice1_34bcbfcb:

    # MC "I didn't buy her. I... it's more complicated than that."
    MC "我没买她。我……情况比那复杂得多。"

# game/script.rpyc:12596
translate schinese m10afterchoice1_08fd0210:

    # MC "I guess everyone is going to have to hear the story at some point."
    MC "看来迟早得把这事儿讲给大家听了。"

# game/script.rpyc:12601
translate schinese m10afterchoice1_b4680d22:

    # n "I don't get it... She faked the whole slavery? I didn't know you could do that."
    n "我不明白……她是伪造了奴隶身份？我都没听说过还能这么干。"

# game/script.rpyc:12602
translate schinese m10afterchoice1_33fec2bf:

    # m "You shouldn't be able to. Could you imagine how much chaos that would cause?"
    m "按理说是不该行的。你能想象那会引发多大的混乱吗？"

# game/script.rpyc:12603
translate schinese m10afterchoice1_c02de4b8:

    # n "But everyone fell for it, right? I don't know because I'm dull, but that magic thingy you do where you scan someone for slavery, no-one else did it?"
    n "但大家都信以为真了，对吧？我不太懂这些，不过你那个扫描别人身上是否有奴隶契约的魔法……难道就没人用过吗？"

# game/script.rpyc:12604
translate schinese m10afterchoice1_ec9a6d4f:

    # C "It must've convinced them somehow."
    C "那肯定是用什么法子说服了他们。"

# game/script.rpyc:12605
translate schinese m10afterchoice1_b7cb3a27:

    # n "So it was only [name]? Why?"
    n "所以只有[name]？为什么？"

# game/script.rpyc:12606
translate schinese m10afterchoice1_6b714477:

    # MC "I wish I knew. I tried it and it was obviously fake. If everyone else saw what I saw, they would've all seen through it too."
    MC "我要是知道就好了。我试了一下，那明显是假的。如果别人也看到了我看到的东西，他们肯定也能识破。"

# game/script.rpyc:12610
translate schinese m10afterchoice1_13d00c33:

    # n "Maybe you have superpowers!"
    n "也许你有超能力！"

# game/script.rpyc:12611
translate schinese m10afterchoice1_571197c2:

    # MC "Superpowers?" (multiple=2)
    MC "超能力？" (multiple=2)

# game/script.rpyc:12612
translate schinese m10afterchoice1_5ab70f1d:

    # m "Superpowers?" (multiple=2)
    m "超能力？" (multiple=2)

# game/script.rpyc:12613
translate schinese m10afterchoice1_032501bb:

    # n "Yeah! Like you saw through the ruse because you're special! I always thought your magic seemed powerful. But you've always been weird about it, like you couldn't control it! Plus you never used to use it."
    n "对啊！就像你能识破那个骗局，因为你很特别！我一直觉得你的魔法看起来很强大。但你对它总是表现得很奇怪，好像无法控制一样！而且你以前从来不用它。"

# game/script.rpyc:12614
translate schinese m10afterchoice1_1747bb5c:

    # n "I always thought that was strange."
    n "我也一直觉得那很奇怪。"

# game/script.rpyc:12615
translate schinese m10afterchoice1_5b28bc24:

    # m "That still doesn't explain how Liliana managed to set up that whole fake slavery thing."
    m "但这还是没法解释莉莉安娜是怎么策划出那场假奴役戏码的。"

# game/script.rpyc:12619
translate schinese m10afterchoice1_5b7da65a:

    # n "Then..."
    n "那……"

# game/script.rpyc:12623
translate schinese m10afterchoice1_bc02912f:

    # n "Maybe this Liliana has superpowers, too."
    n "也许这个莉莉安娜也有超能力。"

# game/script.rpyc:12627
translate schinese m10afterchoice1_576d4a6a:

    # n "And it takes two to complement each other, she must know that the spell cast on Cadence was fake, too. So you two could have more than just that in common."
    n "而且这需要两人相辅相成，她肯定也知道施加在凯登丝身上的咒语是假的。所以你们俩的共同点可能不止这一点。"

# game/script.rpyc:12628
translate schinese m10afterchoice1_3842f564:

    # MCt "Wha-"
    MCt "什——"

# game/script.rpyc:12630
translate schinese m10afterchoice1_11d0db2c:

    # MCt "\"Too\"? Could she..."
    MCt "也？难道她……"

# game/script.rpyc:12631
translate schinese m10afterchoice1_a9ec9ab2:

    # MCt "Be like me? Or... am {i}I{/i} like {i}her{/i}? That's..."
    MCt "像我一样？或者说……是{i}我{/i}像{i}她{/i}？这……"

# game/script.rpyc:12632
translate schinese m10afterchoice1_d6488c34:

    # MCt "What if I wasn't the only one brought to this world..."
    MCt "如果来到这个世界的不仅仅是我……"

# game/script.rpyc:12636
translate schinese m10afterchoice1_bc3ab40e:

    # MC "Cadence? Anything?"
    MC "凯登丝？有什么发现吗？"

# game/script.rpyc:12637
translate schinese m10afterchoice1_68c29efb:

    # C "She never cast magic in front of me..."
    C "她从未在我面前施展过魔法……"

# game/script.rpyc:12638
translate schinese m10afterchoice1_135731c4:

    # MC "*Sigh* We're getting nowhere."
    MC "*叹气* 看来是问不出什么了。"

# game/script.rpyc:12639
translate schinese m10afterchoice1_ba7243f7:

    # C "There was that one time... When she first \"enslaved\" me."
    C "倒是有那么一次……就是她刚把我……奴役的时候。"

# game/script.rpyc:12640
translate schinese m10afterchoice1_da95543e:

    # MC "Right. So what was that like? Oh, uh... Sorry to make you relive it."
    MC "是啊。那当时是什么样的？噢，呃……抱歉让你重温那段经历。"

# game/script.rpyc:12641
translate schinese m10afterchoice1_6fe4591e:

    # C "It's fine. I understand."
    C "没关系。我明白。"

# game/script.rpyc:12642
translate schinese m10afterchoice1_cab0797c:

    # C "I know this doesn't help but... it was normal... It looked like any other binding. It even seemed the same as the one you cast on me..."
    C "我知道这没什么帮助，但……那看起来很正常……就像任何其他的束缚咒一样。甚至看起来和你对我施的那个咒语一模一样……"

# game/script.rpyc:12646
translate schinese m10afterchoice1_07711c31:

