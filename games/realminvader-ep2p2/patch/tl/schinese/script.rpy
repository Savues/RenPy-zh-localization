    # MC "..."
    MC "……"

# game/script.rpyc:8045
translate schinese m7choice6_2_5dea1b08:

    # MC "Works for me."
    MC "那正合我意。"

# game/script.rpyc:8063
translate schinese m7choice6_2_e246b5c4:

    # msgr "I..."
    msgr "我……"

# game/script.rpyc:8067
translate schinese m7choice6_2_c86e2d4b:

    # msgr "I'm in love with you, too."
    msgr "我也爱上你了。"

# game/script.rpyc:8071
translate schinese m7choice6_2_7c984c61:

    # msgr "H-how..."
    msgr "怎……怎么会……"

# game/script.rpyc:8075
translate schinese m7choice6_2_8cc429cf:

    # msgr "How many kids do you want?!" with vpunch
    msgr "你想要几个孩子？！" with vpunch

# game/script.rpyc:8079
translate schinese m7choice6_2_2d204a49_1:

    # MC "..."
    MC "……"

# game/script.rpyc:8080
translate schinese m7choice6_2_e3bd8314:

    # MC "Um... Miss. Greenslade... it's far too early in our relationship to ask such questions..."
    MC "呃……格林斯莱德小姐……我们现在的关系还没进展到能问这种问题的时候……"

# game/script.rpyc:8084
translate schinese m7choice6_2_fe13b52b:

    # msgr "Do you know how it feels to be inching closer and closer towards menopause?"
    msgr "你知道那种一步步逼近更年期的感觉吗？"

# game/script.rpyc:8085
translate schinese m7choice6_2_20d07eab:

    # msgr "I will {i}not{/i} let you deny me of my dreams."
    msgr "我绝{i}不{/i}允许你剥夺我的梦想。"

# game/script.rpyc:8086
translate schinese m7choice6_2_d349d2c3:

    # MC "Y-yes, ma'am."
    MC "是、是的，女士。"

# game/script.rpyc:8096
translate schinese m7choice6_2_f5b2cc54:

    # msgr "Got it?"
    msgr "明白了吗？"

# game/script.rpyc:8097
translate schinese m7choice6_2_42f9ad52:

    # msgr "I hope you have the next ten years of our lives memorized."
    msgr "希望你已经把我们未来十年的生活规划牢记在心了。"

# game/script.rpyc:8098
translate schinese m7choice6_2_cfe0b122:

    # msgr "I won't even except a single dent in these plans. I've been crafting them for almost thirty-years."
    msgr "这些计划绝不允许出现哪怕一丝一毫的差错。我制作它们已经快三十年了。"

# game/script.rpyc:8102
translate schinese m7choice6_2_ba012d55:

    # msgr "And I'm looking forward to our date."
    msgr "而且我很期待我们的约会。"

# game/script.rpyc:8112
translate schinese m7afterchoice6_62f8c0fd:

    # c "I thought you weren't coming."
    c "我以为你不来了。"

# game/script.rpyc:8113
translate schinese m7afterchoice6_d30a51bb:

    # MC "Sorry, getting here was more difficult than I expected."
    MC "抱歉，来这里的路比我预想的要难走。"

# game/script.rpyc:8117
translate schinese m7afterchoice6_5b39f565:

    # MC "Here."
    MC "给你。"

# game/script.rpyc:8121
translate schinese m7afterchoice6_dd20ffbf:

    # c "Thanks."
    c "谢谢。"

# game/script.rpyc:8131
translate schinese m7afterchoice6_16c674da:

    # c "What are you looking so smug about?"
    c "你那一脸得意的样子是为什么？"

# game/script.rpyc:8135
translate schinese m7afterchoice6_c5e311cc:

    # MC "You should've seen it, Chloe."
    MC "你真该亲眼看看那一幕，克洛伊。"

# game/script.rpyc:8139
translate schinese m7afterchoice6_9b54a583:

    # MC "Oh, wait."
    MC "噢，等等。"

# game/script.rpyc:8143
translate schinese m7afterchoice6_78b83776:

    # MC "It was impossible to see me."
    MC "当时根本没人能看见我。"

# game/script.rpyc:8147
translate schinese m7afterchoice6_5b39f565_1:

    # MC "Here."
    MC "给你。"

# game/script.rpyc:8148
translate schinese m7afterchoice6_234beaeb:

    # MC "Take your homework."
    MC "把你的作业拿去。"

# game/script.rpyc:8183
translate schinese m7afterchoice6_89154424:

    # MC "Did I really have to do this?"
    MC "我真的非做这个不可吗？"

# game/script.rpyc:8184
translate schinese m7afterchoice6_62a9c633:

    # MC "Can't you just make up an excuse or something?"
    MC "你就不能随便找个借口之类的吗？"

# game/script.rpyc:8185
translate schinese m7afterchoice6_47fb0447:

    # MC "It's just one homework."
    MC "这只是一份作业而已。"

# game/script.rpyc:8189
translate schinese m7afterchoice6_ee349493:

    # c "It's not the first..."
    c "这又不是第一次……"

# game/script.rpyc:8190
translate schinese m7afterchoice6_6e75ec90:

    # c "The teacher said I'd get detention if I miss one more."
    c "老师说我要是再缺席一次，就得留堂了。"

# game/script.rpyc:8194
translate schinese m7afterchoice6_92c2a57d:

    # MC "Sounds to me like you deserve that detention."
    MC "听起来，你这留堂是自找的。"

# game/script.rpyc:8203
translate schinese m7afterchoice6_5c644b8e:

    # MC "What was that for?!"
    MC "你干嘛打我？！"

# game/script.rpyc:8207
translate schinese m7afterchoice6_195f7802:

    # c "Those sunglasses were kind of annoying me."
    c "那副墨镜看着挺碍眼的。"

# game/script.rpyc:8208
translate schinese m7afterchoice6_79a44935:

    # MC "Well, thankfully your tiny frame can't slap for shit."
    MC "好在你的小身板儿，扇起耳光来一点劲儿都没有。"

# game/script.rpyc:8209
translate schinese m7afterchoice6_4b1d9f05:

    # MC "Nor do homework for that matter."
    MC "做作业也是一样，没啥长进。"

# game/script.rpyc:8210
translate schinese m7afterchoice6_6b2a3256:

    # MC "I looked over it."
    MC "我刚才看了一下。"

# game/script.rpyc:8211
translate schinese m7afterchoice6_4bbb922a:

    # c "Why do {i}you{/i} care?"
    c "你{i}干嘛{/i}操心这个？"

# game/script.rpyc:8215
translate schinese m7afterchoice6_bcd94307:

    # MC "We've all heard Miya chewing you out for under-performing at school."
    MC "大家都听见米娅数落你学业表现不佳了。"

# game/script.rpyc:8216
translate schinese m7afterchoice6_7e295987:

    # MC "I thought I'd see what's going on."
    MC "我就想看看是怎么回事。"

# game/script.rpyc:8217
translate schinese m7afterchoice6_7a13dac9:

    # MC "You haven't even finished it. And what you {i}have{/i} done is pretty sloppy."
    MC "你根本没做完。而且{i}做完的{/i}那些也挺敷衍的。"

# game/script.rpyc:8218
translate schinese m7afterchoice6_ff8578cf:

    # MC "Be honest with me. How much time did you actually spend on this?"
    MC "跟我说实话。你到底在这上面花了多少时间？"

# game/script.rpyc:8219
translate schinese m7afterchoice6_d19f855d:

    # c "..."
    c "……"

# game/script.rpyc:8220
translate schinese m7afterchoice6_c5e69f93:

    # c "Like... ten minutes..."
    c "呃……大概十分钟吧……"

# game/script.rpyc:8221
translate schinese m7afterchoice6_c9e81035:

    # MC "Last night?"
    MC "昨晚？"

# game/script.rpyc:8233
translate schinese m7afterchoice6_2fb90bab:

    # MC "Fell asleep?"
    MC "睡着了？"

# game/script.rpyc:8248
translate schinese m7afterchoice6_a6c50e0e:

    # MC "Hmm..."
    MC "嗯……"

# game/script.rpyc:8249
translate schinese m7afterchoice6_7138e6a7:

    # MC "Almost every one of your problems can be traced back to sleep deprivation."
    MC "你遇到的几乎所有问题，归根结底都是睡眠不足造成的。"

# game/script.rpyc:8256
translate schinese m7afterchoice6_dc551e26:

    # "{i}{u}???" "Found you!"
    "{i}{u}？？？" "找到你了！"

# game/script.rpyc:8260
translate schinese m7afterchoice6_1ccf8c1b:

    # c "Oh, no..."
    c "噢，不……"

# game/script.rpyc:8265
translate schinese m7afterchoice6_c3b6565f:

    # MC "Eh, whatever, I'm not a sleep therapist."
    MC "呃，算了，我又不是睡眠治疗师。"

# game/script.rpyc:8269
translate schinese m7afterchoice6_dd384f84:

    # MC "We've still got the whole of recess."
    MC "我们还有整个课间休息时间呢。"

# game/script.rpyc:8270
translate schinese m7afterchoice6_624a66a9:

    # MC "I'll just tell you the rest of the answers and you fill them out on the sheet."
    MC "我把剩下的答案告诉你，你填在纸上就行。"

# game/script.rpyc:8274
translate schinese m7afterchoice6_4917a7a7:

    # c "Really?!"
    c "真的吗？！"

# game/script.rpyc:8275
translate schinese m7afterchoice6_a184d8a7:

    # MC "Yeah, I don't really give a shit that you didn't do it. I'm more concerned about your sleeping to be honest."
    MC "是啊，你没做作业我其实根本不在乎。老实说，我更担心的是你睡觉的问题。"

# game/script.rpyc:8276
translate schinese m7afterchoice6_5671c8d7:

    # MC "Get a pen."
    MC "拿支笔来。"

# game/script.rpyc:8284
translate schinese m7afterchoice6_93eb8911:

    # c "Thank you!"
    c "谢谢！"

# game/script.rpyc:8288
translate schinese m7afterchoice6_ce6231d3:

    # c "Thank you, thank you, thank you!"
    c "谢谢，谢谢，谢谢！"

# game/script.rpyc:8291
translate schinese m7afterchoice6_a45c7ee1:

    # c "I definitely won't get detention with this!"
    c "这下我肯定不用留堂了！"

# game/script.rpyc:8296
translate schinese m7afterchoice6_dc551e26_1:

    # "{i}{u}???" "Found you!"
    "{i}{u}？？？" "找到你了！"

# game/script.rpyc:8300
translate schinese m7afterchoice6_1ccf8c1b_1:

    # c "Oh, no..."
    c "噢，不……"

# game/script.rpyc:8307
translate schinese m7afterchoice6_964f6de2:

    # "{i}{u}???" "I hope I'm not interrupting something."
    "{i}{u}？？？" "希望我没打扰到你们。"

# game/script.rpyc:8311
translate schinese m7afterchoice6_50bb49ad:

    # "{i}{u}???" "I was looking for you, Chloe."
    "{i}{u}？？？" "我一直在找你，克洛伊。"

# game/script.rpyc:8315
translate schinese m7afterchoice6_8a98a3b5:

    # "{i}{u}???" "It's not often I see you here."
    "{i}{u}？？？" "很少见你来这儿。"

# game/script.rpyc:8319
translate schinese m7afterchoice6_466f97c4:

    # "{i}{u}???" "Or with someone..."
    "{i}{u}？？？" "或者跟别人在一起……"

# game/script.rpyc:8320
translate schinese m7afterchoice6_68deef64:

    # "{i}{u}???" "Hello, there."
    "{i}{u}？？？" "你好啊。"

# game/script.rpyc:8328
translate schinese m7afterchoice6_fc57ac86:

    # "{i}{u}???" "You're quite tall. Are you in your final year?"
    "{i}{u}？？？" "你个子挺高的。你是在读最后一年吗？"

# game/script.rpyc:8332
translate schinese m7afterchoice6_f0cbdf92:

    # c "It's [name]."
    c "我叫[name]。"

# game/script.rpyc:8336
translate schinese m7afterchoice6_48418d07:

    # "{i}{u}???" "Oh, wow! This is [name]?"
    "{i}{u}？？？" "噢，哇！这就是[name]吗？"

# game/script.rpyc:8354
translate schinese m7afterchoice6_b76c3dde:

    # "{i}{u}???" "It's a pleasure to make your acquaintance, [name]."
    "{i}{u}？？？" "很高兴认识你，[name]。"

# game/script.rpyc:8358
translate schinese m7afterchoice6_bbe6fa9f:

    # v "My name is Vineeta. Eternal friend of little Chloe."
    v "我叫维妮塔。是小克洛伊永远的朋友。"

# game/script.rpyc:8362
translate schinese m7afterchoice6_7c4fd0a1:

    # c "I'm taller than you."
    c "我比你高。"

# game/script.rpyc:8366
translate schinese m7afterchoice6_4fbfa172:

    # v "And Chloe is the eternal friend of little me."
    v "而克洛伊是我——那个小小的我——永远的朋友。"

# game/script.rpyc:8370
translate schinese m7afterchoice6_c4ec500b:

    # v "I have to ask, [name], why are you currently trespassing in our school?"
    v "我得问问，[name]，你为什么擅自闯入我们的学校？"

# game/script.rpyc:8371
translate schinese m7afterchoice6_5ffa76cd:

    # v "Wearing a disguise, no less."
    v "而且还乔装打扮了一番。"

# game/script.rpyc:8372
translate schinese m7afterchoice6_d631219e:

    # MC "I'm just making a delivery to Chloe."
    MC "我只是来给克洛伊送个东西。"

# game/script.rpyc:8373
translate schinese m7afterchoice6_3e61350f:

    # v "Oh, how reliable."
    v "噢，真是可靠啊。"

# game/script.rpyc:8377
translate schinese m7afterchoice6_e81b0db2:

    # v "Hmm... maybe Chloe {i}wasn't{/i} exaggerating..."
    v "嗯……也许克洛伊{i}并没有{/i}夸大其词……"

# game/script.rpyc:8378
translate schinese m7afterchoice6_29f64ce8:

    # MC "About what?"
    MC "关于什么？"

# game/script.rpyc:8382
translate schinese m7afterchoice6_d14787e4:

    # v "I've known Chloe for a long time. We've been friends since we were children."
    v "我认识克洛伊很久了。我们从小就是朋友。"

# game/script.rpyc:8386
translate schinese m7afterchoice6_77999807:

    # v "She always used to talk about you fondly."
    v "她以前总会满怀好感地提起你。"

# game/script.rpyc:8390
translate schinese m7afterchoice6_2fd6a637:

    # v "[name]'s the coolest."
    v "[name]是最酷的。"

# game/script.rpyc:8393
translate schinese m7afterchoice6_e600af15:

    # v "[name]'s the strongest."
    v "[name]是最强的。"

# game/script.rpyc:8397
translate schinese m7afterchoice6_aad7a371:

    # v "He's so smart..."
    v "他好聪明……"

# game/script.rpyc:8401
translate schinese m7afterchoice6_cd2987e6:

    # v "I remember asking her what she thought about Dexter, the most popular guy in our grade."
    v "我记得曾问过她对德克斯特（Dexter）——也就是我们年级最受欢迎的男生——的看法。"

# game/script.rpyc:8402
translate schinese m7afterchoice6_7a252875:

    # v "And she said-"
    v "然后她说——"

# game/script.rpyc:8412
translate schinese m7afterchoice6_65cabcbf:

    # v "..."
    v "……"

# game/script.rpyc:8416
translate schinese m7afterchoice6_a9a0a1b2:

    # MCt "I had no idea that Chloe used to look up to me so much..."
    MCt "我完全没想到克洛伊以前竟然那么崇拜我……"

# game/script.rpyc:8420
translate schinese m7afterchoice6_34151b11:

    # MCt "She had been kind of distant, lately..."
    MCt "最近她好像有点疏远我了……"

# game/script.rpyc:8424
translate schinese m7afterchoice6_2cba7448:

    # MCt "Maybe it's a rebellious phase..."
    MCt "也许是到了叛逆期吧……"

# game/script.rpyc:8428
translate schinese m7afterchoice6_b3b3cc9d:

    # MCt "Hmm... How do I really think about Chloe?"
    MCt "嗯……我到底是怎么看待克洛伊的呢？"

# game/script.rpyc:8444
translate schinese m7choice7_1_f9d91080:

    # MCt "Rough, huh?"
    MCt "挺粗暴的，是吧？"

# game/script.rpyc:8445
translate schinese m7choice7_1_79f317db:

    # MCt "I guess her tiny frame would make it easy to throw her around..."
    MCt "我想，凭她那娇小的身形，应该很容易把她甩来甩去吧……"

# game/script.rpyc:8460
translate schinese m7afterchoice7_b58e6980:

    # v "*Sigh* Let's go."
    v "*叹气* 走吧。"

# game/script.rpyc:8469
translate schinese m7afterchoice7_ee6d7b45:

    # v "[name]?"
    v "[name]？"

# game/script.rpyc:8483
translate schinese m7afterchoice7_beecf43f:

    # "{i}{u}Ricky{/i}{/u}" "Ayyy, Mr S. You're a real swell cat, y'know that?"
    "{i}{u}瑞奇{/i}{/u}" "Ayy哎，S老师。你可真是个了不起的家伙，知道吗？

# game/script.rpyc:8484
translate schinese m7afterchoice7_7ae4d040:

    # stew "Rev those engines, Ricky! If I can still hear you that means you aren't revving hard enough!"
    stew "把引擎轰起来，瑞奇！如果我还能听见你的声音，那就说明你油门踩得还不够狠！"

# game/script.rpyc:8485
translate schinese m7afterchoice7_56015298:

    # "{i}{u}Ricky{/i}{/u}" "Aww shucks, Mr. S, that's all you had to say!"
    "{i}{u}瑞奇{/i}{/u}" "Aww哎呀，S老师，你早说嘛！

# game/script.rpyc:8494
translate schinese m7afterchoice7_02ff8eb4:

    # v "What are you looking at?"
    v "你在看什么？"

# game/script.rpyc:8496
translate schinese m7afterchoice7_a5b00b83:

    # MC "The greatest damn teacher who ever lived..."
    MC "史上最牛的老师……"

# game/script.rpyc:8502
translate schinese m7afterchoice7_24435a63:

    # v "[name], I have to wonder..."
    v "[name]，我很好奇……"

# game/script.rpyc:8503
translate schinese m7afterchoice7_31f12021:

    # v "How do you plan on sneaking out of here?"
    v "你打算怎么溜出去？"

# game/script.rpyc:8507
translate schinese m7afterchoice7_ed9095a6:

    # MC "\"Sneaking\"?"
    MC "“溜出去”？"

# game/script.rpyc:8511
translate schinese m7afterchoice7_528b43f2:

    # MC "What's that teacher's name?"
    MC "那个老师叫什么名字？"

# game/script.rpyc:8512
translate schinese m7afterchoice7_89c858bc:

    # c "Mr. Dobson?"
    c "多布森先生？"

# game/script.rpyc:8513
translate schinese m7afterchoice7_914ec0c5:

    # MC "Cool, thanks."
    MC "太好了，谢谢。"

# game/script.rpyc:8517
translate schinese m7afterchoice7_6cc27947:

    # MC "Ayo, Mr. Dobson!"
    MC "嘿，多布森先生！"

# game/script.rpyc:8596
translate schinese m7afterchoice7_dbf4695c:

    # MC "Morning, Ron, wuss poppin'?!"
    MC "早啊，罗纳德，最近怎么样？"

# game/script.rpyc:8600
translate schinese m7afterchoice7_99230b5a:

    # ron "Stella's teaching you today."
    ron "今天由斯特拉来教你。"

# game/script.rpyc:8629
translate schinese m7afterchoice7_8f9d0d82:

    # MC "Does that guy ever relax?"
    MC "那家伙难道就不能放松一下吗？"

# game/script.rpyc:8633
translate schinese m7afterchoice7_0206370e:

    # s "Not at all."
    s "完全不会。"

# game/script.rpyc:8634
translate schinese m7afterchoice7_920564cc:

    # MC "Wait, really?! He's always like this?"
    MC "等等，真的吗？！他一直都这样？"

# game/script.rpyc:8635
translate schinese m7afterchoice7_66ee1789:

    # s "Mm-hmm."
    s "嗯。"

# game/script.rpyc:8636
translate schinese m7afterchoice7_3256ca35:

    # s "Ronald takes... uh... life... very seriously."
    s "罗纳德把……呃……生活……看得非常严肃。"

# game/script.rpyc:8637
translate schinese m7afterchoice7_9f1c7ad2:

    # s "He always has."
    s "他一直都是这样。"

# game/script.rpyc:8638
translate schinese m7afterchoice7_458ec518:

    # MC "Don't you find it... how do I put this?"
    MC "你不觉得……该怎么说呢……"

# game/script.rpyc:8639
translate schinese m7afterchoice7_c61ac1ea:

    # MC "Grating?"
    MC "让人受不了吗？"

# game/script.rpyc:8643
translate schinese m7afterchoice7_550ea09a:

    # s "Not particularly."
    s "倒也不觉得。"

# game/script.rpyc:8644
translate schinese m7afterchoice7_f82067dc:

    # s "I've known him my whole life. He may seem blunt. But I know him better than anyone else. I know how he truly is."
    s "我认识他一辈子了。他看起来或许有些直率，但我比任何人都了解他。我知道他真正的为人。"

# game/script.rpyc:8645
translate schinese m7afterchoice7_8aba91e0:

    # MC "And how is that?"
    MC "那他是个什么样的人？"

# game/script.rpyc:8650
translate schinese m7afterchoice7_bff04be6:

    # s "He's someone who cares too much."
    s "他是个太爱操心的人。"

# game/script.rpyc:8655
translate schinese m7afterchoice7_10184f0a:

    # MC "Wait."
    MC "等等。"

# game/script.rpyc:8659
translate schinese m7afterchoice7_25eeb7e1:

    # MC "Your {i}whole{/i} life?"
    MC "你{i}整整{/i}一辈子？"

# game/script.rpyc:8660
translate schinese m7afterchoice7_2eb6d06a:

    # MC "Didn't you say you've been his slave for thirteen years?"
    MC "你不是说你当了他十三年的奴隶吗？"

# game/script.rpyc:8661
translate schinese m7afterchoice7_f95e7eca:

    # MC "Wouldn't that have made you five years old?"
    MC "那算起来你当时才五岁吧？"

# game/script.rpyc:8665
translate schinese m7afterchoice7_e63ecff4:

    # MC "How did you become his slave, anyway?"
    MC "话说回来，你是怎么成为他的奴隶的？"

# game/script.rpyc:8666
translate schinese m7afterchoice7_f3852344:

    # MC "What about your parents?"
    MC "你的父母呢？"

# game/script.rpyc:8670
translate schinese m7afterchoice7_e1554201:

    # s "..."
    s "……"

# game/script.rpyc:8671
translate schinese m7afterchoice7_61ecc309:

    # s "I don't know."
    s "我不知道。"

# game/script.rpyc:8672
translate schinese m7afterchoice7_95e59f81:

    # MC "What?!"
    MC "什么？！"

# game/script.rpyc:8673
translate schinese m7afterchoice7_8c87ff77:

    # s "I'm sorry."
    s "抱歉。"

# game/script.rpyc:8674
translate schinese m7afterchoice7_61ecc309_1:

    # s "I don't know."
    s "我不知道。"

# game/script.rpyc:8675
translate schinese m7afterchoice7_a371d776:

    # s "I don't remember anything since before then..."
    s "我不记得那之前发生的任何事了……"

# game/script.rpyc:8676
translate schinese m7afterchoice7_4019495d:

    # s "Even my memories of that time are fuzzy."
    s "就连关于那个时期的记忆也很模糊。"

# game/script.rpyc:8677
translate schinese m7afterchoice7_b594bebc:

    # s "Ron says he got me at a market, and that I had no memories then, either."
    s "罗纳德说他是在市场上买下我的，当时我就已经没有记忆了。"

# game/script.rpyc:8678
translate schinese m7afterchoice7_0628fa53:

    # MC "At five?!"
    MC "五岁的时候？！"

# game/script.rpyc:8679
translate schinese m7afterchoice7_e44db692:

    # s "I think his research..."
    s "我想他的研究……"

# game/script.rpyc:8683
translate schinese m7afterchoice7_c74b98e4:

    # s "He wants to look into my memories."
    s "他想探究我的记忆。"

# game/script.rpyc:8684
translate schinese m7afterchoice7_2b3cf52f:

    # s "I don't know that for sure. But everything I see... He's looking into human thoughts, memories, methods of interacting with them."
    s "我也不敢肯定。但从我所见的一切来看……他正在研究人类的思想、记忆以及与这些事物交互的方法。"

# game/script.rpyc:8685
translate schinese m7afterchoice7_51541d22:

    # s "Obviously I'm speculating. But that's how it seems to me."
    s "显然，这只是我的推测。但给我的感觉就是这样。"

# game/script.rpyc:8686
translate schinese m7afterchoice7_2d204a49:

    # MC "..."
    MC "……"

# game/script.rpyc:8687
translate schinese m7afterchoice7_4ad57842:

    # s "Can I ask {i}you{/i} a question?"
    s "我能问{i}你{/i}一个问题吗？"

# game/script.rpyc:8688
translate schinese m7afterchoice7_690b7417:

    # MC "Sure."
    MC "当然。"

# game/script.rpyc:8689
translate schinese m7afterchoice7_df40801c:

    # s "Did you really put a tracking spell on your Embers?"
    s "你真的在你的“余烬”上施了追踪咒吗？"

# game/script.rpyc:8693
translate schinese m7afterchoice7_e6594e15:

    # MC "Yeah, I did. I didn't expect it to be such a big deal."
    MC "是的，我施了。我没想到这会引起这么大的反响。"

# game/script.rpyc:8698
translate schinese m7afterchoice7_2658deff:

    # s "That's so cool!"
    s "那太酷了！"

# game/script.rpyc:8699
translate schinese m7afterchoice7_04229737:

    # MC "It is?"
    MC "是吗？"

# game/script.rpyc:8704
translate schinese m7afterchoice7_d0ffd6e1:

    # s "It's super cool!"
    s "简直酷毙了！"

# game/script.rpyc:8705
translate schinese m7afterchoice7_b26f5e97:

    # s "You cast a spell that no-one has ever heard of before!"
    s "你施展了一个前所未闻的咒语！"

# game/script.rpyc:8723
translate schinese m7afterchoice7_1f9dfdf4:

    # MC "So why did Ron abandon our session today?"
    MC "那罗纳德为什么中途离开了今天的课程？"

# game/script.rpyc:8727
translate schinese m7afterchoice7_32dcc897:

    # s "Emergency substitution at the college."
    s "学院那边有急事，需要他去代课。"

# game/script.rpyc:8728
translate schinese m7afterchoice7_fea6a280:

    # s "The department there is considerably robust, but not in his school."
    s "那里的相关院系实力相当雄厚，但他所在的学院并非如此。"

# game/script.rpyc:8729
translate schinese m7afterchoice7_80c8104c:

    # MC "Which school is it he specializes in?"
    MC "他是哪个学院的专家？"

# game/script.rpyc:8730
translate schinese m7afterchoice7_e6f03c75:

    # s "Psychological. He said he's the only other lecturer who was qualified to deliver the lecture."
    s "心理学。他说他是除主讲人外，唯一有资格讲授这门课的讲师。"

# game/script.rpyc:8731
translate schinese m7afterchoice7_2ba7d15f:

    # MC "He said that {i}you're{/i} teaching me today?"
    MC "他说今天由{i}你{/i}来教我？"

# game/script.rpyc:8735
translate schinese m7afterchoice7_ad5d6e4e:

    # s "Ronald trusts me. He taught me himself."
    s "罗纳德很信任我。我是他亲自教出来的。"

# game/script.rpyc:8736
translate schinese m7afterchoice7_09238b52:

    # s "You're in safe hands."
    s "跟着我，你大可放心。"

# game/script.rpyc:8737
translate schinese m7afterchoice7_120e5e98:

    # MC "I'll hold you to that."
    MC "那我可记住了。"

# game/script.rpyc:8741
translate schinese m7afterchoice7_feaf82b0:

    # s "Shall we begin?"
    s "我们开始吧？"

# game/script.rpyc:8887
translate schinese m7afterchoice7_b0060bf9:

    # s "You're amazing, master [name]!"
    s "您太厉害了，主人[name]！"

# game/script.rpyc:8891
translate schinese m7afterchoice7_a4bf1ab3:

    # s "You learn so quickly!"
    s "你学得真快！"

# game/script.rpyc:8892
translate schinese m7afterchoice7_1e4647d6:

    # s "You even started to control yourself!"
    s "你甚至开始学会控制自己了！"

# game/script.rpyc:8893
translate schinese m7afterchoice7_3bd635d3:

    # s "I thought you'd blow a hole in the apartment."
    s "我还以为你会把公寓炸个洞出来呢。"

# game/script.rpyc:8897
translate schinese m7afterchoice7_e787ed3e:

    # s "I think I'm going to miss all of those pretty colors you made."
    s "我想我会怀念你制造出的那些绚丽色彩的。"

# game/script.rpyc:8898
translate schinese m7afterchoice7_84a50067:

    # MC "I think I can still do that if I try hard enough."
    MC "我觉得只要足够努力，我还是能做到的。"

# game/script.rpyc:8909
translate schinese m7afterchoice7_962b475c:

    # s "Please stop, master [name]! I don't want to die!"
    s "请住手，主人[name]！我不想死！"

# game/script.rpyc:8915
translate schinese m7afterchoice7_fc6bdf73:

    # s "What spell {i}was{/i} that?"
    s "那{i}是{/i}什么法术？"

# game/script.rpyc:8916
translate schinese m7afterchoice7_5714e6a8:

    # MC "I dunno but it looked kinda cool, didn't it?"
    MC "我不知道，但看起来挺酷的，不是吗？"

# game/script.rpyc:8921
translate schinese m7afterchoice7_c71836a1:

    # s "STOP!"
    s "住手！"

# game/script.rpyc:8929
translate schinese m7afterchoice7_4787d70a:

    # MC "I have a question."
    MC "我有个问题。"

# game/script.rpyc:8936
translate schinese m7afterchoice7_3bb065eb:

    # MC "You've taught me how to detect slaves, but I was seeing this collar on people {i}before{/i} I knew how to cast it."
    MC "你教过我怎么侦测奴隶，可在我学会施放这个咒语{i}之前{/i}，就已经在别人身上看见那个项圈了。"

# game/script.rpyc:8937
translate schinese m7afterchoice7_c52fb80a:

    # MC "Then after a while it stopped."
    MC "过了一会儿，它就停了。"

# game/script.rpyc:8941
translate schinese m7afterchoice7_b3b9c0e8:

    # s "Hmm..."
    s "嗯……"

# game/script.rpyc:8942
translate schinese m7afterchoice7_719794f5:

    # s "I can't say for sure."
    s "我也不敢肯定。"

# game/script.rpyc:8943
translate schinese m7afterchoice7_6bb45847:

    # s "But if I were to guess, I'd say you were probably casting the spell without knowing it."
    s "不过我猜，你当时可能是在无意识地施展魔法。"

# game/script.rpyc:8944
translate schinese m7afterchoice7_9809eaeb:

    # s "Now you've practiced using magic your control over it has stabilized. So you probably don't cast spells unconsciously anymore."
    s "现在你练习过魔法了，对它的控制也稳定了下来，所以应该不会再无意识地施法了。"

# game/script.rpyc:8945
translate schinese m7afterchoice7_f1eacc28:

    # MC "Maybe. That sounds like a good explanation."
    MC "也许吧，这听起来很有道理。"

# game/script.rpyc:8949
translate schinese m7afterchoice7_05b6255b:

    # s "I think we've gone through everything today."
    s "我想今天的课程就到这里吧。"

# game/script.rpyc:8950
translate schinese m7afterchoice7_7b3d3933:

    # s "You're really impressive, master [name]. I think you're supremely talented."
    s "您真的很厉害，主人[name]。我觉得您天赋极高。"

# game/script.rpyc:8951
translate schinese m7afterchoice7_cc402fc6:

    # s "Do you have any more questions?"
    s "还有什么问题吗？"

# game/script.rpyc:8991
translate schinese m7afterchoice7_092f5598:

    # MCt "Never mind, we're back in business!"
    MCt "没别的事了，我们继续干活吧！"

# game/script.rpyc:9014
translate schinese m7afterchoice7_83c7856a:

    # MC "???"
    MC "？？？"

# game/script.rpyc:9089
translate schinese m7afterchoice7_1f943a3e:

    # s "Ron should be coming home any moment now."
    s "罗纳德应该很快就会回来了。"

# game/script.rpyc:9090
translate schinese m7afterchoice7_18f58d13:

    # s "You're free to leave since our work is done."
    s "既然我们的工作已经完成，你可以走了。"

# game/script.rpyc:9091
translate schinese m7afterchoice7_12c6f3b4:

    # s "I'll be sure to report your progress to him."
    s "我会向他汇报你的进展的。"

# game/script.rpyc:9092
translate schinese m7afterchoice7_4790b15b:

    # MC "You know what? The thought of leaving here before he shows up is just swell."
    MC "你知道吗？一想到能在他出现之前离开这里，我就觉得太棒了。"

# game/script.rpyc:9132
translate schinese main8_d6547783:

    # "{i}{u}Kid" "Ahh!"
    "{i}{u}小孩" "A啊！

# game/script.rpyc:9138
translate schinese main8_8b03ef6b:

    # "{i}{u}Kid" "S-sorry, mister..."
    "{i}{u}小孩" "S对、对不起，先生……

# game/script.rpyc:9169
translate schinese main8_c2a92d36:

    # "{i}{u}???" "Excellent! The children are gone."
    "{i}{u}？？？" "太好了！孩子们都走了。"

# game/script.rpyc:9174
translate schinese main8_a48469dd:

    # shad "And it's all thanks to you, my scary friend."
    shad "这全都要归功于你，我那可怕的朋友。"

# game/script.rpyc:9175
translate schinese main8_bd0851c8:

    # shad "It's so difficult to do business in broad daylight."
    shad "光天化日之下做生意真难啊。"

# game/script.rpyc:9176
translate schinese main8_3479da8f:

    # shad "But miracle workers like {i}you{/i} make my life run like a dream."
    shad "但像{i}你{/i}这样的能人，让我的生意顺风顺水。"

# game/script.rpyc:9177
translate schinese main8_aa1e60c2:

    # shad "For you, my friend. A special deal, if you're interested!"
    shad "给你的，我的朋友。如果你感兴趣，有个特别优惠！"

# game/script.rpyc:9178
translate schinese main8_290f8ca4:

    # shad "At a discounted rate;"
    shad "打折优惠；"

# game/script.rpyc:9183
translate schinese main8_e3a44af4:

    # shad "Care to purchase a rare anal ornament from my cart of rare anal ornaments?"
    shad "要不要从我的稀有肛门饰品推车里买个稀有肛门饰品？"

# game/script.rpyc:9197
translate schinese main8_93363558:

    # shad "Ahh! No! Wait! Wait!"
    shad "啊！不！等等！等等！"

# game/script.rpyc:9202
translate schinese main8_6bca728e:

    # shad "Do you know how difficult it is to sell butt plugs on this city's streets?"
    shad "你知道在这座城市的街头兜售肛塞有多难吗？"

# game/script.rpyc:9203
translate schinese main8_a8df60ed:

    # shad "Do you know how many people a willing to make such a purchase in the middle of the afternoon?"
    shad "你知道大下午的有几个人愿意买这种东西吗？"

# game/script.rpyc:9209
translate schinese main8_5198cc9a:

    # shad "It's actually more than you'd think but..."
    shad "其实人数比你想象的要多，但是……"

# game/script.rpyc:9215
translate schinese main8_7a912642:

    # shad "You haven't even seen the prices I offer."
    shad "你还没看过我开出的价格呢。"

# game/script.rpyc:9216
translate schinese main8_689c4e3e:

    # shad "You can see them, look at the craftsmanship, and the rare shitsium crystals embedded in the base! Mined from deep within the infinite forest!"
    shad "你可以看看，瞧瞧这做工，还有底座上镶嵌的稀有“屎晶”（Shitsium）！那可是从无尽森林深处开采出来的！"

# game/script.rpyc:9217
translate schinese main8_80b5daa1:

    # shad "Such a delightful piece of art... With your earlier efforts of dispersing the children..."
    shad "多么精美的艺术品啊……再加上你刚才驱散那些小孩的举动……"

# game/script.rpyc:9221
translate schinese main8_cf258619:

    # shad "A supremely reasonable..."
    shad "这可是极其合理的……"

# game/script.rpyc:9232
translate schinese main8_0f011805:

    # shad "Okay! Okay!"
    shad "好好好！"

# game/script.rpyc:9233
translate schinese main8_d40f6c05:

    # shad "Please, just hear me out! This thing might not actually be to your tastes but the materials really {i}are{/i} valuable!"
    shad "拜托，听我说完！这东西也许不合你的口味，但它的材质可是货真价实、价值连城的！"

# game/script.rpyc:9237
translate schinese main8_89df57dc:

    # shad "C'mon, sir, look at it! See how it glistens?"
    shad "来，先生，瞧瞧这个！看它闪闪发光的样子？"

# game/script.rpyc:9238
translate schinese main8_e005ff1b:

    # shad "You can break off the crystals if you want."
    shad "你要是想要，随时可以把上面的晶体掰下来。"

# game/script.rpyc:9239
translate schinese main8_686bd28a:

    # MCt "..."
    MCt "……"

# game/script.rpyc:9240
translate schinese main8_7d6375e5:

    # MCt "Miya would probably like those crystals..."
    MCt "米娅应该会喜欢这些晶体……"

# game/script.rpyc:9245
translate schinese main8_2c784af4:

    # shad "Ahh, I can see it in your eyes! You realize now, don't you?! The true value of these items is not what they do to your anus, but what they do to your heart."
    shad "啊，我从你的眼神里看出来了！你现在明白了吧？！这些东西真正的价值，不在于它们能对你的肛门做什么，而在于它们能触动你的内心。"

# game/script.rpyc:9246
translate schinese main8_ce11f6cf:

    # shad "You are interested, no?"
    shad "你感兴趣，对吧？"

# game/script.rpyc:9251
translate schinese main8_6fb3b433:

    # MC "I'm only interested in buying them for what they're actually worth."
    MC "我只对按其实际价值购买它们感兴趣。"

# game/script.rpyc:9255
translate schinese main8_73bd1e21:

    # shad "Eheh... I see you are capable of bartering..."
    shad "嘿嘿……看来你很擅长讨价还价嘛……"

# game/script.rpyc:9259
translate schinese main8_98365a53:

    # MC "I'm capable of walking away if that's what you really want."
    MC "如果你真想这样，我随时可以走人。"

# game/script.rpyc:9260
translate schinese main8_bf90d1f9:

    # shad "Ehh... that would be disastrous for business."
    shad "呃……那生意可就全毁了。"

# game/script.rpyc:9261
translate schinese main8_89ffa9a4:

    # MC "Not {i}my{/i} business."
    MC "又不是{i}我的{/i}生意。"

# game/script.rpyc:9262
translate schinese main8_1b5dc894:

    # MC "You wanna scam me? You can shove them up your own ass. Along with my foot."
    MC "想坑我？那你干脆把这玩意儿连同我的脚一起塞进你屁眼里去吧。"

# game/script.rpyc:9263
translate schinese main8_f175b4a5:

    # MC "What kind of fucking scheme has you selling these, in daylight, in a public street?"
    MC "到底是什么鬼把戏，让你敢在大白天、当街兜售这种东西？"

# game/script.rpyc:9264
translate schinese main8_085c0e21:

    # MC "You think I'm gonna pay a thousand embers for a sex toy?"
    MC "你觉得我会花一千“余烬”去买个情趣玩具？"

# game/script.rpyc:9265
translate schinese main8_b4a54f89:

    # shad "But the crystals..."
    shad "可是那些晶体……"

# game/script.rpyc:9266
translate schinese main8_12d1bfcb:

    # MC "Could've been sold separately."
    MC "本来是可以单独出售的。"

# game/script.rpyc:9267
translate schinese main8_f7aa84e9:

    # MC "I don't know what kind of pervert you took me for, but I'm not one of your typical marks, am I?"
    MC "不知道你把我当成了什么变态，但我可不是那种任人宰割的肥羊，对吧？"

# game/script.rpyc:9268
translate schinese main8_d424a0cd:

    # MC "How about you sell me the crystals, and I'll take the plug free of charge?"
    MC "不如这样：你把晶体卖给我，那个塞子就当赠品送我了？"

# game/script.rpyc:9269
translate schinese main8_ead8b2e1:

    # shad "Sir, you're starting to intimidate me..."
    shad "先生，你这架势有点吓人啊……"

# game/script.rpyc:9270
translate schinese main8_930fb1e7:

    # MC "Oh? I thought I was being friendly. Because to me it looks like I'm the only one of us making {i}reasonable{/i} requests."
    MC "哦？我还以为自己表现得很友善呢。毕竟在我看来，咱们俩之中只有我提出的要求才算“{i}合理{/i}”。"

# game/script.rpyc:9271
translate schinese main8_1675282a:

    # MC "How much is your business worth, really?"
    MC "你的这桩生意到底值多少钱？"

# game/script.rpyc:9272
translate schinese main8_88c7da84:

    # MC "The plug's value."
    MC "这枚塞子的价值。"

# game/script.rpyc:9273
translate schinese main8_4cf22763:

    # MC "A number."
    MC "报个数。"

# game/script.rpyc:9277
translate schinese main8_6acc6bb7:

    # MC "Now."
    MC "现在。"

# game/script.rpyc:9278
translate schinese main8_74b68085:

    # shad "..."
    shad "……"

# game/script.rpyc:9279
translate schinese main8_61144985:

    # shad "It's... worth... three... three-hundred..."
    shad "它……值……三……三百……"

# game/script.rpyc:9280
translate schinese main8_2d204a49:

    # MC "..."
    MC "……"

# game/script.rpyc:9290
translate schinese m8choice1_1_83026754:

    # shad "*Tsk*"
    shad "*啧*"

# game/script.rpyc:9291
translate schinese m8choice1_1_707f9841:

    # MC "Pleasure doing business with you, jackass."
    MC "跟你做生意真“愉快”啊，混蛋。"

# game/script.rpyc:9295
translate schinese m8choice1_1_6badbfaa:

    # MCt "I can't believe I bought this stupid thing in front of so many strangers."
    MCt "真不敢相信，我竟然当着这么多陌生人的面买下了这破玩意儿。"

# game/script.rpyc:9296
translate schinese m8choice1_1_4e5f7a89:

    # MCt "Woah, I thought it was gonna be more shallow than that... The gem looks nice. I'll be sure to give it to Miya."
    MCt "哇，我还以为这东西会更敷衍呢……这宝石看起来真不错。我一定要把它送给米娅。"

# game/script.rpyc:9308
translate schinese m8choice1_1_5ba14e60:

    # MCt "There we go."
    MCt "这就对了。"

# game/script.rpyc:9341
translate schinese m8choice1_2_1bf0c042:

    # MC "Isn't that nice? You've learned to tell the truth."
    MC "这多好啊？你学会说实话了。"

# game/script.rpyc:9342
translate schinese m8choice1_2_3db37c6e:

    # MC "Now why don't you run along and tell your future customers about it?"
    MC "现在，何不去找你未来的顾客说说这事呢？"

# game/script.rpyc:9343
translate schinese m8choice1_2_83026754:

    # shad "*Tsk*"
    shad "*啧*"

# game/script.rpyc:9366
translate schinese m8afterchoice1_26f22390:

    # n "Oww!!" with vpunch
    n "哎哟！！" with vpunch

# game/script.rpyc:9370
translate schinese m8afterchoice1_e34c2859:

    # n "Jeez, there's really no sneaking up on you, is there?"
    n "天哪，想悄悄靠近你还真是不容易啊。"

# game/script.rpyc:9371
translate schinese m8afterchoice1_10e019a7:

    # MC "Blame Grace. A lesser man couldn't have survived her repeated ambushes."
    MC "这得怪格蕾丝。要是换个一般人，可扛不住她那一轮又一轮的突袭。"

# game/script.rpyc:9375
translate schinese m8afterchoice1_ba091281:

    # MC "Such a large city, and we find ourselves at the same place at the same time."
    MC "这么大的一座城市，我们竟然在同一时间出现在了同一个地方。"

# game/script.rpyc:9376
translate schinese m8afterchoice1_4775d49f:

    # n "Funny isn't it? Do you believe in fate?"
    n "真有意思，不是吗？你相信命运吗？"

# game/script.rpyc:9377
translate schinese m8afterchoice1_b30158d8:

    # MC "In a mysticism way or a Laplace's Demon kind of way?"
    MC "是指神秘主义那种，还是“拉普拉斯妖”那种？"

# game/script.rpyc:9378
translate schinese m8afterchoice1_e0d9c6a0:

    # n "What's a Laplace? I'm talking about, like fortune tellers and stuff."
    n "拉普拉斯是什么？我是说那种算命之类的东西。"

# game/script.rpyc:9379
translate schinese m8afterchoice1_bbb53c88:

    # MC "Then no, I don't believe in any of that."
    MC "那好吧，我不信那一套。"

# game/script.rpyc:9383
translate schinese m8afterchoice1_47f4827a:

    # n "Then maybe you should, wouldn't it be cool to find out that you're the chosen one?"
    n "也许你应该信信看；要是发现自己是“天选之人”，那多酷啊？"

# game/script.rpyc:9384
translate schinese m8afterchoice1_035bc48b:

    # MC "And what exactly do you supposed I've been chosen for?"
    MC "那你觉得我被选中是要做什么呢？"

# game/script.rpyc:9388
translate schinese m8afterchoice1_3c4b12bc:

    # n "Escorting me home."
    n "送我回家。"

# game/script.rpyc:9389
translate schinese m8afterchoice1_0dba3ecd:

    # n "You {i}are{/i} going home, aren't you?"
    n "你{i}是{/i}要回家吧？"

# game/script.rpyc:9390
translate schinese m8afterchoice1_3b6acd6c:

    # MC "I go wherever the wind takes me."
    MC "风带我去哪儿，我就去哪儿。"

# game/script.rpyc:9391
translate schinese m8afterchoice1_bb2cf764:

    # n "..."
    n "……"

# game/script.rpyc:9392
translate schinese m8afterchoice1_6ad6aa76:

    # MC "The wind is going home..."
    MC "风正往家吹呢……"

# game/script.rpyc:9396
translate schinese m8afterchoice1_ca1f2cd1:

    # n "C'mon! Let's go."
    n "来吧！我们走。"

# game/script.rpyc:9428
translate schinese m8afterchoice1_23db6781:

    # n "[name], let me handle this."
    n "[name]，这事儿交给我来处理。"

# game/script.rpyc:9432
translate schinese m8afterchoice1_5b98de46:

    # "{i}{u}Child" "I like your pretty earrings, miss. Did they hurt?"
    "{i}{u}孩子" "I l小姐，我喜欢你漂亮的耳环。打耳洞疼吗？

# game/script.rpyc:9440
translate schinese m8afterchoice1_e2b2fe6b:

    # n "These? Only a little."
    n "这个吗？只有一点点疼。"

# game/script.rpyc:9444
translate schinese m8afterchoice1_4179bdc9:

    # n "It's like a small pinch."
    n "就像被轻轻捏了一下。"

# game/script.rpyc:9447
translate schinese m8afterchoice1_c49fbda2:

    # "{i}{u}Child" "I want to get them but I'm scared."
    "{i}{u}孩子" "I w我也想打，但我有点害怕。

# game/script.rpyc:9448
translate schinese m8afterchoice1_154ef7aa:

    # n "I was scared too. But then I thought \"If everyone else can do this, why can't I?\""
    n "我当时也害怕。但后来我想：“既然别人都能做到，我为什么不能呢？”"

# game/script.rpyc:9449
translate schinese m8afterchoice1_521e19b0:

    # n "Don't worry about the pain, you learn through life that a little bit of pain isn't worth panicking about."
    n "别担心疼痛，你会慢慢明白，这点小痛根本不值得大惊小怪。"

# game/script.rpyc:9450
translate schinese m8afterchoice1_33689f08:

    # n "Piercings,"
    n "打耳洞，"

# game/script.rpyc:9451
translate schinese m8afterchoice1_36a6824e:

    # n "Piercings, tattoos,"
    n "打耳洞、纹身，"

# game/script.rpyc:9455
translate schinese m8afterchoice1_40beb5ad:

    # n "Piercings, tattoos, dentistry."
    n "打耳洞、纹身、看牙医。"

# game/script.rpyc:9459
translate schinese m8afterchoice1_2d8b1012:

    # n "You need to be brave."
    n "你需要勇敢一点。"

# game/script.rpyc:9460
translate schinese m8afterchoice1_da5879a7:

    # n "Do you want earrings?"
    n "你想要耳环吗？"

# game/script.rpyc:9461
translate schinese m8afterchoice1_e67aa251:

    # "{i}{u}Child" "Mmhm."
    "{i}{u}孩子" "Mmh嗯。

# game/script.rpyc:9462
translate schinese m8afterchoice1_589885d8:

    # n "Do you {i}really{/i} want earrings?"
    n "你{i}真的{/i}想要耳环吗？"

# game/script.rpyc:9463
translate schinese m8afterchoice1_e67aa251_1:

    # "{i}{u}Child" "Mmhm."
    "{i}{u}孩子" "Mmh嗯。

# game/script.rpyc:9464
translate schinese m8afterchoice1_55689fb3:

    # n "Then the only way to get them is by smiling through a little sting."
    n "那唯一的办法就是忍过那一丁点儿刺痛，笑着面对。"

# game/script.rpyc:9465
translate schinese m8afterchoice1_da8d9ec4:

    # n "When I got my ears pierced, it hurt a lot for a few minutes."
    n "我穿耳洞的时候，疼了好几分钟呢。"

# game/script.rpyc:9466
translate schinese m8afterchoice1_be8a506c:

    # n "That was nine years ago. What's a few minutes of pain compared to the years of having the earrings I wanted?"
    n "那可是九年前的事了。跟戴上心仪耳环后的漫长岁月相比，那几分钟的疼痛又算得了什么呢？"

# game/script.rpyc:9467
translate schinese m8afterchoice1_82845c49:

    # n "Ten, twenty, fifty years from now, my ears will still be pierced. All thanks to me being a brave little girl."
    n "十年、二十年、五十年后，我的耳洞依然会在。这全都要归功于我当时是个勇敢的小女孩。"

# game/script.rpyc:9471
translate schinese m8afterchoice1_7580bdf4:

    # "{i}{u}Child" "Wow! You're really cool!"
    "{i}{u}孩子" "Wow哇！你真酷！

# game/script.rpyc:9472
translate schinese m8afterchoice1_30fab3f9:

    # n "Why don't {i}you{/i} be cool as well?"
    n "那你怎么不也{i}酷一点{/i}呢？"

# game/script.rpyc:9473
translate schinese m8afterchoice1_156b0a57:

    # "{i}{u}Child" "Yeah! I'll go tell daddy I want to do it!"
    "{i}{u}孩子" "Yea好啊！我现在就去告诉爸爸，我也想穿耳洞！

# game/script.rpyc:9474
translate schinese m8afterchoice1_d1e4f7e8:

    # n "That's right! And even if it hurts, you know it's over!"
    n "没错！而且就算会痛，你也知道一切都结束了！"

# game/script.rpyc:9475
translate schinese m8afterchoice1_a869887f:

    # "{i}{u}Child" "What's your name?"
    "{i}{u}孩子" "Wha你叫什么名字？

# game/script.rpyc:9476
translate schinese m8afterchoice1_79bbc69f:

    # n "Aww, my name's Noelle, do you plan on remembering me?"
    n "噢，我叫诺艾尔，你打算记住我吗？"

# game/script.rpyc:9477
translate schinese m8afterchoice1_66e41f35:

    # "{i}{u}Child" "Yep! I'll remember you when I pick my earrings!"
    "{i}{u}孩子" "Yep嗯！我挑耳环的时候会想起你的！

# game/script.rpyc:9481
translate schinese m8afterchoice1_91ecf090:

    # "{i}{u}Child" "Your boyfriend is really scary."
    "{i}{u}孩子" "You你的男朋友真的很吓人。

# game/script.rpyc:9485
translate schinese m8afterchoice1_0cfd9a34:

    # n "Mmm. He is isn't he? He's a real sweetheart when no-one's looking."
    n "嗯……是啊。不过没人的时候，他可是个大甜心呢。"

# game/script.rpyc:9489
translate schinese m8afterchoice1_7ef786a0:

    # "{i}{u}Child" "Bye-bye, Noelle!"
    "{i}{u}孩子" "Bye再见，诺艾尔！

# game/script.rpyc:9493
translate schinese m8afterchoice1_794d1d6d:

    # n "Bye-bye!"
    n "再见！"

# game/script.rpyc:9498
translate schinese m8afterchoice1_2338a53c:

    # n "Why do you hate children so much?"
    n "你为什么这么讨厌小孩？"

# game/script.rpyc:9504
translate schinese m8afterchoice1_7594dfee:

    # MC "They know what they did."
    MC "他们自己心里清楚做了什么。"

# game/script.rpyc:9505
translate schinese m8afterchoice1_0f692be9:

    # n "Eh, whatever. People always say you change your mind when you get older."
    n "哎，算了。人们总说人长大了想法就会变。"

# game/script.rpyc:9506
translate schinese m8afterchoice1_f99e2e42:

    # n "Let's go."
    n "走吧。"

# game/script.rpyc:9507
translate schinese m8afterchoice1_c906905f:

    # MC "Since when was I your boyfriend?"
    MC "我什么时候成你男朋友了？"

# game/script.rpyc:9511
translate schinese m8afterchoice1_bf9e2ac4:

    # n "Since that little girl assumed so until about..."
    n "从那个小女孩误以为是的那一刻起，一直到……"

# game/script.rpyc:9517
translate schinese m8afterchoice1_5694989b:

    # n "Now."
    n "现在。"

# game/script.rpyc:9518
translate schinese m8afterchoice1_540d05b5:

    # n "Congratulations, how did it feel having the honor of being my boyfriend?"
    n "恭喜啊，有幸当了我一回男朋友，感觉如何？"

# game/script.rpyc:9519
translate schinese m8afterchoice1_a5417708:

    # MC "Fleeting."
    MC "转瞬即逝。"

# game/script.rpyc:9520
translate schinese m8afterchoice1_522c6ee3:

    # n "Well that really {i}is{/i} a shame, isn't it?"
    n "那还真是{i}太{/i}遗憾了，不是吗？"

# game/script.rpyc:9528
translate schinese m8afterchoice1_b7ed867c:

    # n "What are you standing around for? Let's get out of here."
    n "还愣着干嘛？我们走吧。"

# game/script.rpyc:9602
translate schinese m8choice2_1_16d17cad:

    # n "Lesbian!"
    n "女同性恋！"

# game/script.rpyc:9603
translate schinese m8choice2_1_95e59f81:

    # MC "What?!"
    MC "什么？！"

# game/script.rpyc:9608
translate schinese m8choice2_1_8ad8dae7:

    # n "I said \"Let's be on our way\". Quit spacing out."
    n "我说“我们走吧”。别发呆了。"

# game/script.rpyc:9616
translate schinese m8afterchoice2_c1e6e443:

    # MC "What were you doing in town?"
    MC "你在城里做什么？"

# game/script.rpyc:9617
translate schinese m8afterchoice2_e0362efa:

    # n "Coffee and shopping. Though the shopping ended up only being window shopping."
    n "喝咖啡、逛街。不过最后只是光看不买。"

# game/script.rpyc:9618
translate schinese m8afterchoice2_ac94de8d:

    # MC "I see."
    MC "我明白了。"

# game/script.rpyc:9623
translate schinese m8afterchoice2_7db3da66:

    # "{i}{u}Dudes" "*Talking about dude stuff like lifting weights, surfing, how many dinosaurs they could take on in a fight. All while loudly saying stuff like \"Bro!\" and \"Dude!\" in a harmless albeit boisterous manner.*"
    "{i}{u}哥们儿" "*T*聊些“哥们儿”话题，比如举重、冲浪，或者能赤手空拳打赢几只恐龙。同时大声喊着“兄弟！”和“哥们儿！”——虽然吵闹，但并无恶意。*

# game/script.rpyc:9632
translate schinese m8afterchoice2_060290e3:

    # n "Did you do some wizard training?"
    n "你进行巫师训练了吗？"

# game/script.rpyc:9633
translate schinese m8afterchoice2_79b82fce:

    # MC "Something like that."
    MC "算是吧。"

# game/script.rpyc:9634
translate schinese m8afterchoice2_fc4b9b75:

    # n "What did you say his name was again?"
    n "你刚才说他叫什么名字来着？"

# game/script.rpyc:9635
translate schinese m8afterchoice2_484937b5:

    # MC "Ron."
    MC "罗纳德。"

# game/script.rpyc:9636
translate schinese m8afterchoice2_43cf98c9:

    # n "Ron smells nice. Almost like a girl."
    n "罗纳德身上有股好闻的味道。简直像女孩子一样。"

# game/script.rpyc:9637
translate schinese m8afterchoice2_e71c5270:

    # MC "Can you and Miya {i}not{/i} do that, please?"
    MC "能不能请你和米娅{i}别{/i}那样做？"

# game/script.rpyc:9638
translate schinese m8afterchoice2_604c0776:

    # MC "Yes, there's a girl there and yes, she smells nice."
    MC "没错，那里确实有个女孩，而且她身上有股好闻的气味。"

# game/script.rpyc:9639
translate schinese m8afterchoice2_5a3d3556:

    # MC "Ron was busy and she taught me today. She's pretty confident in magic, though they both told me her affinity is exactly average."
    MC "罗纳德当时很忙，所以今天是由她来教我。她在魔法方面相当自信，尽管他们俩都跟我说过，她的魔法亲和力其实只是普普通通的平均水平。"

# game/script.rpyc:9640
translate schinese m8afterchoice2_2ccfb758:

    # n "Did she teach you anything cool?"
    n "她教了你什么厉害的招数吗？"

# game/script.rpyc:9641
translate schinese m8afterchoice2_7dd841f4:

    # MC "A bunch of stuff, we did a lot of stuff from each school, a lot of it meta, we were playing around with forces and elements."
    MC "教了不少东西。我们尝试了各个魔法流派的许多内容，其中很多都涉及魔法本质的运用，我们还试着操控了各种力量与元素。"

# game/script.rpyc:9642
translate schinese m8afterchoice2_ba50b2f8:

    # n "Did you learn any psycho magic?"
    n "你学了精神系魔法吗？"

# game/script.rpyc:9643
translate schinese m8afterchoice2_4dd0ecb7:

    # MC "I learned how to do the calming spell."
    MC "我学会了怎么施展镇静咒。"

# game/script.rpyc:9647
translate schinese m8afterchoice2_b7198cb4:

    # n "Oooh! Show me! Show me!"
    n "噢！快给我展示一下！展示给我看！"

# game/script.rpyc:9648
translate schinese m8afterchoice2_652c36ea:

    # MC "You sure?"
    MC "你确定？"

# game/script.rpyc:9649
translate schinese m8afterchoice2_635d72fa:

    # n "Yeah, do it."
    n "嗯，来吧。"

# game/script.rpyc:9650
translate schinese m8afterchoice2_615eedc7:

    # MC "Okay."
    MC "好吧。"

# game/script.rpyc:9655
translate schinese m8afterchoice2_f333ee3e:

    # MC "You can actually do it at a range which I think is pretty sweet."
    MC "而且你甚至可以在一定距离外操作，我觉得这挺酷的。"

# game/script.rpyc:9656
translate schinese m8afterchoice2_77f7f63a:

    # n "Make me feel all fluffy, okay?"
    n "让我感觉暖暖的、软软的，好吗？"

# game/script.rpyc:9657
translate schinese m8afterchoice2_8f37e50b:

    # MC "I'm pretty sure I actually have zero control over exactly how it makes you feel but..."
    MC "我敢肯定，对于它具体会让你有什么感觉，我其实完全无法控制，不过……"

# game/script.rpyc:9662
translate schinese m8afterchoice2_5d2c1781:

    # MC "One fluffy experience coming right up."
    MC "这就给你来个暖心体验。"

# game/script.rpyc:9707
translate schinese m8afterchoice2_fe65659e:

    # n "Put me back!" with vpunch
    n "把我放回去！" with vpunch

# game/script.rpyc:9714
translate schinese m8afterchoice2_f8aeda04:

    # n "And they draw a card {i}every{/i} time you special summon? Why don't you just stop special summoning?"
    n "而且你{i}每次{/i}进行特殊召唤，他们都要抽一张牌？你干嘛不干脆别再特殊召唤了？"

# game/script.rpyc:9715
translate schinese m8afterchoice2_aa350f73:

    # MC "Noelle, you don't understand, if I stop special summoning I might as well just skip my turn. No one card should put you in that situation."
    MC "诺艾尔，你不明白，如果我停止特殊召唤，那还不如直接跳过回合呢。不该有一张牌能让人陷入这种境地。"

# game/script.rpyc:9746
translate schinese m8afterchoice2_3f537fce:

    # n "Holy shit, [name]! What was that?!"
    n "天哪，[name]！那是什么？！"

# game/script.rpyc:9747
