    # c "Saying that just to distract me."
    c "你这么说只是为了转移我的注意力。"

# game/script.rpyc:5995
translate schinese m5choice2_3_4774cb0b:

    # MC "Well... I wasn't lying..."
    MC "嗯……我可没撒谎……"

# game/script.rpyc:5996
translate schinese m5choice2_3_d19f855d_2:

    # c "..."
    c "……"

# game/script.rpyc:6006
translate schinese m5choice2_4_75bcd5b3:

