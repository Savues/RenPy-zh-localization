    ron "斯特拉！"

# game/script.rpyc:6099
translate schinese main6_4210972f:

    # MCt "Woah..."
    MCt "哇……"

# game/script.rpyc:6103
translate schinese main6_34cfcb28:

    # s "You must be Master [name]?"
    s "您就是主人[name]吧？"

# game/script.rpyc:6107
translate schinese main6_3e1b4606:

    # MC "Uh... Hey... Ron."
    MC "呃……嗨……罗纳德。"

# game/script.rpyc:6111
translate schinese main6_567c8a43:

    # MC "You look different in natural light..."
    MC "在自然光下，你看起来不太一样……"

# game/script.rpyc:6115
translate schinese main6_cd090ab3:

    # ron "I much prefer being referred to as \"Dr. Bashford\"."
    ron "我更喜欢别人称呼我为“巴什福德博士”。"

# game/script.rpyc:6119
translate schinese main6_6f53899b:

    # ron "Or at least don't shorten my name to \"Ron\"."
    ron "至少，别把我的名字缩成“罗纳德”。"

# game/script.rpyc:6120
translate schinese main6_27dcf6db:

    # MC "Sure thing, R-dog."
    MC "没问题，R-dog。"

# game/script.rpyc:6128
translate schinese main6_e5292ff4:

    # ron "Could you and Stella get your introductions done with? I have some work to finish."
    ron "你和斯特拉能先完成介绍吗？我还有些工作要做。"

# game/script.rpyc:6129
translate schinese main6_45a213ce:

    # ron "It shouldn't be long at all."
    ron "应该很快就好。"

# game/script.rpyc:6142
translate schinese main6_f4420c57:

    # MCt "What's with this cute young maid?"
    MCt "这个可爱的年轻女仆是怎么回事？"

# game/script.rpyc:6143
translate schinese main6_da879e19:

    # MCt "She isn't just a cleaner is she?"
    MCt "她不只是个打扫卫生的吧？"

# game/script.rpyc:6144
translate schinese main6_6273e048:

    # MCt "Why would he want me to introduce myself to her?"
    MCt "他为什么要让我向她做自我介绍？"

# game/script.rpyc:6148
translate schinese main6_91ebd3f8:

    # MCt "Maybe she's a live-in maid. If I'll be coming here often then it's only natural I'll be seeing her."
    MCt "也许她是住家女仆。既然我要经常来这里，那自然会见到她。"

# game/script.rpyc:6149
translate schinese main6_686bd28a:

    # MCt "..."
    MCt "……"

# game/script.rpyc:6150
translate schinese main6_fbbc067e:

    # MCt "She {i}is{/i} pretty cute..."
    MCt "她{i}确实{/i}挺可爱的……"

# game/script.rpyc:6151
translate schinese main6_e0d00c40:

    # MCt "Maybe I should..."
    MCt "也许我应该……"

# game/script.rpyc:6154
translate schinese m6choice1_1_238eb92f:

    # MCt "Probably best to not intimidate her or make an ass out of myself."
    MCt "最好别吓着她，也别让自己出洋相。"

# game/script.rpyc:6155
translate schinese m6choice1_1_e41c6f12:

    # MCt "I'll just do it normally."
    MCt "我就正常一点吧。"

# game/script.rpyc:6159
translate schinese m6choice1_2_aa5510b3:

    # MCt "Oh, yeah!"
    MCt "对了！"

# game/script.rpyc:6180
translate schinese m6afterchoice1_0a768fc7:

    # s "It's a pleasure to meet you, master [name]."
    s "很高兴见到您，主人[name]。"

# game/script.rpyc:6181
translate schinese m6afterchoice1_824cd262:

    # s "My name is Stella."
    s "叫斯特拉。"

# game/script.rpyc:6183
translate schinese m6afterchoice1_74290205:

    # s "I have been Ronald's slave for the past thirteen years."
    s "过去十三年里，我一直是罗纳德的奴隶。"

# game/script.rpyc:6184
translate schinese m6afterchoice1_5f865bb6:

    # MCt "Slave?"
    MCt "奴隶？"

# game/script.rpyc:6185
translate schinese m6afterchoice1_08a94efe:

    # s "I was educated by Ronald and my magnetic affinity is forty-centimeters."
    s "受过罗纳德的教导，我的磁力亲和力是四十厘米。"

# game/script.rpyc:6186
translate schinese m6afterchoice1_11f66ae3:

    # s "Perfectly average."
    s "完全处于平均水平。"

# game/script.rpyc:6191
translate schinese m6afterchoice1_2d204a49:

    # MC "..."
    MC "……"

# game/script.rpyc:6195
translate schinese m6afterchoice1_27040b36:

    # MC "I'm [name]."
    MC "是[name]。"

# game/script.rpyc:6200
translate schinese m6afterchoice1_bd1c4cd0:

    # MC "You used my name when you answered the door."
    MC "你开门的时候叫出了我的名字。"

# game/script.rpyc:6201
translate schinese m6afterchoice1_efac066a:

    # MC "I assume you were told about me beforehand?"
    MC "我想你是提前得知了关于我的事吧？"

# game/script.rpyc:6205
translate schinese m6afterchoice1_401cfa70:

    # s "Yes, Ronald had explained your arrangement."
    s "是的，罗纳德已经说明了您的安排。"

# game/script.rpyc:6209
translate schinese m6afterchoice1_43de026e:

    # s "He also mentioned {i}how{/i} you met."
    s "他还提到了你们是{i}怎么{/i}相遇的。"

# game/script.rpyc:6214
translate schinese m6afterchoice1_36743396:

    # s "You were heroically chasing a thief."
    s "当时您正英勇地追赶一名小偷。"

# game/script.rpyc:6218
translate schinese m6afterchoice1_42e152d3:

    # ron "I don't remember saying \"heroically\"."
    ron "我不记得自己说过“英勇”这个词。"

# game/script.rpyc:6219
translate schinese m6afterchoice1_6b21661b:

    # s "You made him sound very brave."
    s "您把他描述得非常勇敢。"

# game/script.rpyc:6222
translate schinese m6afterchoice1_ec173bee:

    # ron "It's time to get started, [name]. Let's sit."
    ron "该开始了，[name]。我们坐下谈吧。"

# game/script.rpyc:6227
translate schinese m6afterchoice1_99c609e2:

    # s "I heard you were robbed... I'm very sorry to hear that."
    s "听说你遭到了抢劫……听到这个消息我很遗憾。"

# game/script.rpyc:6228
translate schinese m6afterchoice1_13a59b78:

    # MC "Ah... yeah... well..."
    MC "啊……是啊……那个……"

# game/script.rpyc:6233
translate schinese m6afterchoice1_0e858cbc:

    # ron "I have something to discuss about that."
    ron "关于那件事，我有些话想跟你谈谈。"

# game/script.rpyc:6234
translate schinese m6afterchoice1_64e8e265:

    # ron "Take a seat."
    ron "请坐。"

# game/script.rpyc:6238
translate schinese m6afterchoice1_bc36abd5:

    # s "Call for me if you need something."
    s "有什么需要就叫我。"

# game/script.rpyc:6244
translate schinese m6afterchoice1_6a8d031b:

    # MC "You said you had something to discuss about the thief?"
    MC "你说过有关于那个小偷的事要谈？"

# game/script.rpyc:6248
translate schinese m6afterchoice1_ece563a1:

    # ron "Not about the thief."
    ron "不是关于小偷的事。"

# game/script.rpyc:6249
translate schinese m6afterchoice1_dce3086c:

    # ron "Could you put your hand out for a moment?"
    ron "能把手伸出来一下吗？"

# game/script.rpyc:6250
translate schinese m6afterchoice1_84ea767b:

    # MC "Umm..."
    MC "呃……"

# game/script.rpyc:6254
translate schinese m6afterchoice1_690b7417:

    # MC "Sure."
    MC "当然。"

# game/script.rpyc:6258
translate schinese m6afterchoice1_be86f2e8:

    # ron "How much did you say was taken from you?"
    ron "你刚才说被抢走了多少钱？"

# game/script.rpyc:6259
translate schinese m6afterchoice1_f9cec079:

    # MC "It was [stolenmoney] Embers."
    MC "是[stolenmoney]余烬。"

# game/script.rpyc:6260
translate schinese m6afterchoice1_12976a48:

    # ron "Well. It's not quite [stolenmoney]."
    ron "嗯，虽然数额不完全是[stolenmoney]……"

# game/script.rpyc:6265
translate schinese m6afterchoice1_3e89ee96:

    # ron "But it'll help you out."
    ron "但这应该能帮到你。"

# game/script.rpyc:6269
translate schinese m6afterchoice1_a905c425:

    # MC "Wait! Wait! Wait!"
    MC "等等！等等！等等！"

# game/script.rpyc:6270
translate schinese m6afterchoice1_f8a29987:

    # MC "You're not just giving me some of your money are you?!"
    MC "你该不会是想把你的“余烬”分给我吧？！"

# game/script.rpyc:6271
translate schinese m6afterchoice1_5dfad55c:

    # MC "I can't just let you do that."
    MC "我不能让你这么做。"

# game/script.rpyc:6275
translate schinese m6afterchoice1_dbb7de0b:

    # ron "I don't see why you should refuse the offer."
    ron "我不明白你为什么要拒绝这个提议。"

# game/script.rpyc:6276
translate schinese m6afterchoice1_2ff26a31:

    # MC "Because {i}I{/i} was the one who was robbed!"
    MC "因为被抢的是{i}我{/i}！"

# game/script.rpyc:6277
translate schinese m6afterchoice1_2224b4ad:

    # MC "You shouldn't have to give up your Embers because of that!"
    MC "你不该因此交出你的“余烬”！"

# game/script.rpyc:6278
translate schinese m6afterchoice1_47502a55:

    # ron "I don't have to, I'm choosing to."
    ron "我不是非得这么做，这是我自愿的。"

# game/script.rpyc:6279
translate schinese m6afterchoice1_c4fa2ff8:

    # ron "I have enough Embers to be comfortable with doing this."
    ron "我手头的“余烬”足够充裕，做这件事完全没问题。"

# game/script.rpyc:6280
translate schinese m6afterchoice1_c50adb3a:

    # ron "You don't need to worry about me."
    ron "你不用担心我。"

# game/script.rpyc:6284
translate schinese m6choice2_1_121ef661:

    # MC "Are you sure about this?"
    MC "你确定吗？"

# game/script.rpyc:6288
translate schinese m6choice2_1_bc4bbb12:

    # ron "Do you sense any doubt?"
    ron "你觉得我有半点犹豫吗？"

# game/script.rpyc:6289
translate schinese m6choice2_1_a99f00b8:

    # MC "No."
    MC "不。"

# game/script.rpyc:6290
translate schinese m6choice2_1_16b1ed53:

    # MC "But maybe you're just good at poker."
    MC "也许你只是特别擅长玩扑克牌吧。"

# game/script.rpyc:6303
translate schinese m6choice2_2_a88bac61:

    # MC "I can't let you do that."
    MC "我不能让你这么做。"

# game/script.rpyc:6306
translate schinese m6choice2_2_861d2641:

    # ron "Is that truly what you want?"
    ron "这真的是你想要的吗？"

# game/script.rpyc:6307
translate schinese m6choice2_2_8316238d:

    # MC "Please, the guilt would devour me."
    MC "拜托了，那种内疚感会把我吞噬的。"

# game/script.rpyc:6318
translate schinese m6afterchoice2_769ba2cf:

    # ron "I almost became a victim of that thief once."
    ron "我以前也差点成了那个小偷的受害者。"

# game/script.rpyc:6319
translate schinese m6afterchoice2_f83fcbec:

    # ron "Luckily I turned my head, saw her coming earlier than she expected."
    ron "幸好我当时转头看了一眼，比她预想的更早发现了她的靠近。"

# game/script.rpyc:6320
translate schinese m6afterchoice2_b5589870:

    # ron "Managed to put my Embers away before she could get to them."
    ron "在她得手之前，我及时把“余烬”收了起来。"

# game/script.rpyc:6322
translate schinese m6afterchoice2_ada91fb3:

    # ron "You're lucky she didn't get to you either."
    ron "你也挺幸运的，没让她得逞。"

# game/script.rpyc:6323
translate schinese m6afterchoice2_e391fa68:

    # ron "Otherwise your Embers could be gone for good."
    ron "否则你的“余烬”可能就彻底没了。"

# game/script.rpyc:6325
translate schinese m6afterchoice2_29006928:

    # ron "If only {i}you{/i} could've been so lucky."
    ron "要是{i}你{/i}也能那么幸运就好了。"

# game/script.rpyc:6326
translate schinese m6afterchoice2_cf238b47:

    # ron "You're never going to see those Embers again."
    ron "你再也见不到那些“余烬”了。"

# game/script.rpyc:6330
translate schinese m6afterchoice2_9c328d34:

    # MC "Eh, I mean. Not necessarily, right?"
    MC "呃，我是说……也不一定吧？"

# game/script.rpyc:6331
translate schinese m6afterchoice2_c0c15818:

    # MC "If I'm lucky enough to get near them again..."
    MC "如果我足够幸运，能再次靠近它们的话……"

# game/script.rpyc:6335
translate schinese m6afterchoice2_f2876551:

    # ron "I don't think I understand..."
    ron "我不太明白……"

# game/script.rpyc:6339
translate schinese m6afterchoice2_e2ded602:

    # MC "I'm talking about the tracking spell I put on them."
    MC "我是指我在它们身上施加的追踪咒语。"

# game/script.rpyc:6340
translate schinese m6afterchoice2_35b302d5:

    # ron "What?"
    ron "什么？"

# game/script.rpyc:6344
translate schinese m6afterchoice2_253c0602:

    # MC "Yeah, on my Embers."
    MC "对，就是针对我的那些“余烬”的咒语。"

# game/script.rpyc:6345
translate schinese m6afterchoice2_34ad802b:

    # MC "To be honest, I never expected to lose them, but I thought it'd be safer to do it."
    MC "老实说，我没想过会弄丢它们，但我觉得这么做更保险。"

# game/script.rpyc:6346
translate schinese m6afterchoice2_afe212e5:

    # MC "I tested it at home. I thought that while learning a new spell I could siphon one of the Embers so I don't absorb it."
    MC "我在家里试过。当时我想，在学习新咒语时，或许可以把其中一颗“余烬”的能量引流出来，这样我就不会直接吸收它了。"

# game/script.rpyc:6347
translate schinese m6afterchoice2_8bf84aa9:

    # MC "I tried putting the spell on the Ember and I could feel it like a buzz in the air, drawing me to it."
    MC "我试着把咒语施加在那颗“余烬”上，能感觉到空气中有一种嗡嗡的波动，牵引着我向它靠近。"

# game/script.rpyc:6351
translate schinese m6afterchoice2_3512652a:

    # MC "I don't really have a way of accurately measuring anything at that distance, but I could still feel it on the other side of the house."
    MC "虽然在那么远的距离下，我没法精确测量什么，但即便在屋子的另一头，我依然能感应到它。"

# game/script.rpyc:6352
translate schinese m6afterchoice2_9441eb79:

    # MC "Though I stopped feeling it some time after leaving the house."
    MC "不过，离开屋子一段时间后，那种感应就消失了。"

# game/script.rpyc:6357
translate schinese m6afterchoice2_2d204a49:

    # MC "..."
    MC "……"

# game/script.rpyc:6371
translate schinese m6afterchoice2_47d7bd37:

    # ron "Stella!"
    ron "斯特拉！"

# game/script.rpyc:6375
translate schinese m6afterchoice2_5c3d40b9:

    # s "On it!"
    s "交给我！"

# game/script.rpyc:6379
translate schinese m6afterchoice2_7f02ef1d:

    # MC "Woah, woah! What's going on?!"
    MC "哇，哇！怎么回事？！"

# game/script.rpyc:6383
translate schinese m6afterchoice2_edb66732:

    # ron "Where did you learn that spell?!"
    ron "你在哪儿学的那个咒语？！"

# game/script.rpyc:6384
translate schinese m6afterchoice2_5a6065c1:

    # MC "I didn't learn it anywhere! I just thought I'd try it and it worked!"
    MC "我在哪儿都没学过！我只是想着试一下，居然就成了！"

# game/script.rpyc:6389
translate schinese m6afterchoice2_603034f4:

    # ron "That's not how it happens!"
    ron "事情不该是这样的！"

# game/script.rpyc:6394
translate schinese m6afterchoice2_47d7bd37_1:

    # ron "Stella!"
    ron "斯特拉！"

# game/script.rpyc:6398
translate schinese m6afterchoice2_8136ef8d:

    # s "There's nothing!"
    s "什么都没有！"

# game/script.rpyc:6402
translate schinese m6afterchoice2_0fd4e341:

    # s "I've searched the whole database!"
    s "我把整个数据库都查遍了！"

# game/script.rpyc:6410
translate schinese m6afterchoice2_97eebf6c:

    # ron "[name]..."
    ron "[name]……"

# game/script.rpyc:6414
translate schinese m6afterchoice2_03bee754:

    # ron "That spell..."
    ron "那个咒语……"

# game/script.rpyc:6416
translate schinese m6afterchoice2_c6665e4a:

    # ron "Doesn't exist."
    ron "根本不存在。"

# game/script.rpyc:6433
translate schinese m6afterchoice2_425d04fe:

    # ron "Be honest with me."
    ron "跟我说实话。"

# game/script.rpyc:6437
translate schinese m6afterchoice2_657082a9:

    # ron "Have you been able to use magic your whole life?"
    ron "你这一生都能使用魔法吗？"

# game/script.rpyc:6442
translate schinese m6afterchoice2_7056bc39:

    # MCt "I don't think this is as straightforward as he wants it to be."
    MCt "我觉得这事儿没他想的那么简单。"

# game/script.rpyc:6443
translate schinese m6afterchoice2_98f3d353:

    # MCt "The me that {i}I{/i} know. Couldn't use a damn sliver of magic until recently."
    MCt "我所认知的那个{i}我{/i}……在那之前，连一丝一毫的魔法都施展不出来。"

# game/script.rpyc:6444
translate schinese m6afterchoice2_d7898313:

    # MCt "But the truth is way more complicated than that."
    MCt "真相远比这复杂得多。"

# game/script.rpyc:6445
translate schinese m6afterchoice2_c9c1b7f5:

    # MCt "I {i}could{/i} tell him the truth, but I understand so little about it."
    MCt "我{i}本可以{/i}告诉他真相，但我自己对这一切也知之甚少。"

# game/script.rpyc:6446
translate schinese m6afterchoice2_1bf25102:

    # MCt "It could be careless to make my circumstance public knowledge. I simply don't understand the implications."
    MCt "公开自己的处境或许有些轻率；我根本不清楚这会带来什么后果。"

# game/script.rpyc:6447
translate schinese m6afterchoice2_774292a4:

    # MCt "I could lie, tell him that I'm normal... normal as far as this world is concerned."
    MCt "可以撒谎，告诉他我很正常……至少在这个世界看来是正常的。"

# game/script.rpyc:6448
translate schinese m6afterchoice2_4306163a:

    # MCt "But then I'd need to continuously fabricate excuses. Why don't I have basic knowledge, why I act like a fish out of water."
    MCt "那样我就得不断编造借口，来解释为何我缺乏常识，为何表现得像个格格不入的局外人。"

# game/script.rpyc:6449
translate schinese m6afterchoice2_781ac860:

    # MCt "I could play along with what he expects me to say, but that could lead to discrepancies of my apparent history. Noelle, Grace, the others..."
    MCt "可以顺着他的预期去回答，但这可能会导致我“既往经历”的说法出现前后矛盾。诺艾尔、格蕾丝，还有其他人……"

# game/script.rpyc:6450
translate schinese m6afterchoice2_4444dfd7:

    # MCt "They all know I am capable of using magic, and always have been."
    MCt "他们都知道我会使用魔法，而且一直都会。"

# game/script.rpyc:6451
translate schinese m6afterchoice2_fe922f4f:

    # MCt "The closest thing right now..."
    MCt "目前最贴切的说法是……"

# game/script.rpyc:6456
translate schinese m6afterchoice2_79cfa724:

    # MC "I..."
    MC "我……"

# game/script.rpyc:6457
translate schinese m6afterchoice2_5d12d9c0:

    # MC "I've always been able to use magic..."
    MC "我一直都能使用魔法……"

# game/script.rpyc:6461
translate schinese m6afterchoice2_22e048cc:

    # MC "Just not consciously..."
    MC "只是并非出于自觉……"

# game/script.rpyc:6462
translate schinese m6afterchoice2_07a6b1c9:

    # MC "I would sometimes fire off spells in my sleep, or when I was an infant..."
    MC "有时我在睡梦中，或者还是婴儿的时候，会无意间释放出魔法……"

# game/script.rpyc:6463
translate schinese m6afterchoice2_737029bd:

    # MC "But whenever I purposefully tried to cast a spell, I couldn't."
    MC "但每当我试图刻意施法时，却总是无法成功。"

# game/script.rpyc:6467
translate schinese m6afterchoice2_7ca289c0:

    # MC "Not until a few weeks ago."
    MC "直到几周前。"

# game/script.rpyc:6489
translate schinese m6afterchoice2_5f446515:

    # ron "That is one of the most unusual things I've ever heard."
    ron "这真是我听过的最奇特的事情之一。"

# game/script.rpyc:6490
translate schinese m6afterchoice2_9c27474b:

    # ron "Stella?"
    ron "斯特拉？"

# game/script.rpyc:6494
translate schinese m6afterchoice2_811e68a2:

    # s "How do I say this?.."
    s "该怎么说呢……"

# game/script.rpyc:6495
translate schinese m6afterchoice2_dc733cf5:

    # s "Your magic sounds... broken?"
    s "你的魔法听起来……像是“坏掉了”？"

# game/script.rpyc:6499
translate schinese m6afterchoice2_d3c2f4ee:

    # ron "I've seen you cast spells."
    ron "我见过你施法。"

# game/script.rpyc:6500
translate schinese m6afterchoice2_715fbb11:

    # ron "\"Broken\" is the perfect way to describe it."
    ron "用“坏掉了”来形容再贴切不过了。"

# game/script.rpyc:6501
translate schinese m6afterchoice2_d0e94edf:

    # ron "You {i}do{/i} cast the spell you want to, only that it manifests in extraordinary ways."
    ron "你{i}确实{/i}能施展出想用的咒语，只是呈现出的方式非同寻常。"

# game/script.rpyc:6502
translate schinese m6afterchoice2_1352af2c:

    # ron "Since you uh... gained control. Have you ever tried to cast a spell and the effect was entirely different?"
