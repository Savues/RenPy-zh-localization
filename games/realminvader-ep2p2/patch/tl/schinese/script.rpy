    MC "你把头发梳整齐后，{i}真的{/i}很可爱。"

# game/script.rpyc:5976
translate schinese m5choice2_3_d19f855d_1:

    # c "..."
    c "……"

# game/script.rpyc:5988
translate schinese m5choice2_3_b542c11c:

    # c "Wow. Congratulations."
    c "哇。恭喜。"

