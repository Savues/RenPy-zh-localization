translate schinese main1_bda4992a:

    # MCt "None of that actually happened!"
    MCt "那些事根本没有发生！"

# game/script.rpyc:1311
translate schinese main1_efd289ff:

    # MCt "That scared me for a moment..."
    MCt "刚才确实吓了我一跳……"

# game/script.rpyc:1315
translate schinese main1_9afaf988:

    # MCt "Still..."
    MCt "不过……"

# game/script.rpyc:1316
translate schinese main1_aa2c873c:

    # MCt "My head... I feel drowsy."
    MCt "我的头……感觉好困。"

# game/script.rpyc:1317
translate schinese main1_83b9e240:

    # MCt "Maybe I {i}should{/i} see a doctor... Spontaneous hallucinating isn't a good sign."
    MCt "也许我{i}确实{/i}该去看医生……无缘无故冒出幻觉可不是好兆头。"

# game/script.rpyc:1318
translate schinese main1_525b2e35:

    # MCt "Later... I've gotta go to bed. I feel like ass."
    MCt "算了……我得睡觉了。感觉糟透了。"

# game/script.rpyc:1322
translate schinese main1_c82e87e4:

    # MCt "Anyway... Daytime sleeping isn't {i}that{/i} alien of a-"
    MCt "总之……白天睡觉这个概念也没那么……"

# game/script.rpyc:1328
translate schinese main1_56729142:

    # MCt "...concept..."
    MCt "……概念……"

# game/script.rpyc:1352
translate schinese main1_14a209b9:

    # MCt "Okay, this is too much."
    MCt "好吧，真是够了。"

# game/script.rpyc:1353
translate schinese main1_486a9d61:

    # MCt "Think!"
    MCt "思考！"

# game/script.rpyc:1354
translate schinese main1_a754c246:

    # MCt "Everything is where it should be, I recognize this street, that lamp, those signs."
    MCt "一切都在该在的地方，我认得这条街、那盏灯和那些招牌。"

# game/script.rpyc:1355
translate schinese main1_9533e5e8:

    # MCt "There could be a convention in town... that guy said his boss was a Dark Elf..."
    MCt "镇上可能在办什么集会……那家伙说他的老板是暗夜精灵……"

# game/script.rpyc:1356
translate schinese main1_074920af:

    # MCt "But why would he bring that up if we hadn't talked about it?"
    MCt "可如果我们没聊过这个，他为什么会提起？"

# game/script.rpyc:1357
translate schinese main1_696136eb:

    # MCt "...He..."
    MCt "……他……"

# game/script.rpyc:1362
translate schinese main1_0effba86:

    # MCt "How did he do that? It looked like magic..."
    MCt "他怎么做到的？看起来像是魔法……"

# game/script.rpyc:1363
translate schinese main1_bd7001e0:

    # MCt "And-"
    MCt "而且——"

# game/script.rpyc:1371
translate schinese main1_c96e1b90:

    # MCt "Something has changed..."
    MCt "有什么东西变了……"

# game/script.rpyc:1376
translate schinese main1_45d0ef1c:

    # MC "Nghh!"
    MC "唔！"

# game/script.rpyc:1377
translate schinese main1_fd36d577:

    # MCt "Shit!"
    MCt "操！"

# game/script.rpyc:1378
translate schinese main1_633986c0:

    # MCt "I need..."
    MCt "我需要……"

# game/script.rpyc:1383
translate schinese main1_1a9c5906:

    # MCt "I need to rest before I can figure this out..."
    MCt "我得先休息，才能弄清这件事……"

# game/script.rpyc:1392
translate schinese main1_535397bb:

    # m "Oh, hey, [name]."
    m "哦，嗨，[name]。"

# game/script.rpyc:1393
translate schinese main1_03aeb8fa:

    # m "How's-"
    m "怎——"

# game/script.rpyc:1398
translate schinese main1_d298af51:

    # m "...your..."
    m "……你的……"

# game/script.rpyc:1403
translate schinese main1_010e5d3f:

    # m "...head?{w=1}{nw}"
    m "……脑袋？{w=1}{nw}"

# game/script.rpyc:1450
translate schinese main1_b6f32c26:

    # MCt "I know this place..."
    MCt "我知道这里是哪里……"

# game/script.rpyc:1458
translate schinese main1_e92131fb:

    # MC "No ghosts?"
    MC "没有鬼？"

# game/script.rpyc:1462
translate schinese main1_68c530ec:

    # MC "Hello?!"
    MC "喂？！"

# game/script.rpyc:1466
translate schinese main1_6c9d2511:

    # MC "Shit? Are you scared of round two?"
    MC "怎么？怕第二轮了？"

# game/script.rpyc:1467
translate schinese main1_21305ad8:

    # MC "If this is like last time, you're my ticket out of here."
    MC "如果和上次一样，你就是我离开这里的钥匙。"

# game/script.rpyc:1468
translate schinese main1_4a22a4a6:

    # MC "So just-{w=0.5}{nw}"
    MC "所以——{w=0.5}{nw}"

# game/script.rpyc:1473
translate schinese main1_325333a2:

    # MC "*Gag*"
    MC "*作呕*"

# game/script.rpyc:1478
translate schinese main1_b7071544:

    # MC "Blegh!"
    MC "呕！"

# game/script.rpyc:1485
translate schinese main1_2d204a49_6:

    # MC "..."
    MC "……"

# game/script.rpyc:1496
translate schinese main1_3b0c5697:

    # MC "I'm giving you your... orbs back..."
    MC "我把你……你的光球还给你……"

# game/script.rpyc:1552
translate schinese main1_9f900dd3:

    # MCt "That was six, right?"
    MCt "那是六个，对吧？"

# game/script.rpyc:1553
translate schinese main1_5759d83b:

    # MCt "The same that were shot at me?"
    MCt "就是朝我射过来的那些？"

# game/script.rpyc:1554
translate schinese main1_0f41b1e0:

    # MC "What are these pillars?"
    MC "这些柱子是什么？"

# game/script.rpyc:1555
translate schinese main1_2d204a49_7:

    # MC "..."
    MC "……"

# game/script.rpyc:1556
translate schinese main1_0e73a3f3:

    # MC "Shit, who am I even asking?"
    MC "操，我到底在问谁？"

# game/script.rpyc:1560
translate schinese main1_a830effa:

    # MCt "This arrangement..."
    MCt "这种排列……"

# game/script.rpyc:1561
translate schinese main1_2d204a49_8:

    # MC "..."
    MC "……"

# game/script.rpyc:1562
translate schinese main1_036693e9:

    # MCt "Planetary orbits?"
    MCt "行星轨道？"

# game/script.rpyc:1563
translate schinese main1_14a76af8:

    # MCt "Then where are the rest of them? And why am I the Sun?"
    MCt "那其他的呢？为什么我是太阳？"

# game/script.rpyc:1564
translate schinese main1_a7433764:

    # MCt "Maybe a puzzle? Do I have to align them? Can I even move them?"
    MCt "也许是某种谜题？我得把它们对齐吗？我甚至能动它们吗？"

# game/script.rpyc:1568
translate schinese main1_44cba8aa:

    # MCt "That one's insanely far away..."
    MCt "那根柱子远得离谱……"

# game/script.rpyc:1569
translate schinese main1_fa89efa6:

    # MCt "Last time I got out of here I was right where I left off... like nothing happened."
    MCt "上次我离开这儿的时候，人还在原来的位置……就像什么都没发生过。"

# game/script.rpyc:1573
translate schinese main1_03e561dc:

    # MCt "So I guess there's no harm in experimenting..."
    MCt "所以我想，试验一下也没什么坏处……"

# game/script.rpyc:1577
translate schinese main1_6bf31c25:

    # MCt "Only with my fingertip... Just in case..."
    MCt "只用指尖……以防万一……"

# game/script.rpyc:1616
translate schinese main1_3842f564:

    # MCt "Wha-"
    MCt "什——"

# game/script.rpyc:1617
translate schinese main1_60cd6306:

    # MCt "I swear I just had a crazy dream."
    MCt "我发誓我刚才做了个特别离谱的梦。"

# game/script.rpyc:1618
translate schinese main1_883d6997:

    # MCt "What was it? I can't remember"
    MCt "梦见了什么？我不记得了"

# game/script.rpyc:1619
translate schinese main1_8e49a2c7:

    # MCt "Eh? Something is glowing to my left."
    MCt "嗯？我左边好像有东西在发光。"

# game/script.rpyc:1643
translate schinese main1_bb2cf764:

    # n "..."
    n "……"

# game/script.rpyc:1644
translate schinese main1_89c7563f:

    # MC "Shit! Noelle, are you okay? What's going on?"
    MC "操！诺艾尔，你没事吧？发生什么了？"

# game/script.rpyc:1648
translate schinese main1_95c43bd8:

    # n "I-I'm fine!"
    n "我、我没事！"

# game/script.rpyc:1649
translate schinese main1_b76fc4e2:

    # n "But what about you?"
    n "那你呢？"

# game/script.rpyc:1650
translate schinese main1_32e55179:

    # MC "Me?"
    MC "我？"

# game/script.rpyc:1651
translate schinese main1_44cb4b1f:

    # n "You've been asleep since yesterday. Mom said you looked sick."
    n "你从昨天开始就一直睡着。妈妈说你看起来病恹恹的。"

# game/script.rpyc:1652
translate schinese main1_8782fdf7:

    # MC "Since yesterday? I've been out that long?"
    MC "从昨天？我睡了那么久？"

# game/script.rpyc:1653
translate schinese main1_a2780f43:

    # n "Mmhm."
    n "嗯。"

# game/script.rpyc:1654
translate schinese main1_68ba110b:

    # MC "Is that why you're in here?"
    MC "所以你才来这里？"

# game/script.rpyc:1659
translate schinese main1_ef8238c1:

    # n "I came to check on you. You looked so uncomfortable."
    n "我来看看你。你看起来很不舒服。"

# game/script.rpyc:1664
translate schinese main1_6e9c8cb5:

    # n "Then you started doing your magic thingy."
    n "然后你开始施展你的那个魔法把戏。"

# game/script.rpyc:1665
translate schinese main1_8e31b626:

    # MCt "...\"Magic thingy\"?"
    MCt "……“魔法把戏”？"

# game/script.rpyc:1669
translate schinese main1_d75fa3be:

    # n "I didn't understand what was going on."
    n "我看不懂发生了什么。"

# game/script.rpyc:1673
translate schinese main1_42e85510:

    # n "When I went for a closer look..."
    n "我凑近看的时候……"

# game/script.rpyc:1677
translate schinese main1_5913a8f5:

    # n "You started pulling on my earring."
    n "你开始拉我的耳环。"

# game/script.rpyc:1691
translate schinese main1_9fbdda0a:

    # n "I couldn't get off..."
    n "我根本脱不开……"

# game/script.rpyc:1696
translate schinese main1_b3145f14:

    # n "It really hurt, y'know."
    n "真的很疼，你懂吧。"

# game/script.rpyc:1697
translate schinese main1_36c55fe2:

    # MC "Wait, why didn't you just pull yourself off of me?"
    MC "等等，你为什么不自己挣脱？"

# game/script.rpyc:1698
translate schinese main1_2782d264:

    # MC "Ah!"
    MC "啊！"

# game/script.rpyc:1703
translate schinese main1_a0516fdb:

    # MC "You just wanted to lay with me didn't you?"
    MC "你只是想和我躺在一起，对吧？"

# game/script.rpyc:1707
translate schinese main1_82bb9a08:

    # n "No."
    n "不。"

# game/script.rpyc:1711
translate schinese main1_0b8c0fc3:

    # MC "Aww..."
    MC "啊……"

# game/script.rpyc:1715
translate schinese main1_4cbd21bf:

    # n "Your magic is super strong. Of course I couldn't pull myself off of you."
    n "你的魔法很强。我当然挣不开你。"

# game/script.rpyc:1716
translate schinese main1_e46cb61d:

    # MC "Uh... sorry... I wasn't doing the, uh, {i}magic thingy{/i} on purpose..."
    MC "呃……抱歉……我不是故意施展那个，呃，{i}魔法把戏{/i}的……"

# game/script.rpyc:1720
translate schinese main1_e0781b63:

    # n "*Sigh* I know."
    n "*叹气* 我知道。"

# game/script.rpyc:1724
translate schinese main1_a132ac74:

    # n "Still... It's strange, isn't it?"
    n "不过……还是怪怪的，对吧？"

# game/script.rpyc:1725
translate schinese main1_8397b425:

    # n "Grace said she saw you giving off magic pulses too."
    n "格蕾丝说她也看到你释放魔法脉冲了。"

# game/script.rpyc:1726
translate schinese main1_beb370d2:

    # n "Maybe you had a magic disease."
    n "也许你得了魔法病。"

# game/script.rpyc:1727
translate schinese main1_21d86c4d:

    # n "That would explain why no-one else was affected."
    n "那就能解释为什么没有别人受影响。"

# game/script.rpyc:1728
translate schinese main1_4bec532f:

    # n "How do you feel? Right now?"
    n "你现在感觉怎么样？"

# game/script.rpyc:1729
translate schinese main1_de1baa08:

    # MC "Um... apart from the hunger and sleep inertia... I feel normal."
    MC "呃……除了饥饿和刚醒来的迟钝之外，我很正常。"

# game/script.rpyc:1730
translate schinese main1_0e67d144:

    # MC "Though yesterday, while I was out, I started seeing some weird shit."
    MC "不过昨天我在外面时，开始看到一些奇怪的玩意儿。"

# game/script.rpyc:1731
translate schinese main1_d1911f4c:

    # n "What kind of weird shit?"
    n "什么样的怪东西？"

# game/script.rpyc:1732
translate schinese main1_5f04c33f:

    # MC "Like Elves."
    MC "比如精灵。"

# game/script.rpyc:1736
translate schinese main1_6e815002:

    # n "Elves?"
    n "精灵？"

# game/script.rpyc:1737
translate schinese main1_f34203aa:

    # MC "Yeah."
    MC "对。"

# game/script.rpyc:1738
translate schinese main1_f9bab323:

    # n "[name]..."
    n "[name]……"

# game/script.rpyc:1740
translate schinese main1_4e297ea1:

    # MC "Y-yeah?"
    MC "怎、怎么了？"

# game/script.rpyc:1746
translate schinese main1_8cd30376:

    # n "When did you become racist?!"
    n "你什么时候变成种族主义者了？！"

# game/script.rpyc:1747
translate schinese main1_08f222fa:

    # MC "Woah! Woah! I never became racist!" with vpunch
    MC "哇！哇！我才没有变成种族主义者！" with vpunch

# game/script.rpyc:1748
translate schinese main1_9e762489:

    # MC "It's... I feel fine, but I'm a little confused. Probably from the oversleeping."
    MC "我……感觉没问题，只是有点困惑。可能睡太久了。"

# game/script.rpyc:1753
translate schinese main1_99f38a46:

    # n "That's good. Make sure everyone else gets to see that you're up, yeah?"
    n "那就好。让其他人也都知道你已经起来了，好吗？"

# game/script.rpyc:1754
translate schinese main1_999fba26:

    # MC "Tell them yourself. A man's gotta sleep."
    MC "你不可能独占世界上所有的睡眠！"

# game/script.rpyc:1758
translate schinese main1_456d2200:

    # n "You can't monopolize all of the sleep in the world!"
    n "你不可能把世界上所有睡眠都垄断！"

# game/script.rpyc:1763
translate schinese main1_301f11e2:

    # n "Hey! Are you listening?!"
    n "喂！你在听吗？！"

# game/script.rpyc:1764
translate schinese main1_3a0cae6c:

    # MC "Silence!"
    MC "安静！"

# game/script.rpyc:1768
translate schinese main1_bb2cf764_1:

    # n "..."
    n "……"

# game/script.rpyc:1769
translate schinese main1_f7efa6fe:

    # n "I have to be at work earlier today. So you'll be on your own for a while, okay?"
    n "我今天要早点去上班。所以你会一个人待一会儿，好吗？"

# game/script.rpyc:1770
translate schinese main1_c66f0b5c:

    # MC "On my own? Where's everyone else? Wait, what time is it?"
    MC "一个人？其他人呢？等等，现在几点？"

# game/script.rpyc:1771
translate schinese main1_0d856108:

    # n "Midday. Grace and Chloe are at school. Mom went out to daydream at the park or whatever it is she'll do sometimes."
    n "中午。格蕾丝和克洛伊在学校。妈妈出去在公园发呆，或者做她偶尔会做的事。"

# game/script.rpyc:1772
translate schinese main1_ac94de8d:

    # MC "I see."
    MC "我明白了。"

# game/script.rpyc:1773
translate schinese main1_476a0d48:

    # n "Are you seriously going back to sleep?"
    n "你真的还要回去睡？"

# game/script.rpyc:1774
translate schinese main1_a1915dce:

    # MC "Yep."
    MC "对。"

# game/script.rpyc:1775
translate schinese main1_db63187f:

    # n "Good for you, I guess."
    n "那挺好的，对我来说。"

# game/script.rpyc:1779
translate schinese main1_78da8f17:

    # n "Enjoy."
    n "好好享受。"

# game/script.rpyc:1783
translate schinese main1_513547eb:

    # n "I'll be seeing you."
    n "回头见。"

# game/script.rpyc:1784
translate schinese main1_8d0d4fce:

    # n "And I'm glad that you're okay."
    n "而且我很高兴你没事。"

# game/script.rpyc:1785
translate schinese main1_2d204a49_9:

    # MC "..."
    MC "……"

# game/script.rpyc:1789
translate schinese m1choice1_1_c51717e4:

    # MC "Hey, Noelle?"
    MC "嘿，诺艾尔？"

# game/script.rpyc:1790
translate schinese m1choice1_1_b07a7006:

    # n "What?"
    n "什么？"

# game/script.rpyc:1791
translate schinese m1choice1_1_9fa13721:

    # MC "Don't get angry but..."
    MC "别生气，不过……"

# game/script.rpyc:1792
translate schinese m1choice1_1_866c3e08:

    # MC "Could you make me breakfast? I'm kinda running low on energy over here."
    MC "能给我做点早餐吗？我这边能量快用完了。"

# game/script.rpyc:1793
translate schinese m1choice1_1_e5228de1:

    # n "I'm not going to get angry."
    n "我不会生气的。"

# game/script.rpyc:1794
translate schinese m1choice1_1_7ef3c834:

    # n "I'm just going to say no."
    n "我只会说不。"

# game/script.rpyc:1795
translate schinese m1choice1_1_2d204a49:

    # MC "..."
    MC "……"

# game/script.rpyc:1796
translate schinese m1choice1_1_ac94de8d:

    # MC "I see."
    MC "我明白了。"

# game/script.rpyc:1797
translate schinese m1choice1_1_3242f80a:

    # MC "Never mind. I'll see you later."
    MC "算了，回头见。"

# game/script.rpyc:1798
translate schinese m1choice1_1_a2780f43:

    # n "Mmhm."
    n "嗯。"

# game/script.rpyc:1802
translate schinese m1choice1_2_c859e874:

    # MC "Noelle?"
    MC "诺艾尔？"

# game/script.rpyc:1803
translate schinese m1choice1_2_2dd18f3e:

    # n "What is it?"
    n "什么事？"

# game/script.rpyc:1804
translate schinese m1choice1_2_6f4a2338:

    # MC "Thanks."
    MC "谢谢。"

# game/script.rpyc:1805
translate schinese m1choice1_2_6a56ece7:

    # n "For checking on you?"
    n "谢我来照顾你？"

# game/script.rpyc:1806
translate schinese m1choice1_2_f34203aa:

    # MC "Yeah."
    MC "对。"

# game/script.rpyc:1807
translate schinese m1choice1_2_1e9562ab:

    # n "I wasn't the only one."
    n "不只是你一个。"

# game/script.rpyc:1808
translate schinese m1choice1_2_fce9332e:

    # MC "But I'm glad you {i}were{/i} one of them."
    MC "但我很高兴你{i}也{/i}是其中之一。"

# game/script.rpyc:1809
translate schinese m1choice1_2_ce213075:

    # MC "I couldn't have picked a more pleasant sight to wake up to."
    MC "我醒来时没看到比这更赏心悦目的景象了。"

# game/script.rpyc:1811
translate schinese m1choice1_2_95a0dd0f:

    # n "When did you become such a sweet-talker?"
    n "你什么时候变得这么会说话了？"

# game/script.rpyc:1812
translate schinese m1choice1_2_b5bcabcf:

    # MC "Must be a side effect of the illness."
    MC "大概是病的副作用。"

# game/script.rpyc:1813
translate schinese m1choice1_2_368477ea:

    # n "Hmm... Well, thank you, [name]. Your kind words {i}almost{/i} make up for all the nursing I did."
    n "嗯……谢谢你，[name]。你的好话{i}几乎{/i}弥补了我这些天的照顾。"

# game/script.rpyc:1814
translate schinese m1choice1_2_a6190c5d:

    # MC "Woah, you breastfed me while I was asleep?"
    MC "哇，你在我睡着时给我喂奶了？"

# game/script.rpyc:1818
translate schinese m1choice1_2_32db3a41:

    # n "I did nothing of the sort!"
    n "我才没做那种事！"

# game/script.rpyc:1819
translate schinese m1choice1_2_95b86dfd:

    # n "You know what I meant by \"nursing\"."
    n "你知道我说“照顾”是什么意思。"

# game/script.rpyc:1820
translate schinese m1choice1_2_0eb2cc7b:

    # MC "Yes, but then I couldn't have teased you."
    MC "对，但这样我就没法逗你了。"

# game/script.rpyc:1821
translate schinese m1choice1_2_bb2cf764:

    # n "..."
    n "……"

# game/script.rpyc:1822
translate schinese m1choice1_2_bdfb1b3d:

    # MC "Seriously, Noelle. Thanks."
    MC "说真的，诺艾尔，谢谢。"

# game/script.rpyc:1823
translate schinese m1choice1_2_bb2cf764_1:

    # n "..."
    n "……"

# game/script.rpyc:1837
translate schinese m1afterchoice1_e82f1831:

    # MCt "This is way too elaborate to be a prank."
    MCt "这也太复杂了，不可能是恶作剧。"

# game/script.rpyc:1838
translate schinese m1afterchoice1_55a136a1:

    # MCt "That illness... the explosion, the Elves, the magic, Noelle's reactions..."
    MCt "这种病……爆炸、精灵、魔法、诺艾尔的反应……"

# game/script.rpyc:1839
translate schinese m1afterchoice1_d72fb142:

    # MCt "Something has definitely changed..."
    MCt "肯定有什么东西变了……"

# game/script.rpyc:1840
translate schinese m1afterchoice1_d44ceefc:

    # MCt "It's almost like I'm in a different world. One that mimics mine."
    MCt "简直像是我身处另一个世界，一个模仿我所在世界的世界。"

# game/script.rpyc:1841
translate schinese m1afterchoice1_5d9988bb:

    # MCt "If only there was an easy way to get some answers..."
    MCt "要是能轻松找到答案就好了……"

# game/script.rpyc:1852
translate schinese m1afterchoice1_5c209ff0:

    # MCt "No parallel world is going to keep me away from the internet."
    MCt "平行世界也拦不住我上网。"

# game/script.rpyc:1853
translate schinese m1afterchoice1_b39d831d:

    # MCt "I know my way around a Wikipedia rabbit-hole."
    MCt "我可是很会在维基百科的兔子洞里迷路的。"

# game/script.rpyc:1858
translate schinese m1afterchoice1_82c1f3ee:

    # MCt "I think... I've underestimated how hard it is to learn the entire history of the world..."
    MCt "我想……我低估了了解世界全部历史有多难了……"

# game/script.rpyc:1859
translate schinese m1afterchoice1_2c92db16:

    # MCt "I need to break it into parts..."
    MCt "我得分成几个部分来查……"

# game/script.rpyc:1861
translate schinese m1afterchoice1_e41893bf:

    # MCt "Let's start with Magic."
    MCt "先从魔法开始。"

# game/script.rpyc:1865
translate schinese m1afterchoice1_9b35a558:

    # MCt "I still can't believe this..."
    MCt "我还是不敢相信……"

# game/script.rpyc:1866
translate schinese m1afterchoice1_58f3980c:

    # MCt "Magic is real! There's so much evidence."
    MCt "魔法是真的！证据多得很。"

# game/script.rpyc:1867
translate schinese m1afterchoice1_1cd19137:

    # MCt "I need to compile everything I've learned. This was far too complicated to take in all at once."
    MCt "我得把自己学到的一切整理起来。这件事太复杂了，不可能一次全记住。"

# game/script.rpyc:1868
translate schinese m1afterchoice1_640173a4:

    # MCt "Magic in this world isn't as chaotic as most novels and movies... There's a lot that magic {i}can't{/i} do."
    MCt "这个世界的魔法不像大多数小说和电影里那么混乱……有很多事情魔法{i}不能{/i}做。"

# game/script.rpyc:1869
translate schinese m1afterchoice1_5df9f25c:

    # MCt "No teleportation, no flight, you can conjure some things but not {i}anything{/i}."
    MCt "不能传送，不能飞行；可以召唤一些东西，但不可能召唤{i}任何{/i}东西。"

# game/script.rpyc:1870
translate schinese m1afterchoice1_1bd57e8e:

    # MCt "Magic has been categorized into three schools."
    MCt "魔法被分为三个学派。"

# game/script.rpyc:1871
translate schinese m1afterchoice1_8d2ede0a:

    # MCt "{b}META{/b}: The ability to create and manipulate."
    MCt "{b}META（元法）{/b}：创造和操纵的能力。"

# game/script.rpyc:1872
translate schinese m1afterchoice1_2bd38db1:

    # MCt "Examples include elemental conjuration, you can shoot fire out of your fucking hands!"
    MCt "例如元素召唤，你可以从你他妈的手里放出火焰！"

# game/script.rpyc:1873
translate schinese m1afterchoice1_5bdf65ea:

    # MCt "Force influence, you can slightly alter how something feels gravity, for example."
    MCt "力量影响，比如说，你可以稍微改变某样东西的重力感。"

# game/script.rpyc:1874
translate schinese m1afterchoice1_5858b5dc:

    # MCt "That's kind of the idea behind meta spells. Things like that."
    MCt "这就是元法之类法术的基本思路。"

# game/script.rpyc:1875
translate schinese m1afterchoice1_c41aee08:

    # MCt "Then the next school..."
    MCt "然后是下一个学派……"

# game/script.rpyc:1876
translate schinese m1afterchoice1_fe6cbc55:

    # MCt "{b}Psychological{/b}: Influence of the mind."
    MCt "{b}心理系{/b}：对心智的影响。"

# game/script.rpyc:1877
translate schinese m1afterchoice1_1c463c23:

    # MCt "This one is a little harder to understand, and not just for me, it's not well understood even by experts."
    MCt "这一学派有点难理解，不只是我，即便是专家也没有充分理解。"

# game/script.rpyc:1878
translate schinese m1afterchoice1_3cd46777:

    # MCt "You can't read minds, except sometimes you can, you can't influence someone's thoughts, except sometimes you can..."
    MCt "你不能读心，但有时可以；你不能影响别人的思想，但有时可以……"

# game/script.rpyc:1879
translate schinese m1afterchoice1_755bf8bc:

    # MCt "There are a few examples of people using magic to change how others perceive the world around them, but only tiny facets."
    MCt "有一些人会用魔法改变别人对周围世界的感知，但只能改变极其微小的方面。"

# game/script.rpyc:1880
translate schinese m1afterchoice1_96f89a9c:

    # MCt "The third school..."
    MCt "第三个学派……"

# game/script.rpyc:1881
translate schinese m1afterchoice1_5e253d9f:

    # MCt "{b}Transitive{/b}: The ability to infuse other things with magic."
    MCt "{b}传递系{/b}：将魔法注入其他物体的能力。"

# game/script.rpyc:1882
translate schinese m1afterchoice1_383d1dc0:

    # MCt "Potions, weapons, even some modern technologies."
    MCt "药水、武器，甚至一些现代科技。"

# game/script.rpyc:1883
translate schinese m1afterchoice1_f1a5cf58:

    # MCt "There's one spell that stood out amongst all of the ones I encountered..."
    MCt "在我遇到的法术中，有一个特别引人注目……"

# game/script.rpyc:1884
translate schinese m1afterchoice1_5ba35cc7:

    # MCt "{b}Binding{/b}."
    MCt "{b}绑定{/b}。"

# game/script.rpyc:1885
translate schinese m1afterchoice1_0159002e:

    # MCt "The only known transitive spell that can be cast on other people."
    MCt "这是传递学派中唯一已知、能够对他人施放的法术。"

# game/script.rpyc:1886
translate schinese m1afterchoice1_ca505947:

    # MCt "It..."
    MCt "我……"

# game/script.rpyc:1887
translate schinese m1afterchoice1_15d8bb1c:

    # MCt "Makes them your slave."
    MCt "会让他们成为你的奴隶。"

# game/script.rpyc:1888
translate schinese m1afterchoice1_487b765d:

    # MCt "I'll review that later. It needs its own attention."
    MCt "我以后再研究这个。它需要单独花时间。"

# game/script.rpyc:1889
translate schinese m1afterchoice1_14de7c20:

    # MCt "For now I'll keep reviewing the magic basics."
    MCt "现在我先继续学习魔法基础。"

# game/script.rpyc:1890
translate schinese m1afterchoice1_84e6390b:

    # MCt "Not everyone can use magic. That must be what Noelle meant earlier..."
    MCt "不是每个人都能使用魔法。那一定就是诺艾尔之前说的……"

# game/script.rpyc:1895
translate schinese m1afterchoice1_682f0669:

    # MCt "So it's only me?"
    MCt "所以只有我会用？"

# game/script.rpyc:1901
translate schinese m1afterchoice1_256479bb:

    # MCt "I looked a little into the demographics. The population that can use magic is somewhere around eighty-five percent. At least according to a census conducted three years ago."
    MCt "我简单了解了一下人口统计。能使用魔法的人大约占百分之八十五。至少根据三年前的人口普查是这样。"

# game/script.rpyc:1902
translate schinese m1afterchoice1_e5fc36ca:

    # MCt "Those who can't use magic are called \"dull\"."
    MCt "不能使用魔法的人被称为“无趣者”。"

# game/script.rpyc:1903
translate schinese m1afterchoice1_7e3f67b8:

    # MCt "And those who {i}can{/i} use magic are anything but equal."
    MCt "而能{i}使用{/i}魔法的人之间，也绝不等同。"

# game/script.rpyc:1904
translate schinese m1afterchoice1_e52673d5:

    # MCt "Each magic user has an affinity; how well they can channel magic."
    MCt "这会影响法术的威力，也会影响魔法抗性。显然还会影响他们学习法术的难易程度。"

# game/script.rpyc:1905
translate schinese m1afterchoice1_ecf4ae4b:

    # MCt "This affects the potency of their spells, but also their magic resistance. It also apparently affects how easily they learn spells, too."
    MCt "这会影响法术威力，也会影响魔法抗性。显然还会影响他们学习法术的容易程度。"

# game/script.rpyc:1909
translate schinese m1afterchoice1_699b0e87:

    # MCt "There are outliers, even within magic users."
    MCt "即使在魔法使用者中，也存在例外。"

# game/script.rpyc:1910
translate schinese m1afterchoice1_aa1d43ad:

    # MCt "Magic affinity affects magic uniformly, at least it normally does."
    MCt "亲和力通常会全面影响魔法，至少一般如此。"

# game/script.rpyc:1911
translate schinese m1afterchoice1_b69a15d0:

    # MCt "There are cases of special magicians."
    MCt "有些特殊的魔法师。"

# game/script.rpyc:1915
translate schinese m1afterchoice1_5d586af6:

    # MCt "Some rare people are {b}Resonant{/b} with a particular school."
    MCt "少数稀有人会与某个特定学派产生{b}共鸣{/b}。"

# game/script.rpyc:1916
translate schinese m1afterchoice1_636b7c00:

    # MCt "Their magical performance in the other schools is in line with their affinity, but their performance with their resonant school far exceeds that, as if they were someone with a much higher affinity."
    MCt "他们在其他学派的魔法表现与亲和力相符，但在自己共鸣学派上的表现却远超这个水平，就像亲和力高得多的人。"

# game/script.rpyc:1917
translate schinese m1afterchoice1_26c5c3f1:

    # MCt "Just a fun fact I found while researching. There aren't many resonant people."
    MCt "这是我研究中偶然发现的趣闻。共鸣者并不多。"

# game/script.rpyc:1921
translate schinese m1afterchoice1_13879c4d:

    # MCt "Affinity can actually be measured. The most natural, instinctual spell is magnetism."
    MCt "亲和力其实可以测量。最自然、最本能的法术是磁力术。"

# game/script.rpyc:1922
translate schinese m1afterchoice1_c3c5febb:

    # MCt "It is, without fail, the first spell infants will cast, both consciously and unconsciously."
    MCt "毫无疑问，这是婴儿最先施展的法术，无论有意识还是无意识。"

# game/script.rpyc:1923
translate schinese m1afterchoice1_60eabf7a:

    # MCt "They will even periodically cast it in the womb. Pregnant mothers are advised to remove navel piercings."
    MCt "他们甚至会在子宫里定期施展。所以医生会建议孕妇摘掉肚脐环。"

# game/script.rpyc:1924
translate schinese m1afterchoice1_2d204a49:

    # MC "..."
    MC "……"

# game/script.rpyc:1925
translate schinese m1afterchoice1_e5a430eb:

    # MCt "So when Noelle said I yanked on her earring..."
    MCt "所以诺艾尔说我扯了她耳环……"

# game/script.rpyc:1927
translate schinese m1afterchoice1_97871764:

    # MCt "The metric used to gauge someone's affinity is the range at which their magnetism is felt."
    MCt "衡量一个人亲和力的指标，是他的磁力能够被感受到的范围。"

# game/script.rpyc:1928
translate schinese m1afterchoice1_ed247a3a:

    # MCt "Because magnetism is a Meta spell, if someone is later suspected to be resonant with Meta magic, they are tested again using a Transitive spell that tests the concentration of forced bonds between liquid molecules."
    MCt "由于磁力属于元法咒法，如果之后怀疑某人与元法魔法共鸣，就会使用一种传递学派法术再次检测，测量液态分子间强制键的浓度。"

# game/script.rpyc:1929
translate schinese m1afterchoice1_27844fcb:

    # MCt "The median average being forty centimeters, when excluding dull people."
    MCt "排除无趣者后，中位平均值是四十厘米。"

# game/script.rpyc:1930
translate schinese m1afterchoice1_1915d85e:

    # MCt "Though, the mean average being fifty-one centimeters seems to indicate that there aren't too many extremely-high-scoring outliers."
    MCt "不过，平均值是五十一厘米，似乎说明极端高分异常值并不多。"

# game/script.rpyc:1931
translate schinese m1afterchoice1_9684d775:

    # MCt "While looking at these numbers I ended up learning of a surprisingly disturbing story."
    MCt "查看这些数字时，我偶然发现了一个令人不安的故事。"

# game/script.rpyc:1932
translate schinese m1afterchoice1_2b76852b:

    # MCt "The highest recorded affinity was two meters. And that baby..."
    MCt "有记录以来最高的亲和力是两米。而那个婴儿……"

# game/script.rpyc:1933
translate schinese m1afterchoice1_71dc9604:

    # MCt "...was killed. The killer wasn't found, but it's suspected that the baby was killed out of fear."
    MCt "……被杀了。凶手没有找到，但据推测，婴儿是因为恐惧而被杀害的。"

# game/script.rpyc:1938
translate schinese m1afterchoice1_05d1eafd:

    # MCt "I alluded to slavery earlier..."
    MCt "我刚才提到过奴隶制……"

# game/script.rpyc:1939
translate schinese m1afterchoice1_4fdb95f8:

    # MCt "The binding spell..."
    MCt "束缚法术……"

# game/script.rpyc:1940
translate schinese m1afterchoice1_84d402f1:

    # MCt "You can cast it on someone in two situations:"
    MCt "在两种情况下，你可以对某人施放它："

# game/script.rpyc:1941
translate schinese m1afterchoice1_d0095d41:

    # MCt "The target of the spell consents. There may be several reasons to do that, such as paying off a debt, or extreme fetishism."
    MCt "目标同意。理由可能很多，比如偿还债务，或极度恋物。"

# game/script.rpyc:1942
translate schinese m1afterchoice1_ef30e44c:

    # MCt "The other situation is that the target of the spell already submits to you, viewing you as entirely dominant over them. In this case you will need to have a higher affinity than the target for the binding to be successful."
    MCt "另一种情况是目标本来就服从你，把你视为完全支配自己的人。在这种情况下，你的亲和力必须高于目标，束缚才会成功。"

# game/script.rpyc:1943
translate schinese m1afterchoice1_2b939ac4:

    # MCt "The spell allows others to recognize a slave's status, and it also protects their owner. Any attempt of physical resistance mounted by a slave will be met with brief, magically induced paralysis."
    MCt "这个法术让别人能认出奴隶的身份，也会保护奴隶的主人。奴隶任何身体上的反抗，都会遭到短暂、由魔法引发的麻痹。"

# game/script.rpyc:1944
translate schinese m1afterchoice1_00ea8395:

    # MCt "Binding is permanent, there are no known ways to reverse it."
    MCt "束缚是永久的，目前没有已知方法可以解除。"

# game/script.rpyc:1946
translate schinese m1afterchoice1_25426b28:

    # MCt "There's also a {i}lot{/i} of world history to take in, an overwhelming amount."
    MCt "要了解的世界历史也{i}太多{/i}了，多到令人窒息。"

# game/script.rpyc:1947
translate schinese m1afterchoice1_9c6006b5:

    # MCt "Humans aren't the only ones anymore... Those Elves were real..."
    MCt "如今人类不再是唯一的存在……那些精灵是真的……"

# game/script.rpyc:1948
translate schinese m1afterchoice1_adf8b984:

    # MCt "Not just Elves, either. There are animal morphs, Cats, Dogs, Rabbits..."
    MCt "还不只是精灵。还有兽化人，猫、狗、兔子……"

# game/script.rpyc:1949
translate schinese m1afterchoice1_c9df7f5a:

    # MCt "There are also species I've never read about before in fiction..."
    MCt "还有一些我以前连在虚构作品里都没听说过的物种……"

# game/script.rpyc:1950
translate schinese m1afterchoice1_e0e2ceaf:

    # MCt "Doomchildren, Quarteth, Golems..."
    MCt "末日之子、四重奏族（Quarteth）、魔像……"

# game/script.rpyc:1951
translate schinese m1afterchoice1_2fc58336:

    # MCt "Even Elves are split into subspecies. Common, Dark, Wild. Even the extinct High Elves..."
    MCt "连精灵也分亚种。普通、黑暗、野生。甚至还有灭绝的高等精灵……"

# game/script.rpyc:1952
translate schinese m1afterchoice1_a232528f:

    # MCt "Each species has its own unique characteristics and history."
    MCt "每个物种都有自己独特的特征和历史。"

# game/script.rpyc:1953
translate schinese m1afterchoice1_c75319e4:

    # MCt "I guess if I ever want to read more in-depth, I can look them up on my phone whenever I want..."
    MCt "如果以后想深入了解，我想随时都可以用手机查……"

# game/script.rpyc:1956
translate schinese m1afterchoice1_2e6ea062:

    # "Try pointing your mouse in the top right corner of the screen. From now on you can gain access to lore codices. These codices will be updated until the game's completion."
    "试着把鼠标指向屏幕右上角。从现在起你可以访问世界资料汇编。这些汇编会持续更新，直到游戏通关。"

# game/script.rpyc:1957
translate schinese m1afterchoice1_dd72f806:

    # "For those of you on mobile, you can also toggle the button's visibility from the pause menu."
    "使用移动设备的玩家，也可以在暂停菜单切换按钮显示。"

# game/script.rpyc:1958
translate schinese m1afterchoice1_00f29105:

    # MCt "Geographically speaking... Not too much has changed, I still live in the northernmost country except..."
    MCt "从地理上说……变化不大，我还住在最北边的国家，除……"

# game/script.rpyc:1962
translate schinese m1afterchoice1_0e702757:

    # MCt "Something is off... The world I know is fully mapped... This world... No-one knows what's past the forest to the north."
    MCt "有什么不对劲……我熟悉的世界已经完全绘制在地图上……这个世界……没人知道北方森林另一边是什么。"

# game/script.rpyc:1963
translate schinese m1afterchoice1_2770717d:

    # MCt "{b}The infinite forest{/b}. You enter the forest, and no matter how far north you venture, you will never be more than an hour away from the city. Spooky stuff."
    MCt "{b}无限森林{/b}。你进入森林后，不管向北走多远，都不会离城市超过一小时路程。怪吓人的。"

# game/script.rpyc:1964
translate schinese m1afterchoice1_a3dd78c1:

    # MCt "Even drones experience the same phenomenon."
    MCt "即使是无人机也会经历同样的现象。"

# game/script.rpyc:1965
translate schinese m1afterchoice1_cc52b77d:

    # MCt "Satellite photos become corrupted, flying over the forest gives the same experience, only in the air."
    MCt "卫星照片会损坏，飞过森林时也会经历同样的事，只不过是在空中。"

# game/script.rpyc:1966
translate schinese m1afterchoice1_67167d84:

    # MCt "This is a lot to take in..."
    MCt "这些信息实在太多了……"

# game/script.rpyc:1967
translate schinese m1afterchoice1_af2e655b:

    # MCt "I'm sure I'll start picking up more information gradually."
    MCt "我相信自己会逐渐掌握更多。"

# game/script.rpyc:1971
translate schinese m1afterchoice1_9dab9ca1:

    # MCt "I don't know if there's anything else I want to look up right now..."
    MCt "我现在好像没别的想查的了……"

# game/script.rpyc:1992
translate schinese m1afterchoice1_036b1ece:

    # MCt "No way! Nice! Elf porn!"
    MCt "不会吧！太棒了！精灵色情片！"

# game/script.rpyc:1996
translate schinese m1afterchoice1_50853d42:

    # MCt "Wait! Is that the time? Shit, who would've guessed that learning about a different dimension would take all day?"
    MCt "等等！已经这个时间了？操，谁能想到了解另一个维度会花上一整天？"

# game/script.rpyc:1997
translate schinese m1afterchoice1_e17dba2c:

    # MCt "Goddamn, I'm hungry."
    MCt "该死，我饿了。"

# game/script.rpyc:1998
translate schinese m1afterchoice1_44a4802f:

    # MCt "I guess it's time to step out of my room, conveniently bump into the girls..."
    MCt "是时候走出房间，碰巧遇到女孩们了……"

# game/script.rpyc:1999
translate schinese m1afterchoice1_0ad81313:

    # MCt "\"[name], we love you! We've been waiting for you! I couldn't bear spending the day without you!\""
    MCt "“[name]，我们爱你！我们一直在等你！没有你度过这一天我受不了！”"

# game/script.rpyc:2000
translate schinese m1afterchoice1_7b07d2c4:

    # MCt "Ladies, ladies, don't all jump on me at once. I'm still fragile."
    MCt "女士们，女士们，别一起扑上来。我还很脆弱。"

# game/script.rpyc:2013
translate schinese m1afterchoice1_ae19c998:

    # MCt "Alas... Some features of the world {i}haven't{/i} changed..."
    MCt "唉……世界的某些特征{i}还是{/i}没变……"

# game/script.rpyc:2022
translate schinese m1afterchoice1_87ff5a11:

    # MCt "My instincts! They're kicking in!"
    MCt "我的本能！它们开始苏醒了！"

# game/script.rpyc:2036
translate schinese m1afterchoice1_50581738:

    # g "You're still slow. That must mean you're at full health."
    g "你还是很慢。这说明你满血了。"

# game/script.rpyc:2040
translate schinese m1afterchoice1_133bb5be:

    # MC "I may be slow but my penis is very long, and at the end of the day that's all that really matters."
    MC "我虽然慢，但阴茎很长，归根结底，这才是真正重要的。"

# game/script.rpyc:2044
translate schinese m1afterchoice1_a33d6b53:

    # g "Mine's bigger."
    g "我的更大。"

# game/script.rpyc:2045
translate schinese m1afterchoice1_a1dac6f3:

    # g "Besides, all I heard from that was \"My girth is underwhelming\"."
    g "再说了，我只听到你说“我的粗度令人失望”。"

# game/script.rpyc:2046
translate schinese m1afterchoice1_2654b6bd:

    # MC "Exactly, 'tis akin to uncooked spaghetti."
    MC "没错，就像没煮熟的面条。"

# game/script.rpyc:2055
translate schinese m1afterchoice1_044da87f:

    # MC "Oh, how I enjoy the embrace of you, my orange little friend."
    MC "啊，我多么享受你的拥抱，我橙色的小伙伴。"

# game/script.rpyc:2056
translate schinese m1afterchoice1_f8b17c8c:

    # g "Oh, shut up. This is merely a symptom of basking in the setting sun."
    g "哦，闭嘴。这只是沐浴在落日余晖中的症状。"

# game/script.rpyc:2057
translate schinese m1afterchoice1_8b796b6a:

    # MC "I don't care. You're comically orange and it makes me laugh."
    MC "我不在乎。你橙得滑稽，看着就让人发笑。"

# game/script.rpyc:2059
translate schinese m1afterchoice1_06ab8f03:

    # g "How are you feeling?"
    g "感觉怎么样？"

# game/script.rpyc:2060
translate schinese m1afterchoice1_0d97413b:

    # MC "Tired, hungry..."
    MC "累，饿……"

# game/script.rpyc:2064
translate schinese m1afterchoice1_412e4d88:

    # g "Your hug feels weaker than usual."
    g "你的拥抱比平时更无力了。"

# game/script.rpyc:2065
translate schinese m1afterchoice1_7b1b0dd1:

    # MC "That's because..."
    MC "那是因为……"

# game/script.rpyc:2069
translate schinese m1afterchoice1_d592d2ec:

    # MC "I don't feel any spark between us anymore..."
    MC "我们之间已经没有以前那种火花……"

# game/script.rpyc:2073
translate schinese m1afterchoice1_101f2d53:

    # g "No, really, you seem weak. Maybe it was the sickness."
    g "不，真的，你看起来很虚弱。可能是那场病。"

# game/script.rpyc:2077
translate schinese m1afterchoice1_7381565d:

    # MC "You think?"
    MC "你觉得？"

# game/script.rpyc:2078
translate schinese m1afterchoice1_2bc5ad6f:

    # MC "Couldn't it just be because I haven't eaten?"
    MC "也可能只是因为我没吃东西？"

# game/script.rpyc:2079
translate schinese m1afterchoice1_1d52b595:

    # g "Eh, maybe."
    g "呃，也许吧。"

# game/script.rpyc:2083
translate schinese m1afterchoice1_5b8aaf05:

    # g "Think you can take care of that by yourself?"
    g "这点事你能自己搞定吗？"

# game/script.rpyc:2084
translate schinese m1afterchoice1_c7450c3e:

    # MC "No, I specifically need a piggyback down the stairs, a three course meal hand fed to me, and table-side entertainment."
    MC "不，我明确需要有人背我下楼、喂我吃三道菜，还要在我吃饭时提供桌边娱乐。"

# game/script.rpyc:2085
translate schinese m1afterchoice1_79096796:

    # MC "Think you could do that for me?"
    MC "你觉得你能做到吗？"

# game/script.rpyc:2098
translate schinese m1afterchoice1_2d204a49_1:

    # MC "..."
    MC "……"

# game/script.rpyc:2099
translate schinese m1afterchoice1_11a7dcca:

    # MCt "I'm making my own food, aren't I?"
    MCt "我不是正在自己做食物吗？"

# game/script.rpyc:2111
translate schinese m1afterchoice1_8ab9ab62:

    # MCt "People really have tails now?"
    MCt "人们现在真的长尾巴了？"

# game/script.rpyc:2112
translate schinese m1afterchoice1_d41c0f90:

    # MCt "Animal-girls..."
    MCt "兽娘……"

# game/script.rpyc:2113
translate schinese m1afterchoice1_b7a42fee:

    # MCt "I kinda..."
    MCt "我有点……"

# game/script.rpyc:2117
translate schinese m1afterchoice1_c006e9e7:

    # MCt "Want to see it..."
    MCt "想看看……"

# game/script.rpyc:2118
translate schinese m1afterchoice1_d5c8fa75:

    # MCt "There's a district relatively nearby. One that's populated by animal-morphs."
    MCt "附近有一个区域，是兽化人居住的。"

# game/script.rpyc:2119
translate schinese m1afterchoice1_c04ae0aa:

    # MCt "I wonder if I can just walk through there... Maybe try my best to not overtly stare, I don't want to look like I'm visiting a zoo."
    MCt "我想我可以就这么走过去……也许尽量不要盯着看，我不想看起来像是在参观动物园。"

# game/script.rpyc:2120
translate schinese m1afterchoice1_d709b47b:

    # MCt "From what I could gather, there isn't much tension between humans and animal-morphs."
    MCt "据我所知，人类和兽化人之间还算相安无事。"

# game/script.rpyc:2121
translate schinese m1afterchoice1_2d204a49_2:

    # MC "..."
    MC "……"

# game/script.rpyc:2122
translate schinese m1afterchoice1_7cb43b18:

    # MCt "Magic?"
    MCt "魔法？"

# game/script.rpyc:2123
translate schinese m1afterchoice1_604a845f:

    # MCt "Even though so much of this world appears the same..."
    MCt "虽然这个世界看起来有很多地方没变……"

# game/script.rpyc:2130
translate schinese m1afterchoice1_9c864f21:

    # MCt "Wait! What about me?!"
    MCt "等等！我呢？！"

# game/script.rpyc:2134
translate schinese m1afterchoice1_0504e4bf:

    # MCt "How do you do it? How do you cast a spell?"
    MCt "我是怎么做到的？怎么施展法术？"

# game/script.rpyc:2135
translate schinese m1afterchoice1_68d3e04e:

    # MCt "It's instinctual, right?"
    MCt "是本能，对吧？"

# game/script.rpyc:2136
translate schinese m1afterchoice1_30491eac:

    # MCt "So..."
    MCt "所以……"

# game/script.rpyc:2144
translate schinese m1afterchoice1_715aadd8:

    # MCt "Give me that fork..."
    MCt "把叉子给我……"

# game/script.rpyc:2158
translate schinese m1afterchoice1_848540c8:

    # MC "F-first try..."
    MC "第、第一次尝试……"

# game/script.rpyc:2159
translate schinese m1afterchoice1_1cd9bd8a:

    # MC "Wait-"
    MC "等等——"

# game/script.rpyc:2162
translate schinese m1afterchoice1_90f8405a:

    # MC "I'm fucking magic!"
    MC "我他妈在使用魔法！"

# game/script.rpyc:2163
translate schinese m1afterchoice1_88d1dc54:

    # MC "No way!"
    MC "不会吧！"

# game/script.rpyc:2164
translate schinese m1afterchoice1_5b1b72bc:

    # MC "That was so cool!"
    MC "太酷了！"

# game/script.rpyc:2168
translate schinese m1afterchoice1_ba82bb0d:

    # MCt "But this... I can..."
    MCt "可是这个……我可以……"

# game/script.rpyc:2218
translate schinese m1afterchoice1_c1170cce:

    # MC "Ah..."
    MC "啊……"

# game/script.rpyc:2222
translate schinese m1afterchoice1_b630f813:

    # c "Why are you playing with a fork?"
    c "你为什么在玩叉子？"

# game/script.rpyc:2223
translate schinese m1afterchoice1_9cfb1884:

    # MC "Umm... Why aren't {i}you{/i}?"
    MC "呃……为什么{i}你{/i}不？"

# game/script.rpyc:2227
translate schinese m1afterchoice1_ec9e63c1:

    # MC "Your brain has been poisoned by technology."
    MC "你的脑子已经被科技污染了。"

# game/script.rpyc:2231
translate schinese m1afterchoice1_0c853b0f:

    # MC "Rendering you incapable of enjoying the simple pleasures in life."
    MC "导致你无法享受生活中那些简单的小乐趣。"

# game/script.rpyc:2235
translate schinese m1afterchoice1_a2051760:

    # MC "Like forks."
    MC "比如叉子。"

# game/script.rpyc:2244
translate schinese m1afterchoice1_2d204a49_3:

    # MC "..."
    MC "……"

# game/script.rpyc:2245
translate schinese m1afterchoice1_59f48d27:

    # MC "Are you here for the forks?"
    MC "你是为了叉子才来的？"

# game/script.rpyc:2247
translate schinese m1afterchoice1_2d204a49_4:

    # MC "..."
    MC "……"

# game/script.rpyc:2248
translate schinese m1afterchoice1_2bd6568f:

    # MC "What do you think of animal people?"
    MC "你觉得兽化人怎么样？"

# game/script.rpyc:2249
translate schinese m1afterchoice1_4e5a4202:

    # c "Why?"
    c "为什么？"

# game/script.rpyc:2250
translate schinese m1afterchoice1_8127959b:

    # MC "...I don't know..."
    MC "……我不知道……"

# game/script.rpyc:2254
translate schinese m1afterchoice1_b756a4ab:

    # c "They're... fine..."
    c "他们……还行……"

# game/script.rpyc:2255
translate schinese m1afterchoice1_224dc04a:

    # c "There are some rabbit twins in my class."
    c "我们班有一对兔子双胞胎。"

# game/script.rpyc:2259
translate schinese m1afterchoice1_6b933961:

    # MC "But how about the way they look?"
    MC "那你觉得他们长什么样？"

# game/script.rpyc:2263
translate schinese m1afterchoice1_e64d6835:

    # MC "What do you think of their ears?"
    MC "你觉得他们的耳朵怎么样？"

# game/script.rpyc:2267
translate schinese m1afterchoice1_ac45ea20:

    # MC "Their tails?"
    MC "尾巴呢？"

# game/script.rpyc:2271
translate schinese m1afterchoice1_0c5dd543:

    # c "Eh? What's gotten into you?"
    c "欸？你怎么了？"

# game/script.rpyc:2272
translate schinese m1afterchoice1_9922da1f:

    # c "Why are you being weird about animal-morphs?"
    c "你为什么对兽化人这么奇怪？"

# game/script.rpyc:2273
translate schinese m1afterchoice1_4b660008:

    # MC "No reason. I was just thinking about them before you showed up."
    MC "没什么。我只是在你出现之前想到了他们。"

# game/script.rpyc:2274
translate schinese m1afterchoice1_1716d02c:

    # c "When you were playing with..."
    c "你刚才在玩……"

# game/script.rpyc:2279
translate schinese m1afterchoice1_99ce956e:

    # MC "Yes! With the fork! Forget about the forks!"
    MC "对！叉子！别管叉子了！"

# game/script.rpyc:2283
translate schinese m1afterchoice1_d19f855d:

    # c "..."
    c "……"

# game/script.rpyc:2284
translate schinese m1afterchoice1_9f9fa72c:

    # c "I think the ears and the tails are... cute..."
    c "我觉得耳朵和尾巴……挺可爱的……"

# game/script.rpyc:2288
translate schinese m1afterchoice1_adcdec6c:

    # MC "Hmm... \"Cute\". I see, I see."
    MC "嗯……“可爱”。我懂了，我懂了。"

# game/script.rpyc:2292
translate schinese m1afterchoice1_01426200:

    # MCt "I can see it just now. A cute girl with fluffy ears, and a tail that could wrap around you."
    MCt "我现在看得很清楚了。一个有着蓬松耳朵、尾巴还能缠住你的可爱女孩。"

# game/script.rpyc:2293
translate schinese m1afterchoice1_85856e7e:

    # MCt "But Elf ears are also..."
    MCt "不过精灵的耳朵也……"

# game/script.rpyc:2297
translate schinese m1afterchoice1_eaf70805:

    # c "S-see you..."
    c "那、那我也……"

# game/script.rpyc:2301
translate schinese m1afterchoice1_94f18b32:

    # c "I'll let you get back to... whatever..."
    c "我就让你回去继续……做你的事……"

# game/script.rpyc:2309
translate schinese m1afterchoice1_ae22e1d4:

    # MCt "Whatever. I've spent my whole life unable to manipulate forks with my mind."
    MCt "随便吧。我一辈子都没法用念力操控叉子。"

# game/script.rpyc:2313
translate schinese m1afterchoice1_e79e3507:

    # MCt "Now:"
    MCt "现在："

# game/script.rpyc:2319
translate schinese m1afterchoice1_aad4b989:

    # MCt "I can command all of the forks in the universe!"
    MCt "我能指挥宇宙里所有的叉子！"

# game/script.rpyc:2324
translate schinese m1afterchoice1_3a88a34d:

    # MCt "Of course Chloe doesn't understand."
    MCt "克洛伊当然不懂。"

# game/script.rpyc:2329
translate schinese m1afterchoice1_ea828d6b:

    # MCt "She doesn't know how it feels to be unstoppable!"
    MCt "她不知道什么叫势不可挡！"

# game/script.rpyc:2375
translate schinese main2_c17b7bbc:

    # g "Could you stop that?"
    g "你能别这样吗？"

# game/script.rpyc:2376
translate schinese main2_85ed3e50:

    # MC "I don't see the harm in it."
    MC "我看不见有什么危害。"

# game/script.rpyc:2387
translate schinese main2_49b6de0b:

    # g "What if you lose them?"
    g "万一你把它们弄丢了呢？"

# game/script.rpyc:2401
translate schinese main2_24d2797f:

    # g "I need those to open my swim locker."
    g "我需要那些叉子打开我的泳池储物柜。"

# game/script.rpyc:2402
translate schinese main2_8cfb53d8:

    # MC "Why don't you just use that grip strength of yours to pry it open?"
    MC "你为什么不用你的握力把它撬开？"

# game/script.rpyc:2414
translate schinese main2_80600135:

    # MC "Or are those muscles purely for show?"
    MC "还是说那些肌肉只是用来展示的？"

# game/script.rpyc:2418
translate schinese main2_f5b4d930:

    # g "I'm serious, stop."
    g "我是认真的，停手。"

# game/script.rpyc:2448
translate schinese main2_e7544197:

    # MC "Be careful spinning those on your finger. You might lose them."
    MC "小心点，别在手指上转的时候掉了。你可能会把它们弄丢。"

# game/script.rpyc:2449
translate schinese main2_465c4fca:

    # g "I don't want to hear that from someone who couldn't resist playing like a child."
    g "我可不想听一个连自己都忍不住像小孩一样玩的人说这种话。"

# game/script.rpyc:2450
translate schinese main2_ac85a666:

    # g "Or do you think you're God's gift to magic?"
    g "还是你以为自己是上帝送给魔法的礼物？"

# game/script.rpyc:2451
translate schinese main2_95d01575:

    # MC "Magic, women, lonely gerbils that need adoption. You name it."
    MC "魔法、女人、需要收养的孤独仓鼠。随你说。"

# game/script.rpyc:2452
translate schinese main2_ee50c645:

    # g "Have you heard of the inconsistent triad?"
    g "你听说过不一致三命题吗？"

# game/script.rpyc:2453
translate schinese main2_63e34801:

    # MC "A triad of propositions such that if all three are true a contradiction is formed."
    MC "如果三个命题同时为真就会形成矛盾的三个命题。"

# game/script.rpyc:2454
translate schinese main2_44874a59:

    # MC "What of it?"
    MC "所以呢？"

# game/script.rpyc:2456
translate schinese main2_517d43c8:

    # MC "I know, Grace."
    MC "我知道，格蕾丝。"

# game/script.rpyc:2457
translate schinese main2_739be2dc:

    # g "Hmm... Sorry, I forgot you were a know-it-all smart-ass."
    g "嗯……抱歉，我忘了你是个自以为什么都懂的自作聪明鬼。"

# game/script.rpyc:2464
translate schinese main2_e5bef915:

    # MC "Where are you going with this?"
    MC "你想用这个证明什么？"

# game/script.rpyc:2465
translate schinese main2_1d0b06e1:

    # g "Let's say you {i}are{/i} God's gift to magic, women and squirrels:"
    g "假设你{i}就是{/i}上帝送给魔法、女人和仓鼠的礼物："

# game/script.rpyc:2466
translate schinese main2_c7a6691a:

    # MC "Gerbils."
    MC "仓鼠。"

# game/script.rpyc:2470
translate schinese main2_0ce5ecf6:

    # g "If God were both omniscient and benevolent, then he lacks the power to solve all of those little gerbils' problems."
    g "如果上帝既全知又仁慈，那他就没有能力解决那些小仓鼠的所有问题。"

# game/script.rpyc:2471
translate schinese main2_95cee8a0:

    # g "If God were both omnipotent and benevolent, then he lacks the knowledge to understand just how bad sending you is."
    g "如果上帝既全能又仁慈，那他就没有足够知识理解把你送出去究竟有多糟糕。"

# game/script.rpyc:2472
translate schinese main2_3ee7766e:

    # g "Or the third, and in my opinion, most likely situation:"
    g "或者第三种情况，在我看来也是最可能的一种："

# game/script.rpyc:2476
translate schinese main2_1e608fdb:

    # g "God is omnipotent and omniscient, but by sending {i}you{/i};"
    g "上帝全能全知，但却把你{i}派{/i}来；"

# game/script.rpyc:2481
translate schinese main2_a26a55ee:

    # g "-he has shown that he doesn't love us at all."
    g "——这说明他根本不爱我们。"

# game/script.rpyc:2487
translate schinese main2_30303b72:

    # MC "Grace..."
    MC "格蕾丝……"

# game/script.rpyc:2491
translate schinese main2_502e4a13:

    # MC "I have a personal list, ranking my favorite people."
    MC "我有一份个人名单，排列着我最喜欢的人。"

# game/script.rpyc:2492
translate schinese main2_83ba07bf:

    # MC "With that, you have just fallen one place."
    MC "这样一来，你刚刚下降了一位。"

# game/script.rpyc:2496
translate schinese main2_5b1238e3:

    # g "Hmm... have I now?"
    g "嗯……是吗？"

# game/script.rpyc:2497
translate schinese main2_8a161429:

    # g "So where am I on this ranking of yours?"
    g "那我在你的排名里排第几？"

# game/script.rpyc:2498
translate schinese main2_db5056ca:

    # MC "If you held your tongue, you'd still be above Chloe."
    MC "就算你闭嘴，也还是比克洛伊高。"

# game/script.rpyc:2503
translate schinese main2_e676067a:

    # g "Chloe? You exchange like, 20 words each week!"
    g "克洛伊？你每周大概只交换二十个词！"

# game/script.rpyc:2504
translate schinese main2_356ac144:

    # MC "Very few of them insults."
    MC "其中很少是骂人的话。"

# game/script.rpyc:2508
translate schinese main2_5f202f5d:

    # g "Wait, nono! Put me back up!"
    g "等等，不行！把我放回去！"

# game/script.rpyc:2512
translate schinese main2_8135e0de:

    # g "How about I take you somewhere nice?"
    g "要不我带你去个好地方？"

# game/script.rpyc:2513
translate schinese main2_140eba31:

    # MC "And what kind of place would that be?"
    MC "那会是什么地方？"

# game/script.rpyc:2522
translate schinese main2_a99f00b8:

    # MC "No."
    MC "不。"

# game/script.rpyc:2523
translate schinese main2_2f8b8ccd:

    # MC "The moment you said you'd take me somewhere I knew it'd be some meat-head shit."
    MC "你刚说带我去什么地方时，我就知道肯定是肌肉笨蛋那套。"

# game/script.rpyc:2527
translate schinese main2_aa83ac11:

    # g "Yeah, well, maybe you need the exercise."
