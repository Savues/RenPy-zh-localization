translate schinese main1_42f279dc:

    # stran "My boss'll kill me if I spend any longer out here than I need to."
    stran "我老板要是发现我在外面待太久，会杀了我的。"

# game/script.rpyc:1270
translate schinese main1_58d38f2d:

    # stran "You know how the Dark Elves are. Always bitter to us Humans."
    stran "你知道黑暗精灵就是这样。总是对我们人类冷言冷语。"

