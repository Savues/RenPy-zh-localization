  "_kept_verbatim_why": {
    "Sireneyes。": "夜店名，玩家和角色都说英文；译成「海妖」反而不像招牌。",
    "https://...": "Patreon / itch.io / Discord 三个链接，翻译它们只会让地址失效。",
    "[gui.about!t]\\n": "Ren'Py 自己的文本插值：!t 让引擎在运行时按当前语言查表，再拼上换行。写成中文反而绕开了引擎的翻译流程。",
    "Shift+A": "按键名，下面一行「打开无障碍菜单。」已经是中文。",
    "Меня зовут...": "script.rpy:36 起是原作自带的俄语分支，只有玩家在语言菜单里主动选俄语才会走到；它是游戏的，不是本补丁漏译的。",
    "Демиан": "同上，script.rpy:36 与 :38 两处俄语分支的默认名。"
  },
  "_names_are_not_translated": "角色名确实被译了（见上表），但只出现在 init.rpy 的 Character(_('…')) 里；正文对白一律用代号而不用名字，所以名字不会在正文里再出现一次。",
  "_suspected_typo": "init.rpy 里 jae_wook0 = Long-haired Gangster 译作「长发司转」、do_hyun0 = Bald Gangster 译作「秃头司转」。「司转」不是词，看着像「司机」手误。两处写法一致，像是统一选定的译名而不是随手打错，因此本补丁原样保留，等作者定夺。",
  "_doubling_exempt": [],
  "_variants_allowed": {
    "游商": "cdr_3.rpy 里流浪商人自报家门时用「游商」，init.rpy 的名牌用「流浪商人」。两种都在补丁里，是作者自己的取舍，不当作错译。",
    "青年教师": "script.rpy:1710 的「young teachers」是普通名词短语，不是 Teacher 这个角色的名牌，所以「教师」在这里不算漂移。"
  }
}
