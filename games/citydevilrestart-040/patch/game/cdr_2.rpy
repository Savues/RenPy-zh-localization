    $ outside_night_choice = []
    menu outside_night_choice: 
        set outside_night_choice
        '「你能告诉我他们是谁吗？」':
        
            gg 9 "你能告诉我他们是谁吗？" with dissolve
            scene outside_night_19 with Dissolve(0.3)
            ka 3 "是黑帮还是打手，我也不知道他们具体是谁。只知道不是善茬，跟他们打交道要小心。" with dissolve
            show outside_night_18 with Dissolve(0.3)
            jump outside_night_choice

        '「我欠的那个人叫什么名字？」':

            gg 9 "我欠的那个人叫什么名字？" with dissolve
            scene outside_night_20 with Dissolve(0.3)
            ka 3 "我不能确定，不过其中有个外号叫东华。" with dissolve
            show outside_night_18 with Dissolve(0.3)
            jump outside_night_choice

        '「我爸到底是做什么工作的？」':

            gg 9 "我爸到底是做什么工作的？" with dissolve
            gg 9 "他从来没跟我讲过实话，你知道的吧？"
            gg 9 "他把事情瞒着，装得跟什么科学家似的。"
            scene outside_night_21 with Dissolve(0.3)
            ka 3 "他确实是科学家，[gg]。" with dissolve
            scene outside_night_22 with Dissolve(0.3)
            ka 3 "神经生物学家。具体在研究什么我不清楚，大概跟某项研究有关。" with dissolve
            show outside_night_18 with Dissolve(0.3)
            jump outside_night_choice
            
        '「明白了。」':
            gg 9 "明白了。"
            
    scene outside_night_23 with Dissolve(0.6)
    ka 3 "做好搬家的准备吧。六万美金对你们来说是个大数目。" with dissolve
    ka 3 "不过说真的，你不用太担心。"
