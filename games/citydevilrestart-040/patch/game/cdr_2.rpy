label home_night_free_1_floor:
    if home_night_free_1_floor_told == False:
        play music relaxing_lofi_ena__sascha_ende fadein 5
        stop music2 fadeout 2
        scene black with Dissolve(1.0)
        pause 2.0
        scene home_night_free_1 with Dissolve(1.5)
        pause 2
        scene home_night_free_2 with Dissolve(0.5)
        gg 10 "（已经很晚了。芽衣应该睡了吧。）" with dissolve
        $ home_night_free_1_floor_told = True
        
    if home_night_free_living_room_with_may and home_night_free_living_room_with_may_covered == True:
        scene home_night_free_may_covered
        
    elif home_night_free_living_room_with_may == True:
        scene home_night_free_may
        
    else:
        scene home_night_free_may_without
        
    call screen home_night_free_1_floor
    
label home_night_free_livingroom:
    scene home_night_free_lr
    $ home_night_free_living_room_saw = True
    
    if home_night_free_living_room_with_may and home_night_free_living_room_with_may_covered == True:
    
        show home_night_free_lr_may_covered
    
    call screen home_night_free_livingroom
    
label home_night_free_livingroom_may:
    if home_night_free_living_room_visited == False:
    
        scene home_night_free_livingroom_may_1 with Dissolve(0.3)
        gg 10 "（果然。她等着等着就睡着了。）" with dissolve
        gg 10 "（八成是在看动画。）"
        scene home_night_free_livingroom_may_2 with Dissolve(0.3)
        gg 10 "（我可以把她抱上楼。）" with dissolve
        $ home_night_free_living_room_visited = True
    else:
        scene home_night_free_livingroom_may_2 with Dissolve(0.3)
    menu:
        "抱她上楼\\n[gr](推荐)":
            scene black with Dissolve(1.0)
            pause 1.0
            show home_night_free_livingroom_may_3 with Dissolve(0.3)
            $ renpy.pause(21.5,hard=True)
            scene black with Dissolve(0.3)
            pause 1
            scene home_night_free_livingroom_may_4 with Dissolve(0.5)
            ''
            scene home_night_free_livingroom_may_5 with Dissolve(0.5)
            gg 10 "晚安，[may]。" with dissolve
            $ home_night_free_living_room_with_may = False
            jump home_night_2_floor_corridor
            
        "给她盖上被子" if home_night_free_lr_blanket_visited:
            play sound clothes_2
            scene home_night_free_livingroom_may_covered_1 with Dissolve(0.3)
            gg 10 "（这样好多了。）" with dissolve
            $ home_night_free_living_room_with_may_covered = True
            jump home_night_free_livingroom
            
        "离开":
            jump home_night_free_livingroom

label home_night_free_livingroom_blanket:
    if home_night_free_living_room_with_may == True:
        scene home_night_free_livingroom_blanket_1 with Dissolve(0.3)
    if home_night_free_living_room_with_may == False:
        scene home_night_free_livingroom_blanket_2 with Dissolve(0.3)
    if home_night_free_lr_blanket_visited == False:
        gg 10 "（毯子。）" with dissolve
    if home_night_free_lr_blanket_visited == False and home_night_free_living_room_with_may == False:
        gg 10 "（与其在这边随便盖一下，还是把她抱上楼安顿好。）" with dissolve
        gg 10 "（睡床上当然比睡沙发好多了。）"
    if home_night_free_lr_blanket_visited == False and home_night_free_living_room_with_may == True:
        gg 10 "（我可以用这个盖住[may]。）" with dissolve
    else:
        gg 10 "{cps=5}……{/cps}" with dissolve
    $ home_night_free_lr_blanket_visited = True
    jump home_night_free_livingroom

label home_night_free_livingroom_phone:
    
    scene home_night_free_lr_phone_1
    $ home_night_free_lr_phone = True
    
    call screen home_night_free_livingroom_phone

label home_night_2_floor:
    if home_night_free_living_room_with_may  == True:
        scene home_night_2_floor_1 with Dissolve(0.3)
    if home_night_free_living_room_with_may  == False:
        scene home_night_2_floor_2 with Dissolve(0.3)

    call screen home_night_2_floor
    
label home_night_2_floor_corridor:
    if home_night_free_living_room_with_may  == True:
        scene home_night_2_floor_corridor_1 with Dissolve(0.3)
    if home_night_free_living_room_with_may  == False:
        scene home_night_2_floor_corridor_2 with Dissolve(0.3)

    call screen home_night_2_floor_corridor

label home_night_free_may_room:
    scene home_night_free_may_room_1 with Dissolve(0.3)
    if home_night_free_living_room_with_may  == True and home_night_free_may_room_visited == False and home_night_free_living_room_saw == True:
        gg 10 "（这里面很舒服，味道也好闻。）" with dissolve
        $ home_night_free_may_room_visited = True
    elif home_night_free_living_room_with_may  == True and home_night_free_may_room_visited == False and home_night_free_living_room_saw == False:
        gg 10 "（她不在。）" with dissolve
        gg 10 "（她大概在楼下的沙发上睡着了。）"
        $ home_night_free_may_room_visited = True
        
    else:
        pause 0.1
        
    call screen home_night_free_may_room

