label cdr_1:
    stop music2
    $ renpy.music.set_volume(1, delay=0, channel=u@Q)
    scene black
    hide screen girls with dissolve
    $ quick_menu = False
    pause 3.0
    show timetravel_1
    $ renpy.pause(5,hard=True)
    pause 1.0
    scene black
    pause 1.0
    show screen girls with dissolve
    $ quick_menu = True
    gg t0 @S with dissolve
    gg t0 @S
    gg t0 @S
    show awoke_1
    $ renpy.pause(4,hard=True)
    scene awoke_2 with dissolve
    play music2 clouds_above_the_oceanloopable_by_chilledmusic fadein 20 volume 0.6
