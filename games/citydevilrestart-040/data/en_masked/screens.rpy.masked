style vscrollbar:
    variant @S
    xsize gui.scrollbar_size
    base_bar Frame(@S, gui.vscrollbar_borders, tile=gui.scrollbar_tile)
    thumb Frame(@S, gui.vscrollbar_borders, tile=gui.scrollbar_tile)

style slider:
    variant @S
    ysize gui.slider_size
    base_bar Frame(@S, gui.slider_borders, tile=gui.slider_tile)
    thumb @S

style vslider:
    variant @S
    xsize gui.slider_size
    base_bar Frame(@S, gui.vslider_borders, tile=gui.slider_tile)
    thumb @S

style slider_vbox:
    variant @S
    xsize None

style slider_slider:
    variant @S
    xsize 600
