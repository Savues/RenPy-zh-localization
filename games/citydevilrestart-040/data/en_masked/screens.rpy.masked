screen game_menu(title, scroll=None, yinitial=0.0):

    style_prefix @S






    frame:
        style @S

        hbox:

            
            frame:
                style @S

            frame:
                style @S

                if scroll == @S:

                    viewport:
                        yinitial yinitial
                        scrollbars @S
                        mousewheel True
                        draggable True
                        pagekeys True

                        side_yfill True

                        vbox:
                            transclude

                elif scroll == @S:

                    vpgrid:
                        cols 1
                        yinitial yinitial

                        scrollbars @S
                        mousewheel True
                        draggable True
                        pagekeys True

                        side_yfill True

                        transclude

                else:

                    transclude

    use navigation






    label title

    if main_menu:
        key @S action ShowMenu(@S)


