transform language_box:
    on show:
        ease 0.3 xsize 500 ysize 760    
    on hide:
        ease 0.3 ysize 1
                
transform language_buttons:
    
    
    on idle:
        ease .3 matrixcolor TintMatrix(@S) * BrightnessMatrix(0.0)
    on hover:
        ease .2 matrixcolor TintMatrix(@S) * BrightnessMatrix(0.4)
    on show:
        ease 0.3 ypos 0 alpha 1.0 ysize 760 xsize 500    
    on hide:
        ease 0.2 ypos -50 alpha 0.0 ysize 60

transform gallery_list_buttons:
    
    
    on idle:
        ease .3 matrixcolor TintMatrix(@S) * BrightnessMatrix(0.0)
    on hover:
        ease .2 matrixcolor TintMatrix(@S) * BrightnessMatrix(0.4)
    on show:
        ease 0.3 ypos 0 alpha 1.0 ysize 150
    on hide:
        ease 0.2 ypos -50 alpha 0.0 ysize 60
        

