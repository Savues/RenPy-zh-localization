screen notify(message):

    zorder 100
    style_prefix @S

    frame at notify_appear:
        text @S

    timer 3.25 action Hide(@Q)


transform notify_appear:
    on show:
        alpha 0
        linear .25 alpha 1.0
    on hide:
        linear .5 alpha 0.0


