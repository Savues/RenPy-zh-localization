screen save():

    modal True
    zorder 2
    
    add @Q
    imagebutton idle @S hover @S focus_mask True hover_sound @S action Return() activate_sound @S at rs_return_nav
    
    add @Q
    use file_slots(_(@S))


screen load():

    modal True
    zorder 2
    
    tag menu
    if main_menu:
        add @Q
        add @Q alpha 0.8

    else:
        add @Q
        
    add @Q
    imagebutton idle @S hover @S focus_mask True hover_sound @S action Return() activate_sound @S at rs_return_nav
    
    use file_slots(_(@S))
    
image pref_bg = Movie(size=(1920,1080), channel =@S, play=@S, loop=True)

screen file_slots(title):

    default page_name_value = FilePageNameInputValue(pattern=_(@S), auto=_(@S), quick=_(@S))

    fixed:

        
        
        order_reverse True

        
        
        button at saveloadslot:
            style @S

            key_events True
            if renpy.variant(@S):
                xalign 0.5
                ypos 140
            if renpy.variant(@S):
                xpos 0.5
                ypos 140
            action page_name_value.Toggle()

            input:
                style @S
                value page_name_value
        
        grid 3 2:
            style_prefix @S
            if renpy.variant(@S):
                xalign 0.5
                yalign 0.5
            if renpy.variant(@S):
                xalign 0.5
                yalign 0.5
            spacing 40

            for i in range(6):

                $ slot = i + 1
                
                button at saveloadslot:
                    action FileAction(slot)
                    
                    xysize (430, 290)
                    hover_background @S
                    background @S
                    insensitive_background @S
                    
                    add FileScreenshot(slot) xalign 0.5 xsize 400 ysize 224 ypos 10
                    add @S xalign 0.5 yalign 0.5
                    
                    text FileTime(slot, format=_(@S)):
                        style @S
                        ypos 246
                        xalign 0.5
                        
                    
                    
                        
                    
                    key @S action FileDelete(slot)

        
        hbox:
            xalign 0.5
            ypos 920
            spacing 10

            imagebutton at saveloadtab:
                idle @S
                action FilePagePrevious()
                yalign 0.5
                xpos -8

            if config.has_autosave:
                button at saveloadslot:
                    style @S
                    text @S align (0.5, 0.5) style @S
                    action FilePage(@S)

            if config.has_quicksave:
                button at saveloadslot:
                    style @S
                    text @S align (0.5, 0.5) style @S
                    action FilePage(@S)

            for page in range(1, 7):
                button at saveloadslot:
                    style @S
                    text @S align (0.5, 0.5) style @S
                    action FilePage(page)

            imagebutton at saveloadtab:
                idle @S
                yalign 0.5
                xpos 8
                action FilePageNext()

