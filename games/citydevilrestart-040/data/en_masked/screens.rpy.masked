init offset = -1



style default:
    properties gui.text_properties()
    language gui.language
    outlines [(absolute(1), @S, absolute(1), absolute(1))]

style input:
    properties gui.text_properties(@S, accent=True)
    adjust_spacing False

style hyperlink_text:
    properties gui.text_properties(@S, accent=True)
    hover_underline True

style gui_text:
    properties gui.text_properties(@S)


style button:
    properties gui.button_properties(@S)

style button_text is gui_text:
    properties gui.text_properties(@S)
    yalign 0.5


style label_text is gui_text:
    properties gui.text_properties(@S, accent=True)

style prompt_text is gui_text:
    properties gui.text_properties(@S)


style bar:
    ysize gui.bar_size
    left_bar Frame(@S, gui.bar_borders, tile=gui.bar_tile)
    right_bar Frame(@S, gui.bar_borders, tile=gui.bar_tile)

style vbar:
    xsize gui.bar_size
    top_bar Frame(@S, gui.vbar_borders, tile=gui.bar_tile)
    bottom_bar Frame(@S, gui.vbar_borders, tile=gui.bar_tile)

style scrollbar:
    ysize gui.scrollbar_size
    base_bar Frame(@S, gui.scrollbar_borders, tile=gui.scrollbar_tile)
    thumb Frame(@S, gui.scrollbar_borders, tile=gui.scrollbar_tile)

style vscrollbar:
    xsize gui.scrollbar_size
    base_bar Frame(@S, gui.vscrollbar_borders, tile=gui.scrollbar_tile)
    thumb Frame(@S, gui.vscrollbar_borders, tile=gui.scrollbar_tile)

style slider:
    ysize gui.slider_size
    base_bar Frame(@S, gui.slider_borders, tile=gui.slider_tile)
    thumb @S

style vslider:
    xsize gui.slider_size
    base_bar Frame(@S, gui.vslider_borders, tile=gui.slider_tile)
    thumb @S


style frame:
    padding gui.frame_borders.padding
    background Frame(@S, gui.frame_borders, tile=gui.frame_tile)





screen say(who, what):
    style_prefix @S

    window:
        id @S

        if who is not None:
            if not renpy.variant(@S):
                add SideImage() xalign 0.0 yalign 1.0
            background Image(@S, xalign=0.0, yalign=1.0)
            if renpy.variant(@S):
                add SideImage() xalign 0.0 yalign 1.085
                background Image(@S, xalign=0.0, yalign=1.0)
            window:
                id @S
                style @S
                text who id @S

        text what id @S

    
    
    





            
            
    
    if skip_dialogue == True:
        imagebutton:
            at alpha_dissolve
            focus_mask True
            idle @S
            hover @S
            hover_sound @S
            activate_sound @S
            action [SetVariable(@S, None), Jump(skip_dialogue_label)]


init python:
    config.character_id_prefixes.append(@Q)

style window is default
style say_label is default
style say_dialogue is default
style say_thought is say_dialogue

style namebox is default
style namebox_label is say_label


style window:
    xalign 0.5
    xfill True
    yalign gui.textbox_yalign
    ysize gui.textbox_height

    

style namebox:
    xpos gui.name_xpos
    xanchor gui.name_xalign
    xsize gui.namebox_width
    ypos gui.name_ypos
    ysize gui.namebox_height

    
    padding gui.namebox_borders.padding

style say_label:
    properties gui.text_properties(@S, accent=True)
    xalign gui.name_xalign
    yalign 0.5

style say_dialogue:
    properties gui.text_properties(@S)

    xpos gui.dialogue_xpos
    xsize gui.dialogue_width
    ypos gui.dialogue_ypos

    adjust_spacing False



screen input(prompt):
    style_prefix @S

    window:

        vbox:
            xanchor gui.dialogue_text_xalign
            xpos gui.dialogue_xpos
            xsize gui.dialogue_width
            ypos gui.dialogue_ypos

            text prompt style @S
            input id @S

style input_prompt is default

style input_prompt:
    xalign gui.dialogue_text_xalign
    properties gui.text_properties(@S)

style input:
    xalign gui.dialogue_text_xalign
    xmaximum gui.dialogue_width






screen countdown:
    
    timer 0.01 repeat True action If(timez > 0, true=SetVariable(@Q, timez - 0.01), false=[Hide(@Q), Jump(timer_jump)])
    bar:
        xsize 700
        ysize 10
        xalign 0.5
        yalign 0.1
        at alpha_dissolve
        value AnimatedValue(value=timez, range=timer_range, delay=1.0)

transform choice_dissolve:
    alpha 0
    linear 0.3 alpha 1
    on hide:
        alpha 1
        linear 0.3 alpha 0

transform rs_notify:
    subpixel True
    yanchor 0.5
    xalign 0.5
    ypos -82
    alpha 0.0
    ease 0.6 ypos 82 alpha 1.0
    on idle:
        ease .3 zoom 1.0 matrixcolor TintMatrix(@S) * BrightnessMatrix(0.0)
    on hover:
        ease .2 zoom 1.03 matrixcolor TintMatrix(@S) * BrightnessMatrix(0.15)
    on hide:
        ease .3 zoom 1.0 alpha 0 ypos -82 matrixcolor TintMatrix(@S) * BrightnessMatrix(0.0)

