    imagebutton idle @S hover @S focus_mask True hover_sound @S action ShowMenu(@S) activate_sound @S
    imagebutton idle @S hover @S focus_mask True hover_sound @S action ShowMenu(@S) activate_sound @S
    imagebutton idle @S hover @S focus_mask True hover_sound @S action Quit(confirm=not main_menu) activate_sound @S
    
    
