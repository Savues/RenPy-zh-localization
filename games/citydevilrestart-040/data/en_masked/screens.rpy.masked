    xalign 0.5








screen help():

    tag menu

    default device = @S

    use game_menu(_(@S), scroll=@S):

        style_prefix @S

        vbox:
            spacing 23

            hbox:

                textbutton _(@S) action SetScreenVariable(@S, @S)
                textbutton _(@S) action SetScreenVariable(@S, @S)

                if GamepadExists():
                    textbutton _(@S) action SetScreenVariable(@S, @S)

            if device == @S:
                use keyboard_help
            elif device == @S:
                use mouse_help
            elif device == @S:
                use gamepad_help


