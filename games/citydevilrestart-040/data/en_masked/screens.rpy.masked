screen navigation():
    tag nav_screen
    on @S action Function(renpy.show_layer_at, with_Blur, layer=@S)
    on @S action Function(renpy.show_layer_at, no_Blur, layer=@S)
    if main_menu:
        imagebutton idle @S hover @S focus_mask True hover_sound @S action Return() activate_sound @S at rs_return
    else:
        add @Q at nav_menu
        imagebutton idle @S hover @S focus_mask True hover_sound @S action Return() activate_sound @S at rs_return
        imagebutton auto @S hover_sound @S action ShowMenu(@Q) activate_sound @S at nav_rs
        imagebutton auto @S  hover_sound @S action ShowMenu(@Q) activate_sound @S at nav_gallery
        imagebutton auto @S hover_sound @S action ShowMenu(@S) activate_sound @S at nav_save
        imagebutton auto @S hover_sound @S action ShowMenu(@S) activate_sound @S at nav_load
        imagebutton auto @S hover_sound @S action ShowMenu(@S) activate_sound @S at nav_options
        
        imagebutton auto @S hover_sound @S action MainMenu() activate_sound @S at nav_main
        imagebutton auto @S hover_sound @S action Quit(confirm=not main_menu) activate_sound @S at nav_quit
    
  


