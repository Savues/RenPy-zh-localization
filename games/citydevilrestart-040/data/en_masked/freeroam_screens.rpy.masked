


screen home_night_free_1_floor:
    imagebutton idle @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S at just_bright
    imagebutton idle @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S at just_bright


screen home_night_free_livingroom:
    if home_night_free_living_room_with_may and home_night_free_living_room_with_may_covered == True:
    
        
        imagebutton auto @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S
        
    elif home_night_free_living_room_with_may == True:
    
        imagebutton auto @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S
        imagebutton auto @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S
        imagebutton auto @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S
        
    else:
        imagebutton auto @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S
        imagebutton auto @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S
        
    imagebutton idle @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S at leave_right:
        ypos 140
        xpos 1520


screen home_night_free_livingroom_phone:
    add @S at game_help
    imagebutton auto @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S at choice_sex_leave:
        ypos 860
        xpos 100
        
    vbox:
        spacing 0
        xpos 806 
        ypos 298 
        ysize 3293 
        xsize 298 
        viewport:
            yfill False
            xfill False
            draggable True
            ysize 502 
            xsize 298
            
            hbox:
            
                button:
                    
                    yanchor 1
                    xysize (270, 3293)
                    xpos 14
                    
                    foreground @S
                    

