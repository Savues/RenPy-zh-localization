screen girls_may:
    tag menu
    modal True
    zorder 3
    
    if love_may >= 100:
        add @Q at rs_bg_dissolve
    elif love_may >= 45:
        add @Q at rs_bg_dissolve
    else:
        add @Q at rs_bg_dissolve


    imagebutton auto @S focus_mask True xpos 70 ypos 220 hover_sound @S action[Hide(@S), Hide(@S), Show(@S)] activate_sound @S at rs_icon:
        sensitive nao_unlock == 1
        
    imagebutton idle @S focus_mask True xpos 70 ypos 420 hover_sound @S action Show(@S) activate_sound @S at rs_icon:
        sensitive may_unlock == 1

    imagebutton auto @S focus_mask True xpos 70 ypos 620 hover_sound @S action[Hide(@S), Hide(@S), Show(@S)] activate_sound @S at rs_icon:
        sensitive lillian_unlock == 1



    add @Q at alpha_dissolve
