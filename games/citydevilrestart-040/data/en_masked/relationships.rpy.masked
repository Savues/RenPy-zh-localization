screen girls_menu:
    tag menu
    add @Q at alpha_dissolve
    add @Q at alpha_dissolve
    
    modal True
    zorder 2
    
    imagebutton idle @S hover @S focus_mask True hover_sound @S action Return() activate_sound @S at rs_return_nav
    
    imagebutton auto @S hover_sound @S action Show(@S) activate_sound @S at bright_button_main
    imagebutton auto @S hover_sound @S action Show(@S) activate_sound @S at bright_button_others
    
    
    imagebutton auto @S focus_mask True hover_sound @S action Show(@S) activate_sound @S at rs_button_may:
        sensitive may_unlock == 1
        
    imagebutton auto @S focus_mask True hover_sound @S action Show(@S) activate_sound @S at rs_button_lillian:
            sensitive lillian_unlock == 1
        
    imagebutton auto @S focus_mask True hover_sound @S action Show(@S) activate_sound @S at rs_button_minami:
        sensitive minami_unlock == 1
        
    imagebutton auto @S focus_mask True hover_sound @S action Show(@S) activate_sound @S at rs_button_izumi:
        sensitive izumi_unlock == 1

    imagebutton auto @S focus_mask True hover_sound @S action Show(@S) activate_sound @S at rs_button_asami:
        sensitive asami_unlock == 1

    imagebutton auto @S focus_mask True hover_sound @S action Show(@S) activate_sound @S at rs_button_nao:
        sensitive nao_unlock == 1     



screen girls_menu_others:
    tag menu
    add @Q at alpha_dissolve
    add @Q at alpha_dissolve
    add @Q at others_bright
    
    modal True
    zorder 2
    
    imagebutton idle @S hover @S focus_mask True hover_sound @S action Return() activate_sound @S at rs_return_nav
    
    imagebutton auto @S hover_sound @S action[Show(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S)] activate_sound @S at bright_button_main
    imagebutton auto @S hover_sound @S action Show(@S) activate_sound @S at bright_button_others
    
    
    
    hbox:
        spacing 0
        ypos 265
        xpos 92
        ysize 680
        xsize 450
        viewport id @S:
            yfill False
            xfill False
            draggable True
            mousewheel True
            at others_bright
            vbox:
                spacing 20
                hbox:
                    spacing 12
                    imagebutton auto @S focus_mask True hover_sound @S action[Show(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S)] activate_sound @S at others_bright:
                        sensitive leah_unlock == True
                    imagebutton auto @S focus_mask True hover_sound @S action[Hide(@S), Show(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S)] activate_sound @S at others_bright:
                        sensitive sophia_unlock == True
                    imagebutton auto @S focus_mask True  hover_sound @S action[Hide(@S), Hide(@S), Show(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S)] activate_sound @S at others_bright:
                        sensitive olivia_unlock == True
                hbox:
                    spacing 12
                    imagebutton auto @S focus_mask True hover_sound @S action[Hide(@S), Hide(@S), Hide(@S), Show(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S)] activate_sound @S at others_bright:
                        sensitive yumiko_unlock == True
                    imagebutton auto @S focus_mask True hover_sound @S action[Hide(@S), Hide(@S), Hide(@S), Hide(@S), Show(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S)] activate_sound @S at others_bright:
                        sensitive carmen_unlock == True
                    imagebutton auto @S focus_mask True hover_sound @S action[Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Show(@S), Hide(@S), Hide(@S), Hide(@S)] activate_sound @S at others_bright:
                        sensitive emma_unlock == True
                hbox:
                    spacing 12
                    imagebutton auto @S focus_mask True hover_sound @S action[Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Show(@S), Hide(@S), Hide(@S)] activate_sound @S at others_bright:
                        sensitive grace_unlock == True
                    imagebutton auto @S focus_mask True hover_sound @S action[Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Show(@S), Hide(@S)] activate_sound @S at others_bright:
                        sensitive chloe_unlock == True
                    imagebutton auto @S focus_mask True hover_sound @S action[Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Hide(@S), Show(@S)] activate_sound @S at others_bright:
                        sensitive scarlett_unlock == True
                hbox:
                    spacing 12
                    imagebutton auto @S focus_mask True  hover_sound @S  activate_sound @S at others_bright
                    imagebutton auto @S focus_mask True hover_sound @S  activate_sound @S at others_bright
                    imagebutton auto @S focus_mask True  hover_sound @S  activate_sound @S at others_bright
                hbox:
                    spacing 12
                    imagebutton auto @S focus_mask True hover_sound @S  activate_sound @S at others_bright
                    imagebutton auto @S focus_mask True hover_sound @S  activate_sound @S at others_bright
                    imagebutton auto @S focus_mask True  hover_sound @S  activate_sound @S at others_bright
                    
    hbox:
        ypos 265
        xpos 582
        ysize 680
        xsize 10
        vbar:
            xysize(6, 680)
            bottom_bar @S
            top_bar @S
            thumb @S
            value YScrollValue (@S)
            at others_bright
    
