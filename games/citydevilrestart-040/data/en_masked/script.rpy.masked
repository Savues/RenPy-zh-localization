label splashscreen:
    scene black
    pause 0.3
    play music mystic_horror_full
    show sabirowgames
    $renpy.pause(1.5, hard=True)
    pause 8
    pause 1
    hide sabirowgames with dissolve
    show adult_warning with dissolve
    pause 7
    hide adult_warning with dissolve
    pause 0.3
    show gamename
    pause 5
    stop music fadeout 0.3
    return



label start:
    $ quick_menu = False
    
    
    scene menu_transitions with Dissolve(0.3)
    $ renpy.pause(2.8, hard=True)
    show menu_gg with Dissolve(0.1)
    
    @Q with Dissolve(0.3)

    if _preferences.language == @Q:
        $ ggname = renpy.input(@Q, length=13, default=@Q).strip()
        if ggname == @Q:
            $ ggname = @Q
    elif _preferences.language == @Q:
        $ ggname = renpy.input(@Q, length=13, default=@Q, allow=@Q).strip()
        if ggname == @Q:
            $ ggname = @Q
    else:
        $ ggname = renpy.input(@Q, length=13, default=@Q, allow=@Q).strip()
