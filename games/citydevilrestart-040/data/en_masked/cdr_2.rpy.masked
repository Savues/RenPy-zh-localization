label outside_night:

    scene black with Dissolve(1.0)
    play music streetsback1 fadein 3 volume 1
    pause 1.5
    play sound zajigalka
    pause 0.5
    $ renpy.music.set_volume(0.6, delay=2, channel=u@Q)
    show outside_night_1 with Dissolve(0.5)
    $ renpy.pause(1.6,hard=True)
    play sound2 cigarette_burning_2 volume 0.3
    $ renpy.pause(2.4,hard=True)
    scene outside_night_2 with Dissolve(0.3)
    ka 3 @S with dissolve
    scene outside_night_3 with Dissolve(0.3)
    gg 9 @S with dissolve
    scene outside_night_4 with Dissolve(0.3)
    ka 3 @S with dissolve
    play sound cigarette_burning_1 volume 0.2
