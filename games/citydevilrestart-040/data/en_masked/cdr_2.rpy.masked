    play sound money_1 volume 0.5
    scene outside_night_30 with Dissolve(0.3)
    pause 2.0
    $ renpy.notify(@Q)
    $ aksha += 100
    play sound2 car_horn_1
    scene outside_night_31 with Dissolve(0.3)
