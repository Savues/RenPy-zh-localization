    gg 9 @S with dissolve
    scene outside_night_14 with Dissolve(0.3)
    ka 3 @S with dissolve
    scene outside_night_15 with Dissolve(0.3)
    gg 9 @S with dissolve
    stop music3 fadeout 5
    stop music fadeout 3
    play music2 streetsback1 fadein 3 volume 2
    $ renpy.music.set_volume(1, delay=2, channel=u@Q)
    scene outside_night_16 with Dissolve(0.3)
    ka 3 @S with dissolve
    scene outside_night_17 with Dissolve(0.3)
    ka 3 @S with dissolve
    show outside_night_18 with Dissolve(0.3)
    $ choice_var = 2
    $ outside_night_choice = []
    menu outside_night_choice: 
        set outside_night_choice
        @Q:
        
            gg 9 @S with dissolve
            scene outside_night_19 with Dissolve(0.3)
            ka 3 @S with dissolve
            show outside_night_18 with Dissolve(0.3)
            jump outside_night_choice

        @Q:

            gg 9 @S with dissolve
            scene outside_night_20 with Dissolve(0.3)
            ka 3 @S with dissolve
            show outside_night_18 with Dissolve(0.3)
            jump outside_night_choice

        @Q:

            gg 9 @S with dissolve
            gg 9 @S
            gg 9 @S
            scene outside_night_21 with Dissolve(0.3)
            ka 3 @S with dissolve
            scene outside_night_22 with Dissolve(0.3)
            ka 3 @S with dissolve
            show outside_night_18 with Dissolve(0.3)
            jump outside_night_choice
            
        @Q:
            gg 9 @S
            
    scene outside_night_23 with Dissolve(0.6)
    ka 3 @S with dissolve
    ka 3 @S
    ka 3 @S
    scene outside_night_24 with Dissolve(0.3)
    ka 3 @S with dissolve
    ka 3 @S
    scene outside_night_25 with Dissolve(0.3)
    gg 9 @S with dissolve
