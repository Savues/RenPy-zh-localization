label credits:
    play music lofi_sadness_by_ramol volume 0.7
    show end_ver with dissolve
    show end_credits:
        ypos 1080
        linear 80 ypos -11000
    pause 66
    scene black with dissolve
    stop music fadeout 1
    pause 1.0
    play music the_suspence_mainmenu fadein 1
    call screen extras
    return

screen end_patreon:
    modal True
    add @Q
    
    imagebutton auto @S focus_mask True hover_sound @S action OpenURL(@S) activate_sound @S
    imagebutton auto @S focus_mask True hover_sound @S action MainMenu() activate_sound @S
    imagebutton auto @S focus_mask True hover_sound @S action Quit(confirm=not main_menu) activate_sound @S
    


screen gallery_alexxis_olivia:
    tag menu
    modal True
    add @Q at alpha_dissolve
    add @S
    add @Q at alpha_dissolve
    
    imagebutton idle @S hover @S focus_mask True hover_sound @S action Return() activate_sound @S at rs_return
    
    imagebutton auto @S hover_sound @S action Jump(@S) activate_sound @S at gallery_choice_sex_1:
        sensitive persistent.gallery_olivia_unlock_1 == True
        ypos 300
        
    imagebutton auto @S hover_sound @S action Jump(@S) activate_sound @S at gallery_choice_sex_2:
        sensitive persistent.gallery_olivia_unlock_2 == True
        ypos 520
        
    imagebutton auto @S hover_sound @S action Jump(@S) activate_sound @S at gallery_choice_sex_3:
        sensitive persistent.gallery_olivia_unlock_3 == True
        ypos 740
        
