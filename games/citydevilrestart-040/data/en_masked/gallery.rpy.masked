screen gallery_list_all:
    modal True
    zorder 2
    tag menu
    add @Q at alpha_dissolve
    add @Q at alpha_dissolve
    imagebutton idle @S hover @S focus_mask True hover_sound @S action Return() activate_sound @S at rs_return_nav

    
    vbox:
        anchor (1, 1)
        spacing 0
        ypos 140
        ysize 1080
        xsize 2250
        viewport:
            edgescroll (500, 1000)
            area 0,0,2000,1080
            yfill False
            xfill False
            draggable True
            
            ysize 1080
            xsize 1920
            
            hbox:
                spacing 40
            
                
                button at gallery_button_1:
                    
                    anchor (0.5, 0.5)
                    xysize (390, 660)
                    ypos 400
                    hover_background @S
                    background @S
                    insensitive_background @S
                    
                    if persistent.gallery_olivia_unlock_1 == True:
                        foreground @S
                    
                    sensitive persistent.gallery_olivia_unlock_1 == True
                    
                    hover_sound @S
                    activate_sound @S

                    action ShowMenu(@S)
                    
                
                button at gallery_button_2:
                    
                    anchor (0.5, 0.5)
                    xysize (390, 660)
                    ypos 400
                    hover_background @S
                    background @S
                    insensitive_background @S
                    
                    if persistent.gallery_yumiko_unlock_1 == True:
                        foreground @S
                    
                    sensitive persistent.gallery_yumiko_unlock_1 == True
                    
                    hover_sound @S
                    activate_sound @S

                    
                    action ShowMenu(@S)
                    
                        
                button at gallery_button_3:
                    
                    anchor (0.5, 0.5)
                    xysize (390, 660)
                    ypos 400
                    
                    hover_background @S
                    background @S 
                    insensitive_background @S
                    
                    if persistent.gallery_lillian == True:
                        foreground @S
                    
                    sensitive persistent.gallery_lillian == True
                    
                    hover_sound @S
                    activate_sound @S

                    action ShowMenu(@S)
                    
                
                button at gallery_button_4:
                    
                    anchor (0.5, 0.5)
                    xysize (390, 660)
                    ypos 400
                    hover_background @S
                    background @S
                    insensitive_background @S
                    
                    if persistent.gallery_grace_unlock_1 == True:
                        foreground @S
                    
                    sensitive persistent.gallery_grace_unlock_1 == True
                    
                    hover_sound @S
                    activate_sound @S

                    
                    action ShowMenu(@S)
                    
                
                button at gallery_button_5:
                    
                    anchor (0.5, 0.5)
                    xysize (390, 660)
                    ypos 400
                    hover_background @S
                    background @S
                    insensitive_background @S
                    
                    if persistent.gallery_emma_unlock_1 == True:
                        foreground @S
                    
                    sensitive persistent.gallery_emma_unlock_1 == True
                    
                    hover_sound @S
                    activate_sound @S

                    
                    action ShowMenu(@S)
                    
                
                
                button at gallery_button_6:
                
                    anchor (0.5, 0.5)
                    xysize (390, 660)
                    ypos 400
                    
                    hover_background @S
                    background @S 
                    insensitive_background @S
                    
                    if persistent.gallery_de1_lillian == True:
                        foreground @S
                    
                    sensitive persistent.gallery_de1_lillian == True
                    
                    hover_sound @S
                    activate_sound @S

                    action ShowMenu(@S)
                
                
                
                button at gallery_button_7:
                    
                    anchor (0.5, 0.5)
                    xysize (390, 660)
                    ypos 400
                    background @S

    imagebutton:
        
        idle @S
        hover_sound @S
        activate_sound @S
        at choice_bright
        xpos 1520
        ypos 54
        
        action ToggleFocus(@Q)
 
    nearrect:
        
        focus @S
        has vbox at gallery_list_buttons
        dismiss action ClearFocus(@S)
        
        imagebutton idle @S action [ShowMenu(@Q), ClearFocus(@S)] hover_sound @S activate_sound @S at choice_bright
        imagebutton idle @S action [ShowMenu(@Q), ClearFocus(@S)] hover_sound @S activate_sound @S at choice_bright
        imagebutton idle @S action [ShowMenu(@Q), ClearFocus(@S)] hover_sound @S activate_sound @S at choice_bright



