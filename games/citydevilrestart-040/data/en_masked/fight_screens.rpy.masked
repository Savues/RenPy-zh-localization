screen izumi_pawnshop_choice_dom_sub:
    add @S at alpha_dissolve
    
    imagebutton idle @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S at date_choice_button_1
    imagebutton idle @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S at date_choice_button_2

screen date_event_1_choice_day:
    add @S at alpha_dissolve
    add @S at date_choice_line_1
    add @S at date_choice_line_2
    add @S at date_choice_line_3
    
    add @S at date_choice_title 
    if date_event_1_day == 1:
        add @S at date_choice_title 
    else:
        add @S at date_choice_title

    

    if date_event_1_may == True:
        imagebutton idle @S action () at date_choice_button_1
    elif date_event_1_after_minami == True:
        imagebutton idle @S action () at date_choice_button_1
    else:
        imagebutton idle @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S at date_choice_button_1
            
    

    if date_event_1_minami == True:
        imagebutton idle @S action () at date_choice_button_2
    else:
        imagebutton idle @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S at date_choice_button_2
            
    

    if date_event_1_lillian == True:
        imagebutton idle @S action () at date_choice_button_3
    else:
        imagebutton idle @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S at date_choice_button_3
            
    imagebutton idle @S focus_mask True hover_sound @S action Jump(@Q) activate_sound @S at date_choice_nextday
    
