screen school_roof_boi_1():
    zorder 2
    imagebutton:
        xalign 0.2
        yalign 0.7
        at alpha_dissolve
        focus_mask True
        idle @Q
        hover @Q 
        action [Hide(@Q), Play(@Q, @Q), Jump(@Q)]
    
screen school_roof_boi_2():
    zorder 2
    imagebutton:
        xalign 0.85
        yalign 0.2
        at alpha_dissolve
        focus_mask True
        idle @Q
        hover @Q
        action [Hide(@Q), Play(@Q, @Q), Jump(@Q)]


