init:
    $ timer_range = 0
    $ timer_jump = 0
    $ timez = 0
    
    $ timeout = 0
    $ timeout_label = None
    
    $ skip_dialogue_label = None 


transform alpha_dissolve:
    alpha 0.0
    linear 0.5 alpha 1.0
    on hide:
        linear 0.5 alpha 0
        
transform rs_dissolve:
    top
    alpha 0.0
    ypos 100
    zoom 1.5
    ease 0.6 ypos 0 zoom 1 alpha 1.0
    on hide:
        ease 0.5 ypos -100 zoom 1.5 alpha 0
        
transform rs_bg_dissolve:
    top
    alpha 0
    zoom 1.5
    ease 0.5 ypos 0 zoom 1.0 alpha 1.0
    on hide:
        ease 0.5 zoom 1.5 alpha 0
        