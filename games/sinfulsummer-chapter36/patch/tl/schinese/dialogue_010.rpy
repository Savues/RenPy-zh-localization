translate schinese hscene28_Erik_Lyna_Helga_b51768e1:
    centered "{font=font_narration}{size=+10}{cps=20}几分钟后……"

translate schinese hscene28_Erik_Lyna_Helga_fbc1d8ba:
    l "嗯哼！"

translate schinese hscene28_Erik_Lyna_Helga_15368943:
    h "哦！嗨，亲爱的……"

translate schinese hscene28_Erik_Lyna_Helga_69238027:
