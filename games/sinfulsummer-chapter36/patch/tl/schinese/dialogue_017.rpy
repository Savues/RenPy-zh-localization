translate schinese story60_Erik_Lyna_Helga_c77acb7b:
    centered "{font=font_narration}{cps=25}{color=#f1b500}我相信了她。{w=0.5}天啊，{w=0.3}我每一个字都信了。"

translate schinese story60_Erik_Lyna_Helga_6d5f6481:
    centered "{font=font_narration}{cps=25}{color=#f1b500}我享受其中，{w=0.3}莱娜。{w=0.5}我太享受了。"

translate schinese story60_Erik_Lyna_Helga_018a329b:
