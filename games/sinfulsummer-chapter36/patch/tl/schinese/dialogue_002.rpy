translate schinese story20_Erik_Lyna_6afb2449:
    h "{size=-5}哎呀宝贝，这种事永远不用谢我。"

translate schinese story20_Erik_Lyna_4ae2ca5c:
    h "{size=-5}现在去让你哥哥好起来吧，好吗？"

translate schinese story20_Erik_Lyna_f3dc53ab:
