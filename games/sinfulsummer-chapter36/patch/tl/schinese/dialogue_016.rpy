translate schinese hscene47_Erik_Lyna_Helga_4a1c2cf0:
    l "等等，什么？为什么？"

translate schinese hscene47_Erik_Lyna_Helga_ac25bbd2:
    h "因为我要脱掉我的胸罩……"

translate schinese hscene47_Erik_Lyna_Helga_034f49dc:
