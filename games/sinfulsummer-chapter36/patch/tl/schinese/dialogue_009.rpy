translate schinese hscene24_Erik_Lyna_Helga_5d27c5c9:
    centered "{font=font_narration}{cps=20}{color=#69d9fe}( 我的双胞胎哥哥……{w=0.5}我亲生的妈妈…… )"

translate schinese hscene24_Erik_Lyna_Helga_70d77ae4:
    h "告诉我，我的儿子……"

translate schinese hscene24_Erik_Lyna_Helga_87b1dc85:
    h "你以前见过女人的身体吗？*打嗝*{size=-5}我是说，认真地看。"

translate schinese hscene24_Erik_Lyna_Helga_0d35af17:
