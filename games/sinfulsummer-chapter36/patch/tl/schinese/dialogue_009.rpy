translate schinese hscene24_Erik_Lyna_Helga_725cb357:
    e "你的私密部位，妈妈！"

translate schinese hscene24_Erik_Lyna_Helga_8510d749:
    h "哦，对哦！嘿嘿~"

translate schinese hscene24_Erik_Lyna_Helga_83ddb42e:
