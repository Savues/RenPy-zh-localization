translate schinese story47_Lyna_Helga_daef38b6:
    l "{size=+10}出发咯，我可靠的战车！" with vpunch

translate schinese story47_Lyna_Helga_42910efd:
    h "{size=-5}喂！别这么开，这可是租来的车！"

translate schinese story47_Lyna_Helga_0c1e14e6:
