    # a "[mc], are you sure about this?"
    a "[mc]，你确定吗？"

translate schinese magicWorldEnd_056282b1:

    # mc "Yes, I'm sure."
    mc "是的，我确定。"

translate schinese magicWorldEnd_8019ebd4:

    # magd "..."
    magd "……"

