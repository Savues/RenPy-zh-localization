translate schinese before_arena_7959a7cd:

    # mc "N-no problem."
    mc "不、不客气。"

translate schinese before_arena_43becb38:

    # mc "(Now I kinda feel bad. I hope she never finds out that the cyberpunk world wasn't all that safe...)"
