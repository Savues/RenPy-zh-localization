    v "{sc=1}这到底是怎么回事？！这怎么可能？！" with vpunch

translate schinese vanessa_portal_caba5bbb:

    # mc "Trust me, I'd like to know too. I just can do it. I only found out about it recently."
    mc "相信我，我也想知道。我只是能做到而已。我也是最近才发现的。"

translate schinese vanessa_portal_9e978f1a:

    # v "Oh my god... it's too much... it's just too much..."
    v "天哪……太过分了……实在太过分了……"

translate schinese vanessa_portal_5a62642d:

    # a "Mom, calm down, please. You don't have to worry about it."
    a "妈，冷静点，求你了。你不用担心。"

translate schinese vanessa_portal_919d481d:

    # k "She's right, Mom. It has nothing to do with you."
    k "她说得对，妈。这跟你没关系。"

translate schinese vanessa_portal_7c4d562b:

    # v "Nothing to do... nothing to do with me..."
    v "跟我没关系……跟我没关系……"

translate schinese vanessa_portal_f9d0d36a:

    # v "Do you even hear yourself?"
    v "你听听自己在说什么？"

translate schinese vanessa_portal_c41ed6c5:

    # v "{b}I am{/b} your mother."
    v "{b}我{/b}是你们妈妈。"

translate schinese vanessa_portal_a25eae6d:

    # v "You girls are the most important people in my life. You mean the world to me."
    v "你们是我生命中最重要的人。你们对我意义重大。"

translate schinese vanessa_portal_a9987bc7:

    # v "I don't know what I'd do with myself if I found out something happened to you."
    v "要是知道你们出了什么事，我不知道自己会怎样。"

translate schinese vanessa_portal_1eb6001e:

    # v "{sc=1}{i}And now{/i} I'm finding out that you're just casually visiting other... worlds?!"
    v "{sc=1}{i}而现在{/i}，我发现你们只是在随随便便地去别的……世界？！"

translate schinese vanessa_portal_1aa392a9:

    # k "Well..."
    k "嗯……"

translate schinese vanessa_portal_bb8e4b4e_1:

    # a "..."
    a "……"

translate schinese vanessa_portal_2bab0a58:

    # v "What even are these worlds? Where the hell have you guys been?"
    v "这些世界到底是什么？你们到底去了哪儿？"

translate schinese vanessa_portal_5d215326:

    # mc "There are all kinds of places. Right now we came back from a cyberpunk world."
    mc "各种各样的地方都有。我们刚从一个赛博朋克世界回来。"

translate schinese vanessa_portal_54d7cce0:

    # v "Cyberpunk? You mean that place with advanced technology, robots and people with electronic body parts? Something like that?"
    v "赛博朋克？你是说那个有先进科技、机器人和电子义体的人的地方？类似那种？"

translate schinese vanessa_portal_7d12b9be:

    # k "Wait, you know it?"
    k "等等，你知道？"

translate schinese vanessa_portal_5fb28166:

    # v "Of course I do. It's pretty popular, I think. I've read about it in books."
    v "当然知道。这个挺有名的吧。我在书里读到过。"

translate schinese vanessa_portal_9e52a3fe:

    # k "Damn, even my Mom knows about cyberpunk? I feel stupid now."
    k "靠，连我妈都知道赛博朋克？我现在觉得自己好蠢。"

translate schinese vanessa_portal_0c719968:

    # v "By the way, can you finally get up? I never even told you to kneel."
    v "话说回来，你们能起来了吗？我可从没说让你们跪着。"

translate schinese vanessa_portal_d3f04867:

    # mc "Right, ugh... We just thought this would show our remorse."
    mc "对，呃……我们只是觉得这样能表示歉意。"

translate schinese vanessa_portal_74068c84:

    # a "Ugh, my legs hurt. I'm not used to this kind of position."
    a "呃，我腿好痛。我不习惯这个姿势。"

translate schinese vanessa_portal_000dd9b8:

    # mc "At least your spine is in one piece."
    mc "至少你的脊椎还是完整的。"

translate schinese vanessa_portal_6e8ee7bc:

    # mc "Thanks girls for that landing. It was spectacular."
    mc "谢谢你们降落的表演。真是精彩绝伦。"

translate schinese vanessa_portal_07883192:

    # r "This is your fault. You could've taken us home right away instead of dragging us through different worlds and then making us jump."
    r "这都是你的错。你本来可以直接带我们回家的，而不是拖着我们穿过一个又一个世界，然后还让我们跳。"

translate schinese vanessa_portal_1e1360ad:

    # mc "Yeah, yeah, I'm sorry. I panicked."
    mc "好吧好吧，对不起。我慌了。"

translate schinese vanessa_portal_75a0fb5e:

    # v "Ahem!"
    v "咳！"

translate schinese vanessa_portal_290ede9e:

    # v "Don't you think you're getting a little too comfortable? Just reminding you that you still owe me a better explanation."
    v "你们是不是有点太安逸了？提醒一下，你还欠我一个更好的解释。"

translate schinese vanessa_portal_4cd4255b:

    # v "And that I'm still mad at you."
    v "还有，我还在生你的气。"

translate schinese vanessa_portal_2affa0d3:

    # mc "You're right, I'm sorry."
    mc "你说得对，对不起。"

translate schinese vanessa_portal_c7d94962:

    # mc "What else would you like to know? I'll tell you everything."
    mc "你还想知道什么？我全都告诉你。"

translate schinese vanessa_portal_3298db87:

    # v "What do you guys do in those worlds? How many have you visited? And why are you even doing this?"
    v "你们在那些世界里做什么？去过多少个？还有，你们为什么要做这种事？"

translate schinese vanessa_portal_afcaf6ec:

    # mc "We've only been in two worlds. I mean... all five of us have only been in two."
    mc "我们只去过两个世界。我是说……我们五个都只去过两个。"

translate schinese vanessa_portal_da10a2e1:

    # mc "I've visited more, but just for a short time."
    mc "我倒是去过更多，不过都只是待一小会儿。"

translate schinese vanessa_portal_07b7c9ed:

    # mc "And what do we do there? Hmmm..."
    mc "那我们在那里做什么？嗯……"

translate schinese vanessa_portal_f5f553ab:

    # mc "(I can't tell her that we're dealing with gangs and other dangerous people...)"
    mc "（我不能告诉她我们在跟黑帮和其他危险人物打交道……）"

translate schinese vanessa_portal_51dedf64:

    # mc "Well, mostly... we're just exploring, right, guys?"
    mc "嗯，大多时候……我们就是在逛来逛去，对吧，伙计们？"

translate schinese vanessa_portal_999cdb15:

    # k "Yeah, that's all we do."
    k "对，我们就是闲逛。"

translate schinese vanessa_portal_4a54a9f4:

    # a "It's just like a trip to another country. Nothing unusual."
    a "就跟去别的国家旅游一样。没什么特别的。"

translate schinese vanessa_portal_449facd7:

    # v "This is not like a trip to another country, Alice! Don't make me more mad."
    v "这跟去别的国家旅游不一样，爱丽丝！别让我更生气。"

translate schinese vanessa_portal_5f24b495:

    # v "It can be extremely dangerous! Are you kids out of your minds?"
    v "那可能非常危险！你们这些孩子是不是脑子有问题？"

translate schinese vanessa_portal_405f74e4:

    # v "What if something happened to you?!"
    v "万一你们出了什么事怎么办？！"

translate schinese vanessa_portal_7bc71884:

    # mc "D-Don't worry. It's not dangerous. We're not visiting any dangerous places."
    mc "别、别担心。不危险。我们不会去危险的地方。"

translate schinese vanessa_portal_2e304593:

    # ch "Exactly. Nobody's shooting at us or anything like that, right guys?"
    ch "就是说。没人朝我们开枪之类的事，对吧，伙计们？"

translate schinese vanessa_portal_f508abda:

    # ch "Ow!"
    ch "哎哟！"

translate schinese vanessa_portal_6f31fa46:

    # k "Y-yeah, just like he said."
    k "对、对，就像他说的。"

translate schinese vanessa_portal_5243adac:

    # mc "It's a hundred percent safe. I assure you."
    mc "百分之百安全。我向你保证。"

translate schinese vanessa_portal_65cabcbf_1:

    # v "..."
    v "……"

translate schinese vanessa_portal_31251bba:

    # v "{i}*Sigh...*{/i} Oh my god. This makes no sense at all."
    v "{i}*叹气……*{/i} 天哪。这完全说不通。"

translate schinese vanessa_portal_60e85cb5:

    # v "Portals and other worlds... Fuck... This is like some kind of fantasy story."
    v "传送门，还有其他世界……靠……这就像什么奇幻故事。"

translate schinese vanessa_portal_103be0af:

    # v "What am I supposed to do with you guys now? Should we report this somewhere?"
    v "你们这样，我到底该怎么办？要不要把这事上报？"

translate schinese vanessa_portal_64369f3a:

    # a "{sc=1}What?! No!"
    a "{sc=1}什么？！不要！"

translate schinese vanessa_portal_08609164:

    # k "{sc=1}Mom, no! That's the worst idea ever!"
    k "{sc=1}妈，不行！这是最糟糕的主意！"

translate schinese vanessa_portal_b4b7ff6c:

    # v "But this is insane! Have you ever heard of a person who opens portals and visits other worlds?"
    v "但这太疯狂了！你听说过有人能打开传送门、去其他世界吗？"

translate schinese vanessa_portal_201321b3:

    # v "Someone needs to check him. See if everything's alright."
    v "总得有人去检查一下他。看看有没有问题。"

translate schinese vanessa_portal_ef7f4d6f:

    # a "He was just in the hospital recently. Dad said everything's fine."
    a "他前不久才住过院。爸说他一切都好。"

translate schinese vanessa_portal_3506fd99:

    # v "I know, but... but still!"
    v "我知道，可是……但还是！"

translate schinese vanessa_portal_5ff8f7f9:

    # k "Mom, please keep this to yourself. Don't tell anyone, not even dad."
    k "妈，请你保密。谁都别说，连爸都别说。"

translate schinese vanessa_portal_70d5b067:

    # mc "Yeah, I agree with the girls. We're not doing anything wrong, and I feel totally fine, so why would we report it to anyone?"
    mc "对，我同意她们。我们没做错什么，而且我感觉完全正常，凭什么要上报？"

translate schinese vanessa_portal_3460aace:

    # mc "Can I ask you to keep this to yourself, Vanessa? Please."
    mc "我能请你保密吗，瓦妮莎？拜托了。"

translate schinese vanessa_portal_7b36c724:

    # v "But... we have to do something."
    v "可是……我们总得做点什么。"

translate schinese vanessa_portal_c1cc06c4:

    # a "No, Mom. That's the whole point, we don't have to."
    a "不，妈。问题就在这儿，我们什么都不用做。"

translate schinese vanessa_portal_8b69a960:

    # k "Exactly. It's fine as it is."
    k "没错。就这样挺好的。"

translate schinese vanessa_portal_ee479e59:

    # v "No, Kate! It's not fine at all. How can you not understand it?"
    v "不，凯特！这样根本不行。你怎么能不明白？"

translate schinese vanessa_portal_cd2d0593:

    # r "Ahem!"
    r "咳！"

translate schinese vanessa_portal_b58beaac:

    # r "Sorry to interrupt, but reporting this anywhere really isn't a good idea."
    r "抱歉打断，不过把这件事上报真的不是个好主意。"

translate schinese vanessa_portal_d9f9ffbd:

    # r "Please take a moment to think about it."
    r "请你花点时间想想。"

translate schinese vanessa_portal_0976f5b7:

    # r "Let's say he goes for tests, and the doctors decide he's some kind of freak and report this case to some government institutions."
    r "假设他去接受检查，然后医生认定他是什么怪人，把这个案例上报给某些政府机构。"

translate schinese vanessa_portal_b42f1221:

    # r "He'll be considered a unique specimen and locked away in some cell, deep underground, for research purposes."
    r "他就会被当成特殊样本，锁在地下某个牢房里，供人研究。"

translate schinese vanessa_portal_421bb218:

    # r "In other words, he'll become a lab rat. A guinea pig."
    r "换句话说，他会变成实验鼠。一只豚鼠。"

translate schinese vanessa_portal_aca0bbae:

    # r "I'm sure you've read about stories like that in books or seen them in movies."
    r "我相信你在书里读到过、或在电影里看过这类故事。"

translate schinese vanessa_portal_50e0d3b2:

    # r "If that happens... well, you'd basically ruin his life."
    r "如果那种事发生了……那你基本上就毁了他的一生。"

translate schinese vanessa_portal_f0c1dd13:

    # v "What... what are you saying?"
    v "你……你这是什么意思？"

translate schinese vanessa_portal_b7e13f53:

    # r "I'm sorry for the harsh words, but we can't rule out that possibility."
    r "抱歉话说得这么重，但我们不能排除那种可能。"

translate schinese vanessa_portal_06ca2105:

    # r "It's definitely possible, right? Don't you think so, Ms. Bradford?"
    r "那完全有可能对吧？您不这么认为吗，布拉德福德女士？"

translate schinese vanessa_portal_391caacc:

    # mc "(Damn, Riley... Aren't you a bit too good at this?)"
    mc "（可恶，莱莉……你也太擅长这套了吧？）"

translate schinese vanessa_portal_65cabcbf_2:

    # v "..."
    v "……"

translate schinese vanessa_portal_1f69617d:

    # v "Y-yeah, I guess that's... possible."
    v "呃……好吧，我猜那是有可能的。"

translate schinese vanessa_portal_6de83ecf:

    # r "Precisely. Which is why we {i}can't{/i} tell anyone about it."
    r "正是。所以我们{i}不能{/i}告诉任何人。"

translate schinese vanessa_portal_197481fb:

    # v "Haaah... Dear god. I can't believe it."
    v "哈啊……天哪。我不敢相信。"

translate schinese vanessa_portal_ae58e5e7:

    # v "All right, I won't report it. You have my word."
    v "好吧，我不会上报。我向你们保证。"

translate schinese vanessa_portal_5e58f989:

    # a "{sc=1}{size=*1.3}Yes!"
    a "{sc=1}{size=*1.3}太好了！"

translate schinese vanessa_portal_bf77e4ac:

    # k "You're the best, Mom!"
    k "妈你最好啦！"

translate schinese vanessa_portal_ca3edfb1:

    # mc "Thank you, Vanessa."
    mc "谢谢你，瓦妮莎。"

translate schinese vanessa_portal_7739543b:

    # "{i}For a moment, she just looks at you, smiling warmly."
    "{i}有那么一会儿，她只是看着你，温暖地笑着。"

translate schinese vanessa_portal_efa3f48b:

    # v "But!"
    v "但是！"

translate schinese vanessa_portal_383d84cb:

    # v "I don't want you using that... power anymore. Do you understand?"
    v "我不想你再使用那种……力量了。明白吗？"

translate schinese vanessa_portal_5a452851:

    # v "You're forbidden from opening portals and going to other worlds. No matter how strange that sounds."
    v "我禁止你打开传送门、去其他世界。不管这听起来有多奇怪。"

translate schinese vanessa_portal_35f80b18:

    # a "But, Mom-!{p=0.5}{nw}"
    a "可是妈——！{p=0.5}{nw}"

translate schinese vanessa_portal_26e0d625:

    # k "Hush! It's fine, Alice."
    k "嘘！没事的，爱丽丝。"

translate schinese vanessa_portal_ea940769:

    # v "I don't want to hear about it ever again. If I find out you've done it one more time, my promise is off the table."
    v "我不想再听到任何这类事。要是被我发现你又做了一次，我的保证就作废。"

translate schinese vanessa_portal_bb89c6f8:

    # mc "Alright, I understand. We won't do it again."
    mc "好，我明白了。我们不会再做了。"

translate schinese vanessa_portal_50659eca:

    # v "Good. I'm glad to hear that."
    v "很好。听到这话我很高兴。"

translate schinese vanessa_portal_c7e35f8f:

    # v "Haaah... God, what a day."
    v "哈啊……天哪，今天真是够了。"

translate schinese vanessa_portal_e1a93887:

    # v "Well then, I know this wasn't the most pleasant first meeting, but I still don't know your friends."
    v "那么，我知道这次初次见面称不上愉快，但我还是不认识你的朋友们。"

translate schinese vanessa_portal_c4666fd3:

    # a "Oh, right. I never introduced her to you."
    a "哦，对。我都还没帮你介绍过她。"

translate schinese vanessa_portal_07d1a5ff:

    # a "Mom, this is Riley, my classmate and best friend. I've told you about her a few times."
    a "妈，这是莱莉，我的同学兼闺蜜。我跟你提过她好几次。"

translate schinese vanessa_portal_8f80ea98:

    # v "Ah, yes. I remember."
    v "啊，是的。我记得。"

translate schinese vanessa_portal_b4c4c099:

    # r "It's nice to meet you, Ms. Bradford."
    r "很高兴认识您，布拉德福德女士。"

translate schinese vanessa_portal_1f9d8d79:

    # mc "And this is-{p=0.7}{nw}"
    mc "这位是——{p=0.7}{nw}"

translate schinese vanessa_portal_41e38131:

    # ch "Hold on, [mc]. I have a tongue, I can introduce myself."
    ch "等一下，[mc]。我有嘴，我会自我介绍一下。"

translate schinese vanessa_portal_cbadd180:

    # mc "{i}*Sigh...*{/i} Just... be normal."
    mc "{i}*叹气……*{/i} 你……正常点。"

translate schinese vanessa_portal_b63f957a:

    # ch "Ahem!"
    ch "咳！"

translate schinese vanessa_portal_57ac0960:

    # ch "Madam!"
    ch "夫人！"

translate schinese vanessa_portal_3916faff:

    # ch "I'm a very good friend of [mc] and Alice. I go to the same school, and we're in the same class."
    ch "我是[mc]和爱丽丝的好朋友。我们在同所学校，同一个班。"

translate schinese vanessa_portal_848d14f5:

    # ch "It's truly a pleasure to finally meet you. I have to say, I'm honestly stunned by your beauty."
    ch "终于见到您真是我的荣幸。说实话，我被您的美貌震惊了。"

translate schinese vanessa_portal_1bc3351e:

    # ch "Ow..."
    ch "哎……"

translate schinese vanessa_portal_66edc634:

    # ch "Well, maybe our friendship isn't that good."
    ch "呃……看来我们的友谊没那么铁。"

translate schinese vanessa_portal_8f0b9ef9:

    # ch "Anyway, my name's Chad."
    ch "总之，我叫查德。"

translate schinese vanessa_portal_e5c61b02:

    # ch "That's what most people call me, but you... you can call me..."
    ch "大多数人都这么叫我，不过你……你可以叫我……"

translate schinese vanessa_portal_025ef619:

    # ch "Giga-{p=0.3}{nw}"
    ch "吉——{p=0.3}{nw}"

translate schinese vanessa_portal_d2c74134:

    # mc "{sc=1}{size=*1.3}SHUT UUUUUUUUP!!!"
    mc "{sc=1}{size=*1.3}闭嘴————————！！！"

translate schinese vanessa_portal_60aeee43:

    # mc "Ahem... just call him Chad."
    mc "咳……就叫他查德吧。"

translate schinese vanessa_portal_29270284:

    # a "Yeah, and ignore his stupidity."
    a "对，还有别理他的蠢话。"

translate schinese vanessa_portal_39132c40:

    # ch "Tch, Alice sweetie, can you stop poking me with a stick?"
    ch "啧，小爱丽丝，能不能别拿棍子戳我？"

translate schinese vanessa_portal_0d74897e:

    # a "No. That's your punishment."
    a "不能。这就是你的惩罚。"

translate schinese vanessa_portal_57b9f27e:

    # k "{i}*Laughing*{/i} He's kinda funny, don't you think?"
    k "{i}*笑出声*{/i} 他还挺好笑的，不是吗？"

translate schinese vanessa_portal_5833ebbf:

    # v "{i}*Laughing*{/i} Yeah, kind of."
    v "{i}*笑出声*{/i} 嗯，还算有点。"

translate schinese vanessa_portal_f05ee23f:

    # ch "Awww, my two angels. I love you."
    ch "啊啊啊，我的两个小天使。我爱你们。"

translate schinese vanessa_portal_6e16dd09:

    # a "Oh my god."
    a "天哪。"

translate schinese vanessa_portal_d770fcb0:

    # a "Like mother like daughter."
    a "果然是有其母必有其女。"

translate schinese vanessa_portal_64a5eaf6:

    # r "Aren't you her daughter, too?"
    r "你不也是她的女儿吗？"

translate schinese vanessa_portal_423e5563:

    # a "Sometimes I feel like I'm adopted."
    a "有时候我都觉得自己像是领养的。"

translate schinese vanessa_portal_45316bd7:

    # v "It's really nice to meet you two. I hope you'll get along with my kids."
    v "很高兴认识你们两个。希望你们能和我家孩子们好好相处。"

translate schinese vanessa_portal_e76d4e22:

    # ch "Of course, ma'am."
    ch "当然，夫人。"

translate schinese vanessa_portal_7f05d362:

    # v "By the way, you have some really nice clothes."
    v "话说回来，你的衣服真好看。"

translate schinese vanessa_portal_09320049:

    # k "Right? I chose them."
    k "对吧？是我挑的。"

translate schinese vanessa_portal_d2bb1774:

    # v "Honestly, I'd love to try on something like that, too."
    v "说实话，我也好想试试那种衣服。"

translate schinese vanessa_portal_7f92a66a:

    # k "I can look for something for you. No problem."
