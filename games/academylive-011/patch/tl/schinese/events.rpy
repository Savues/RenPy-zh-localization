# game/events.rpy:12167
translate schinese ayumi_soushi_00_5b8ca91a:

    # mc "Let me guess...{w} It's because of that friend of yours? She owes [sou] as well, right?" with d
    mc "让我猜猜……{w} 是因为你那个朋友吧？她也欠[sou]，对吧？" with d

# game/events.rpy:12170
translate schinese ayumi_soushi_00_d2461468:

    # ay "...Yes." with d
    ay "……对。" with d

# game/events.rpy:12171
translate schinese ayumi_soushi_00_e2e82861:

    # ay "But her situation is a little more... {i}messy."
    ay "但她的情况有点更……{i}复杂。"

# game/events.rpy:12175
translate schinese ayumi_soushi_00_8a2e753b:

    # mc "How so?" with d
    mc "怎么说？" with d

# game/events.rpy:12178
translate schinese ayumi_soushi_00_15cdf314:

    # ay "I might be mistaken, but... I think [sou] is having her 'work' for him." with d
    ay "也许是我想多了，但……我觉得[sou]在让她替他「工作」。"with d

# game/events.rpy:12181
translate schinese ayumi_soushi_00_6133be63:

    # mc "Doing what?{w} I can't imagine it's anything clean, given how he seems to operate." with d
    mc "做什么？{w} 看他做事的做派，不可能是什么干净的活。" with d

# game/events.rpy:12186
translate schinese ayumi_soushi_00_3c1aad20:

    # ay "I... don't want to jump to conclusions, but like you said, it's probably nothing good." with d
    ay "我……不想妄下定论，但就像你说的，大概不是什么好事。" with d

# game/events.rpy:12187
translate schinese ayumi_soushi_00_84e2ef90:

    # ay "That's why I want to pay my part {i}and{/i} hers, so that she doesn't have to do anything [sou] tells her to."
    ay "所以我想把我这份{i}和{/i}她的那份一起还了，这样她就不用去做[sou]让她做的任何事。"

# game/events.rpy:12195
translate schinese ayumi_soushi_00_221f5051:

    # mct "([ay] doesn't have any answers for the situations she's in.)" with d
    mct "（[ay]对自己身处的这些状况毫无头绪。）" with d

# game/events.rpy:12196
translate schinese ayumi_soushi_00_5f856e39:

    # mct "(And I'd say 'not knowing the answer' is something she's not quite used to.)"
    mct "（而且我觉得「没有答案」这种状态，她还没完全习惯。）"

# game/events.rpy:12197
translate schinese ayumi_soushi_00_23c049d3:

    # mct "(I might be able to influence her decision here, it's like she's at a crossroands and is just waiting for someone to tell her what to do.)"
    mct "（我也许能影响她在这里的决定，她就像站在十字路口，等着有人告诉她该怎么做。）"

# game/events.rpy:12200
translate schinese ayumi_soushi_00_b727bbb8:

    # mct "(I'm sure I could just keep [sou] away from her, and she'd be grateful for that.)"
    mct "（我只要让[sou]离她远一点就行，她肯定会感激的。）"

# game/events.rpy:12201
translate schinese ayumi_soushi_00_6d300e56:

    # mct "(This is probably the wisest choice at the moment.)"
    mct "（这大概是当下最明智的选择。）"

# game/events.rpy:12202
translate schinese ayumi_soushi_00_df8ea600:

    # mct "(But... often times the wisest choice is not the most exciting one.)"
    mct "（不过……很多时候最明智的选择并不是最刺激的那个。）"

# game/events.rpy:12203
translate schinese ayumi_soushi_00_5fbe29c4:

    # mct "(There's that little hint of curiosity on whether I should push her towards him and see what comes of it.)"
    mct "（我心里还是有一点小好奇，想知道该不该把她推向那边，看看会变成什么样。）"

# game/events.rpy:12204
translate schinese ayumi_soushi_00_0de00f84:

    # mct "(To see just how far she'd be willing to go...)"
    mct "（想看看她到底愿意走到哪一步……）"

# game/events.rpy:12208
translate schinese ayumi_soushi_00_aa7d0db9:

    # mct "(I'm sure many of the Board members are anxiously awaiting for me to influence [ay] to do what [sou] wants, but that might not be a good idea.)"
    mct "（我敢肯定董事会有很多人在焦急地等我影响[ay]去做[sou]想让她做的事，但那可能不是个好主意。）"

# game/events.rpy:12209
translate schinese ayumi_soushi_00_28693c9c:

    # mct "(He's a wildcard and I'm not sure what he'll ask of her if that were the case.)"
    mct "（他是个变数，我不确定那样的话他会让她做什么。）"

# game/events.rpy:12210
translate schinese ayumi_soushi_00_eddc6dd3:

    # mct "(On the other hand, I'm sure that if I help her, she'll be really grateful and this would probably help me get closer to her.)"
    mct "（另一方面，我确信如果我帮她，她会非常感激，这大概也能帮我更接近她。）"

# game/events.rpy:12227
translate schinese ayumi_soushi_00_2cee0313:

    # mc "Have you thought about just... giving [sou] what he wants?" with d
    mc "你有没有想过干脆……就给[sou]想要的东西？" with d

# game/events.rpy:12233
translate schinese ayumi_soushi_00_8ccf89a0:

    # ay "I... W-what?" with Dissolve(0.1)
    ay "我……什、什么？" with Dissolve(0.1)

# game/events.rpy:12235
translate schinese ayumi_soushi_00_5c154473:

    # mc "I know this is not what you wanted to hear right now, but it's the easiest way to repay what you owe." with d
    mc "我知道这可能不是你现在想听的，但这是还清欠债最简单的办法。" with d

# game/events.rpy:12238
translate schinese ayumi_soushi_00_f0c8b260:

    # ay "But... give him what?" with d
    ay "可……给他什么？" with d

# game/events.rpy:12240
translate schinese ayumi_soushi_00_5945b328:

    # ay "I can't just... give him the money I got from the Academy. I need it, for other things. Like I said, I have other problems going on right now."
    ay "我不能就这么……把学院给的钱给他。我需要那些钱处理别的事。就像我说的，我现在还有别的麻烦。"

# game/events.rpy:12242
translate schinese ayumi_soushi_00_2c3c10aa:

    # ay "I don't really have anything to give right now"
    ay "我现在真没什么能给的"

# game/events.rpy:12244
translate schinese ayumi_soushi_00_6d211dd1:

    # ay "I got no money from the Academy, so there's only the small savings left from my part-time job. Which is... not enough."
    ay "我没从学院拿到钱，所以只剩下打工攒的一点积蓄。而那……不够。"

# game/events.rpy:12246
translate schinese ayumi_soushi_00_7bf49443:

    # ay "Somehow I got a terrible score on the last exam. I have got basically nothing left, only the small savings left from my part-time job. Which is... not enough."
    ay "不知怎么的，上次考试我考砸了。我基本什么都没剩下，只有打工攒的一点积蓄。而那……不够。"

# game/events.rpy:12248
translate schinese ayumi_soushi_00_3bba3fb1:

    # mc "Is he {i}that{/i} unreasonable that he'd only want money and nothing else?" with d
    mc "他有那么{i}不讲理{/i}，只要钱别的都不要？" with d

# game/events.rpy:12257
translate schinese ayumi_soushi_00_97dd63e4:

    # ay "Yes." with d
    ay "对。" with d

# game/events.rpy:12262
translate schinese ayumi_soushi_00_7a8fbd04:

    # ay "{size=-8}...Sort of."
    ay "{size=-8}……算是吧。"

# game/events.rpy:12266
translate schinese ayumi_soushi_00_cf0ff932:

    # ay "He'd only want money... Unless..." with d
    ay "他只会要钱……除非……" with d

# game/events.rpy:12270
translate schinese ayumi_soushi_00_06bb0f9e:

    # mc "...Unless you offered something better than that." with d
    mc "……除非你给他比钱更好的东西。" with d

# game/events.rpy:12274
translate schinese ayumi_soushi_00_7347bf2c:

    # ay "You mean if I..." with d
    ay "你是说如果我……" with d

# game/events.rpy:12275
translate schinese ayumi_soushi_00_c74d5e97:

    # ay "{size=-8}...'Offered myself' to him?"
    ay "{size=-8}……「把自己献出去」？"

# game/events.rpy:12277
translate schinese ayumi_soushi_00_12380e6b:

    # mc "Now, now... I didn't say {i}that{/i} specifically... You're just jumping to conclusions on your own." with d
    mc "喂喂……我并没特指{i}那件事{/i}……是你自己急着下结论。" with d

# game/events.rpy:12279
translate schinese ayumi_soushi_00_d415ae67:

    # mc "What I mean to say is that you {i}do{/i} know that there are other ways to give a man what he wants."
    mc "我的意思是，你{i}确实{/i}知道，让一个男人满足的方法不止一种。"

# game/events.rpy:12280
translate schinese ayumi_soushi_00_a03094b6:

    # mc "Your little visit to my office, after last weeks' exam tells me as much."
    mc "上周考试之后你来我办公室走那一趟，已经说明了一切。"

# game/events.rpy:12285
translate schinese ayumi_soushi_00_207b07d0:

    # mc "Anyone would be a fool to reject you. And you should start to use this to your advantage." with d
    mc "任何人都不会是个傻子去拒绝你。你该学会把这一点变成自己的优势。" with d

# game/events.rpy:12287
translate schinese ayumi_soushi_00_4935d538:

    # mc "You're a very beautiful girl, [ay]. You should learn how to use this to your advantage." with d
    mc "你是个非常漂亮的女孩，[ay]。你应该学会利用这一点。" with d

# game/events.rpy:12288
translate schinese ayumi_soushi_00_bb9fe48b:

    # mc "Who knows... If you weren't just trying to 'win me over' because you were told to, then I might've taken you up on your previous offer."
    mc "谁知道呢……如果你不是被人吩咐来「讨好我」，那我也许就会接受你之前的提议了。"

# game/events.rpy:12290
translate schinese ayumi_soushi_00_1a4409f6:

    # ay "B-but... again, I don't want to become someone that does that type of stuff." with d
    ay "可、可是……我还是不想变成会做那种事的人。" with d

# game/events.rpy:12292
translate schinese ayumi_soushi_00_a50b972d:

    # mc "Then why'd you do it in the first place?" with d
    mc "那你一开始为什么要做？" with d

# game/events.rpy:12296
translate schinese ayumi_soushi_00_7b7ef3e8:

    # ay "I... guess because it was... {i}you?{/i} I don't know how to explain it properly, I just felt that you wouldn't treat me badly." with d
    ay "我……大概是因为对方是……{i}你{/i}。我不太会解释清楚，我只是觉得你不会对我太差。" with d

# game/events.rpy:12297
translate schinese ayumi_soushi_00_6ab87298:

    # ay "I just can't see myself doing the same thing with [sou]."
    ay "我实在想象不到自己对[sou]做同样的事。"

# game/events.rpy:12299
translate schinese ayumi_soushi_00_7541eae6:

    # mc "So what you're saying is that you'd be able to do it again if it was me?" with d
    mc "也就是说，对方是我的话，你就愿意再来一次？" with d

# game/events.rpy:12301
translate schinese ayumi_soushi_00_8748679a:

    # ay "...I don't-" with d
    ay "……我不——" with d

# game/events.rpy:12302
translate schinese ayumi_soushi_00_6ff6b3b1:

    # mc "I'd prefer if you'd be honest about it." with d
    mc "我更希望你诚实一点。" with d

# game/events.rpy:12307
translate schinese ayumi_soushi_00_322c42a0_3:

    # ay "..." with d
    ay "……" with d

# game/events.rpy:12311
translate schinese ayumi_soushi_00_2ee6de11:

    # ay "{size=-8}I think so."
    ay "{size=-8}我想是的。"

# game/events.rpy:12314
translate schinese ayumi_soushi_00_57edbed5:

    # mc "So why don't you tell me what you'd do if it were me you needed to convince?" with d
    mc "那你说说看，要是需要说服的人是我，你会怎么做？" with d

# game/events.rpy:12317
translate schinese ayumi_soushi_00_c8ddb807:

    # ay "W-what? Like... now?" with d
    ay "什、什么？ 像是……现在？" with d

# game/events.rpy:12319
translate schinese ayumi_soushi_00_f2f28c2f:

    # mc "Yes...?" with d
    mc "对……？" with d

# game/events.rpy:12324
translate schinese ayumi_soushi_00_e4244b9e:

    # ay "I don't know... What would you like me to do?" with d
    ay "我不知道……你想让我怎么做？" with d

# game/events.rpy:12326
translate schinese ayumi_soushi_00_00b7c8df:

    # mc "You're the one that needs to answer that." with d
    mc "该回答这个问题的是你。" with d

# game/events.rpy:12328
translate schinese ayumi_soushi_00_7923bfc5:

    # ay "I guess I could... Give you something?" with d
    ay "我想我可以……给你点什么？" with d

# game/events.rpy:12330
translate schinese ayumi_soushi_00_78b56d07:

    # mc "...Like what?" with d
    mc "……比如什么？" with d

# game/events.rpy:12335
translate schinese ayumi_soushi_00_add6923a:

    # ay "A... {size=-6}Kiss?" with d
    ay "一个……{size=-6}吻？" with d

# game/events.rpy:12337
translate schinese ayumi_soushi_00_fe4e814c:

    # mc "A kiss? That's romantic, but I don't think other men would want such things." with d
    mc "一个吻？那挺浪漫的，但我觉得别的男人不会想要这种东西。" with d

# game/events.rpy:12341
translate schinese ayumi_soushi_00_35a7b7a5:

    # ay "I... wha-?!" with Dissolve(0.1)
    ay "我……什——？！" with Dissolve(0.1)

# game/events.rpy:12342
translate schinese ayumi_soushi_00_3db4e16c:

    # ay "I thought we were talking about you... and..."
    ay "我以为我们谈的是你……还有……"

# game/events.rpy:12348
translate schinese ayumi_soushi_00_37ead45a:

    # ay "...Me."
    ay "……我。"

# game/events.rpy:12352
translate schinese ayumi_soushi_00_6803a70b:

    # ay "S-sorry." with d
    ay "对、对不起。" with d

# game/events.rpy:12355
translate schinese ayumi_soushi_00_8d56b679:

    # mc "It's okay... go on, what else could you offer 'me'?" with d
    mc "没关系……继续说，还能给「我」什么？"with d

# game/events.rpy:12358
translate schinese ayumi_soushi_00_b5afff09:

    # ay "What if I showed you... something?" with d
    ay "如果我给你看……某个东西呢？" with d

# game/events.rpy:12359
translate schinese ayumi_soushi_00_283f4460:

    # ay "Like... maybe... {size=-6}my bare chest?"
    ay "比如……也许……{size=-6}我的裸胸？"

# game/events.rpy:12363
translate schinese ayumi_soushi_00_943e26cd:

    # mc "Now that's a little better." with d
    mc "这就好一点了。" with d

# game/events.rpy:12364
translate schinese ayumi_soushi_00_6192ec90:

    # mc "Would you let me touch it?"
    mc "你能让我摸一下吗？"

# game/events.rpy:12367
translate schinese ayumi_soushi_00_2ebeb292:

    # ay "{size=-8}Y-yes." with d
    ay "{size=-8}好、好的。" with d

# game/events.rpy:12369
translate schinese ayumi_soushi_00_3ddf3d93:

    # mc "That's good. What else would you be willing to offer?" with d
    mc "很好。你还愿意给什么？" with d

# game/events.rpy:12370
translate schinese ayumi_soushi_00_a2cba1e4:

    # mc "How about something a little more... pleasurable?"
    mc "那来点更……舒服一点的？"

# game/events.rpy:12372
translate schinese ayumi_soushi_00_322c42a0_4:

    # ay "..." with d
    ay "……" with d

# game/events.rpy:12377
translate schinese ayumi_soushi_00_a460ead0:

    # ay "...I think this is as far as I'd go."
    ay "……我觉得我能做的就到这里了。"

# game/events.rpy:12378
translate schinese ayumi_soushi_00_7e73171d:

    # ay "At least in this hypothetical scenario."
    ay "至少在这个假设情境里。"

# game/events.rpy:12380
translate schinese ayumi_soushi_00_4b7e2d01:

    # mc "Are you sure? You could get much more if you'd be willing to go the extra length." with d
    mc "你确定？如果你愿意更拼一点，能拿到的会多得多。" with d

# game/events.rpy:12382
translate schinese ayumi_soushi_00_322c42a0_5:

    # ay "..." with d
    ay "……" with d

# game/events.rpy:12384
translate schinese ayumi_soushi_00_8edaba37:

    # ay "Can we... not talk about this anymore?"
    ay "我们能……别再谈这个了吗？"

# game/events.rpy:12386
translate schinese ayumi_soushi_00_68d72fec:

    # mc "Of course." with d
    mc "当然。" with d

# game/events.rpy:12391
translate schinese ayumi_soushi_00_12e09014:

    # ay "And... Would you be okay with me doing something like this?" with d
    ay "还有……你能接受我做这种事吗？" with d

# game/events.rpy:12393
translate schinese ayumi_soushi_00_2375c663:

    # mc "If 'I' would be okay? Why are you asking me this?" with d
    mc "问我「我」能不能接受？你为什么反过来问我？"with d

# game/events.rpy:12397
translate schinese ayumi_soushi_00_e3d7b646:

    # ay "I..." with Dissolve(0.1)
    ay "我……" with Dissolve(0.1)

# game/events.rpy:12403
translate schinese ayumi_soushi_00_44789bdb:

    # ay "S-sorry, forget I asked. It was a stupid question."
    ay "对、对不起，当我没问。是个蠢问题。"

# game/events.rpy:12405
translate schinese ayumi_soushi_00_17d97b89_1:

    # mc "It's fine, [ay]." with d
    mc "没关系，[ay]。" with d

# game/events.rpy:12407
translate schinese ayumi_soushi_00_dd3bb904:

    # mc "Anyway..." with d
    mc "总之……" with d

# game/events.rpy:12411
translate schinese ayumi_soushi_00_147e5a44:

    # mc "...I want you to think about what we talked here. You'd be surprised with just how much you can gain if you start to use this 'asset' to your advantage." with d
    mc "……我希望你好好想想我们刚才谈的。如果你能开始利用这项「资产」，你会惊讶于自己能得到多少。"with d

# game/events.rpy:12417
translate schinese ayumi_soushi_00_785ec4f4:

    # mct "(No answer...)" with d
    mct "（没有回答……）" with d

# game/events.rpy:12418
translate schinese ayumi_soushi_00_9ce946db:

    # mct "(Yet, I can tell she's really considering it.)"
    mct "（不过，我看得出她是真的在考虑。）"

# game/events.rpy:12419
translate schinese ayumi_soushi_00_617fc7e5:

    # mct "(Even though [sou] is a piece of shit, my curiosity over what [ay] would be willing to do is an interesting outcome.)"
    mct "（虽然[sou]是个混蛋，但我对[ay]愿意做到什么程度的好奇心，倒是成了个有趣的收获。）"

# game/events.rpy:12420
translate schinese ayumi_soushi_00_25bb2008:

    # mct "(I just gotta be careful not to let things get out of control, and let [sou] go as far as I let him.)"
    mct "（我只要小心别让事情失控，别让[sou]走出我允许的范围就行。）"

# game/events.rpy:12424
translate schinese ayumi_soushi_00_dd3bb904_1:

    # mc "Anyway..." with d
    mc "总之……" with d

# game/events.rpy:12428
translate schinese ayumi_soushi_00_a084b17b:

    # mc "I think [sou] is the kind of person that if you give an inch, he'll take a mile, and this situation will keep going until you find yourself with no way out." with d
    mc "我觉得[sou]就是那种你给他一寸、他要一里的人，这样下去直到你发现自己无路可走。" with d

# game/events.rpy:12430
translate schinese ayumi_soushi_00_a81b5cdc:

    # mc "It's best to cut off this shit now rather than later."
    mc "这种烂摊子最好现在就斩断，而不是拖到以后。"

# game/events.rpy:12432
translate schinese ayumi_soushi_00_b96c09fc:

    # ay "But... I can't." with d
    ay "可我……做不到。" with d

# game/events.rpy:12433
translate schinese ayumi_soushi_00_975e5cba:

    # ay "Remember, I'm not the only one here that'll be affected by this."
    ay "记住，受这件事影响的不只是我一个人。"

# game/events.rpy:12435
translate schinese ayumi_soushi_00_dbf5fa63:

    # mc "I know, but you have to look after yourself first, {i}then{/i} think about your friend." with d
    mc "我知道，但你得先照顾好自己，{i}然后{/i}再考虑你朋友。" with d

# game/events.rpy:12436
translate schinese ayumi_soushi_00_006207f9:

    # mc "Who, by the sounds of it, doesn't seem like she has your interests in mind."
    mc "而听起来，她好像并没有把你的利益放在心上。"

# game/events.rpy:12438
translate schinese ayumi_soushi_00_a4f4613c:

    # mc "Have you talked to her recently and discussed this?"
    mc "你最近跟她聊过这件事吗？"

# game/events.rpy:12440
translate schinese ayumi_soushi_00_aa02316e:

