translate schinese Haruka_Sneaking_Office_da0f28e3:

    # mc "Come, let me walk you out to the Academy gates. We can chat a bit about the normal stuff on our way there."
    mc "来，我送你到学院门口。路上我们可以聊点平常的事。"

# game/events.rpy:18523
translate schinese Haruka_Sneaking_Office_a4654038:

    # em "Okay."
    em "好。"

# game/events.rpy:18530
translate schinese Haruka_Sneaking_Office_0320422b:

    # ha "{size=-6}{xpr}*whispering*{/xpr} Fuck, that was close." with d
    ha "{size=-6}{xpr}*低声说*{/xpr} 靠，好险。" with d

# game/events.rpy:18535
translate schinese Haruka_Sneaking_Office_511da05d:

    # ha "Alright, alright. 'After classes, in the upcoming days'. I got to keep an eye out for it." with d
    ha "好吧好吧。「最近几天，放学之后」。我得留心着点。"with d

# game/events.rpy:18536
translate schinese Haruka_Sneaking_Office_953ad7ae:

    # ha "Just what are you hiding, [mc]...? Why is this shit so secretive and important?"
    ha "你到底在瞒什么啊，[mc]……？为什么这鬼事这么神秘又重要？"

# game/events.rpy:18537
translate schinese Haruka_Sneaking_Office_1cb1c40d:

    # ha "And why the fuck is [k] helping you with your girlfriend's virginity? Is she like your wingman or something?"
    ha "还有，[k]凭什么要帮你解决你女朋友的处女问题？她该不会是你的红娘吧？"

# game/events.rpy:18538
translate schinese Haruka_Sneaking_Office_304e3873:

    # ha "And what did she mean by 'viewers' that day?"
    ha "还有那天她说的「观众」是什么意思？"

# game/events.rpy:18545
translate schinese Haruka_Sneaking_Office_db77fda2:

    # ha "I'm sounding like an obsessive girlfriend, but it can't be all in my head, can it?" with d
    ha "我听起来像个偏执的女友，但这不可能都是我胡思乱想的吧？" with d

# game/events.rpy:18547
translate schinese Haruka_Sneaking_Office_a8ea88dc:

    # ha "Maybe I'm acting a bit obsessive here, but it can't be all in my head, can it?" with d
    ha "也许我在这里表现得有点偏执，但这不可能都是我胡思乱想的吧？" with d

# game/events.rpy:18552
translate schinese Haruka_Sneaking_Office_11268901:

    # ha "... Shit, I have to stop brainstorming and get the fuck out of here." with d
    ha "……靠，我得停止胡思乱想，赶紧滚出这里。" with d

# game/events.rpy:18787
translate schinese Emiko_Virginity_Event_image_definitions_7cb1e745:

    # mct "(This is it.)" with d
    mct "（就是这里。）" with d

# game/events.rpy:18788
translate schinese Emiko_Virginity_Event_image_definitions_959b0ba7:

    # mct "(It feels like this is the occasion the Board's been anticipating the most.)"
    mct "（感觉这正是理事会最期待的一刻。）"

# game/events.rpy:18789
translate schinese Emiko_Virginity_Event_image_definitions_a729aedd:

    # mct "(I get it that it is a special moment and they want to capture it, but still, I wonder if that's all there is to it...)"
    mct "（我明白这是特别时刻，他们想记录下来，但我还是怀疑……是不是仅此而已……）"

# game/events.rpy:18791
translate schinese Emiko_Virginity_Event_image_definitions_6dc5b959:

    # mct "(Is it only because this mysterious 'Board member' wants to... have their way with [em]?)"
    mct "（是不是只因为那个神秘的「理事」想……对[em]为所欲为？）"

# game/events.rpy:18792
translate schinese Emiko_Virginity_Event_image_definitions_f7942ef3:

    # mct "(Seems unlikely. I bet they would still be interested in it all the same if it were only me and [em]... But why?)"
    mct "（看起来不太可能。就算只有我和[em]，我打赌他们照样会有兴趣……但为什么？）"

# game/events.rpy:18795
translate schinese Emiko_Virginity_Event_image_definitions_9970cda0:

    # mct "(Is is really because of [em]'s close relationship with me? Seems unlikely...)"
    mct "（真的只是因为[em]和我关系好吗？似乎不太可能……）"

# game/events.rpy:18798
translate schinese Emiko_Virginity_Event_image_definitions_53d32f75:

    # mct "([tvar]As far as I know, I'm not that important of a person. At least not until I've become the CAO of this place.)"
    mct "（[tvar]据我所知，我并不是什么重要人物。至少在我当上这儿的总务长之前不是。）"

# game/events.rpy:18800
translate schinese Emiko_Virginity_Event_image_definitions_64f38d83:

    # mct "(But even still, they went ahead and put me in this position, and even went as far as to make [em] one of the 'Main Targets'. Strange...)"
    mct "（但即便如此，他们还是让我坐上了这个位子，甚至还把[em]也列进了「主要目标」。奇怪……）"

# game/events.rpy:18803
translate schinese Emiko_Virginity_Event_image_definitions_20be283c:

    # mct "(Anyway... Now's not the time to think about complicated stuff. I just need to forget everything around it and do my part.)" with d
    mct "（总之……现在不是想复杂事情的时候。我只需要把周围的一切都忘掉，做好自己该做的就行。）" with d

# game/events.rpy:18806
translate schinese Emiko_Virginity_Event_image_definitions_9bd25797:

    # k "Sir." with d
    k "先生。" with d

# game/events.rpy:18812
translate schinese Emiko_Virginity_Event_image_definitions_3cef201f:

    # k "The event is under way." with d
    k "活动已经开始了。" with d

# game/events.rpy:18814
translate schinese Emiko_Virginity_Event_image_definitions_9113574b:

    # mc "Good. So [em] is...-"
    mc "很好。那么[em]她……-"

# game/events.rpy:18816
translate schinese Emiko_Virginity_Event_image_definitions_4e2b6aa1:

    # k "Yes. She was informed earlier that you wish to meet with her, and she's making her way here as we speak."
    k "是的。我们之前已经通知过她，说您想见她，她现在正在过来的路上。"

# game/events.rpy:18817
translate schinese Emiko_Virginity_Event_image_definitions_477e0ae7:

    # k "She should be arriving shortly."
    k "她应该很快就到。"

# game/events.rpy:18820
translate schinese Emiko_Virginity_Event_image_definitions_cbd33fa2:

    # mc "And... what about the... uhm..."
    mc "那么……那个「第三方」呢……呃……"

# game/events.rpy:18822
translate schinese Emiko_Virginity_Event_image_definitions_02c33c69:

    # k "The 'Third-Party' is also present at the Academy and is on stand-by."
    k "「第三方」现在也在学院里待命。"

# game/events.rpy:18824
translate schinese Emiko_Virginity_Event_image_definitions_747c913a:

    # mc "'Third-Party', right."
    mc "「第三方」，没错。"

# game/events.rpy:18825
translate schinese Emiko_Virginity_Event_image_definitions_ef43cb8c:

    # mc "Did you get the prop I asked for as well?"
    mc "我让你准备的道具也带来了吗？"

# game/events.rpy:18827
translate schinese Emiko_Virginity_Event_image_definitions_dc239098:

    # k "Yes, sir. It's under the desk positioned at the center of the classroom, just like you instructed."
    k "是的，先生。就像您吩咐的，放在教室中央那张桌子下面。"

# game/events.rpy:18829
translate schinese Emiko_Virginity_Event_image_definitions_e0ce6cf7:

    # mc "Okay, good job."
    mc "很好，干得不错。"

# game/events.rpy:18831
translate schinese Emiko_Virginity_Event_image_definitions_054c5ee0:

    # mc "I see."
    mc "明白了。"

# game/events.rpy:18835
translate schinese Emiko_Virginity_Event_image_definitions_914bffc3:

    # mc "And what of [ha]? Did the bait work?" with d
    mc "那[ha]呢？诱饵起作用了吗？" with d

# game/events.rpy:18839
translate schinese Emiko_Virginity_Event_image_definitions_c8607cb4:

    # k "I believe so. I made sure she heard me loud and clear when I spoke to Miss [em]."
    k "我想是的。我和[em]小姐说话时，确保她听得清清楚楚。"

# game/events.rpy:18840
translate schinese Emiko_Virginity_Event_image_definitions_9023240e:

    # k "Ever since, she has been keeping a close eye and following Miss [em] around the Academy."
    k "从那以后，她一直紧紧盯着[em]小姐，在学院里到处跟着她。"

# game/events.rpy:18841
translate schinese Emiko_Virginity_Event_image_definitions_866412f6:

    # k "She's likely to follow her up here as well."
    k "她多半也会跟到这里来。"

# game/events.rpy:18845
translate schinese Emiko_Virginity_Event_image_definitions_2ed86984:

    # mc "All according to plan. Let's just hope she'll just watch and doesn't decide to interfere."
    mc "一切都在计划之中。只希望她只是看着，不会决定插手。"

# game/events.rpy:18849
translate schinese Emiko_Virginity_Event_image_definitions_a8ff56a0:

    # k "The Janitor is at the ready. If she shows intention of interfering with it, he is to make sure that doesn't happen."
    k "保洁员已经待命。如果她有意干扰，他负责确保那种事不会发生。"

# game/events.rpy:18854
translate schinese Emiko_Virginity_Event_image_definitions_ae71a682:

    # mc "The Janitor?! I don't think he'll be needed, I don't want to escalate things any further."
    mc "保洁员？！我觉得用不上他，我不想把事情闹得更大。"

# game/events.rpy:18858
