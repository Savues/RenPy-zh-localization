translate schinese Haruka_First_Weekend_H_Replay_604f6ff9:

    # ha "{xpr}*Hmph!*" with d
    ha "{xpr}*哼！*" with d

# game/events.rpy:35342
translate schinese Haruka_First_Weekend_H_Replay_c393b52a:

    # mc "You know...{w} I have just the thing that'll make you forget all about this mess..." with d
    mc "你知道吗……{w} 我正好有个东西，能让你把这堆烂事全都忘掉……" with d

# game/events.rpy:35345
translate schinese Haruka_First_Weekend_H_Replay_e1ff199e_7:

    # ha "..." with d
    ha "..." with d

# game/events.rpy:35350
translate schinese Haruka_First_Weekend_H_Replay_b69fa8bc:

    # mc "... No?" with d
    mc "……不要？" with d

# game/events.rpy:35356
translate schinese Haruka_First_Weekend_H_Replay_5b0dd91a:

    # ha "... Great idea~" with dd
    ha "……好主意～" with dd

# game/events.rpy:35359
translate schinese Haruka_First_Weekend_H_Replay_3227d437:

    # mc "That's my girl." with d
    mc "这才是我的女孩。" with d

# game/events.rpy:35559
translate schinese Ayumi_friend_meeting_3eeb516b:

    # mct "(I told [ay] I wanted to meet her mysterious 'friend' over the weekend.)" with d
    mct "（我告诉[ay]我想在周末见见她那位神秘的「朋友」。）"with d

# game/events.rpy:35560
translate schinese Ayumi_friend_meeting_982a5520:

    # mct "(I'll give her a call and tell her I'm available for today and to arrange a meeting between us.)"
    mct "（我会给她打个电话，告诉她我今天有空，让她安排我们见面。）"

# game/events.rpy:35568
translate schinese Ayumi_friend_meeting_4bfbb499:

    # mct "(She said she'd be waiting for me at the train station.)" with d
    mct "（她说她会在火车站等我。）" with d

# game/events.rpy:35569
translate schinese Ayumi_friend_meeting_f7fe96ac:

    # mct "(Good thing it is not that crowded today. I guess since it's raining and over the weekend, not many people are using this line.)"
    mct "（好在今天人不多。我猜因为在下雨又是周末，这条线没多少人用。）"

# game/events.rpy:35570
translate schinese Ayumi_friend_meeting_c16726e9:

    # mct "(... Now, where is she?)"
    mct "（……那么，她在哪儿？）"

# game/events.rpy:35575
translate schinese Ayumi_friend_meeting_36131d1d:

    # mct "(There she is!)" with d
    mct "（在那儿！）" with d

# game/events.rpy:35578
translate schinese Ayumi_friend_meeting_44d3c3b0:

    # mct "(It's kinda nice seeing her with something other than the Academy uniform.)" with d
    mct "（看她穿着学院制服以外的东西，感觉还挺新鲜。）" with d

# game/events.rpy:35579
translate schinese Ayumi_friend_meeting_48392d9d:

    # mct "(She's an uptight kind of girl, so it's a welcome change of pace to see her in a more casual setting.)"
    mct "（她是个有点拘谨的女孩，所以在更休闲的场合看到她，算是让人愉快的转变。）"

# game/events.rpy:35580
translate schinese Ayumi_friend_meeting_ad82a1e2:

    # mct "(... Anyway, I better stop ogling her like a pervert and let her know I'm here. Some grandmas' are starting to throw weird looks at me.)"
    mct "（……总之，我最好别像变态一样盯着她看，该让她知道我来了。有些老太太开始用奇怪的眼神看我了。）"

# game/events.rpy:35582
translate schinese Ayumi_friend_meeting_d8df50a1:

    # mc "Yo! [ay], I'm here." with d
    mc "喂！[ay]，我来了。" with d

# game/events.rpy:35584
translate schinese Ayumi_friend_meeting_b1652fe0:

    # mct "(...)" with d
    mct "(……)" with d

# game/events.rpy:35585
translate schinese Ayumi_friend_meeting_2ec2dc68:

    # mct "(She seems to be lost in her own mind again...)"
    mct "（她又沉浸在自己的思绪里了……）"

# game/events.rpy:35586
translate schinese Ayumi_friend_meeting_f13ba934:

    # mct "(Let me try and wake her up.)"
    mct "（我试着把她叫醒。）"

# game/events.rpy:35589
translate schinese Ayumi_friend_meeting_339f8cf5:

    # mc "[ay]! Hello?!" with hpunch
    mc "[ay]！你好？！" with hpunch

# game/events.rpy:35591
translate schinese Ayumi_friend_meeting_e743fab2:

    # ay "Wha-...?"
    ay "什……？"

# game/events.rpy:35592
translate schinese Ayumi_friend_meeting_f3227ccf:

    # ay "Oh, it's you."
    ay "哦，是你。"

# game/events.rpy:35604
translate schinese Ayumi_friend_meeting_86facaba:

    # ay "Hello, [mc]." with d
    ay "你好，[mc]。" with d

# game/events.rpy:35606
translate schinese Ayumi_friend_meeting_6b1e3790:

    # mc "Hope I didn't keep you waiting for too long." with d
    mc "希望我没让你等太久。" with d

# game/events.rpy:35608
translate schinese Ayumi_friend_meeting_9d3b066c:

    # ay "... Waiting? N-no, I don't think so. I... wasn't really paying attention at the time." with d
    ay "……等？不、不，应该没有。我……刚才没怎么注意。" with d

# game/events.rpy:35610
translate schinese Ayumi_friend_meeting_dc783e5d:

    # mc "Yeah, I could tell you were a bit distracted there. Is everything okay?" with d
    mc "对，我看得出你刚才有点心不在焉。没事吧？" with d

# game/events.rpy:35615
translate schinese Ayumi_friend_meeting_c4f0115e:

    # ay "Sorry, I just... haven't had enough time to process everything that's been going on these past few days." with d
    ay "抱歉，我只是……还没来得及处理过去这几天发生的所有事。" with d

# game/events.rpy:35616
translate schinese Ayumi_friend_meeting_df8d53c5:

    # ay "And now..."
    ay "而且现在……"

# game/events.rpy:35617
translate schinese Ayumi_friend_meeting_36bd38cb:

    # ay "I don't know. I got a weird feeling about what we're about to do."
    ay "我不知道。我对我们要做的事有种奇怪的感觉。"

# game/events.rpy:35619
translate schinese Ayumi_friend_meeting_247e3999:

    # mc "Look... I know meeting your 'friend' is not exactly something you're looking forward to, but we must figure this out eventually." with d
    mc "你看……我知道见你的「朋友」并不是什么值得期待的事，但我们终究得解决这件事。"with d

# game/events.rpy:35620
translate schinese Ayumi_friend_meeting_6dbdd811:

    # mc "You do understand that, right?"
    mc "你明白的，对吧？"

# game/events.rpy:35622
translate schinese Ayumi_friend_meeting_bba8ecfd:

    # ay "Yes, I know." with d
    ay "是的，我明白。" with d

# game/events.rpy:35625
translate schinese Ayumi_friend_meeting_1e32716f:

    # mc "So, where are we going? Have you talked to her? Arranged a meeting place yet?" with d
    mc "那，我们去哪儿？你联系她了吗？定好见面地点了吗？" with d

# game/events.rpy:35627
translate schinese Ayumi_friend_meeting_98e5a38a:

    # ay "... Y-yeah, we'll {xpr}*Uhm*{/xpr} ... just go to her place and... meet her there. She's already waiting for us." with d
    ay "……对、对，我们会 {xpr}*呃*{/xpr}……直接去她家……在那里见面。她已经在等我们了。" with d

# game/events.rpy:35629
translate schinese Ayumi_friend_meeting_e44108ab:

    # mct "(She sounds {i}very{/i} nervous about this, but I won't press her too much about it.)" with d
    mct "（她听起来{i}非常{/i}紧张，但我不会逼她太紧。）" with d

# game/events.rpy:35630
translate schinese Ayumi_friend_meeting_60aa54ac:

    # mct "(This must be a big step for her.)"
    mct "（这对她来说一定是很大的一步。）"

# game/events.rpy:35631
translate schinese Ayumi_friend_meeting_8e9ce355:

    # mc "Alright, then. Sounds good to me."
    mc "好啊，那就这么办。"

# game/events.rpy:35634
translate schinese Ayumi_friend_meeting_2143c37a:

    # ay "If I may ask... What exactly is your plan with all of this?" with d
    ay "请问我可以问吗……你到底打算怎么处理这件事？" with d

# game/events.rpy:35639
translate schinese Ayumi_friend_meeting_535a6e7c:

    # ay "I didn't question it at the time, due to the... {i}circumstances{/i} we were in, but..."
    ay "当时因为我们所处的……{i}状况{/i}，我没有追问，但……"

# game/events.rpy:35640
translate schinese Ayumi_friend_meeting_27a64825:

    # ay "... I don't think this'll work or what the point of it even is."
    ay "……我觉得这行不通，也不明白这么做的意义在哪。"

# game/events.rpy:35642
translate schinese Ayumi_friend_meeting_fb740e3e:

    # mc "The point is that [sou] is using this girl to manipulate you. I hope this much is obvious to you, isn't it?" with d
    mc "重点是[sou]在利用这个女孩操控你。这点你该看得出来吧？" with d

# game/events.rpy:35649
translate schinese Ayumi_friend_meeting_1c4ae973:

    # ay "He's not manipulating me. I'm just...-" with d
    ay "他没有在操控我。我只是……" with d

# game/events.rpy:35651
translate schinese Ayumi_friend_meeting_9c734bc3:

    # mc "... You feel like it's your responsibility to help your friend since last you were together, you were also in this mess with her."
    mc "……你们上次见面已经过去这么多年，你觉得自己有责任帮她，因为当时你也跟她一起陷在这滩浑水里。"

# game/events.rpy:35652
translate schinese Ayumi_friend_meeting_cb056cea:

    # mc "And [sou] is quick to remind you of that, making you feel guilty afterward. Isn't that right?"
    mc "而[sou]很乐意提醒你这一点，让你事后感到内疚。没错吧？"

# game/events.rpy:35653
translate schinese Ayumi_friend_meeting_322c42a0:

    # ay "..." with d
    ay "……" with d

# game/events.rpy:35654
translate schinese Ayumi_friend_meeting_82e017c5:

    # mc "Come on, [ay] this is manipulation 101." with d
    mc "得了吧[ay]，这都是操控入门课了。" with d

# game/events.rpy:35659
translate schinese Ayumi_friend_meeting_e7fc79e5:

    # ay "{xpr}*sigh*{/xpr} ... I guess." with d
    ay "{xpr}*叹气*{/xpr}……算是吧。" with d

# game/events.rpy:35661
translate schinese Ayumi_friend_meeting_3a0c76cb:

    # mc "Anyway, my plan is to figure out if this girl is just another victim or if she's just going along with him." with d
    mc "总之，我的计划是查清这个女孩只是另一个受害者，还是在跟他同流合污。" with d

# game/events.rpy:35662
translate schinese Ayumi_friend_meeting_22733459:

    # mc "If she's not on [sou]'s side, maybe I can find a way to help her and make her not depend on him, which would help you as well."
    mc "如果她不是站在[sou]那边，也许我能找到办法帮她，让她不再依赖他，那样也能帮到你。"

# game/events.rpy:35664
translate schinese Ayumi_friend_meeting_88db6a44:

    # ay "I do get the reasoning behind it, I just can't see the 'how' you'll achieve this." with d
    ay "道理我明白，但我看不出你要怎么「做到」。"with d

# game/events.rpy:35666
translate schinese Ayumi_friend_meeting_86a99279:

    # mc "Relax, [ay]. You gotta trust the process." with d
    mc "放轻松[ay]。你得信这个过程。" with d

# game/events.rpy:35668
translate schinese Ayumi_friend_meeting_c89ec675:

    # ay "...If only things were that simple." with d
    ay "……要是事情真这么简单就好了。" with d

# game/events.rpy:35673
translate schinese Ayumi_friend_meeting_76b5828c:

    # mc "First things first though. It would be great if you could tell me a little bit more about this 'friend'. Like how you two met each other or what she's like." with d
    mc "不过先说正事。能不能跟我多讲讲这个「朋友」？比如你们是怎么认识的，她又是什么样的人。"with d

# game/events.rpy:35674
translate schinese Ayumi_friend_meeting_13ae129d:

    # mc "I don't even know her name, now that I come to think of it."
    mc "仔细想想，我好像连她叫什么都不知道。"

# game/events.rpy:35681
translate schinese Ayumi_friend_meeting_11a7e0fd:

    # ay "Her name is [nat]..." with dd
    ay "她叫[nat]……" with dd

# game/events.rpy:35686
translate schinese Ayumi_friend_meeting_3ab2a8a5:

    # ay "We met each other some years ago when we used to attend Haruno Prefecture Institute." with d
    ay "我们是几年前在春野县立学院读书时认识的。" with d

# game/events.rpy:35687
translate schinese Ayumi_friend_meeting_822be85e:

    # mc "Oh, I know that place. Very fancy from what I recall." with d
    mc "哦，我知道那个地方。听说很高级。" with d

# game/events.rpy:35688
translate schinese Ayumi_friend_meeting_2dc3c129:

    # mc "I tried to apply for a job there once, but they wouldn't accept me. It's a 'girls only' school, isn't it?"
    mc "我以前试着去那儿应聘过，但他们不要我。那是「女子学校」对吧？"

# game/events.rpy:35689
translate schinese Ayumi_friend_meeting_97dd63e4:

    # ay "Yes." with d
    ay "对。" with d

# game/events.rpy:35690
translate schinese Ayumi_friend_meeting_84753b22:

    # ay "My father didn't want anything to distract me from my studies, so he thought an all-girls school was the best place for me."
    ay "我父亲不想让任何事分散我学习的注意力，所以他觉得女子校才是最适合我的地方。"

# game/events.rpy:35691
translate schinese Ayumi_friend_meeting_7c0d4c84:

    # mct "([ay]'s father... The so-called 'Head of the [ayumi.surname] Family' and supposedly a very important politician. The reason why [ay] is a main target in the first place.)" with d
    mct "（[ay]的父亲……那位所谓的「[ayumi.surname]家当主」，据说是个很有分量的政客。也正是[ay]会被当成主要目标的原因。）"with d

# game/events.rpy:35692
translate schinese Ayumi_friend_meeting_b201a10d:

    # mct "(I should do my job for once and look into this guy.)"
    mct "（我这次也该干点正事了，查查这个人。）"

# game/events.rpy:35693
translate schinese Ayumi_friend_meeting_e4091dde:

    # mc "He sounds like a strict man. But even still, he didn't really achieve much when trying to shield you from 'distractions'. You {i}did{/i} meet [nat] over there after all."
    mc "听起来是个严厉的人。但即便如此，他想把你和『干扰』隔开也没成功多少。你最后还是{i}真的{/i}在那儿遇见了[nat]。"

# game/events.rpy:35694
translate schinese Ayumi_friend_meeting_f98863ca:

    # ay "Yes, you're not wrong." with d
    ay "对，你说得没错。" with d

# game/events.rpy:35695
translate schinese Ayumi_friend_meeting_55d421ed:

    # ay "Even though it was an all-girls school, many were in a period of their lives where they'd be curious and would naturally want to experiment and learn more about themselves."
    ay "虽然那是所女校，但很多人正处在人生中好奇的阶段，自然而然想尝试、想更了解自己。"

# game/events.rpy:35696
translate schinese Ayumi_friend_meeting_e3005859:

    # ay "And it was no different with me."
    ay "我也不例外。"

# game/events.rpy:35697
translate schinese Ayumi_friend_meeting_346c0ccd:

    # ay "[nat] was always more of an outgoing type of girl, so me and her tried some... 'things' together."
    ay "[nat]一直是比较外向的那种女孩，所以我和她一起试过一些……「事」。"

# game/events.rpy:35699
translate schinese Ayumi_friend_meeting_16fb572b:

    # ay "As time went on, however, [nat] constantly got herself in trouble and often had lower grades than expected from the demanding school, so she eventually dropped out." with d
    ay "但随着时间推移，[nat]总是惹麻烦，在这种要求严格的学校里成绩也经常不理想，最后她退学了。" with d

# game/events.rpy:35700
translate schinese Ayumi_friend_meeting_0347fc7a:

    # ay "At this point, my father already knew about her and we would always have big arguments and fights because of it. My father kept saying she was a bad influence on me and would forbid me from seeing her."
    ay "那时候我父亲已经知道她的存在，我们总是因为她大吵大闹。我父亲总说她是带坏我的人，禁止我去见她。"

# game/events.rpy:35701
translate schinese Ayumi_friend_meeting_cfe3e586:

    # ay "But, I did it anyway, and when he found out, we had the biggest argument of all, and that was the cause for me to leave my parents' house, and went on to live with [nat]."
    ay "但我还是去了。被发现以后，我们爆发了有史以来最大的一次争吵，也因此我离家出走，跟[nat]住到了一起。"

# game/events.rpy:35708
translate schinese Ayumi_friend_meeting_c034b352:

    # ay "From that point, you already know the rest of the story." with d
    ay "从那以后的事你就已经知道了。" with d

# game/events.rpy:35709
translate schinese Ayumi_friend_meeting_3ac57959:

    # ay "Living with her had its ups and downs, but eventually she was getting more and more toxic to me. And that, coupled with her problems and addictions meant that I had to make a choice. And I decided I had to distance myself from her."
    ay "跟她一起生活有起有落，但渐渐地，她对我越来越有害。再加上她自己的问题和那些瘾，我不得不做出选择。我决定跟她保持距离。"

# game/events.rpy:35710
translate schinese Ayumi_friend_meeting_9ca12b75:

    # ay "When I was invited to ReLive Academy, I saw it as an opportunity for me to do so and finally be able to move on."
    ay "当我收到ReLive学院的邀请时，我把它当成一个机会，正好能这么做，也终于可以翻篇了。"

# game/events.rpy:35714
translate schinese Ayumi_friend_meeting_40619953:

    # ay "{xpr}*sigh*{/xpr}Yet... Here I am." with d
    ay "{xpr}*叹气*{/xpr}结果……我现在在这儿。" with d

# game/events.rpy:35718
translate schinese Ayumi_friend_meeting_73ea4581:

    # mc "What about your parents? Have you never thought about going back?" with d
    mc "那你父母呢？你没想过回去吗？" with d

# game/events.rpy:35720
translate schinese Ayumi_friend_meeting_b30fb88d:

    # ay "No, I can't do that." with d
    ay "不，我做不到。" with d

# game/events.rpy:35722
translate schinese Ayumi_friend_meeting_43c77bcb:

    # mc "Because your father wouldn't accept you back? That seems a bit harsh of him." with d
    mc "因为你父亲不会接受你回去？他这么做也太狠了点。" with d

# game/events.rpy:35724
translate schinese Ayumi_friend_meeting_051f3aa6:

    # ay "That's not it." with d
    ay "不是那样。" with d

# game/events.rpy:35725
translate schinese Ayumi_friend_meeting_e782959b:

    # ay "He probably does want me to go back, but I'd have to accept that he was right after all and it would end up being just as miserable as living with [nat]."
    ay "他大概确实希望我回去，但那意味着我得承认他终究是对的，结果只会跟跟[nat]住在一起一样痛苦。"

# game/events.rpy:35727
translate schinese Ayumi_friend_meeting_dde5bca1:

    # mc "Does he know about your current situation at least?" with d
    mc "那他至少知道你现在的处境吗？" with d

# game/events.rpy:35729
translate schinese Ayumi_friend_meeting_f69dc1d0:

    # ay "Kind of. We haven't spoken for a few years now, but I can tell he sends some of the people that work for him to spy on me from time to time." with d
    ay "算是知道吧。我们已经好几年没说过话了，但我看得出来，他时不时会派手下的人来监视我。" with d

# game/events.rpy:35734
translate schinese Ayumi_friend_meeting_4b8cd6e1:

    # ay "Anyway, I don't want to talk about him. That's a topic I'm not ready to revisit." with d
    ay "总之，我不想谈他。这个话题我还没准备好重新面对。" with d

# game/events.rpy:35736
translate schinese Ayumi_friend_meeting_25a3c86e:

    # mc "Fair enough." with d
    mc "行吧。" with d

# game/events.rpy:35752
translate schinese Ayumi_friend_meeting_c5a528fa:

    # ay "This is ours, we should get going..." with d
    ay "到了，我们该走了……" with d

# game/events.rpy:35765
translate schinese Ayumi_friend_meeting_e3101bc0:

    # mc "So, this is her neighborhood?" with d
    mc "这就是她住的街区？" with d

# game/events.rpy:35768
translate schinese Ayumi_friend_meeting_971f37b1:

    # ay "Yes, we're nearly there. There's a big residential building just around that block." with d
    ay "对，快到了。拐过那个街区有一栋大型公寓楼。" with d

# game/events.rpy:35771
translate schinese Ayumi_friend_meeting_9db39a29:

    # mc "I gotta say, it's a bit underwhelming compared to what I had in mind." with d
    mc "得说啊，跟我想象中比有点让人失望。" with d

# game/events.rpy:35774
translate schinese Ayumi_friend_meeting_549e68e3:

    # ay "What were you expecting it to be?" with d
    ay "你原本以为是什么样？" with d

# game/events.rpy:35779
translate schinese Ayumi_friend_meeting_1e40f706:

    # mc "I don't know, the way you spoke about it made it seem like we were going in to some Yakuza territory or something like that." with dd
    mc "不知道，你说话那架势，搞得我们像是要闯进什么极道地盘似的。" with dd

# game/events.rpy:35782
translate schinese Ayumi_friend_meeting_87671879:

    # ay "It... {i}is.{/i}" with d
