translate schinese gym_intro_9ec61b49:

    # mar "Or else I'll send you to the Principal!"
    mar "不然我就把你送去理事长那儿！"

# game/script.rpy:3828
translate schinese gym_intro_7ca9775f:

    # ha "Bro. The Principal is right there..."
    ha "哥们儿，理事长就在那儿呢……"

# game/script.rpy:3829
translate schinese gym_intro_77b4f976:

    # ha "But alright... alright... I'll behave."
    ha "但是好吧……好吧……我会守规矩的。"

# game/script.rpy:3831
translate schinese gym_intro_f5c133b3:

    # mar "You should apologize to Mr. [mc] now!"
    mar "你现在该向[mc]先生道歉！"

# game/script.rpy:3833
translate schinese gym_intro_adc6ab0d:

    # ha "Fine..."
    ha "……好吧。"

# game/script.rpy:3837
translate schinese gym_intro_a0dc36d5:

    # ha "Hey, man, if you pick me I'll apologize." with d
    ha "喂，哥们，挑我的话我就道歉。" with d

# game/script.rpy:3840
translate schinese gym_intro_a0b5f66f:

    # mar "[ha]!" with hpunch
    mar "[ha]!" with hpunch

# game/script.rpy:3842
translate schinese gym_intro_631f14d9:

    # ha "What more do you want, dude?!"
    ha "你还想怎样，老兄？！"

# game/script.rpy:3844
translate schinese gym_intro_5fff9d5b:

    # mar "Don't play dumb with me! Apologi-..."
    mar "别跟我装傻！道——"

# game/script.rpy:3845
translate schinese gym_intro_81f71e54:

    # mc "... [mar].{p}It's fine." with dquick
    mc "……[mar]。{p}没关系。" with dquick

# game/script.rpy:3847
translate schinese gym_intro_dd02c182:

    # mar "{xpr}*sigh*{/xpr} Sure thing, boss..."
    mar "{xpr}*叹气*{/xpr}好的老板……"

# game/script.rpy:3848
translate schinese gym_intro_4c45014a:

    # mc "Seems like I have a fourth option now..."
    mc "看来我多了一个第四选项……"

# game/script.rpy:3849
translate schinese gym_intro_47026035:

    # mc "And that one is [ha], right?"
    mc "就是[ha]，对吧？"

# game/script.rpy:3850
translate schinese gym_intro_440c029a:

    # k "Exactly, sir. [haruka.surname] [haruka.name]."
    k "正是，先生。[haruka.surname][haruka.name]。"

# game/script.rpy:3851
translate schinese gym_intro_1c4ba3ea:

    # k "And like I explained in the presentation earlier, she is one of our main targets in the Academy, so she's a top priority of our program."
    k "就像我刚才说明时讲的，她是学院的主要目标之一，所以是我们项目的最高优先事项。"

# game/script.rpy:3852
translate schinese gym_intro_8aa28c2d:

    # mc "Yeah, I remember that."
    mc "嗯，我记得。"

# game/script.rpy:3853
translate schinese gym_intro_ed532887:

    # mc "You said she was an Internet celebrity? Something like that, right?"
    mc "你说她以前是网络红人？大概是这个意思吧？"

# game/script.rpy:3854
translate schinese gym_intro_e1946810:

    # k "Correct."
    k "正确。"

# game/script.rpy:3855
translate schinese gym_intro_2bf0bbd5:

    # k "Miss [ha] is a very popular student among our viewers."
    k "[ha]小姐在我们的观众中非常受欢迎。"

# game/script.rpy:3856
translate schinese gym_intro_e9e47514:

    # k "And, of course, being one of our priority targets, it would be an obvious choice for you to focus your efforts on her."
    k "而且，作为优先目标之一，你把精力集中在她身上Obviously是个绝妙的选择。"

# game/script.rpy:3857
translate schinese gym_intro_64cd335b:

    # k "It would seem that right now is an opportunity to do so."
    k "眼下似乎就是个好机会。"

# game/script.rpy:3858
translate schinese gym_intro_23356dc8:

    # k "And, of course, the Academy President left instructions that it would be wise for you to maximize your interactions with these targets."
    k "当然，学院理事长也留下指示：明智的做法是让你与这些目标的互动次数最大化。"

# game/script.rpy:3859
translate schinese gym_intro_999a66f8:

    # k "But I digress, I don't want to influence your decisions, sir."
    k "不过我说岔了，先生，我并不想影响您的决定。"

# game/script.rpy:3860
translate schinese gym_intro_84f16542:

    # mc "Okay..."
    mc "好……"

# game/script.rpy:3862
translate schinese gym_intro_9a923e5d:

    # mar "Alright, Boss!" with d
    mar "好了，老板！" with d

# game/script.rpy:3864
translate schinese gym_intro_b914a7a4:

    # mar "Seems like there's four options for you!" with d
    mar "看来您有四个选项！" with d

# game/script.rpy:3865
translate schinese gym_intro_85e8c620:

    # mar "I can already tell you're gonna be popular with the girls here! Haha!"
    mar "我敢肯定您会在这儿很吃香的！哈哈！"

# game/script.rpy:3866
translate schinese gym_intro_0c05b62f:

    # mar "Pick one and let's begin!"
    mar "挑一个，开始吧！"

# game/script.rpy:3874
translate schinese gym_intro_a5b50916:

    # k "Some of our students will be reluctant to do these types of activities with you, sir. It is only natural." with d
    k "先生，我们有些学生不太愿意和您做这类活动，这是很自然的。" with d

# game/script.rpy:3875
translate schinese gym_intro_b6ad635d:

    # k "It would seem that [nan] possesses a somewhat {i}pure{/i} mindset and wouldn't accept this so easily."
    k "看来[nan]多少有点{i}纯洁{/i}的心态，不会这么轻易接受。"

# game/script.rpy:3876
translate schinese gym_intro_8bb899fa:

    # k "However, I'm sure the other girls will not refuse."
    k "不过我敢肯定其他女孩不会拒绝。"

# game/script.rpy:3878
translate schinese gym_intro_7d47e088:

    # mc "Hmm... Well, let's see if you're right about that."
    mc "嗯……好吧，那就看看你说的对不对。"

# game/script.rpy:3886
translate schinese gym_intro_0b7eea1b:

    # mc "I'll pick you." with d
    mc "我选你。" with d

# game/script.rpy:3887
translate schinese gym_intro_906e13ac:

    # mc "[nan], right?"
    mc "[nan]，对吧？"

# game/script.rpy:3889
translate schinese gym_intro_c5d574f4:

    # nan "{i}Eeh?!{/i} Why me?" with d
    nan "{i}诶？！{/i}为什么是我？" with d

# game/script.rpy:3891
translate schinese gym_intro_6920c952:

    # mc "You don't want to?"
    mc "你不愿意？"

# game/script.rpy:3895
translate schinese gym_intro_7c898615:

    # nan "No! It's not that..."
    nan "不！不是那个意思……"

# game/script.rpy:3896
translate schinese gym_intro_81e82441:

    # nan "It's just that I'm not feeling very well right now."
    nan "只是我现在身体有点不舒服。"

# game/script.rpy:3898
translate schinese gym_intro_9d6a71e1:

    # mct "(I guess she doesn't want to do this with me.)"
    mct "（我猜她是不想和我一起做这个。）"

# game/script.rpy:3900
translate schinese gym_intro_b3ac09ef:

    # mc "Don't worry, I'll pick someone else."
    mc "别担心，我另选一个。"

# game/script.rpy:3901
translate schinese gym_intro_f916760e:

    # mc "You can pair up with another one of the girls."
    mc "你可以和别的女生搭档。"

# game/script.rpy:3903
translate schinese gym_intro_57c4200a:

    # nan "... Okay."
    nan "……好吧。"

# game/script.rpy:3911
translate schinese gym_intro_660aa653:

    # mc "No, thanks. You can do your thing, [mar]." with d
    mc "不用了，谢谢。[mar]，你自己来吧。" with d

# game/script.rpy:3912
translate schinese gym_intro_aa0e1f78:

    # mc "I'll just sit back here and watch it."
    mc "我就在这儿看着。"

# game/script.rpy:3915
translate schinese gym_intro_113c2297:

    # mar "... Okay, Boss!" with d
    mar "……好，老板！" with d

# game/script.rpy:3916
translate schinese gym_intro_291c9135:

    # mar "I'll be here, if you need me!"
    mar "有需要就叫我！"

# game/script.rpy:3918
translate schinese gym_intro_64074c07:

    # mar "Come on, everyone! Let's stretch those muscles!" with d
    mar "来吧大家！把肌肉拉伸开！" with d

# game/script.rpy:3919
translate schinese gym_intro_5f377ea0:

    # mar "I don't want anyone complaining about cramps later!"
    mar "我可不想等下有人抱怨抽筋！"

# game/script.rpy:3922
translate schinese gym_intro_df425ca6:

    # mar "Stretch those legs!" with d
    mar "把腿伸展开！" with d

# game/script.rpy:3923
translate schinese gym_intro_b9081192:

    # mar "Keep at it!"
    mar "坚持住！"

# game/script.rpy:3926
translate schinese gym_intro_5133445a:

    # mar "Go go go!" with d
    mar "冲啊冲啊！" with d

# game/script.rpy:3927
translate schinese gym_intro_bb5c9bb7:

    # mar "Run like your life depends on it!"
    mar "拼命地跑！"

# game/script.rpy:3928
translate schinese gym_intro_b530bc18:

    # mar "What if there's a creep running after you, huh!?"
    mar "万一后面有个变态在追你呢，嗯！？"

# game/script.rpy:3929
translate schinese gym_intro_74045301:

    # mar "Would you run like a bunch of soft dolls? I dont think so!"
    mar "你还能像一群软绵绵的布娃娃一样跑吗？我可不信！"

# game/script.rpy:3932
translate schinese gym_intro_b80fc60c:

    # mar "Go after her, [nan], don't let her get away with it!" with d
    mar "[nan]，追上去，别让她跑了！" with d

# game/script.rpy:3933
translate schinese gym_intro_0481a676:

    # mar "Chop her legs, tackle! Tackle! Tackle!"
    mar "砍她的腿！冲撞！冲撞！冲撞！"

# game/script.rpy:3936
translate schinese gym_intro_b18b37b5:

    # mar "Goal!" with vpunch
    mar "进球！" with vpunch

# game/script.rpy:3937
translate schinese gym_intro_3ce4dee8:

    # mar "Good job, [yun]!"
    mar "干得好，[yun]！"

# game/script.rpy:3938
translate schinese gym_intro_a2187fa3:

    # mar "You left [nan] behind you!"
    mar "你把[nan]甩在后面了！"

# game/script.rpy:3939
translate schinese gym_intro_07a73f97:

    # mar "That's what I like to see!"
    mar "这才是我想看到的！"

# game/script.rpy:3942
translate schinese gym_intro_ef5901e3:

    # mar "So... That was it!" with d
    mar "那么……就是这样！" with d

# game/script.rpy:3943
translate schinese gym_intro_187f5440:

    # mar "I hope everything looked fine for you, Boss!"
    mar "希望一切看起来还不错，老板！"

# game/script.rpy:3945
translate schinese gym_intro_a83a5e07:

    # mc "Yeah, It seems like you got everything under control here."
    mc "是啊，看来你在这里把一切都掌控住了。"

# game/script.rpy:3946
translate schinese gym_intro_7ead8d8c:

    # mc "The girls looked very much in shape."
    mc "那些女孩看起来状态非常好。"

# game/script.rpy:3948
translate schinese gym_intro_72218192:

    # mar "Hah! Yeah, they are!..."
    mar "哈！是啊，她们确实很棒！……"

# game/script.rpy:3949
translate schinese gym_intro_3436b122:

    # mar "They're a fine group of girls!"
    mar "是一群很棒的姑娘！"

# game/script.rpy:3950
translate schinese gym_intro_e84bdb39:

    # mar "So, I guess that means I won't get fired this week, huh!"
    mar "所以我猜我这周不会被开除了，哈！"

# game/script.rpy:3951
translate schinese gym_intro_8781977a:

    # mar "I'm glad I made a good impression!"
    mar "太好了，我给人的印象不错！"

# game/script.rpy:3953
translate schinese gym_intro_37771e43:

    # mar "Anyway... If you feel like visiting again, feel free to come over and watch us."
    mar "总之……如果你想再来参观，随时过来看我们都行。"

# game/script.rpy:3954
translate schinese gym_intro_4212c311:

    # mar "And, if you wish, maybe we could make space for you to participate in some way."
    mar "而且，如果你愿意，也许我们可以给你留点位置，让你也参与一下。"

# game/script.rpy:3955
translate schinese gym_intro_188fa3de:

    # mar "You're still a pretty young guy, right? I don't think there's anything wrong with getting those muscles loose!"
    mar "你还很年轻，对吧？我觉得活动活动肌肉没什么不好的！"

# game/script.rpy:3957
translate schinese gym_intro_fb805947:

    # mc "Yeah, I'll consider it!"
    mc "嗯，我会考虑的！"

# game/script.rpy:3958
translate schinese gym_intro_7d0b83ba:

    # mc "I guess that's it! Thanks for letting us watch your class, [mar]."
    mc "那就到这里！谢谢你让我们看你的课，[mar]。"

# game/script.rpy:3960
translate schinese gym_intro_996e5fbd:

    # mar "Anytime, Boss!"
    mar "随时，老板！"

# game/script.rpy:3964
translate schinese gym_intro_878baa66:

    # k "Hm..." with dd
    k "嗯……" with dd

# game/script.rpy:3966
translate schinese gym_intro_2a8f2632:

    # mc "What is that look on your face?"
    mc "你脸上那是什么表情？"

# game/script.rpy:3967
translate schinese gym_intro_5cbe8ff5:

    # mc "Do you want to say something?"
    mc "有什么想说的吗？"

# game/script.rpy:3971
translate schinese gym_intro_06d558b1:

    # k "I have some thoughts on what just happened."
    k "我对刚刚发生的事有些想法。"

# game/script.rpy:3975
translate schinese gym_intro_753db8f8:

    # mc "Let's hear them."
    mc "说来听听。"

# game/script.rpy:3980
translate schinese gym_intro_b52087d7:

    # k "It is your first day here, I understand it."
    k "我理解，今天是你第一天。"

# game/script.rpy:3981
translate schinese gym_intro_65321caa:

    # k "You are supposed to see how our Academy operates and also have an understanding of our students' behavior."
    k "你本来应该看看我们学院是怎么运作的，也应该对我们学生的行为有所了解。"

# game/script.rpy:3982
translate schinese gym_intro_8385596f:

    # k "As a result, it is a valid strategy to take on a more passive role during this period."
    k "所以在这段时间里采取更被动的角色，也是合理的策略。"

# game/script.rpy:3983
translate schinese gym_intro_53f266f5:

    # k "However, while that could be a viable option, I believe you were presented with a great opportunity to do more than just observe."
    k "不过，虽然那是个可行的选项，但我认为你本可以得到一个远不止于旁观的机会。"

# game/script.rpy:3987
translate schinese gym_intro_76fb3929:

    # mc "You mean I should've taken part in [mar]'s class?"
    mc "你的意思是我本来应该参加[mar]的课？"

# game/script.rpy:3993
translate schinese gym_intro_e1946810_1:

    # k "Correct."
    k "没错。"

# game/script.rpy:3997
translate schinese gym_intro_235e65ed:

    # mc "... You really need to start using fewer words to say what you want to say."
    mc "……你真该学会用更少的字表达你想说的东西。"

# game/script.rpy:3998
translate schinese gym_intro_5d985aed:

    # mc "But, okay, I'll take note of that."
    mc "不过，好吧，我会记住的。"

# game/script.rpy:4002
translate schinese gym_intro_16153dc4:

    # k "Wonderful."
    k "很好。"

# game/script.rpy:4006
translate schinese gym_intro_cccd1286:

    # k "With that being said, let's continue."
    k "话虽如此，我们继续吧。"

# game/script.rpy:4013
translate schinese gym_intro_stretch_start_0bf5b1da:

    # mc "Let's do this." with d
    mc "开始吧。" with d

# game/script.rpy:4014
translate schinese gym_intro_stretch_start_898d18b3:

    # mc "You're [ri], right?"
    mc "你是[ri]，对吧？"

# game/script.rpy:4016
translate schinese gym_intro_stretch_start_81ca7ee0:

    # ri "Yes, that's me."
    ri "是，就是我。"

# game/script.rpy:4017
translate schinese gym_intro_stretch_start_b75a3229:

    # ri "I'm glad you chose me, Mr. [mc]."
    ri "很高兴您选我，[mc]先生。"

# game/script.rpy:4019
translate schinese gym_intro_stretch_start_4dc7a53f:

    # mc "Thanks. I saw that you were smiling at me... I guess you wanted me to pick you?"
    mc "谢谢。我看到你在对我笑……所以你是想让我选你吧？"

# game/script.rpy:4021
translate schinese gym_intro_stretch_start_8432ea23:

    # ri "I did... This class is a bit boring, to be honest... You being here can make this interesting..."
    ri "是的……说实话这堂课有点无聊……有你在会变得有趣……"

# game/script.rpy:4022
translate schinese gym_intro_stretch_start_10c7369a:

    # ri "... And, it would also leave someone in particular without a partner..."
    ri "……而且，这样也会让某个人没搭档……"

# game/script.rpy:4030
translate schinese gym_intro_stretch_start_f145595e:

    # mc "Hey, you're [yo], right?" with d
    mc "喂，你是[yo]，对吧？" with d

# game/script.rpy:4031
translate schinese gym_intro_stretch_start_43e1f613:

    # mc "I'll help you out with the stretches."
    mc "我来帮你做拉伸。"

# game/script.rpy:4033
translate schinese gym_intro_stretch_start_9c812433:

    # yo "{size=20}I-... Why... me?"
    yo "{size=20}我、……为什么、是我？"

# game/script.rpy:4035
translate schinese gym_intro_stretch_start_f8ad994a:

    # mc "... What?"
    mc "……什么？"

# game/script.rpy:4037
translate schinese gym_intro_stretch_start_a664b25d:

    # yo "Uhm... Nothing, sir. Y-yes, I'm [yo], pleasure to meet you..."
    yo "呃……没什么，先生。是、是的，我是[yo]，很高兴认识你……"

# game/script.rpy:4038
translate schinese gym_intro_stretch_start_25f4e0e7:

    # mc "No need to be so formal, [yo], you can call me [mc]."
    mc "不用这么拘谨，[yo]，叫我[mc]就行。"

# game/script.rpy:4040
translate schinese gym_intro_stretch_start_75f8073d:

    # yo "..."
    yo "……"

# game/script.rpy:4042
translate schinese gym_intro_stretch_start_ffdac6e3:

    # yo "Yes, [mc]."
    yo "好的，[mc]。"

# game/script.rpy:4047
translate schinese gym_intro_stretch_start_7a6097f1:

    # mc "Seeing as you were suddenly so eager to join in, I'll pick you." with d
    mc "看你刚才那么积极地想加入，我就选你了。" with d

# game/script.rpy:4049
translate schinese gym_intro_stretch_start_32d17abf:

    # ha "Nice!"
    ha "不错！"

# game/script.rpy:4053
translate schinese gym_intro_stretch_start_41098c07:

    # mar "Good pick, Boss!" with d
    mar "挑得好，老板！" with d

# game/script.rpy:4055
translate schinese gym_intro_stretch_start_1636aa0f:

    # mar "Uhm... Shit... Looks like my math was wrong. Someone will be without a pair."
    mar "呃……靠……看来我算错了。会有人没有搭档。"

# game/script.rpy:4058
translate schinese gym_intro_stretch_start_ad8c5b6b:

    # ha "Welp... Guess I'm gonna get back to my book..." with d
    ha "唉……我还是回去看书吧……" with d

# game/script.rpy:4060
translate schinese gym_intro_stretch_start_fcd5c8af:

    # mar "Wait, we can still make this work."
    mar "等等，还是有办法的。"

# game/script.rpy:4062
translate schinese gym_intro_stretch_start_22fe5b24:

    # ha "Meh... I changed my mind."
    ha "算了……我改主意了。"

# game/script.rpy:4063
translate schinese gym_intro_stretch_start_9c3a7b4b:

    # ha "And there's no pair for me, so I'm out."
    ha "反正也没人跟我搭档，我还是出局了。"

# game/script.rpy:4064
translate schinese gym_intro_stretch_start_964dff2e:

    # mar "Maybe I can be your pair?"
    mar "要不我来当你的搭档？"

# game/script.rpy:4065
translate schinese gym_intro_stretch_start_a301b149:

    # ha "Hah! Nice try, creep!"
    ha "哈！想得美，变态！"

# game/script.rpy:4066
translate schinese gym_intro_stretch_start_3de5f5a5:

    # mar "... Okay then."
    mar "……那好吧。"

# game/script.rpy:4070
translate schinese gym_intro_stretch_start_c342f220:

    # ri "It's always fun to see her frustrated." with d
    ri "看她受挫的样子总是很有趣。" with d

# game/script.rpy:4072
translate schinese gym_intro_stretch_start_32ef0bec:

    # mc "She doesn't look that mad."
    mc "她看起来没那么生气。"

# game/script.rpy:4073
translate schinese gym_intro_stretch_start_1a3f0999:

    # mc "And why would she be? Just because I didn't pick her?"
    mc "她为什么会生气？就因为我没选她？"

# game/script.rpy:4075
translate schinese gym_intro_stretch_start_2e7696c4:

