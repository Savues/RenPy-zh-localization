    # mc "{i}Argh{/i}!" with d
    mc "{i}啊呃{/i}！" with d

# game/script.rpy:5514
translate schinese delinquents_ayumi_1_e7bd60e5:

    # mc "I'm feeling stretched now after those exercises!"
    mc "做完那些运动，我现在浑身都舒展开了！"

# game/script.rpy:5515
translate schinese delinquents_ayumi_1_cdf98720:

    # mc "[marcus.name]'s class is... Interesting."
    mc "[marcus.name]的课真是……有意思。"

# game/script.rpy:5521
translate schinese delinquents_ayumi_1_e46f7268:

    # mc "So, where to next?" with d
    mc "那么，下一站去哪？" with d

# game/script.rpy:5522
translate schinese delinquents_ayumi_1_10b16b09:

    # mc "Don't I have to take a photo for the book or something like that?"
    mc "我不是还得去拍照，弄进那本书里之类的吗？"

# game/script.rpy:5526
translate schinese delinquents_ayumi_1_130e8119:

    # k "Not yet."
    k "还不到时候。"

# game/script.rpy:5527
translate schinese delinquents_ayumi_1_15eeaea0:

    # k "It's too early for that."
    k "太早了。"

# game/script.rpy:5531
translate schinese delinquents_ayumi_1_f10e1176:

    # k "At this time, there's usually a gap in our activities, some students are moving to different classrooms while others are socializing during this brief period."
    k "这个时段我们通常会有空档，一些学生在换教室，另一些则趁这短暂的空闲在社交。"

# game/script.rpy:5532
translate schinese delinquents_ayumi_1_0d18c591:

    # k "I believe it would be a good moment to walk around the Academy Grounds, just so that you could be familiarized with its layout."
    k "我想这正是逛逛校园的好时机，好让你熟悉这里的布局。"

# game/script.rpy:5536
translate schinese delinquents_ayumi_1_d22228c6:

    # mc "... Sure."
    mc "……好吧。"

# game/script.rpy:5537
translate schinese delinquents_ayumi_1_a097e43f:

    # mc "Sounds a little boring, to be honest, but alright."
    mc "说实话听着有点无聊，不过也行吧。"

# game/script.rpy:5541
translate schinese delinquents_ayumi_1_14012973:

    # k "Sometimes there will be idling periods that you might consider to be 'boring', sir."
    k "先生，有时候确实会有您觉得「无聊」的空闲时段。"

# game/script.rpy:5542
translate schinese delinquents_ayumi_1_7d0e05f9:

    # k "It's only natural."
    k "这很自然。"

# game/script.rpy:5546
translate schinese delinquents_ayumi_1_26b6078e:

    # k "In any occasion, follow me..."
    k "总之跟我来……"

# game/script.rpy:5549
translate schinese delinquents_ayumi_1_aaacf5b1:

    # "???" "... Hey." with dd
    "???" "……嘿。" with dd

# game/script.rpy:5551
translate schinese delinquents_ayumi_1_af531c41:

    # "{color=[k.who_args[color]]}[k]{/color} & {color=[mc.who_args[color]]}[mc]{/color}" "...?"
    "{color=[k.who_args[color]]}[k]{/color} & {color=[mc.who_args[color]]}[mc]{/color}" "……?"

# game/script.rpy:5554
translate schinese delinquents_ayumi_1_faa4a3a7:

    # k "... Miss [miy].{w} Do you need anything?" with d
    k "……[miy]小姐。{w}您有什么事吗？" with d

# game/script.rpy:5556
translate schinese delinquents_ayumi_1_41bf232b:

    # miy "Uhm... Not really."
    miy "呃……没什么。"

# game/script.rpy:5561
translate schinese delinquents_ayumi_1_f0558edb:

    # miy "But, I saw those annoying dudes in that alley, and they were messing with [ay]."
    miy "不过，我看到那条巷子里有几个讨厌的家伙在纠缠[ay]。"

# game/script.rpy:5562
translate schinese delinquents_ayumi_1_20875596:

    # miy "You should probably go there... or... I don't know...?"
    miy "您也许应该去那边看看……或者……我也不知道……？"

# game/script.rpy:5566
translate schinese delinquents_ayumi_1_3a764130:

    # k "By 'Annoying Dudes', I assume you mean [sou] and the others?"
    k "您说的「讨厌的家伙」，是指[sou]他们几个吧？"

# game/script.rpy:5568
translate schinese delinquents_ayumi_1_3b10e871:

    # miy "Yeah..."
    miy "是……"

# game/script.rpy:5570
translate schinese delinquents_ayumi_1_0f1f9ff3:

    # miy "..."
    miy "……"

# game/script.rpy:5572
translate schinese delinquents_ayumi_1_7382c9bf:

    # miy "Anyway... That's it..."
    miy "总之……就是这样……"

# game/script.rpy:5576
translate schinese delinquents_ayumi_1_1753fd49:

    # miy "... Bye."
    miy "……再见。"

# game/script.rpy:5577
translate schinese delinquents_ayumi_1_88ae75e6:

    # k "Of course."
    k "当然。"

# game/script.rpy:5582
translate schinese delinquents_ayumi_1_ef045802:

    # mc "Now that sounds more interesting than just walking around." with d
    mc "这听起来可比随便逛逛有意思多了。" with d

# game/script.rpy:5583
translate schinese delinquents_ayumi_1_2db3f33f:

    # mc "I think we should go there."
    mc "我觉得我们应该去那边。"

# game/script.rpy:5587
translate schinese delinquents_ayumi_1_33fccf3e:

    # k "Yes, I believe you are correct."
    k "是的，我也认为您说得对。"

# game/script.rpy:5588
translate schinese delinquents_ayumi_1_4dbbc1bb:

    # k "Let us make our way there then."
    k "那我们就去那边吧。"

# game/script.rpy:5598
translate schinese delinquents_ayumi_1_90d2fdd5:

    # mc "What's happening over there?" with d
    mc "那边发生了什么？" with d

# game/script.rpy:5602
translate schinese delinquents_ayumi_1_b42c2b00:

    # k "This is one of our most problematic group of students in the Academy."
    k "这是学院里最麻烦的一群学生之一。"

# game/script.rpy:5606
translate schinese delinquents_ayumi_1_37c2ac4f:

    # k "That one is [soushi.surname] [soushi.name].{w} He is the presumed leader of this group." with d
    k "那位是[soushi.surname][soushi.name]。{w}他是这群人里大概是头目的那个。" with d

# game/script.rpy:5610
translate schinese delinquents_ayumi_1_8994f058:

    # k "The one with the larger build is [izo.surname] [izo.name]. He mostly acts as an enforcer to [sou]'s demands." with d
    k "体格更壮的那个是[izo.surname][izo.name]。他基本上是在执行[sou]的要求，充当打手。" with d

# game/script.rpy:5614
translate schinese delinquents_ayumi_1_4a95b42b:

    # k "And the last one is [ryoichi.surname] [ryoichi.name]. Who mostly just tags along in an effort to belong to the group." with d
    k "最后那位是[ryoichi.surname][ryoichi.name]。他基本上只是为了能融入圈子才跟着一起混。" with d

# game/script.rpy:5618
translate schinese delinquents_ayumi_1_84f16542:

    # mc "Okay..."
    mc "好……"

# game/script.rpy:5619
translate schinese delinquents_ayumi_1_c696c0c3:

    # mc "And why are they harassing [ay]?"
    mc "他们为什么要找[ay]的麻烦？"

# game/script.rpy:5620
translate schinese delinquents_ayumi_1_b45ccb6b:

    # mc "She doesn't seem the type to let these people get the upper hand."
    mc "她看起来不像是会让这帮人占上风的人。"

# game/script.rpy:5622
translate schinese delinquents_ayumi_1_6745f6aa:

    # mc "And should we do something about it?"
    mc "那我们要不要做点什么？"

# game/script.rpy:5626
translate schinese delinquents_ayumi_1_2084c8a1:

    # k "Whether or not we should do something about it, it's up to you, sir."
    k "先生，要不要出手，由您决定。"

# game/script.rpy:5628
translate schinese delinquents_ayumi_1_31252179:

    # k "As to why they're targeting [ay], we do not know for certain."
    k "至于他们为什么针对[ay]，我们并不确切知道。"

# game/script.rpy:5629
translate schinese delinquents_ayumi_1_90eb93d0:

    # k "I believe, however, that [sou] and [ay] have already known each other before their arrival at our Academy."
    k "不过我相信，[sou]和[ay]在来到我们学院之前就已经认识了。"

# game/script.rpy:5633
translate schinese delinquents_ayumi_1_08492a71:

    # mc "Yeah, that's what it looks like..."
    mc "对，看起来就是这样……"

# game/script.rpy:5638
translate schinese delinquents_ayumi_1_44b95e36:

    # sou "... When [iz] and I were invited to this shitty place, we thought it would just be a boring social reforming program or some shit like that." with d
    sou "……当初[iz]和我被邀请到这个破地方时，我们还以为只是什么无聊的社会性改造项目之类的屁事。" with d

# game/script.rpy:5639
translate schinese delinquents_ayumi_1_a190ba28:

    # sou "So I thought: 'Eh, at least they're paying us to study here, right?'"
    sou "所以我当时就想：「反正他们付钱让我们在这儿读书，对吧？」"

# game/script.rpy:5640
translate schinese delinquents_ayumi_1_eb3dde61:

    # sou "'Easy Money'."
    sou "「轻松钱」。"

# game/script.rpy:5641
translate schinese delinquents_ayumi_1_17ef5e9f:

    # sou "But then, the other day I saw you strutting around the place... The always respectable and dignified [ayumi.surname] [ayumi.name]."
    sou "但后来，前几天我看见你在这地方神气活现地走来走去……那个永远体面端庄的[ayumi.surname][ayumi.name]。"

# game/script.rpy:5642
translate schinese delinquents_ayumi_1_ce815591:

    # sou "What a fucking surprise."
    sou "真他妈是个惊喜。"

# game/script.rpy:5643
translate schinese delinquents_ayumi_1_f743ad08:

    # sou "Seems like they think you're as fucked up as we are... Heh."
    sou "看来他们觉得你也跟我们一样烂……呵。"

# game/script.rpy:5644
translate schinese delinquents_ayumi_1_d30ba7d1:

    # sou "And so it seems this place has brought us together... again."
    sou "所以这地方又让我们聚到了一起……"

# game/script.rpy:5645
translate schinese delinquents_ayumi_1_85832266:

    # sou "I know you were trying to avoid me... and pretend that you didn't owe me..."
    sou "我知道你一直在躲着我……装作不欠我钱的样子……"

# game/script.rpy:5646
translate schinese delinquents_ayumi_1_658608c1:

    # sou "But eventually we would run in with each other, right?"
    sou "但我们迟早还是会碰上的，对吧？"

# game/script.rpy:5652
translate schinese delinquents_ayumi_1_5232568a:

    # ay "... Are you done with your little speech?"
    ay "……你那番小演说完了？"

# game/script.rpy:5653
translate schinese delinquents_ayumi_1_82936759:

    # ay "I bet you practiced that the entire week."
    ay "我敢说你练了整整一周。"

# game/script.rpy:5654
translate schinese delinquents_ayumi_1_dcc83a75:

    # ay "Probably took all your brain power to remember your lines."
    ay "光记住台词大概就费了你所有的脑细胞。"

# game/script.rpy:5658
translate schinese delinquents_ayumi_1_743ae1b8:

    # sou "You think you're pretty smart, huh?"
    sou "你以为自己很聪明，嗯？"

# game/script.rpy:5660
translate schinese delinquents_ayumi_1_37f3f970_2:

    # ay "..."
    ay "……"

# game/script.rpy:5665
translate schinese delinquents_ayumi_1_5d16feca:

    # sou "Well, you better stop acting tough and actually start to think your situation through..."
    sou "那你还不如别再装硬气，好好把自己的处境想清楚……"

# game/script.rpy:5666
translate schinese delinquents_ayumi_1_ed462672:

    # sou "'Cause it ain't looking good."
    sou "因为看起来可不妙。"

# game/script.rpy:5670
translate schinese delinquents_ayumi_1_4a8e7789:

    # ay "... What do you want this time, [sou]?"
    ay "……你这次想要什么，[sou]？"

# game/script.rpy:5674
translate schinese delinquents_ayumi_1_46f14496:

    # sou "There we go... Now you're starting to be a little more understanding." with d
    sou "这就对了……你现在开始稍微讲点道理了。" with d

# game/script.rpy:5680
translate schinese delinquents_ayumi_1_cd90d70d:

    # mc "Yeah, they definitely got some history together..." with d
    mc "对，他们两个肯定有些旧怨……" with d

# game/script.rpy:5681
translate schinese delinquents_ayumi_1_84913fd3:

    # mc "But he's getting way too close to her now."
    mc "不过他现在靠她靠得太近了。"

# game/script.rpy:5686
translate schinese delinquents_ayumi_1_75c10c97:

    # k "Remember, sir. Since [ay] is one of our main targets, the board allows you to be more flexible about how you decide whether things are or aren't allowed to happen to her."
    k "请记住，先生。因为[ay]是我们的主要目标之一，董事会允许你在判断她身上哪些事可以发生、哪些不行时，拥有更大的弹性。"

# game/script.rpy:5687
translate schinese delinquents_ayumi_1_6ee1b9d1:

    # k "You are well within your rights to stop this encounter between [ay] and [sou]'s group, should you wish to."
    k "如果您愿意，您完全有权阻止[ay]和[sou]那伙人之间的这次接触。"

# game/script.rpy:5688
translate schinese delinquents_ayumi_1_98c9e8ac:

    # k "However, acquiring information about her could also be important, and this is an opportunity to do so."
    k "不过，获取关于她的情报可能也很重要，而这正是一个机会。"

# game/script.rpy:5690
translate schinese delinquents_ayumi_1_a06983ef:

    # k "Listening in to their conversation could also prove to be valuable."
    k "偷听她们的谈话也可能证明很有价值。"

# game/script.rpy:5691
translate schinese delinquents_ayumi_1_6abeba52:

    # k "Ultimately, however, it is your decision..."
    k "但最终，这得由您来决定……"

# game/script.rpy:5703
translate schinese delinquents_ayumi_1_1f666273:

    # mc "It could be important to learn more about [ay]." with d
    mc "多了解一些[ay]的情况可能很重要。" with d

# game/script.rpy:5704
translate schinese delinquents_ayumi_1_a0129497:

    # mc "Let's listen in for a bit."
    mc "我们就听一会儿吧。"

# game/script.rpy:5708
translate schinese delinquents_ayumi_1_80f91ba3:

    # k "Of course, sir."
    k "当然，先生。"

# game/script.rpy:5713
translate schinese delinquents_ayumi_1_967ccdbc:

    # sou "You know damn well what I want, [ay]." with d
    sou "你心里清楚得很我想要什么，[ay]。" with d

# game/script.rpy:5717
translate schinese delinquents_ayumi_1_8bafbff5:

    # ay "Not this again, [sou]..."
    ay "又来这套，[sou]……"

# game/script.rpy:5718
translate schinese delinquents_ayumi_1_d7da98b8:

    # ay "Haven't I given you enough money already?"
    ay "我给你的钱还不够吗？"

# game/script.rpy:5723
translate schinese delinquents_ayumi_1_1f1c4145:

    # mc "It seems [ay] is having some money issues..." with d
    mc "看来[ay]有点经济困难……" with d

# game/script.rpy:5724
translate schinese delinquents_ayumi_1_24dcde9b:

    # mc "And she owes money to this [sou] guy..."
    mc "而且她还欠这个[sou]的钱……"

# game/script.rpy:5728
translate schinese delinquents_ayumi_1_a18ce708:

    # k "That appears to be the case."
    k "看来确实如此。"

# game/script.rpy:5729
translate schinese delinquents_ayumi_1_6c06d240:

    # k "We do offer our students a weekly payment to attend our program."
    k "我们确实会给学生提供参加我们项目的每周报酬。"

# game/script.rpy:5730
translate schinese delinquents_ayumi_1_9b36fffb:

    # k "The amount is based on many factors, but the student's grades are a big part of that sum."
    k "金额取决于很多因素，但学生的成绩是其中很大一块。"

# game/script.rpy:5731
translate schinese delinquents_ayumi_1_9525e091:

    # k "This is done in an attempt to dissuade them from dropping out in order to find a job or pursue other means of generating income. And, of course, to encourage them to get good grades, in any way they can."
    k "这样做是为了劝阻她们辍学去找工作，或用其他方式赚钱。当然，也是为了鼓励她们用一切手段去拿好成绩。"

# game/script.rpy:5732
translate schinese delinquents_ayumi_1_8712c4b2:

    # k "However, considering that [ay] left her parents' house years ago, it would be logical to assume she doesn't have access to their larger-than-normal income."
    k "不过考虑到[ay]多年前就离开了父母家，合理地推测她现在没法再拿到那份远超普通人的收入。"

# game/script.rpy:5737
translate schinese delinquents_ayumi_1_a97e6bb3:

    # sou "You have given me money... Just not enough." with d
    sou "你给过我钱……只是不够多。" with d

# game/script.rpy:5742
translate schinese delinquents_ayumi_1_f2aac982:

    # sou "For starters, you could give me some of the cash you got from the Academy."
    sou "先从你从学院拿到的那些钱里分我一点开始吧。"

# game/script.rpy:5743
translate schinese delinquents_ayumi_1_bce14d32:

    # sou "I'm sure they're desperate to keep the genius [ay] as one of their students here, right?"
    sou "我敢肯定他们很想把天才[ay]留在这里当学生，对吧？"

# game/script.rpy:5744
translate schinese delinquents_ayumi_1_fedde293:

    # sou "Adds to the prestige of the place."
    sou "这样也能给学校增添声誉。"

# game/script.rpy:5748
translate schinese delinquents_ayumi_1_0c0aa5c8:

    # ay "... I can't do that, [sou]."
    ay "……我做不到，[sou]。"

# game/script.rpy:5749
translate schinese delinquents_ayumi_1_92ae30ae:

    # ay "I need that money."
    ay "我需要那笔钱。"

# game/script.rpy:5750
translate schinese delinquents_ayumi_1_f4fcd302:

    # ay "You know I don't live with her anymore... I have to pay my own rent now."
    ay "你知道我已经不跟她住了……现在房租得我自己付。"

# game/script.rpy:5755
translate schinese delinquents_ayumi_1_4cefef8b:

    # mc "'Her'?" with d
    mc "「她」？"with d

# game/script.rpy:5760
translate schinese delinquents_ayumi_1_7bc81192:

    # k "[ay]'s friend."
    k "[ay]的朋友。"

# game/script.rpy:5761
translate schinese delinquents_ayumi_1_af79f0db:

    # k "After she left her parents' house, she went on to live with a friend."
    k "她离开父母家之后，就和一位朋友住在一起了。"

# game/script.rpy:5766
translate schinese delinquents_ayumi_1_f8f5deea:

    # k "However, last I checked on [ay]'s information, she still lived at said friend's house."
    k "不过，我上次查[ay]的资料时，她还住在那个朋友家里。"

# game/script.rpy:5767
translate schinese delinquents_ayumi_1_f0ccd989:

    # k "It would seem the situation is different now."
    k "看来现在情况变了。"

# game/script.rpy:5773
translate schinese delinquents_ayumi_1_6586792f:

    # sou "How about you ask the Academy for more? I don't know..." with d
    sou "要不你再向学院多要一些？我也不知道……" with d

# game/script.rpy:5774
translate schinese delinquents_ayumi_1_debc5789:

    # sou "I'm sure you'll figure something out."
    sou "我相信你总能想出办法的。"

# game/script.rpy:5775
translate schinese delinquents_ayumi_1_bc6c9e46:

    # sou "You're a smart girl, right?"
    sou "你是个聪明的女孩，对吧？"

# game/script.rpy:5779
translate schinese delinquents_ayumi_1_1e0d1193:

    # sou "If not..."
    sou "如果不是的话……"

# game/script.rpy:5792
translate schinese delinquents_ayumi_1_6af663d6:

    # sou "... There's always another option." with d
    sou "……总还有别的选择。" with d

# game/script.rpy:5797
translate schinese delinquents_ayumi_1_8af236f5:

    # ay "Stop this, [sou]." with d
    ay "适可而止吧，[sou]。" with d

# game/script.rpy:5801
translate schinese delinquents_ayumi_1_9fedfe2b:

    # sou "Oh, come on... Don't act like you never thought about it...?"
    sou "哎，别这样嘛……别装作你从来没考虑过……？"

# game/script.rpy:5802
translate schinese delinquents_ayumi_1_8bf9155f:

    # sou "... That would be one way to deal with this problem."
    sou "……那倒是解决这个问题的办法之一。"

# game/script.rpy:5807
translate schinese delinquents_ayumi_1_14ba573b:

    # mc "It's clear they got some history." with d
    mc "很明显他们有些旧怨。" with d

# game/script.rpy:5808
translate schinese delinquents_ayumi_1_abbb72d9:

    # mc "But now he's just pushing it too far..."
    mc "但现在他实在太过分了……"

# game/script.rpy:5813
translate schinese delinquents_ayumi_1_ce6a8396:

    # k "Remember, sir. We can interrupt this if you don't want them harassing [ay]."
    k "请记住，先生。如果您不想让他们纠缠[ay]，我们可以打断他们。"

# game/script.rpy:5814
translate schinese delinquents_ayumi_1_f14e2c1b:

    # k "It's your decision."
    k "由您决定。"

# game/script.rpy:5833
translate schinese delinquents_ayumi_1_4a70ebd9:

    # ay "... No, I have never thought about it." with d
