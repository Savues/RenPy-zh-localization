translate schinese hallwaybg_71cfd71a:

    # k "Good morning, Miss [maiya.name]."
    k "早上好，[maiya.name]小姐。"

# game/script.rpy:1753
translate schinese hallwaybg_0c14f140:

    # mc "... Mr. Handsome? Thanks!"
    mc "……帅哥先生？谢啦！"

# game/script.rpy:1755
translate schinese hallwaybg_173a52c4:

    # v7 "{i}Heheee~{/i}"
    v7 "{i}嘿嘿嘿～{/i}"

# game/script.rpy:1757
translate schinese hallwaybg_01e27d34:

    # k "We should keep moving. The President is waiting." with d
    k "我们该继续往前走了。院长在等。" with d

# game/script.rpy:1758
translate schinese hallwaybg_ae0eed67:

    # v7 "{xpr}*whispering*{/xpr} Yup... You should..."
    v7 "{xpr}*低语*{/xpr} 对……你、你该……"

# game/script.rpy:1759
translate schinese hallwaybg_6a72f23d:

    # mc "Oh, of course... Goodbye, [maiya.name]!"
    mc "哦，当然……再见，[maiya.name]！"

# game/script.rpy:1760
translate schinese hallwaybg_344155a9:

    # v7 "{xpr}(In English){/xpr}{i} Bye Bye~~{/i}"
    v7 "{xpr}（用英语）{/xpr}{i}拜拜～～{/i}"

# game/script.rpy:1762
translate schinese hallwaybg_8f153dc5:

    # k "As I was saying..." with d
    k "我刚才说到……" with d

# game/script.rpy:1824
translate schinese prologue_presidentmeeting_8893f634:

    # mc "Woah!{w} This is a cool office..." with d
    mc "哇！{w}这办公室真不错……" with d

# game/script.rpy:1825
translate schinese prologue_presidentmeeting_f3acedfc:

    # mc "Very different from the rest of the school."
    mc "跟学校里其他地方很不一样。"

# game/script.rpy:1827
translate schinese prologue_presidentmeeting_af1195b4:

    # k "Indeed.{w} The Academy President has excellent taste."
    k "确实。{w} 学院院长的品味一流。"

# game/script.rpy:1831
translate schinese prologue_presidentmeeting_9fe96b63:

    # mct "(The Academy President... I bet that's him.)" with d
    mct "（学院院长……我猜就是那位。）" with d

# game/script.rpy:1832
translate schinese prologue_presidentmeeting_7f8c6d5f:

    # mct "(Why does he have to sit facing away from us? Is he about to make a villain introduction?)"
    mct "（他为什么非得背对着我们坐？难道要来个反派自我介绍？）"

# game/script.rpy:1833
translate schinese prologue_presidentmeeting_d4050b6e:

    # mct "(The rest of the Academy seemed normal, but this office and this guy give some creepy vibes.)"
    mct "（学院其他地方看起来都正常，但这间办公室和这家伙透着股瘆人气息。）"

# game/script.rpy:1834
translate schinese prologue_presidentmeeting_2218f24e:

    # mct "(I knew this was some secret government stuff...)"
    mct "（我就知道这是政府机密之类的东西……）"

# game/script.rpy:1836
translate schinese prologue_presidentmeeting_5f8bc46e:

    # ap "Mr. [mc]..." with d
    ap "[mc]先生……" with d

# game/script.rpy:1838
translate schinese prologue_presidentmeeting_bb96d1fd:

    # ap "You're finally here... I have been anxiously waiting for our meeting to begin." with d
    ap "你终于来了……我一直焦急地等着这次会面开始。" with d

# game/script.rpy:1839
translate schinese prologue_presidentmeeting_ea9324db:

    # ap "Please... Take a seat."
    ap "请……坐。"

# game/script.rpy:1841
translate schinese prologue_presidentmeeting_416ee725:

    # k "You can sit over there, Mr. [mc]."
    k "您可以坐那边，[mc]先生。"

# game/script.rpy:1843
translate schinese prologue_presidentmeeting_0aacb704:

    # k "Here are the reports, Mr. President." with d
    k "院长，这是报告。" with d

# game/script.rpy:1844
translate schinese prologue_presidentmeeting_30021100:

    # ap "Good job, as always, Kiyomi."
    ap "做得好，和往常一样，清。"

# game/script.rpy:1845
translate schinese prologue_presidentmeeting_923e97a6:

    # mct "(Man... What a lucky guy, to have this hottie working for him...)"
    mct "（老兄……能让这种美女给他打工，真够走运的……）"

# game/script.rpy:1850
translate schinese prologue_presidentmeeting_d549be77:

    # ap "Welcome to ReLive Academy, Mr. [mc]." with dd
    ap "欢迎来到ReLive学院，[mc]先生。" with dd

# game/script.rpy:1852
translate schinese prologue_presidentmeeting_f12bdab7:

    # mct "(Welp... there it is. Textbook villain introduction.)" with d
    mct "（好吧……来了。教科书式的反派自我介绍。）" with d

# game/script.rpy:1854
translate schinese prologue_presidentmeeting_65432531:

    # ap "I believe [k] here gave you a tour of the facility before your arrival here. Correct?"
    ap "我记得在您来之前，[k]已经带您参观过这里了。对吗？"

# game/script.rpy:1855
translate schinese prologue_presidentmeeting_133c59df:

    # mc "Ah, yes..."
    mc "啊，是的……"

# game/script.rpy:1857
translate schinese prologue_presidentmeeting_f88b7d52:

    # mc "She did, and this place is quite something..."
    mc "是的，而且这个地方真不一般……"

# game/script.rpy:1859
translate schinese prologue_presidentmeeting_1dcab16b:

    # mc "It seems like a very hard task to reintegrate outcasts back into our education system, but from the looks of it, this place has everything needed to do so."
    mc "把这些边缘人重新纳入教育体系似乎是一项非常艰难的任务，不过看起来，这里具备所需的一切条件。"

# game/script.rpy:1860
translate schinese prologue_presidentmeeting_b08470fc:

    # ap "Yes...{w} It can be a challenging task."
    ap "是的……{w} 这会是项挑战。"

# game/script.rpy:1861
translate schinese prologue_presidentmeeting_9cbcde79:

    # mc "But, what I don't understand is why were you so keen on contacting me and offering help?"
    mc "但我不明白的是，你为什么这么急着联系我并主动提供帮助？"

# game/script.rpy:1862
translate schinese prologue_presidentmeeting_815008c5:

    # mc "Especially because of... you know. The incident at my previous school."
    mc "尤其因为……你懂的。我上一所学校的那件事。"

# game/script.rpy:1863
translate schinese prologue_presidentmeeting_6cf3594a:

    # ap "Well... This Academy {u}is{/u} a place for outcasts. Those that don't fit anywhere. And we offer a second chance for those with a stain in their past."
    ap "这个嘛……这所学院{u}就是{/u}为边缘人准备的地方。那些哪儿都不属于的人。而我们为过去有污点的人提供第二次机会。"

# game/script.rpy:1865
translate schinese prologue_presidentmeeting_2ffa32bc:

    # mct "(So they did call me because I was a failure...){p}(I don't know what I was expecting. I should've known...)"
    mct "（所以他们确实是因为我失败才找上门的……）{p}（我也不知道自己在期待什么。我早该明白……）"

# game/script.rpy:1866
translate schinese prologue_presidentmeeting_33fbfbea:

    # ap "..." with d
    ap "……" with d

# game/script.rpy:1867
translate schinese prologue_presidentmeeting_665028a5:

    # ap "However, that is not the only reason you are here."
    ap "不过，那并不是您来这里的原因。"

# game/script.rpy:1868
translate schinese prologue_presidentmeeting_2100706d:

    # ap "And certainly not the only reason you are being considered for a position here at our Academy."
    ap "也绝不是您被我们学院考虑录用的唯一原因。"

# game/script.rpy:1869
translate schinese prologue_presidentmeeting_0956a483:

    # mc "And that reason is...?"
    mc "那个原因是……？"

# game/script.rpy:1871
translate schinese prologue_presidentmeeting_0e5f928d:

    # mc "But I wanted to hear about the place from yourself."
    mc "不过我想先听听您自己谈谈这个地方。"

# game/script.rpy:1872
translate schinese prologue_presidentmeeting_40ee5c1b:

    # mc "You know... Since you own the place."
    mc "您知道……毕竟这里是你的。"

# game/script.rpy:1873
translate schinese prologue_presidentmeeting_a386fe7d:

    # ap "A small correction.{w} I don't 'own the place'. This is a project funded by our Board of Trustees, I merely pushed the project's idea forward. But more on that later..."
    ap "小小更正一下。{w} 我并不「拥有」这里。这是由我们董事会出资的项目，我只是把构想推动了而已。不过这个稍后再说……"

# game/script.rpy:1874
translate schinese prologue_presidentmeeting_dd568d38:

    # ap "I take it, since you weren't interested in the tour, that you want to hear the reason you're here, right?"
    ap "看来您对参观没兴趣，是想知道自己来这儿的原因吧？"

# game/script.rpy:1875
translate schinese prologue_presidentmeeting_1fbc5165:

    # mc "Yeah, that would be a great start to this meeting."
    mc "对，这会是这次会面的很好开端。"

# game/script.rpy:1876
translate schinese prologue_presidentmeeting_6fcedeb9:

    # ap "As you wish..."
    ap "如您所愿……"

# game/script.rpy:1878
translate schinese prologue_presidentmeeting_aa966556:

    # ap "You see... ReLive Academy is much more than what you think it is."
    ap "您要明白……ReLive学院远不止您以为的那么简单。"

# game/script.rpy:1879
translate schinese prologue_presidentmeeting_d15d608b:

    # ap "At first glance, you may think this is a normal place."
    ap "乍一看，您可能以为这是个普通的地方。"

# game/script.rpy:1880
translate schinese prologue_presidentmeeting_6e4690e2:

    # ap "But... Deep down, there is a different reality going on... One that is {u}much{/u} more interesting."
    ap "但……在更深处，存在着另一种现实……一个{u}有趣得多{/u}的现实。"

# game/script.rpy:1881
translate schinese prologue_presidentmeeting_b557a153:

    # mc "Which is...?"
    mc "什么现实……？"

# game/script.rpy:1882
translate schinese prologue_presidentmeeting_bf822ed7:

    # ap "We prepared a little... demonstration for you to see."
    ap "我们准备了一点……演示给您看。"

# game/script.rpy:1883
translate schinese prologue_presidentmeeting_6aa4a287:

    # ap "But these kinds of things require some preparation..."
    ap "不过这种事需要一些准备……"

# game/script.rpy:1885
translate schinese prologue_presidentmeeting_1afaac38:

    # ap "[k]...{w} Is everything in place for the planned encounter?" with d
    ap "[k]……{w} 计划中的接触准备就绪了吗？" with d

# game/script.rpy:1887
translate schinese prologue_presidentmeeting_1c6bc86f:

    # k "Yes, Mr. President. The targets are in the desired position, it should be starting at any moment now."
    k "是的，院长。目标已就位，随时可以开始。"

# game/script.rpy:1889
translate schinese prologue_presidentmeeting_3b9c04cc:

    # ap "Perfect. Then, Mr. [mc], we'll let you watch a little showing of what we planned for you."
    ap "很好。那么，[mc]先生，接下来请欣赏我们为您准备的小演出。"

# game/script.rpy:1890
translate schinese prologue_presidentmeeting_fc211e27:

    # ap "As the saying goes:{w} '{i}A picture is worth a thousand words.{/i}'"
    ap "俗话说：{w}『{i}一图胜千言。{/i}』"

# game/script.rpy:1900
translate schinese prologue_presidentmeeting_c3369918:

    # ap "Enjoy..." with dd
    ap "请欣赏……" with dd

# game/script.rpy:1903
translate schinese prologue_presidentmeeting_dbb78500:

    # mc "What's this? One of the cameras at the Academy?" with d
    mc "这是什么？学院里的某个摄像头？" with d

# game/script.rpy:1904
translate schinese prologue_presidentmeeting_a6b4f76c:

    # ap "Precisely."
    ap "正是。"

# game/script.rpy:1905
translate schinese prologue_presidentmeeting_71134d6b:

    # ap "Who are those in the video feed, Miss [k]?"
    ap "[k]小姐，画面里那两个人是谁？"

# game/script.rpy:1908
translate schinese prologue_presidentmeeting_908ba613:

    # k "This is one of our teachers, Mr. [hidetoshi.surname] [hidetoshi.name]. And the girl is one of the students, [yoko.surname] [yoko.name]."
    k "这位是我们的老师，[hidetoshi.surname][hidetoshi.name]先生。那个女孩是学生之一，[yoko.surname][yoko.name]。"

# game/script.rpy:1909
translate schinese prologue_presidentmeeting_bc9a1349:

    # mc "Is this live? Is there a reason why we're watching them?"
    mc "这是实时画面吗？我们为什么要看他们？"

# game/script.rpy:1912
translate schinese prologue_presidentmeeting_7b821944:

    # ap "The reason should be very clear in a moment..."
    ap "片刻之后您就会明白原因……"

# game/script.rpy:1914
translate schinese prologue_presidentmeeting_bf2e1984:

    # mc "That's... a little too close, isn't it?"
    mc "这……是不是太近了点？"

# game/script.rpy:1915
translate schinese prologue_presidentmeeting_c91bce68:

    # mc "Is he about to do what I'm thinking...?"
    mc "他是不是正要干我想的那件事……？"

# game/script.rpy:1917
translate schinese prologue_presidentmeeting_c1dff962:

    # mc "Oh..."
    mc "哦……"

# game/script.rpy:1918
translate schinese prologue_presidentmeeting_35e035db:

    # ap "{xpr}*chuckles*{/xpr} Just like we knew it would happen!"
    ap "{xpr}*轻笑*{/xpr} 果然和我们预想的一样！"

# game/script.rpy:1919
translate schinese prologue_presidentmeeting_b70ae6bc:

    # ap "Mr. [hi] is quite predictable, isn't he?"
    ap "[hi]先生很好预测，不是吗？"

# game/script.rpy:1920
translate schinese prologue_presidentmeeting_cb9183a6:

    # k "Once again you were right, Mr. President. Your insight is amazing."
    k "院长，您又说对了。您的洞察力真是惊人。"

# game/script.rpy:1921
translate schinese prologue_presidentmeeting_eec97ac9:

    # mct "(Poor bastard... At least there wasn't video evidence with me and [em].)"
    mct "（可怜的家伙……好在我和[em]没有留下视频证据。）"

# game/script.rpy:1922
translate schinese prologue_presidentmeeting_542076f4:

    # mc "So, am I watching this guy get fired live? That's why I'm here? I'll be a teacher in his position?" with d
    mc "所以，我是在实时看着这家伙被开除吗？这就是我来这里的原因？我要接替他的位置当老师？" with d

# game/script.rpy:1923
translate schinese prologue_presidentmeeting_0587ddca:

    # mc "I gotta say... This is a very creative job interview..."
    mc "我得说……这真是很有创意的求职面试……"

# game/script.rpy:1925
translate schinese prologue_presidentmeeting_0b60f6b2:

    # ap "Oh no... He's not getting fired for this. In fact, he's doing exactly what we wanted him to do!"
    ap "糟了……他不会因为这个被开除。事实上，他做的正是我们希望他做的事！"

# game/script.rpy:1926
translate schinese prologue_presidentmeeting_d2ee5c58:

    # ap "You see... Mr. [hi] was caught many times in situations like this in his previous schools. The man is quite a pervert. Although... A little bit careless."
    ap "您看……[hi]先生在之前的学校里多次被人撞见这种场面。这人是个大变态。虽然……有点不小心。"

# game/script.rpy:1928
translate schinese prologue_presidentmeeting_33e62fb9:

    # mc "Oh damn! So you're not stopping this?"
    mc "我靠！所以你不打算阻止？"

# game/script.rpy:1929
translate schinese prologue_presidentmeeting_a3adf586:

    # mc "He's about to... you know...?"
    mc "他就要……你懂的……？"

# game/script.rpy:1930
translate schinese prologue_presidentmeeting_4e3018f1:

    # ap "Yes, he is..."
    ap "是的，他就要……"

# game/script.rpy:1931
translate schinese prologue_presidentmeeting_a1d69457:

    # ap "However, Mr. [hi] is not the only pervert here..."
    ap "不过，[hi]先生并不是这里唯一的变态……"

# game/script.rpy:1932
translate schinese prologue_presidentmeeting_45a3ac7c:

    # ap "The girl also has some wicked desires... She constantly fantasizes about situations like this and you could say that she has some form of 'sexual addiction'..."
    ap "这个女孩也有不正常的欲望……她总是幻想这种场面，可以说有某种「性成瘾」……"

# game/script.rpy:1933
translate schinese prologue_presidentmeeting_fb3e2d90:

    # ap "She knows that Mr. [hi] looks at her in a manner of desire, and yet, she agreed to meet with the teacher in this secluded place, away from all the other students..."
    ap "她知道[hi]先生是用欲望的目光看她的，却还是同意和这位老师在这个远离其他学生的僻静地方见面……"

# game/script.rpy:1934
translate schinese prologue_presidentmeeting_95160710:

    # ap "She probably had hoped that something like this would happen."
    ap "她大概本来就盼着会发生这种事。"

# game/script.rpy:1935
translate schinese prologue_presidentmeeting_7488ddf8:

    # ap "And as you can see, [yo] is starting to enjoy this."
    ap "而您可以看到，[yo]开始享受起来了。"

# game/script.rpy:1936
translate schinese prologue_presidentmeeting_022df3ed:

    # ap "Can't you see the look in her face? She's ashamed, of course, but there's a desire there as well."
    ap "您没看到她脸上的表情吗？当然很羞耻，但其中也有渴望。"

# game/script.rpy:1937
translate schinese prologue_presidentmeeting_2a761023:

    # ap "And Mr. Hidetoshi is merely doing something we knew that she secretly wanted to happen."
    ap "而日下部先生只是在做一件我们早就知道她暗自期待会发生的事。"

# game/script.rpy:1938
translate schinese prologue_presidentmeeting_c946a676:

    # ap "Now that you've heard the context of our little planned encounter, do you wish to keep watching it, Mr. [mc]?"
    ap "既然您已经了解了我们这场小小安排的前因后果，[mc]先生，您还想继续看下去吗？"

# game/script.rpy:1939
translate schinese prologue_presidentmeeting_767aa80f:

    # ap "I assure you, there is more to come. Mr. [hi] will not be satisfied by just looking at the girl..."
    ap "我向您保证，后面还有。[hi]先生可不会满足于只是看着那个女孩……"

# game/script.rpy:1950
translate schinese Yoko_Prologue_H_Replay_f3644681:

    # mc "I think I've seen enough..." with d
    mc "我觉得我已经看够了……" with d

# game/script.rpy:1952
translate schinese Yoko_Prologue_H_Replay_c6d5a9e3:

    # ap "What a shame..." with d
    ap "真可惜……" with d

# game/script.rpy:1953
translate schinese Yoko_Prologue_H_Replay_fc3c45a7:

    # ap "I apologize if our presentation was not to your liking, Mr. [mc]."
    ap "很抱歉，[mc]先生，我们的展示没能让您满意。"

# game/script.rpy:1954
translate schinese Yoko_Prologue_H_Replay_cc30d33a:

    # ap "You can turn it off then, [k]."
    ap "那您现在可以关掉了，[k]。"

# game/script.rpy:1955
translate schinese Yoko_Prologue_H_Replay_00ad11f8:

    # k "Certainly, Mr. President."
    k "当然，理事长先生。"

# game/script.rpy:1970
translate schinese Yoko_Prologue_H_Replay_c0ca8832:

    # ap "So? How is the show?" with dd
    ap "那么？表演如何？" with dd

# game/script.rpy:1971
translate schinese Yoko_Prologue_H_Replay_266ddbfb:

    # mc "{xpr}Uhm...{/xpr} It's... quite something."
    mc "{xpr}呃……{/xpr}这……还真是不一般。"

# game/script.rpy:1972
translate schinese Yoko_Prologue_H_Replay_15f04b3a:

    # mc "But I still don't know what the point of it is?"
    mc "可我还是很不明白这的意义何在？"

# game/script.rpy:1974
translate schinese Yoko_Prologue_H_Replay_574b25ee:

    # mc "But why did you want to show me that?" with d
    mc "但你为什么想给我看这个？" with d

# game/script.rpy:1975
translate schinese Yoko_Prologue_H_Replay_8ae10ff3:

    # mc "What does that have to do with me?"
    mc "这跟我有什么关系？"

# game/script.rpy:1976
translate schinese Yoko_Prologue_H_Replay_621ea45a:

    # mc "And why did you want it to happen in the first place?"
    mc "而且你为什么一开始就想让这种事发生？"

# game/script.rpy:1979
translate schinese Yoko_Prologue_H_Replay_6e0acb9e:

    # ap "Heh..."
    ap "呵……"

# game/script.rpy:1980
translate schinese Yoko_Prologue_H_Replay_0bc837ea:

    # ap "As you can see here, our Academy has various cameras and microphones."
    ap "如你所见，我们的学院里装着各式各样的摄像机和麦克风。"

# game/script.rpy:1981
translate schinese Yoko_Prologue_H_Replay_97539daf:

    # ap "Many are in plain sight... But there are also some that are hidden."
    ap "许多就明晃晃地摆在那里……但也有一些是藏起来的。"

# game/script.rpy:1982
translate schinese Yoko_Prologue_H_Replay_d79096fe:

    # ap "And these cameras are constantly broadcasting their contents. Live, for those who are privileged enough to watch it... For a price, of course. This is still a business, after all."
    ap "而这些摄像机会持续不断地把画面直播出去。实时直播，给那些有资格观看的人……当然，是要付费的。毕竟这终究是一门生意。"

