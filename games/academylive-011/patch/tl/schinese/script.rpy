    ay "你想怎样？" with d

# game/script.rpy:5467
translate schinese delinquents_ayumi_1_fc02eb1f:

    # v7 "I just want to have a talk with an old friend!"
    v7 "我只是想和老朋友聊聊天！"

# game/script.rpy:5468
translate schinese delinquents_ayumi_1_46ec31c6:

    # v7 "Why are you so defensive, [ay]?"
    v7 "你干嘛这么防备，[ay]？"

# game/script.rpy:5469
translate schinese delinquents_ayumi_1_37f3f970:

    # ay "..."
    ay "……"

# game/script.rpy:5471
translate schinese delinquents_ayumi_1_7619752d:

    # ay "I don't have time for this..."
    ay "我没时间跟你扯这些……"

# game/script.rpy:5473
