    k "那是[nanako.surname][nan]。" with d

# game/script.rpy:3760
translate schinese gym_intro_74b7c7d9:

    # k "She is one of our most 'normal' students."
    k "她是我们最「正常」的学生之一。"

# game/script.rpy:3761
translate schinese gym_intro_1af9605c:

    # k "I confess there isn't much information about her that would make it possible to take advantage of."
    k "坦白说，关于她，并没有多少可以利用的信息。"

# game/script.rpy:3762
translate schinese gym_intro_a284f138:

    # k "She used to be a good student and a popular girl at her previous school."
