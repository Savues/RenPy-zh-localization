# game/new scripts/008/ayumi_talk_pre.rpy:29
translate schinese Ayumi_Talk_Pre_Soushi_Talk_c18a3d85:

    # k "Sir." with dd
    k "先生。" with dd

# game/new scripts/008/ayumi_talk_pre.rpy:31
translate schinese Ayumi_Talk_Pre_Soushi_Talk_0cbd0f80:

    # k "Miss [ay] has been looking for you. She says she needs to have a private conversation." with d
    k "[ay] 小姐一直在找您。她说有话想私下谈。" with d

# game/new scripts/008/ayumi_talk_pre.rpy:33
translate schinese Ayumi_Talk_Pre_Soushi_Talk_f9aa78cf:

    # mc "Has she?"
    mc "是吗？"

# game/new scripts/008/ayumi_talk_pre.rpy:34
translate schinese Ayumi_Talk_Pre_Soushi_Talk_ab21d2f7:

    # mc "Alright, call her in."
    mc "好，让她进来吧。"

# game/new scripts/008/ayumi_talk_pre.rpy:36
translate schinese Ayumi_Talk_Pre_Soushi_Talk_9424f73a:

    # k "She said she'll meet with you in the Study Group club room."
    k "她说会在学习小组的社团教室见您。"

# game/new scripts/008/ayumi_talk_pre.rpy:40
translate schinese Ayumi_Talk_Pre_Soushi_Talk_face9095:

    # mc "Huh... Okay, I'll head over there."
    mc "咦……好，我这就过去。"

# game/new scripts/008/ayumi_talk_pre.rpy:55
translate schinese Ayumi_Talk_Pre_Soushi_Talk_ca645ea1:

    # ay "[mc]. You came." with d
    ay "[mc]，你来了。" with d

# game/new scripts/008/ayumi_talk_pre.rpy:59
translate schinese Ayumi_Talk_Pre_Soushi_Talk_662a507a:

    # mc "[k] said you wanted to have a 'private conversation'?"
    mc "[k] 说想私下谈谈？"

# game/new scripts/008/ayumi_talk_pre.rpy:60
translate schinese Ayumi_Talk_Pre_Soushi_Talk_39df6013:

    # mc "What's it about? You seem a bit apprehensive."
    mc "是什么事？你看起来有点不安。"

# game/new scripts/008/ayumi_talk_pre.rpy:67
translate schinese Ayumi_Talk_Pre_Soushi_Talk_3c17292c:

    # ay "{xpr}*sigh*{/xpr} Surely you already know what's it about. [nat] and [sou]—It's all we've talked about lately." with d
    ay "{xpr}*叹气*{/xpr} 你应该已经知道是什么事了吧。[nat] 和 [sou]——最近我们谈的全是这个。" with d

# game/new scripts/008/ayumi_talk_pre.rpy:68
translate schinese Ayumi_Talk_Pre_Soushi_Talk_05e2384b:

    # ay "It must be getting tiresome for you."
    ay "对你来说应该也挺烦的。"

# game/new scripts/008/ayumi_talk_pre.rpy:70
translate schinese Ayumi_Talk_Pre_Soushi_Talk_c586a456:

    # mc "I could've guessed."
    mc "我猜也是。"

# game/new scripts/008/ayumi_talk_pre.rpy:74
translate schinese Ayumi_Talk_Pre_Soushi_Talk_24708729:

    # ay "To be more specific, I want to know what your next step is going to be. How are you going to deal with [sou] and when?"
    ay "说具体一点，我想知道你下一步打算怎么做。你打算怎么对付 [sou]，什么时候动手？"

# game/new scripts/008/ayumi_talk_pre.rpy:75
translate schinese Ayumi_Talk_Pre_Soushi_Talk_632bd632:

    # ay "You saw what happened last time."
    ay "上次发生的事你也看到了。"

# game/new scripts/008/ayumi_talk_pre.rpy:76
translate schinese Ayumi_Talk_Pre_Soushi_Talk_f336db72:

    # ay "I know it was my fault for letting him know what our plan is, but now I'm afraid he'll do something stupid. Either to me or [nat]."
    ay "我知道把我们的计划透露给他是我的错，但现在我怕他会做出什么蠢事来。不管是对我还是对 [nat]。"

# game/new scripts/008/ayumi_talk_pre.rpy:78
translate schinese Ayumi_Talk_Pre_Soushi_Talk_6dfad3fd:

    # mc "Yeah, that wasn't ideal."
    mc "嗯，那确实不太妙。"

# game/new scripts/008/ayumi_talk_pre.rpy:82
translate schinese Ayumi_Talk_Pre_Soushi_Talk_c41f95d1:

    # ay "I'm sorry."
    ay "对不起。"

# game/new scripts/008/ayumi_talk_pre.rpy:84
translate schinese Ayumi_Talk_Pre_Soushi_Talk_db3d8030:

    # mc "Don't worry, he was going to find out sooner or later."
    mc "别在意，他迟早都会发现的。"

# game/new scripts/008/ayumi_talk_pre.rpy:86
translate schinese Ayumi_Talk_Pre_Soushi_Talk_6fb5b6fe:

    # mc "But you're right, we might need to hasten things up a bit."
    mc "不过你说得对，我们可能得加快一点进度。"

# game/new scripts/008/ayumi_talk_pre.rpy:88
translate schinese Ayumi_Talk_Pre_Soushi_Talk_8fb1eb37:

    # ay "I agree."
    ay "我同意。"

# game/new scripts/008/ayumi_talk_pre.rpy:89
translate schinese Ayumi_Talk_Pre_Soushi_Talk_d87ea7de:

    # ay "So... How exactly?"
    ay "那么……具体要怎么做？"

# game/new scripts/008/ayumi_talk_pre.rpy:94
translate schinese Ayumi_Talk_Pre_Soushi_Talk_52b4fc19:

    # mc "Hm... Maybe it's time [sou] and I have a talk." with dd
    mc "嗯……也许是该我和 [sou] 好好谈一次了。" with dd

# game/new scripts/008/ayumi_talk_pre.rpy:96
translate schinese Ayumi_Talk_Pre_Soushi_Talk_7cdb0e3d:

    # ay "What does that mean?"
    ay "这是什么意思？"

# game/new scripts/008/ayumi_talk_pre.rpy:98
translate schinese Ayumi_Talk_Pre_Soushi_Talk_73286f9e:

    # mc "I was thinking of offering him some sort of deal. That way, we could solve all of our issues in a somewhat peaceful way, where everyone gains something out of it."
    mc "我在想给他开出一个条件。这样的话，我们就能比较和平地把所有问题解决掉，让每个人都能从中得到一些东西。"

# game/new scripts/008/ayumi_talk_pre.rpy:106
translate schinese Ayumi_Talk_Pre_Soushi_Talk_f9b5b747:

    # ay "A deal, you say? With [sou]?" with d
    ay "你说……条件？和 [sou]？" with d

# game/new scripts/008/ayumi_talk_pre.rpy:107
translate schinese Ayumi_Talk_Pre_Soushi_Talk_d9cb6c2d:

    # ay "That's not a good idea."
    ay "那可不是个好主意。"

# game/new scripts/008/ayumi_talk_pre.rpy:111
translate schinese Ayumi_Talk_Pre_Soushi_Talk_52e56559:

    # mc "Why not? If I can make it worth his while, I'm sure he'll at least think about it."
    mc "为什么不好？如果我能让他觉得划算，他肯定至少会考虑一下。"

# game/new scripts/008/ayumi_talk_pre.rpy:116
translate schinese Ayumi_Talk_Pre_Soushi_Talk_fdcd355c:

    # ay "And, I-if I may ask, what do you mean when you say 'worth his while'?"
    ay "那、那个，我能问一下吗？你说的「划算」是什么意思？"

# game/new scripts/008/ayumi_talk_pre.rpy:120
translate schinese Ayumi_Talk_Pre_Soushi_Talk_9fc280ee:

    # mc "It'd have to be something that would be of equal value to what [nat] means to him."
    mc "那东西的价值必须等同于 [nat] 对他的意义。"

# game/new scripts/008/ayumi_talk_pre.rpy:121
translate schinese Ayumi_Talk_Pre_Soushi_Talk_88615d09:

    # mc "I was thinking of giving him some 'academic benefits'. A permanent boost to his grades, strike removal, that sort of thing."
    mc "我在想给他一些「学业上的好处」。比如永久提升他的成绩、消除记过之类的。"

# game/new scripts/008/ayumi_talk_pre.rpy:125
translate schinese Ayumi_Talk_Pre_Soushi_Talk_2853c8fa:

    # ay "Do you think that'd be enough? I'm sure [sou] values [nat] way more than just the money she pays him."
    ay "你觉得这样够吗？[sou] 看重 [nat]，肯定远远超过她付给他的那些钱。"

# game/new scripts/008/ayumi_talk_pre.rpy:126
translate schinese Ayumi_Talk_Pre_Soushi_Talk_eeef4bd0:

    # ay "He likes using her to torment me. I don't think he'll give that up so easily."
    ay "他喜欢拿她来折磨我。我觉得他不会轻易放弃。"

# game/new scripts/008/ayumi_talk_pre.rpy:139
translate schinese Ayumi_Talk_Pre_Soushi_Talk_255f45c8:

    # mc "It would be a good offer, but if that doesn't work, there {i}are{/i} other possibilities I could think of." with d
    mc "那会是个不错的条件，但如果不管用，我还能想到{i}别的{/i}办法。" with d

# game/new scripts/008/ayumi_talk_pre.rpy:144
translate schinese Ayumi_Talk_Pre_Soushi_Talk_921274cb:

    # ay "And... W-what are these other possibilities?"
    ay "那、那个……还有什么别的办法？"

# game/new scripts/008/ayumi_talk_pre.rpy:148
translate schinese Ayumi_Talk_Pre_Soushi_Talk_e43892cb:

    # mc "That would be my plan B. We don't have to get into it now, but it's something equally tempting to him."
    mc "那就是我的 B 计划。我们现在不必细说，但对他说来同样诱人。"

# game/new scripts/008/ayumi_talk_pre.rpy:150
translate schinese Ayumi_Talk_Pre_Soushi_Talk_37f3f970:

    # ay "..."
    ay "……"

# game/new scripts/008/ayumi_talk_pre.rpy:152
translate schinese Ayumi_Talk_Pre_Soushi_Talk_29216901:

    # ay "I... see."
    ay "我……明白了。"

# game/new scripts/008/ayumi_talk_pre.rpy:156
translate schinese Ayumi_Talk_Pre_Soushi_Talk_1181e784:

    # ay "But, regarding your 'plan A'." with d
    ay "不过，关于你的「A 计划」。" with d

# game/new scripts/008/ayumi_talk_pre.rpy:159
translate schinese Ayumi_Talk_Pre_Soushi_Talk_e1995c8e:

    # mc "That's why I said it'd have to be worth his while. It wouldn't be a simple offer." with d
    mc "所以我才说，那必须让他觉得划算才行。不可能是个简单的条件。" with d

# game/new scripts/008/ayumi_talk_pre.rpy:163
translate schinese Ayumi_Talk_Pre_Soushi_Talk_8c5ecc7e:

    # ay "I see..."
    ay "我懂了……"

# game/new scripts/008/ayumi_talk_pre.rpy:164
translate schinese Ayumi_Talk_Pre_Soushi_Talk_915fa994:

    # ay "That hardly seems fair, though. To give such benefits to [sou] while others are struggling."
    ay "可这样也太不公平了。别人还在苦苦挣扎，却要给 [sou] 这样的好处。"

# game/new scripts/008/ayumi_talk_pre.rpy:169
translate schinese Ayumi_Talk_Pre_Soushi_Talk_23c2a1a2:

    # mc "It is what it is, unfortunately. We have to make some compromises."
    mc "可惜没办法。我们不得不做出一些妥协。"

# game/new scripts/008/ayumi_talk_pre.rpy:176
translate schinese Ayumi_Talk_Pre_Soushi_Talk_c9bb1f5a:

    # ay "I understand."
    ay "我明白。"

# game/new scripts/008/ayumi_talk_pre.rpy:184
translate schinese Ayumi_Talk_Pre_Soushi_Talk_62bb5797:

    # mc "Do you... have a better idea?"
    mc "你……有更好的办法吗？"

# game/new scripts/008/ayumi_talk_pre.rpy:188
translate schinese Ayumi_Talk_Pre_Soushi_Talk_b0a4ba82:

    # ay "..." with dd
    ay "……" with dd

# game/new scripts/008/ayumi_talk_pre.rpy:189
translate schinese Ayumi_Talk_Pre_Soushi_Talk_15e6319e:

    # mc "You do, don't you? I know what that face means."
    mc "你有的，对吧？我一看你的表情就知道。"

# game/new scripts/008/ayumi_talk_pre.rpy:191
translate schinese Ayumi_Talk_Pre_Soushi_Talk_72e31731:

    # ay "... M-maybe." with d
    ay "……也、也许吧。" with d

# game/new scripts/008/ayumi_talk_pre.rpy:193
translate schinese Ayumi_Talk_Pre_Soushi_Talk_ddf3237b:

    # mc "Let's hear it."
    mc "说来听听。"

# game/new scripts/008/ayumi_talk_pre.rpy:195
translate schinese Ayumi_Talk_Pre_Soushi_Talk_e91d3e79:

    # ay "N-no. It's... it's stupid. It would only make things worse."
    ay "不、不是。那个……那个很蠢，只会让事情更糟。"

# game/new scripts/008/ayumi_talk_pre.rpy:197
translate schinese Ayumi_Talk_Pre_Soushi_Talk_6bd7a97a:

    # mc "Maybe it would, maybe it wouldn't."
    mc "也许会，也许不会。"

# game/new scripts/008/ayumi_talk_pre.rpy:199
translate schinese Ayumi_Talk_Pre_Soushi_Talk_9db9fa8d:

    # mc "It's better for us to discuss all of the possibilities now and decide what to do together, isn't it?"
    mc "我们把各种可能性都摆出来谈一谈，再一起决定怎么办，不是更好吗？"

# game/new scripts/008/ayumi_talk_pre.rpy:200
translate schinese Ayumi_Talk_Pre_Soushi_Talk_37f3f970_1:

    # ay "..."
    ay "……"

# game/new scripts/008/ayumi_talk_pre.rpy:204
translate schinese Ayumi_Talk_Pre_Soushi_Talk_3dafab1d:

    # ay "{xpr}*sigh*{/xpr} Yes, you're right."
    ay "{xpr}*叹气*{/xpr} 嗯，你说得对。"

# game/new scripts/008/ayumi_talk_pre.rpy:208
translate schinese Ayumi_Talk_Pre_Soushi_Talk_51fcf384:

    # ay "I was thinking that you have been going to such big lengths to fix this problem, which is not even yours to begin with." with d
    ay "我只是在想，为了解决这个本来根本不属于你的问题，你已经付出了这么多。" with d

# game/new scripts/008/ayumi_talk_pre.rpy:209
translate schinese Ayumi_Talk_Pre_Soushi_Talk_dc8ece7a:

    # ay "I feel bad for not being able to do anything to help, and, I... I think I should start to act and not just be a dead-weight in this situation."
    ay "我很自责帮不上什么忙。而且我……我觉得自己该开始行动起来了，而不是在这里当一个累赘。"

# game/new scripts/008/ayumi_talk_pre.rpy:211
translate schinese Ayumi_Talk_Pre_Soushi_Talk_84c48332:

    # mc "Okay, but what could you do?"
    mc "好吧，但你能做什么？"

# game/new scripts/008/ayumi_talk_pre.rpy:215
translate schinese Ayumi_Talk_Pre_Soushi_Talk_1f778861:

    # ay "I... I think I know what your plan B would be."
    ay "我……我想我知道你的 B 计划是什么了。"

# game/new scripts/008/ayumi_talk_pre.rpy:217
translate schinese Ayumi_Talk_Pre_Soushi_Talk_81709362:

    # mc "You do?"
    mc "你知道？"

# game/new scripts/008/ayumi_talk_pre.rpy:219
translate schinese Ayumi_Talk_Pre_Soushi_Talk_8e76b374:

    # ay "You said you need to offer something worthwhile to [sou]. Something he'd give [nat] up for."
    ay "你说要给 [sou] 一个划算的条件。一个能让他放弃 [nat] 的东西。"

# game/new scripts/008/ayumi_talk_pre.rpy:220
translate schinese Ayumi_Talk_Pre_Soushi_Talk_6e80e477:

    # ay "What if... what if that could be... well..."
    ay "如果……如果那个能是……那个……"

# game/new scripts/008/ayumi_talk_pre.rpy:224
translate schinese Ayumi_Talk_Pre_Soushi_Talk_47304e35:

    # ay "... Me?" with dd
    ay "……我？" with dd

# game/new scripts/008/ayumi_talk_pre.rpy:229
translate schinese Ayumi_Talk_Pre_Soushi_Talk_7f54c3d2:

    # mc "You mean for you and [sou] to...?" with d
    mc "你是说，让你和 [sou]……？" with d

# game/new scripts/008/ayumi_talk_pre.rpy:233
translate schinese Ayumi_Talk_Pre_Soushi_Talk_a86d9a83:

    # ay "...- Have sex. Yes."
    ay "……做爱。对。"

# game/new scripts/008/ayumi_talk_pre.rpy:234
translate schinese Ayumi_Talk_Pre_Soushi_Talk_6b4891d5:

    # ay "I feel like it's the least I can do. [nat]'s been paying our debt by herself, without my help. I owe her that much."
    ay "我觉得这已经是我能做的最少了。[nat] 一直靠她自己替我们还债，没有我的帮忙。我欠她这么多。"

# game/new scripts/008/ayumi_talk_pre.rpy:235
translate schinese Ayumi_Talk_Pre_Soushi_Talk_2d075167:

    # ay "But I wouldn't want to do something like this without your approval."
    ay "但我不想在没得到你同意的情况下做这种事。"

# game/new scripts/008/ayumi_talk_pre.rpy:238
translate schinese Ayumi_Talk_Pre_Soushi_Talk_6e650155:

    # mc "Huh... I wasn't expecting you to suggest this."
    mc "咦……我没料到你会提出这个。"

# game/new scripts/008/ayumi_talk_pre.rpy:240
translate schinese Ayumi_Talk_Pre_Soushi_Talk_01f0eb9a:

    # mc "Okay, it's something to consider."
    mc "好吧，这倒值得考虑。"

# game/new scripts/008/ayumi_talk_pre.rpy:242
translate schinese Ayumi_Talk_Pre_Soushi_Talk_311d8130:

    # ay "F-forget I mentioned it! Like I said, it's a stupid idea."
    ay "忘、忘掉我说的！就像我说的，很蠢的主意。"

# game/new scripts/008/ayumi_talk_pre.rpy:244
translate schinese Ayumi_Talk_Pre_Soushi_Talk_86c43f0d:

    # mc "No, it's not."
    mc "不，不蠢。"

# game/new scripts/008/ayumi_talk_pre.rpy:248
translate schinese Ayumi_Talk_Pre_Soushi_Talk_1f04b081:

    # ay "It's not?"
    ay "不蠢？"

# game/new scripts/008/ayumi_talk_pre.rpy:250
translate schinese Ayumi_Talk_Pre_Soushi_Talk_f627d987:

    # mc "From a purely pragmatic perspective, it's not. If [sou] is that fixated on you, I think this is something he wouldn't hesitate to accept."
    mc "纯粹从功利的角度来说，确实不蠢。如果 [sou] 那么执着于你，我觉得这是他不会犹豫就接受的条件。"

# game/new scripts/008/ayumi_talk_pre.rpy:252
translate schinese Ayumi_Talk_Pre_Soushi_Talk_8dbf0b26:

    # ay "Yes, that's what I thought as well."
    ay "嗯，我也是这么想的。"

# game/new scripts/008/ayumi_talk_pre.rpy:254
translate schinese Ayumi_Talk_Pre_Soushi_Talk_269abd58:

    # ay "On the other hand, I wouldn't want to cause a bad impression on you."
    ay "但另一方面，我也不想给你留下坏印象。"

# game/new scripts/008/ayumi_talk_pre.rpy:256
translate schinese Ayumi_Talk_Pre_Soushi_Talk_3a2423dd:

    # mc "I'm sure by this point you already know what I think of it."
    mc "我相信到了这个地步，你已经知道我的看法了。"

# game/new scripts/008/ayumi_talk_pre.rpy:258
translate schinese Ayumi_Talk_Pre_Soushi_Talk_624ba382:

    # ay "... Yeah."
    ay "……嗯。"

# game/new scripts/008/ayumi_talk_pre.rpy:260
translate schinese Ayumi_Talk_Pre_Soushi_Talk_bfbcf90a:

    # mc "But it would be with [sou]."
    mc "可是对象是 [sou]。"

# game/new scripts/008/ayumi_talk_pre.rpy:261
translate schinese Ayumi_Talk_Pre_Soushi_Talk_6726a3a9:

    # mc "Do you think you'd be ready for something like that?"
    mc "你觉得你能接受那种事吗？"

# game/new scripts/008/ayumi_talk_pre.rpy:263
translate schinese Ayumi_Talk_Pre_Soushi_Talk_322c42a0:

    # ay "..." with d
    ay "……" with d

# game/new scripts/008/ayumi_talk_pre.rpy:266
translate schinese Ayumi_Talk_Pre_Soushi_Talk_3f8a42c1:

    # ay "Y-yes, I do." with d
    ay "我、是的，我可以。" with d

# game/new scripts/008/ayumi_talk_pre.rpy:268
translate schinese Ayumi_Talk_Pre_Soushi_Talk_2de93561:

    # mc "Okay, then I will keep it as an option."
    mc "好，那我就先把它当作一个选项保留。"

# game/new scripts/008/ayumi_talk_pre.rpy:273
translate schinese Ayumi_Talk_Pre_Soushi_Talk_c06be384:

    # ay "... N-no, I haven't." with d
    ay "……不、没有。" with d

# game/new scripts/008/ayumi_talk_pre.rpy:275
translate schinese Ayumi_Talk_Pre_Soushi_Talk_8acf1c66:

    # mc "Come on, now. I know what that face means."
    mc "好了，别这样。我一看你的表情就知道。"

# game/new scripts/008/ayumi_talk_pre.rpy:277
translate schinese Ayumi_Talk_Pre_Soushi_Talk_22cdaa06:

    # ay "It's nothing, just a stupid idea. It's not worth it and it wouldn't even work."
    ay "没什么，只是个蠢主意。不值得，也根本行不通。"

# game/new scripts/008/ayumi_talk_pre.rpy:279
translate schinese Ayumi_Talk_Pre_Soushi_Talk_bab0c343:

    # mc "Let's hear it at least."
    mc "至少说来听听。"

# game/new scripts/008/ayumi_talk_pre.rpy:281
translate schinese Ayumi_Talk_Pre_Soushi_Talk_92da43e5:

    # ay "N-no. Like I said, it wouldn't work."
    ay "不、不行。就像我说的，行不通。"

# game/new scripts/008/ayumi_talk_pre.rpy:283
translate schinese Ayumi_Talk_Pre_Soushi_Talk_84f16542:

    # mc "Okay..."
    mc "好吧……"

# game/new scripts/008/ayumi_talk_pre.rpy:286
translate schinese Ayumi_Talk_Pre_Soushi_Talk_fd544ab9:

    # mct "(I feel like she has thought of her own way of convincing [sou] herself.)" with d
    mct "（我感觉她自己已经想出了说服 [sou] 的方法。）" with d

# game/new scripts/008/ayumi_talk_pre.rpy:287
translate schinese Ayumi_Talk_Pre_Soushi_Talk_2a1f84fc:

    # mct "(But it seems she's not ready for such a big step like that.)"
    mct "（不过，她似乎还没准备好迈出这么大的一步。）"

# game/new scripts/008/ayumi_talk_pre.rpy:289
translate schinese Ayumi_Talk_Pre_Soushi_Talk_a10be63a:

    # mc "Alright, I won't push it." with d
    mc "好吧，我不再逼你了。" with d

# game/new scripts/008/ayumi_talk_pre.rpy:291
translate schinese Ayumi_Talk_Pre_Soushi_Talk_7c6a1145:

    # mc "Don't worry, though. I'm sure everything will work out in the end."
