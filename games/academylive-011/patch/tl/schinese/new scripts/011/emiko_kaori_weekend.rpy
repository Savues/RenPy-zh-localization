    em "{size=-4}[mc]！！" with hpunch

# game/new scripts/011/emiko_kaori_weekend.rpy:343
translate schinese Emiko_Kaori_Weekend_1_da66531a:

    # mc "... ?"
    mc "……？"

# game/new scripts/011/emiko_kaori_weekend.rpy:360
translate schinese Emiko_Kaori_Weekend_1_5b0898aa:

    # mc "[em]... You're back." with d
    mc "[em]……你回来了。" with d

# game/new scripts/011/emiko_kaori_weekend.rpy:364
translate schinese Emiko_Kaori_Weekend_1_784c6281:

    # em "Yup!"
    em "嗯！"

# game/new scripts/011/emiko_kaori_weekend.rpy:365
translate schinese Emiko_Kaori_Weekend_1_3e6a4bf6:

    # em "Sorry I took long. I was giving [ka] some directions on how to get to your secret little hideout."
    em "抱歉久等了。我刚才在给[ka]指路，教她怎么去你的秘密小窝。"

# game/new scripts/011/emiko_kaori_weekend.rpy:369
translate schinese Emiko_Kaori_Weekend_1_990fded5:

    # mc "Oh, gotcha..."
    mc "哦，知道了……"

# game/new scripts/011/emiko_kaori_weekend.rpy:372
translate schinese Emiko_Kaori_Weekend_1_05e48445:

    # mc "..." with d
    mc "……" with d

# game/new scripts/011/emiko_kaori_weekend.rpy:376
translate schinese Emiko_Kaori_Weekend_1_5e820595:

    # mc "Wait! [ka]?!" with dquick
    mc "等等！[ka]？！" with dquick

# game/new scripts/011/emiko_kaori_weekend.rpy:382
translate schinese Emiko_Kaori_Weekend_1_3706f479:

    # ka "Hey, hey, [mc]!! It's been a while!" with dd
    ka "喂喂，[mc]！！好久不见！" with dd

# game/new scripts/011/emiko_kaori_weekend.rpy:386
translate schinese Emiko_Kaori_Weekend_1_e82f9466:

    # mc "What the... Why are you here?!" with hpunch
    mc "什……你怎么会在这儿？！" with hpunch

# game/new scripts/011/emiko_kaori_weekend.rpy:392
translate schinese Emiko_Kaori_Weekend_1_ac369f7a:

    # em "[mc]?!!" with hpunch
    em "[mc]？！！" with hpunch

# game/new scripts/011/emiko_kaori_weekend.rpy:396
translate schinese Emiko_Kaori_Weekend_1_09bf09fe:

    # ka "{xpr}*giggles*{/xpr}"
    ka "{xpr}*咯咯笑*{/xpr}"

# game/new scripts/011/emiko_kaori_weekend.rpy:398
translate schinese Emiko_Kaori_Weekend_1_ace5a447:

    # mc "{xpr}Ah-hem{/xpr} Sorry! The news threw me off for a second. Let me start over..."
    mc "{xpr}咳咳{/xpr} 抱歉！那个新闻让我一时没反应过来。我重新来……"

# game/new scripts/011/emiko_kaori_weekend.rpy:399
translate schinese Emiko_Kaori_Weekend_1_bf2b6a27:

    # mc "Good to see you, [ka]! How have you been?"
    mc "见到你真好，[ka]！最近怎么样？"

# game/new scripts/011/emiko_kaori_weekend.rpy:400
translate schinese Emiko_Kaori_Weekend_1_b6adf0f2:

    # mc "And... yeah... why are you here? That's still a relevant question."
    mc "还有……对……你为什么会来？这个问题还是很成立。"

# game/new scripts/011/emiko_kaori_weekend.rpy:406
translate schinese Emiko_Kaori_Weekend_1_a5e21ec2:

    # ka "Well, [em] invited me for us to talk, right? Like she told you?"
    ka "嗯，[em]约我们三个出来聊聊，对吧？她跟你说了吧？"

# game/new scripts/011/emiko_kaori_weekend.rpy:412
translate schinese Emiko_Kaori_Weekend_1_af9e0a50_1:

    # em "..."
    em "……"

# game/new scripts/011/emiko_kaori_weekend.rpy:414
translate schinese Emiko_Kaori_Weekend_1_8869214c:

    # ka "You didn't tell him, did you, [em]?"
    ka "你没告诉他吧，[em]？"

# game/new scripts/011/emiko_kaori_weekend.rpy:418
translate schinese Emiko_Kaori_Weekend_1_72997a4a:

    # em "... No."
    em "……没有。"

# game/new scripts/011/emiko_kaori_weekend.rpy:419
translate schinese Emiko_Kaori_Weekend_1_689e737d:

    # em "I tried to, but he kept changing the subject, talking about some random biker bar he once went to..."
    em "我想说，可他一直转移话题，聊他以前去过的一家莫名其妙的机车酒吧……"

# game/new scripts/011/emiko_kaori_weekend.rpy:420
translate schinese Emiko_Kaori_Weekend_1_236a31fb:

    # em "... And getting all flirty and..."
    em "……然后还一副暧昧的样子……"

# game/new scripts/011/emiko_kaori_weekend.rpy:425
translate schinese Emiko_Kaori_Weekend_1_c8e3b221:

    # em "{xpr}*gasp*" with hpunch
    em "{xpr}*倒吸一口气*" with hpunch

# game/new scripts/011/emiko_kaori_weekend.rpy:430
translate schinese Emiko_Kaori_Weekend_1_58449a9d:

    # em "I... m-meant like making those stupid double-meaning jokes, nothing serious! {xpr}*nervous giggling*{/xpr}"
    em "我……我、我的意思只是开那种无聊的双关玩笑，没别的！{xpr}*紧张地傻笑*{/xpr}"

# game/new scripts/011/emiko_kaori_weekend.rpy:440
translate schinese Emiko_Kaori_Weekend_1_d4570df9:

    # ka "{xpr}*giggles*{/xpr} It's okay, [v1]. I know all about you guys. Don't worry, I don't mind."
    ka "{xpr}*咯咯笑*{/xpr} 没关系，[v1]。你们的事我都知道。别在意，我不介意。"

# game/new scripts/011/emiko_kaori_weekend.rpy:444
translate schinese Emiko_Kaori_Weekend_1_cb08d1ef:

    # em "{xpr}*nervous giggling*{/xpr} Y-yeah, of course..."
    em "{xpr}*紧张地傻笑*{/xpr} 对、对，当然……"

# game/new scripts/011/emiko_kaori_weekend.rpy:452
translate schinese Emiko_Kaori_Weekend_1_8933c18a:

    # em "B-but yeah, that's it, [mc]. I wanted the three of us to meet up and chat. That's why I called you out." with d
    em "不、不过就是这样，[mc]。我想让我们三个出来聊聊。所以才约的你。" with d

# game/new scripts/011/emiko_kaori_weekend.rpy:456
translate schinese Emiko_Kaori_Weekend_1_f0c54518:

    # mc "Gotcha."
    mc "懂了。"

# game/new scripts/011/emiko_kaori_weekend.rpy:457
translate schinese Emiko_Kaori_Weekend_1_12cc6956:

    # mc "Any special reason, though? I feel like there's some details left out still..."
    mc "不过有什么特别原因吗？我总觉得还有些细节没说出来……"

# game/new scripts/011/emiko_kaori_weekend.rpy:463
translate schinese Emiko_Kaori_Weekend_1_7a002b15:

    # em "Yeah. [ka]'s got some really important things to talk about."
    em "嗯。[ka]有些很重要的事要说。"

# game/new scripts/011/emiko_kaori_weekend.rpy:467
translate schinese Emiko_Kaori_Weekend_1_a9ff9c58:

    # mc "She does?"
    mc "她有吗？"

# game/new scripts/011/emiko_kaori_weekend.rpy:471
translate schinese Emiko_Kaori_Weekend_1_c65a94b3:

    # ka "{xpr}*sigh*{/xpr} Yes... I do."
    ka "{xpr}*叹气*{/xpr} 有……我有。"

# game/new scripts/011/emiko_kaori_weekend.rpy:472
translate schinese Emiko_Kaori_Weekend_1_c368ea2a:

    # ka "How about we find a table to sit and talk? I'd prefer not to just chat standing here..."
    ka "我们找张桌子坐下聊吧？我不太想一直站着说话……"

# game/new scripts/011/emiko_kaori_weekend.rpy:478
translate schinese Emiko_Kaori_Weekend_1_bffd5f7d:

    # mc "You were fired?!!" with hpunch
    mc "你被解雇了？！！" with hpunch

# game/new scripts/011/emiko_kaori_weekend.rpy:482
translate schinese Emiko_Kaori_Weekend_1_fbefb222:

    # ka "Yes." with d
    ka "是的。" with d

# game/new scripts/011/emiko_kaori_weekend.rpy:487
translate schinese Emiko_Kaori_Weekend_1_f5fa69a2:

    # ka "I mean, technically I quit first. Didn't want to give that hag the satisfaction"
    ka "严格来说，是我先辞的职。我不想让那个臭婆娘称心如意"

# game/new scripts/011/emiko_kaori_weekend.rpy:489
translate schinese Emiko_Kaori_Weekend_1_1a99d23c:

    # mc "[ka]..."
    mc "[ka]……"

# game/new scripts/011/emiko_kaori_weekend.rpy:493
translate schinese Emiko_Kaori_Weekend_1_686d89d1:

    # mc "Was it because of me? Because of the lawsuit?"
    mc "是因为我吗？因为那场官司？"

# game/new scripts/011/emiko_kaori_weekend.rpy:494
translate schinese Emiko_Kaori_Weekend_1_97f85b8e:

    # mc "I told you to stay out of it — I'm already dealing with it. You were just going to put a target on your back for [mi]."
    mc "我叫你别掺和——我自己会处理。你那样只会给[mi]送靶子。"

# game/new scripts/011/emiko_kaori_weekend.rpy:498
translate schinese Emiko_Kaori_Weekend_1_423e5bfb:

    # ka "I know... sorry."
    ka "我知道……对不起。"

# game/new scripts/011/emiko_kaori_weekend.rpy:502
translate schinese Emiko_Kaori_Weekend_1_1fad7b26:

    # ka "I just couldn't stand sitting there and pretending nothing happened."
    ka "我实在没法坐在那里装作什么都没发生。"

# game/new scripts/011/emiko_kaori_weekend.rpy:503
translate schinese Emiko_Kaori_Weekend_1_07100154:

    # ka "So I just had to do some investigation myself. Get some insider information to help you out."
    ka "所以我只能自己去查点东西。弄点内部消息来帮你。"

# game/new scripts/011/emiko_kaori_weekend.rpy:505
translate schinese Emiko_Kaori_Weekend_1_6687ae5f:

    # mc "I appreciate it, I do, but you shouldn't have exposed yourself like this... Fuck."
    mc "我很感激，真的。但你不该这样把自己搭进去……操。"

# game/new scripts/011/emiko_kaori_weekend.rpy:507
translate schinese Emiko_Kaori_Weekend_1_e1c38142:

    # ka "It wasn't for nothing, though. I did end up looking through some of the documents."
    ka "不过也不算白费。我确实翻到了一些文件。"

# game/new scripts/011/emiko_kaori_weekend.rpy:509
translate schinese Emiko_Kaori_Weekend_1_15d4a291:

    # mc "You did?"
    mc "你真的翻了？"

# game/new scripts/011/emiko_kaori_weekend.rpy:510
translate schinese Emiko_Kaori_Weekend_1_523fab10:

    # mcT "Crap... I know she's trying to help, but I don't want [ka] snooping about in [mi]'s findings, if there are any. She might actually stumble upon something."
    mcT "糟了……我知道她是想帮忙，但我不想让[ka]去翻[mi]的调查结果，万一真有什么的话。她说不定会真的碰上看什么。"

# game/new scripts/011/emiko_kaori_weekend.rpy:512
translate schinese Emiko_Kaori_Weekend_1_db1b534e:

    # ka "Yeah, I did."
    ka "嗯，我翻了。"

# game/new scripts/011/emiko_kaori_weekend.rpy:513
translate schinese Emiko_Kaori_Weekend_1_8060f956:

    # ka "She's still really interested in this Academy of yours — Relive Academy. That's the name, right?"
    ka "她对你这所学院还是很感兴趣啊——Re-LIVE学院。是这个名字吧？"

# game/new scripts/011/emiko_kaori_weekend.rpy:515
translate schinese Emiko_Kaori_Weekend_1_7e4aae06:

    # em "Yeah, that's it."
    em "嗯，就是。"

# game/new scripts/011/emiko_kaori_weekend.rpy:519
translate schinese Emiko_Kaori_Weekend_1_a929d151:

    # em "It's... {xpr}u-uhm...{/xpr} a bit of an odd place, but [mc] being the Principal makes it not so bad."
    em "这里是……{xpr}呃……{/xpr} 有点古怪，不过有[mc]当理事长就还说得过去。"

# game/new scripts/011/emiko_kaori_weekend.rpy:524
translate schinese Emiko_Kaori_Weekend_1_fb19600a:

    # ka "Odd? How so?"
    ka "古怪？怎么个古怪法？"

# game/new scripts/011/emiko_kaori_weekend.rpy:529
translate schinese Emiko_Kaori_Weekend_1_775a5983:

    # em "Well, you know... Just feels odd. Like some of the teachers and staff members are weird. And there's some shady students too."
    em "嗯，你知道的……就是感觉怪怪的。怎么说呢，有些教职员工很奇怪。而且还有些来路不明的学生。"

# game/new scripts/011/emiko_kaori_weekend.rpy:534
translate schinese Emiko_Kaori_Weekend_1_c8cd7c4d:

    # em "Like that [sou] guy. I heard [sats] say he might be a drug dealer."
    em "比如那个[sou]。我听[sats]说，他可能是卖药的。"

# game/new scripts/011/emiko_kaori_weekend.rpy:540
translate schinese Emiko_Kaori_Weekend_1_47fa8684:

    # ka "A drug dealer?!"
    ka "卖药的？！"

# game/new scripts/011/emiko_kaori_weekend.rpy:545
translate schinese Emiko_Kaori_Weekend_1_5cab678a:

    # mc "{xpr}*Ah-hem*{/xpr}"
    mc "{xpr}*咳咳*{/xpr}"

# game/new scripts/011/emiko_kaori_weekend.rpy:546
translate schinese Emiko_Kaori_Weekend_1_a6bc7120:

    # mc "If you remember from our first conversation about this, [ka], one of the goals of the Academy is to reform certain {i}unruly{/i} students."
    mc "[ka]，你还记得我们第一次聊到这件事时说过的话吧。学院的目标之一，就是感化某些{i}不成器{/i}的学生。"

# game/new scripts/011/emiko_kaori_weekend.rpy:547
translate schinese Emiko_Kaori_Weekend_1_9da3709e:

    # mc "So yeah, we've got a few {i}shady{/i} students that we're trying to straighten out."
    mc "所以没错，我们确实有几个{i}有问题{/i}的学生，正在想办法把他们掰正。"

# game/new scripts/011/emiko_kaori_weekend.rpy:551
translate schinese Emiko_Kaori_Weekend_1_90da4267:

    # ka "{xpr}Mhm...{/xpr} Yeah, I guess that makes sense."
    ka "{xpr}嗯……{/xpr} 嗯，好像是说得通。"

# game/new scripts/011/emiko_kaori_weekend.rpy:556
translate schinese Emiko_Kaori_Weekend_1_642a34fa:

    # ka "In any case, I think the one thread [mi] is grasping at is that she claims your academy came out of nowhere. There's not a lot of records of it from before." with d
    ka "总之，我觉得[mi]抓住的那条线是——她声称你们学院是凭空冒出来的。之前几乎没有关于它的记录。" with d

# game/new scripts/011/emiko_kaori_weekend.rpy:558
translate schinese Emiko_Kaori_Weekend_1_be282bc5:

    # mc "She can question all she wants. It's none of her business."
    mc "她要怎么质疑都随她。不关她的事。"

# game/new scripts/011/emiko_kaori_weekend.rpy:562
translate schinese Emiko_Kaori_Weekend_1_c833732a:

    # ka "You know it's not that simple."
    ka "你知道事情没这么简单。"

# game/new scripts/011/emiko_kaori_weekend.rpy:563
translate schinese Emiko_Kaori_Weekend_1_8d54c162:

    # ka "She sent and received a bunch of emails with some of her legal team, telling them to look into the history of the place. Who owns it, and why it came to be."
    ka "她和自己的法务团队收发了一大堆邮件，让他们调查这个地方的历史——归谁所有，又是怎么来的。"

# game/new scripts/011/emiko_kaori_weekend.rpy:564
translate schinese Emiko_Kaori_Weekend_1_da1dc358:

    # ka "I think she's trying to question the legitimacy of the place. If that claim goes through, I'm pretty sure some form of auditing can happen."
    ka "我觉得她是想质疑这个地方的合法性。如果那个主张成立，我敢肯定会以某种形式被审查。"

# game/new scripts/011/emiko_kaori_weekend.rpy:565
translate schinese Emiko_Kaori_Weekend_1_e54d585d:

    # ka "So you better be ready for that."
    ka "所以你最好做好准备。"

# game/new scripts/011/emiko_kaori_weekend.rpy:567
translate schinese Emiko_Kaori_Weekend_1_a65cb88b:

    # mc "Auditing? How so?"
    mc "审查？具体呢？"

# game/new scripts/011/emiko_kaori_weekend.rpy:570
translate schinese Emiko_Kaori_Weekend_1_60a418dc:

    # ka "I don't know, I'm not a legal expert. I assume it'd mean some government officials coming in to take a closer look around the place."
    ka "我不清楚，我又不是法律专家。我猜就是会有政府官员进来，把这里上上下下查一遍。"

# game/new scripts/011/emiko_kaori_weekend.rpy:572
translate schinese Emiko_Kaori_Weekend_1_ad09b856:

    # mc "Shit."
    mc "糟了。"

# game/new scripts/011/emiko_kaori_weekend.rpy:576
translate schinese Emiko_Kaori_Weekend_1_a061416a:

    # ka "I don't think it's as bad as it sounds, though."
    ka "不过我觉得没听起来那么糟。"

# game/new scripts/011/emiko_kaori_weekend.rpy:577
translate schinese Emiko_Kaori_Weekend_1_f63ac6f6:

    # ka "This is her only move for now. All of her leads went nowhere. If your Academy is legitimate, she won't find anything."
    ka "她现在只有这一招。所有线索都断了。只要你们的学院合法，她就查不出任何东西。"

# game/new scripts/011/emiko_kaori_weekend.rpy:583
translate schinese Emiko_Kaori_Weekend_1_92a06789:

    # mc "{xpr}*sigh*{/xpr} Yeah, I guess we'll have to be ready for it."
    mc "{xpr}*叹气*{/xpr} 嗯，看来我们得做好准备。"

# game/new scripts/011/emiko_kaori_weekend.rpy:584
translate schinese Emiko_Kaori_Weekend_1_b96e3ee4:

    # mc "Did you find anything else?"
    mc "你还查到别的什么了吗？"

# game/new scripts/011/emiko_kaori_weekend.rpy:589
translate schinese Emiko_Kaori_Weekend_1_e22d6027:

    # ka "Not really."
    ka "没什么。"

# game/new scripts/011/emiko_kaori_weekend.rpy:594
translate schinese Emiko_Kaori_Weekend_1_70e9332d:

    # ka "There were some documents on some of the students, but I didn't have time to check it further."
    ka "有一些关于某些学生的文件，但我没时间再细查了。"

# game/new scripts/011/emiko_kaori_weekend.rpy:596
translate schinese Emiko_Kaori_Weekend_1_38c742d6:

    # mc "Students? Anyone in particular?"
    mc "学生？有具体的人吗？"

# game/new scripts/011/emiko_kaori_weekend.rpy:600
translate schinese Emiko_Kaori_Weekend_1_ed0f21d9:

    # ka "Well, [em] was one of the students she was looking for."
    ka "嗯，[em]就是她在找的学生之一。"

# game/new scripts/011/emiko_kaori_weekend.rpy:601
translate schinese Emiko_Kaori_Weekend_1_38e1d64b:

    # ka "There were even some pictures of her in your Academy grounds. You should tell your staff to keep an eye out. She might have some of her investigators watching the place."
    ka "甚至还有她在你们学院内的照片。你该让下面的人留点意。她可能派了调查员盯着那里。"

# game/new scripts/011/emiko_kaori_weekend.rpy:602
translate schinese Emiko_Kaori_Weekend_1_f73b9900:

    # ka "Another one she was particularly interested in was that girl from the maid café, [ay]?"
    ka "她特别感兴趣的另一个，是女仆咖啡厅那个女孩，[ay]？"

# game/new scripts/011/emiko_kaori_weekend.rpy:604
translate schinese Emiko_Kaori_Weekend_1_57a5981b:

    # mc "Why was she looking into her?"
    mc "为什么要查她？"

# game/new scripts/011/emiko_kaori_weekend.rpy:608
translate schinese Emiko_Kaori_Weekend_1_b186a88b:

    # ka "I don't know. Couldn't really look into it. I just skimmed past it."
    ka "我不知道。没法细看，只是翻过去了。"

# game/new scripts/011/emiko_kaori_weekend.rpy:610
translate schinese Emiko_Kaori_Weekend_1_bd4fd6cd:

    # ka "Other than this, nothing much. I assume she must've discovered I was looking through her documents and fired me soon after."
    ka "除了这个就没什么了。我想她大概是发现我在翻她的文件，所以很快就把我辞了。"

# game/new scripts/011/emiko_kaori_weekend.rpy:614
translate schinese Emiko_Kaori_Weekend_1_9051decb:

    # mc "{xpr}*sigh{/xpr} Yeah, thanks for the heads up, [ka]. Really. I'll go over these details with [k] and see how we can prepare for that."
    mc "{xpr}*叹气{/xpr} 嗯，谢谢你提醒我，[ka]。真的。我会跟[k]过一遍这些细节，看该怎么准备。"

# game/new scripts/011/emiko_kaori_weekend.rpy:618
translate schinese Emiko_Kaori_Weekend_1_f7c74526:

    # mcT "[mi] didn't manage to dig {i}too{/i} deep yet. That's good..." with dd
    mcT "[mi]还没能挖到{i}太深{/i}。这很好……" with dd

# game/new scripts/011/emiko_kaori_weekend.rpy:619
translate schinese Emiko_Kaori_Weekend_1_7a3e6684:

