    # mcT "To get a leash on our future Prime Minister..."
    mcT "为了把未来的内阁总理牢牢攥在手里……"

# game/new scripts/011/emiko_kaori_weekend.rpy:339
translate schinese Emiko_Kaori_Weekend_1_0da2a827:

    # em "{size=-6}... [mc]?{/size}" with d
    em "{size=-6}……[mc]？{/size}" with d

