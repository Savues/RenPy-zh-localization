    # be "You still looked like yourself. You actually joked around."
    be "你看起来还是你自己。你还会开玩笑。"

# game/script.rpy:15475
translate Chinese po02_01_con_4_qte_1_goodend_44a0e6a2:

    # be "You felt... alive."
    be "你感觉……是活生生的。"

