    # vir "Here. This suits you perfectly."
    vir "给，这个特别适合你。"

# game/script.rpy:18082
translate Chinese po02_02_sto_con_12859b06:

    # re "Don't mess with me. I'm not in the mood for jokes."
    re "别耍我。我现在没心情开玩笑。"

# game/script.rpy:18084
translate Chinese po02_02_sto_con_95707131:

    # vir "What? It's solid, reliable, and you could knock a damn zombie's head clean off with it."
    vir "怎么了？这玩意结实耐用，一下就能把丧尸的脑袋敲飞。"

# game/script.rpy:18086
translate Chinese po02_02_sto_con_6e57d127:

    # re "You said you trusted me. But you're still screwing around like I'm some clown."
    re "你说你信任我。可你还是把我当小丑一样耍。"

# game/script.rpy:18087
translate Chinese po02_02_sto_con_812072bb:

    # re "That trust thing? Doesn't feel real when you're mocking me."
    re "什么信任不信任的？你这么嘲我，可我一点都感觉不到。"

# game/script.rpy:18089
translate Chinese po02_02_sto_con_0d90ab98:

    # vir "Alright, alright. I get it. But I wasn't mocking you. I'm giving you something that works."
    vir "好了好了，我明白了。但我没有嘲讽你的意思。我是想给你一件真正好用的东西。"

# game/script.rpy:18090
translate Chinese po02_02_sto_con_44444751:

    # vir "You want a weapon? This'll keep you alive."
    vir "你想要武器？这个能保住你的命。"

# game/script.rpy:18092
translate Chinese po02_02_sto_con_4b2724b0:

    # re "You better hope I don't decide to test it on you first."
    re "你最好祈祷我不会先拿你来试试它好不好用。"

# game/script.rpy:18093
translate Chinese po02_02_sto_con_73c4c16c:

    # re "This is bullshit..."
    re "这简直扯淡……"

