    # re "You wanna know!? That body back there..."
    re "你想知道！？后面那具尸体……"

# game/script.rpy:19054
translate Chinese po02_02_sto_con2_f4d98089:

    # re "She was more than just a prospect... She was family. And you cops..."
    re "她不只是个见习成员……她是家人。而你们这些条子……"

# game/script.rpy:19055
translate Chinese po02_02_sto_con2_bd0befa9:

    # re "You cops fucking took her away!"
    re "你们这些条子他妈的把她夺走了！"

# game/script.rpy:19057
translate Chinese po02_02_sto_con2_c5f9dc1e:

    # vir "We were doing our job. It was chaos! Then the outbreak hit. It all spiraled out of control!"
    vir "我们只是在做我们的工作。当时一片混乱！然后疫情爆发了。一切都失控了！"

# game/script.rpy:19059
translate Chinese po02_02_sto_con2_70af61c0:

    # re "She wasn't turning. She was just scared. You cops... always jump the gun!"
    re "她根本没有变异。她只是吓坏了。你们这些条子……总是先开枪再说！"

