    # be "Withdrawal? What do you mean by that?"
    be "撤退？这是什么意思？"

# game/script.rpy:21901
translate Chinese po02_02_sto_con2_d5e37e2f:

    # ire "Yeah. The military lost multiple evacuation centers in a single night. The National Guard tried to lock down the city to contain the outbreak, but it failed."
    ire "是的。军方一夜之间失去了好几个撤离中心。国民警卫队试图封锁城市控制疫情，但失败了。"

# game/script.rpy:21902
translate Chinese po02_02_sto_con2_3b630395:

    # ire "'Code Black' means if containment fails, we pull out. No more evacuees. Instead, they switch to drones and airstrikes."
    ire "「黑色代码」的意思是，一旦控制失败，我们就撤出。不再接收撤离者。取而代之的是改用无人机和空袭。"

# game/script.rpy:21904
translate Chinese po02_02_sto_con2_fddd1b10:

    # vir "Why risk sending in ground troops at all? Why not just use drones from the start?"
    vir "那为什么一开始还要冒险派地面部队进去？为什么不直接用无人机呢？"

# game/script.rpy:21906
translate Chinese po02_02_sto_con2_622bf708:

    # ire "As far as I know, drones have been in use the whole time. Troops were sent to evacuate civilians, not to fight."
    ire "据我所知，无人机其实一直都在用。派地面部队进去是为了撤离平民，不是为了打仗。"

# game/script.rpy:21908
translate Chinese po02_02_sto_con2_bf7a7fa4:

    # be "And where are they withdrawing to now?"
    be "那他们现在要撤到哪儿去？"

# game/script.rpy:21910
translate Chinese po02_02_sto_con2_4d4a089e:

    # ire "I don't know. My orders are to evacuate key personnel to the carrier."
    ire "我不知道。我接到的命令是把关键人员撤到航母上。"

# game/script.rpy:21912
translate Chinese po02_02_sto_con2_94523756:

    # be "And... What about the rest of us?"
    be "那……我们剩下的人怎么办？"

# game/script.rpy:21914
translate Chinese po02_02_sto_con2_bfe4d83a:

    # ire "For now, we just wait. Any further orders will come later."
    ire "现在只能等。后续命令会再下达。"

