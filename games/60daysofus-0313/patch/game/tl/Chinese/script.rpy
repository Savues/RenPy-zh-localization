# game/script.rpy:10820
translate Chinese po02_01_con_3_152758a0:

    # du "So? Ain't hearin' nothin'."
    du "那又怎样？我什么都没听到。"

# game/script.rpy:10822
translate Chinese po02_01_con_3_7cb42070:

    # wi "We stick to the plan."
    wi "我们按计划行动。"

# game/script.rpy:10823
translate Chinese po02_01_con_3_bc1bd85d:

    # du "Stay quiet. Guns only if things go to hell."
    du "保持安静。除非情况彻底失控，否则不开枪。"

# game/script.rpy:10824
translate Chinese po02_01_con_3_a3e8b1df:

    # wi "Exactly. That's why I trust you the most."
    wi "没错。所以我最信任你。"

# game/script.rpy:10825
translate Chinese po02_01_con_3_27067c03:

    # du "Careful now. Folks might hear ya say that."
    du "小心点。别让别人听见你这么说。"

# game/script.rpy:10826
translate Chinese po02_01_con_3_7d38a019:

    # wi "AJ already knows."
    wi "A.J.已经知道了。"

# game/script.rpy:10827
translate Chinese po02_01_con_3_ba76f4d9:

    # du "Guess so."
    du "我猜也是。"

# game/script.rpy:10829
translate Chinese po02_01_con_3_17f63dd2:

    # du "Reckon those cops made it?"
    du "你觉得那些警察撑住了吗？"

# game/script.rpy:10830
translate Chinese po02_01_con_3_90022360:

    # wi "But if they're still moving civilians... The Empire's still our best shot."
    wi "但如果他们还在转移平民……帝国商场仍然是我们最好的机会。"

# game/script.rpy:10831
translate Chinese po02_01_con_3_62892a05:

    # du "And if it ain't?"
    du "那如果不是呢？"

# game/script.rpy:10832
translate Chinese po02_01_con_3_969a5ea3:

    # wi "Then we improvise. Got a better one?"
    wi "那我们就随机应变。你有更好的主意吗？"

# game/script.rpy:10833
translate Chinese po02_01_con_3_ac9f0717:

    # du "Nope. Far as I can tell, The Empire's still the best bet we got."
    du "没有。就我所知，帝国商场仍然是我们能押注的最好选择。"

# game/script.rpy:10834
translate Chinese po02_01_con_3_493bdadc:

    # du "Maybe they're still there. Maybe they ain't."
    du "也许他们还在那儿。也许不在了。"

# game/script.rpy:10835
translate Chinese po02_01_con_3_40d3e5a0:

    # du "Hell if I know. Other choice is drivin' around with no destination..."
    du "谁知道呢。另一个选择就是开着车到处乱转……"

# game/script.rpy:10836
translate Chinese po02_01_con_3_2ed370d6:

    # du "Or sittin' here waitin' to die. Ain't much of a choice, if you ask me."
    du "或者坐在这儿等死。要我说，这算不上什么选择。"

# game/script.rpy:10837
translate Chinese po02_01_con_3_d4688e7c:

    # du "Lead on, soldier."
    du "带路吧，大兵。"

