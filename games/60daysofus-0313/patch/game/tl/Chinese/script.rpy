    du "短、轻，上肩快。"

# game/script.rpy:12803
translate Chinese po02_01_con_4_qte_1_goodend_e55d196b:

    # du "Now, my Marlin... She's a damn fine rifle."
    du "而我的马林……那可是把好枪。"

# game/script.rpy:12804
translate Chinese po02_01_con_4_qte_1_goodend_4bc35724:

    # du "But in a place like this, with these things wearin' armor..."
    du "但在这种地方，面对这些穿着防弹衣的东西……"

# game/script.rpy:12805
translate Chinese po02_01_con_4_qte_1_goodend_c91d52cd:

    # du "One bad shot... Or hit one in the helmet..."
    du "一发打偏……或者打中了它们的头盔……"

# game/script.rpy:12806
translate Chinese po02_01_con_4_qte_1_goodend_7ede584a:

    # du "I may not get another shot before they reach me. And workin' that lever takes time."
    du "它们扑到我跟前之前我可能都打不出第二发。而且拉枪栓也要时间。"

# game/script.rpy:12807
translate Chinese po02_01_con_4_qte_1_goodend_647fef62:

    # du "Reloadin' ain't exactly quick, either."
    du "装弹也不算快。"

# game/script.rpy:12809
translate Chinese po02_01_con_4_qte_1_goodend_cfbacdea:

    # du "With your rifle? I can keep shootin'. That's what I need."
    du "拿你那把枪？我能连续开火。这才是我需要的。"

# game/script.rpy:12811
translate Chinese po02_01_con_4_qte_1_goodend_56dbaa77:

    # wi "Makes sense. Let's do it."
    wi "有道理。就这么办。"

# game/script.rpy:12813
translate Chinese po02_01_con_4_qte_1_goodend_81af2b88:

    # wi "Everyone fights better with what they trust."
    wi "每个人用自己信得过的家伙打起来才顺手。"

# game/script.rpy:12814
translate Chinese po02_01_con_4_qte_1_goodend_8fbe515a:

    # wi "That's what's gonna get us out."
    wi "这才能帮我们脱身。"

# game/script.rpy:12816
translate Chinese po02_01_con_4_qte_1_goodend_65919978:

    # wi "One thing."
    wi "有件事。"

# game/script.rpy:12817
translate Chinese po02_01_con_4_qte_1_goodend_d717f3a6:

    # wi "If you're not shooting... Keep the safety on."
    wi "如果你不开枪……把保险栓扣上。"

# game/script.rpy:12818
translate Chinese po02_01_con_4_qte_1_goodend_d4d5a01b:

    # wi "Trigger's tuned. Barely touch it... and it'll go off."
    wi "扳机被调校过。轻轻一碰……就会走火。"

# game/script.rpy:12820
translate Chinese po02_01_con_4_qte_1_goodend_d94c5b5e:

    # du "Copy that. I'll treat her like she's mine."
    du "收到。我会把她当自己的一样对待。"

# game/script.rpy:12822
translate Chinese po02_01_con_4_qte_1_goodend_8b9b752f:

    # wi "I know you will."
    wi "我知道你会的。"

# game/script.rpy:12824
translate Chinese po02_01_con_4_qte_1_goodend_7b42bfff:

    # wi "AJ. How's your vision?"
    wi "A.J.，你的视力怎么样了？"

# game/script.rpy:12825
translate Chinese po02_01_con_4_qte_1_goodend_2103ff11:

    # aj "I can see, man."
    aj "我能看见了，老兄。"

# game/script.rpy:12826
translate Chinese po02_01_con_4_qte_1_goodend_e0215631:

    # aj "Still burns like a motherfucker, though."
    aj "不过还是疼得要命。"

# game/script.rpy:12827
translate Chinese po02_01_con_4_qte_1_goodend_f3b992ee:

    # wi "Good."
    wi "好。"

# game/script.rpy:12829
translate Chinese po02_01_con_4_qte_1_goodend_d779a517:

    # wi "Fall back to the middle. If it gets worse, hand your rifle to Dianne."
    wi "退到中间去。要是情况恶化，就把你的步枪交给戴安。"

# game/script.rpy:12830
translate Chinese po02_01_con_4_qte_1_goodend_73864b47:

    # wi "She'll take point with me."
    wi "她会跟我一起打头阵。"

# game/script.rpy:12833
translate Chinese po02_01_con_4_qte_1_goodend_d527c143:

    # aj "Hell nah. I'm straight."
    aj "门儿都没有。我没事。"

# game/script.rpy:12834
translate Chinese po02_01_con_4_qte_1_goodend_266f39fe:

    # wi "AJ..."
    wi "A.J.……"

# game/script.rpy:12836
translate Chinese po02_01_con_4_qte_1_goodend_0514d5d3:

    # aj "Bro, I said I'm straight."
    aj "老兄，我说了我没事。"

