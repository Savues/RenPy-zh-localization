# game/script.rpy:18635
translate Chinese po02_02_sto_con2_80d374ba:

    # vir "Let's stay together for a little while longer at least, okay, Rhea?"
    vir "我们至少再一起待一阵子，好吗，瑞亚？"

# game/script.rpy:18636
translate Chinese po02_02_sto_con2_2710ec3b:

    # vir "I gave you those shells... not because I trust you blindly. But because I believe you still have something worth fighting for."
    vir "我给你那些子弹……不是因为我盲目信任你。而是因为我相信你心里还有值得为之奋战的东西。"

# game/script.rpy:18638
translate Chinese po02_02_sto_con2_0ae9bcd0_23:

    # ""
