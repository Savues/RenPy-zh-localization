# game/script.rpy:1885
translate Chinese po01_Con_2_3a22b257:

    # be "Yeah... I'll live. It's just a bit scratched up. I've definitely had better days though."
    be "嗯……死不了。就是有点擦伤而已。不过我确实经历过更好的日子。"

