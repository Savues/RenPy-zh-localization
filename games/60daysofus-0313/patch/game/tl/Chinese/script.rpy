    # wi "She's reckless, and that could get someone killed. We need to be careful."
    wi "她很鲁莽，这可能会害死人。我们得小心点。"

# game/script.rpy:18568
translate Chinese po02_02_sto_con2_0ae9bcd0_12:

    # ""
    ""

# game/script.rpy:18570
translate Chinese po02_02_sto_con2_d32ea746:

    # vir "Thanks. I just need to know someone sees what I see."
    vir "谢了。我只是需要知道有人跟我看法一样。"

# game/script.rpy:18572
