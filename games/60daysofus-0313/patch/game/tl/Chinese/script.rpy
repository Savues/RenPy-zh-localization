translate Chinese po02_01_con_3_ff73ae2d:

    # wi "Alright, listen up."
    wi "好了，都听好了。"

# game/script.rpy:10761
translate Chinese po02_01_con_3_47869be4:

    # wi "Leave most of the supplies here. Only take what you need."
    wi "大部分补给留在这儿。只带需要的东西。"

# game/script.rpy:10763
translate Chinese po02_01_con_3_3bdcabc2:

    # aj "Damn, we just got all this stuff."
    aj "靠，我们才刚弄到这些东西呢。"

# game/script.rpy:10765
translate Chinese po02_01_con_3_b3ebe4ca:

    # wi "Exactly."
    wi "没错。"

# game/script.rpy:10766
translate Chinese po02_01_con_3_c6f1837d:

    # wi "If something goes wrong, I don't want us losing everything at once."
    wi "万一出事，我不想让我们一下子全部损失掉。"

# game/script.rpy:10767
translate Chinese po02_01_con_3_c862131b:

    # wi "This alley is our fallback point."
    wi "这条小巷就是我们的撤退点。"

# game/script.rpy:10769
translate Chinese po02_01_con_3_28e6f4b8:

    # du "Smart."
    du "聪明。"

# game/script.rpy:10771
translate Chinese po02_01_con_3_fec25885:

    # be "Backup plan."
    be "备用方案。"

# game/script.rpy:10773
translate Chinese po02_01_con_3_ba29e75e:

    # wi "Yeah... Supplies can be replaced. You can't."
    wi "嗯……补给可以再找。你们不行。"

# game/script.rpy:10775
translate Chinese po02_01_con_3_0306073c:

    # wi "Five minutes. Check your gear. Check your weapons. Then we move."
    wi "五分钟。检查装备。检查武器。然后我们出发。"

# game/script.rpy:10777
translate Chinese po02_01_con_3_0ae9bcd0_569:

    # ""
    ""

