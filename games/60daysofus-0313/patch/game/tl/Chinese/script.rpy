# game/script.rpy:21660
translate Chinese po02_02_sto_con2_0b6b5c15:

    # ev "So, when are you two going to care about each other, huh?"
    ev "那你们俩打算什么时候也彼此在乎一下呢，嗯？"

# game/script.rpy:21662
