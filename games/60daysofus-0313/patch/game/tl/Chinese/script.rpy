    # du "Texas."
    du "德克萨斯。"

# game/script.rpy:15566
translate Chinese po02_01_con_4_qte_1_goodend_eab3ae48:

    # exteai "You picked one hell of a day to visit."
    exteai "你可挑了个够呛的日子来参观。"

# game/script.rpy:15567
translate Chinese po02_01_con_4_qte_1_goodend_948298c4:

    # du "Ma'am, I come out here every year."
    du "女士，我每年都来这儿。"

# game/script.rpy:15568
translate Chinese po02_01_con_4_qte_1_goodend_18b16c8d:

    # du "Just never seen the place this lively."
    du "就是从没见过这地方这么「热闹」过。"

# game/script.rpy:15570
translate Chinese po02_01_con_4_qte_1_goodend_04d68e5a:

    # exteai "Lively?"
    exteai "热闹？"

# game/script.rpy:15571
translate Chinese po02_01_con_4_qte_1_goodend_c0960ebc:

    # exteai "That's one word for it."
    exteai "也可以这么说吧。"

# game/script.rpy:15572
translate Chinese po02_01_con_4_qte_1_goodend_ca849ded:

    # du "You look busy."
    du "你看起来挺忙的。"

# game/script.rpy:15573
translate Chinese po02_01_con_4_qte_1_goodend_ecc1d35a:

    # exteai "Of course I am."
    exteai "那是当然。"

# game/script.rpy:15575
translate Chinese po02_01_con_4_qte_1_goodend_006fc341:

    # exteai "I've spent years trying to bring this city back to life."
    exteai "我花了好几年时间想让这座城市重新焕发生机。"

# game/script.rpy:15576
translate Chinese po02_01_con_4_qte_1_goodend_add6d864:

    # exteai "Los Suenos has been sick for a long time. I'm just trying to keep it from dying."
    exteai "洛斯苏埃诺斯病了很久了。我只是想不让它死掉。"

# game/script.rpy:15577
translate Chinese po02_01_con_4_qte_1_goodend_d08ef0f1:

    # du "Well... Ain't exactly an easy job."
    du "嗯……这活儿可真不轻松。"

# game/script.rpy:15578
translate Chinese po02_01_con_4_qte_1_goodend_76de3591:

    # exteai "No. Crime's been climbing for years."
    exteai "是啊。犯罪率已经攀升好几年了。"

# game/script.rpy:15579
translate Chinese po02_01_con_4_qte_1_goodend_37b24e69:

    # exteai "Drug overdoses. Gang violence. Syntrox."
    exteai "毒品过量。帮派暴力。合成粉。"

# game/script.rpy:15580
translate Chinese po02_01_con_4_qte_1_goodend_49257137:

    # exteai "And now veterans are protesting in the streets because the city keeps cutting the services they depend on."
    exteai "现在退伍军人还在街头抗议，因为这座城市一直在削减他们赖以生存的福利。"

# game/script.rpy:15581
translate Chinese po02_01_con_4_qte_1_goodend_d5cb775a:

    # exteai "Every time we try to fix something..."
    exteai "每次我们想解决点问题……"

# game/script.rpy:15582
translate Chinese po02_01_con_4_qte_1_goodend_3a43617e:

    # exteai "Somebody in a suit finds a reason not to."
    exteai "就总有个西装革履的人找出理由来阻挠。"

# game/script.rpy:15584
translate Chinese po02_01_con_4_qte_1_goodend_d214d353:

    # exteai "Everybody wants someone else to take the blame."
    exteai "每个人都想让别人来背这个锅。"

# game/script.rpy:15585
translate Chinese po02_01_con_4_qte_1_goodend_54fb3726:

    # du "Sounds like you've had your hands full."
    du "听起来你也是分身乏术啊。"

# game/script.rpy:15586
translate Chinese po02_01_con_4_qte_1_goodend_bf476b25:

    # exteai "Maybe it was beyond saving all along."
    exteai "也许这座城市从一开始就已经没救了。"

# game/script.rpy:15587
translate Chinese po02_01_con_4_qte_1_goodend_9ecac0aa:

    # exteai "Look at what's happening down there."
    exteai "看看楼下正在发生的一切。"

# game/script.rpy:15588
translate Chinese po02_01_con_4_qte_1_goodend_db7e24e5:

    # exteai "Tell me... Who's supposed to take responsibility for all this?"
    exteai "你说……这一切究竟该由谁来负责？"

