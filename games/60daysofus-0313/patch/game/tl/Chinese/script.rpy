    # ltgrn "What you've been doing with her... has already embarrassed me enough."
    ltgrn "你跟她干的那些事……已经够让我丢脸了。"

# game/script.rpy:919
translate Chinese po01_Con_1_86f2ebe5:

    # ltgrn "If this gets out..."
    ltgrn "要是这事传出去……"

# game/script.rpy:921
translate Chinese po01_Con_1_1658c2fa:

    # ltgrn "You won't be the only one who pays for it."
    ltgrn "付出代价的可不止你一个人。"

# game/script.rpy:922
translate Chinese po01_Con_1_19d02bbd:

    # ltgrn "Stay away from her."
    ltgrn "离她远一点。"

# game/script.rpy:923
translate Chinese po01_Con_1_27f4f242:

    # ltgrn "No calls. No messages. Nothing."
    ltgrn "不许打电话，不许发消息，别的都不许。"

# game/script.rpy:924
translate Chinese po01_Con_1_8982960c:

    # ltgrn "You understand?"
    ltgrn "明白了吗？"

# game/script.rpy:926
translate Chinese po01_Con_1_100d099a:

    # ltgrn "I'm trying to help you."
    ltgrn "我这是在帮你。"

# game/script.rpy:927
translate Chinese po01_Con_1_fb04ebab:

    # ltgrn "Go home. Forget all of this. Find yourself a new life."
    ltgrn "回家去，忘掉这一切，重新开始你的生活。"

# game/script.rpy:928
translate Chinese po01_Con_1_aa7f75fe:

    # ltgrn "And stay away from my daughter."
    ltgrn "还有，离我女儿远一点。"

