    # ""
    ""

# game/script.rpy:17952
translate Chinese po02_02_sto_con_d76f9a37:

    # ev "Thanks... for changing."
    ev "谢谢你……愿意改变。"

# game/script.rpy:17954
translate Chinese po02_02_sto_con_481bdfe5:

    # wi "No... I should be the one thanking you. Thanks for trusting me. My life almost fell apart."
    wi "不……该说谢谢的是我。谢谢你还愿意信任我。我的人生差点就彻底崩溃了。"

