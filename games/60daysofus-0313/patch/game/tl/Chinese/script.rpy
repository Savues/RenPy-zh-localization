# game/script.rpy:8616
translate Chinese po02_01_con_3_e303f4b3:

    # moln "They moved in a few months ago."
    moln "他们是几个月前搬进来的。"

# game/script.rpy:8617
translate Chinese po02_01_con_3_13467cb8:

    # moln "Three... maybe four."
    moln "三个……也许四个人。"

# game/script.rpy:8619
translate Chinese po02_01_con_3_18bee015:

    # moln "This place? Just storage. Their main operation's down the street."
    moln "这地方？只是个仓库。他们的主要据点在街那头。"

# game/script.rpy:8621
translate Chinese po02_01_con_3_2ef9aeb8:

    # moln "They rent this unit..."
    moln "他们租下这个单元……"

# game/script.rpy:8622
translate Chinese po02_01_con_3_f09115fd:

    # moln "Hooked up a route through the rooftop."
    moln "从楼顶接了条通道。"

# game/script.rpy:8623
translate Chinese po02_01_con_3_0f734c0d:

    # moln "Move product in, stash it here."
    moln "把货运进来，藏在这儿。"

# game/script.rpy:8625
translate Chinese po02_01_con_3_96899431:

    # moln "No parties. No noise. No trouble."
    moln "不开派对。不吵闹。不惹事。"

# game/script.rpy:8626
translate Chinese po02_01_con_3_bf4a6313:

    # moln "So when cops hit their main place... They find nothing. Everything's stored here."
    moln "所以当警察去查他们的主据点时……什么都找不到。东西全在这儿。"

# game/script.rpy:8628
translate Chinese po02_01_con_3_8e78c28f:

    # be "Why didn't you report them?"
    be "你为什么不举报他们？"

# game/script.rpy:8630
translate Chinese po02_01_con_3_be6e9f18:

    # moln "Because I didn't want this whole building turned into a graveyard."
    moln "因为我不想让整栋楼变成坟场。"

# game/script.rpy:8631
translate Chinese po02_01_con_3_917289d9:

    # moln "Some cops are clean. Not all of them."
    moln "有些警察是干净的。不是每个警察都干净。"

# game/script.rpy:8633
translate Chinese po02_01_con_3_479aa8aa:

    # moln "And if anything happens to their stash..."
    moln "而且要是他们的货出了什么事……"

# game/script.rpy:8634
translate Chinese po02_01_con_3_313450fe:

    # moln "They don't go after the police."
    moln "他们不会去找警察算账。"

# game/script.rpy:8635
translate Chinese po02_01_con_3_a02e92c3:

    # moln "They come here. And people in this building..."
    moln "他们会来这儿。而这栋楼里的人……"

# game/script.rpy:8636
translate Chinese po02_01_con_3_2f5aa54a:

    # moln "They're always the ones who pay."
    moln "到头来吃亏的永远是他们。"

# game/script.rpy:8637
translate Chinese po02_01_con_3_67f72635:

    # moln "So we stayed out of their way. They stayed out of ours."
    moln "所以我们不惹他们，他们也不惹我们。"

# game/script.rpy:8638
translate Chinese po02_01_con_3_8b56e18d:

    # moln "'{i}That was the deal.{/i}'"
    moln "「{i}这就是我们的约定。{/i}」"

# game/script.rpy:8640
translate Chinese po02_01_con_3_a1daa82e:

    # moln "Take what you need. And leave in the morning."
    moln "拿走你们需要的。早上就离开。"

# game/script.rpy:8641
translate Chinese po02_01_con_3_b01689c8:

    # moln "Before they come back for it."
    moln "趁他们还没回来找货之前。"

# game/script.rpy:8643
translate Chinese po02_01_con_3_e5c21b36:

    # moln "'{i}They got careless.{/i}'"
    moln "「{i}是他们自己大意了。{/i}」"

