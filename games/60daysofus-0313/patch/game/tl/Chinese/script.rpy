    # cia "They're training the ALF."
    cia "他们在训练ALF。"

# game/script.rpy:634
translate Chinese po01_Con_1_5765b9ba:

    # cia "Think of them as our shadow."
    cia "就把他们当成我们的影子好了。"

# game/script.rpy:646
