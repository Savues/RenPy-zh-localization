    # wi "Some are bad shots. Some are decent. Some know tactics."
    wi "有些枪法差。有些还不错。有些懂战术。"

# game/script.rpy:12851
translate Chinese po02_01_con_4_qte_1_goodend_c5dd929e:

    # wi "That officer... No visible bites. No obvious wounds."
    wi "那个警官……没有看得见的咬痕。没有明显的伤口。"

# game/script.rpy:12853
translate Chinese po02_01_con_4_qte_1_goodend_2057241c:

    # wi "And she was still infected."
    wi "但她还是被感染了。"

# game/script.rpy:12857
translate Chinese po02_01_con_4_qte_1_goodend_0b0a9f1f:

    # be "Then we can't assume someone's safe just because they look clean."
    be "那我们就不能因为一个人看着没事，就以为对方是安全的。"

# game/script.rpy:12858
translate Chinese po02_01_con_4_qte_1_goodend_b3ebe4ca:

    # wi "Exactly."
    wi "没错。"

# game/script.rpy:12859
translate Chinese po02_01_con_4_qte_1_goodend_e69d56ff:

    # wi "So the plan changes."
    wi "所以计划要变了。"

# game/script.rpy:12861
translate Chinese po02_01_con_4_qte_1_goodend_f837dcce:

    # aj "Man... Nothing ever goes according to plan."
    aj "老兄……从来就没有什么事是按计划走的。"

# game/script.rpy:12862
translate Chinese po02_01_con_4_qte_1_goodend_5068bd92:

    # aj "We make one plan... Then reality says, 'Fuck you.'"
    aj "我们定个计划……然后现实说，「去你的」。"

# game/script.rpy:12864
translate Chinese po02_01_con_4_qte_1_goodend_52de03d5:

    # wi "Plans don't survive first contact."
    wi "计划一旦接敌就会崩溃。"

# game/script.rpy:12865
translate Chinese po02_01_con_4_qte_1_goodend_59b94e4f:

    # wi "But that doesn't mean we move blind."
    wi "但这不代表我们要盲目行动。"

# game/script.rpy:12866
translate Chinese po02_01_con_4_qte_1_goodend_97a32283:

    # wi "From now on, every armed infected is a shooter."
    wi "从现在起，每个持有武器的感染者都视为射手。"

# game/script.rpy:12867
translate Chinese po02_01_con_4_qte_1_goodend_b08a4bb5:

    # wi "Use cover. Keep moving."
    wi "利用掩体。保持移动。"

# game/script.rpy:12868
translate Chinese po02_01_con_4_qte_1_goodend_32ea4306:

    # wi "We adapt when we have to."
    wi "该应变的时候就应变。"

# game/script.rpy:12870
translate Chinese po02_01_con_4_qte_1_goodend_be4efbb0:

    # du "Now that's a plan I can get behind."
    du "这计划我举双手赞成。"

# game/script.rpy:12872
translate Chinese po02_01_con_4_qte_1_goodend_861b9fa5:

    # wi "Alright. Time to move."
    wi "好了。该出发了。"

# game/script.rpy:12873
translate Chinese po02_01_con_4_qte_1_goodend_ecbbff27:

    # wi "We're leaving this place. We can't go back the way we came."
    wi "我们要离开这儿。不能走原路回去了。"

# game/script.rpy:12874
translate Chinese po02_01_con_4_qte_1_goodend_6db4a859:

    # wi "Only way out is the elevator at the far end of the hall."
    wi "唯一的出路是走廊尽头的电梯。"

# game/script.rpy:12875
translate Chinese po02_01_con_4_qte_1_goodend_089dd988:

    # wi "It'll take us down to the parking lot, then we move back to the fallback point."
    wi "它能把我们送到停车场，然后我们再退回撤退点。"

# game/script.rpy:12876
translate Chinese po02_01_con_4_qte_1_goodend_97866473:

    # wi "If we get pinned down there, we're done."
    wi "要是在那儿被压制住，我们就完了。"

# game/script.rpy:12877
translate Chinese po02_01_con_4_qte_1_goodend_d20fc28e:

    # wi "Finish your drinks. Check your weapons."
    wi "喝完你们的饮料。检查武器。"

# game/script.rpy:12878
translate Chinese po02_01_con_4_qte_1_goodend_a6bccd8d:

    # wi "Then we move."
    wi "然后出发。"

