    # ""
    ""

# game/script.rpy:21425
translate Chinese po02_02_sto_con2_3dcea2c7:

    # exteai "Elaine Patricia. Mayor of Los Suenos."
    exteai "伊莱恩·帕特里夏。洛斯苏埃诺斯市长。"

# game/script.rpy:21426
translate Chinese po02_02_sto_con2_7fef633e:

    # exteai "Now tell me, where's the squad? They were supposed to extract me!"
    exteai "现在告诉我，救援班在哪儿？他们本该来撤离我的！"

# game/script.rpy:21428
translate Chinese po02_02_sto_con2_850dc5d0:

    # re "Of course. A damn politician. Always thinking they're the center of the world."
    re "果然。又是个该死的政客。总觉得自己是世界的中心。"

# game/script.rpy:21429
translate Chinese po02_02_sto_con2_04139cba:

    # re "Acting like they run everything, but when the real shit hits, they hide behind others."
    re "装得好像什么都是他们说了算，可真出事的时候，躲得比谁都快。"

# game/script.rpy:21431
translate Chinese po02_02_sto_con2_b6006e38:

    # exteai "Officer! Arrest her! She's a criminal, dangerous!"
    exteai "警官！逮捕她！她是罪犯，很危险！"

# game/script.rpy:21432
translate Chinese po02_02_sto_con2_638a3d4b:

    # vir "And where exactly am I supposed to put her? The station is dusty."
    vir "那我该把她关到哪儿去？警局早就荒废了。"

# game/script.rpy:21434
translate Chinese po02_02_sto_con2_ef3ed9f5:

    # be "Figures. No matter the apocalypse, there's always a politician ready to make it worse."
    be "早就猜到了。不管末日成什么样，总有政客在添乱。"

# game/script.rpy:21438
translate Chinese po02_02_sto_con2_64ce2e91:

    # wi "Alright, that's enough. Just a few more steps and we're out of here. Everyone, move!"
    wi "好了，够了。再走几步我们就能离开这儿了。大家快走！"

