# game/script.rpy:19694
translate Chinese po02_02_sto_con2_159f6a8d:

    # extge "Last flight left around 2 a.m. Never came back."
    extge "最后一班直升机大概凌晨两点起飞的。再也没回来过。"

# game/script.rpy:19695
translate Chinese po02_02_sto_con2_4c834d54:

    # extge "The zombies hit hard... wiped everything out... like a fat kid devouring a cake, and then they were gone."
