    # wi "Evie. Go back to the room."
    wi "伊薇。回房间去。"

# game/script.rpy:8089
translate Chinese po02_01_con_3_b8a4c512:

    # wi "You shouldn't see this. Not this."
    wi "这个你不该看。这个不行。"

# game/script.rpy:8093
translate Chinese po02_01_con_3_00b895f5:

    # ev "Okay..."
    ev "好吧……"

# game/script.rpy:8095
translate Chinese po02_01_con_3_fe9fdb6f:

    # be "Alright. Tell me."
    be "好。告诉我。"

# game/script.rpy:8096
translate Chinese po02_01_con_3_ff14391d:

    # be "What's on the fifth floor?"
    be "五楼有什么？"

# game/script.rpy:8097
translate Chinese po02_01_con_3_982f0498:

    # wi "Drugs. Weapons."
    wi "毒品。武器。"

# game/script.rpy:8098
