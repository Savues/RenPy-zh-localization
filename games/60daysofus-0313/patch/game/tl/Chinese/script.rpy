    # ""
    ""

# game/script.rpy:10781
translate Chinese po02_01_con_3_27995a19:

    # wi "Your slide's locked back."
    wi "你的套筒锁在后边了。"

# game/script.rpy:10783
translate Chinese po02_01_con_3_bad369ec:

    # aj "Huh? Oh. Guess I'm dry."
    aj "嗯？哦。原来我枪里没弹了。"

# game/script.rpy:10785
translate Chinese po02_01_con_3_2ddfee2f:

    # wi "I've known for a while."
    wi "我早就知道了。"

# game/script.rpy:10787
translate Chinese po02_01_con_3_02dbfb1a:

    # aj "Then why didn't you say anything?"
    aj "那你怎么不早说？"

# game/script.rpy:10788
translate Chinese po02_01_con_3_c14b80af:

    # wi "Wanted to see if you'd notice."
    wi "想看看你自己会不会发现。"

# game/script.rpy:10789
translate Chinese po02_01_con_3_369621a5:

    # aj "Damn."
    aj "靠。"

# game/script.rpy:10791
translate Chinese po02_01_con_3_2a82fb5b:

    # wi "You picked that gun. Take care of it."
    wi "是你自己选的这把枪。好好照顾它。"

# game/script.rpy:10792
translate Chinese po02_01_con_3_5abbabbb:

    # wi "Keep track of your ammo. An empty gun is just expensive metal."
    wi "记好你的弹药数量。空枪就只是一堆昂贵的金属。"

# game/script.rpy:10794
translate Chinese po02_01_con_3_26da9a59:

    # aj "Cold."
    aj "你可真狠。"

# game/script.rpy:10795
translate Chinese po02_01_con_3_da99c4e0:

    # wi "True."
    wi "是事实。"

# game/script.rpy:10805
translate Chinese po02_01_con_3_0c9d6101:

    # aj "There. Happy now?"
    aj "好了。这下满意了？"

# game/script.rpy:10806
translate Chinese po02_01_con_3_5e13bdc9:

    # wi "Better."
    wi "好多了。"

# game/script.rpy:10807
translate Chinese po02_01_con_3_9d42082d:

    # aj "Man... I just hope my girl's safe in there."
    aj "老兄……我只希望我女朋友在里面平安无事。"

# game/script.rpy:10808
translate Chinese po02_01_con_3_ebd36806:

    # wi "You haven't tried contacting her?"
    wi "你还没试过联系她？"

# game/script.rpy:10809
translate Chinese po02_01_con_3_7e096c8f:

    # aj "My phone fucked up right when this shit started."
    aj "这事一开始我的手机就坏了。"

# game/script.rpy:10810
translate Chinese po02_01_con_3_a6fbc9fb:

    # aj "Haven't been able to reach her since."
    aj "从那以后就一直联系不上她。"

