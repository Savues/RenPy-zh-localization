    ""

# game/script.rpy:18554
translate Chinese po02_02_sto_con2_43f645aa:

    # wi "She's grieving. I get it. She just lost her people. She's angry, hurt... I would be too."
    wi "她在悲伤。我理解。她刚失去了自己的人。她愤怒、受伤……换成是我也会这样。"

# game/script.rpy:18557
translate Chinese po02_02_sto_con2_0ae9bcd0_10:

    # ""
    ""

# game/script.rpy:18559
