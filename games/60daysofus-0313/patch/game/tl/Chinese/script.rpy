    # vir "I'll go talk to her. We need to clear the air before we move."
    vir "我去跟她谈谈。出发前我们得把话说开。"

# game/script.rpy:18577
translate Chinese po02_02_sto_con2_4638e568:

    # vir "Sasha, get everyone loaded. We're heading out."
    vir "萨莎，让大家都上车。我们要出发了。"

