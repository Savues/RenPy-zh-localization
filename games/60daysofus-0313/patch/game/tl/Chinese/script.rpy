translate Chinese po02_01_con_4_qte_1_goodend_37c61416:

    # aj "I'm not sittin' my ass in the middle while y'all handle this."
    aj "你们动手的时候，我可不会缩在中间坐着。"

# game/script.rpy:12838
translate Chinese po02_01_con_4_qte_1_goodend_6e478041:

    # aj "If this shit goes sideways..."
    aj "万一情况失控了……"

# game/script.rpy:12839
translate Chinese po02_01_con_4_qte_1_goodend_6e0604a7:

    # aj "You want me right there with you."
    aj "你会希望我就在你身边。"

# game/script.rpy:12841
translate Chinese po02_01_con_4_qte_1_goodend_aafc2c94:

    # aj "So I'm stayin' right here."
    aj "所以我就待在这儿。"

# game/script.rpy:12842
translate Chinese po02_01_con_4_qte_1_goodend_55d0634c:

    # aj "You ain't gettin' rid of me that easy."
    aj "你可没那么容易甩掉我。"

# game/script.rpy:12843
translate Chinese po02_01_con_4_qte_1_goodend_0dd9c313:

