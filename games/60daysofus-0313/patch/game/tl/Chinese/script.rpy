    vir "嘿，你还撑得住吗？"

# game/script.rpy:17893
translate Chinese po02_02_sto_con_0b40ec7d:

    # extsasha "Just a little fever. Nothing serious."
    extsasha "就是有点发烧，没什么大事。"

# game/script.rpy:17895
translate Chinese po02_02_sto_con_02cf6b05:

    # vir "Hmm, you're burning up a bit."
    vir "嗯，你烧得有点高。"

# game/script.rpy:17897
translate Chinese po02_02_sto_con_cc399e68:

    # be "I saw some ibuprofen and aspirin in the med stockpile yesterday. I'll go check."
    be "我昨天在药品储备里看到了布洛芬和阿司匹林，我去找找看。"

# game/script.rpy:17899
translate Chinese po02_02_sto_con_4f045662:

    # vir "We'll get you something. You need to take it and rest. A fever isn't something to ignore."
    vir "我们会给你弄点药。你得吃药休息，发烧这种事不能不当回事。"

# game/script.rpy:17901
translate Chinese po02_02_sto_con_74298dff:

    # extsasha "I'll be fine, really. It's just a little fever. Don't worry about me."
    extsasha "我没事的，真的。就是有点发烧而已。别担心我。"

# game/script.rpy:17903
translate Chinese po02_02_sto_con_5fe44664:

    # vir "Stop being so stubborn. Beth will get you some medicine, and you should rest a bit more."
    vir "别这么固执了。贝丝会给你拿药，你也该多休息一下。"

# game/script.rpy:17905
translate Chinese po02_02_sto_con_fdbc722f:

    # extsasha "Okay... fine."
    extsasha "好吧……行。"

