    # be "Just breathe for a minute."
    be "先喘口气吧。"

# game/script.rpy:15650
translate Chinese po02_01_con_4_qte_1_goodend_050dc996:

    # be "You could've told us how bad it was."
    be "你本可以早点告诉我们情况有多糟的。"

# game/script.rpy:15652
translate Chinese po02_01_con_4_qte_1_goodend_ab8e79c3:

    # wi "You had enough to worry about."
    wi "你们要担心的事已经够多了。"

# game/script.rpy:15654
translate Chinese po02_01_con_4_qte_1_goodend_47fe05f0:

    # aj "And you didn't?"
    aj "那你也没说啊？"

# game/script.rpy:15655
translate Chinese po02_01_con_4_qte_1_goodend_0b804a2e:

    # aj "Look, I know I run my mouth. But I got a brain too."
    aj "听着，我知道我嘴上没个把门的。但我脑子也是能用的。"

# game/script.rpy:15656
translate Chinese po02_01_con_4_qte_1_goodend_07db90b1:

    # aj "Let me use it before you go figuring out every damn thing yourself."
    aj "在你把每件事都自己扛下来之前，先让我也动动脑子。"

# game/script.rpy:15658
translate Chinese po02_01_con_4_qte_1_goodend_c0700e6b_1:

    # wi "I'm trying to keep everyone alive."
    wi "我在努力让大家都活下来。"

# game/script.rpy:15660
translate Chinese po02_01_con_4_qte_1_goodend_bdf2113b:

    # aj "Yeah. So am I."
    aj "是啊。我也是。"

# game/script.rpy:15662
translate Chinese po02_01_con_4_qte_1_goodend_4ac53f33:

    # be "We can help, Will. You don't have to wait until you can't keep going."
    be "我们能帮你，威尔。你不必等到自己撑不住了才说。"

# game/script.rpy:15663
translate Chinese po02_01_con_4_qte_1_goodend_b80376d4:

    # wi "I don't always know what I need."
    wi "我不总是清楚自己需要什么。"

# game/script.rpy:15664
translate Chinese po02_01_con_4_qte_1_goodend_8283223f:

    # be "Then tell us that."
    be "那就告诉我们啊。"

# game/script.rpy:15665
translate Chinese po02_01_con_4_qte_1_goodend_5ad7337a:

    # wi "Alright. Just... give me a minute."
    wi "好吧。就……给我一分钟。"

# game/script.rpy:15667
translate Chinese po02_01_con_4_qte_1_goodend_a87294a8:

    # aj "Take it."
    aj "慢慢来。"

# game/script.rpy:15669
translate Chinese po02_01_con_4_qte_1_goodend_0ae9bcd0_392:

    # ""
    ""

# game/script.rpy:15671
translate Chinese po02_01_con_4_qte_1_goodend_a1e85093:

    # wi "Yumi, you did good down there."
    wi "由美，你刚才在下面表现得很好。"

# game/script.rpy:15673
translate Chinese po02_01_con_4_qte_1_goodend_af035ddf:

    # wi "You had the guts to stand and fight beside me."
    wi "你有胆量站在我身边一起战斗。"

# game/script.rpy:15675
translate Chinese po02_01_con_4_qte_1_goodend_30503d29:

    # yu "I didn't do much. I just tried to be useful"
    yu "我也没做什么。只是想尽量派上点用场。"

# game/script.rpy:15677
translate Chinese po02_01_con_4_qte_1_goodend_abd51665:

    # wi "That's more than enough."
    wi "这已经足够了。"

# game/script.rpy:15678
translate Chinese po02_01_con_4_qte_1_goodend_3e83e1c9:

    # wi "Don't risk your life just to prove you belong."
    wi "别为了证明自己属于这儿而拿命去冒险。"

# game/script.rpy:15679
translate Chinese po02_01_con_4_qte_1_goodend_377b2eaf:

    # yu "Okay. I'll try. Thanks, Will."
    yu "好。我会尽量的。谢谢你，威尔。"

# game/script.rpy:15681
translate Chinese po02_01_con_4_qte_1_goodend_2380abbd:

    # wi "Hey."
    wi "嘿。"

# game/script.rpy:15683
translate Chinese po02_01_con_4_qte_1_goodend_688e2c18:

    # di "What?"
    di "怎么了？"

# game/script.rpy:15684
translate Chinese po02_01_con_4_qte_1_goodend_3777b9f4:

    # wi "You told me that you don't give a damn about people."
    wi "你跟我说过你根本不在乎别人。"

# game/script.rpy:15685
translate Chinese po02_01_con_4_qte_1_goodend_9fdc6916:

    # wi "But you stayed at the back with me. You helped the others."
    wi "但你留下来跟我一起断后。你也帮了其他人。"

# game/script.rpy:15686
translate Chinese po02_01_con_4_qte_1_goodend_b96054be:

    # wi "And you stopped to help that cop downstairs."
    wi "而且你还停下来帮楼下那个警察。"

# game/script.rpy:15687
translate Chinese po02_01_con_4_qte_1_goodend_dd78e703_1:

    # wi "Why?"
    wi "为什么？"

# game/script.rpy:15689
translate Chinese po02_01_con_4_qte_1_goodend_910b93ae:

    # di "I knew her."
    di "我认识她。"

# game/script.rpy:15690
translate Chinese po02_01_con_4_qte_1_goodend_cb0f44b8:

    # di "I mean... I knew of her."
    di "我是说……我听说过她。"

# game/script.rpy:15691
translate Chinese po02_01_con_4_qte_1_goodend_165cbc85:

    # di "I'd fixed her patrol car a couple of times. Never knew her name."
    di "我帮她修过几次巡逻车。但一直不知道她叫什么名字。"

# game/script.rpy:15692
translate Chinese po02_01_con_4_qte_1_goodend_8b8288d3:

    # di "Down there, I saw her. She waved at me..."
    di "在下面的时候，我看到了她。她朝我挥了挥手……"

# game/script.rpy:15693
translate Chinese po02_01_con_4_qte_1_goodend_061c8cf7:

    # di "So I didn't think much of it. I just figured she was another survivor."
    di "所以我没多想。我以为她只是另一个幸存者。"

# game/script.rpy:15694
translate Chinese po02_01_con_4_qte_1_goodend_20041891:

    # di "That taught me a lesson."
    di "这件事让我明白了一个道理。"

# game/script.rpy:15696
translate Chinese po02_01_con_4_qte_1_goodend_e139b026:

    # wi "You've been talking more than usual."
    wi "你比平时话多了。"

# game/script.rpy:15697
translate Chinese po02_01_con_4_qte_1_goodend_f1c2c411:

    # wi "Looks like the ice is finally melting."
    wi "看来这层冰终于开始融化了。"

# game/script.rpy:15698
translate Chinese po02_01_con_4_qte_1_goodend_1970d964:

    # di "Yeah?"
    di "是吗？"

# game/script.rpy:15699
translate Chinese po02_01_con_4_qte_1_goodend_b00c0f3c:

    # wi "Are you sure you're actually a mechanic?"
    wi "你确定你真是个修车工？"

# game/script.rpy:15700
translate Chinese po02_01_con_4_qte_1_goodend_1111faed:

    # di "What makes you say that?"
    di "你为什么这么说？"

# game/script.rpy:15701
translate Chinese po02_01_con_4_qte_1_goodend_a1a973bb:

    # wi "You shoot like that..."
    wi "你枪法那么好……"

# game/script.rpy:15702
translate Chinese po02_01_con_4_qte_1_goodend_733327e1:

    # wi "And you've got skills I didn't expect."
    wi "而且你还有些我没想到的本事。"

# game/script.rpy:15703
translate Chinese po02_01_con_4_qte_1_goodend_a6225a49:

    # wi "You really are full of mysteries."
    wi "你身上还真是谜团重重。"

# game/script.rpy:15704
translate Chinese po02_01_con_4_qte_1_goodend_28ed753e:

    # di "Maybe... Don't get used to it."
    di "也许吧……别太习惯就是了。"

# game/script.rpy:15706
translate Chinese po02_01_con_4_qte_1_goodend_0ae9bcd0_393:

    # ""
    ""

# game/script.rpy:15708
translate Chinese po02_01_con_4_qte_1_goodend_4a8622c5:

    # exteai "Where are those soldiers? Why aren't they up here?"
    exteai "那些士兵在哪儿？他们怎么还没上来？"

# game/script.rpy:15709
translate Chinese po02_01_con_4_qte_1_goodend_c2a29b55:

    # exteai "They're supposed to get us out. Where the hell is the helicopter?"
    exteai "他们应该把我们撤出去的。直升机到底在哪儿？"

# game/script.rpy:15711
translate Chinese po02_01_con_4_qte_1_goodend_bd92e1b5:

