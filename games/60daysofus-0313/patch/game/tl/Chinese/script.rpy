    # exteai "Elaine Patricia. Mayor of Los Suenos."
    exteai "伊莱恩·帕特里夏。洛斯苏埃诺斯市长。"

# game/script.rpy:15564
translate Chinese po02_01_con_4_qte_1_goodend_fe59c042:

    # exteai "You don't sound local."
    exteai "听你口音不像本地人。"

# game/script.rpy:15565
