    wi "又来了……"

# game/script.rpy:17940
translate Chinese po02_02_sto_con_41b1e4c6:

    # ev "Again?"
    ev "又怎么了？"

# game/script.rpy:17942
translate Chinese po02_02_sto_con_dcc6be6a:

    # wi "I guess yesterday just hit me harder than I thought."
    wi "我猜昨天的事对我的打击比我以为的还要大。"

# game/script.rpy:17944
translate Chinese po02_02_sto_con_b007610d:

    # ev "Then drink this! Thunderbolt, energy drink. Gives you the power to fight zombies!"
    ev "那就喝这个！「雷霆一击」能量饮料。喝了就有力气打丧尸了！"

# game/script.rpy:17946
translate Chinese po02_02_sto_con_2b63d040:

    # wi "Thanks. I was just getting thirsty."
    wi "谢了，我正好有点渴。"

# game/script.rpy:17948
translate Chinese po02_02_sto_con_3e77ee95:

    # wi "Thanks, my lovely little sister."
    wi "谢谢你，我可爱的小妹妹。"

# game/script.rpy:17950
