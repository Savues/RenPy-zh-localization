translate Chinese po02_01_con_4_qte_1_goodend_957c22d5:

    # aj "For what? To just sit around and wait?"
    aj "图什么？就为了坐在这儿干等？"

# game/script.rpy:15904
translate Chinese po02_01_con_4_qte_1_goodend_c8d50187:

    # aj "Because I'm not ready to die on a damn rooftop."
    aj "因为我可不打算死在这该死的楼顶上。"

# game/script.rpy:15906
translate Chinese po02_01_con_4_qte_1_goodend_f6c8f8a9:

    # wi "Neither am I."
    wi "我也不打算。"

# game/script.rpy:15909
translate Chinese po02_01_con_4_qte_1_goodend_1fad541c:

    # ire "My mission was to extract a priority individual."
    ire "我的任务是撤离一名优先人员。"

# game/script.rpy:15910
translate Chinese po02_01_con_4_qte_1_goodend_a7b65fe7:

    # ire "That's what I was sent here to do."
    ire "那就是派我来这儿的目的。"

# game/script.rpy:15911
translate Chinese po02_01_con_4_qte_1_goodend_673e0c32:

    # ire "I tried to get you all out. I really did."
    ire "我试过把你们所有人都带出去。真的试过了。"

# game/script.rpy:15913
translate Chinese po02_01_con_4_qte_1_goodend_e4a3b136:

    # aj "Man... fuckin' knew it."
    aj "老兄……我他妈就知道。"

# game/script.rpy:15915
translate Chinese po02_01_con_4_qte_1_goodend_a335f3d9:

    # aj "Priority people..."
    aj "优先人员……"

# game/script.rpy:15916
translate Chinese po02_01_con_4_qte_1_goodend_2ffa6082:

    # aj "Kick my ass."
    aj "去他妈的。"

# game/script.rpy:15918
translate Chinese po02_01_con_4_qte_1_goodend_492e2da7:

    # ire "Will. I've got less than ten minutes. I need to talk to you. Alone."
    ire "威尔。我只剩不到十分钟了。我得单独跟你谈谈。"

# game/script.rpy:15919
translate Chinese po02_01_con_4_qte_1_goodend_1621b1a6:

    # wi "Alright."
    wi "好。"

# game/script.rpy:15921
translate Chinese po02_01_con_4_qte_1_goodend_0ae9bcd0_406:

    # ""
    ""

# game/script.rpy:15923
translate Chinese po02_01_con_4_qte_1_goodend_0ae9bcd0_407:

    # ""
    ""

# game/script.rpy:15925
translate Chinese po02_01_con_4_qte_1_goodend_0ae9bcd0_408:

    # ""
    ""

# game/script.rpy:15927
translate Chinese po02_01_con_4_qte_1_goodend_a34ba10e:

    # ire "Let me see that."
    ire "让我看看那个。"

# game/script.rpy:15931
translate Chinese po02_01_con_4_qte_1_goodend_d7a04f14:

    # wi "I'm fine. Get to the point."
    wi "我没事。说重点吧。"

# game/script.rpy:15935
translate Chinese po02_01_con_4_qte_1_goodend_b7b447e6:

    # ire "Will, I need to talk to you about..."
    ire "威尔，我有件事得跟你谈谈……"

# game/script.rpy:15937
translate Chinese po02_01_con_4_qte_1_goodend_c2d70240:

    # wi "If this is about Lawdalif, I'm done talking about it."
    wi "如果是关于劳达利夫的事，我已经不想再谈了。"

# game/script.rpy:15938
translate Chinese po02_01_con_4_qte_1_goodend_df703843:

    # wi "I just want that part of my life to be over."
    wi "我只想让人生的那一段彻底翻篇。"

# game/script.rpy:15940
translate Chinese po02_01_con_4_qte_1_goodend_90787edd:

    # ire "You think I don't understand that?"
    ire "你以为我不懂吗？"

# game/script.rpy:15942
translate Chinese po02_01_con_4_qte_1_goodend_325e7477:

    # wi "Then why are we having this conversation?"
    wi "那我们为什么还要谈这个？"

# game/script.rpy:15943
translate Chinese po02_01_con_4_qte_1_goodend_5f9a8059:

    # wi "If you want answers, check my helmet cam."
    wi "你想要答案的话，去查我的头盔摄像头。"

# game/script.rpy:15945
translate Chinese po02_01_con_4_qte_1_goodend_ecd64246:

    # ire "I tried."
    ire "我试过了。"

# game/script.rpy:15947
translate Chinese po02_01_con_4_qte_1_goodend_99352f3c:

    # ire "Yours was gone before the recovery team got there."
    ire "你的那份在回收小组赶到之前就已经没了。"

# game/script.rpy:15948
translate Chinese po02_01_con_4_qte_1_goodend_299280d3:

    # ire "The ones they recovered were corrupted."
    ire "他们找回来的那些都损坏了。"

# game/script.rpy:15949
translate Chinese po02_01_con_4_qte_1_goodend_f65a7046:

    # ire "Then somebody rebuilt the footage with AI."
    ire "后来有人用AI重建了画面。"

# game/script.rpy:15950
translate Chinese po02_01_con_4_qte_1_goodend_69d6f100:

    # ire "Just an IED strike. Just another convoy hit."
    ire "只是一次简易爆炸装置袭击。又一次车队遇袭。"

# game/script.rpy:15951
translate Chinese po02_01_con_4_qte_1_goodend_2a45f259:

    # ire "But that isn't what happened, is it?"
    ire "但事实并非如此，对吧？"

# game/script.rpy:15952
translate Chinese po02_01_con_4_qte_1_goodend_83aeab0d:

    # ire "Will..."
    ire "威尔……"

# game/script.rpy:15953
translate Chinese po02_01_con_4_qte_1_goodend_5bd12f8e:

    # ire "\"What happened at Lawdalif?\""
    ire "「劳达利夫到底发生了什么？」"

# game/script.rpy:15955
translate Chinese po02_01_con_4_qte_1_goodend_dfe9bf7f:

    # wi "I don't remember."
    wi "我不记得了。"

# game/script.rpy:15957
translate Chinese po02_01_con_4_qte_1_goodend_f919cb16:

    # ire "Nothing?"
    ire "什么都不记得？"

# game/script.rpy:15959
translate Chinese po02_01_con_4_qte_1_goodend_129f7503:

    # wi "Pieces. A road. An MATV. Then Lawdalif. After that… nothing."
    wi "只有片段。一条路。一辆防雷车。然后是劳达利夫。之后……就什么都没有了。"

# game/script.rpy:15961
translate Chinese po02_01_con_4_qte_1_goodend_3a5c4a30:

    # ire "I tried reaching the others who made it out."
    ire "我试着联系过其他活下来的人。"

# game/script.rpy:15962
translate Chinese po02_01_con_4_qte_1_goodend_2583bbdc:

    # ire "Staff Sergeant Joseph Turner."
    ire "约瑟夫·特纳上士。"

# game/script.rpy:15963
translate Chinese po02_01_con_4_qte_1_goodend_415a87e3:

    # ire "Corporal John James."
    ire "约翰·詹姆斯下士。"

# game/script.rpy:15964
translate Chinese po02_01_con_4_qte_1_goodend_3bd5b86d:

    # ire "Mohammad Saeed."
    ire "穆罕默德·萨伊德。"

# game/script.rpy:15965
translate Chinese po02_01_con_4_qte_1_goodend_5d16f5ab:

    # ire "I couldn't reach any of them. Not even you."
    ire "他们一个都联系不上。连你也是。"

# game/script.rpy:15967
translate Chinese po02_01_con_4_qte_1_goodend_c1f231ba:

    # wi "Irene, I don't want to talk about this."
    wi "艾琳，我不想谈这个。"

# game/script.rpy:15968
translate Chinese po02_01_con_4_qte_1_goodend_c62f5e75:

    # ire "And what about the Rangers?"
    ire "那游骑兵们呢？"

# game/script.rpy:15969
translate Chinese po02_01_con_4_qte_1_goodend_18274e5f:

    # ire "The British armored unit? The Russian Spetsnaz? The ADF?"
    ire "英国装甲部队？俄罗斯特种部队？澳大利亚国防军？"

# game/script.rpy:15970
translate Chinese po02_01_con_4_qte_1_goodend_f4c55084:

    # ire "They're all dead, Will."
    ire "他们全都死了，威尔。"

# game/script.rpy:15971
translate Chinese po02_01_con_4_qte_1_goodend_dfa4c0c1:

    # ire "Every one of them."
    ire "一个不剩。"

# game/script.rpy:15972
translate Chinese po02_01_con_4_qte_1_goodend_b8004d03:

    # ire "You really want to just walk away from that?"
    ire "你真打算就这么撇开不管吗？"

# game/script.rpy:15975
translate Chinese po02_01_con_4_qte_1_goodend_4a36c374:

    # wi "I said I don't remember!"
    wi "我说了我不记得了！"

# game/script.rpy:15977
translate Chinese po02_01_con_4_qte_1_goodend_949ca345:

    # ire "Then remember!"
    ire "那就想起来！"

# game/script.rpy:15979
translate Chinese po02_01_con_4_qte_1_goodend_93ae770d:

    # wi "You think I haven't tried?!"
    wi "你以为我没试过吗？！"

# game/script.rpy:15980
translate Chinese po02_01_con_4_qte_1_goodend_3f765aba:

    # wi "Every time I close my eyes, something comes back!"
    wi "每次我闭上眼睛，都会有东西浮现出来！"

# game/script.rpy:15981
translate Chinese po02_01_con_4_qte_1_goodend_312b942c:

    # wi "A flash. A sound. Someone screaming."
    wi "一道闪光。一声巨响。有人在尖叫。"

# game/script.rpy:15982
translate Chinese po02_01_con_4_qte_1_goodend_5fa61239:

    # wi "And then it's gone!"
    wi "然后就消失了！"

# game/script.rpy:15984
translate Chinese po02_01_con_4_qte_1_goodend_c3dccfb9:

    # wi "I don't know what happened to them!"
    wi "我不知道他们发生了什么！"

# game/script.rpy:15985
translate Chinese po02_01_con_4_qte_1_goodend_14ba24b1:

    # wi "I don't know who made it out!"
    wi "我不知道谁活了下来！"

# game/script.rpy:15986
translate Chinese po02_01_con_4_qte_1_goodend_a2721d3b:

    # wi "I don't even know what the hell I did!"
    wi "我甚至不知道我他妈做了什么！"

# game/script.rpy:15987
translate Chinese po02_01_con_4_qte_1_goodend_001c2749:

    # wi "You know what happened after I got discharged?"
    wi "你知道我退伍之后发生了什么吗？"

# game/script.rpy:15989
translate Chinese po02_01_con_4_qte_1_goodend_c8a5d42b:

    # wi "I had to face them every damn day."
    wi "我每天都得面对他们。"

# game/script.rpy:15990
translate Chinese po02_01_con_4_qte_1_goodend_bf9b7b4e:

    # wi "The red lights. The masks. Their faces... right in front of me."
    wi "那些红光。那些面具。他们的脸……就在我眼前。"

# game/script.rpy:15991
translate Chinese po02_01_con_4_qte_1_goodend_aeea673a:

    # wi "You were there too."
    wi "你当时也在。"

# game/script.rpy:15992
translate Chinese po02_01_con_4_qte_1_goodend_0ed23738:

    # wi "I killed more people after I came home."
    wi "我回家之后又杀了更多人。"

# game/script.rpy:15993
translate Chinese po02_01_con_4_qte_1_goodend_fdaced63:

    # wi "I almost did it to my own sister."
    wi "我差点对我自己的妹妹下了手。"

# game/script.rpy:15994
translate Chinese po02_01_con_4_qte_1_goodend_a5a09692:

    # wi "But she pulled me back."
    wi "但她把我拉了回来。"

# game/script.rpy:15996
translate Chinese po02_01_con_4_qte_1_goodend_f84d9587:

    # wi "So don't ask me to go back there."
    wi "所以别叫我回到那儿去。"

# game/script.rpy:15997
translate Chinese po02_01_con_4_qte_1_goodend_8a26fd92:

    # wi "I'm trying to live with what's left."
    wi "我在努力带着剩下的这些继续活下去。"

# game/script.rpy:15998
translate Chinese po02_01_con_4_qte_1_goodend_74906685:

    # wi "And for once... it's finally starting to feel like mine."
    wi "而且难得的是……这日子总算开始像是我自己的了。"

# game/script.rpy:15999
translate Chinese po02_01_con_4_qte_1_goodend_14d2308c:

    # wi "So... enough. I don't want this anymore."
    wi "所以……够了。我不想再这样了。"

# game/script.rpy:16001
translate Chinese po02_01_con_4_qte_1_goodend_0ae9bcd0_409:

    # ""
    ""

# game/script.rpy:16003
translate Chinese po02_01_con_4_qte_1_goodend_bb58aac3:

    # ire "I'm sorry, Will. Take it easy."
    ire "对不起，威尔。冷静点。"

# game/script.rpy:16004
translate Chinese po02_01_con_4_qte_1_goodend_b5e36500:

    # ire "I... I wasn't trying to set you off."
    ire "我……我没想惹你生气。"

# game/script.rpy:16005
translate Chinese po02_01_con_4_qte_1_goodend_9b6a331e:

    # ire "I'm just... trying to find answers."
    ire "我只是……想找到答案。"

# game/script.rpy:16007
translate Chinese po02_01_con_4_qte_1_goodend_19f9918e:

    # ire "This didn't just happen to you."
    ire "这不只是发生在你身上的事。"

# game/script.rpy:16008
translate Chinese po02_01_con_4_qte_1_goodend_c13a499c:

    # ire "I've been looking into it."
    ire "我一直在调查这件事。"

# game/script.rpy:16009
translate Chinese po02_01_con_4_qte_1_goodend_dc30c725:

    # ire "I had to come find you."
    ire "我必须来找你。"

# game/script.rpy:16010
translate Chinese po02_01_con_4_qte_1_goodend_c02f18a0:

    # ire "I'm sorry."
    ire "对不起。"

# game/script.rpy:16012
translate Chinese po02_01_con_4_qte_1_goodend_38895adc:

    # wi "I'm sorry I yelled at you."
    wi "抱歉我朝你吼了。"

# game/script.rpy:16013
translate Chinese po02_01_con_4_qte_1_goodend_e87f39e7:

    # wi "I just... I've been holding this in for a long time."
    wi "我只是……这些话我憋了很久了。"

# game/script.rpy:16014
translate Chinese po02_01_con_4_qte_1_goodend_aba52027:

    # ire "It's okay."
    ire "没关系。"

# game/script.rpy:16016
translate Chinese po02_01_con_4_qte_1_goodend_0ae9bcd0_410:

    # ""
    ""

# game/script.rpy:16018
translate Chinese po02_01_con_4_qte_1_goodend_bc5409ad:

    # ire "I want to get you guys out. I really do."
    ire "我想把你们都带出去。真的想。"

# game/script.rpy:16019
translate Chinese po02_01_con_4_qte_1_goodend_e3b9a82b:

    # ire "But I just got the update over the radio."
    ire "但我刚从无线电里收到了最新消息。"

# game/script.rpy:16020
translate Chinese po02_01_con_4_qte_1_goodend_233c133a:

    # ire "Everyone who made it out before has been detained."
    ire "之前撤离出去的人都被拘留了。"

# game/script.rpy:16021
translate Chinese po02_01_con_4_qte_1_goodend_1b0fee77:

    # ire "Including the VIP I'm supposed to extract."
    ire "包括我本该撤离的那位重要人物。"

# game/script.rpy:16023
translate Chinese po02_01_con_4_qte_1_goodend_32ca9a43:

    # wi "Where are you taking them?"
    wi "你们要把他们带去哪儿？"

# game/script.rpy:16025
translate Chinese po02_01_con_4_qte_1_goodend_7bc1881c:

    # ire "A carrier."
    ire "一艘航母。"

# game/script.rpy:16026
translate Chinese po02_01_con_4_qte_1_goodend_cd7ef6ce:

    # ire "But even the VIPs are detained too."
    ire "但就连VIP也被拘留了。"

# game/script.rpy:16027
translate Chinese po02_01_con_4_qte_1_goodend_48cf2861:

    # ire "Just... VIP treatment."
    ire "只是……待遇好点罢了。"

# game/script.rpy:16028
translate Chinese po02_01_con_4_qte_1_goodend_2746a2ff:

    # ire "If I take you with me, you'll be detained too."
    ire "要是我带你走，你也会被拘留的。"

# game/script.rpy:16029
translate Chinese po02_01_con_4_qte_1_goodend_5c00efd8:

    # ire "Honestly? You're better off staying here and waiting for long-term instructions."
    ire "说真的，你留在这儿等后续指示可能还好些。"

# game/script.rpy:16031
translate Chinese po02_01_con_4_qte_1_goodend_8f73443a:

    # wi "So either way... We're getting locked up."
    wi "所以不管怎样……我们都会被关起来。"

# game/script.rpy:16033
translate Chinese po02_01_con_4_qte_1_goodend_039df9bc:

    # ire "Pretty much."
    ire "差不多吧。"

# game/script.rpy:16034
translate Chinese po02_01_con_4_qte_1_goodend_3366b546:

    # ire "Then do me a favor."
    ire "那帮我个忙。"

# game/script.rpy:16035
translate Chinese po02_01_con_4_qte_1_goodend_8b36fa90:

    # ire "Get a phone working. Radio. Anything that can transmit."
    ire "想办法弄一部能用的手机。或者无线电。任何能发信号的东西。"

# game/script.rpy:16036
translate Chinese po02_01_con_4_qte_1_goodend_e630e905:

    # ire "Once we restore communications, I'll reach out."
    ire "一旦通讯恢复，我会联系你的。"

# game/script.rpy:16038
translate Chinese po02_01_con_4_qte_1_goodend_d2a8595f:

    # wi "Understood, 'Little Greyhound.'"
    wi "明白了，「小灵缇」。"

# game/script.rpy:16042
translate Chinese po02_01_con_4_qte_1_goodend_1c06d8f6:

    # ire "I'm being serious. And stop calling me that."
    ire "我是认真的。别再那么叫我了。"

# game/script.rpy:16043
translate Chinese po02_01_con_4_qte_1_goodend_a8fa08d1:

    # wi "Ow...!"
    wi "哎哟……！"

# game/script.rpy:16045
translate Chinese po02_01_con_4_qte_1_goodend_cb1633a9:

    # ire "That was so fucking cringey."
    ire "那个外号真他妈尴尬死了。"

# game/script.rpy:16046
translate Chinese po02_01_con_4_qte_1_goodend_e2ca020d:

    # ire "God, it was embarrassing."
    ire "天哪，太丢人了。"

# game/script.rpy:16048
translate Chinese po02_01_con_4_qte_1_goodend_c19972b3:

    # wi "You told me to call you that."
    wi "是你叫我这么叫你的。"

# game/script.rpy:16050
translate Chinese po02_01_con_4_qte_1_goodend_616d964b:

    # ire "I know!"
    ire "我知道！"

# game/script.rpy:16051
translate Chinese po02_01_con_4_qte_1_goodend_333eae0d:

    # ire "That's how my dad figured us out."
    ire "我爸就是因为这个才发现我们的事的。"

# game/script.rpy:16052
translate Chinese po02_01_con_4_qte_1_goodend_d49575c4:

    # ire "And that's how we ended."
    ire "我们也是因为这样才分的手。"

# game/script.rpy:16053
translate Chinese po02_01_con_4_qte_1_goodend_73e3a025:

    # ire "He's still pissed about it."
    ire "他到现在还在为这事生气。"

# game/script.rpy:16054
translate Chinese po02_01_con_4_qte_1_goodend_9e7cff5a:

    # ire "He'd probably kill you if he found out we're together again."
    ire "要是他发现我们又在一起了，估计会宰了你。"

# game/script.rpy:16055
translate Chinese po02_01_con_4_qte_1_goodend_3f0fda5e:

    # ire "Seriously..."
    ire "说真的……"

# game/script.rpy:16056
translate Chinese po02_01_con_4_qte_1_goodend_fa3e9630:

    # ire "You don't remember anything, but you remember that?"
    ire "你什么都不记得，倒记得这个？"

# game/script.rpy:16058
translate Chinese po02_01_con_4_qte_1_goodend_0e4a5460:

    # wi "Sorry, ma'am."
    wi "抱歉，女士。"

# game/script.rpy:16059
translate Chinese po02_01_con_4_qte_1_goodend_d349d549:

    # wi "I remember what matters."
    wi "我只记得重要的事。"

# game/script.rpy:16060
translate Chinese po02_01_con_4_qte_1_goodend_949295c6:

    # ire "Asshole..."
    ire "混蛋……"

# game/script.rpy:16062
translate Chinese po02_01_con_4_qte_1_goodend_cce1c5dc:

    # ire "There. You're starting to sound like the old you again."
    ire "瞧。你又开始有点像以前的你了。"

# game/script.rpy:16063
translate Chinese po02_01_con_4_qte_1_goodend_45f69bca:

    # ire "At least I got to see that miserable little loser asshole one more time."
    ire "至少我又见到那个可怜的小混蛋一面了。"

# game/script.rpy:16065
translate Chinese po02_01_con_4_qte_1_goodend_87793e38:

