# game/script.rpy:10620
translate Chinese po02_01_con_3_ba93e06b:

    # aj "Like... she ain't screaming. Ain't crying. Ain't acting annoying."
    aj "就是……她不尖叫，不哭，也不烦人。"

# game/script.rpy:10621
translate Chinese po02_01_con_3_0b5ab1ff:

    # aj "I respect that."
    aj "这点我服。"

# game/script.rpy:10623
translate Chinese po02_01_con_3_642d2bc7:

    # ev "That sounds like a compliment and an insult at the same time."
    ev "这听起来又像夸我又像损我。"

# game/script.rpy:10625
translate Chinese po02_01_con_3_9f1fdeaf:

    # aj "Nah, I'm serious."
    aj "不是，我是认真的。"

# game/script.rpy:10626
translate Chinese po02_01_con_3_6f273cc3:

    # aj "Most people would've lost their damn minds already."
    aj "大多数人早就崩溃了。"

# game/script.rpy:10627
translate Chinese po02_01_con_3_6a8a5849:

    # aj "Dead people running around... Gunshots everywhere... And you still chillin'."
    aj "死人到处跑……枪声四起……你却还这么淡定。"

# game/script.rpy:10629
translate Chinese po02_01_con_3_537ef2b4:

    # ev "I'm scared though."
    ev "不过我其实很害怕。"

# game/script.rpy:10630
translate Chinese po02_01_con_3_b7512b68:

    # ev "I just... If my brother sees me panic... He'll panic harder."
    ev "我只是……如果我哥看到我慌了，他会更慌。"

# game/script.rpy:10632
translate Chinese po02_01_con_3_8e4a1fb0:

    # wi "Evie..."
    wi "伊薇……"

# game/script.rpy:10633
translate Chinese po02_01_con_3_a1961c61:

    # ev "It's true. You already look stressed all the time."
    ev "确实。你看起来一直压力很大。"

# game/script.rpy:10636
translate Chinese po02_01_con_3_0ae9bcd0_560:

    # ""
    ""

# game/script.rpy:10638
translate Chinese po02_01_con_3_23d27cf8:

    # aj "Yo... About yesterday... sorry."
    aj "哟……昨天那事……抱歉。"

# game/script.rpy:10639
translate Chinese po02_01_con_3_e9d273f5:

    # aj "When things get bad, I joke too much. For real."
    aj "情况一糟，我就忍不住开玩笑。说真的。"

# game/script.rpy:10641
translate Chinese po02_01_con_3_786863e6:

    # yu "I kept thinking about it too. Like maybe I really am useless."
    yu "我也一直在想这事。就好像我真的很没用似的。"

# game/script.rpy:10643
translate Chinese po02_01_con_3_23ba964b:

    # wi "Yumi..."
    wi "由美……"

# game/script.rpy:10644
translate Chinese po02_01_con_3_93f42e5a:

    # yu "No, listen..."
    yu "不，听我说……"

# game/script.rpy:10646
translate Chinese po02_01_con_3_527255d2:

    # yu "I'm not strong like you guys."
    yu "我不像你们那么强。"

# game/script.rpy:10647
translate Chinese po02_01_con_3_69f5299f:

    # yu "I don't want to become baggage."
    yu "我不想成为累赘。"

# game/script.rpy:10649
translate Chinese po02_01_con_3_41a6e862:

    # aj "Nah... Burden people don't charge zombies with a sword."
    aj "不是……累赘可不会拿着刀冲向丧尸。"

# game/script.rpy:10651
translate Chinese po02_01_con_3_0ae9bcd0_561:

    # ""
    ""

# game/script.rpy:10653
translate Chinese po02_01_con_3_a59548c5:

    # wi "He's annoying. But he's right."
    wi "他这人烦人。但他说得对。"

# game/script.rpy:10655
translate Chinese po02_01_con_3_31920b33:

    # aj "Damn right."
    aj "说得太对了。"

# game/script.rpy:10656
translate Chinese po02_01_con_3_c00ef443:

    # wi "You're still here. That means something."
    wi "你还在这儿。这就说明了一切。"

# game/script.rpy:10657
translate Chinese po02_01_con_3_38e276af:

    # yu "Thanks..."
    yu "谢谢……"

# game/script.rpy:10659
translate Chinese po02_01_con_3_0ae9bcd0_562:

    # ""
    ""

# game/script.rpy:10661
translate Chinese po02_01_con_3_402a57f7:

    # yu "Hey... do we still have any spare guns?"
    yu "嘿……我们还有多余的枪吗？"

# game/script.rpy:10662
translate Chinese po02_01_con_3_b78a3f0d:

    # wi "Ever used one before?"
    wi "你以前用过枪吗？"

# game/script.rpy:10663
translate Chinese po02_01_con_3_0713f2b5:

    # yu "Nope."
    yu "没有。"

# game/script.rpy:10665
translate Chinese po02_01_con_3_2ba2f35f:

    # wi "Then no."
    wi "那就不行。"

# game/script.rpy:10666
translate Chinese po02_01_con_3_eeedcb58:

    # wi "You're not ready."
    wi "你还没准备好。"

# game/script.rpy:10668
translate Chinese po02_01_con_3_90a85921:

    # wi "People think shooting's easy. Panic, and somebody gets hurt."
    wi "大家都以为开枪很简单。一慌乱，就会有人受伤。"

# game/script.rpy:10669
translate Chinese po02_01_con_3_2c0e3978:

    # wi "Later, I'll teach you."
    wi "之后我会教你的。"

# game/script.rpy:10670
translate Chinese po02_01_con_3_68d170e9:

    # yu "Really?"
    yu "真的？"

# game/script.rpy:10672
translate Chinese po02_01_con_3_ef1f552d:

    # wi "Safety first. Then shooting."
    wi "安全第一，然后才是射击。"

# game/script.rpy:10674
translate Chinese po02_01_con_3_93daebcd:

    # ev "Me too! Me too!"
    ev "我也要！我也要！"

# game/script.rpy:10675
translate Chinese po02_01_con_3_8e4a1fb0_1:

    # wi "Evie..."
    wi "伊薇……"

# game/script.rpy:10676
translate Chinese po02_01_con_3_80f0b502:

    # ev "Come on! If everybody's learning, I'm learning too"
    ev "拜托嘛！大家都在学，我也要学。"

# game/script.rpy:10677
translate Chinese po02_01_con_3_f7c70250:

    # wi "Fine..."
    wi "好吧……"

# game/script.rpy:10679
translate Chinese po02_01_con_3_0ae9bcd0_563:

    # ""
    ""

# game/script.rpy:10683
translate Chinese po02_01_con_3_4e9b17ed:

    # ev "Our car's still back there."
    ev "我们的车还留在那儿。"

# game/script.rpy:10684
translate Chinese po02_01_con_3_8aec9a40:

    # wi "We got boxed in. Had to leave it. Still hurts, though."
    wi "我们被困住了。只能丢下它。不过还是挺心疼的。"

# game/script.rpy:10685
translate Chinese po02_01_con_3_053f9b12:

    # wi "Dad's R35..."
    wi "爸爸的R35……"

# game/script.rpy:10687
translate Chinese po02_01_con_3_7d83da88:

    # di "Wait... You said R35?"
    di "等等……你说R35？"

# game/script.rpy:10689
translate Chinese po02_01_con_3_94df22b0:

    # di "Nissan R35?"
    di "日产R35？"

# game/script.rpy:10691
translate Chinese po02_01_con_3_b67a7770:

    # wi "Yeah?"
    wi "对啊？"

# game/script.rpy:10693
translate Chinese po02_01_con_3_fa1fd1cc:

    # di "WHY... would you leave it?"
    di "你……你怎么能丢下它？"

# game/script.rpy:10694
translate Chinese po02_01_con_3_be97f4f4:

    # wi "Because we were busy not dying."
    wi "因为我们当时忙着不去死。"

# game/script.rpy:10696
translate Chinese po02_01_con_3_d0952d5a:

    # di "Where exactly?"
    di "具体在哪儿？"

# game/script.rpy:10697
translate Chinese po02_01_con_3_aec048a9:

    # wi "You're serious?"
    wi "你是认真的？"

# game/script.rpy:10698
translate Chinese po02_01_con_3_0876fb0d:

    # di "Very."
    di "非常认真。"

# game/script.rpy:10699
translate Chinese po02_01_con_3_d6052582:

    # wi "Middle of zombies, probably."
    wi "大概在一堆丧尸中间吧。"

# game/script.rpy:10701
translate Chinese po02_01_con_3_b94f4b29:

    # di "Pain..."
    di "好痛……"

# game/script.rpy:10703
translate Chinese po02_01_con_3_dfa46930:

    # aj "AHAHAHA... She looks more upset about the car than the apocalypse."
    aj "哈哈哈哈……她看起来比对末日还在意那辆车。"

# game/script.rpy:10705
translate Chinese po02_01_con_3_0ae9bcd0_564:

    # ""
    ""

# game/script.rpy:10707
translate Chinese po02_01_con_3_768709ae:

    # ev "Dad loved that car. He cleaned that car like every single day."
    ev "爸爸超爱那辆车的。他几乎每天都要洗车。"

# game/script.rpy:10709
translate Chinese po02_01_con_3_653ff419:

    # wi "I wasn't even around when he bought it."
    wi "他买车的时候我都不在。"

# game/script.rpy:10710
translate Chinese po02_01_con_3_c9b38902:

    # wi "When I got home... It was already sitting in the garage."
    wi "等我回家的时候……它已经停在车库里了。"

# game/script.rpy:10712
translate Chinese po02_01_con_3_92d63d51:

    # wi "Actually... That car got stolen once."
    wi "其实……那辆车被偷过一次。"

# game/script.rpy:10714
translate Chinese po02_01_con_3_7764ddfc:

    # ev "Wait... WHEN?"
    ev "等等……什么时候的事？"

# game/script.rpy:10715
translate Chinese po02_01_con_3_1e9e00aa:

    # wi "Back when I was still messed up."
    wi "那时候我还一团糟。"

# game/script.rpy:10717
translate Chinese po02_01_con_3_3c4ca8bb:

    # aj "Now we talkin'."
    aj "这才叫故事嘛。"

# game/script.rpy:10719
translate Chinese po02_01_con_3_9126bc9c:

    # wi "Guys put a gun to my head. Took the car."
    wi "有人拿枪指着我的头。把车抢走了。"

# game/script.rpy:10721
translate Chinese po02_01_con_3_a5a198f8_1:

    # aj "Damn..."
    aj "靠……"

# game/script.rpy:10723
translate Chinese po02_01_con_3_7505111a:

    # wi "I tracked the car down myself. So I found it. And drove it home."
    wi "我自己把那辆车追了回来。找到了它，开回了家。"

# game/script.rpy:10725
translate Chinese po02_01_con_3_f632ed16:

    # aj "Bro skipped the entire action movie."
    aj "老兄这是把整部动作片都跳过了。"

# game/script.rpy:10727
translate Chinese po02_01_con_3_1d3aa9d5:

    # ev "You never told me this!"
    ev "你从没跟我说过这事！"

# game/script.rpy:10728
translate Chinese po02_01_con_3_cf4a1b03:

    # wi "Wasn't exactly a proud moment."
    wi "那也不是什么值得骄傲的事。"

# game/script.rpy:10730
translate Chinese po02_01_con_3_144d0756:

    # di "Was the car okay?"
    di "那车没事吧？"

# game/script.rpy:10732
translate Chinese po02_01_con_3_208bf3e4:

    # wi "That's your question?"
    wi "你问的是这个？"

# game/script.rpy:10734
translate Chinese po02_01_con_3_e0df77f3:

    # di "Absolutely."
    di "当然。"

# game/script.rpy:10735
translate Chinese po02_01_con_3_6b4e5f6e:

    # di "You got it back once. We'll get it back again."
    di "你以前找回过一次。这次我们也能找回来。"

# game/script.rpy:10737
translate Chinese po02_01_con_3_140117db:

    # wi "You really like that car, huh?"
    wi "你是真的很喜欢那辆车啊，是吧？"

# game/script.rpy:10739
translate Chinese po02_01_con_3_2b4ed05c:

    # di "No. I like people who fight for things they care about."
    di "不是。我喜欢那种愿意为自己在乎的东西去争取的人。"

# game/script.rpy:10740
translate Chinese po02_01_con_3_6032a7ef:

    # di "And it's an R35."
    di "而且那可是R35。"

# game/script.rpy:10742
translate Chinese po02_01_con_3_a1a5835f:

    # aj "There it is. Knew the car was part of it."
    aj "我就说嘛。我就知道那辆车肯定也是原因之一。"

