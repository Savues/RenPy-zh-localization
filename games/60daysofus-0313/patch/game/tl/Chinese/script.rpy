translate Chinese po02_01_con_4_qte_1_goodend_92e5b567:

    # wi "Down there. They're holding the line for us. They're good. They'll be fine."
    wi "他们在下面。为我们守着防线。他们很厉害。会没事的。"

# game/script.rpy:15643
translate Chinese po02_01_con_4_qte_1_goodend_856f35ad:

    # wi "I'm done thinking for a minute. But don't drop your guard."
    wi "我先歇一会儿，不去想了。但你们别放松警惕。"

# game/script.rpy:15645
translate Chinese po02_01_con_4_qte_1_goodend_43a41b9a:

    # aj "We got it, man. Rest."
    aj "我们明白，老兄。你歇着吧。"

# game/script.rpy:15647
translate Chinese po02_01_con_4_qte_1_goodend_0ae9bcd0_391:

    # ""
    ""

