    # vir "Sasha, stop it!"
    vir "萨莎，住手！"

# game/script.rpy:19143
translate Chinese po02_02_sto_con2_631108ca:

    # re "I never planned on ending this with you either..."
    re "我也从没打算跟你就这么了结……"

# game/script.rpy:19144
translate Chinese po02_02_sto_con2_db2adb45:

    # re "I don't even know what the hell I did to piss you off, but I've said it before..."
    re "我都不知道我到底做了什么把你惹毛了，但我说过……"

# game/script.rpy:19145
translate Chinese po02_02_sto_con2_92555c7d:

    # re "{i}I will kill you.{i}"
    re "{i}我会杀了你。{/i}"

# game/script.rpy:19147
translate Chinese po02_02_sto_con2_fd8d3d13:

    # extsasha "Well, maybe now's the perfect fucking time to end it!"
    extsasha "那也许现在正是他妈的了结的最佳时机！"

# game/script.rpy:19149
translate Chinese po02_02_sto_con2_873d12be:

    # be "Will, do something."
    be "威尔，做点什么吧。"

# game/script.rpy:19153
translate Chinese po02_02_sto_con2_50f3eac8:

    # wi "Both of you, stop it! This isn't the time. You're gonna get us all killed if you keep this up!"
    wi "你们俩都住手！现在不是时候。你们这样下去会害死我们所有人的！"

# game/script.rpy:19155
translate Chinese po02_02_sto_con2_c454156d:

    # extsasha "Get out of the way, Will. You have no idea what kind of person she is!"
    extsasha "让开，威尔。你根本不知道她是什么样的人！"

# game/script.rpy:19158
