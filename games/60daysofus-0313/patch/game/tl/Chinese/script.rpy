# game/script.rpy:21413
translate Chinese po02_02_sto_con2_25cd9992:

    # be "The LSPD runs training programs pretty often."
    be "洛斯苏埃诺斯警局经常搞培训项目。"

# game/script.rpy:21415
translate Chinese po02_02_sto_con2_ff1d1154:

    # vir "Yeah, self-defense with firearms. Crime's too common here."
    vir "对，枪械自卫训练。这儿犯罪率太高了。"

# game/script.rpy:21417
translate Chinese po02_02_sto_con2_c6f0d8a8:

    # be "So I went every time. Sometimes I took time off work, sometimes the hospital sent us."
    be "所以我每次都去参加。有时候是请假去的，有时候是医院安排我们去的。"

# game/script.rpy:21418
translate Chinese po02_02_sto_con2_df1834e9:

    # be "Look, I'm not useless in this group, okay?"
    be "听着，我在这个团队里可不是没用的人，好吗？"

# game/script.rpy:21421
translate Chinese po02_02_sto_con2_a06589bc:

    # be "Wait a sec... you're...?"
    be "等等……你是……？"

# game/script.rpy:21423
