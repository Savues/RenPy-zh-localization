# game/script.rpy:17194
translate Chinese po02_02_92ac893e:

    # ren "That bike was all I had left! And you just... left it out there like it was nothing!"
    ren "那辆摩托车是我最后剩下的东西了！而你们就这么……把它留在外面，好像根本不算什么似的！"

# game/script.rpy:17196
translate Chinese po02_02_125fc61c:

    # virn "We're alive, and we're safe—for now. That's all that matters."
    virn "我们还活着，暂时也算安全了。这才是最重要的。"

# game/script.rpy:17198
translate Chinese po02_02_828602d5:

    # ren "Fuck off! Just leave me alone already."
    ren "滚开！别烦我了。"

# game/script.rpy:17200
