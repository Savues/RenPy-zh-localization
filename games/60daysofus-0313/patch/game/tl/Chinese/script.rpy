translate Chinese po02_01_con_4_qte_1_goodend_3f325e4f:

    # wi "You fall back. No arguing."
    wi "你就得退下去。没得商量。"

# game/script.rpy:12845
translate Chinese po02_01_con_4_qte_1_goodend_f1b70151:

    # aj "Aight. You got it, Captain."
    aj "行。听你的，队长。"

# game/script.rpy:12847
translate Chinese po02_01_con_4_qte_1_goodend_5f106e99:

    # wi "We just learned something important."
    wi "我们刚学到了一件重要的事。"

