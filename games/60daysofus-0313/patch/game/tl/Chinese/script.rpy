translate Chinese po02_02_con_1_1a26cb6b:

    # be "Not exactly gourmet, but it'll keep us going."
    be "算不上什么美食，但能让我们撑下去。"

# game/script.rpy:17523
translate Chinese po02_02_con_1_f150bb8d:

    # ren "Guess this is our dinner party, huh? I'll pass. Not really in the mood to eat right now."
    ren "我猜这就是我们的晚宴了吧？我就不参加了。现在没什么胃口。"

# game/script.rpy:17525
translate Chinese po02_02_con_1_629a59a5:

    # vir "You might want to change your mind. We don't know when we'll get another chance to eat."
    vir "你可能得改改主意。我们不知道下次还有没有机会吃东西。"

# game/script.rpy:17527
