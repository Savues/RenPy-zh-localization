# game/script.rpy:18644
translate Chinese po02_02_sto_con2_6ec3b8b1:

    # vir "See that? They're still out there. Still flying. That means someone up there's still fighting for us."
    vir "看到了吗？他们还在那儿。还在飞。这说明天上还有人在为我们战斗。"

# game/script.rpy:18645
translate Chinese po02_02_sto_con2_d87542c3:

    # vir "And maybe... maybe we're not as alone as it feels."
    vir "也许……也许我们没感觉上那么孤单。"

# game/script.rpy:18646
translate Chinese po02_02_sto_con2_b17106bb:

    # vir "Let's head to the Empire Mall. They'll get us out of here."
    vir "我们去帝国商场吧。他们会带我们离开这里的。"

# game/script.rpy:18647
translate Chinese po02_02_sto_con2_1ffd78c3:

    # re "Yeah... if that chopper can carry my bike too."
    re "行……如果那直升机能带上我的摩托车的话。"

# game/script.rpy:18649
translate Chinese po02_02_sto_con2_261d0726:

    # vir "If it can't, I'll just tie it to the chopper and fly it out. Not bad, right? Your bike gets to fly for the first time."
    vir "要是不行，我就把它绑在直升机上一起飞出去。不错吧？你的车能第一次体验飞行了。"

# game/script.rpy:18651
translate Chinese po02_02_sto_con2_2e4f420c:

    # re "You better not scratch it."
    re "你最好别刮花它。"

# game/script.rpy:18653
translate Chinese po02_02_sto_con2_3beb413a:

    # vir "Deal. But only if you promise not to punch me for tying a bow on it."
    vir "成交。但你得保证，我在上面绑个蝴蝶结你不会揍我。"

# game/script.rpy:18655
translate Chinese po02_02_sto_con2_7f37e1b3:

    # re "You're damn weird, you know that?"
    re "你他妈挺奇怪的，你知道吗？"

# game/script.rpy:18657
translate Chinese po02_02_sto_con2_6b40d6ff:

    # vir "Yeah... but weird earns trust faster than silence, don't you think?"
    vir "是啊……不过奇怪总比沉默更容易赢得信任，你说呢？"

# game/script.rpy:18659
translate Chinese po02_02_sto_con2_7331f7d1:

    # re "...Maybe."
    re "……也许吧。"

# game/script.rpy:18661
translate Chinese po02_02_sto_con2_6df1f12e:

    # vir "I want you to lead us to The Empire Mall."
    vir "我想让你带我们去帝国商场。"

# game/script.rpy:18662
translate Chinese po02_02_sto_con2_0ae674cd:

    # vir "Full throttle. Raise some hell."
    vir "全速前进，大闹一场。"

# game/script.rpy:18664
translate Chinese po02_02_sto_con2_518bea49:

    # re "Now you're talking my language."
    re "这才对我的胃口。"

# game/script.rpy:18666
translate Chinese po02_02_sto_con2_8530fed7:

    # vir "Ready? Let's go."
    vir "准备好了？出发。"

