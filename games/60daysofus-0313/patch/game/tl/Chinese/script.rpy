    # be "And AJ and Dust?"
    be "那A.J.和达斯特呢？"

# game/script.rpy:8099
translate Chinese po02_01_con_3_b51b0c84:

    # wi "Yeah... We talked about going up there."
    wi "嗯……我们商量过要上去。"

# game/script.rpy:8100
translate Chinese po02_01_con_3_9feb0b38:

    # wi "Getting those guns. We're gonna need them. I just didn't expect them to go now"
    wi "去拿那些枪。我们会需要的。只是没想到他们这么快就去了。"

# game/script.rpy:8101
translate Chinese po02_01_con_3_ea0d5d00:

    # be "And the owners?"
    be "那些东西的主人呢？"

# game/script.rpy:8102
