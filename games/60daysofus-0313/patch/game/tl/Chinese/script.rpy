translate Chinese po02_01_con_3_0c7c2ba3:

    # di "After me."
    di "在我后面。"

# game/script.rpy:7412
translate Chinese po02_01_con_3_a3b1a3b6:

    # be "Wow... one charger, huh."
    be "哇……就一个充电器啊。"

# game/script.rpy:7413
translate Chinese po02_01_con_3_2df01ef1:

    # be "Guess I'll get mine in the morning."
    be "看来我得等到早上了。"

# game/script.rpy:7415
translate Chinese po02_01_con_3_1af41d92:

    # be "Anyway..."
    be "总之……"

# game/script.rpy:7416
translate Chinese po02_01_con_3_b70d8cca:

    # be "Internet's dead..."
    be "网络断了……"

# game/script.rpy:7417
translate Chinese po02_01_con_3_d8c24b38:

    # be "Might as well try the TV."
    be "不如试试电视吧。"

# game/script.rpy:7419
translate Chinese po02_01_con_3_0ae9bcd0_214:

    # ""
    ""

# game/script.rpy:7421
translate Chinese po02_01_con_3_2577c738:

    # aj "Keep flipping."
    aj "接着换台。"

# game/script.rpy:7422
translate Chinese po02_01_con_3_a518f236:

    # aj "Gotta be somethin' on."
    aj "总该有点节目吧。"

# game/script.rpy:7423
translate Chinese po02_01_con_3_c36ddbd0:

    # be "Hey, smartphone era. I haven't used a TV in ages."
    be "嘿，智能手机时代嘛，我都好久没用过电视了。"

# game/script.rpy:7424
translate Chinese po02_01_con_3_0f0e8f3d:

    # be "I'm trying, okay?"
    be "我在弄了，好吗？"

# game/script.rpy:7426
translate Chinese po02_01_con_3_adfc9e64:

    # be "Nothing..."
    be "什么都没有……"

# game/script.rpy:7428
translate Chinese po02_01_con_3_0ae9bcd0_215:

    # ""
    ""

# game/script.rpy:7432
translate Chinese po02_01_con_3_a6595c3a:

    # be "Got one..."
    be "有了……"

# game/script.rpy:7433
translate Chinese po02_01_con_3_83174323:

    # evyu "Yay..."
    evyu "耶……"

# game/script.rpy:7460
translate Chinese po02_01_con_3_73334e9a:

    # jjj "Good evening, I'm James J. Jamison. Tonight, we begin with breaking news."
    jjj "晚上好，我是詹姆斯·J·詹米森。今晚我们从一则突发新闻开始。"

# game/script.rpy:7461
translate Chinese po02_01_con_3_2f1a1a58:

    # jjj "Reports are coming in from across the western United States, where a series of violent attacks have been linked to the synthetic drug known as Syntrox."
    jjj "来自美国西部各地的报道显示，一系列暴力袭击事件都与一种名为「合成粉」的新型毒品有关。"

# game/script.rpy:7462
translate Chinese po02_01_con_3_f272d539:

    # jjj "Eyewitnesses describe extreme aggression, loss of control, and behavior some are calling... 'zombie-like.'"
    jjj "目击者描述称，受影响者表现出极端攻击性、失控行为，一些人将其称为……「丧尸般的」举动。"

# game/script.rpy:7467
translate Chinese po02_01_con_3_39feb9b6:

    # jjj "Authorities have yet to confirm what's causing these incidents, but emergency measures are already being enforced in multiple regions."
    jjj "当局尚未确认这些事件的具体成因，但多个地区已经开始实施紧急措施。"

# game/script.rpy:7468
translate Chinese po02_01_con_3_765bbe28:

    # jjj "We don't yet know if this is a developing disease, a dangerous mutation linked to Syntrox... or something more deliberate."
    jjj "我们目前还不清楚这是一种正在发展的疾病、与合成粉有关的危险变异……还是某种更为蓄意的行为。"

# game/script.rpy:7473
translate Chinese po02_01_con_3_ac198565:

    # jjj "To help us understand what's happening, we're joined by Dr. Steven Stark, a biochemical pathologist and advisor on emerging public health crises."
    jjj "为了帮助我们了解事件真相，今晚我们请到了史蒂文·斯塔克博士，他是一位生化病理学家，也是新兴公共卫生危机顾问。"

# game/script.rpy:7477
translate Chinese po02_01_con_3_b88cb203:

    # jjj "Doctor, based on what we're seeing, what exactly is Syntrox?"
    jjj "博士，根据我们目前看到的情况，合成粉到底是什么？"

# game/script.rpy:7482
translate Chinese po02_01_con_3_c979c2a4:

    # drste "We've known Syntrox as a street drug for nearly a year."
    drste "合成粉作为一种街头毒品，我们已经关注了将近一年。"

# game/script.rpy:7483
translate Chinese po02_01_con_3_be19f3f9:

    # drste "Users often exhibit extreme aggression, loss of coordination, and what many have described as 'zombie-like' behavior."
    drste "使用者通常会表现出极端攻击性、协调能力丧失，许多人将其描述为「丧尸般」的行为。"

# game/script.rpy:7484
translate Chinese po02_01_con_3_83464ffd:

    # drste "For months, we've been concerned that this substance could become something more than just a narcotic."
    drste "几个月来，我们一直担心这种物质可能不仅仅是一种麻醉品那么简单。"

# game/script.rpy:7487
translate Chinese po02_01_con_3_7a8db4a5:

    # jjj "You're saying this was anticipated?"
    jjj "您是说这早已在预料之中？"

# game/script.rpy:7495
translate Chinese po02_01_con_3_ca1f82d5:

    # drste "Feared... would be a better word."
    drste "「担忧」这个词也许更准确。"

# game/script.rpy:7496
translate Chinese po02_01_con_3_226c494a:

    # drste "Right now, we still don't have a definitive answer."
    drste "目前我们仍然没有确切的答案。"

# game/script.rpy:7497
translate Chinese po02_01_con_3_1c423e0d:

    # drste "Cities like Los Suenos are already dealing with multiple crises at once, labor protests, veteran unrest, and a sharp rise in violent incidents."
    drste "像洛斯苏埃诺斯这样的城市，本就同时面临多重危机——劳工抗议、退伍军人骚乱，以及暴力事件的急剧上升。"

# game/script.rpy:7498
translate Chinese po02_01_con_3_459cf547:

    # drste "When all of that happens together, systems break down."
    drste "当这些问题同时爆发时，整个系统就会崩溃。"

# game/script.rpy:7501
translate Chinese po02_01_con_3_90e02fef:

    # jjj "So how does a street drug like Syntrox escalate to this level?"
    jjj "那么，像合成粉这样的街头毒品，是如何升级到这种程度的？"

# game/script.rpy:7508
translate Chinese po02_01_con_3_ba4a5cb2:

    # drste "Syntrox didn't just appear out of nowhere."
    drste "合成粉并不是凭空出现的。"

# game/script.rpy:7509
translate Chinese po02_01_con_3_f1c4191d:

    # drste "We've encountered substances with similar effects on the battlefield, in the Middle East and more recently during the Russian-Ruskovian conflict."
    drste "我们在战场上见过类似效果的物质，在中东，以及最近的俄罗斯-鲁斯科维亚冲突中。"

# game/script.rpy:7510
translate Chinese po02_01_con_3_6bdccbad:

    # drste "The effects were devastating. Severe psychological damage, loss of motor control, uncontrollable aggression."
    drste "其影响是毁灭性的：严重的心理创伤、运动能力丧失、无法控制的攻击性。"

# game/script.rpy:7516
translate Chinese po02_01_con_3_575862f4:

    # drste "Many of the veterans protesting now have seen this before."
    drste "如今许多参与抗议的退伍军人，此前就见识过这种情况。"

# game/script.rpy:7517
translate Chinese po02_01_con_3_aca7f94f:

    # drste "They know exactly how bad it can get."
    drste "他们非常清楚事态能糟糕到什么地步。"

# game/script.rpy:7519
translate Chinese po02_01_con_3_0ae9bcd0_216:

    # ""
    ""

# game/script.rpy:7521
translate Chinese po02_01_con_3_0ae9bcd0_217:

