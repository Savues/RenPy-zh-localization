# game/script.rpy:17920
translate Chinese po02_02_sto_con_88fae2a1:

    # ev "Did you even get any sleep?"
    ev "你到底有没有睡觉啊？"

# game/script.rpy:17921
translate Chinese po02_02_sto_con_5a78f6b4:

    # wi "Yeah, I caught some rest. I woke up earlier to switch shifts with Virginia."
    wi "有啊，我睡了一会儿。早上起来跟弗吉尼亚换了岗。"

# game/script.rpy:17922
translate Chinese po02_02_sto_con_5c9cb0d5:

    # wi "Alright, stretch a little, freshen up, and get ready. We're heading out soon."
    wi "好了，伸展一下身体，收拾收拾，准备出发。我们马上要走了。"

# game/script.rpy:17923
translate Chinese po02_02_sto_con_41acb677:

    # ev "Heading out? But we've got so much food here."
    ev "要走了？可是这里还有那么多吃的呢。"

# game/script.rpy:17924
translate Chinese po02_02_sto_con_b03cbd8c:

    # wi "Yeah, but we can't stay here. It's not safe."
    wi "是啊，但我们不能待在这儿，这里不安全。"

# game/script.rpy:17926
translate Chinese po02_02_sto_con_9d8ef59b:

    # ev "Okay, I'm gonna grab something to eat real quick."
    ev "好吧，那我先随便吃点东西。"

