# game/Days/dayFive.rpy:3313
translate chinese D5_Principal_3_e59abd2a:

    # mc "Anything."
    mc "哪儿都行。"

# game/Days/dayFive.rpy:3314
translate chinese D5_Principal_3_15f4e202:

    # mc "Does this answer your question, [belle]?"
