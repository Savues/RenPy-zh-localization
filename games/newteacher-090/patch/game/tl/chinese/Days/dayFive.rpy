# game/Days/dayFive.rpy:3055
translate chinese D5_Principal_3_5e63aa9d:

    # mc "A spot inspection is an unscheduled check to make sure that the specific rule is being carried out in full."
    mc "突击检查，就是不打招呼的临时检查，为的是确认某条规则有没有被彻底执行。"

# game/Days/dayFive.rpy:3056
translate chinese D5_Principal_3_d828794d:

