# game/Days/dayFive.rpy:3316
translate chinese D5_Principal_3_a8fecc33:

    # belle "It does... Thank you."
    belle "回答了……谢谢你。"

# game/Days/dayFive.rpy:3318
translate chinese D5_Principal_3_28b4158e:

