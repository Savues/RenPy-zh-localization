# game/Days/dayFive.rpy:3072
translate chinese D5_Principal_3_d0abcddb:

    # mc "I'm not going to abuse my power and check willy-nilly to see if you're breaking this rule."
    mc "我不会滥用职权，毫无理由地到处翻查你有没有犯规。"

# game/Days/dayFive.rpy:3073
translate chinese D5_Principal_3_20cc9d54:

