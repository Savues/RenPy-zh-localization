translate chinese D5_Principal_3_86ae39f5:

    # mc "If you all get good enough results on a test, we can go for a trip somewhere."
    mc "只要这次考试大家都考到足够好的分数，我们就出去玩一趟。"

# game/Days/dayFive.rpy:3308
translate chinese D5_Principal_3_25b2078e:

    # mc "The student with the highest mark, can decide where we go."
    mc "分数最高的那位，可以决定我们上哪儿去。"

# game/Days/dayFive.rpy:3309
translate chinese D5_Principal_3_635d4be8:

    # mc "It could be anywhere..."
    mc "哪儿都行……"

# game/Days/dayFive.rpy:3311
translate chinese D5_Principal_3_1755a775:

