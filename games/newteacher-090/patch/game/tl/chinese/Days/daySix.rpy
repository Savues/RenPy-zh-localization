    # ella "{i}And..{/i}?"
    ella "{i}那又……{/i}？"

# game/Days/daySix.rpy:5848
translate chinese D6_Georgia_e3c3144d:

    # iris "Ahh.. He.."
    iris "啊……他……"

# game/Days/daySix.rpy:5850
translate chinese D6_Georgia_5a2b008c:

    # iris "H-he's very out of line, m'lady."
    iris "他、他太过分了，夫人。"

# game/Days/daySix.rpy:5852
translate chinese D6_Georgia_d6a2c23f:

    # iris "Bad. Very bad. H-he deserves to be replaced..!"
    iris "坏。非常坏。他、他该被撤换……！"

# game/Days/daySix.rpy:5854
translate chinese D6_Georgia_d957ff19:

    # ella "[clarissa]..?"
    ella "[clarissa]……？"

# game/Days/daySix.rpy:5856
translate chinese D6_Georgia_930ab5e3:

    # "[clarissa] is still dazed from what you said, and words fail to escape her lips."
    "[clarissa]还因为你刚才的话发着愣，嘴唇动了动，什么也没说出来。"

# game/Days/daySix.rpy:5858
translate chinese D6_Georgia_dc69763b:

    # ella "...{size=-10}{i}pathetic.{/i}{/size}"
    ella "……{size=-10}{i}可悲。{/i}{/size}"

# game/Days/daySix.rpy:5866
translate chinese D6_Georgia_d8109ec5:

    # "Interestingly, [ella] gives you a slow, methodical clap."
    "有意思的是，[ella]不紧不慢地为你鼓起了掌。"

# game/Days/daySix.rpy:5874
