    # iris "Ahh... Yes... M-ma'am?"
    iris "啊……是……夫、夫人？"

# game/Days/daySix.rpy:5842
translate chinese D6_Georgia_fba7bef8:

    # ella "Did you hear what he just said?"
    ella "你听到他刚才说什么了吗？"

# game/Days/daySix.rpy:5844
translate chinese D6_Georgia_2d029583:

    # iris "Y-yes, M-'am."
    iris "是、是的，夫、夫人。"

# game/Days/daySix.rpy:5846
