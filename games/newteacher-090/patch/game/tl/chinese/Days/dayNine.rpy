# game/Days/dayNine.rpy:8
translate chinese dayNineStart_b5ee063f:

    # nurse "Of course we will! It'll be a good learning exercise for you!"
    nurse "那当然！这对你来说可是一次难得的学习机会！"

# game/Days/dayNine.rpy:10
translate chinese dayNineStart_3a432979:

    # mcT "...What have I gotten myself into..."
    mcT "……我这是把自己搞进了什么麻烦里……"

# game/Days/dayNine.rpy:13
translate chinese dayNineStart_c6203aea:

    # nurse "Don't just stand there! Get a move on! We have a patient in dire need of assistance!"
    nurse "别光站着！快动起来！有个病人急需救治！"

# game/Days/dayNine.rpy:15
translate chinese dayNineStart_5e44a000:

    # mc "Right..."
    mc "好吧……"

# game/Days/dayNine.rpy:18
translate chinese dayNineStart_e4a92845:

    # "[sadie] brings [yui] over to one of the beds as instructed by [nurse], and plonks her down."
    "[sadie]照[nurse]的吩咐把[yui]领到一张病床边，往床上一撂。"

# game/Days/dayNine.rpy:19
translate chinese dayNineStart_38073594:

    # yui "Ouchie..."
    yui "哎哟……"

# game/Days/dayNine.rpy:21
translate chinese dayNineStart_750ad622:

    # "As you peer around the curtain, the sharp, chemical tang of chlorine hits you."
    "你探头绕过帘子，一股刺鼻的氯水气味扑面而来。"

# game/Days/dayNine.rpy:22
translate chinese dayNineStart_7472329a:

    # "Both girls are still damp from the pool, their skin glistening with moisture, swimsuits clinging to their bodies."
    "两个女孩刚从泳池上来，身上的水还没干，皮肤泛着水光，泳衣湿漉漉地贴在身上。"

# game/Days/dayNine.rpy:23
translate chinese dayNineStart_05800f19:

    # "Small puddles form on the floor beneath them as water drips from their hair."
    "水珠顺着发梢往下滴，在她们脚边汇成小小一滩。"

# game/Days/dayNine.rpy:24
translate chinese dayNineStart_3bc225ea:

    # sadie "You hurt your foot, [yui]. Not your ass."
    sadie "你伤到的是脚，[yui]。不是屁股。"

# game/Days/dayNine.rpy:26
translate chinese dayNineStart_2bb3b8bf:

    # yui "What if I have? You don't know!"
    yui "就算是屁股又怎样？你又不知道！"

# game/Days/dayNine.rpy:28
translate chinese dayNineStart_92f0fea2:

    # sadie "You have a terrible habit of never shutting up, babes. If you hurt your ass, everyone would know about it."
    sadie "宝贝，你这张嘴就没停过。真要是伤在屁股上，大家一眼就看见了。"

# game/Days/dayNine.rpy:29
translate chinese dayNineStart_bdab4a8b:

    # yui "..."
    yui "……"

# game/Days/dayNine.rpy:33
translate chinese dayNineStart_f7680232:

    # sadie "Speaking of which..."
    sadie "说到这个……"

# game/Days/dayNine.rpy:35
translate chinese dayNineStart_ab4ac035:

    # sadie "{i}{size=-10}...Whispering...{/size}{/i} {size=-14}Don't mention anything about that {i}thing{/i}, okay?{/size}"
    sadie "{i}{size=-10}……小声说……{/size}{/i} {size=-14}别提那{i}件事{/i}，好吗？{/size}"

# game/Days/dayNine.rpy:36
translate chinese dayNineStart_0f856f97:

    # sadie "{i}{size=-10}...Whispering...{/size}{/i} {size=-14}It's our secret! Keep those lips sealed!{/size}"
    sadie "{i}{size=-10}……小声说……{/size}{/i} {size=-14}这是我们俩的秘密！把嘴给我管严实了！{/size}"

# game/Days/dayNine.rpy:38
translate chinese dayNineStart_cea86b5e:

    # yui "{i}{size=-10}...Whispering...{/size}{/i} {size=-14}Wow, you think so little of me?{/size}"
    yui "{i}{size=-10}……小声说……{/size}{/i} {size=-14}哇，你就这么不信任我？{/size}"

# game/Days/dayNine.rpy:40
translate chinese dayNineStart_a2f950d4:

    # sadie "{i}{size=-10}...Whispering...{/size}{/i} {size=-14}No, I just know how you are. We've been friends for too long.{/size}"
    sadie "{i}{size=-10}……小声说……{/size}{/i} {size=-14}不，我只是了解你的为人。我们做朋友太久了。{/size}"

# game/Days/dayNine.rpy:41
translate chinese dayNineStart_ba914226:

    # sadie "Just sit there and let the Nurse fix you up-"
    sadie "坐那儿别动，让护士给你处理——"

# game/Days/dayNine.rpy:43
translate chinese dayNineStart_e46796cf:

    # sadie "-And I guess, [school_player_name] too..."
    sadie "——还有我想，[school_player_name]大概也得……"

# game/Days/dayNine.rpy:45
translate chinese dayNineStart_ee384f58:

    # sadie "Oh, that reminds me. [school_player_name], can I speak with you?"
    sadie "哦，这倒提醒我了。[school_player_name]，我能和你谈谈吗？"

# game/Days/dayNine.rpy:47
translate chinese dayNineStart_57aa96a8:

    # mc "Hmm? Sure, I don't mind."
    mc "嗯？好啊，反正我也没事。"

# game/Days/dayNine.rpy:49
translate chinese dayNineStart_2b4857a1:

    # mc "[nurse]... No funny business. I'll be back in a second for this er... 'help' you need from me."
    mc "[nurse]……别耍花样。我一会儿就回来，帮你搞定你需要的那个……呃……「帮助」。"

# game/Days/dayNine.rpy:51
translate chinese dayNineStart_c668e25c:

    # nurse "Funny business? Behave spud-pudding, you've got nothing to worry about."
    nurse "耍花样？乖一点，小土豆布丁，没什么好担心的。"

# game/Days/dayNine.rpy:53
translate chinese dayNineStart_cd951070:

    # mc "I hope you prove me wrong. I'll be back in a moment."
    mc "希望你是对的。我马上就回来。"

# game/Days/dayNine.rpy:57
translate chinese dayNineStart_191559e1:

    # mc "What's up?"
    mc "怎么了？"

# game/Days/dayNine.rpy:59
translate chinese dayNineStart_88f6ba0a:

    # sadie "Have you found anything out?"
    sadie "你查出什么了吗？"

# game/Days/dayNine.rpy:61
translate chinese dayNineStart_60802f4e:

    # mc "With your dad? I thought I told you, you shouldn't be getting involved?"
    mc "你爸的事？我不是跟你说过了吗，你不该掺和进来？"

# game/Days/dayNine.rpy:63
translate chinese dayNineStart_acb1c698:

    # sadie "Since when was asking questions getting involved?"
    sadie "从什么时候开始，问问题也算掺和了？"

# game/Days/dayNine.rpy:65
translate chinese dayNineStart_b79e62d6:

    # sadie "Don't you think I deserve to know details?"
    sadie "难道我不该知道详情吗？"

# game/Days/dayNine.rpy:66
translate chinese dayNineStart_f217f981:

    # sadie "You know... It is about my family after all..."
    sadie "你也知道……这毕竟是关于我家的事……"

# game/Days/dayNine.rpy:74
translate chinese dayNineStart_ca1d2a5b:

    # mcT "She's not wrong, but I {i}really{/i} don't want her getting involved..."
    mcT "她没说错，但我{i}真的{/i}不想让她掺和进来……"

# game/Days/dayNine.rpy:75
translate chinese dayNineStart_f6b19cff:

    # mcT "If 'scary looking people' keep waltzing into her house, it's got to be serious."
    mcT "要是那些「看着就吓人」的家伙一个接一个往她家里钻，那这事肯定不简单。"

# game/Days/dayNine.rpy:76
translate chinese dayNineStart_fb0a6598:

    # mcT "She could get hurt. I don't want that."
    mcT "她可能会被牵连受伤。我不想看到那种事。"

# game/Days/dayNine.rpy:77
translate chinese dayNineStart_a6cce1bd:

    # mcT "This is probably much bigger than her dad, and me..."
    mcT "这件事的水，可能比我、也比我爸以为的深得多……"

# game/Days/dayNine.rpy:78
translate chinese dayNineStart_d4a1e067:

    # mcT "I'm just a regular guy. I'm not even sure {b}I{/b} want to get involved..."
    mcT "我只是个普通人。我甚至不确定{b}我{/b}想不想掺和进来……"

# game/Days/dayNine.rpy:79
translate chinese dayNineStart_deee8838:

    # mcT "So why the hell am I the one stuck in the middle of this mess?"
    mcT "那他妈的凭什么我偏偏卡在这团乱麻正中间？"

# game/Days/dayNine.rpy:80
translate chinese dayNineStart_24d5ab0b:

    # mcT "And honestly... I haven't even found anything solid yet. If anything, I've got more questions now than when I started."
    mcT "而且说真的……我到现在也没查出任何实据。要说有变化，也就是我手上的疑问比刚开头时更多了。"

# game/Days/dayNine.rpy:81
translate chinese dayNineStart_56c3b307:

    # mc "[sadie]..."
    mc "[sadie]……"

# game/Days/dayNine.rpy:82
translate chinese dayNineStart_55b7bd54:

    # mc "Unfortunately, I haven't really found out anything yet."
    mc "很遗憾，我确实还什么都没查出来。"

# game/Days/dayNine.rpy:84
translate chinese dayNineStart_72ed7df8:

    # sadie "Really? You're not just saying that to keep me out of it, are you?"
    sadie "真的？你不是只想把我挡在外头才这么说的吧？"

# game/Days/dayNine.rpy:86
translate chinese dayNineStart_da864656:

    # mc "No, I'm not lying. I genuinely don't know much more than before."
    mc "不，我没骗你。真的没比刚才多知道多少。"

# game/Days/dayNine.rpy:88
translate chinese dayNineStart_4076debc:

    # sadie "Those guys that keep coming to the house..."
    sadie "那些老是来我家的人……"

# game/Days/dayNine.rpy:90
translate chinese dayNineStart_e1717950:

    # sadie "They don't just look scary. The way they look at me... it's like I-I'm-"
    sadie "他们不只是长得吓人。他们看我的眼神……就好像我——我是——"

# game/Days/dayNine.rpy:92
translate chinese dayNineStart_1f7d9e9d:

    # sadie "It makes me feel uneasy. Like I'm not even safe in my own home."
    sadie "这让我很不安。好像连在自己家里都不安全了。"

# game/Days/dayNine.rpy:93
translate chinese dayNineStart_711dbdea:

    # sadie "If something's going on with Dad, I need to know. I can't just sit here waiting for whatever comes next."
    sadie "要是爸爸真出了什么事，我必须知道。我不能就这么干坐着，等着不知什么东西落到自己头上。"

# game/Days/dayNine.rpy:95
translate chinese dayNineStart_67622432:

    # sadie "I think one of them stole s-something too..."
    sadie "我觉得他们其中一个人还偷了什么东西……"

# game/Days/dayNine.rpy:103
translate chinese dayNineStart_69847283:

    # mc "That-"
    mc "那——"

# game/Days/dayNine.rpy:104
translate chinese dayNineStart_1c85308d:

    # mcT "-Probably not a good time to mention I'm the thief, ha... ha..."
    mcT "——现在大概不是提「我就是那个小偷」的好时机，哈……哈……"

# game/Days/dayNine.rpy:105
translate chinese dayNineStart_83014aa9:

    # mcT "I'll call her to my office or something later and explain..."
    mcT "改天我把她叫到办公室什么的，再慢慢跟她解释……"

# game/Days/dayNine.rpy:107
translate chinese dayNineStart_fa6eff17:

    # mcT "This sucks..."
    mcT "真他妈麻烦……"

# game/Days/dayNine.rpy:108
translate chinese dayNineStart_e0b8d451:

    # mcT "If I tell her everything I find out later... would I be keeping her informed, or just pulling her deeper into danger?"
    mcT "如果把我之后查到的一切都告诉她……我算是在让她知情，还是在把她拖得更深？"

# game/Days/dayNine.rpy:120
translate chinese dayNineStart_9e00fe28:

    # mcT "And if I keep her in the dark... am I protecting her, or leaving her completely blind to whatever might come for her anyway?"
    mcT "可要是我瞒着她……我算是在保护她，还是让她对可能砸到她身上的东西一无所知？"

# game/Days/dayNine.rpy:121
translate chinese dayNineStart_d3967cef:

    # mcT "I don't even know how dangerous this is yet."
    mcT "我甚至还不清楚这有多危险。"

# game/Days/dayNine.rpy:123
translate chinese dayNineStart_0dd14afb:

    # mcT "Either way, I could be the one putting her at risk."
    mcT "不管怎么选，把她推入危险的那个人，都可能是我。"

# game/Days/dayNine.rpy:130
translate chinese dayNineStart_2da46f17:

    # mcT "No... I can't tell her. Not yet."
    mcT "不……我不能告诉她。还不行。"

# game/Days/dayNine.rpy:131
translate chinese dayNineStart_6aa0bd1c:

    # mcT "My gut's screaming that knowing too much would only put a bigger target on her back."
    mcT "直觉在尖叫：她知道得越多，身上的靶子就越大。"

# game/Days/dayNine.rpy:132
translate chinese dayNineStart_2d44c3e1:

    # mc "Look, I'm not giving up. I'll keep digging for answers."
    mc "听着，我不会放弃。我会继续往下挖。"

# game/Days/dayNine.rpy:133
translate chinese dayNineStart_cdc2145b:

    # mc "But I'm not going to tell you everything I find. It might be too dangerous for you."
    mc "但我不会把我找到的一切都告诉你。对你来说可能太危险了。"

# game/Days/dayNine.rpy:135
translate chinese dayNineStart_31a139c0:

    # sadie "When is everyone going to stop treating me like a helpless kid?"
    sadie "大家到底要到什么时候才肯不把我当成一个什么都不会的小丫头？"

# game/Days/dayNine.rpy:136
translate chinese dayNineStart_ea4a9504:

    # sadie "I'm not made of glass. I'm not going to shatter with a little bit of pressure."
    sadie "我又不是玻璃做的。稍微施点压，还不至于碎。"

# game/Days/dayNine.rpy:137
translate chinese dayNineStart_f976e5f0:

    # sadie "I deserve to know what's happening with my own family!"
    sadie "我有权知道自己家里发生了什么！"

# game/Days/dayNine.rpy:139
translate chinese dayNineStart_6b040fd5:

    # mc "I get that. I do."
    mc "我明白。我真的明白。"

# game/Days/dayNine.rpy:140
translate chinese dayNineStart_42601521:

    # mc "But if something happened to you because I opened my mouth... I couldn't live with that."
    mc "但万一因为我多嘴，让你出了什么事……我没法原谅自己。"

# game/Days/dayNine.rpy:142
translate chinese dayNineStart_e7c87e63:

    # sadie "So you'd rather I stay scared and clueless?"
    sadie "所以你宁愿我一无所知、担惊受怕？"

# game/Days/dayNine.rpy:144
translate chinese dayNineStart_12b6bdd4:

    # mc "I'd rather you stay safe."
    mc "我宁愿你平平安安的。"

# game/Days/dayNine.rpy:146
translate chinese dayNineStart_4c1ff504:

    # sadie "That's not fair."
    sadie "这不公平。"

# game/Days/dayNine.rpy:148
translate chinese dayNineStart_ca3d8fda:

    # mc "I know, but it's the way it has to be."
    mc "我知道，但只能这样。"

# game/Days/dayNine.rpy:150
translate chinese dayNineStart_9ed6602d:

    # sadie "Just... don't shut me out completely, okay?"
    sadie "不过……别把我彻底挡在外面，好吗？"

# game/Days/dayNine.rpy:152
translate chinese dayNineStart_8260fac5:

    # mc "I won't. I'll tell you what I can that won't endanger you. I promise."
    mc "不会。我会把能说、又不会连累你的那些都告诉你。我保证。"

# game/Days/dayNine.rpy:154
translate chinese dayNineStart_205c7890:

    # sadie "...Fine. For now."
    sadie "……好吧。暂时这样。"

# game/Days/dayNine.rpy:156
translate chinese dayNineStart_c85807a9:

    # mcT "She sounds hurt, but at least she's backing off."
    mcT "听着像是被伤到了，不过至少她肯退一步。"

# game/Days/dayNine.rpy:157
translate chinese dayNineStart_e71663f2:

    # mcT "I hate lying to her like this... but I have to believe I'm doing the right thing."
    mcT "我讨厌这样对她撒谎……但我必须相信我做的是对的。"

# game/Days/dayNine.rpy:162
translate chinese dayNineStart_fd7585a4:

    # mc "Alright, alright. Here's the deal."
    mc "好吧好吧。说定了。"

# game/Days/dayNine.rpy:163
translate chinese dayNineStart_54661b4e:

    # mc "When I find something out, I'll fill you in on the details."
    mc "等我查到什么，就把细节一五一十告诉你。"

# game/Days/dayNine.rpy:165
translate chinese dayNineStart_9875047b:

    # sadie "You will?"
    sadie "你会吗？"

# game/Days/dayNine.rpy:167
translate chinese dayNineStart_2226bcf8:

    # mc "{i}{b}But{/b}{/i}, you still have to stay out of it."
    mc "{i}{b}但是{/b}{/i}，你还是得置身事外。"

# game/Days/dayNine.rpy:168
translate chinese dayNineStart_1b199792:

    # mc "Okay?"
    mc "好吗？"

# game/Days/dayNine.rpy:170
translate chinese dayNineStart_aff1fcb2:

    # sadie "I'm not a little girl, you know. I can look after myself!"
    sadie "我早就不是小孩子了，你知道的。我能照顾好自己！"

# game/Days/dayNine.rpy:172
translate chinese dayNineStart_d82e43e7:

    # mc "Irrelevant."
    mc "无关紧要。"

# game/Days/dayNine.rpy:173
translate chinese dayNineStart_609bb345:

    # mc "The only reason I'm telling you anything is so you can protect yourself."
    mc "我之所以告诉你，唯一的原因就是让你能保护好自己。"

# game/Days/dayNine.rpy:174
translate chinese dayNineStart_f9a4a89e:

    # mc "Which is pointless if you go looking for the exact trouble I warn you about."
    mc "你非要自己跑去招惹那些我警告过你的麻烦，那我告诉你这些就全都没意义了。"

# game/Days/dayNine.rpy:176
translate chinese dayNineStart_9a05cbd8:

    # sadie "Can't call it a favour if you're the one who brought it up in the first place."
    sadie "要不是你先提起来的，这还谈得上是我帮你？"

# game/Days/dayNine.rpy:178
translate chinese dayNineStart_f7d98978:

    # mc "True. {i}However{/i}, I never claimed to be a smart man."
    mc "也对。{i}不过{/i}，我可从没说过自己是个聪明人。"

# game/Days/dayNine.rpy:180
translate chinese dayNineStart_0613c7e1:

    # sadie "You wear that fact proudly, sir. Haha."
    sadie "你还挺以这个为荣嘛，先生。哈哈。"

# game/Days/dayNine.rpy:181
translate chinese dayNineStart_0a8f2b67:

    # sadie "But thank you. I guess I can agree to that."
    sadie "不过还是谢谢你。这条我答应。"

# game/Days/dayNine.rpy:183
translate chinese dayNineStart_1b0ef467:

    # mcT "I hope I'm not making a mistake..."
    mcT "希望我没做错……"

# game/Days/dayNine.rpy:186
translate chinese dayNineStart_c4e6cb57:

    # yui "I wonder what they're talking about..?"
    yui "不知道他们在讲什么呢……？"

# game/Days/dayNine.rpy:188
translate chinese dayNineStart_d5e3cf89:

    # nurse "Mmm...breeding, I hope."
    nurse "嗯……希望是在聊配种。"

# game/Days/dayNine.rpy:190
translate chinese dayNineStart_06df2b2a:

    # yui "Er..."
    yui "呃……"

# game/Days/dayNine.rpy:191
translate chinese dayNineStart_684f28ca:

    # yui "You're a little strange, 'you know that?"
    yui "你有点怪怪的，你知道吗？"

# game/Days/dayNine.rpy:193
translate chinese dayNineStart_ae442011:

    # nurse "Hmm? Sometimes sweet-cheeks. Sometimes."
    nurse "嗯？有时候吧，甜心。有时候。"

# game/Days/dayNine.rpy:195
translate chinese dayNineStart_fceac081:

    # nurse "Anyway, where were we?"
    nurse "总之，我们说到哪了？"

# game/Days/dayNine.rpy:200
translate chinese dayNineStart_a8efe6ac:

    # mc "With what you've said, I don't think you should be staying at home in the meantime."
    mc "照你这么说，我觉得你暂时还是别一个人待在家里的好。"

# game/Days/dayNine.rpy:202
translate chinese dayNineStart_3cd83581:

    # sadie "{bt=2}Yeaaah...{/bt} I've been crashing at [yui]'s family estate for a bit."
    sadie "{bt=2}对啊……{/bt}我这段时间都借住在[yui]家的庄园里。"

# game/Days/dayNine.rpy:203
translate chinese dayNineStart_2cdf107c:

    # sadie "They have more than enough room."
    sadie "他们那儿地方大得很。"

# game/Days/dayNine.rpy:205
translate chinese dayNineStart_ee87e6f3:

    # mc "Oh?"
    mc "哦？"

# game/Days/dayNine.rpy:207
translate chinese dayNineStart_fd685410:

    # sadie "Basically since my dad {i}apparently{/i} asked you to keep an eye on me."
    sadie "说到底，是因为我爸{i}大概{/i}拜托你照看着我。"

# game/Days/dayNine.rpy:208
translate chinese dayNineStart_c26f7e9a:

    # sadie "Like I'm some damsel who can't handle herself."
    sadie "搞得好像我是个离了人就不能照顾自己的娇小姐似的。"

# game/Days/dayNine.rpy:210
translate chinese dayNineStart_d830bb9d:

    # mc "Hey, he's your dad, he was worried. And after everything you told me... I don't blame him."
    mc "嘿，他是你爸，担心你也正常。而且听你说了这么多……我也不怪他。"

# game/Days/dayNine.rpy:212
translate chinese dayNineStart_9a1f01e1:

    # sadie "Still. I can't believe I ran into the living room stark naked..."
    sadie "话虽如此……我居然就那么一丝不挂地冲进了客厅……"

# game/Days/dayNine.rpy:214
translate chinese dayNineStart_11847b20:

    # mc "Sorry about that. I honestly didn't think you'd just run in like that."
    mc "抱歉啊。我真没想到你会那样直接冲进来。"

# game/Days/dayNine.rpy:217
translate chinese dayNineStart_ddf12976:

    # sadie "It's my house! I didn't think the sitter was coming for at least another hour!"
    sadie "这可是我家！我还以为保姆至少一小时后才来！"

# game/Days/dayNine.rpy:220
translate chinese dayNineStart_10ef61e7:

    # sadie "Less so that it'd be you!!"
    sadie "更没想到来的会是你！！"

# game/Days/dayNine.rpy:224
translate chinese dayNineStart_02031670:

    # mc "Haha, it was a surprise for me too."
    mc "哈哈，对我来说也够突然的。"

# game/Days/dayNine.rpy:225
translate chinese dayNineStart_51e86c20:

    # mc "So... you're not at home alone with your dad anymore? That's actually a relief."
    mc "所以……你现在不和你爸单独待在家了？那我倒是松了口气。"

# game/Days/dayNine.rpy:226
translate chinese dayNineStart_dfa6a1c2:

    # mc "'Means he's probably by himself most of the time now?"
    mc "也就是说，他现在大部分时间都是一个人？"

# game/Days/dayNine.rpy:229
translate chinese dayNineStart_4d0b8acb:

    # sadie "Yeah, he should be. House is empty when I'm not there now."
    sadie "嗯，应该是。我不在的时候，家里就是空的。"

# game/Days/dayNine.rpy:231
translate chinese dayNineStart_c0b272d0:

    # mc "Gotcha. I'll make a trip over some time soon."
    mc "收到。改天我抽空过去一趟。"

# game/Days/dayNine.rpy:232
translate chinese dayNineStart_627c3f33:

    # mc "We should have another pizza night sometime soon as well."
    mc "最近也该再约一次披萨之夜了。"

# game/Days/dayNine.rpy:234
translate chinese dayNineStart_c496d3b5:

    # sadie "So you can tell me what you find out, right?"
    sadie "这样你就可以告诉我你发现了什么，对吧？"

# game/Days/dayNine.rpy:237
translate chinese dayNineStart_161521ec:

    # mc "Forgetful, are we?"
    mc "忘性大，是吧？"

# game/Days/dayNine.rpy:239
translate chinese dayNineStart_952f8031:

    # sadie "It was worth a try."
    sadie "值得一试。"

# game/Days/dayNine.rpy:240
translate chinese dayNineStart_3361ffb3:

    # sadie "In any case; {w}pizza night sounds good!"
    sadie "总之，{w}披萨之夜听着就不错！"

# game/Days/dayNine.rpy:242
translate chinese dayNineStart_edf2b575:

    # sadie "This time I'm picking the pizza though."
    sadie "不过这次我来选披萨。"

# game/Days/dayNine.rpy:244
translate chinese dayNineStart_e57e78ab:

    # sadie "I can't believe you suggested pineapple last time."
    sadie "真不敢相信你上次居然还提议加菠萝。"

# game/Days/dayNine.rpy:246
translate chinese dayNineStart_dd3b41c5:

    # sadie "Disgusting."
    sadie "恶心。"

# game/Days/dayNine.rpy:247
translate chinese dayNineStart_498e58ce:

    # mc "Yeah, that's my bad. I don't know what I was thinking..."
    mc "是啊，是我的错。我也不知道自己当时脑子在想什么……"

# game/Days/dayNine.rpy:250
translate chinese dayNineStart_386170ce:

    # sadie "Luckily you got my favorite pizza on the first try!"
    sadie "还好你第一次就点中了我最喜欢的口味！"

# game/Days/dayNine.rpy:251
translate chinese dayNineStart_0838d702:

    # sadie "A nice chillax night. It's been a while since I've had a normal night that didn't involve worrying about... everything."
    sadie "多惬意的一晚。我已经很久没有过一个不用为……任何事提心吊胆的平常夜晚了。"

# game/Days/dayNine.rpy:254
translate chinese dayNineStart_e5ba6005:

    # mc "That, and it's just nice to get to know each other better, you know?"
    mc "而且，能多了解彼此一点也不错，你说呢？"

# game/Days/dayNine.rpy:256
translate chinese dayNineStart_4094fe86:

    # sadie "Yeah... it would be nice. Been a while since I've had a normal night that didn't involve worrying about... everything."
    sadie "是啊……那挺好的。我已经很久没有过一个不用为……任何事提心吊胆的平常夜晚了。"

# game/Days/dayNine.rpy:258
translate chinese dayNineStart_ef7921a9:

    # mc "T-that's not good..."
    mc "那、那可不好……"

# game/Days/dayNine.rpy:260
translate chinese dayNineStart_41ba34c4:

    # sadie "Hey, um..."
    sadie "嘿，呃……"

# game/Days/dayNine.rpy:262
translate chinese dayNineStart_eaf3992e:

    # sadie "Can... Can I give you my number? You know, in case something comes up. Or... whatever."
    sadie "我……我能把号码给你吗？就是……万一有什么事的话。或者……算了。"

# game/Days/dayNine.rpy:264
translate chinese dayNineStart_3daed6fd:

    # mc "Yeah, good call. I was actually gonna ask."
    mc "好啊，想得周到。我正想问你呢。"

# game/Days/dayNine.rpy:266
translate chinese dayNineStart_67de4c35:

    # sadie "Can... Can I give you my number? Just in case?"
    sadie "可……可以把我号码给你吗？以防万一？"

# game/Days/dayNine.rpy:268
translate chinese dayNineStart_66de3c43:

    # mc "Oh? Sure. I was gonna ask you the same thing."
    mc "哦？当然。我本来也要问同样的事。"

# game/Days/dayNine.rpy:270
translate chinese dayNineStart_177409ce:

    # sadie "Sure you were..."
    sadie "你当然「会」……"

# game/Days/dayNine.rpy:272
translate chinese dayNineStart_8de0b690:

    # "[sadie] smiles a little, the first real one since the conversation started."
    "[sadie]露出了一点笑意——这是这番谈话开始以来第一个真心的笑。"

# game/Days/dayNine.rpy:277
translate chinese dayNineStart_7e2efafc:

    # mc "There ya go, you've got my number now."
    mc "好了，号码给你了。"

# game/Days/dayNine.rpy:279
translate chinese dayNineStart_e8f94579:

    # sadie "T-thank you..."
    sadie "谢、谢谢你……"

# game/Days/dayNine.rpy:281
translate chinese dayNineStart_1a802d14:

    # mc "In any case, thank you for bringing [yui] up here. You should probably get back to class."
    mc "总之，谢谢你带[yui]上来。你该回去上课了。"

# game/Days/dayNine.rpy:283
translate chinese dayNineStart_2a98197d:

    # sadie "{bt=2}Yeaahhh...{/bt} She can be a handful at times. But what can you do?"
    sadie "{bt=2}是啊……{/bt}她有时候是挺难搞的。但又能怎么办呢？"

# game/Days/dayNine.rpy:285
translate chinese dayNineStart_83b8f3ce:

    # sadie "..."
    sadie "……"

# game/Days/dayNine.rpy:287
translate chinese dayNineStart_29702dce:

    # "She lingers for a second, shifting her weight and fidgeting instead of immediately leaving."
    "她磨蹭了一会儿，重心挪来挪去，没有立刻离开。"

# game/Days/dayNine.rpy:288
translate chinese dayNineStart_c0fec97b:

    # mc "...Something else?"
    mc "……还有别的？"

# game/Days/dayNine.rpy:289
translate chinese dayNineStart_83b8f3ce_1:

    # sadie "..."
    sadie "……"

# game/Days/dayNine.rpy:291
translate chinese dayNineStart_9f6ff3ee:

    # sadie "Just..."
    sadie "就……"

# game/Days/dayNine.rpy:293
translate chinese dayNineStart_be6fb7fa:

    # sadie "Be careful, okay?"
    sadie "小心点，好吗？"

# game/Days/dayNine.rpy:298
translate chinese dayNineStart_3f0c9516:

    # mc "Hey, I'm not the one with the creepy guys showing up at my house."
    mc "嘿，那些怪人跑到我家去的又不是我。"

# game/Days/dayNine.rpy:300
translate chinese dayNineStart_52dc5b1b:

    # sadie "I'm serious."
    sadie "我是认真的。"

# game/Days/dayNine.rpy:301
translate chinese dayNineStart_621a00a5:

    # sadie "You keep saying you're 'just a regular guy' but..."
    sadie "你总说自己「不过是个普通人」，可是……"

# game/Days/dayNine.rpy:302
translate chinese dayNineStart_163e8fe5:

    # sadie "You're still the one walking into whatever this is."
    sadie "可自己踏进这滩浑水的人，是你。"

# game/Days/dayNine.rpy:304
translate chinese dayNineStart_8efdd4f3:

    # sadie "For me!"
    sadie "为了我！"

# game/Days/dayNine.rpy:310
translate chinese dayNineStart_2b35b6fe:

    # mc "..."
    mc "……"

# game/Days/dayNine.rpy:312
translate chinese dayNineStart_f4305d98:

    # sadie "So just-"
    sadie "所以就——"

# game/Days/dayNine.rpy:313
translate chinese dayNineStart_dd5cb8de:

    # sadie "Don't do anything stupid without telling me first."
    sadie "做什么蠢事先告诉我一声。"

# game/Days/dayNine.rpy:315
translate chinese dayNineStart_2d6bb977:

    # mcT "That'll be a hard ask... I'm known to...be stupid."
    mcT "这可有点难为我了……我这人……一向挺蠢的。"

# game/Days/dayNine.rpy:317
translate chinese dayNineStart_a58bd525:

    # mc "Wasn't planning on it. You'll be the first to know, remember?"
    mc "没打算。我说过你会第一个知道，忘了？"

# game/Days/dayNine.rpy:320
translate chinese dayNineStart_b498ded7:

    # sadie "Good."
    sadie "很好。"

# game/Days/dayNine.rpy:322
translate chinese dayNineStart_ab3e32b3:

    # mc "I'll... try to keep that in mind."
    mc "我会……尽量记住的。"

# game/Days/dayNine.rpy:325
translate chinese dayNineStart_af09863d:

    # sadie "Try harder."
    sadie "再努力点。"

# game/Days/dayNine.rpy:326
translate chinese dayNineStart_02161954:

    # "She softens a little, exhaling through her nose."
    "她的神色柔和了些，从鼻子里轻轻呼出一口气。"

# game/Days/dayNine.rpy:328
translate chinese dayNineStart_1c446574:

    # sadie "And don't cancel on pizza night."
    sadie "还有，别取消披萨之夜。"

# game/Days/dayNine.rpy:329
translate chinese dayNineStart_84f4b189:

    # sadie "I need something normal to look forward to right now."
    sadie "我现在需要一件正常的事可以期待。"

# game/Days/dayNine.rpy:331
translate chinese dayNineStart_05418da0:

    # mc "You have my word. I would never cancel a pizza night!"
    mc "我保证。我绝对不会取消披萨之夜！"

# game/Days/dayNine.rpy:333
translate chinese dayNineStart_40de1f5c:

    # sadie "Okay. Good."
    sadie "好的。很好。"

# game/Days/dayNine.rpy:341
translate chinese dayNineStart_9a99bc00:

    # "She turns to leave, then pauses at the door.{p=1.5}{nw}"
    "她转身要走，却在门口停住了。{p=1.5}{nw}"

# game/Days/dayNine.rpy:342
translate chinese dayNineStart_1d26f83f:

    # sadie "Oh-and [player_name]?"
    sadie "哦对了，[player_name]？"

# game/Days/dayNine.rpy:344
translate chinese dayNineStart_f49fff8f:

    # mc "Yeah?"
    mc "嗯？"

# game/Days/dayNine.rpy:346
translate chinese dayNineStart_3d3a49ed:

    # sadie "Thanks... for not brushing me off."
    sadie "谢谢你……没有敷衍我。"

# game/Days/dayNine.rpy:348
translate chinese dayNineStart_bc666b09:

    # mc "Anytime."
    mc "随时。"

# game/Days/dayNine.rpy:349
translate chinese dayNineStart_26ec79ba:

    # "That small smile returns to her face again. Softer than the previous ones, but more genuine."
    "那抹浅笑又回到了她脸上。比之前更柔和，也更真实。"

# game/Days/dayNine.rpy:351
translate chinese dayNineStart_45c6c92e:

    # sadie "Bye."
    sadie "拜。"

# game/Days/dayNine.rpy:354
translate chinese dayNineStart_f8d91e98:

    # mc "...Later."
    mc "……回头见。"

# game/Days/dayNine.rpy:357
translate chinese dayNineStart_235a8485:

    # mcT "Shit! I forgot to ask her if she's seen that photo!"
    mcT "糟了！我忘了问她看没看过那张照片了！"

# game/Days/dayNine.rpy:361
translate chinese dayNineStart_c96d979f:

    # nurse "[player_name]!! Are you done yet!? We should get started!!"
    nurse "[player_name]！！你那边好了吗！？我们该开始了！！"

# game/Days/dayNine.rpy:367
translate chinese dayNineStart_f360182f:

    # mc "Aye-aye captain."
    mc "遵命，队长。"

# game/Days/dayNine.rpy:374
translate chinese D9_Yui_53d93f9b:

    # mc "Sooo.... What am I looking at?"
    mc "所所所以……我要看什么？"

# game/Days/dayNine.rpy:376
translate chinese D9_Yui_13f8d49c:

    # nurse "Come here, take a seat on this convenient chair I set out for you!"
    nurse "过来，坐坐我特意给你准备的「便利」椅子！"

# game/Days/dayNine.rpy:378
translate chinese D9_Yui_2b35b6fe:

    # mc "..."
    mc "……"

# game/Days/dayNine.rpy:379
translate chinese D9_Yui_758b9cb7:

    # mc "It's just not a chair though, is it?"
    mc "但这可不只是把椅子，对吧？"

# game/Days/dayNine.rpy:380
translate chinese D9_Yui_f294ac4c:

    # nurse "It's in the name!"
    nurse "这名字里不都写着嘛！"

# game/Days/dayNine.rpy:381
translate chinese D9_Yui_68415fc1:

    # mc "Hhh..."
    mc "呵……"

# game/Days/dayNine.rpy:384
translate chinese D9_Yui_da29d05a:

    # "You reluctantly plop yourself on the {i}Wheelchair{/i} kindly set out by [nurse]."
    "你不情不愿地坐到了[nurse]体贴摆好的那把{i}轮椅{/i}上。"

# game/Days/dayNine.rpy:386
translate chinese D9_Yui_38f8f8b7:

    # mc "What do we know?"
    mc "我们都知道些什么了？"

# game/Days/dayNine.rpy:388
translate chinese D9_Yui_91cf95ec:

    # nurse "It seems [yui] here banged her right foot on the diving board."
    nurse "情况是这样的：[yui]从跳板上下来时磕到了右脚。"

# game/Days/dayNine.rpy:391
translate chinese D9_Yui_13cf562d:

    # "She tilts her head slightly and leans forward, sniffing you with open curiosity, her expression thoughtful as her cat ears flick once."
    "她微微歪着头，毫不掩饰地凑上来嗅你，神情若有所思，猫耳抖了抖。"

# game/Days/dayNine.rpy:393
translate chinese D9_Yui_a2dc10af:

    # nurse "Hm. You smell good."
    nurse "嗯。你闻起来不错。"

# game/Days/dayNine.rpy:394
translate chinese D9_Yui_193a9846:

    # mc "Right. We gathered that much when she first came in. Anything else?"
    mc "对。她刚被送来的时候我们就知道了。还有别的吗？"

# game/Days/dayNine.rpy:395
translate chinese D9_Yui_dd847a7b:

    # nurse "..."
    nurse "……"

# game/Days/dayNine.rpy:396
translate chinese D9_Yui_bdab4a8b:

    # yui "..."
    yui "……"

# game/Days/dayNine.rpy:397
translate chinese D9_Yui_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Days/dayNine.rpy:400
translate chinese D9_Yui_5e750d93:

    # mc "You... are a qualified nurse, {i}right{/i}?"
    mc "你……是持证护士，{i}对吧{/i}？"

# game/Days/dayNine.rpy:402
translate chinese D9_Yui_50da9e69:

    # nurse "Of course! But, hmm..."
    nurse "当然！不过，嗯……"

# game/Days/dayNine.rpy:404
translate chinese D9_Yui_91d25c18:

    # nurse "What else is there to say? She's hurt her ankle."
    nurse "还有什么好说的？她伤了脚踝。"

# game/Days/dayNine.rpy:405
translate chinese D9_Yui_25917d47:

    # nurse "That's the whole story."
    nurse "就这样。"

# game/Days/dayNine.rpy:406
translate chinese D9_Yui_cd1d7c36:

    # nurse "She's dove off the board 100's of times before and always nailed it."
    nurse "她从这块板上跳下去过几百次了，每次都稳稳落水。"

# game/Days/dayNine.rpy:408
translate chinese D9_Yui_cb392e8b:

    # yui "Mhmm... I think I might have just slipped. You know, water is wet."
    yui "嗯……我想我大概只是滑了一下。你知道的，水是湿的。"

# game/Days/dayNine.rpy:410
translate chinese D9_Yui_36faca12:

    # nurse "See?"
    nurse "看吧？"

# game/Days/dayNine.rpy:411
translate chinese D9_Yui_b83ccce6:

    # nurse "Now it's our job to fix it!"
    nurse "现在就是我们的职责了！"

# game/Days/dayNine.rpy:413
translate chinese D9_Yui_18940498:

    # mc "Our job? I'm not a nurse. I'm not sure you're much of one either."
    mc "我们的工作？我又不是护士。再说了，我也不觉得你能算哪门子护士。"

# game/Days/dayNine.rpy:415
translate chinese D9_Yui_5df852ce:

    # nurse "But you could be! It's a new skill!"
    nurse "但你可以学啊！这也算门新手艺！"

# game/Days/dayNine.rpy:417
translate chinese D9_Yui_ab90080b:

    # "She leans in a little closer, a soft trace of her perfume lingering as her breath brushes past your ear, her voice dropping to a quiet murmur."
    "她又凑近了一点，身上那点香水味若有若无地萦绕着，呼吸拂过你的耳廓，声音压得又轻又低。"

# game/Days/dayNine.rpy:418
translate chinese D9_Yui_285078d9:

    # nurse "{i}{size=-10}...Whispering...{/i}{/size} {size=-14}And you can get a good {i}feel{/i} for it.{/size}"
    nurse "{i}{size=-10}……小声说……{/i}{/size} {size=-14}这样你就能好好{i}体会{/i}一下了。{/size}"

# game/Days/dayNine.rpy:419
translate chinese D9_Yui_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Days/dayNine.rpy:421
translate chinese D9_Yui_d541809f:

    # mc "[nurse]..."
    mc "[nurse]……"

# game/Days/dayNine.rpy:424
translate chinese D9_Yui_6c9a5abd:

    # mc "Do I look like Johnny Sins to you!?"
    mc "我看着像「强尼·辛斯」吗！？"

# game/Days/dayNine.rpy:432
translate chinese D9_Yui_ea999211:

    # "She Looks you up and down, peeling away at you starting from your head and ending at your crotch."
    "她从上到下把你打量了一遍，目光一路往下，最后落在你的裤裆上。"

# game/Days/dayNine.rpy:435
translate chinese D9_Yui_d6cbca2e:

    # nurse "In some regards, I'm sure~"
    nurse "这方面嘛，我很确定～"

# game/Days/dayNine.rpy:436
translate chinese D9_Yui_5ae0810e:

    # nurse "If only you'd let me take a peak. [outlineHeart]"
    nurse "要是你肯让我看上一眼就好了。[outlineHeart]"

# game/Days/dayNine.rpy:444
translate chinese D9_Yui_29e218fa:

    # nurse "So, what's it gonna be, Mr. Sins? Do you want to add a career and massage [yui]?"
    nurse "怎么样，「辛斯」先生？要不要多加一门职业，给[yui]做做按摩？"

# game/Days/dayNine.rpy:450
translate chinese D9_Yui_11fdb519:

    # extend "" nointeract
    extend "" nointeract

# game/Days/dayNine.rpy:453
translate chinese D9_Yui_948c20ca:

    # mc "You know... I don't think I can do this."
    mc "你知道的……我觉得我做不到。"

# game/Days/dayNine.rpy:454
translate chinese D9_Yui_85615939:

