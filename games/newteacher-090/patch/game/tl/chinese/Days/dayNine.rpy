# game/Days/dayNine.rpy:6007
translate chinese d9_window_skip_584bbdf2:

    # "She shifts slightly in her seat."
    "她在椅子上微微挪了挪身子。"

# game/Days/dayNine.rpy:6009
translate chinese d9_window_skip_9a456530:

    # principal "I'm perfectly fine. Your little stunt was more of an inconvenience than anything else."
    principal "我好得很。你那点小把戏顶多算添麻烦。"

# game/Days/dayNine.rpy:6011
translate chinese d9_window_skip_4542cef4:

    # mc "An inconvenience? You looked pretty affected to me."
    mc "添麻烦？在我看来你可是难受得很。"

# game/Days/dayNine.rpy:6013
translate chinese d9_window_skip_deff439d:

    # principal "You mean you looked frustrated that your plan didn't work?"
    principal "你是说，你看起来很沮丧——因为你的计划没能成功？"

# game/Days/dayNine.rpy:6015
translate chinese d9_window_skip_aafc053b:

    # principal "I maintained control throughout. Despite your best efforts."
    principal "我全程都保持着自控，任凭你使尽手段。"

# game/Days/dayNine.rpy:6017
translate chinese d9_window_skip_3b637c62:

    # mc "Is that what you think?"
    mc "你是这么想的？"

# game/Days/dayNine.rpy:6019
translate chinese d9_window_skip_90a831dd:

    # principal "Close doesn't count, [player_name]. You don't win over me."
    principal "接近可不算赢，[player_name]。你赢不了我。"

# game/Days/dayNine.rpy:6021
translate chinese d9_window_skip_7915e66c:

    # mc "If that helps you sleep at night."
    mc "如果那能让你晚上睡得着的话。"

# game/Days/dayNine.rpy:6025
translate chinese d9_window_skip_afbe75ad:

    # principal "I was foolish to select maximum intensity."
    principal "我真是蠢，选了最高档。"

# game/Days/dayNine.rpy:6026
translate chinese d9_window_skip_325e4fa5:

    # principal "Although I am glad you only used it once during the speech."
    principal "不过还好你在演讲时只用过一次。"

# game/Days/dayNine.rpy:6028
translate chinese d9_window_skip_f5251891:

    # mc "Of course! I wouldn't want you to get too into it during a public lecture."
    mc "当然！我可不想你在公开讲座上太投入。"

# game/Days/dayNine.rpy:6029
translate chinese d9_window_skip_0122a8ac:

    # mc "That'd be way over the top for your first punishment."
    mc "对你第一次受罚来说，那就太过火了。"

# game/Days/dayNine.rpy:6032
translate chinese d9_window_skip_f57245d3:

    # principal "Ha. I made a reasonable choice with the intensity."
    principal "哈。强度我选得很合理。"

# game/Days/dayNine.rpy:6034
translate chinese d9_window_skip_08b68527:

    # mc "Could've been worse if I'd used it more."
    mc "要是我多用几次，可能更糟。"

# game/Days/dayNine.rpy:6035
translate chinese d9_window_skip_983642f9:

    # mc "But that'd be over the top for your first punishment, wouldn't you say?"
    mc "不过那样对你第一次受罚来说就过头了，你说呢？"

# game/Days/dayNine.rpy:6038
translate chinese d9_window_skip_f8b95340:

    # principal "A mild setting was the smart choice."
    principal "选温和档才是明智之举。"

# game/Days/dayNine.rpy:6040
translate chinese d9_window_skip_07df869e:

    # mc "You played it safe, commendable; for your first punishment."
    mc "你选了个稳妥的做法，值得表扬——毕竟是你第一次受罚。"

# game/Days/dayNine.rpy:6043
translate chinese d9_window_skip_4163e935:

    # principal "Minimum power was the only logical choice. I barely felt anything."
    principal "最低档才是唯一合乎逻辑的选择。我几乎没什么感觉。"

# game/Days/dayNine.rpy:6045
translate chinese d9_window_skip_76683da7:

    # mc "Smart. But that won't work twice."
    mc "聪明。但这一招不会有第二次机会。"

# game/Days/dayNine.rpy:6047
translate chinese d9_window_skip_a278df2b:

    # principal "There won't be a next time."
    principal "不会有下次了。"

# game/Days/dayNine.rpy:6051
translate chinese d9_window_skip_b19808de:

    # principal "Your attempt at punishment was laughable at best."
    principal "你那次惩罚顶多算个笑话。"

# game/Days/dayNine.rpy:6052
translate chinese d9_window_skip_dce3b316:

    # principal "I barely noticed anything was happening."
    principal "我几乎没察觉有什么在发生。"

# game/Days/dayNine.rpy:6054
translate chinese d9_window_skip_a148799b:

    # mc "Yeah, I might have gone too easy on you."
    mc "是啊，我可能对你手下留情了。"

# game/Days/dayNine.rpy:6055
translate chinese d9_window_skip_acf93193:

    # mc "But, luckily for us, there's always next time!"
    mc "不过还好，我们总还有下次！"

# game/Days/dayNine.rpy:6057
translate chinese d9_window_skip_8177a506:

    # principal "Next time? There won't be a next time."
    principal "下次？不会有下次的。"

# game/Days/dayNine.rpy:6059
translate chinese d9_window_skip_098ca340:

    # mc "Oh, we'll see about that."
    mc "哦，这个可说不准。"

# game/Days/dayNine.rpy:6060
translate chinese d9_window_skip_3da4fa4f:

    # mc "Still kept BoB?"
    mc "鲍勃还留着吗？"

# game/Days/dayNine.rpy:6062
translate chinese d9_window_skip_d1d6029d:

    # principal "That {i}thing{/i}?"
    principal "那{i}个东西{/i}？"

# game/Days/dayNine.rpy:6063
translate chinese d9_window_skip_1b3ab3e1:

    # principal "Regrettably so. Why do you ask?"
    principal "很遗憾，是的。你问这个做什么？"

# game/Days/dayNine.rpy:6065
translate chinese d9_window_skip_31214459:

    # mc "Just curious... Might come in handy sooner rather than later."
    mc "只是好奇……说不定很快就有用武之地了。"

# game/Days/dayNine.rpy:6066
translate chinese d9_window_skip_04b54245:

    # mc "But that's not why I'm here."
    mc "但我来这不是为了这个。"

# game/Days/dayNine.rpy:6068
translate chinese d9_window_skip_75086279:

    # principal "Then please, enlighten me. What is the purpose of this visit?"
    principal "那么请赐教。这次来访有何贵干？"

# game/Days/dayNine.rpy:6070
translate chinese d9_window_skip_8d52a1f2:

    # mc "How long has it been again? Since you became Principal?"
    mc "我再问一遍，你当校长多久了？"

# game/Days/dayNine.rpy:6071
translate chinese d9_window_skip_5f061a9b_1:

    # principal "..."
    principal "……"

# game/Days/dayNine.rpy:6073
translate chinese d9_window_skip_85c5e51c:

    # principal "Five years and Twenty-Nine days."
    principal "五年零二十九天。"

# game/Days/dayNine.rpy:6075
translate chinese d9_window_skip_d4a3cbd4:

    # mc "Right. Almost six years of hard work building this place up."
    mc "对。将近六年的辛苦，才把这里建起来。"

# game/Days/dayNine.rpy:6077
translate chinese d9_window_skip_586350b9:

    # principal "Yes. And I won't have you pilfer it."
    principal "没错。而且我不会让你把它偷走。"

# game/Days/dayNine.rpy:6079
translate chinese d9_window_skip_86ee19ab:

    # mc "Pilfer? That's a strong word."
    mc "偷？这用词可够重的。"

# game/Days/dayNine.rpy:6081
translate chinese d9_window_skip_26930ea2:

    # principal "Is it? You waltz in here with your little contract and suddenly everything I've built is being undermined."
    principal "是吗？你拿着那份小合同大摇大摆地走进来，我辛辛苦苦建立的一切就一下子被动摇了。"

# game/Days/dayNine.rpy:6083
translate chinese d9_window_skip_cac51ce9:

    # mc "A contract you signed, and took the money for, by the way."
    mc "顺便说一句，那份合同可是你签的，钱你也收了。"

# game/Days/dayNine.rpy:6084
translate chinese d9_window_skip_9e1c4cd0:

    # mc "You don't just take up a new curriculum without getting something out of it."
    mc "你总不会接手一门新课程，却什么都不想从中得到吧。"

# game/Days/dayNine.rpy:6085
translate chinese d9_window_skip_43fc5a16:

    # mc "Must have been {i}a lot{/i} given what {i}my{/i} paycheck is. I dread to think how much you can be bought for."
    mc "那一定是{i}一大笔{/i}钱——以{i}我{/i}这份薪水来看。我真不敢想你得值多少钱。"

# game/Days/dayNine.rpy:6086
translate chinese d9_window_skip_5fdadb6c:

    # mc "It's not my fault you didn't read the fine print."
    mc "你没看细则，这可不能怪我。"

# game/Days/dayNine.rpy:6088
translate chinese d9_window_skip_777d9582:

    # mc "For someone as {i}prestigious{/i} as you, I'd have thought you'd have had that reading thing nailed."
    mc "像你这样{i}德高望重{/i}的人，我还以为你看文件这种小事早就安排妥当了。"

# game/Days/dayNine.rpy:6090
translate chinese d9_window_skip_2e04a05f:

    # mc "Whereas for me? I'm just doing my job that {i}you{/i} hired me for."
    mc "至于我？我不过是在做{i}你{/i}雇我做的事而已。"

# game/Days/dayNine.rpy:6102
translate chinese d9_window_skip_f638fb98:

    # mc "Or was someone speaking for you then, too?"
    mc "还是说，那时候也有人替你说话？"

# game/Days/dayNine.rpy:6103
translate chinese d9_window_skip_a40e6f35:

    # "You're slowly but surely getting under her skin. Her eye twitches with sutble anger even if she might try and mask it."
    "你正在一点一点地惹毛她。她的眼角因压抑的怒气而抽动，哪怕她想掩饰也藏不住。"

# game/Days/dayNine.rpy:6105
translate chinese d9_window_skip_7d846fc7:

    # principal "Sinergy offered an {i}obscene{/i} amount of money for a partnership."
    principal "星聚能为了达成合作，开出了{i}一笔天文数字{/i}的价码。"

# game/Days/dayNine.rpy:6108
translate chinese d9_window_skip_8bd0cc8e:

    # principal "Only a fool would have rejected it."
    principal "只有傻子才会拒绝。"

# game/Days/dayNine.rpy:6109
translate chinese d9_window_skip_f20acec4:

    # principal "You have no idea how much it costs to actually run and facilitate a college."
    principal "你根本不知道真正经营一所学院要花多少钱。"

# game/Days/dayNine.rpy:6110
translate chinese d9_window_skip_9f3df620:

    # principal "You wouldn't understand."
    principal "你不会懂的。"

# game/Days/dayNine.rpy:6112
translate chinese d9_window_skip_e3563e0c:

    # mc "Partnership. Interesting word for it."
    mc "合作。这词选得真有意思。"

# game/Days/dayNine.rpy:6116
translate chinese d9_window_skip_398bbedf:

    # principal "That's what it is."
    principal "事实就是如此。"

# game/Days/dayNine.rpy:6118
translate chinese d9_window_skip_fabb14a1:

    # mc "So you still own this place then? Full control?"
    mc "所以这里现在还归你所有？完全的控制权？"

# game/Days/dayNine.rpy:6120
translate chinese d9_window_skip_eed63cc5:

    # principal "I maintain operational control, yes."
    principal "是的，日常运营由我掌控。"

# game/Days/dayNine.rpy:6122
translate chinese d9_window_skip_ba065f2c:

    # mc "That's not what I asked."
    mc "我问的不是这个。"

# game/Days/dayNine.rpy:6123
translate chinese d9_window_skip_5f061a9b_2:

    # principal "..."
    principal "……"

# game/Days/dayNine.rpy:6125
translate chinese d9_window_skip_19fea70d:

    # principal "Sinergy holds majority stake. But I run this institution day-to-day."
    principal "星聚能持有多数股权，但这所机构日常由我打理。"

# game/Days/dayNine.rpy:6127
translate chinese d9_window_skip_5647312a:

    # mc "So you sold it."
    mc "所以你把它卖了。"

# game/Days/dayNine.rpy:6129
translate chinese d9_window_skip_25bb7d9d:

    # principal "No, I secured my..-its future."
    principal "不，我保障的是我……它的未来。"

# game/Days/dayNine.rpy:6131
translate chinese d9_window_skip_9fcac3e9:

    # mc "By giving up control."
    mc "通过放弃控制权。"

# game/Days/dayNine.rpy:6133
translate chinese d9_window_skip_efd8d41a:

    # principal "I still have more authority here than you ever will."
    principal "我在这里的权力，比你这辈子能有的都大。"

# game/Days/dayNine.rpy:6135
translate chinese d9_window_skip_f0e056cc:

    # mc "Authority over running the college? Sure. That's your domain."
    mc "管理学院的权限？当然。那是你的地盘。"

# game/Days/dayNine.rpy:6137
translate chinese d9_window_skip_d18062a7:

    # mc "But the PARE system? That's mine."
    mc "可赏罚系统呢？那归我管。"

# game/Days/dayNine.rpy:6139
translate chinese d9_window_skip_f18347e2:

    # principal "That I approved and signed off on."
    principal "那可是我批准、签字认可的。"

# game/Days/dayNine.rpy:6141
translate chinese d9_window_skip_eeec3688:

    # mc "A system you subjected everyone to. Students. Staff."
    mc "一个你强加给所有人的系统。学生、教职工。"

# game/Days/dayNine.rpy:6143
translate chinese d9_window_skip_7dcd8ee4:

    # mc "Even your own daughter."
    mc "甚至你自己的女儿。"

# game/Days/dayNine.rpy:6147
translate chinese d9_window_skip_5bc64732:

    # principal "You leave [belle] out of this!"
    principal "别把[belle]牵扯进来！"

# game/Days/dayNine.rpy:6149
translate chinese d9_window_skip_d7c9c6cf:

    # mc "Why? You didn't leave her out when you handed the keys over to Sinergy."
    mc "为什么？把钥匙交给星聚能的时候，你可没把她排除在外。"

# game/Days/dayNine.rpy:6150
translate chinese d9_window_skip_41ba7d6d:

    # mc "You approved a system where [belle] could be sexually punished or rewarded by an unknown Enforcer."
    mc "你批准了这样一个系统：[belle]可能会被某个来路不明的执法者施加性惩罚，或者性奖励。"

# game/Days/dayNine.rpy:6152
translate chinese d9_window_skip_e6a27fbf:

    # mc "How does that square with how protective you seemingly are of her?"
    mc "这和你表面上那副护女心切的样子怎么对得上？"

# game/Days/dayNine.rpy:6154
translate chinese d9_window_skip_b63736e3:

    # principal "I... I ensured proper safeguards were in place."
    principal "我……我确保了必要的防护措施已经到位。"

# game/Days/dayNine.rpy:6156
translate chinese d9_window_skip_4d9e136e:

    # mc "Safeguards? Like what? You staying around as the big and mighty principal?"
    mc "防护措施？比如什么？比如你这个大人物校长留在旁边镇场子？"

# game/Days/dayNine.rpy:6157
translate chinese d9_window_skip_93f9c485:

    # mc "The contract she signed?"
    mc "她签的合同？"

# game/Days/dayNine.rpy:6158
translate chinese d9_window_skip_c36909c8:

    # mc "The same contract that gives me authority over her if her behavior needs correcting?"
    mc "就是那份只要她的行为需要矫正，就赋予我管束她权力的合同？"

# game/Days/dayNine.rpy:6160
translate chinese d9_window_skip_d894c91b:

    # principal "I've made myself clear regarding my daughter."
    principal "关于我女儿的事，我已经说得很清楚。"

# game/Days/dayNine.rpy:6168
translate chinese d9_window_skip_71630dd7:

    # mc "But the system doesn't work that way, does it?"
    mc "但系统不是那样运作的，对吧？"

# game/Days/dayNine.rpy:6169
translate chinese d9_window_skip_f28b24e3:

    # mc "You can't tell me to enforce the rules on everyone except [belle]."
    mc "你不能要求我对所有人都照章执行，唯独放过[belle]。"

# game/Days/dayNine.rpy:6170
translate chinese d9_window_skip_3dbe65da:

    # mc "That's not how this works."
    mc "这套东西不是这么运作的。"

# game/Days/dayNine.rpy:6172
translate chinese d9_window_skip_086dca30:

    # mc "Look at me. This is important."
    mc "看着我。这件事很重要。"

# game/Days/dayNine.rpy:6174
translate chinese d9_window_skip_b5bce35d:

    # principal "I simply won't allow [belle] to get into situations requiring... {i}enforcement{/i}."
    principal "我绝不会让[belle]陷入需要……{i}强制{/i}处理的情形。"

# game/Days/dayNine.rpy:6177
translate chinese d9_window_skip_02eed136:

    # mc "Not sure that's for you to decide. You sound a little controlling."
    mc "这可由不得你决定。你听起来有点控制过头了。"

# game/Days/dayNine.rpy:6178
translate chinese d9_window_skip_160ad14b:

    # principal "If necessary, yes."
    principal "如果有必要，是的。"

# game/Days/dayNine.rpy:6179
translate chinese d9_window_skip_a3fd2288:

    # mc "You're not protecting her. You're locking her in a cage."
    mc "你不是在保护她，你是在把她关进笼子。"

# game/Days/dayNine.rpy:6180
translate chinese d9_window_skip_8cc46b77:

    # principal "She's my daughter. I know what's best for her."
    principal "她是我女儿。我知道什么才是对她最好的。"

# game/Days/dayNine.rpy:6181
translate chinese d9_window_skip_ea792d4c:

    # mc "Then why sign her into a system where you can't control what happens to her?"
    mc "那为什么要把她送进一个你根本掌控不了她遭遇的系统？"

# game/Days/dayNine.rpy:6182
translate chinese d9_window_skip_caebd3a9:

    # mc "You can't both approve the Punishment and Reward Exchange and demand she be exempt from it."
    mc "你不能一边批准赏罚系统，一边要求她豁免在外。"

# game/Days/dayNine.rpy:6183
translate chinese d9_window_skip_c9e69707:

    # mc "Pick one."
    mc "你选一个吧。"

# game/Days/dayNine.rpy:6184
translate chinese d9_window_skip_5f061a9b_3:

    # principal "..."
    principal "……"

# game/Days/dayNine.rpy:6185
translate chinese d9_window_skip_c9afaa84:

    # "She tears her gaze from yours once again; the same way as someone walking out of a room they set on fire, certain it needed burning."
    "她再一次把视线从你身上撕开；就像一个人走出自己亲手点燃的房间，笃定那屋子非烧不可。"

# game/Days/dayNine.rpy:6188
translate chinese d9_window_skip_8fb8442f:

    # mc "The money was that good, huh?"
    mc "那笔钱就那么值钱，嗯？"

# game/Days/dayNine.rpy:6190
translate chinese d9_window_skip_68eec354:

    # principal "Get out."
    principal "滚出去。"

# game/Days/dayNine.rpy:6192
translate chinese d9_window_skip_70e7de7c:

    # mc "Not yet."
    mc "还不行。"

# game/Days/dayNine.rpy:6196
translate chinese d9_window_skip_be89fa7a:

    # "You drop the envelope on the desk in front of her."
    "你把信封往她面前的桌上一丢。"

# game/Days/dayNine.rpy:6198
translate chinese d9_window_skip_7290a666:

    # mc "Open it."
    mc "打开。"

# game/Days/dayNine.rpy:6200
translate chinese d9_window_skip_0df39c91:

    # principal "I don't take orders from you."
    principal "我不接受你的命令。"

# game/Days/dayNine.rpy:6206
translate chinese d9_window_skip_11fdb519:

    # extend "" nointeract
    extend "" nointeract

# game/Days/dayNine.rpy:6209
translate chinese d9_window_skip_80b6f985:

    # mc "Alright, I'll rephrase it."
    mc "好吧，我换个说法。"

# game/Days/dayNine.rpy:6210
translate chinese d9_window_skip_476b8b5e:

    # mc "Can you {i}please{/i} open the letter?"
    mc "这封信，你能{i}拜托{/i}拆开吗？"

# game/Days/dayNine.rpy:6212
translate chinese d9_window_skip_e9d0edab:

    # principal "Better."
    principal "这还差不多。"

# game/Days/dayNine.rpy:6215
translate chinese d9_window_skip_d06d09ab:

    # mc "The one thing I'm not going to do, is repeat myself."
    mc "我唯一不会做的事，就是把话再说一遍。"

# game/Days/dayNine.rpy:6216
translate chinese d9_window_skip_5f061a9b_4:

    # principal "..."
    principal "……"

# game/Days/dayNine.rpy:6220
translate chinese d9_window_skip_879e5db7:

    # "She sits back down and picks up the envelope, examining it."
    "她重新坐下，拿起信封，仔细端详。"

# game/Days/dayNine.rpy:6222
