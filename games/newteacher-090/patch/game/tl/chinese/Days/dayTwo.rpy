translate chinese D2_Morgana_Swim_81b63e29:

    # mc "How are you feeling [morg]?"
    mc "[morg]，你感觉怎么样？"

# game/Days/dayTwo.rpy:1174
translate chinese D2_Morgana_Swim_5f5b46f8:

    # morg "Hey [school_player_name]."
    morg "嘿，[school_player_name]。"

