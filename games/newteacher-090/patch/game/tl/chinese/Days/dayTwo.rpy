    nurse "[morg]，亲爱的，为我站起来！"

# game/Days/dayTwo.rpy:1221
translate chinese D2_Morgana_Swim_c2d95b65_1:

    # morg "..."
    morg "……"

# game/Days/dayTwo.rpy:1223
translate chinese D2_Morgana_Swim_36faca12:

    # nurse "See?"
    nurse "看到了吧？"

# game/Days/dayTwo.rpy:1225
