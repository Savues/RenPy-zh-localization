translate chinese D2_Morgana_Swim_efda842e:

    # mc "Wait... You used it on [morg]?"
    mc "等等……你在[morg]身上使用过它了？"

# game/Days/dayTwo.rpy:1197
translate chinese D2_Morgana_Swim_1c7a3a92_1:

