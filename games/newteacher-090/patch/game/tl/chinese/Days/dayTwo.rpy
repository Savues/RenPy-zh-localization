translate chinese D2_Morgana_Swim_681d950d:

    # mcT "There it is again... [morg]'s eyes {b}are{/b} changing!"
    mcT "又出现了……[morg]的眼睛{b}确实{/b}在变色！"

# game/Days/dayTwo.rpy:1194
translate chinese D2_Morgana_Swim_a31340dd:

    # mc "Really?"
    mc "真的吗？"

# game/Days/dayTwo.rpy:1195
translate chinese D2_Morgana_Swim_e320af98:

    # mc "And shit didn't blow up?"
    mc "而且没引发什么乱子吗？"

