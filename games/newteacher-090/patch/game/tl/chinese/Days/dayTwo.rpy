translate chinese D2_Morgana_Nurse_f80863ff:

    # ella "We will support you in anyway you need. {i}Anything{/i} you need."
    ella "无论你需要什么，我们都会全力支持。{i}任何{/i}需求都可以。"

# game/Days/dayTwo.rpy:1715
translate chinese D2_Morgana_Nurse_730a6a5a:

    # ella "Come to think of it.."
    ella "说到这……"

