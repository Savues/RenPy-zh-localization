translate chinese D2_Morgana_Swim_e154b20e:

    # nurse "But that faux animosity might change rather sharpishly my little gumball."
    nurse "不过，我的小甜心——你这副假装出来的敌意，很快就要变成别的东西咯。"

# game/Days/dayTwo.rpy:1170
translate chinese D2_Morgana_Swim_6cace255:

    # nurse "Come look!"
    nurse "快来看看吧！"

