translate chinese D2_Morgana_Swim_2d06357b:

    # nurse "Oh.. You remember that hair you gave me yesterday?"
    nurse "哦……你还记得昨天你给我的头发吗？"

# game/Days/dayTwo.rpy:1189
translate chinese D2_Morgana_Swim_ad909a8e:

    # mc "Hmmm..."
    mc "嗯……"

# game/Days/dayTwo.rpy:1191
translate chinese D2_Morgana_Swim_c5023821:

