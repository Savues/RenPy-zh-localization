# game/Days/prologue.rpy:3
translate chinese prologue_07b4f379:

    # mc "...I look that bad, huh?"
    mc "……我看起来有那么糟吗，嗯？"

# game/Days/prologue.rpy:4
translate chinese prologue_82fb30fd:

    # nobody "You know, people usually come here to {i}forget{/i} their problems, not marinate in them."
    nobody "你知道，人们通常来这里是为了{i}忘记{/i}烦恼，而不是泡在烦恼里。"

# game/Days/prologue.rpy:5
translate chinese prologue_103ae547:

    # nobody "You're scaring off the regulars with your depressive stink, [player_name]."
    nobody "你身上那股子忧郁的霉气，都快把老主顾吓跑了，[player_name]。"

# game/Days/prologue.rpy:6
translate chinese prologue_de7d9026:

    # mc "Yeah, well... maybe they'll start tipping better out of pity."
    mc "是啊，好吧……说不定他们出于同情，反倒会给更多小费呢。"

# game/Days/prologue.rpy:7
translate chinese prologue_cfb2b9fb:

    # nobody "Come on, man. Everyone's got a story. It's half my job; serving drinks and playing therapist."
    nobody "得了吧，老兄。谁还没点故事。我干这行，一半是为了端酒，一半是兼职心理医生。"

# game/Days/prologue.rpy:8
translate chinese prologue_ab15a1dc:

    # mc "Eh, maybe some other time, [bill]."
    mc "呃，也许改天吧，[bill]。"

# game/Days/prologue.rpy:9
translate chinese prologue_cfd31846:

    # mc "Right now I just want to drown myself in this liquid gold."
    mc "我现在只想一头扎进这液体黄金里。"

# game/Days/prologue.rpy:10
translate chinese prologue_e2fe3514:

    # bill "It's really that bad, huh?"
    bill "真的有那么糟吗，嗯？"

# game/Days/prologue.rpy:11
translate chinese prologue_a0ba589e:

    # bill "Shit man, what happened? Get fired or something?"
    bill "靠，老兄，出什么事了？被炒鱿鱼了还是怎么的？"

# game/Days/prologue.rpy:12
translate chinese prologue_2b60433f:

    # mc "Serving drinks while reading your crystal ball, ay?"
    mc "一边端酒，一边看水晶球占卜，是吧？"

# game/Days/prologue.rpy:13
translate chinese prologue_406b7bfa:

    # bill "Well, your eyes haven't left the table. Gotta be something rough."
    bill "你的眼睛一直盯着桌子发呆，肯定遇上什么糟心事了。"

# game/Days/prologue.rpy:15
translate chinese prologue_7911f0b3:

    # mc "Yeah... Sorry, [bill]. I'm not normally one to mope. You know that better than anyone."
    mc "是啊……抱歉，[bill]。我平时不这样的，你比谁都了解我。"

# game/Days/prologue.rpy:16
translate chinese prologue_19bae4e3:

    # bill "That I do, my friend."
    bill "那倒是，老朋友。"

# game/Days/prologue.rpy:17
translate chinese prologue_28b3a758:

    # bill "What happened then? I thought you were good at your job?"
    bill "那到底出什么事了？我记得你工作不是做得挺好的吗？"

# game/Days/prologue.rpy:18
translate chinese prologue_be546480:

    # mc "Oh, I was. It wasn't about {i}me{/i}."
    mc "哦，我干得确实不错。问题不在{i}我{/i}身上。"

# game/Days/prologue.rpy:19
translate chinese prologue_f6a8d50d:

    # bill "Awww shit. Let me guess, something to do with that whatchamacallit you always moan about?"
    bill "啊，靠。让我猜猜，跟你老是念叨的那个什么玩意儿有关？"

# game/Days/prologue.rpy:20
translate chinese prologue_9df44fc3:

    # bill "That colleague chick? What's her name..."
    bill "那个女同事？她叫什么来着……"

# game/Days/prologue.rpy:21
translate chinese prologue_30c4b7d7:

    # bill "...[nurse]?"
    bill "……[nurse]？"

# game/Days/prologue.rpy:22
translate chinese prologue_b180829a:

    # mc "Bingo."
    mc "没错。"

# game/Days/prologue.rpy:23
translate chinese prologue_f853ca42:

    # mc "Let's just say... an experiment went south. {i}Fast{/i}."
    mc "这么说吧……有次实验砸了。{i}而且砸得飞快{/i}。"

# game/Days/prologue.rpy:24
translate chinese prologue_4f5eed2d:

    # bill "Damn. She finally blew something up, huh?"
    bill "该死。她终于把什么东西给炸了，是吧？"

# game/Days/prologue.rpy:25
translate chinese prologue_3e9d9c88:

    # mc "Oh she wanted to blow something all right..."
    mc "哦，她倒是真想炸点什么……"

# game/Days/prologue.rpy:26
translate chinese prologue_3ff7ffd5:

    # bill "Hahaha. That doesn't sound like a bad thing."
    bill "哈哈哈。听起来不像是坏事。"

# game/Days/prologue.rpy:27
translate chinese prologue_dd092624:

    # mc "It is when {i}she's{/i} involved. And in that state."
    mc "但只要{i}她{/i}掺和进来就麻烦了——尤其是当时那个状态。"

# game/Days/prologue.rpy:28
translate chinese prologue_3a37f211:

    # mc "...Anyway, it's behind me. Time to start a new chapter."
    mc "……总之，都过去了。是时候翻开新的一章了。"

# game/Days/prologue.rpy:30
translate chinese prologue_e949c7f4:

    # mc "Thankfully, I can stay at home as long as I need."
    mc "幸好，现在我可以在家想待多久就待多久。"

# game/Days/prologue.rpy:31
translate chinese prologue_af95c5b6:

    # bill "God bless your mom. I wish my mom would'a done that for me."
    bill "你妈妈真是个好人。我真希望我妈当年也能这样对我。"

# game/Days/prologue.rpy:32
translate chinese prologue_131eaf2a:

    # bill "Soon as I was 18, I was on my own, ha."
    bill "我一满十八岁，就靠自己讨生活了，哈。"

# game/Days/prologue.rpy:33
translate chinese prologue_b3441388:

    # bill "Not all bad though. Made me the man I am today."
    bill "不过也不算全是坏事。正是那段日子塑造了今天的我。"

# game/Days/prologue.rpy:34
translate chinese prologue_35118208:

    # bill "Just don't let comfort make you soft. You're a smart guy. You'll bounce back."
    bill "只是别让安逸把你养软了。你很聪明，会振作起来的。"

# game/Days/prologue.rpy:35
translate chinese prologue_9b7bb7cb:

    # mc "Let's hope."
    mc "希望如此吧。"

# game/Days/prologue.rpy:37
translate chinese prologue_5cda54ec:

    # mc "Since the lab let me go, I've got to find a new place to live too."
    mc "既然实验室让我滚蛋，我还得找个新地方住。"

# game/Days/prologue.rpy:38
translate chinese prologue_7be82bdf:

    # bill "What, they kick you out of staff housing or something?"
    bill "什么，他们把你从员工宿舍里赶出来了还是怎么的？"

# game/Days/prologue.rpy:39
translate chinese prologue_e1e29807:

    # mc "Something like that. Lease was tied to my contract. No job, no keys."
    mc "差不多吧。租约是跟合同绑定的。没工作，就没钥匙。"

# game/Days/prologue.rpy:40
translate chinese prologue_5b4e1caf:

    # mc "And since I'm not exactly flush, I've been looking for rooms to rent."
    mc "而且我手头也不宽裕，所以一直在找房子租。"

# game/Days/prologue.rpy:41
translate chinese prologue_cfafea5e:

    # mc "Found this house with a nice couple. Says they've got two other tenants already."
    mc "找到一栋房子，房主是对不错的夫妻。他们说家里还住着另外两个租客。"

# game/Days/prologue.rpy:42
translate chinese prologue_1b70cc27:

    # bill "You thinking of moving in?"
    bill "你在考虑搬进去？"

# game/Days/prologue.rpy:43
translate chinese prologue_f81997a1:

    # mc "Maybe. The Landlady seems like a looker, too."
    mc "也许吧。而且那位女房东看着也是个美人。"

# game/Days/prologue.rpy:44
translate chinese prologue_a58dd0ed:

    # bill "Haha. You never change."
    bill "哈哈。你真是本性难移。"

# game/Days/prologue.rpy:45
translate chinese prologue_74c8c452:

    # bill "How much of a looker? For science?"
    bill "有多漂亮？值得我为科学献身？"

# game/Days/prologue.rpy:47
translate chinese prologue_53d7721e:

    # bill "{size=-10}{i}...Whistles...{/i}{/size} A looker indeed."
    bill "{size=-10}{i}……吹口哨……{/i}{/size}确实是个美人儿。"
# game/Days/prologue.rpy:48
translate chinese prologue_d13d2e29:

    # bill "Though, you said couple, yeah?"
    bill "不过，你说是夫妻，对吧？"

# game/Days/prologue.rpy:49
translate chinese prologue_541f70e1:

    # mc "You know that's never stopped me before, [bill]."
    mc "你知道这从来就拦不住我，[bill]。"

# game/Days/prologue.rpy:50
translate chinese prologue_93616325:

    # bill "Homewrecker with a smile. You're a menace. Next you'll be going after [mina]."
    bill "笑着的家庭破坏者。你可真是个祸害。下一个目标就是[mina]了吧。"

# game/Days/prologue.rpy:51
translate chinese prologue_5d4c81aa:

    # mc "You never know..."
    mc "谁知道呢……"

# game/Days/prologue.rpy:52
translate chinese prologue_a542d642:

    # bill "Careful now... I {i}do{/i} have a shotgun behind the bar."
    bill "小心点……我{i}确实{/i}在吧台后面放了把猎枪。"

# game/Days/prologue.rpy:53
translate chinese prologue_2740fbab:

    # mc "You know I'm joking, [bill]. Chill."
    mc "你知道我在开玩笑，[bill]。放松点。"

# game/Days/prologue.rpy:54
translate chinese prologue_396d96f7:

    # mc "I wouldn't go after your bread and butter."
    mc "我不会打你饭碗的主意。"

# game/Days/prologue.rpy:55
translate chinese prologue_66bfabb1:

    # bill "I'm glad, or else you'll have more than one hole to shit out of."
    bill "那就好，不然你身上就不止一个窟窿眼用来拉屎了。"

# game/Days/prologue.rpy:56
translate chinese prologue_4d50dd55:

    # mc "I hear ya."
    mc "明白。"

# game/Days/prologue.rpy:57
translate chinese prologue_c40f4907:

    # mc "Anyway, we'll see how it goes. New place, new people... new problems."
    mc "总之，看看情况再说吧。新地方，新的人……新的问题。"

# game/Days/prologue.rpy:58
translate chinese prologue_8283f1e2:

    # bill "'Long as you're not bringing them back here with you."
    bill "只要你没把那些人带回来就行。"

# game/Days/prologue.rpy:59
translate chinese prologue_39956e6a:

    # mc "No promises there either."
    mc "这一点我也无法保证。"

# game/Days/prologue.rpy:62
translate chinese prologue_b267ea7c:

    # bill "Hey, I'm just saying. Enjoy your freedom while it lasts. Bar's going under new management soon."
    bill "嘿，我随口说说。趁自由还在，好好珍惜吧。这酒吧很快就要换新东家了。"

# game/Days/prologue.rpy:63
translate chinese prologue_27728edc:

    # mc "No shit?"
    mc "真的假的？"

# game/Days/prologue.rpy:64
translate chinese prologue_96e31e6d:

    # bill "You betcha. Some corporate types. Gonna turn this place into a fancy club or something. Flashy lights. Dancers. Whole nine yards."
    bill "那当然。几个公司的高管，打算把这地方改成什么高档俱乐部之类的：炫目的灯光，舞者，一应俱全。"

# game/Days/prologue.rpy:65
translate chinese prologue_21157e58:

    # mc "Guess next time I come in, I'll need to dress up."
    mc "看来下次我来，得穿正式点了。"

# game/Days/prologue.rpy:66
translate chinese prologue_b6f5495b:

    # bill "Just don't expect a discount for nostalgia."
    bill "别指望能因为怀旧给你打折。"

# game/Days/prologue.rpy:67
translate chinese prologue_88e5451d:

    # mc "Was worth a shot."
    mc "值得一试。"

# game/Days/prologue.rpy:68
translate chinese prologue_47b4c27f:

    # bill "{i}Luckily{/i} I can't see how much of an asshole you are. Just that you {i}are{/i} one."
    bill "{i}好在{/i}我看不出你有多混，只知道你{i}就是{/i}个混蛋。"

# game/Days/prologue.rpy:69
translate chinese prologue_640d5bcf:

    # mc "Hahaha. At least you've got depth perception of character."
    mc "哈哈哈。至少你看人方面挺有洞察力的。"

# game/Days/prologue.rpy:70
translate chinese prologue_57477387:

    # bill "One of us has to."
    bill "我们俩总得有一个人有。"

# game/Days/prologue.rpy:71
translate chinese prologue_d38ca079:

    # "Amongst your boisterous chit-chat at the bar, another pub-goer is in dire need of a stiff drink."
    "你们在吧台旁高谈阔论的同时，另一位酒客正急需一杯烈酒。"

# game/Days/prologue.rpy:72
translate chinese prologue_9fb89a97:

    # "You hear the sharp click of heels as someone approaches the counter."
    "你听见清脆的高跟鞋声，有人朝吧台走来。"

# game/Days/prologue.rpy:73
translate chinese prologue_5a1e1c02:

    # "As she sits, the barstool lets out a soft hiss, barely audible over the hum of music."
    "当她坐下时，高脚凳发出轻微的嘶嘶声，几乎被音乐声淹没。"

# game/Days/prologue.rpy:74
translate chinese prologue_621536e7:

    # "Glancing over, you spot a beautiful woman, dressed to turn heads, and clearly out to enjoy herself."
    "你瞥见一个漂亮女人，打扮得惊艳夺目，显然是出来寻乐子的。"

# game/Days/prologue.rpy:75
translate chinese prologue_aebe6572:

    # __("{color=#ff8af3}Girl{/color}") "Hey, could I get a rum and coke?"
    __("{color=#ff8af3}女孩{/color}") "嘿，能给我一杯朗姆可乐吗？"

# game/Days/prologue.rpy:76
translate chinese prologue_6d9af3b2:

    # "She pauses, then turns slightly, locking eyes with you."
    "她顿了顿，微微侧身，与你四目相对。"

# game/Days/prologue.rpy:77
translate chinese prologue_acf72f06:

    # __("{color=#ff8af3}Girl{/color}") "Hmmm? And one for my new friend here."
    __("{color=#ff8af3}女孩{/color}") "嗯？再给我这位新朋友也来一杯。"

# game/Days/prologue.rpy:78
translate chinese prologue_3e451df7:

    # bill "Two rum and cokes coming right up!"
    bill "两杯朗姆可乐，马上好！"

# game/Days/prologue.rpy:79
translate chinese prologue_2765c72d:

    # mc "Careful, or people might think you're trying to pick me up."
    mc "小心点，不然别人会以为你想泡我呢。"

# game/Days/prologue.rpy:80
translate chinese prologue_ecec3636:

    # __("{color=#ff8af3}Girl{/color}") "And what if I am?"
    __("{color=#ff8af3}女孩{/color}") "那如果是呢？"

# game/Days/prologue.rpy:81
translate chinese prologue_2038dc7d:

    # mc "Then I should be the one buying."
    mc "那应该由我来请客才对。"

# game/Days/prologue.rpy:82
translate chinese prologue_67966b09:

    # "She flashes a slow smile, takes the glass [bill] sets down, and clinks it lightly against yours."
    "她缓缓一笑，接过[bill]放下的杯子，轻轻与你的杯子一碰。"

# game/Days/prologue.rpy:83
translate chinese prologue_7eb5d0c8:

    # __("{color=#ff8af3}Girl{/color}") "Next round's on you then, hot-shot."
    __("{color=#ff8af3}女孩{/color}") "那下一轮你请，帅哥。"

# game/Days/prologue.rpy:84
translate chinese prologue_b780924f:

    # "She tosses a wink over her shoulder as she walks away, hips swaying with intent."
    "她走开时回头抛来一个媚眼，扭着腰，刻意得很。"

# game/Days/prologue.rpy:85
translate chinese prologue_26557fb4:

    # "With a grin, you knock back your shot and stand."
    "你咧嘴一笑，一饮而尽，然后站了起来。"

# game/Days/prologue.rpy:86
translate chinese prologue_29c9ee3c:

    # mc "Well... duty calls."
    mc "好了……该我上岗了。"

# game/Days/prologue.rpy:87
translate chinese prologue_41437c25:

    # bill "Don't break anything."
    bill "别砸了东西。"

# game/Days/prologue.rpy:88
translate chinese prologue_b21541d8:

    # mc "No promises."
    mc "不敢保证。"

translate chinese strings:

    # game/Days/prologue.rpy:75
    old "{color=#ff8af3}Girl{/color}"
    new "{color=#ff8af3}女孩{/color}"

    # game/Days/prologue.rpy:90
    old "{size=+18}...Five Months Later...{/size}"
    new "{size=+18}……五个月后……{/size}"

