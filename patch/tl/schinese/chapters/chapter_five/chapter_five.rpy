translate schinese chapter_five_scene_twenty_thirty_one_C_959e56bd:

    # wi "Understood, your Majesty."
    wi "明白了，陛下。"

# game/chapters/chapter_five/chapter_five.rpy:1902
translate schinese chapter_five_scene_twenty_thirty_one_C_56b455fe:

    # aq "What?! Why?!"
    aq "什么？！为什么？！"

