    # mc "So… how do we begin?"
    mc "那么……怎么开始？"

# game/chapters/chapter_five/chapter_five.rpy:2593
translate schinese chapter_five_scene_twenty_thirty_two_d4b51ae7_1:

    # wi "Let us start with some meditation."
    wi "我们从冥想开始。"

# game/chapters/chapter_five/chapter_five.rpy:2594
translate schinese chapter_five_scene_twenty_thirty_two_4710a494_1:

    # wi "I want you to close your eyes and empty your mind."
    wi "我要你闭上眼睛，清空脑海。"

