    wi "不过更多时候，他会把人送回原来的地方。"

# game/chapters/chapter_five/chapter_five.rpy:2238
translate schinese chapter_five_scene_twenty_thirty_two_190c9171:

    # mc "I see…"
    mc "我明白了……"

# game/chapters/chapter_five/chapter_five.rpy:2239
translate schinese chapter_five_scene_twenty_thirty_two_6ff56d95:

    # mc "So can all Dark Casters open Time Pockets?"
    mc "那么所有暗系施法者都能打开时间口袋吗？"

# game/chapters/chapter_five/chapter_five.rpy:2242
translate schinese chapter_five_scene_twenty_thirty_two_b3b6e313:

    # wi "Yes! Time Pockets are a dimension created by Vela."
    wi "是的！时间口袋是薇拉创造出的一个维度。"

# game/chapters/chapter_five/chapter_five.rpy:2245
translate schinese chapter_five_scene_twenty_thirty_two_1a333054:

    # mc "So it’s passed down to all Dark Casters?"
    mc "所以这能力传承给了所有暗系施法者？"

# game/chapters/chapter_five/chapter_five.rpy:2248
translate schinese chapter_five_scene_twenty_thirty_two_cbd98e85:

    # wi "That would be correct."
    wi "可以这么说。"

# game/chapters/chapter_five/chapter_five.rpy:2249
translate schinese chapter_five_scene_twenty_thirty_two_a2e9499f:

    # wi "Now, follow us."
    wi "现在，跟我们来。"

# game/chapters/chapter_five/chapter_five.rpy:2250
translate schinese chapter_five_scene_twenty_thirty_two_632fc2cf:

    # wi "This is a sacred place."
    wi "这是神圣之地。"

# game/chapters/chapter_five/chapter_five.rpy:2260
translate schinese chapter_five_scene_twenty_thirty_two_6a6f9138:

    # wi "Let us begin."
    wi "我们开始吧。"

# game/chapters/chapter_five/chapter_five.rpy:2263
translate schinese chapter_five_scene_twenty_thirty_two_38f06463:

    # aq "What else did Luminox say?"
    aq "露米诺克斯还说了什么？"

# game/chapters/chapter_five/chapter_five.rpy:2266
translate schinese chapter_five_scene_twenty_thirty_two_1edf1124:

    # aq "I know there were some things you were hiding."
    aq "我知道你有些事瞒着。"

# game/chapters/chapter_five/chapter_five.rpy:2269
translate schinese chapter_five_scene_twenty_thirty_two_5a1005a7:

    # wi "Aqua…"
    wi "阿库娅……"

# game/chapters/chapter_five/chapter_five.rpy:2272
translate schinese chapter_five_scene_twenty_thirty_two_a1090ca2:

    # aq "Best to get straight to it."
    aq "最好直接说。"

# game/chapters/chapter_five/chapter_five.rpy:2275
translate schinese chapter_five_scene_twenty_thirty_two_994ce6f3:

    # mc "She’s right."
    mc "她说得对。"

# game/chapters/chapter_five/chapter_five.rpy:2278
translate schinese chapter_five_scene_twenty_thirty_two_7495f3a5:

    # mc "First thing’s first, she only intended to summon Natasha, Yuki, and Gianna."
    mc "首先，她本来只打算召唤娜塔莎、由纪和吉安娜。"

# game/chapters/chapter_five/chapter_five.rpy:2281
translate schinese chapter_five_scene_twenty_thirty_two_156fb73b:

    # aq "And you?"
    aq "那你呢？"

# game/chapters/chapter_five/chapter_five.rpy:2284
translate schinese chapter_five_scene_twenty_thirty_two_d738b621:

    # mc "Mistake."
    mc "是个错误。"

# game/chapters/chapter_five/chapter_five.rpy:2287
translate schinese chapter_five_scene_twenty_thirty_two_5e93922a:

    # wi "This does explain why they are far more powerful than you are."
    wi "这倒是解释了他们为什么比你强得多。"

# game/chapters/chapter_five/chapter_five.rpy:2288
translate schinese chapter_five_scene_twenty_thirty_two_955170a5:

    # wi "What else?"
    wi "还有呢？"

# game/chapters/chapter_five/chapter_five.rpy:2291
translate schinese chapter_five_scene_twenty_thirty_two_69e0aca2:

    # mc "She did say something about Nat being the chosen one."
    mc "她确实说过娜塔是被选中的人。"

# game/chapters/chapter_five/chapter_five.rpy:2294
translate schinese chapter_five_scene_twenty_thirty_two_4f6f7e80:

    # wi "Chosen one, you say?"
    wi "被选中的人？"

# game/chapters/chapter_five/chapter_five.rpy:2297
translate schinese chapter_five_scene_twenty_thirty_two_f022e06e:

    # mc "Yes, but that’s something she didn’t expand upon."
    mc "是的，但她没有详说。"

# game/chapters/chapter_five/chapter_five.rpy:2300
translate schinese chapter_five_scene_twenty_thirty_two_58992128:

    # aq "Maybe we should train her, too."
    aq "也许我们也该训练她。"

# game/chapters/chapter_five/chapter_five.rpy:2303
translate schinese chapter_five_scene_twenty_thirty_two_c6d26ac7:

    # wi "I agree."
    wi "我同意。"

# game/chapters/chapter_five/chapter_five.rpy:2306
translate schinese chapter_five_scene_twenty_thirty_two_355d1a36:

    # wi "I knew there was more to her."
    wi "我就知道她还有别的门道。"

# game/chapters/chapter_five/chapter_five.rpy:2309
translate schinese chapter_five_scene_twenty_thirty_two_17dfc117:

    # mc "What do you think that might’ve meant?"
    mc "你觉得那可能是什么意思？"

# game/chapters/chapter_five/chapter_five.rpy:2312
translate schinese chapter_five_scene_twenty_thirty_two_a13b99f6:

    # wi "That is something only time will tell."
    wi "那就只有时间能知道了。"

# game/chapters/chapter_five/chapter_five.rpy:2315
translate schinese chapter_five_scene_twenty_thirty_two_f9ce6732:

    # mc "Great. More cryptic answers."
    mc "很好。更多的谜语式回答。"

# game/chapters/chapter_five/chapter_five.rpy:2318
translate schinese chapter_five_scene_twenty_thirty_two_0f3fd9a0:

    # wi "I’m sorry, [playername]… I wish I knew what Luminox’s plans were."
    wi "对不起，[playername]……我真希望我知道露米诺克斯的计划是什么。"

# game/chapters/chapter_five/chapter_five.rpy:2321
translate schinese chapter_five_scene_twenty_thirty_two_f9b8503c:

    # aq "What else did she tell you?"
    aq "她还告诉你什么了？"

# game/chapters/chapter_five/chapter_five.rpy:2324
translate schinese chapter_five_scene_twenty_thirty_two_5f2ba573:

    # mc "She talked about a darkness within me."
    mc "她说我体内有一种黑暗。"

# game/chapters/chapter_five/chapter_five.rpy:2325
translate schinese chapter_five_scene_twenty_thirty_two_6e5be33e:

    # mc "A darkness that could consume me."
    mc "一种会吞噬我的黑暗。"

# game/chapters/chapter_five/chapter_five.rpy:2328
translate schinese chapter_five_scene_twenty_thirty_two_321349a1:

    # wi "Such is the fate of Dark Casters."
    wi "这就是暗系施法者的命运。"

# game/chapters/chapter_five/chapter_five.rpy:2331
translate schinese chapter_five_scene_twenty_thirty_two_7081b869:

    # wi "The mortal mind is very feeble to power."
    wi "凡人的心智对力量而言太过脆弱。"

# game/chapters/chapter_five/chapter_five.rpy:2332
translate schinese chapter_five_scene_twenty_thirty_two_05fb9cdf:

    # wi "And absolute power can corrupt even the purest of souls."
    wi "而绝对的力量连最纯洁的灵魂都能腐化。"

# game/chapters/chapter_five/chapter_five.rpy:2335
translate schinese chapter_five_scene_twenty_thirty_two_d6c9d9c1:

    # mc "Aren’t you the most powerful being in the world right now?"
    mc "你现在不就是世上最强的存在吗？"

# game/chapters/chapter_five/chapter_five.rpy:2338
translate schinese chapter_five_scene_twenty_thirty_two_61880680:

    # wi "No… that would be the Witch of Light."
    wi "不……那应该是光之魔女。"

# game/chapters/chapter_five/chapter_five.rpy:2341
translate schinese chapter_five_scene_twenty_thirty_two_5112c222:

    # aq "But she hasn’t been seen in centuries…"
    aq "但她已经几个世纪没露面了……"

# game/chapters/chapter_five/chapter_five.rpy:2342
translate schinese chapter_five_scene_twenty_thirty_two_e56adc0b:

    # aq "We might as well assume she’s dead."
    aq "我们不妨认为她已经死了。"

# game/chapters/chapter_five/chapter_five.rpy:2345
translate schinese chapter_five_scene_twenty_thirty_two_e5865721:

    # wi "Perhaps…"
    wi "或许吧……"

# game/chapters/chapter_five/chapter_five.rpy:2348
translate schinese chapter_five_scene_twenty_thirty_two_3ab5771b:

    # wi "At any rate, as a witch I am unconcerned about mortal dilemmas."
    wi "总之，作为魔女，我对凡人的困境毫不关心。"

# game/chapters/chapter_five/chapter_five.rpy:2349
translate schinese chapter_five_scene_twenty_thirty_two_cd3bc870:

    # wi "Power is something that comes and goes."
    wi "力量来来去去。"

# game/chapters/chapter_five/chapter_five.rpy:2350
translate schinese chapter_five_scene_twenty_thirty_two_8f9cadc0:

    # wi "Wisdom remains."
    wi "智慧长存。"

# game/chapters/chapter_five/chapter_five.rpy:2353
translate schinese chapter_five_scene_twenty_thirty_two_d2c503bb:

    # aq "Once you live as long as we have, you simply become detached from all that is."
    aq "当你活得像我们这么久，你就会对这一切变得超然。"

# game/chapters/chapter_five/chapter_five.rpy:2356
translate schinese chapter_five_scene_twenty_thirty_two_190c9171_1:

    # mc "I see…"
    mc "我明白了……"

# game/chapters/chapter_five/chapter_five.rpy:2359
translate schinese chapter_five_scene_twenty_thirty_two_70191e0e:

    # mc "So then me being mortal…"
    mc "所以我身为凡人……"

# game/chapters/chapter_five/chapter_five.rpy:2362
translate schinese chapter_five_scene_twenty_thirty_two_101b0a58:

    # wi "Puts you at risk."
    wi "会让你陷入风险。"

# game/chapters/chapter_five/chapter_five.rpy:2364
translate schinese chapter_five_scene_twenty_thirty_two_40263a1b:

    # mc "Mmmm…"
    mc "唔……"

# game/chapters/chapter_five/chapter_five.rpy:2367
translate schinese chapter_five_scene_twenty_thirty_two_3c327cb0:

    # aq "But don’t worry! You are a good man!"
    aq "但别担心！你是个好人！"

# game/chapters/chapter_five/chapter_five.rpy:2368
translate schinese chapter_five_scene_twenty_thirty_two_c7e1fd87:

    # aq "Just be mindful of your attachments."
    aq "只要留意你的牵绊就好。"

# game/chapters/chapter_five/chapter_five.rpy:2371
translate schinese chapter_five_scene_twenty_thirty_two_f020ce7a:

    # mc "Oh, come on…"
    mc "得了吧……"

# game/chapters/chapter_five/chapter_five.rpy:2374
translate schinese chapter_five_scene_twenty_thirty_two_711cd0b0:

    # aq "What?"
    aq "什么？"

# game/chapters/chapter_five/chapter_five.rpy:2377
translate schinese chapter_five_scene_twenty_thirty_two_57f47ef0:

    # mc "Man fuck the Jedi."
    mc "老兄，去他的绝地武士。"

# game/chapters/chapter_five/chapter_five.rpy:2378
translate schinese chapter_five_scene_twenty_thirty_two_7c711846:

    # mc "I swear, the whole bit of no attachments is so stupid to me."
    mc "我发誓，那套\"不能有牵绊\"的说辞在我听来蠢透了。"

# game/chapters/chapter_five/chapter_five.rpy:2381
translate schinese chapter_five_scene_twenty_thirty_two_1187a010:

    # wi "What are you talking about?"
    wi "你在说什么？"

# game/chapters/chapter_five/chapter_five.rpy:2382
translate schinese chapter_five_scene_twenty_thirty_two_bcbe6146:

    # wi "Attachments aren’t bad."
    wi "牵绊不是坏事。"

# game/chapters/chapter_five/chapter_five.rpy:2383
translate schinese chapter_five_scene_twenty_thirty_two_7de5e1df:

    # wi "If anything, witchhood encourages them."
    wi "恰恰相反，魔女之道是鼓励牵绊的。"

# game/chapters/chapter_five/chapter_five.rpy:2386
translate schinese chapter_five_scene_twenty_thirty_two_d06e0391:

    # aq "You simply need to learn when to let go."
    aq "你只需要学会何时放手。"

# game/chapters/chapter_five/chapter_five.rpy:2387
translate schinese chapter_five_scene_twenty_thirty_two_1036faea:

    # aq "Getting too attached can lead to…"
    aq "太过执着可能导致……"

# game/chapters/chapter_five/chapter_five.rpy:2390
translate schinese chapter_five_scene_twenty_thirty_two_a15557cb:

    # mc "The events of the Circle of Eden?"
    mc "伊甸之环的那场变故？"

# game/chapters/chapter_five/chapter_five.rpy:2393
translate schinese chapter_five_scene_twenty_thirty_two_cb014812:

    # wi "Indeed."
    wi "正是。"

# game/chapters/chapter_five/chapter_five.rpy:2396
translate schinese chapter_five_scene_twenty_thirty_two_ec268f14:

    # wi "That said, you need to keep your priorities straight."
    wi "话虽如此，你必须分清主次。"

# game/chapters/chapter_five/chapter_five.rpy:2397
translate schinese chapter_five_scene_twenty_thirty_two_de9cca7d:

    # wi "Lest you are to become like the Celestiarch of Light."
    wi "别让自己变得像光之天枢一样。"

# game/chapters/chapter_five/chapter_five.rpy:2400
translate schinese chapter_five_scene_twenty_thirty_two_2c562e24:

    # mc "Ailana?"
    mc "艾拉娜？"

# game/chapters/chapter_five/chapter_five.rpy:2403
translate schinese chapter_five_scene_twenty_thirty_two_894595aa:

    # aq "You know her!?"
    aq "你认识她！？"

# game/chapters/chapter_five/chapter_five.rpy:2405
translate schinese chapter_five_scene_twenty_thirty_two_99f5d190:

    # mc "I’ve met her! She seems like a great person."
    mc "我见过！她看起来是个很棒的人。"

# game/chapters/chapter_five/chapter_five.rpy:2406
translate schinese chapter_five_scene_twenty_thirty_two_787786ca:

    # mc "I don’t think her story is all that bad, though."
    mc "不过我觉得她的故事也没那么糟。"

# game/chapters/chapter_five/chapter_five.rpy:2409
translate schinese chapter_five_scene_twenty_thirty_two_81998da9:

    # wi "You don’t?"
    wi "你不这么认为？"

# game/chapters/chapter_five/chapter_five.rpy:2412
translate schinese chapter_five_scene_twenty_thirty_two_7adcf5ac:

    # mc "I think sacrificing everything for love just… makes sense."
    mc "我觉得为爱牺牲一切……挺合理的。"

# game/chapters/chapter_five/chapter_five.rpy:2415
translate schinese chapter_five_scene_twenty_thirty_two_4a56980c:

    # aq "Your harem is very lucky."
    aq "你的后宫很幸运。"

# game/chapters/chapter_five/chapter_five.rpy:2418
translate schinese chapter_five_scene_twenty_thirty_two_c9b564f5:

    # wi "As much as I agree with you, making a deal with a Nexian is just…"
    wi "我虽然同意你，但和涅克西安做交易终究是……"

# game/chapters/chapter_five/chapter_five.rpy:2421
translate schinese chapter_five_scene_twenty_thirty_two_4909b00d:

    # wi "Dangerous."
    wi "很危险。"

# game/chapters/chapter_five/chapter_five.rpy:2424
translate schinese chapter_five_scene_twenty_thirty_two_d79b90ee:

    # mc "Nexian?"
    mc "涅克西安？"

# game/chapters/chapter_five/chapter_five.rpy:2425
translate schinese chapter_five_scene_twenty_thirty_two_be6fba95:

    # mc "You know what, can you explain the whole theology of this place?"
    mc "这样吧，你能把这个地方的神学讲一遍吗？"

# game/chapters/chapter_five/chapter_five.rpy:2428
translate schinese chapter_five_scene_twenty_thirty_two_7b1f0e41:

    # wi "Do you want the long version or the short version?"
    wi "你想听长版还是短版？"

# game/chapters/chapter_five/chapter_five.rpy:2434
translate schinese chapter_five_scene_twenty_thirty_two_7b4a7dac:

    # wi "You have Luminox on top."
    wi "长版是：最上面是露米诺克斯。"

# game/chapters/chapter_five/chapter_five.rpy:2435
translate schinese chapter_five_scene_twenty_thirty_two_30d7328a:

    # wi "Six Celestiarchs, one for each type of Spiritual Energy."
    wi "六位天枢，每种灵力属性各一位。"

# game/chapters/chapter_five/chapter_five.rpy:2436
translate schinese chapter_five_scene_twenty_thirty_two_023c4f65:

    # wi "People that ascend as gods are known as Divinarchs."
    wi "飞升成神的人被称为天枢。"

# game/chapters/chapter_five/chapter_five.rpy:2437
translate schinese chapter_five_scene_twenty_thirty_two_1cc4705d:

    # wi "Finally, you have Nexians, rulers of the underworld."
    wi "最后是涅克西安，冥界的统治者。"

# game/chapters/chapter_five/chapter_five.rpy:2438
translate schinese chapter_five_scene_twenty_thirty_two_eea47d9b:

    # wi "Ailana, the Celestiarch of Light, made a deal with a Nexian named Solstice."
    wi "光之天枢艾拉娜曾与一位名叫索尔斯蒂斯的涅克西安做了交易。"

# game/chapters/chapter_five/chapter_five.rpy:2439
translate schinese chapter_five_scene_twenty_thirty_two_f168c22f:

    # wi "Solstice is known as the Nexian of Knowledge, but she is not to be trifled with."
    wi "索尔斯蒂斯被称为知识之涅克西安，但绝不是好惹的角色。"

# game/chapters/chapter_five/chapter_five.rpy:2445
translate schinese chapter_five_scene_twenty_thirty_two_602c7752:

    # wi "Let us begin with the Creation of Eden, then."
    wi "那就从伊甸的创世开始讲吧。"

# game/chapters/chapter_five/chapter_five.rpy:2452
translate schinese chapter_five_scene_twenty_thirty_two_5c9aeb67:

    # wi "In the beginning, the world was but a seed."
    wi "起初，世界只是一颗种子。"

# game/chapters/chapter_five/chapter_five.rpy:2453
translate schinese chapter_five_scene_twenty_thirty_two_3a5c0dc1:

    # wi "From that seed, the Tree of Eden was born."
    wi "从那颗种子里，生出了伊甸之树。"

# game/chapters/chapter_five/chapter_five.rpy:2454
translate schinese chapter_five_scene_twenty_thirty_two_84c9d8db:

    # wi "And thus, Luminox began crafting the world around it."
    wi "于是，露米诺克斯开始围绕它塑造这个世界。"

# game/chapters/chapter_five/chapter_five.rpy:2457
translate schinese chapter_five_scene_twenty_thirty_two_8fc2a986:

    # aq "At first, she created the Four Divinarchs to craft each element needed in the world."
    aq "最初，她创造了四位天枢，各自塑造世界所需的元素。"

# game/chapters/chapter_five/chapter_five.rpy:2458
translate schinese chapter_five_scene_twenty_thirty_two_4e498560:

    # aq "Fire, Air, Wind, and Nature."
    aq "火、风、气与自然。"

# game/chapters/chapter_five/chapter_five.rpy:2459
translate schinese chapter_five_scene_twenty_thirty_two_64d002b9:

    # aq "Together, the Four made the world we live in."
    aq "四位一起造就了我们所生活的世界。"

# game/chapters/chapter_five/chapter_five.rpy:2462
translate schinese chapter_five_scene_twenty_thirty_two_63214b1b:

    # wi "But then, Luminox felt like something was missing."
    wi "但后来，露米诺克斯觉得少了点什么。"

# game/chapters/chapter_five/chapter_five.rpy:2463
translate schinese chapter_five_scene_twenty_thirty_two_90d3beaf:

    # wi "She truly loved her creation, but she wanted more."
    wi "她深深爱着自己的造物，但她想要更多。"

# game/chapters/chapter_five/chapter_five.rpy:2466
translate schinese chapter_five_scene_twenty_thirty_two_8c3397f0:

    # mc "Someone to share it with?"
    mc "想有人与她分享？"

# game/chapters/chapter_five/chapter_five.rpy:2469
translate schinese chapter_five_scene_twenty_thirty_two_65ea9d6a:

    # wi "Correct."
    wi "正是。"

# game/chapters/chapter_five/chapter_five.rpy:2470
translate schinese chapter_five_scene_twenty_thirty_two_b5d6b58d:

    # wi "Thus the Celestiarchs of Light and Darkness were born."
    wi "于是光之天枢与暗之天枢诞生了。"

# game/chapters/chapter_five/chapter_five.rpy:2471
translate schinese chapter_five_scene_twenty_thirty_two_445e60e7:

    # wi "The Celestiarch of Light was the one who brought life to the world."
    wi "光之天枢为世界带来了生命。"

# game/chapters/chapter_five/chapter_five.rpy:2472
translate schinese chapter_five_scene_twenty_thirty_two_6aafb8d2:

    # wi "Whereas the Celestiarch of Darkness brought death."
    wi "而暗之天枢带来了死亡。"

# game/chapters/chapter_five/chapter_five.rpy:2475
translate schinese chapter_five_scene_twenty_thirty_two_f8c55353:

    # aq "Ailana and Nebulys."
    aq "艾拉娜和涅布利斯。"

# game/chapters/chapter_five/chapter_five.rpy:2478
translate schinese chapter_five_scene_twenty_thirty_two_aa0dd972:

    # wi "As the two joined the stage, life as we know it was eventually born."
