    mc "不……"

# game/chapters/chapter_five/chapter_five.rpy:2608
translate schinese chapter_five_scene_twenty_thirty_two_8d1c80ad_1:

    # mc "No!"
    mc "不！"

# game/chapters/chapter_five/chapter_five.rpy:2610
translate schinese chapter_five_scene_twenty_thirty_two_7fad2da1_1:

    # mc "NO!!!!"
    mc "不要！！！！"

# game/chapters/chapter_five/chapter_five.rpy:2612
translate schinese chapter_five_scene_twenty_thirty_two_3601d828_1:

    # mc "Y-YUKI!"
    mc "由、由纪！"

