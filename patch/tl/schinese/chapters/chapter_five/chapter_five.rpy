    # mc "She promised that none in our party shall perish as long as we are on the right path."
    mc "她保证只要我们走在正确的路上，队伍中就不会有人丧命。"

# game/chapters/chapter_five/chapter_five.rpy:2562
translate schinese chapter_five_scene_twenty_thirty_two_ec5a5a5c_1:

    # wi "That is very relieving to hear."
    wi "听到这个真是让人松了口气。"

# game/chapters/chapter_five/chapter_five.rpy:2563
translate schinese chapter_five_scene_twenty_thirty_two_996acdcd_1:

    # wi "All must be going according to plan."
    wi "一切一定都在按计划进行。"

# game/chapters/chapter_five/chapter_five.rpy:2566
translate schinese chapter_five_scene_twenty_thirty_two_d4dafa05_1:

    # mc "We are unclear about how we’ll remain on the right path."
    mc "可我们并不清楚要如何才能不偏离正确的路。"

# game/chapters/chapter_five/chapter_five.rpy:2567
translate schinese chapter_five_scene_twenty_thirty_two_bc6ccff8_1:

    # mc "All she said was to trust in her and that everything would be done according to her will."
    mc "她只说让我们相信她，一切都会按她的意志完成。"

# game/chapters/chapter_five/chapter_five.rpy:2570
translate schinese chapter_five_scene_twenty_thirty_two_a527a92c_1:

    # aq "Such is the way of Luminox."
    aq "这就是露米诺克斯的方式。"

# game/chapters/chapter_five/chapter_five.rpy:2573
translate schinese chapter_five_scene_twenty_thirty_two_7d81de88_1:

    # aq "Fortunately, this is not the first time the world has been in crisis."
    aq "好在这不是世界第一次陷入危机。"

# game/chapters/chapter_five/chapter_five.rpy:2574
translate schinese chapter_five_scene_twenty_thirty_two_9f963408_1:

    # aq "Unfortunately, it will not be the last."
    aq "可惜也不会是最后一次。"

# game/chapters/chapter_five/chapter_five.rpy:2577
translate schinese chapter_five_scene_twenty_thirty_two_eb8cb48f_1:

    # mc "As long as you’re around, that should not be an issue, right?"
    mc "有你在，应该不成问题，对吧？"

# game/chapters/chapter_five/chapter_five.rpy:2580
translate schinese chapter_five_scene_twenty_thirty_two_a68c1574_1:

    # wi "You got that right."
    wi "你说到点子上了。"

# game/chapters/chapter_five/chapter_five.rpy:2581
translate schinese chapter_five_scene_twenty_thirty_two_c83ce13c_1:

    # wi "Now, shall we work on your Dark Spiritual Energy?"
    wi "现在，我们来修炼你的黑暗灵力吧？"

# game/chapters/chapter_five/chapter_five.rpy:2584
translate schinese chapter_five_scene_twenty_thirty_two_635d0ec1_1:

    # mc "Ladies, let’s get to it."
    mc "两位女士，开始吧。"

