translate schinese chapter_five_scene_twenty_thirty_one_C_cb713814:

    # mc "You build up an army in case there’s an uprising, as well as to set chase for us…"
    mc "他扩建军队以防起义，同时也可以用来追杀我们……"

# game/chapters/chapter_five/chapter_five.rpy:1936
translate schinese chapter_five_scene_twenty_thirty_one_C_efa416b8:

    # mc "But this would give him the highest odds of a smooth transition to power."
    mc "但这样他和平掌权的概率最高。"

# game/chapters/chapter_five/chapter_five.rpy:1937
translate schinese chapter_five_scene_twenty_thirty_one_C_286c6885:

    # mc "Then by controlling the Priestesses, you can get the people to follow you because religion says so."
    mc "然后通过控制女祭司，让民众因为宗教教条而追随你。"

