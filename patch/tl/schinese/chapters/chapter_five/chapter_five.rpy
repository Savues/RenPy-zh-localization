translate schinese chapter_five_scene_twenty_thirty_one_C_8b2ea70a:

    # rav "N-no! I-it’s okay, Aqua… I was just worried."
    rav "不、不！没、没关系，阿库娅……我只是担心。"

# game/chapters/chapter_five/chapter_five.rpy:1921
translate schinese chapter_five_scene_twenty_thirty_one_C_e9c77690:

    # rav "I truly appreciate all you have done for me."
    rav "我真心感谢你为我做的一切。"

