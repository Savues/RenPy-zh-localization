    # rav "What?"
    rav "什么？"

# game/chapters/chapter_five/chapter_five.rpy:6690
translate schinese chapter_five_scene_forty_0a4cd91e:

    # yu "Did you figure something out?"
    yu "你想明白什么了？"

# game/chapters/chapter_five/chapter_five.rpy:6693
translate schinese chapter_five_scene_forty_2437049a:

    # gi "Yeah, they’re clear."
    gi "嗯，她们没事。"

