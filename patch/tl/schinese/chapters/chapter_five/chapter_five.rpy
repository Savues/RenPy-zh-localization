    # wi "Luminox’s Realm is more reserved to those that led truly extraordinary lives."
    wi "露米诺克斯的国度则保留给那些真正活得出类拔萃的人。"

# game/chapters/chapter_five/chapter_five.rpy:2521
translate schinese chapter_five_scene_twenty_thirty_two_d05f831c_1:

    # mc "Like Vela."
    mc "比如薇拉。"

# game/chapters/chapter_five/chapter_five.rpy:2524
translate schinese chapter_five_scene_twenty_thirty_two_54341ab0_1:

    # aq "Her sacrifice is what allowed her to Ascend."
    aq "正是她的牺牲让她得以飞升。"

# game/chapters/chapter_five/chapter_five.rpy:2527
translate schinese chapter_five_scene_twenty_thirty_two_4ceb2e69_1:

    # mc "And you said you two are not interested in that?"
    mc "而你说你不感兴趣？"

# game/chapters/chapter_five/chapter_five.rpy:2530
translate schinese chapter_five_scene_twenty_thirty_two_e9cb9241_1:

    # wi "Not at all."
    wi "完全不感兴趣。"

# game/chapters/chapter_five/chapter_five.rpy:2532
translate schinese chapter_five_scene_twenty_thirty_two_dcbf1fa5_1:

    # aq "I mean, it would be cool but not necessarily the reason why we became witches."
    aq "我是说，那当然很酷，但未必是我们成为魔女的原因。"

# game/chapters/chapter_five/chapter_five.rpy:2533
translate schinese chapter_five_scene_twenty_thirty_two_b103ba8a_1:

    # aq "Being in tune with Luminox is reward enough."
    aq "能与露米诺克斯同调，本身就是最好的回报。"

# game/chapters/chapter_five/chapter_five.rpy:2536
translate schinese chapter_five_scene_twenty_thirty_two_376ca817_1:

    # mc "Tell me more about the Nexians, then."
    mc "那再多讲讲涅克西安吧。"

# game/chapters/chapter_five/chapter_five.rpy:2537
translate schinese chapter_five_scene_twenty_thirty_two_d3bd7353_1:

    # mc "You mentioned Ailana made a deal with one of them?"
    mc "你提到艾拉娜和其中一位做了交易？"

# game/chapters/chapter_five/chapter_five.rpy:2540
translate schinese chapter_five_scene_twenty_thirty_two_125347a6_1:

    # wi "Solstice."
    wi "索尔斯蒂斯。"

# game/chapters/chapter_five/chapter_five.rpy:2541
translate schinese chapter_five_scene_twenty_thirty_two_d9612ed5_1:

    # wi "Every Nexian has a purpose."
    wi "每位涅克西安都有各自的职司。"

# game/chapters/chapter_five/chapter_five.rpy:2542
translate schinese chapter_five_scene_twenty_thirty_two_19ba629a_1:

    # wi "Solstice is the Guardian of Knowledge."
    wi "索尔斯蒂斯是知识的守护者。"

