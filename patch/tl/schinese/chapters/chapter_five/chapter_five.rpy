translate schinese chapter_five_scene_forty_cd1fba63:

    # gi "No need to worry."
    gi "不用担心。"

# game/chapters/chapter_five/chapter_five.rpy:6695
translate schinese chapter_five_scene_forty_e4fca8d8:

    # gi "Anyway, I need to accompany Natasha today."
    gi "总之，今天我要陪娜塔莎一起去。"

# game/chapters/chapter_five/chapter_five.rpy:6698
translate schinese chapter_five_scene_forty_5d40a397:

    # rav "That’s works, Yuki and [playername] will be coming with me to get briefed on their mission."
    rav "行，由纪和 [playername] 会跟我一起去听任务说明。"

# game/chapters/chapter_five/chapter_five.rpy:6701
translate schinese chapter_five_scene_forty_475f36bd:

    # yu "Yes, we need to get moving as soon as possible."
    yu "好的，我们得尽快出发。"

# game/chapters/chapter_five/chapter_five.rpy:6704
translate schinese chapter_five_scene_forty_267fec95:

    # mc "Glad we’re not wasting any time."
    mc "太好了，没有浪费时间。"

# game/chapters/chapter_five/chapter_five.rpy:6707
translate schinese chapter_five_scene_forty_8fff5050:

    # rav "Indeed, so go get changed, I’ll wait for you all out front."
    rav "那就去换衣服吧，我在前面等你们。"

# game/chapters/chapter_five/chapter_five.rpy:6710
translate schinese chapter_five_scene_forty_73ac8d6a:

    # mc "Nat? Got a sec?"
    mc "娜塔？借一步说话？"

# game/chapters/chapter_five/chapter_five.rpy:6713
translate schinese chapter_five_scene_forty_2b73d13a:

    # na "Yeah, what’s up?"
    na "嗯，什么事？"

# game/chapters/chapter_five/chapter_five.rpy:6720
translate schinese chapter_five_scene_forty_a8cede89:

    # mc "Just wanted to say goodbye."
    mc "就是想说声再见。"

# game/chapters/chapter_five/chapter_five.rpy:6723
translate schinese chapter_five_scene_forty_1ee7bdfd:

    # na "Look at you being all suave now."
    na "瞧瞧你，现在多会说话了。"

# game/chapters/chapter_five/chapter_five.rpy:6724
translate schinese chapter_five_scene_forty_94fba057:

    # na "Stay safe, okay?"
    na "小心点，好吗？"

# game/chapters/chapter_five/chapter_five.rpy:6725
translate schinese chapter_five_scene_forty_20993c91:

    # na "And don’t cast too many spells."
    na "还有，别施太多法术。"

# game/chapters/chapter_five/chapter_five.rpy:6728
translate schinese chapter_five_scene_forty_2f35de29:

    # mc "Don’t worry, I’m going with Yuki."
    mc "放心，有由纪陪着我。"

# game/chapters/chapter_five/chapter_five.rpy:6731
translate schinese chapter_five_scene_forty_692c7aae:

    # na "You better treat her well or so help me Luminox."
    na "你最好对她好一点，不然我以露米诺克斯的名义发誓。"

# game/chapters/chapter_five/chapter_five.rpy:6732
translate schinese chapter_five_scene_forty_60f1497f:

    # na "I’ll make you feel the wrath of a latina girlfriend."
    na "我会让你见识一下拉丁裔女朋友的怒火。"

# game/chapters/chapter_five/chapter_five.rpy:6735
translate schinese chapter_five_scene_forty_ef8835b4:

    # mc "*Shivers* Why did that activate my fight or flight instinct?"
    mc "*打了个寒颤*为什么这话让我本能地想逃跑？"

# game/chapters/chapter_five/chapter_five.rpy:6738
translate schinese chapter_five_scene_forty_1e7ee2dd:

    # na "*Laughs* Yeah, yeah. Don’t keep our queen waiting."
    na "*笑*好好好，别让我们的女王久等。"

# game/chapters/chapter_five/chapter_five.rpy:6745
translate schinese chapter_five_scene_forty_d9670093:

    # rav "Your Majesty, we’re back."
    rav "陛下，我们回来了。"

# game/chapters/chapter_five/chapter_five.rpy:6749
translate schinese chapter_five_scene_forty_ee2f7c05:

    # qh "Good, thank you for meeting with me."
    qh "很好，感谢你们来见我。"

# game/chapters/chapter_five/chapter_five.rpy:6752
translate schinese chapter_five_scene_forty_0be1ac15:

    # qh "My healers tell me you helped them quite a bit yesterday, [playername]."
    qh "我的治疗师告诉我，你昨天帮了他们不少忙，[playername]。"

# game/chapters/chapter_five/chapter_five.rpy:6753
translate schinese chapter_five_scene_forty_203eeac3:

    # qh "For that, you have my thanks."
    qh "为此，我要谢谢你。"

# game/chapters/chapter_five/chapter_five.rpy:6756
translate schinese chapter_five_scene_forty_6e193fc1:

    # mc "I was simply acting on behalf of her Majesty."
    mc "我只是代陛下行事。"

# game/chapters/chapter_five/chapter_five.rpy:6759
translate schinese chapter_five_scene_forty_7925eccd:

    # qh "You’re a lucky woman, Celeste."
    qh "你真是个幸运的女人，塞莱斯特。"

# game/chapters/chapter_five/chapter_five.rpy:6762
translate schinese chapter_five_scene_forty_0773ec3f:

    # rav "Luminox has really blessed me."
    rav "露米诺克斯真的很眷顾我。"

# game/chapters/chapter_five/chapter_five.rpy:6765
translate schinese chapter_five_scene_forty_fbadffb8:

    # rav "Now, about the mission…"
    rav "那么，说说这次任务……"

# game/chapters/chapter_five/chapter_five.rpy:6768
translate schinese chapter_five_scene_forty_21f3d49a:

    # qh "Yes, this is critical for the safety of my kingdom."
    qh "是的，这事关我的王国安危。"

# game/chapters/chapter_five/chapter_five.rpy:6771
translate schinese chapter_five_scene_forty_3780a918:

    # qh "There is a band of ruffians known as Takedo and Company that live around a day’s walk away."
    qh "走一天路程的地方住着一伙自称\"武户一伙\"的混混。"

# game/chapters/chapter_five/chapter_five.rpy:6772
translate schinese chapter_five_scene_forty_5b9d8083:

    # qh "Your mission is to infiltrate Takedo’s castle and subdue him."
    qh "你们的任务是潜入武户的城堡，制服他。"

# game/chapters/chapter_five/chapter_five.rpy:6775
translate schinese chapter_five_scene_forty_681a591b:

    # yu "You don’t want us to assassinate him?"
    yu "您不想让我们直接刺杀他？"

# game/chapters/chapter_five/chapter_five.rpy:6778
translate schinese chapter_five_scene_forty_8b3a99b7:

    # qh "No, no. I need him alive."
    qh "不，不。我需要他活着。"

# game/chapters/chapter_five/chapter_five.rpy:6779
translate schinese chapter_five_scene_forty_39903010:

    # qh "You must take control of his castle and force him to come to Ryosei out of his own volition."
    qh "你们必须夺取他的城堡，让他心甘情愿地来凉星。"

# game/chapters/chapter_five/chapter_five.rpy:6782
translate schinese chapter_five_scene_forty_9691d188:

    # mc "What happened between you? I thought Ryosei was unified?"
    mc "你们之间发生了什么？我还以为凉星已经统一了？"

# game/chapters/chapter_five/chapter_five.rpy:6785
translate schinese chapter_five_scene_forty_62b5be18:

    # qh "It is, Takedo and I simply do not see eye-to-eye in many things."
    qh "是统一的，只是我和武户在很多事上意见不合。"

# game/chapters/chapter_five/chapter_five.rpy:6788
translate schinese chapter_five_scene_forty_50839657:

    # yu "How many targets are there in his keep?"
    yu "他的据点里有多少个目标？"

# game/chapters/chapter_five/chapter_five.rpy:6791
translate schinese chapter_five_scene_forty_3822e8cf:

    # qh "Five, including Takedo."
    qh "五个，包括武户本人。"

# game/chapters/chapter_five/chapter_five.rpy:6794
translate schinese chapter_five_scene_forty_4141dfe4:

    # yu "So why not send your army?"
    yu "那为什么不派军队去？"

# game/chapters/chapter_five/chapter_five.rpy:6797
translate schinese chapter_five_scene_forty_9d6d1792:

    # mc "Doing so might seem like she’s a tyrant."
    mc "那样做会显得我很像个暴君。"

# game/chapters/chapter_five/chapter_five.rpy:6800
translate schinese chapter_five_scene_forty_073bbe87:

    # qh "Precisely."
    qh "正是。"

# game/chapters/chapter_five/chapter_five.rpy:6801
translate schinese chapter_five_scene_forty_3a4eadd8:

    # qh "Which is why I want you to bring him."
    qh "所以我才希望你们把他带来。"

# game/chapters/chapter_five/chapter_five.rpy:6804
translate schinese chapter_five_scene_forty_28f7a9f2:

    # rav "Having him by our side might increase our odds."
    rav "让他站到我们这边，胜算会大一些。"

# game/chapters/chapter_five/chapter_five.rpy:6805
translate schinese chapter_five_scene_forty_acd77988:

    # rav "I’ve heard tales about them."
    rav "我听说过他们的传闻。"

# game/chapters/chapter_five/chapter_five.rpy:6808
translate schinese chapter_five_scene_forty_8a504601:

    # rav "Did they not kill Wedpusi?"
    rav "他们不是杀了温普西吗？"

# game/chapters/chapter_five/chapter_five.rpy:6811
translate schinese chapter_five_scene_forty_708d3600:

    # qh "They’re the main reason I was able to unify these lands."
    qh "他们正是我得以统一这片土地的主要原因。"

# game/chapters/chapter_five/chapter_five.rpy:6812
translate schinese chapter_five_scene_forty_e4b064cd:

    # qh "So please, I request your aid on this mission."
    qh "所以，请你们在这次任务中助我一臂之力。"

# game/chapters/chapter_five/chapter_five.rpy:6813
translate schinese chapter_five_scene_forty_18e15c44:

    # qh "I will be eternally in your debt."
    qh "我将永远欠你们的人情。"

# game/chapters/chapter_five/chapter_five.rpy:6816
translate schinese chapter_five_scene_forty_ef45086e:

    # mc "Your wish is our command, your Majesty."
    mc "谨遵您的吩咐，陛下。"

# game/chapters/chapter_five/chapter_five.rpy:6817
translate schinese chapter_five_scene_forty_bc562119:

    # mc "Now… what’s the plan?"
    mc "那么……计划是什么？"

# game/chapters/chapter_five/chapter_five.rpy:6820
translate schinese chapter_five_scene_forty_8f39fb1c:

    # qh "His fortress is practically impenetrable."
    qh "他的要塞几乎不可能攻破。"

# game/chapters/chapter_five/chapter_five.rpy:6821
translate schinese chapter_five_scene_forty_34caa1ee:

    # qh "High walls, a moat, and that’s not even the worst part."
    qh "高墙、护城河，而这还都不是最麻烦的。"

# game/chapters/chapter_five/chapter_five.rpy:6824
translate schinese chapter_five_scene_forty_58f2daf6:

    # qh "The real danger lies within."
    qh "真正的危险在里面。"

# game/chapters/chapter_five/chapter_five.rpy:6825
translate schinese chapter_five_scene_forty_88e2daf4:

    # qh "Takedo and his companions are Ryosei’s fiercest warriors."
    qh "武户和他的同伴是凉星最强的战士。"

# game/chapters/chapter_five/chapter_five.rpy:6828
translate schinese chapter_five_scene_forty_c0575ac1:

    # qh "You must approach them with utmost caution."
    qh "你们必须万分谨慎地接近他们。"

# game/chapters/chapter_five/chapter_five.rpy:6829
translate schinese chapter_five_scene_forty_866e5fc1:

    # qh "Your entry point will be from the south. Takedo’s castle has a secret tunnel in case they need to escape."
    qh "你们要从南边进入。武户的城堡有一条密道，以备逃跑之用。"

# game/chapters/chapter_five/chapter_five.rpy:6832
translate schinese chapter_five_scene_forty_394a9575:

    # yu "If we go in at night, there shouldn’t be much of an issue."
    yu "如果是夜里进去，应该不会有问题。"

# game/chapters/chapter_five/chapter_five.rpy:6835
translate schinese chapter_five_scene_forty_01ad0adf:

    # rav "What if they get captured, Hinata?"
    rav "如果她们被抓住了呢，日向？"

# game/chapters/chapter_five/chapter_five.rpy:6838
translate schinese chapter_five_scene_forty_134ae57e:

    # qh "Then I will go to negotiate with them there."
    qh "那我就亲自去和她们谈判。"

# game/chapters/chapter_five/chapter_five.rpy:6841
translate schinese chapter_five_scene_forty_7c594bbb:

    # mc "Why aren’t we doing that in the first place?"
    mc "那为什么不干脆一开始就这么做？"

# game/chapters/chapter_five/chapter_five.rpy:6844
translate schinese chapter_five_scene_forty_3c999ed5:

    # qh "I cannot appear to be desperate."
    qh "我不能显得如此急切。"

# game/chapters/chapter_five/chapter_five.rpy:6847
translate schinese chapter_five_scene_forty_1c597f77:

    # mc "Hmmm… fine."
    mc "唔……好吧。"

# game/chapters/chapter_five/chapter_five.rpy:6850
translate schinese chapter_five_scene_forty_9e6bda4a:

    # rav "You don’t seem convinced."
    rav "你好像不太信服。"

# game/chapters/chapter_five/chapter_five.rpy:6853
translate schinese chapter_five_scene_forty_8c5abad5:

    # mc "I’m not."
    mc "我确实不信。"

# game/chapters/chapter_five/chapter_five.rpy:6856
translate schinese chapter_five_scene_forty_a3d710ac:

    # mc "When we succeed, I want your word that you will stand with us."
    mc "等我们成功了，你要答应站在我们这边。"

# game/chapters/chapter_five/chapter_five.rpy:6859
translate schinese chapter_five_scene_forty_47e7ae15:

    # qh "You have it."
    qh "我答应你。"

# game/chapters/chapter_five/chapter_five.rpy:6862
translate schinese chapter_five_scene_forty_8bfba041:

    # mc "Anything else, your Majesty?"
    mc "还有别的事吗，陛下？"

# game/chapters/chapter_five/chapter_five.rpy:6865
translate schinese chapter_five_scene_forty_36bf7d42:

    # qh "You must avoid fighting them at all cost."
    qh "你们必须不惜一切代价避免和他们交手。"

# game/chapters/chapter_five/chapter_five.rpy:6866
translate schinese chapter_five_scene_forty_59f6ce3e:

    # qh "They are far too powerful and even more valuable to our cause."
    qh "他们太强了，而且对我们的事业来说更加宝贵。"

# game/chapters/chapter_five/chapter_five.rpy:6869
translate schinese chapter_five_scene_forty_9da6f50d:

    # mc "Yes m'am."
    mc "是，长官。"

# game/chapters/chapter_five/chapter_five.rpy:6872
translate schinese chapter_five_scene_forty_89a67ef5:

    # mc "Yuki, ready?"
    mc "由纪，准备好了吗？"

# game/chapters/chapter_five/chapter_five.rpy:6875
translate schinese chapter_five_scene_forty_804953a2:

    # yu "Let’s make haste."
    yu "我们快走吧。"

# game/chapters/chapter_five/chapter_five.rpy:6876
translate schinese chapter_five_scene_forty_33b55d86:

    # yu "We must get there at sunset."
    yu "我们必须日落前赶到。"

# game/chapters/chapter_five/chapter_five.rpy:6879
translate schinese chapter_five_scene_forty_1eb36601:

    # qh "Off you go, then."
    qh "那就出发吧。"

# game/chapters/chapter_five/chapter_five.rpy:6885
translate schinese chapter_five_scene_forty_31828b53:

    # mc "*Sighs*"
    mc "*叹气*"

# game/chapters/chapter_five/chapter_five.rpy:6888
translate schinese chapter_five_scene_forty_d889f1a8:

    # rav "What’s wrong?"
    rav "怎么了？"

# game/chapters/chapter_five/chapter_five.rpy:6891
translate schinese chapter_five_scene_forty_f48c7d21:

    # mc "Nothing."
    mc "没什么。"

# game/chapters/chapter_five/chapter_five.rpy:6894
translate schinese chapter_five_scene_forty_b51346d1:

    # rav "No, that was definitely a stressed sigh."
    rav "不，那绝对是焦虑的叹息。"

# game/chapters/chapter_five/chapter_five.rpy:6897
translate schinese chapter_five_scene_forty_cb940076:

    # yu "This whole operation feels… wrong."
    yu "整个行动都让我觉得……不对劲。"

# game/chapters/chapter_five/chapter_five.rpy:6900
translate schinese chapter_five_scene_forty_d72146c8:

    # mc "I agree… but we have no other choice."
    mc "我也这么觉得……但我们别无选择。"

# game/chapters/chapter_five/chapter_five.rpy:6903
translate schinese chapter_five_scene_forty_b9c1a173:

    # rav "I know she said to bring them here but…"
    rav "我知道她说是要把人带到这里，可是……"

# game/chapters/chapter_five/chapter_five.rpy:6906
translate schinese chapter_five_scene_forty_34102e23:

    # rav "What if we try convincing Takedo to join us."
    rav "我们试试说服武户加入我们怎么样？"

# game/chapters/chapter_five/chapter_five.rpy:6907
translate schinese chapter_five_scene_forty_815a996b:

    # rav "Especially considering the fact that he lives with Nina, Slayer of Wedpusi."
    rav "毕竟他跟温普西的杀手妮娜住在一起。"

# game/chapters/chapter_five/chapter_five.rpy:6908
translate schinese chapter_five_scene_forty_fc071907:

    # rav "If we can get her on our side…"
    rav "如果能把她拉到我方……"

# game/chapters/chapter_five/chapter_five.rpy:6911
translate schinese chapter_five_scene_forty_d34ad0f3:

    # mc "Who is Wedpusi?"
    mc "温普西是谁？"

# game/chapters/chapter_five/chapter_five.rpy:6914
translate schinese chapter_five_scene_forty_34f5708f:

    # rav "She was the strongest warrior from the most powerful clan which was eventually conquered by Queen Hinata thanks to Nina."
    rav "她曾是那个最强大氏族里最强的战士，后来那个氏族被日向女王在妮娜的协助下征服了。"

# game/chapters/chapter_five/chapter_five.rpy:6917
translate schinese chapter_five_scene_forty_56128594:

    # yu "Nina sounds powerful."
    yu "妮娜听起来很厉害。"

# game/chapters/chapter_five/chapter_five.rpy:6918
translate schinese chapter_five_scene_forty_3727b687:

    # yu "Do you think she would be willing to join?"
    yu "你觉得她会愿意加入吗？"

# game/chapters/chapter_five/chapter_five.rpy:6921
translate schinese chapter_five_scene_forty_8d2b11e1:

    # rav "I leave that in your very capable hands."
    rav "那就交给你那双非常能干的双手了。"

# game/chapters/chapter_five/chapter_five.rpy:6922
translate schinese chapter_five_scene_forty_aa76d3ab:

    # rav "You two should change before heading out."
    rav "你们两个出发前先去换衣服。"

# game/chapters/chapter_five/chapter_five.rpy:6925
translate schinese chapter_five_scene_forty_f10eea98:

    # mc "Yeah… we’re not exactly dressed for stealth."
    mc "是啊……我们这样可不适合潜行。"

# game/chapters/chapter_five/chapter_five.rpy:6928
translate schinese chapter_five_scene_forty_e099ccbf:

    # rav "I think I saw some clothes in our place."
    rav "我记得在我们住处看到过一些衣服。"

# game/chapters/chapter_five/chapter_five.rpy:6929
translate schinese chapter_five_scene_forty_7b7ccdef:

    # rav "I’ll stay here and work with Hinata to ease negotiations for the alliance later on."
    rav "我会留在这里和日向一起，为之后的结盟谈判铺路。"

# game/chapters/chapter_five/chapter_five.rpy:6932
translate schinese chapter_five_scene_forty_7179822a:

    # rav "..."
    rav "……"

# game/chapters/chapter_five/chapter_five.rpy:6936
translate schinese chapter_five_scene_forty_901312b9:

    # rav "I…"
    rav "我……"

# game/chapters/chapter_five/chapter_five.rpy:6937
translate schinese chapter_five_scene_forty_fa5af91d:

    # rav "I’m sorry for putting you two in a situation like this."
    rav "很抱歉让你们卷进这种事。"

# game/chapters/chapter_five/chapter_five.rpy:6940
