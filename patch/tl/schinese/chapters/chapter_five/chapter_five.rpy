    mc "不要被他的伪装蒙蔽，以为自己不配为王。"

# game/chapters/chapter_five/chapter_five.rpy:1956
translate schinese chapter_five_scene_twenty_thirty_one_C_b6c0fe89:

    # wi "I agree, your Majesty."
    wi "我同意，陛下。"

# game/chapters/chapter_five/chapter_five.rpy:1959
translate schinese chapter_five_scene_twenty_thirty_one_C_96cf3e72:

    # wi "You are the only one that has a genuine claim to the throne."
    wi "只有您才是王位的真正合法继承者。"

