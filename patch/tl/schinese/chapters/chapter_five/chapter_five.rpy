translate schinese chapter_five_scene_twenty_thirty_two_0756aedf_1:

    # wi "Focus on the sound of your heartbeat."
    wi "专注于自己心跳的声音。"

# game/chapters/chapter_five/chapter_five.rpy:2601
translate schinese chapter_five_scene_twenty_thirty_two_3acf946c_1:

    # wi "Listen to the sounds of your surroundings."
    wi "聆听周围的声音。"

