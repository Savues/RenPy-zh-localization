translate schinese chapter_five_scene_twenty_thirty_two_532adddf_1:

    # yu "...failed you… master…"
    yu "……辜负了您……教官……"

# game/chapters/chapter_five/chapter_five.rpy:2622
translate schinese chapter_five_scene_twenty_thirty_two_3c7841cd_1:

    # na "[playername]…"
    na "[playername]……"

