    # na "No wonder she looked so shaken up…"
    na "难怪她看起来那么动摇……"

# game/chapters/chapter_five/chapter_five.rpy:1473
translate schinese chapter_five_scene_twenty_thirty_one_B_42771e9b_1:

    # mc "Yeah… seeing Luminox like that was…"
    mc "是啊……看到那样的露米诺克斯……"

# game/chapters/chapter_five/chapter_five.rpy:1476
translate schinese chapter_five_scene_twenty_thirty_one_B_1f1fd9aa_1:

    # na "What? Seeing her how?"
    na "什么？看到她怎么了？"

# game/chapters/chapter_five/chapter_five.rpy:1479
translate schinese chapter_five_scene_twenty_thirty_one_B_9cec4a5c_1:

    # mc "She was weak, Nat…"
    mc "她很虚弱，娜塔……"

# game/chapters/chapter_five/chapter_five.rpy:1480
translate schinese chapter_five_scene_twenty_thirty_one_B_6f1ba46f_1:

    # mc "It’s like…"
    mc "就像是……"

# game/chapters/chapter_five/chapter_five.rpy:1481
translate schinese chapter_five_scene_twenty_thirty_one_B_f2912c70_1:

    # mc "...talking to someone near the end of their life..."
    mc "……在跟一个走到生命尽头的人说话……"

# game/chapters/chapter_five/chapter_five.rpy:1484
translate schinese chapter_five_scene_twenty_thirty_one_B_117962a9_1:

    # na "I…"
    na "我……"

# game/chapters/chapter_five/chapter_five.rpy:1485
translate schinese chapter_five_scene_twenty_thirty_one_B_3bfe290a_1:

    # na "Wow… I mean…"
    na "哇……我是说……"

# game/chapters/chapter_five/chapter_five.rpy:1488
translate schinese chapter_five_scene_twenty_thirty_one_B_fe615a71_1:

    # na "What?"
    na "什么？"

# game/chapters/chapter_five/chapter_five.rpy:1489
translate schinese chapter_five_scene_twenty_thirty_one_B_d303f13f_1:

    # na "How’s that even possible?"
    na "这怎么可能？"

# game/chapters/chapter_five/chapter_five.rpy:1492
translate schinese chapter_five_scene_twenty_thirty_one_B_3e9d25be_1:

    # mc "I wish I knew…"
    mc "我也想知道……"

# game/chapters/chapter_five/chapter_five.rpy:1495
translate schinese chapter_five_scene_twenty_thirty_one_B_0b0c8e71_1:

    # mc "This whole situation is fucked, Nat…"
    mc "整件事都糟透了，娜塔……"

# game/chapters/chapter_five/chapter_five.rpy:1498
translate schinese chapter_five_scene_twenty_thirty_one_B_641b6dfa_1:

    # mc "I feel so damn lost…"
    mc "我真的迷失了方向……"

# game/chapters/chapter_five/chapter_five.rpy:1501
translate schinese chapter_five_scene_twenty_thirty_one_B_6f48a14c_1:

    # na "I can only imagine…"
    na "我只能想象……"

# game/chapters/chapter_five/chapter_five.rpy:1502
translate schinese chapter_five_scene_twenty_thirty_one_B_534466f9_1:

    # na "Come on, big guy, let’s sit down together."
    na "来吧，大块头，我们一起坐下。"

# game/chapters/chapter_five/chapter_five.rpy:1506
translate schinese chapter_five_scene_twenty_thirty_one_B_20142cbd_1:

    # na "Tell me everything."
    na "把一切都告诉我。"

# game/chapters/chapter_five/chapter_five.rpy:1509
translate schinese chapter_five_scene_twenty_thirty_one_B_ee210116_1:

    # mc "I don’t even know where to begin, I mean…"
    mc "我甚至不知道该从哪儿说起，我是说……"

# game/chapters/chapter_five/chapter_five.rpy:1512
translate schinese chapter_five_scene_twenty_thirty_one_B_c0fd765c_1:

    # mc "I genuinely cannot explain what we witnessed."
    mc "我真的没法解释我们看到的一切。"

# game/chapters/chapter_five/chapter_five.rpy:1515
translate schinese chapter_five_scene_twenty_thirty_one_B_de1ce9a6_1:

    # na "How about you tell me what Luminox said?"
    na "要不你告诉我露米诺克斯说了什么？"

# game/chapters/chapter_five/chapter_five.rpy:1518
translate schinese chapter_five_scene_twenty_thirty_one_B_645c4ce9_1:

    # mc "Well… for starters…"
    mc "这个嘛……首先……"

# game/chapters/chapter_five/chapter_five.rpy:1521
translate schinese chapter_five_scene_twenty_thirty_one_B_3535c8e5_1:

    # mc "She never meant for me to come to Eden..."
    mc "她从没打算让我来伊甸……"

# game/chapters/chapter_five/chapter_five.rpy:1524
translate schinese chapter_five_scene_twenty_thirty_one_B_4e85aad9_1:

    # na "What do you mean?"
    na "什么意思？"

# game/chapters/chapter_five/chapter_five.rpy:1527
translate schinese chapter_five_scene_twenty_thirty_one_B_0e33526c_1:

    # mc "Her original plan was for the four of you to be the ones to solve the entire crisis going on right now…"
    mc "她原本的计划是让你们四个人去解决眼下这场危机……"

# game/chapters/chapter_five/chapter_five.rpy:1530
translate schinese chapter_five_scene_twenty_thirty_one_B_c941bbb1_1:

    # na "I see…"
    na "我明白了……"

# game/chapters/chapter_five/chapter_five.rpy:1531
translate schinese chapter_five_scene_twenty_thirty_one_B_74253558_1:

    # na "So… we actually have a mission?"
    na "所以……我们其实是有任务的？"

# game/chapters/chapter_five/chapter_five.rpy:1534
translate schinese chapter_five_scene_twenty_thirty_one_B_7f45e733_1:

    # mc "Sort of? She was very cryptic when it came to that…"
    mc "算是吧？说到这个她打得很含糊……"

# game/chapters/chapter_five/chapter_five.rpy:1535
translate schinese chapter_five_scene_twenty_thirty_one_B_665c6a68_1:

    # mc "It’s something we’ll have to talk to Sophia about."
    mc "这件事我们得跟索菲娅谈谈。"

# game/chapters/chapter_five/chapter_five.rpy:1538
translate schinese chapter_five_scene_twenty_thirty_one_B_945e6332_1:

    # na "That’s not what’s weighing you down though, right?"
    na "但压在你心里的不是这个，对吧？"

# game/chapters/chapter_five/chapter_five.rpy:1541
translate schinese chapter_five_scene_twenty_thirty_one_B_5d9f22ac_1:

    # mc "I…"
    mc "我……"

# game/chapters/chapter_five/chapter_five.rpy:1544
translate schinese chapter_five_scene_twenty_thirty_one_B_710fbd0f_3:

    # mc "No…"
    mc "不……"

# game/chapters/chapter_five/chapter_five.rpy:1547
translate schinese chapter_five_scene_twenty_thirty_one_B_14a3172e_1:

    # na "Whatever it is that’s troubling you, [playername]… do you think you’d be better off not knowing about it?"
    na "不管是什么在困扰你，[playername]……你觉得不知道会不会更好受一点？"

# game/chapters/chapter_five/chapter_five.rpy:1550
translate schinese chapter_five_scene_twenty_thirty_one_B_5b2ccf88_1:

    # mc "I’m not entirely sure…"
    mc "我也说不好……"

# game/chapters/chapter_five/chapter_five.rpy:1551
translate schinese chapter_five_scene_twenty_thirty_one_B_3491bed5_1:

    # mc "On one hand, we could keep on living a life that’s relaxed here."
    mc "一方面，我们可以继续在这里过轻松的日子。"

# game/chapters/chapter_five/chapter_five.rpy:1554
translate schinese chapter_five_scene_twenty_thirty_one_B_3815833f_1:

    # mc "Enjoy our time, just kinda go with the flow."
    mc "享受时间，顺其自然。"

# game/chapters/chapter_five/chapter_five.rpy:1557
translate schinese chapter_five_scene_twenty_thirty_one_B_c41a4d1b_1:

    # na "But on the other hand..?"
    na "但另一方面……？"

# game/chapters/chapter_five/chapter_five.rpy:1560
translate schinese chapter_five_scene_twenty_thirty_one_B_bafd55a7_1:

    # mc "We now know the direction we should be headed."
    mc "我们现在知道了该往哪个方向走。"

# game/chapters/chapter_five/chapter_five.rpy:1563
translate schinese chapter_five_scene_twenty_thirty_one_B_2f7cda16_1:

    # na "And that is?"
    na "是什么？"

# game/chapters/chapter_five/chapter_five.rpy:1566
translate schinese chapter_five_scene_twenty_thirty_one_B_456d8137_1:

    # mc "Continue doing what we’ve been doing."
    mc "继续做我们一直在做的事。"

# game/chapters/chapter_five/chapter_five.rpy:1569
translate schinese chapter_five_scene_twenty_thirty_one_B_aa8bc185_1:

    # na "So why does that bring you down?"
    na "那这为什么会让你难过？"

# game/chapters/chapter_five/chapter_five.rpy:1572
translate schinese chapter_five_scene_twenty_thirty_one_B_5e42df02_1:

    # mc "The uncertainty of it all, Nat."
    mc "是那种一切都不确定的感觉，娜塔。"

# game/chapters/chapter_five/chapter_five.rpy:1573
translate schinese chapter_five_scene_twenty_thirty_one_B_e654891b_1:

    # mc "You know that’s why I don’t like it when you drive or anyone else drives."
    mc "你知道，所以我才不喜欢你开车，也不喜欢别人开车。"

# game/chapters/chapter_five/chapter_five.rpy:1574
translate schinese chapter_five_scene_twenty_thirty_one_B_354d7398_1:

    # mc "I’ve spent all my life avoiding people because I simply cannot deal with uncertain things."
    mc "我这一辈子都在躲着人，因为我实在应付不了不确定的事。"

# game/chapters/chapter_five/chapter_five.rpy:1577
translate schinese chapter_five_scene_twenty_thirty_one_B_fb06c062_1:

    # na "Yet you deal with me."
    na "可你却愿意应付我。"

# game/chapters/chapter_five/chapter_five.rpy:1580
translate schinese chapter_five_scene_twenty_thirty_one_B_739f1c44_1:

    # mc "You’re different."
    mc "你不一样。"

# game/chapters/chapter_five/chapter_five.rpy:1583
translate schinese chapter_five_scene_twenty_thirty_one_B_65ef2155_1:

    # na "How?"
    na "怎么不一样？"

# game/chapters/chapter_five/chapter_five.rpy:1586
translate schinese chapter_five_scene_twenty_thirty_one_B_12185bff_1:

    # mc "You just… are."
    mc "你就是……不一样。"

# game/chapters/chapter_five/chapter_five.rpy:1589
translate schinese chapter_five_scene_twenty_thirty_one_B_1892beaa_1:

    # na "Hmmm…"
    na "嗯……"

# game/chapters/chapter_five/chapter_five.rpy:1592
translate schinese chapter_five_scene_twenty_thirty_one_B_a5e7d74b_1:

    # na "You know, [playername]…"
    na "你知道吗，[playername]……"

# game/chapters/chapter_five/chapter_five.rpy:1593
translate schinese chapter_five_scene_twenty_thirty_one_B_57e24295_1:

    # na "Life has a way of leading us to where we’re meant to be at the right time."
    na "人生总会用某种方式，在恰当的时机把我们带到该去的地方。"

# game/chapters/chapter_five/chapter_five.rpy:1596
translate schinese chapter_five_scene_twenty_thirty_one_B_b38913ce_1:

    # na "Regardless of whether we feel happy, angry, or just hurt…"
    na "不管我们感到快乐、愤怒，还是只是受伤……"

# game/chapters/chapter_five/chapter_five.rpy:1597
translate schinese chapter_five_scene_twenty_thirty_one_B_81155a4f_1:

    # na "Those things end up helping us grow into the person we’re meant to be."
    na "这些事情最终都会帮我们成长为那个我们注定要成为的人。"

# game/chapters/chapter_five/chapter_five.rpy:1600
translate schinese chapter_five_scene_twenty_thirty_one_B_4c8dba41_1:

    # mc "Just like how when we met…"
    mc "就像我们相遇时一样……"

# game/chapters/chapter_five/chapter_five.rpy:1603
translate schinese chapter_five_scene_twenty_thirty_one_B_1f5aa983_1:

    # na "Exactly!"
    na "正是如此！"

# game/chapters/chapter_five/chapter_five.rpy:1604
translate schinese chapter_five_scene_twenty_thirty_one_B_c50cc79b_1:

    # na "It’s not so much the circumstances that surround us, but rather what we do with the opportunity handed to us."
    na "重要的不是围绕我们的处境，而是我们如何把握送到手边的机会。"

# game/chapters/chapter_five/chapter_five.rpy:1607
translate schinese chapter_five_scene_twenty_thirty_one_B_54c59757_1:

    # mc "What if we fail, though?"
    mc "但万一我们失败了呢？"

# game/chapters/chapter_five/chapter_five.rpy:1608
translate schinese chapter_five_scene_twenty_thirty_one_B_deeaf697_1:

    # mc "There’s so much riding on this…"
    mc "这牵涉的东西太多了……"

# game/chapters/chapter_five/chapter_five.rpy:1609
translate schinese chapter_five_scene_twenty_thirty_one_B_c33fdc4b_1:

    # mc "We don’t get second chances."
    mc "我们没有第二次机会。"

# game/chapters/chapter_five/chapter_five.rpy:1610
translate schinese chapter_five_scene_twenty_thirty_one_B_fcdb1a1b_1:

    # mc "And it’s not just my life we’re gambling here."
    mc "而且我们赌上的不只是我的命。"

# game/chapters/chapter_five/chapter_five.rpy:1611
translate schinese chapter_five_scene_twenty_thirty_one_B_44dcde42_1:

    # mc "It’s yours, Gianna’s, Yuki’s, Ravena’s, everyone in this world."
    mc "还有你的、吉安娜的、由纪的、拉维娜的，还有这个世界所有人的。"

# game/chapters/chapter_five/chapter_five.rpy:1614
translate schinese chapter_five_scene_twenty_thirty_one_B_4e7fdab2_1:

    # mc "I… I can’t afford to fuck this up, Nat!"
    mc "我……我不能搞砸这一切，娜塔！"

# game/chapters/chapter_five/chapter_five.rpy:1617
translate schinese chapter_five_scene_twenty_thirty_one_B_30241b95_1:

    # na "When did we become an I?"
    na "我们什么时候变成\"我们\"了？"

# game/chapters/chapter_five/chapter_five.rpy:1618
translate schinese chapter_five_scene_twenty_thirty_one_B_4bd32387_1:

    # na "Am I not here next to you?"
    na "我不是就在你旁边吗？"

# game/chapters/chapter_five/chapter_five.rpy:1621
translate schinese chapter_five_scene_twenty_thirty_one_B_529e459e_1:

    # mc "You are… but…"
    mc "是……但是……"

# game/chapters/chapter_five/chapter_five.rpy:1624
translate schinese chapter_five_scene_twenty_thirty_one_B_5e3df63a_1:

    # na "No matter the odds, I’ll always stay by your side."
    na "不管胜算多低，我都会待在你身边。"

# game/chapters/chapter_five/chapter_five.rpy:1625
translate schinese chapter_five_scene_twenty_thirty_one_B_9269ac23_1:

    # na "Even if we got the world against us, it’s you and me, pretty boy."
    na "就算全世界都与我们为敌，那也只有你和我，帅哥。"

# game/chapters/chapter_five/chapter_five.rpy:1626
translate schinese chapter_five_scene_twenty_thirty_one_B_22c51b04_1:

    # na "I’m not letting anyone take you away from me."
    na "我不会让任何人把你从我身边带走。"

# game/chapters/chapter_five/chapter_five.rpy:1629
translate schinese chapter_five_scene_twenty_thirty_one_B_152e693e_1:

    # mc "But what if I’m the one getting in our way?"
    mc "但如果挡路的那个就是我呢？"

# game/chapters/chapter_five/chapter_five.rpy:1630
translate schinese chapter_five_scene_twenty_thirty_one_B_71ff55b2_1:

    # mc "I wasn’t even meant to be here, Nat…"
    mc "我本来就不该在这里，娜塔……"

# game/chapters/chapter_five/chapter_five.rpy:1633
translate schinese chapter_five_scene_twenty_thirty_one_B_10bd3856_1:

    # na "So?"
    na "所以呢？"

# game/chapters/chapter_five/chapter_five.rpy:1636
translate schinese chapter_five_scene_twenty_thirty_one_B_0cfb5691_1:

    # mc "What do you mean ‘so’?"
    mc "什么叫所以？"

# game/chapters/chapter_five/chapter_five.rpy:1637
translate schinese chapter_five_scene_twenty_thirty_one_B_9e9e46b1_1:

    # mc "Don’t you understand, Nat?"
    mc "你还不明白吗，娜塔？"

# game/chapters/chapter_five/chapter_five.rpy:1638
translate schinese chapter_five_scene_twenty_thirty_one_B_3819dfa9_1:

    # mc "I’m leading our group and I shouldn’t even be here in the first place!"
    mc "我带领着这个队伍，可我本来根本不该来！"

# game/chapters/chapter_five/chapter_five.rpy:1639
translate schinese chapter_five_scene_twenty_thirty_one_B_30b9e2ff_1:

    # mc "I’m a fucking liability and I would never be able to-"
    mc "我他妈就是个累赘，永远都——"

# game/chapters/chapter_five/chapter_five.rpy:1648
translate schinese chapter_five_scene_twenty_thirty_one_B_ee1f159f_1:

    # na "Will you stop and listen to me?"
    na "你能不能停下来听我说？"

# game/chapters/chapter_five/chapter_five.rpy:1651
translate schinese chapter_five_scene_twenty_thirty_one_B_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/chapters/chapter_five/chapter_five.rpy:1654
translate schinese chapter_five_scene_twenty_thirty_one_B_38aca7e5_1:

    # na "*Imitating [playername]* Yes, Natasha, you are oh so smart!"
    na "*模仿[playername]* 是的，娜塔莎，你真是太聪明了！"

# game/chapters/chapter_five/chapter_five.rpy:1655
translate schinese chapter_five_scene_twenty_thirty_one_B_26eafd49_1:

    # na "Thank you, [playername]."
    na "谢谢你，[playername]。"

# game/chapters/chapter_five/chapter_five.rpy:1656
translate schinese chapter_five_scene_twenty_thirty_one_B_c376b17f_1:

    # na "First of all, you are not a liability."
    na "首先，你不是累赘。"

# game/chapters/chapter_five/chapter_five.rpy:1657
translate schinese chapter_five_scene_twenty_thirty_one_B_e177360b_1:

    # na "Have you considered the possibility of Luminox being wrong about not having chosen you?"
    na "你有没有想过，露米诺克斯说没有选中你，本身可能是错的？"

# game/chapters/chapter_five/chapter_five.rpy:1660
translate schinese chapter_five_scene_twenty_thirty_one_B_11455b53_1:

    # mc "What?"
    mc "什么？"

# game/chapters/chapter_five/chapter_five.rpy:1663
translate schinese chapter_five_scene_twenty_thirty_one_B_7a6b8f99_1:

    # na "We learned she’s all about balance while studying with Cinnie today."
    na "我们今天和辛西一起研究时了解到，她讲的一切都是围绕平衡。"

# game/chapters/chapter_five/chapter_five.rpy:1664
translate schinese chapter_five_scene_twenty_thirty_one_B_2a2f67bb_1:

    # na "Without you there’d be a pretty big lack of balance here."
    na "没有你，这里会严重失衡。"

# game/chapters/chapter_five/chapter_five.rpy:1665
translate schinese chapter_five_scene_twenty_thirty_one_B_a438089b_1:

    # na "You’re the rational one of the group. The planner."
    na "你是队伍里最理智的那个。是负责规划的人。"

# game/chapters/chapter_five/chapter_five.rpy:1666
translate schinese chapter_five_scene_twenty_thirty_one_B_a312cbe2_1:

    # na "I genuinely believe the chancellor would’ve found a reason to imprison us regardless of what happened."
    na "我真心认为，不管发生什么，宰相都会找到理由把我们关起来。"

# game/chapters/chapter_five/chapter_five.rpy:1667
translate schinese chapter_five_scene_twenty_thirty_one_B_738e760c_1:

    # na "You being a Dark Caster simply made it more convenient and believable for him."
    na "你是暗系施法者这件事，只是让他的理由更顺理成章、更可信而已。"

# game/chapters/chapter_five/chapter_five.rpy:1670
translate schinese chapter_five_scene_twenty_thirty_one_B_108af15c_1:

    # mc "Sure but-"
    mc "好吧，但——"

