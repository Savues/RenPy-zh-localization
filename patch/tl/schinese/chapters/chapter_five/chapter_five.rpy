translate schinese chapter_five_scene_twenty_thirty_two_c9b564f5_1:

    # wi "As much as I agree with you, making a deal with a Nexian is just…"
    wi "我虽然同意你，但和涅克西安做交易终究是……"

# game/chapters/chapter_five/chapter_five.rpy:2421
translate schinese chapter_five_scene_twenty_thirty_two_4909b00d_1:

    # wi "Dangerous."
    wi "很危险。"

# game/chapters/chapter_five/chapter_five.rpy:2424
translate schinese chapter_five_scene_twenty_thirty_two_d79b90ee_1:

    # mc "Nexian?"
    mc "涅克西安？"

# game/chapters/chapter_five/chapter_five.rpy:2425
translate schinese chapter_five_scene_twenty_thirty_two_be6fba95_1:

    # mc "You know what, can you explain the whole theology of this place?"
    mc "这样吧，你能把这个地方的神学讲一遍吗？"

# game/chapters/chapter_five/chapter_five.rpy:2428
translate schinese chapter_five_scene_twenty_thirty_two_7b1f0e41_1:

    # wi "Do you want the long version or the short version?"
    wi "你想听长版还是短版？"

# game/chapters/chapter_five/chapter_five.rpy:2434
translate schinese chapter_five_scene_twenty_thirty_two_7b4a7dac_1:

    # wi "You have Luminox on top."
    wi "长版是：最上面是露米诺克斯。"

# game/chapters/chapter_five/chapter_five.rpy:2435
translate schinese chapter_five_scene_twenty_thirty_two_30d7328a_1:

    # wi "Six Celestiarchs, one for each type of Spiritual Energy."
    wi "六位天枢，每种灵力属性各一位。"

# game/chapters/chapter_five/chapter_five.rpy:2436
translate schinese chapter_five_scene_twenty_thirty_two_023c4f65_1:

    # wi "People that ascend as gods are known as Divinarchs."
    wi "飞升成神的人被称为天枢。"

# game/chapters/chapter_five/chapter_five.rpy:2437
translate schinese chapter_five_scene_twenty_thirty_two_1cc4705d_1:

    # wi "Finally, you have Nexians, rulers of the underworld."
    wi "最后是涅克西安，冥界的统治者。"

# game/chapters/chapter_five/chapter_five.rpy:2438
translate schinese chapter_five_scene_twenty_thirty_two_eea47d9b_1:

    # wi "Ailana, the Celestiarch of Light, made a deal with a Nexian named Solstice."
    wi "光之天枢艾拉娜曾与一位名叫索尔斯蒂斯的涅克西安做了交易。"

# game/chapters/chapter_five/chapter_five.rpy:2439
translate schinese chapter_five_scene_twenty_thirty_two_f168c22f_1:

    # wi "Solstice is known as the Nexian of Knowledge, but she is not to be trifled with."
    wi "索尔斯蒂斯被称为知识之涅克西安，但绝不是好惹的角色。"

# game/chapters/chapter_five/chapter_five.rpy:2445
translate schinese chapter_five_scene_twenty_thirty_two_602c7752_1:

    # wi "Let us begin with the Creation of Eden, then."
    wi "那就从伊甸的创世开始讲吧。"

# game/chapters/chapter_five/chapter_five.rpy:2452
translate schinese chapter_five_scene_twenty_thirty_two_5c9aeb67_1:

    # wi "In the beginning, the world was but a seed."
    wi "起初，世界只是一颗种子。"

# game/chapters/chapter_five/chapter_five.rpy:2453
translate schinese chapter_five_scene_twenty_thirty_two_3a5c0dc1_1:

    # wi "From that seed, the Tree of Eden was born."
    wi "从那颗种子里，生出了伊甸之树。"

# game/chapters/chapter_five/chapter_five.rpy:2454
translate schinese chapter_five_scene_twenty_thirty_two_84c9d8db_1:

    # wi "And thus, Luminox began crafting the world around it."
    wi "于是，露米诺克斯开始围绕它塑造这个世界。"

# game/chapters/chapter_five/chapter_five.rpy:2457
translate schinese chapter_five_scene_twenty_thirty_two_8fc2a986_1:

    # aq "At first, she created the Four Divinarchs to craft each element needed in the world."
    aq "最初，她创造了四位天枢，各自塑造世界所需的元素。"

# game/chapters/chapter_five/chapter_five.rpy:2458
translate schinese chapter_five_scene_twenty_thirty_two_4e498560_1:

    # aq "Fire, Air, Wind, and Nature."
    aq "火、风、气与自然。"

# game/chapters/chapter_five/chapter_five.rpy:2459
translate schinese chapter_five_scene_twenty_thirty_two_64d002b9_1:

    # aq "Together, the Four made the world we live in."
    aq "四位一起造就了我们所生活的世界。"

# game/chapters/chapter_five/chapter_five.rpy:2462
translate schinese chapter_five_scene_twenty_thirty_two_63214b1b_1:

    # wi "But then, Luminox felt like something was missing."
    wi "但后来，露米诺克斯觉得少了点什么。"

# game/chapters/chapter_five/chapter_five.rpy:2463
translate schinese chapter_five_scene_twenty_thirty_two_90d3beaf_1:

    # wi "She truly loved her creation, but she wanted more."
    wi "她深深爱着自己的造物，但她想要更多。"

# game/chapters/chapter_five/chapter_five.rpy:2466
translate schinese chapter_five_scene_twenty_thirty_two_8c3397f0_1:

    # mc "Someone to share it with?"
    mc "想有人与她分享？"

# game/chapters/chapter_five/chapter_five.rpy:2469
translate schinese chapter_five_scene_twenty_thirty_two_65ea9d6a_1:

    # wi "Correct."
    wi "正是。"

# game/chapters/chapter_five/chapter_five.rpy:2470
translate schinese chapter_five_scene_twenty_thirty_two_b5d6b58d_1:

    # wi "Thus the Celestiarchs of Light and Darkness were born."
    wi "于是光之天枢与暗之天枢诞生了。"

# game/chapters/chapter_five/chapter_five.rpy:2471
translate schinese chapter_five_scene_twenty_thirty_two_445e60e7_1:

    # wi "The Celestiarch of Light was the one who brought life to the world."
    wi "光之天枢为世界带来了生命。"

# game/chapters/chapter_five/chapter_five.rpy:2472
translate schinese chapter_five_scene_twenty_thirty_two_6aafb8d2_1:

    # wi "Whereas the Celestiarch of Darkness brought death."
    wi "而暗之天枢带来了死亡。"

# game/chapters/chapter_five/chapter_five.rpy:2475
translate schinese chapter_five_scene_twenty_thirty_two_f8c55353_1:

    # aq "Ailana and Nebulys."
    aq "艾拉娜和涅布利斯。"

# game/chapters/chapter_five/chapter_five.rpy:2478
translate schinese chapter_five_scene_twenty_thirty_two_aa0dd972_1:

    # wi "As the two joined the stage, life as we know it was eventually born."
    wi "随着两位一同登台，我们所知的生命形态终于诞生。"

# game/chapters/chapter_five/chapter_five.rpy:2479
translate schinese chapter_five_scene_twenty_thirty_two_70412d2e_1:

    # wi "People, animals, creatures."
    wi "人类、动物、生物。"

# game/chapters/chapter_five/chapter_five.rpy:2482
translate schinese chapter_five_scene_twenty_thirty_two_7238b9de_1:

    # mc "Have there ever been other religions that have not followed Luminox?"
    mc "有没有其他不信仰露米诺克斯的宗教？"

# game/chapters/chapter_five/chapter_five.rpy:2485
translate schinese chapter_five_scene_twenty_thirty_two_3ab79c01_1:

    # wi "Not religions, but there are cults around Nebulys."
    wi "算不上宗教，但有崇拜涅布利斯的邪教。"

# game/chapters/chapter_five/chapter_five.rpy:2488
translate schinese chapter_five_scene_twenty_thirty_two_9242447a_1:

    # mc "I’m assuming those cults are dangerous?"
    mc "我猜那些邪教很危险？"

# game/chapters/chapter_five/chapter_five.rpy:2491
translate schinese chapter_five_scene_twenty_thirty_two_be06099f_1:

    # aq "Some, not all."
    aq "有些是，不是全部。"

# game/chapters/chapter_five/chapter_five.rpy:2494
translate schinese chapter_five_scene_twenty_thirty_two_baa23e71_1:

    # aq "Nebulys is a heavily misunderstood Celestiarch."
    aq "涅布利斯是一位被严重误解的天枢。"

# game/chapters/chapter_five/chapter_five.rpy:2495
translate schinese chapter_five_scene_twenty_thirty_two_699767b6_1:

    # aq "Although she rules the underworld, she’s not evil."
    aq "虽然她统治冥界，但她并不邪恶。"

# game/chapters/chapter_five/chapter_five.rpy:2498
translate schinese chapter_five_scene_twenty_thirty_two_054c5ee0_1:

    # mc "I see."
    mc "我明白了。"

# game/chapters/chapter_five/chapter_five.rpy:2499
translate schinese chapter_five_scene_twenty_thirty_two_c801b3e5_1:

    # mc "Now, where does Vela fall in?"
    mc "那薇拉算是哪一类？"

# game/chapters/chapter_five/chapter_five.rpy:2502
translate schinese chapter_five_scene_twenty_thirty_two_dc92bef8_1:

    # wi "There are far more Divinarchs than the Six."
    wi "天枢远不止六位。"

# game/chapters/chapter_five/chapter_five.rpy:2503
translate schinese chapter_five_scene_twenty_thirty_two_72260632_1:

    # wi "They are humans that have transcended their mortality and joined Luminox in her realm."
    wi "他们是超越自身死亡、进入露米诺克斯国度的人类。"

# game/chapters/chapter_five/chapter_five.rpy:2506
translate schinese chapter_five_scene_twenty_thirty_two_da4ab5c2_1:

    # mc "So like… heaven?"
    mc "所以就像……天堂？"

# game/chapters/chapter_five/chapter_five.rpy:2509
translate schinese chapter_five_scene_twenty_thirty_two_1db38363_1:

    # aq "What’s heaven?"
    aq "天堂是什么？"

# game/chapters/chapter_five/chapter_five.rpy:2512
translate schinese chapter_five_scene_twenty_thirty_two_05df294a_1:

    # mc "A place where the good go."
    mc "好人去的地方。"

# game/chapters/chapter_five/chapter_five.rpy:2513
translate schinese chapter_five_scene_twenty_thirty_two_2d04420f_1:

    # mc "At least that’s the more common belief in my world."
    mc "至少在我的世界，这是更常见的说法。"

# game/chapters/chapter_five/chapter_five.rpy:2516
translate schinese chapter_five_scene_twenty_thirty_two_8874a7a9_1:

    # wi "Oh no, nothing like that."
    wi "哦不，完全不是那样。"

