translate schinese chapter_five_scene_twenty_thirty_two_f6c80e6c_1:

    # wi "She is willing to help ordinary people grow exponentially in power, however in return she expects a greater sacrifice."
    wi "她愿意帮助普通人以指数级增长实力，但作为回报，她期待更大的牺牲。"

# game/chapters/chapter_five/chapter_five.rpy:2544
translate schinese chapter_five_scene_twenty_thirty_two_a905cbfc_1:

    # wi "Legend often depicts her as one that approaches people in their most dire moment.."
    wi "传说常描绘她在人们最危急的时刻现身……"

# game/chapters/chapter_five/chapter_five.rpy:2547
translate schinese chapter_five_scene_twenty_thirty_two_9f1ec238_1:

    # mc "So the fact that she hasn’t appeared to us…"
    mc "所以她没有出现在我们面前……"

# game/chapters/chapter_five/chapter_five.rpy:2550
translate schinese chapter_five_scene_twenty_thirty_two_e415f23e_1:

    # wi "Is a very good thing."
    wi "是件大好事。"

