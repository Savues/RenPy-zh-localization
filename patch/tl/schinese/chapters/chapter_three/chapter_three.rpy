translate schinese scene_fifteen_label_3e315beb:

    # mc "Our group is fairly powerful and I know the Church will have our backs."
    mc "我们这伙人实力不弱，而且教会一定会支持我们。"

# game/chapters/chapter_three/chapter_three.rpy:3797
