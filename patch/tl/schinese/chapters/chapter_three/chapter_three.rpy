translate schinese scene_fifteen_label_f6a8f9cb:

    # gi "We’re not really dressed to be someone who can afford bodyguards…"
    gi "穿成这样可不像请得起保镖的人……"

# game/chapters/chapter_three/chapter_three.rpy:3831
translate schinese scene_fifteen_label_163881aa:

    # rav "*Gasps* How dare you insinuate my clothes are cheap!"
    rav "*倒吸一口气* 你竟然敢说我的衣服廉价？！"

