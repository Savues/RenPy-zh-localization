translate schinese scene_sixteen_label_ed468a2c:

    # na "You know it."
    na "你知道的。"

# game/chapters/chapter_three/chapter_three.rpy:4604
translate schinese scene_sixteen_label_6906b5d8:

    # gi "I’ve always wanted to serve a princess."
    gi "我一直梦想侍奉一位公主。"

# game/chapters/chapter_three/chapter_three.rpy:4607
translate schinese scene_sixteen_label_d0a80629:

    # yu "I swear allegiance to you, your highness, until my last breath."
    yu "我以最后一口气向您宣誓效忠，殿下。"

# game/chapters/chapter_three/chapter_three.rpy:4610
translate schinese scene_sixteen_label_56778c64:

    # rav "Everyone… thank you."
    rav "各位……谢谢你们。"

# game/chapters/chapter_three/chapter_three.rpy:4611
translate schinese scene_sixteen_label_8dd743b0:

    # rav "I truly am happy our paths have crossed."
    rav "我们的命运能交汇，我真的很高兴。"

# game/chapters/chapter_three/chapter_three.rpy:4614
translate schinese scene_sixteen_label_13e8a528:

    # na "So then… what should we do first?"
    na "那么……我们先做什么？"

# game/chapters/chapter_three/chapter_three.rpy:4617
translate schinese scene_sixteen_label_ac0d643f:

    # mc "Ravena, do you know much about Lunebrook?"
    mc "拉维娜，你知道卢恩布鲁克的多少情况？"

# game/chapters/chapter_three/chapter_three.rpy:4620
translate schinese scene_sixteen_label_3c2b08fc:

    # rav "Can’t say I do…"
    rav "还真不知道……"

# game/chapters/chapter_three/chapter_three.rpy:4621
translate schinese scene_sixteen_label_6a1077e6:

    # rav "It’s a very remote town."
    rav "那是个很偏远的镇子。"

# game/chapters/chapter_three/chapter_three.rpy:4625
translate schinese scene_sixteen_label_7ac7a788:

    # gi "So we need to learn about this town."
    gi "所以我们得先了解这个镇子。"

# game/chapters/chapter_three/chapter_three.rpy:4628
translate schinese scene_sixteen_label_3a633da8:

    # mc "Correct."
    mc "正是。"

# game/chapters/chapter_three/chapter_three.rpy:4629
translate schinese scene_sixteen_label_57c34c97:

    # mc "We could even make it our base of operations."
    mc "说不定还能把它当成我们的大本营。"

# game/chapters/chapter_three/chapter_three.rpy:4632
translate schinese scene_sixteen_label_322d569f:

    # gi "Raising an army should be difficult."
    gi "召集军队应该很难。"

# game/chapters/chapter_three/chapter_three.rpy:4633
translate schinese scene_sixteen_label_527e931e:

    # gi "But I’m sure we can connect with other kingdoms."
    gi "但我敢肯定我们能联络上其他王国。"

# game/chapters/chapter_three/chapter_three.rpy:4636
translate schinese scene_sixteen_label_4429383f:

    # rav "Is that a good idea?"
    rav "这是个好主意吗？"

# game/chapters/chapter_three/chapter_three.rpy:4639
translate schinese scene_sixteen_label_120bca0b:

    # mc "Are relations between Temporia and other kingdoms hostile?"
    mc "坦皮奥拉和其他王国的关系紧张吗？"

# game/chapters/chapter_three/chapter_three.rpy:4642
translate schinese scene_sixteen_label_90cadb43:

    # rav "Not that I’m aware of…"
    rav "据我所知没有……"

# game/chapters/chapter_three/chapter_three.rpy:4645
translate schinese scene_sixteen_label_3e9dcfa6:

    # yu "But a turmoil within Temporia could lead to a power vacuum that another kingdom tries to fill."
    yu "但坦皮奥拉内部的动荡可能造成权力真空，其他王国就会想趁机填补。"

# game/chapters/chapter_three/chapter_three.rpy:4648
translate schinese scene_sixteen_label_a32a50b8:

    # rav "Precisely."
    rav "正是。"

# game/chapters/chapter_three/chapter_three.rpy:4651
translate schinese scene_sixteen_label_7781ed4b:

    # mc "But we can convince them to help us to restore the power of Temporia’s royal family."
    mc "但我们可以说服他们帮我们恢复坦皮奥拉王室的权力。"

# game/chapters/chapter_three/chapter_three.rpy:4654
translate schinese scene_sixteen_label_484d1db6:

    # na "Why would they want to do that and not take the power for themselves?"
    na "他们为什么要帮我们，而不是自己夺走权力？"

# game/chapters/chapter_three/chapter_three.rpy:4657
translate schinese scene_sixteen_label_09050e2e:

    # mc "For one, people aren’t eager to accept a foreign ruler too quickly."
    mc "首先，人们不会轻易接受一个外国统治者。"

# game/chapters/chapter_three/chapter_three.rpy:4658
translate schinese scene_sixteen_label_c41d5cff:

    # mc "It’d be more convenient for the nation to try to put a leader that’s favorable to them."
    mc "让一个对他们有利的领袖上位，对这个国家来说更划算。"

# game/chapters/chapter_three/chapter_three.rpy:4661
translate schinese scene_sixteen_label_7304d792:

    # mc "So by helping Ravena, the rightful ruler of Temporia, they earn a favor from her."
    mc "所以帮助拉维娜这位坦皮奥拉的正统统治者，就能欠她一个人情。"

# game/chapters/chapter_three/chapter_three.rpy:4662
translate schinese scene_sixteen_label_7b660df1:

    # mc "A pretty big one, at that."
    mc "而且是相当大的人情。"

# game/chapters/chapter_three/chapter_three.rpy:4665
translate schinese scene_sixteen_label_3a6307ac:

    # rav "That is true."
    rav "确实。"

# game/chapters/chapter_three/chapter_three.rpy:4666
translate schinese scene_sixteen_label_5e15b61b:

    # rav "I think I know who we can start asking help from."
    rav "我想我知道我们可以先向谁求助。"

# game/chapters/chapter_three/chapter_three.rpy:4669
translate schinese scene_sixteen_label_71455195:

    # gi "Is she far?"
    gi "她离得远吗？"

# game/chapters/chapter_three/chapter_three.rpy:4672
translate schinese scene_sixteen_label_dc2d7f84:

    # rav "Not too far from us."
    rav "离我们不算远。"

# game/chapters/chapter_three/chapter_three.rpy:4673
translate schinese scene_sixteen_label_4e306759:

    # rav "If anything, we’re headed in her direction."
    rav "我们正好往她那个方向走。"

# game/chapters/chapter_three/chapter_three.rpy:4676
translate schinese scene_sixteen_label_548a0c54:

    # na "Man, I love plot armor."
    na "天哪，我爱死这主角光环了。"

# game/chapters/chapter_three/chapter_three.rpy:4679
translate schinese scene_sixteen_label_177b0ebd:

    # mc "Can you tell me more about that kingdom?"
    mc "能多讲讲那个王国吗？"

# game/chapters/chapter_three/chapter_three.rpy:4682
translate schinese scene_sixteen_label_35a75080:

    # rav "Of course."
    rav "当然。"

# game/chapters/chapter_three/chapter_three.rpy:4683
translate schinese scene_sixteen_label_e13fb636:

    # rav "This kingdom is named Thalum, ruled by a beautiful queen named Sahar."
    rav "这个王国叫萨勒姆，由一位名叫萨哈尔的美丽女王统治。"

# game/chapters/chapter_three/chapter_three.rpy:4686
translate schinese scene_sixteen_label_7d0663c1:

    # yu "So it’s a matriarchy?"
    yu "所以是母系君主制？"

# game/chapters/chapter_three/chapter_three.rpy:4689
translate schinese scene_sixteen_label_160907f9:

    # rav "Correct."
    rav "正是。"

# game/chapters/chapter_three/chapter_three.rpy:4692
translate schinese scene_sixteen_label_3abccc78:

    # yu "Woah!"
    yu "哇！"

# game/chapters/chapter_three/chapter_three.rpy:4693
translate schinese scene_sixteen_label_f3458a56:

    # yu "That is so cool!"
    yu "太酷了！"

# game/chapters/chapter_three/chapter_three.rpy:4696
translate schinese scene_sixteen_label_0b570197:

    # gi "Are there no matriarchies in your world?"
    gi "你们那边没有母系君主制吗？"

# game/chapters/chapter_three/chapter_three.rpy:4699
translate schinese scene_sixteen_label_6032960b:

    # yu "No, only men rule."
    yu "没有，只有男人统治。"

# game/chapters/chapter_three/chapter_three.rpy:4702
translate schinese scene_sixteen_label_8832cd35:

    # gi "Interesting."
    gi "有意思。"

# game/chapters/chapter_three/chapter_three.rpy:4703
translate schinese scene_sixteen_label_9237c208:

    # gi "How do you feel about that?"
    gi "你怎么看？"

# game/chapters/chapter_three/chapter_three.rpy:4706
translate schinese scene_sixteen_label_a910a049:

    # yu "Hmmmm…"
    yu "嗯……"

# game/chapters/chapter_three/chapter_three.rpy:4709
translate schinese scene_sixteen_label_e8e093a2:

    # yu "I don’t care."
    yu "我不在乎。"

# game/chapters/chapter_three/chapter_three.rpy:4712
translate schinese scene_sixteen_label_46b76479:

    # na "You wouldn’t want to rule?"
    na "你不想统治？"

# game/chapters/chapter_three/chapter_three.rpy:4715
translate schinese scene_sixteen_label_93162b41:

    # yu "No!"
    yu "不！"

# game/chapters/chapter_three/chapter_three.rpy:4716
translate schinese scene_sixteen_label_d88db8d2:

    # yu "Too much responsibility."
    yu "责任太重了。"

# game/chapters/chapter_three/chapter_three.rpy:4717
translate schinese scene_sixteen_label_35a06cd5:

    # yu "Being an assassin is enough."
    yu "当个杀手就够了。"

# game/chapters/chapter_three/chapter_three.rpy:4720
translate schinese scene_sixteen_label_1124a0bb:

    # rav "*Giggles* She gets it."
    rav "*咯咯笑* 她很懂。"

# game/chapters/chapter_three/chapter_three.rpy:4723
translate schinese scene_sixteen_label_27bb54d3:

    # mc "What else can you tell me from this kingdom?"
    mc "这个国家的还有什么是你能讲的？"

# game/chapters/chapter_three/chapter_three.rpy:4726
translate schinese scene_sixteen_label_9a79f994:

    # rav "Well, you’d have to pose as our servant, [playername]."
    rav "嗯，你得假扮成我们的仆人，[playername]。"

# game/chapters/chapter_three/chapter_three.rpy:4729
translate schinese scene_sixteen_label_22e110c9:

    # na "Oh boy, I’d love to have him be my servant."
    na "哎，我倒是很想让他当我的仆人。"

# game/chapters/chapter_three/chapter_three.rpy:4731
translate schinese scene_sixteen_label_e5392b07:

    # gi "You can say that again."
    gi "我完全同意。"

# game/chapters/chapter_three/chapter_three.rpy:4734
translate schinese scene_sixteen_label_46f1afbc:

    # mc "*Sigh*"
    mc "*叹气*"

# game/chapters/chapter_three/chapter_three.rpy:4735
translate schinese scene_sixteen_label_3be9c249:

    # mc "I can do that, though."
    mc "不过这我倒是做得到。"

# game/chapters/chapter_three/chapter_three.rpy:4738
translate schinese scene_sixteen_label_7e87467e:

    # rav "They also have a different belief system than we do."
    rav "他们的信仰体系也跟我们不一样。"

# game/chapters/chapter_three/chapter_three.rpy:4741
translate schinese scene_sixteen_label_1b6ac4b4:

    # yu "Oh?"
    yu "哦？"

# game/chapters/chapter_three/chapter_three.rpy:4744
translate schinese scene_sixteen_label_3fd5b0ea:

    # rav "Although they believe in Luminox, they also believe the Queen has the spirit of the goddess."
    rav "虽然他们也信奉露米诺克斯，但他们还相信女王身怀女神的灵魂。"

# game/chapters/chapter_three/chapter_three.rpy:4747
translate schinese scene_sixteen_label_52c17e49:

    # mc "Fine, I’ll buy that."
    mc "好吧，我就信了。"

# game/chapters/chapter_three/chapter_three.rpy:4750
translate schinese scene_sixteen_label_5ca282f2:

    # rav "You’re willing to believe that?"
    rav "你愿意信这个？"

# game/chapters/chapter_three/chapter_three.rpy:4753
translate schinese scene_sixteen_label_0b6cf116:

    # mc "I don’t see why not."
    mc "我看没理由不上。"

# game/chapters/chapter_three/chapter_three.rpy:4754
translate schinese scene_sixteen_label_18d855f2:

    # mc "It’s definitely possible."
    mc "这完全有可能。"

# game/chapters/chapter_three/chapter_three.rpy:4757
translate schinese scene_sixteen_label_10b2be0a:

    # rav "I don’t know if I find your will to believe this disturbing or calming."
    rav "我不知道该说你这种愿意相信的样子让人不安还是让人安心。"

# game/chapters/chapter_three/chapter_three.rpy:4760
translate schinese scene_sixteen_label_758b9cae:

    # na "I think it’s more so that we’re willing to accept it all things considered."
    na "我觉得更多是因为综合考虑之下我们愿意接受。"

# game/chapters/chapter_three/chapter_three.rpy:4763
translate schinese scene_sixteen_label_2c7f280c:

    # mc "It’s an easy way to not offend them."
    mc "这是个不冒犯他们的省事办法。"

# game/chapters/chapter_three/chapter_three.rpy:4764
translate schinese scene_sixteen_label_65fa197d:

    # mc "That’s the last thing we want to do."
    mc "这是我们最不想做的事。"

# game/chapters/chapter_three/chapter_three.rpy:4767
translate schinese scene_sixteen_label_36ad43f8:

    # rav "Fair point."
    rav "有道理。"

# game/chapters/chapter_three/chapter_three.rpy:4770
translate schinese scene_sixteen_label_d662ff4d:

    # yu "Will she take advantage of you?"
    yu "她会占你的便宜吗？"

# game/chapters/chapter_three/chapter_three.rpy:4773
translate schinese scene_sixteen_label_0294b609_1:

    # rav "What do you mean?"
    rav "什么意思？"

# game/chapters/chapter_three/chapter_three.rpy:4776
translate schinese scene_sixteen_label_f3b07176:

    # yu "If we get them to help us, will it come back to haunt us in the future?"
    yu "如果让他们帮了我们，将来会不会反过来找我们的麻烦？"

# game/chapters/chapter_three/chapter_three.rpy:4779
translate schinese scene_sixteen_label_acd5184b:

    # rav "I like to think not."
    rav "我愿意相信不会。"

# game/chapters/chapter_three/chapter_three.rpy:4780
translate schinese scene_sixteen_label_d4de17e5:

    # rav "From what I’ve heard, Thalum and Temporia have had a pretty long lasting relationship going on."
    rav "据我所知，萨勒姆和坦皮奥拉的往来由来已久。"

# game/chapters/chapter_three/chapter_three.rpy:4781
translate schinese scene_sixteen_label_9ad66705:

    # rav "And Queen Sahar was pretty close to mom and dad."
    rav "而且萨哈尔女王跟爸爸妈妈相当亲近。"

# game/chapters/chapter_three/chapter_three.rpy:4782
translate schinese scene_sixteen_label_9684be5a:

    # rav "We should be fine."
    rav "我们应该没问题。"

# game/chapters/chapter_three/chapter_three.rpy:4785
translate schinese scene_sixteen_label_bbea2d13:

    # gi "Then we should consider going there."
    gi "那我们就该考虑去一趟。"

# game/chapters/chapter_three/chapter_three.rpy:4788
translate schinese scene_sixteen_label_fcf340b6:

    # mc "I agree."
    mc "我同意。"

# game/chapters/chapter_three/chapter_three.rpy:4789
translate schinese scene_sixteen_label_55a275f9:

    # mc "Joining forces with someone that powerful could work perfectly."
    mc "跟那样强大的人联手，绝对可行。"

# game/chapters/chapter_three/chapter_three.rpy:4792
translate schinese scene_sixteen_label_8e4eed92:

    # mc "The people look at the king and queen favorably."
    mc "百姓对国王和王后印象很好。"

# game/chapters/chapter_three/chapter_three.rpy:4793
translate schinese scene_sixteen_label_8da4ab78:

    # mc "So we can even start amassing influence away from the capital and take away from the Chancellor."
    mc "所以我们可以在王都之外积累势力，从宰相手里一点点夺走。"

# game/chapters/chapter_three/chapter_three.rpy:4796
translate schinese scene_sixteen_label_cb6acff7:

    # rav "A possible solution."
    rav "这倒是个可行的办法。"

# game/chapters/chapter_three/chapter_three.rpy:4799
translate schinese scene_sixteen_label_df00ebf6:

    # na "If we can get farmers and such to follow us, we should be able to really hit the chancellor where it hurts."
    na "如果能让农民之类的人追随我们，就能真正打到宰相的痛处。"

# game/chapters/chapter_three/chapter_three.rpy:4802
translate schinese scene_sixteen_label_440f51b4:

    # rav "And have my people starve?"
    rav "让我的子民挨饿？"

# game/chapters/chapter_three/chapter_three.rpy:4805
translate schinese scene_sixteen_label_875de3cc:

    # na "Not necessarily."
    na "不一定。"

# game/chapters/chapter_three/chapter_three.rpy:4806
translate schinese scene_sixteen_label_c4a34d1a:

    # na "We allow those in the capital to come out and join us."
    na "我们允许王都里的人出来加入我们。"

# game/chapters/chapter_three/chapter_three.rpy:4807
translate schinese scene_sixteen_label_617dc0a1:

    # na "We offer them food, medical assistance."
    na "我们提供食物和医疗援助。"

# game/chapters/chapter_three/chapter_three.rpy:4808
translate schinese scene_sixteen_label_e0cccfa9:

    # na "Anything they need while we retake the kingdom."
    na "在我们夺回王国期间，他们需要什么我们都提供。"

# game/chapters/chapter_three/chapter_three.rpy:4811
translate schinese scene_sixteen_label_7a2fc013:

    # gi "That’s not a bad idea."
    gi "这主意不赖。"

# game/chapters/chapter_three/chapter_three.rpy:4812
translate schinese scene_sixteen_label_b7838072:

    # gi "We can make the chancellor look real bad if we go at it this way."
    gi "这样做能让宰相很难看。"

# game/chapters/chapter_three/chapter_three.rpy:4815
translate schinese scene_sixteen_label_82ad1855:

    # rav "And if the chancellor refuses?"
    rav "要是宰相拒绝呢？"

# game/chapters/chapter_three/chapter_three.rpy:4818
translate schinese scene_sixteen_label_34b2b698:

    # gi "We could always send aid as well, but just enough to ensure people do not suffer."
    gi "我们也可以提供援助，但只给到让百姓不至于受苦的程度。"

# game/chapters/chapter_three/chapter_three.rpy:4821
translate schinese scene_sixteen_label_a0314473:

    # yu "I can sneak into the castle walls as well and start planting seeds of rebellion within the people."
    yu "我也能潜入城堡，在人们心里埋下反叛的种子。"

# game/chapters/chapter_three/chapter_three.rpy:4824
translate schinese scene_sixteen_label_58596c39:

    # mc "Like I said, Ravena, we have your back."
    mc "我说过了，拉维娜，我们支持你。"

# game/chapters/chapter_three/chapter_three.rpy:4825
translate schinese scene_sixteen_label_e9c1fd67:

    # mc "You’ll come back stronger than ever."
    mc "你回来时会比以往更强。"

# game/chapters/chapter_three/chapter_three.rpy:4826
translate schinese scene_sixteen_label_f7226a9b:

    # mc "And in the meantime, I can ask Sophia to investigate what happened to your parents."
    mc "与此同时，我可以请索菲娅调查你父母到底出了什么事。"

# game/chapters/chapter_three/chapter_three.rpy:4829
translate schinese scene_sixteen_label_e5acf679:

    # rav "You still want her help?"
    rav "你还想要她帮忙？"

# game/chapters/chapter_three/chapter_three.rpy:4832
translate schinese scene_sixteen_label_1efcff39:

    # mc "I don’t see why we shouldn’t have her be our ally."
    mc "我看不出有什么理由不让她当我们的盟友。"

# game/chapters/chapter_three/chapter_three.rpy:4833
translate schinese scene_sixteen_label_1fa95d4e:

    # mc "Remember, I still need to train my powers."
    mc "别忘了，我还需要训练我的力量。"

# game/chapters/chapter_three/chapter_three.rpy:4836
translate schinese scene_sixteen_label_7d239f46:

    # rav "I guess you’re right…"
    rav "我猜你说得对……"

# game/chapters/chapter_three/chapter_three.rpy:4839
translate schinese scene_sixteen_label_8b44dc20:

    # na "She’s really sweet, Ravena."
    na "她人真的很好，拉维娜。"

# game/chapters/chapter_three/chapter_three.rpy:4840
translate schinese scene_sixteen_label_75195396:

    # na "I think you’ll end up liking her."
    na "我觉得最后你会喜欢她的。"

# game/chapters/chapter_three/chapter_three.rpy:4843
translate schinese scene_sixteen_label_ee8e1d1b:

    # rav "I know… I’m just…"
    rav "我知道……我只是……"

# game/chapters/chapter_three/chapter_three.rpy:4844
translate schinese scene_sixteen_label_51f15949:

    # rav "It’s tough to suddenly change what you grew up believing in, you know?"
    rav "你知道，突然改变自己从小信仰的东西很难吧？"

# game/chapters/chapter_three/chapter_three.rpy:4847
translate schinese scene_sixteen_label_b4261c4e:

    # mc "What’d your parents say about her?"
    mc "你父母怎么说她？"

# game/chapters/chapter_three/chapter_three.rpy:4850
translate schinese scene_sixteen_label_c75dcd76:

    # rav "Hmmmmm…"
    rav "嗯……"

# game/chapters/chapter_three/chapter_three.rpy:4851
translate schinese scene_sixteen_label_194fe179:

    # rav "Not much actually…"
    rav "其实没怎么说……"

# game/chapters/chapter_three/chapter_three.rpy:4854
translate schinese scene_sixteen_label_90958774:

    # na "How about we talk about something else?"
    na "我们换个话题吧？"

# game/chapters/chapter_three/chapter_three.rpy:4855
translate schinese scene_sixteen_label_9d82616c:

    # na "We shouldn’t be barraging Ravena right now with questions."
