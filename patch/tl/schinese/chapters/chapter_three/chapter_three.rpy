translate schinese scene_fifteen_label_bcb8f7cf:

    # bm "What’d the chancellor do?"
    bm "宰相做了什么？"

# game/chapters/chapter_three/chapter_three.rpy:3904
translate schinese scene_fifteen_label_4ce01e59:

    # mc "Your excellency, I know this will sound like we’re trying to make out the chancellor to be a demon but…"
    mc "阁下，我知道这听起来像是在把宰相说成恶魔，可是……"

# game/chapters/chapter_three/chapter_three.rpy:3907
translate schinese scene_fifteen_label_8d77719c:

    # bm "Thus sayeth Luminox: truth shall prevail."
    bm "露米诺克斯如是说：真相必胜。"

# game/chapters/chapter_three/chapter_three.rpy:3908
translate schinese scene_fifteen_label_fe154aef:

    # bm "We need all the information available to us so that we may investigate it."
    bm "我们需要掌握一切能得到的信息，以便调查。"

# game/chapters/chapter_three/chapter_three.rpy:3911
translate schinese scene_fifteen_label_765c50a0:

    # mc "Of course, I know you’d understand the position we find ourselves in, though."
    mc "当然，我知道你理解我们的处境。"

# game/chapters/chapter_three/chapter_three.rpy:3914
translate schinese scene_fifteen_label_49c8203a:

    # bm "Naturally, but we’ve had our eye on the chancellor for a while already."
    bm "那当然，不过我们盯着宰相已经有一段时间了。"

# game/chapters/chapter_three/chapter_three.rpy:3915
translate schinese scene_fifteen_label_ed6b40b5:

    # bm "To say he’s been acting erratic would be an understatement."
    bm "说他行事乖张都算轻描淡写了。"

# game/chapters/chapter_three/chapter_three.rpy:3918
translate schinese scene_fifteen_label_ca321ec9:

    # mc "The chancellor accused us of terrorism and tried to get us executed."
    mc "宰相指控我们是恐怖分子，还想处死我们。"

# game/chapters/chapter_three/chapter_three.rpy:3921
translate schinese scene_fifteen_label_3b92f7c6:

    # bm "He what?"
    bm "他什么？"

# game/chapters/chapter_three/chapter_three.rpy:3924
translate schinese scene_fifteen_label_974e1556:

    # mc "Despite Bishop Jane clearly sentencing us to three days in prison, he still tried to get us executed."
    mc "尽管简主教明明判我们三天监禁，他还是想处死我们。"

# game/chapters/chapter_three/chapter_three.rpy:3925
translate schinese scene_fifteen_label_40e93715:

    # mc "So then we had to escape the prison."
    mc "所以我们只好逃狱。"

# game/chapters/chapter_three/chapter_three.rpy:3928
translate schinese scene_fifteen_label_eaee0b35:

    # bm "Of course, that makes perfect sense."
    bm "当然，这就完全说得通了。"

# game/chapters/chapter_three/chapter_three.rpy:3931
translate schinese scene_fifteen_label_dc1e6db4:

    # bm "I sincerely apologize for this situation, this requires the Church to launch a full investigation as to what is going on."
    bm "我为这件事深表歉意，教会必须对到底发生了什么展开全面调查。"

# game/chapters/chapter_three/chapter_three.rpy:3934
translate schinese scene_fifteen_label_3fc72cb6:

    # bm "I fear we might be looking at the rise of another Dark Caster."
    bm "我担心我们可能正目睹另一位暗系施法者的崛起。"

# game/chapters/chapter_three/chapter_three.rpy:3937
translate schinese scene_fifteen_label_4002db1f:

    # rav "I am sure there is a perfectly reasonable explanation behind this, your excellency."
    rav "我相信这背后一定有完全合理的解释，阁下。"

# game/chapters/chapter_three/chapter_three.rpy:3940
translate schinese scene_fifteen_label_d60765f7:

    # bm "No. We cannot take a risk."
    bm "不。我们不能冒险。"

# game/chapters/chapter_three/chapter_three.rpy:3941
translate schinese scene_fifteen_label_4e62dc73:

    # bm "We must avoid another conflict like the one 500 years ago."
    bm "我们必须避免再来一场五百年前那样的冲突。"

# game/chapters/chapter_three/chapter_three.rpy:3944
translate schinese scene_fifteen_label_8fcf8a08:

    # mc "Can’t say I disagree with that."
    mc "这点我没法反驳。"

# game/chapters/chapter_three/chapter_three.rpy:3945
translate schinese scene_fifteen_label_d4a52ca2:

    # mc "What can we do to assist?"
    mc "我们能帮上什么忙？"

# game/chapters/chapter_three/chapter_three.rpy:3948
translate schinese scene_fifteen_label_ebebff37:

    # bm "You must keep Princess Celeste alive at all costs as she is the heir to the throne."
    bm "无论付出什么代价，你们都必须保住塞莱斯特公主的性命，她是王位继承人。"

# game/chapters/chapter_three/chapter_three.rpy:3951
translate schinese scene_fifteen_label_7233a004:

    # yu "I can do that."
    yu "我做得到。"

# game/chapters/chapter_three/chapter_three.rpy:3954
translate schinese scene_fifteen_label_5618e85b:

    # bm "It puts my heart at ease to know her highness has truly made some good friends."
    bm "得知殿下真的交到了好朋友，我也就安心了。"

# game/chapters/chapter_three/chapter_three.rpy:3955
translate schinese scene_fifteen_label_f2e017e6:

    # bm "I will also inform the Meliode Tribe about the current situation."
    bm "我也会把目前的情况告知梅利奥德部落。"

# game/chapters/chapter_three/chapter_three.rpy:3958
translate schinese scene_fifteen_label_ed31af57:

    # mc "Who-"
    mc "谁——"

# game/chapters/chapter_three/chapter_three.rpy:3960
translate schinese scene_fifteen_label_1682f755:

    # rav "Milena’s tribe."
    rav "米莱娜的部落。"

# game/chapters/chapter_three/chapter_three.rpy:3961
translate schinese scene_fifteen_label_4636c0ed:

    # rav "Thank you, your excellency."
    rav "谢谢您，阁下。"

# game/chapters/chapter_three/chapter_three.rpy:3962
translate schinese scene_fifteen_label_5156c9d8:

    # rav "Can you tell me more about Lunebrook?"
    rav "能跟我们多说说卢恩布鲁克吗？"

# game/chapters/chapter_three/chapter_three.rpy:3965
translate schinese scene_fifteen_label_fbf7ad5e:

    # bm "Of course."
    bm "当然。"

# game/chapters/chapter_three/chapter_three.rpy:3968
translate schinese scene_fifteen_label_4364b193:

    # bm "This village is very far from the capital. You will be travelling throughout the night in order to reach there."
    bm "那个村子离王都很远，你们要连夜赶路才能到。"

# game/chapters/chapter_three/chapter_three.rpy:3969
translate schinese scene_fifteen_label_9c243def:

    # bm "It is a peaceful village, but not a luxurious one."
    bm "那是个安宁的村子，但并不奢华。"

# game/chapters/chapter_three/chapter_three.rpy:3972
translate schinese scene_fifteen_label_4e0139f7:

    # bm "Life will be uncomfortable there."
    bm "在那里生活会比较艰苦。"

# game/chapters/chapter_three/chapter_three.rpy:3973
translate schinese scene_fifteen_label_94dea253:

    # bm "But Luminox will reward you for your patience."
    bm "但露米诺克斯会回报你们的耐心。"

# game/chapters/chapter_three/chapter_three.rpy:3976
translate schinese scene_fifteen_label_8fcd180d:

    # mc "Seems like there’s no other choice."
    mc "看来也没别的选择了。"

# game/chapters/chapter_three/chapter_three.rpy:3977
translate schinese scene_fifteen_label_d9970bff:

    # mc "How will we keep in touch?"
    mc "我们怎么保持联络？"

# game/chapters/chapter_three/chapter_three.rpy:3980
translate schinese scene_fifteen_label_6db855c7:

    # bm "We will find a way to contact you if anything major happens."
    bm "一旦有重大情况，我们会想办法联系你们。"

# game/chapters/chapter_three/chapter_three.rpy:3983
translate schinese scene_fifteen_label_54879062:

    # mc "We sincerely appreciate the help."
    mc "我们由衷感谢你们的帮助。"

# game/chapters/chapter_three/chapter_three.rpy:3986
translate schinese scene_fifteen_label_556873f7:

    # bm "Oh! And before you leave."
    bm "哦！对了，你们走之前。"

# game/chapters/chapter_three/chapter_three.rpy:3987
translate schinese scene_fifteen_label_99458836:

    # bm "Follow me really quickly."
    bm "跟我来一下。"

# game/chapters/chapter_three/chapter_three.rpy:3993
translate schinese scene_fifteen_label_5fd2997d:

    # mc "Where exactly are we?"
    mc "我们现在到底在哪儿？"

# game/chapters/chapter_three/chapter_three.rpy:3996
translate schinese scene_fifteen_label_bb301510:

    # bm "The church’s armory."
    bm "教会的军械库。"

# game/chapters/chapter_three/chapter_three.rpy:3999
translate schinese scene_fifteen_label_ba7e20ce:

    # gi "Why would you need an armory?"
    gi "你为什么需要军械库？"

# game/chapters/chapter_three/chapter_three.rpy:4002
translate schinese scene_fifteen_label_a29c3eb2:

    # bm "In case a situation like this rises up."
    bm "以防出现今天这种情况。"

# game/chapters/chapter_three/chapter_three.rpy:4003
translate schinese scene_fifteen_label_42c75395:

    # bm "Historically, the Church has always been the last line of defense against Dark Casters."
    bm "历史上，教会一直是抵御暗系施法者的最后一道防线。"

# game/chapters/chapter_three/chapter_three.rpy:4006
translate schinese scene_fifteen_label_2f29f394:

    # mc "Dark Casters specifically?"
    mc "专指暗系施法者吗？"

# game/chapters/chapter_three/chapter_three.rpy:4009
translate schinese scene_fifteen_label_561d4bd6:

    # bm "Any sort of person that may try to take over the kingdom and upset the balance of the world."
    bm "任何企图夺取王国、扰乱世界平衡的人。"

# game/chapters/chapter_three/chapter_three.rpy:4012
translate schinese scene_fifteen_label_054c5ee0:

    # mc "I see."
    mc "我明白了。"

# game/chapters/chapter_three/chapter_three.rpy:4015
translate schinese scene_fifteen_label_708551f3:

    # na "So…"
    na "那么……"

# game/chapters/chapter_three/chapter_three.rpy:4016
translate schinese scene_fifteen_label_3732daea:

    # na "We’re getting weapons now?"
    na "现在要领武器吗？"

# game/chapters/chapter_three/chapter_three.rpy:4019
translate schinese scene_fifteen_label_a987cde9:

    # bm "Indeed."
    bm "正是。"

# game/chapters/chapter_three/chapter_three.rpy:4020
translate schinese scene_fifteen_label_b93a11b4:

    # bm "It is dangerous to go alone."
    bm "一个人上路太危险了。"

# game/chapters/chapter_three/chapter_three.rpy:4023
translate schinese scene_fifteen_label_5636682f:

    # gi "How do we even know what kind of weapon to use?"
    gi "我们怎么知道该用什么武器？"

# game/chapters/chapter_three/chapter_three.rpy:4026
translate schinese scene_fifteen_label_cc9c3806:

    # bm "The weapons will choose you."
    bm "武器会选择你。"

# game/chapters/chapter_three/chapter_three.rpy:4029
translate schinese scene_fifteen_label_c4c977ba_1:

    # gi "What?"
    gi "什么？"

# game/chapters/chapter_three/chapter_three.rpy:4032
translate schinese scene_fifteen_label_361cd0ac:

    # bm "There are two types of weapons in this world."
    bm "这世上有两种武器。"

# game/chapters/chapter_three/chapter_three.rpy:4033
