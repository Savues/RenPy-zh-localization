translate schinese scene_fifteen_label_27cd4dc6:

    # na "[playername] and Yuki can probably pass as bodyguards…"
    na "[playername]和由纪大概能冒充保镖……"

# game/chapters/chapter_three/chapter_three.rpy:3825
translate schinese scene_fifteen_label_372fa219:

    # na "But then the three of us…"
    na "可我们三个……"

