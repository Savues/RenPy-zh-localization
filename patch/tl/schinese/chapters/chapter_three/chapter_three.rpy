translate schinese scene_fifteen_label_b74905e3:

    # rav "D-d-don’t call me that."
    rav "别、别那么叫我。"

# game/chapters/chapter_three/chapter_three.rpy:3807
translate schinese scene_fifteen_label_d8870bc2:

    # na "*Laughing* Aww… why not, your highness?"
    na "*笑* 哎……为什么不行呢，殿下？"

# game/chapters/chapter_three/chapter_three.rpy:3809
translate schinese scene_fifteen_label_27cf5e53:

    # gi "We truly are blessed to have you in our presence!"
    gi "有您在我们身边，真是我们的福气！"

# game/chapters/chapter_three/chapter_three.rpy:3812
translate schinese scene_fifteen_label_02809705:

    # rav "*Sigh* Maybe I should just embrace it…"
    rav "*叹气* 也许我干脆认了……"

