translate schinese scene_fifteen_label_29b10471:

    # gi "*Giggles* Oh merciful Princess Ravena, please have mercy!"
    gi "*咯咯笑* 哦，仁慈的拉维娜公主，请高抬贵手！"

# game/chapters/chapter_three/chapter_three.rpy:3838
translate schinese scene_fifteen_label_4966565b:

    # rav "Thank you… you all have no idea how much I needed this quick laugh."
    rav "谢谢……你们不知道我有多需要这点快速的笑声。"

# game/chapters/chapter_three/chapter_three.rpy:3841
translate schinese scene_fifteen_label_69a695bb:

    # na "It’s nice to see our group getting along so well."
    na "看到我们这个小队相处得这么好，真不错。"

# game/chapters/chapter_three/chapter_three.rpy:3843
translate schinese scene_fifteen_label_79deecbe:

    # mc "Indeed."
    mc "正是。"

# game/chapters/chapter_three/chapter_three.rpy:3845
translate schinese scene_fifteen_label_74753a03:

    # mc "Anyway ladies, ready to head out?"
    mc "总之各位，准备出发了吗？"

# game/chapters/chapter_three/chapter_three.rpy:3846
translate schinese scene_fifteen_label_6ed39057:

    # mc "We’ve got very important business to attend to."
    mc "我们有很重要的事要办。"

# game/chapters/chapter_three/chapter_three.rpy:3855
translate schinese scene_fifteen_label_f2cd65f1:

    # bm "These news are very disturbing."
    bm "这些消息实在让人不安。"

# game/chapters/chapter_three/chapter_three.rpy:3856
translate schinese scene_fifteen_label_1a87af43:

    # bm "I knew the chancellor’s methods were… unorthodox…"
    bm "我早知道宰相的手段……不太寻常……"

# game/chapters/chapter_three/chapter_three.rpy:3858
translate schinese scene_fifteen_label_962eb728:

    # bm "But him taking control of Temporia just like that is truly concerning."
    bm "但他就这样掌控了坦皮奥拉，确实令人担忧。"

# game/chapters/chapter_three/chapter_three.rpy:3861
translate schinese scene_fifteen_label_24794efa:

    # mc "You’d understand why we don’t feel safe here anymore, your excellency."
    mc "阁下应该能理解我们为什么在这里再也感觉不安全了。"

# game/chapters/chapter_three/chapter_three.rpy:3864
translate schinese scene_fifteen_label_de744500:

    # bm "Yes, of course."
    bm "当然可以。"

# game/chapters/chapter_three/chapter_three.rpy:3867
translate schinese scene_fifteen_label_e89153ae:

    # bm "Selena?"
    bm "塞莱娜？"

# game/chapters/chapter_three/chapter_three.rpy:3870
translate schinese scene_fifteen_label_e32e5816:

    # se "Yes, bishop?"
    se "是的，主教？"

# game/chapters/chapter_three/chapter_three.rpy:3873
translate schinese scene_fifteen_label_d0815506:

    # bm "Please see that they can get a carriage to the outskirts of the kingdom."
    bm "请安排一辆马车送他们到王城郊外。"

# game/chapters/chapter_three/chapter_three.rpy:3876
translate schinese scene_fifteen_label_e8cec778:

    # se "Shall we make it so they go to Lunebrook?"
    se "送他们去卢恩布鲁克好吗？"

# game/chapters/chapter_three/chapter_three.rpy:3879
translate schinese scene_fifteen_label_cc3e297d:

    # bm "You read my mind."
    bm "你正合我意。"

# game/chapters/chapter_three/chapter_three.rpy:3882
translate schinese scene_fifteen_label_b4492560:

    # se "It shall be done, then."
    se "那就这样办。"

# game/chapters/chapter_three/chapter_three.rpy:3885
translate schinese scene_fifteen_label_d8ed52b5:

    # bm "Now, is it true that you were incarcerated?"
    bm "那么，你们真的被关押了吗？"

# game/chapters/chapter_three/chapter_three.rpy:3888
translate schinese scene_fifteen_label_927ca41f:

    # mc "Yes, your excellency. For aiding the princess on her escapade."
    mc "是的，阁下。因为协助公主私自出走。"

# game/chapters/chapter_three/chapter_three.rpy:3891
translate schinese scene_fifteen_label_abd29cf5:

    # bm "*Exasperated sigh* Of course Jane said that."
    bm "*无奈地叹气* 当然是简那么说的。"

# game/chapters/chapter_three/chapter_three.rpy:3892
translate schinese scene_fifteen_label_843ce76c:

    # bm "I’ll need to have a word with her."
    bm "我得跟她谈谈。"

# game/chapters/chapter_three/chapter_three.rpy:3895
translate schinese scene_fifteen_label_bf8961a2:

    # na "The chancellor even-"
    na "宰相居然——"

