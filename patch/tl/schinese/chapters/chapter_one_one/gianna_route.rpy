# game/chapters/chapter_one_one/gianna_route.rpy:6
translate schinese gianna_route_label_49a2a3a0:

    # "You feel a fierce heat coming from the other side of the gate. Will you proceed?"
    "门的另一边传来灼人的热浪。你要继续前进吗？"

# game/chapters/chapter_one_one/gianna_route.rpy:24
translate schinese gianna_route_label_6a02c183:

    # mc "(Hmmm… an office?)"
    mc "（唔……办公室？）"

# game/chapters/chapter_one_one/gianna_route.rpy:27
translate schinese gianna_route_label_5c2a2777:

    # mc "Excuse me… miss?"
    mc "不好意思……小姐？"

# game/chapters/chapter_one_one/gianna_route.rpy:30
translate schinese gianna_route_label_24ce3e79:

    # gi "W-what?"
    gi "什、什么？"

# game/chapters/chapter_one_one/gianna_route.rpy:33
translate schinese gianna_route_label_c5e0529d:

    # gi "W-who are you?"
    gi "你、你是谁？"

# game/chapters/chapter_one_one/gianna_route.rpy:34
translate schinese gianna_route_label_c8421ff2:

    # gi "How did you get in here?"
    gi "你是怎么进来的？"

# game/chapters/chapter_one_one/gianna_route.rpy:37
translate schinese gianna_route_label_901488f7:

    # mc "Hello, my name is [playername]."
    mc "你好，我叫[playername]。"

# game/chapters/chapter_one_one/gianna_route.rpy:42
translate schinese gianna_route_label_c38bf33b:

    # gi "Gianna."
    gi "吉安娜。"

# game/chapters/chapter_one_one/gianna_route.rpy:45
translate schinese gianna_route_label_70cfbcb1:

    # mc "I’m here to help you get out of here, Gianna."
    mc "我是来帮你离开这里的，吉安娜。"

# game/chapters/chapter_one_one/gianna_route.rpy:48
translate schinese gianna_route_label_8edb5c0b:

    # gi "Yes… perfect."
    gi "好……太好了。"

# game/chapters/chapter_one_one/gianna_route.rpy:51
translate schinese gianna_route_label_35cd6547:

    # gi "Just… one question, though…"
    gi "不过……有一个问题……"

# game/chapters/chapter_one_one/gianna_route.rpy:52
translate schinese gianna_route_label_9ca9e5a1:

    # gi "Where exactly is here?"
    gi "这里到底是哪？"

# game/chapters/chapter_one_one/gianna_route.rpy:55
translate schinese gianna_route_label_e1d81158:

    # mc "That’s… a long story."
    mc "这个……说来话长。"

# game/chapters/chapter_one_one/gianna_route.rpy:56
translate schinese gianna_route_label_df41b7c2:

    # mc "I’m not entirely sure myself."
    mc "我自己也不太确定。"

# game/chapters/chapter_one_one/gianna_route.rpy:59
translate schinese gianna_route_label_1472ec01:

    # gi "And I should trust you because..?"
    gi "我凭什么相信你……？"

# game/chapters/chapter_one_one/gianna_route.rpy:62
translate schinese gianna_route_label_91dbf74e:

    # mc "I’m a detective."
    mc "我是一名侦探。"

# game/chapters/chapter_one_one/gianna_route.rpy:63
translate schinese gianna_route_label_594077b7:

    # mc "It is my duty to protect people regardless of where I am."
    mc "不管身在何处，保护人都是我的职责。"

# game/chapters/chapter_one_one/gianna_route.rpy:66
translate schinese gianna_route_label_fa5874bf:

    # gi "*Giggles* How noble of you."
    gi "*咯咯笑* 你可真高尚。"

# game/chapters/chapter_one_one/gianna_route.rpy:69
translate schinese gianna_route_label_aef9f002:

    # gi "This does put me a bit at ease but…"
    gi "这确实让我安心了一点，但……"

# game/chapters/chapter_one_one/gianna_route.rpy:72
translate schinese gianna_route_label_ba37706d:

    # gi "But I need some sort of guarantee that I can trust you."
    gi "但我需要某种保证，才能相信你。"

# game/chapters/chapter_one_one/gianna_route.rpy:77
translate schinese gianna_route_label_53c20a85:

    # mc "I mean… shit."
    mc "我是说……靠。"

# game/chapters/chapter_one_one/gianna_route.rpy:78
translate schinese gianna_route_label_de641316:

    # mc "Can’t think of any good reason other than just trust me."
    mc "除了直接相信你，我想不出别的理由。"

# game/chapters/chapter_one_one/gianna_route.rpy:81
translate schinese gianna_route_label_1f20aedd:

    # gi "I suppose I have no other option, huh?"
    gi "看来我没别的选择了，是吧？"

# game/chapters/chapter_one_one/gianna_route.rpy:84
translate schinese gianna_route_label_47402ea1:

    # mc "I wouldn’t put it that way."
    mc "我倒不会这么说。"

# game/chapters/chapter_one_one/gianna_route.rpy:85
translate schinese gianna_route_label_3fa9d4ce:

    # mc "I’ll help you get out of here and you’ll decide if you can trust me or not."
    mc "我帮你离开这里，之后你自己判断能不能信我。"

# game/chapters/chapter_one_one/gianna_route.rpy:91
translate schinese gianna_route_label_8203cf90:

    # mc "I could give you...{w} my gun."
    mc "我可以把……{w}我的枪给你。"

# game/chapters/chapter_one_one/gianna_route.rpy:94
translate schinese gianna_route_label_9af41b16:

    # gi "W-what?!"
    gi "什、什么？！"

# game/chapters/chapter_one_one/gianna_route.rpy:97
translate schinese gianna_route_label_4402c1c0:

    # mc "Yeah, I’m willing to give you my weapon so that you can see I mean no harm."
    mc "对，我愿意把武器交给你，让你知道我没有恶意。"

# game/chapters/chapter_one_one/gianna_route.rpy:100
translate schinese gianna_route_label_20bc8f45:

    # gi "This is incredibly stupid, you realize that, right?"
    gi "你知道这有多蠢吧？"

# game/chapters/chapter_one_one/gianna_route.rpy:103
translate schinese gianna_route_label_a07ee2e4:

    # mc "Fortune favors the bold."
    mc "不入虎穴，焉得虎子。"

# game/chapters/chapter_one_one/gianna_route.rpy:106
translate schinese gianna_route_label_e7425605:

    # gi "*Giggles* Fine, Mr. Officer. I trust you. Keep your gun."
    gi "*咯咯笑* 好吧，警官先生。我信你了，枪你留着。"

# game/chapters/chapter_one_one/gianna_route.rpy:109
translate schinese gianna_route_label_38b65ebd:

    # mc "Thank you kindly, miss."
    mc "多谢，小姐。"

# game/chapters/chapter_one_one/gianna_route.rpy:112
translate schinese gianna_route_label_8f33340a:

    # gi "So then… what now?"
    gi "那么……接下来怎么办？"

# game/chapters/chapter_one_one/gianna_route.rpy:115
translate schinese gianna_route_label_466d9443:

    # mc "Well, if this is anything like the place I was in…"
    mc "嗯，如果这里和我之前待的地方差不多……"

# game/chapters/chapter_one_one/gianna_route.rpy:116
translate schinese gianna_route_label_57430c75:

    # mc "There should be clues to getting out of here."
    mc "那应该会有逃出去的线索。"

# game/chapters/chapter_one_one/gianna_route.rpy:119
translate schinese gianna_route_label_94aa1851:

    # gi "What are you talking about?"
    gi "你在说什么？"

# game/chapters/chapter_one_one/gianna_route.rpy:120
translate schinese gianna_route_label_7bd94a48:

    # gi "You were in a similar situation?"
    gi "你也遇到过类似的情况？"

# game/chapters/chapter_one_one/gianna_route.rpy:123
translate schinese gianna_route_label_ce8d10d3:

    # mc "Yeah… you could say that."
    mc "嗯……可以这么说吧。"

# game/chapters/chapter_one_one/gianna_route.rpy:124
translate schinese gianna_route_label_ffb6da54:

    # mc "Main difference is mine was a hotel room."
    mc "最大的区别是，我那边是酒店房间。"

# game/chapters/chapter_one_one/gianna_route.rpy:127
translate schinese gianna_route_label_00a290f9:

    # gi "So you’re not from this…{w} place?"
    gi "所以你不是从这……{w}个地方来的？"

# game/chapters/chapter_one_one/gianna_route.rpy:130
translate schinese gianna_route_label_6ff41185:

    # mc "Nope."
    mc "不写了。"

# game/chapters/chapter_one_one/gianna_route.rpy:131
translate schinese gianna_route_label_b7427dd4:

    # mc "I’m from Brookdale."
    mc "我来自布鲁克代尔。"

# game/chapters/chapter_one_one/gianna_route.rpy:134
translate schinese gianna_route_label_044fb89f:

    # gi "I see, not far from New York, then."
    gi "哦，离纽约不远嘛。"

# game/chapters/chapter_one_one/gianna_route.rpy:137
translate schinese gianna_route_label_5f35f048:

    # mc "Couple of hours."
    mc "两个小时车程。"

# game/chapters/chapter_one_one/gianna_route.rpy:140
translate schinese gianna_route_label_d4d4c7b3:

    # gi "And so you solved the puzzles?"
    gi "然后你解开了那些谜题？"

# game/chapters/chapter_one_one/gianna_route.rpy:143
translate schinese gianna_route_label_2df4920f:

    # mc "Correct. That led me to a place where a woman was waiting for us."
    mc "没错。那之后我到了一个地方，有个女人在等我们。"

# game/chapters/chapter_one_one/gianna_route.rpy:146
translate schinese gianna_route_label_bb57bf03:

    # gi "I see…"
    gi "我明白了……"

# game/chapters/chapter_one_one/gianna_route.rpy:147
translate schinese gianna_route_label_e68acd67:

    # gi "So we’re dead?"
    gi "所以我们死了？"

# game/chapters/chapter_one_one/gianna_route.rpy:150
translate schinese gianna_route_label_d6927775:

    # mc "Why is that everyone’s first thought?"
    mc "为什么每个人都第一反应都是这个？"

# game/chapters/chapter_one_one/gianna_route.rpy:153
translate schinese gianna_route_label_d5b76c08:

    # gi "I don’t know… maybe because it’s what makes sense?"
    gi "我也不知道……可能因为这样才合理吧？"

# game/chapters/chapter_one_one/gianna_route.rpy:156
translate schinese gianna_route_label_cd54b095:

    # mc "Yeah… fair enough."
    mc "对……有道理。"

# game/chapters/chapter_one_one/gianna_route.rpy:159
translate schinese gianna_route_label_4818eca8:

    # mc "We aren’t dead."
    mc "我们没死。"

# game/chapters/chapter_one_one/gianna_route.rpy:160
translate schinese gianna_route_label_d1c49380:

    # mc "We’re just going to a different dimension, I guess?"
    mc "只是去了另一个位面吧？"

# game/chapters/chapter_one_one/gianna_route.rpy:163
translate schinese gianna_route_label_71f0ed24:

    # gi "Different dimension?"
    gi "另一个位面？"

# game/chapters/chapter_one_one/gianna_route.rpy:166
translate schinese gianna_route_label_c2117744:

    # mc "Yes. One where magic is real."
    mc "是的，一个魔法真实存在的世界。"

# game/chapters/chapter_one_one/gianna_route.rpy:169
translate schinese gianna_route_label_85e6717f:

    # gi "This is absurd."
    gi "这太荒谬了。"

# game/chapters/chapter_one_one/gianna_route.rpy:172
translate schinese gianna_route_label_33adc9df:

    # mc "You’re telling me."
    mc "这话该我说。"

# game/chapters/chapter_one_one/gianna_route.rpy:173
translate schinese gianna_route_label_f24eb3be:

    # mc "I’ve had one hell of a morning."
    mc "我今天早上真是够呛。"

# game/chapters/chapter_one_one/gianna_route.rpy:176
translate schinese gianna_route_label_0d014baa:

    # gi "Stressed?"
    gi "压力大吗？"

# game/chapters/chapter_one_one/gianna_route.rpy:179
translate schinese gianna_route_label_d2e7d5cf:

    # mc "Quite."
    mc "可不是。"

# game/chapters/chapter_one_one/gianna_route.rpy:182
translate schinese gianna_route_label_2d1ef510:

    # gi "Hmm…"
    gi "嗯……"

# game/chapters/chapter_one_one/gianna_route.rpy:185
translate schinese gianna_route_label_deb14d7d:

    # gi "Maybe we can do something about that later…"
    gi "也许我们以后可以想想办法……"

# game/chapters/chapter_one_one/gianna_route.rpy:190
translate schinese gianna_route_label_9a8e9419:

    # mc "Do you have anything in mind?"
    mc "你有什么想法吗？"

# game/chapters/chapter_one_one/gianna_route.rpy:193
translate schinese gianna_route_label_53e673ea:

    # gi "*Seductively* Oh I’m sure you’ll enjoy it quite a bit."
    gi "*诱惑地* 哦，我敢说你会喜欢的。"

# game/chapters/chapter_one_one/gianna_route.rpy:196
translate schinese gianna_route_label_09f2de35:

    # mc "Is that so?"
    mc "是吗？"

# game/chapters/chapter_one_one/gianna_route.rpy:199
translate schinese gianna_route_label_38beac61:

    # gi "My mouth isn’t only good for singing, stud."
    gi "我的嘴可不只会唱歌，老弟。"

# game/chapters/chapter_one_one/gianna_route.rpy:202
translate schinese gianna_route_label_dc285615:

    # mc "Well, only one way to find out, huh?"
    mc "嗯，只有一个办法能知道了，是吧？"

# game/chapters/chapter_one_one/gianna_route.rpy:205
translate schinese gianna_route_label_21ac0754:

    # gi "Easy there, officer."
    gi "冷静点，警官。"

# game/chapters/chapter_one_one/gianna_route.rpy:206
translate schinese gianna_route_label_936079f2:

    # gi "We’ll get to it later."
    gi "我们以后再说。"

# game/chapters/chapter_one_one/gianna_route.rpy:209
translate schinese gianna_route_label_7f72cc54:

    # mc "Sounds perfect to me."
    mc "我觉得完美。"

# game/chapters/chapter_one_one/gianna_route.rpy:213
translate schinese gianna_route_label_e55cc68e:

    # mc "As… tempting as that sounds…"
    mc "虽然……听起来很诱人……"

# game/chapters/chapter_one_one/gianna_route.rpy:214
translate schinese gianna_route_label_6d047019:

    # mc "Let’s focus on surviving first."
    mc "先想办法活下来吧。"

# game/chapters/chapter_one_one/gianna_route.rpy:217
translate schinese gianna_route_label_b6eb2ac9:

    # gi "Oh. I’m sorry…"
    gi "哦。抱歉……"

# game/chapters/chapter_one_one/gianna_route.rpy:219
translate schinese gianna_route_label_930363b7:

    # mc "Don’t worry, you did nothing wrong."
    mc "没关系，你没做错什么。"

# game/chapters/chapter_one_one/gianna_route.rpy:220
translate schinese gianna_route_label_f5db242a:

    # mc "We just have to get out of here quickly."
    mc "我们只要快点离开这里就行。"

# game/chapters/chapter_one_one/gianna_route.rpy:223
translate schinese gianna_route_label_5270e232:

    # gi "So… what should we do first?"
    gi "那……我们先做什么？"

# game/chapters/chapter_one_one/gianna_route.rpy:226
translate schinese gianna_route_label_d3f62c84:

    # mc "Let’s look around the office, I’m sure there are things here that can end up being useful for getting out."
    mc "先在这间办公室里找找吧，肯定有能派上用场的东西。"

# game/chapters/chapter_one_one/gianna_route.rpy:229
translate schinese gianna_route_label_4e921789:

    # gi "Will do."
    gi "好的。"

# game/chapters/chapter_one_one/gianna_route.rpy:244
translate schinese water_bottle_office_label_79090400:

    # mc "Hey check this out."
    mc "嘿，看这个。"

# game/chapters/chapter_one_one/gianna_route.rpy:247
translate schinese water_bottle_office_label_76f94f56:

    # gi "Feeling thirsty?"
    gi "渴了吗？"

# game/chapters/chapter_one_one/gianna_route.rpy:250
translate schinese water_bottle_office_label_dcd1e2bb:

    # mc "Could be useful in case we do…"
    mc "万一我们等下要……"

# game/chapters/chapter_one_one/gianna_route.rpy:253
translate schinese water_bottle_office_label_be4807a3:

    # gi "Then let’s take it with us."
    gi "那就带上吧。"

# game/chapters/chapter_one_one/gianna_route.rpy:265
translate schinese plant_office_label_0394b1d8:

    # mc "This looks dehydrated… maybe we should give it water."
    mc "这看起来快干了……也许该给它浇点水。"

# game/chapters/chapter_one_one/gianna_route.rpy:269
translate schinese plant_office_label_7656c076:

    # gi "This plant looks so dehydrated…"
    gi "这株植物看起来缺水得很……"

# game/chapters/chapter_one_one/gianna_route.rpy:272
translate schinese plant_office_label_797e2af1:

    # mc "Uh huh…{w} so dehydrated…"
    mc "是啊……{w}渴得不行……"

# game/chapters/chapter_one_one/gianna_route.rpy:275
translate schinese plant_office_label_65b059ee:

    # gi "Should we give it water?"
    gi "要不要给它浇水？"

# game/chapters/chapter_one_one/gianna_route.rpy:280
translate schinese plant_office_label_1bf60051:

    # mc "Of course."
    mc "当然。"

# game/chapters/chapter_one_one/gianna_route.rpy:281
translate schinese plant_office_label_8b3269ed:

    # mc "I think it’s a good way to make use of our water."
    mc "我觉得这样能让我们的水派上用场。"

# game/chapters/chapter_one_one/gianna_route.rpy:284
translate schinese plant_office_label_3435e92d:

    # gi "*Giggles* Aren’t you sweet?"
    gi "*咯咯笑* 你真贴心。"

# game/chapters/chapter_one_one/gianna_route.rpy:289
translate schinese plant_office_label_7ae8f4f6:

    # mc "Hmmm… not sure, we may need this for later."
    mc "唔……不一定，我们可能之后还要用。"

# game/chapters/chapter_one_one/gianna_route.rpy:297
translate schinese key_office_label_3b674a1c:

    # gi "Hey check this out!"
    gi "嘿，看这个！"

# game/chapters/chapter_one_one/gianna_route.rpy:300
translate schinese key_office_label_82bf42d2:

    # mc "A key!"
    mc "一把钥匙！"

# game/chapters/chapter_one_one/gianna_route.rpy:301
translate schinese key_office_label_a1370cf7:

    # mc "Must be useful for something."
    mc "肯定有用。"

# game/chapters/chapter_one_one/gianna_route.rpy:313
translate schinese clock_office_label_7299efa1:

    # gi "This clock is broken…"
    gi "这个钟坏了……"

# game/chapters/chapter_one_one/gianna_route.rpy:316
translate schinese clock_office_label_c3cad326:

    # mc "Meaning it’s right twice a day!"
    mc "也就是说一天里有两次它是对的！"

# game/chapters/chapter_one_one/gianna_route.rpy:319
translate schinese clock_office_label_4de8a6d9:

    # gi "*Snorts* That’s funny."
    gi "*哼* 真有意思。"

# game/chapters/chapter_one_one/gianna_route.rpy:324
translate schinese clock_office_label_571d5f0d:

    # gi "Clock still isn’t working."
    gi "钟还是不动。"

# game/chapters/chapter_one_one/gianna_route.rpy:327
translate schinese clock_office_label_097f235e:

    # mc "Yeah I know… maybe we should check this out later?"
    mc "对啊……也许我们该晚点再来看看？"

# game/chapters/chapter_one_one/gianna_route.rpy:331
translate schinese clock_office_label_9748802d:

    # gi "So… meeting at 6:30…"
    gi "那么……六点三十分见面……"

# game/chapters/chapter_one_one/gianna_route.rpy:332
translate schinese clock_office_label_309ce837:

    # gi "The clock hasn’t moved since we got in here."
    gi "我们进来之后，这钟就没走过。"

# game/chapters/chapter_one_one/gianna_route.rpy:335
translate schinese clock_office_label_b4a90e92:

    # mc "Hmmm…"
    mc "嗯……"

# game/chapters/chapter_one_one/gianna_route.rpy:336
translate schinese clock_office_label_b17650c6:

    # mc "Maybe if we move things around it can work?"
    mc "也许把指针拨一拨它就能走了？"

# game/chapters/chapter_one_one/gianna_route.rpy:340
translate schinese clock_office_label_97fabb4d:

    # mc "I can move the hands using those buttons, A and D are for the minute hand whereas Q and E are for the hour hand."
    mc "我可以拨动指针，用那几个按钮，A和D调分针，Q和E调时针。"

# game/chapters/chapter_one_one/gianna_route.rpy:342
translate schinese clock_office_label_c1d94c24:

    # mc "I can move the hands by touching them."
    mc "我可以直接拨动指针。"

# game/chapters/chapter_one_one/gianna_route.rpy:344
translate schinese clock_office_label_a77b9b20:

    # gi "You think so?"
    gi "你这么认为？"

# game/chapters/chapter_one_one/gianna_route.rpy:347
translate schinese clock_office_label_3bdc046f:

    # mc "Worth a shot."
    mc "值得一试。"

# game/chapters/chapter_one_one/gianna_route.rpy:359
translate schinese clock_office_label_0b576b41:

    # mc "Let's try moving the clock arrows..."
    mc "我们试试拨动钟针吧……"

# game/chapters/chapter_one_one/gianna_route.rpy:373
