# The game's own translation templates. Imported by tools/template.py; they are
# the original (English) script and are not ours to redistribute.
games/*/tl_template/

# Build scratch
work/
dist/
*.log
*.tmp
*.bak
*.orig

# Ren'Py bytecode -- never commit compiled output
*.rpyc
*.rpymc
*.rpyb
.saves/
log.txt
errors.txt
traceback.txt

# Ad-hoc fonts dropped in at the repo root are build scratch. The face each game
# actually ships lives in games/<slug>/assets/fonts/ and is committed on purpose.
fonts/*.ttf
fonts/*.otf
fonts/*.ttc
fonts/*.otf2
fonts/*.woff*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Locked-down local overrides
*.local.json
